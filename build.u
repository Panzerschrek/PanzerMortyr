import "/build_system.uh"
import "/path_utils.u"

fn GetPackageInfo( BK::BuildSystemInterface &mut build_system_interface ) : BK::PackageInfo
{
	var BK::TargetTriple target_triple= build_system_interface.GetTargetTriple();
	var bool is_host_windows= ust::constexpr_string_equals( compiler::target::os, "windows" );
	var bool is_target_windows= target_triple.operating_system == "windows";

	// Common lib.

	var BK::BuildTarget mut common_lib_target
	{
		.target_type = BK::BuildTargetType::Library,
		.name= "common_lib",
		.source_files= ust::make_array</ust::string8/>(
			"common_lib/src/game_params_file.u",
			"common_lib/src/map_loading.u",
			"common_lib/src/maps_description_file.u",
			"common_lib/src/materials_file.u",
			"common_lib/src/model_loading.u",
			"common_lib/src/string_iterators.u" ),
		.public_include_directories= ust::make_array</ust::string8/>( "common_lib/imports" ),
	};

	//
	// C++ header converter.
	//

	auto build_system_executable_path= build_system_interface.GetBuildSystemExecutablePath();
	auto bin_path_opt= ust::path::get_parent_path( build_system_executable_path );

	var ust::string8 cpp_header_converter_executable_name=
		ust::concat(
			"u.._cpp_header_converter",
			( is_host_windows ? ust::string_view8(".exe") : ust::string_view8("") ) );

	var ust::filesystem_path cpp_header_converter_path=
		ust::path::join(
			bin_path_opt.try_deref(), cpp_header_converter_executable_name );

	//
	// SDL
	//

	var ust::filesystem_path mut sdl_install_prefix;

	auto mut sdl_install_prefix_opt= build_system_interface.GetConfigurationOption( "sdl_install_prefix" );
	if( !sdl_install_prefix_opt.empty() )
	{
		sdl_install_prefix= sdl_install_prefix_opt.try_take();
		build_system_interface.LogInfo( ust::concat( "\"sdl_install_prefix\" is \"", sdl_install_prefix, "\"" ) );
	}
	else
	{
		build_system_interface.LogInfo( "\"sdl_install_prefix\" is not specified, using default value" );
		sdl_install_prefix= ( is_host_windows ? ust::string_view8("") : ust::string_view8( "/usr" ) );
	}

	var BK::BuildTarget mut sdl_wrapper_target
	{
		.target_type = BK::BuildTargetType::Library,
		.name= "sdl",
	};

	if( is_target_windows )
	{
		sdl_wrapper_target.external_libraries.push_back(
			ust::path::join(
				sdl_install_prefix, "lib",
				( target_triple.architecture == "x86_64" ? "x64" : "x86" ),
				"SDL2.lib" ) );
	}
	else
	{
		sdl_wrapper_target.external_libraries.push_back( "-lSDL2" );
	}

	var ust::filesystem_path sdl_include_dir=
		( is_host_windows
			? ust::path::join( sdl_install_prefix, "include" )
			: ust::path::join( sdl_install_prefix, "include/SDL2" ) );

	var ust::filesystem_path sdl_header= ust::path::join( sdl_include_dir, "SDL.h" );

	var ust::filesystem_path sdl_header_converted_base_name= "SDL.uh";

	var ust::filesystem_path sdl_header_converted=
		ust::path::join(
			build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( sdl_wrapper_target.name ),
			sdl_header_converted_base_name );

	sdl_wrapper_target.generated_public_header_files.push_back( sdl_header_converted_base_name );

	var BK::CustomBuildStep mut sdl_header_generate_step
	{
		.command= BK::CustomBuildStep::ExeCommand
		{
			.exe_path= cpp_header_converter_path,
			.command_line= ust::make_array</ust::string8/>(
				sdl_header,
				"-o",
				sdl_header_converted,
				"--",
				"-std=c11",
				// Set clang "--target" option matching our current target triple.
				ust::concat(
					"--target=",
					target_triple.architecture,
					"-",
					target_triple.vendor,
					"-",
					target_triple.operating_system,
					"-",
					target_triple.environment ) ),
		},
		.comment= sdl_header_converted_base_name,
		.input_files= ust::make_array( sdl_header ),
		.output_files= ust::make_array( sdl_header_converted ),
	};

	var ust::filesystem_path sdl_opengl_header=
		ust::path::join(
			build_system_interface.GetCurrentPackageSourceDirectory(),
			"sdl_wrapper/sdl_with_opengl.h" );

	var ust::filesystem_path sdl_opengl_header_converted_base_name= "sdl_with_opengl.uh";

	var ust::filesystem_path sdl_opengl_header_converted=
		ust::path::join(
			build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( sdl_wrapper_target.name ),
			sdl_opengl_header_converted_base_name );

	sdl_wrapper_target.generated_public_header_files.push_back( sdl_opengl_header_converted_base_name );

	var BK::CustomBuildStep mut sdl_opengl_header_generate_step
	{
		.command= BK::CustomBuildStep::ExeCommand
		{
			.exe_path= cpp_header_converter_path,
			.command_line= ust::make_array</ust::string8/>(
				sdl_opengl_header,
				"-o",
				sdl_opengl_header_converted,
				"--",
				"-std=c11",
				"-I",
				sdl_include_dir,
				// Set clang "--target" option matching our current target triple.
				ust::concat(
					"--target=",
					target_triple.architecture,
					"-",
					target_triple.vendor,
					"-",
					target_triple.operating_system,
					"-",
					target_triple.environment ) ),
		},
		.comment= sdl_opengl_header_converted_base_name,
		.input_files= ust::make_array( sdl_opengl_header ),
		.output_files= ust::make_array( sdl_opengl_header_converted ),
	};

	//
	// raylib build
	//

	var BK::BuildTarget mut raylib_wrapper_target
	{
		.target_type = BK::BuildTargetType::Library,
		.name= "raylib_wrapper",
	};

	var ust::filesystem_path raylib_src_path= ust::path::join( build_system_interface.GetCurrentPackageSourceDirectory(), "raylib" );
	var ust::filesystem_path raylib_build_path= ust::path::join( build_system_interface.GetCurrentPackageBuildDirectory(), "raylib_build" );
	var ust::filesystem_path cmake_cache_file= ust::path::join( raylib_build_path, "CMakeCache.txt" );

	var ust::filesystem_path raylib_compiled=
		ust::path::join(
			raylib_build_path,
			"raylib",
			( is_target_windows
				? ust::string_view8( "raylib.lib" )
				: ust::string_view8( "libraylib.a" ) ) );

	var ust::filesystem_path raylib_header= ust::path::join( raylib_src_path, "src", "raylib.h" );

	var ust::string_view8 mut cmake_build_type;
	switch( build_system_interface.GetBuildConfiguration() )
	{
		BK::BuildConfiguration::Debug -> { cmake_build_type= "Debug"; },
		BK::BuildConfiguration::Release -> { cmake_build_type= "Release"; },
		BK::BuildConfiguration::MinSizeRelease -> { cmake_build_type= "MinSizeRel"; },
	}

	var ust::string8 cmake_executable =
		ust::concat(
			"cmake",
			( is_host_windows ? ust::string_view8(".exe") : ust::string_view8("") ) );

	var BK::CustomBuildStep mut raylib_cmake_generate_step
	{
		.command= BK::CustomBuildStep::ExeCommand
		{
			.exe_path= cmake_executable,
			.command_line= ust::make_array</ust::string8/>(
				"-S", raylib_src_path,
				"-B", raylib_build_path,
				"-DBUILD_EXAMPLES=OFF",
				ust::concat( "-DCMAKE_BUILD_TYPE=", cmake_build_type ),
				"-G", "Ninja" )
		},
		.input_files= ust::make_array( ust::path::join( raylib_src_path, "CMakeLists.txt" ) ),
		.output_files= ust::make_array( cmake_cache_file ),
		.comment= "cmake generation for raylib",
	};

	var BK::CustomBuildStep mut raylib_cmake_build_step
	{
		.command= BK::CustomBuildStep::ExeCommand
		{
			.exe_path= cmake_executable,
			.command_line= ust::make_array</ust::string8/>( "--build", raylib_build_path )
		},
		.input_files= ust::make_array( cmake_cache_file ),
		.output_files= ust::make_array( raylib_compiled ),
		.comment= "cmake build for raylib",
	};

	var ust::filesystem_path_view raylib_header_converted_base_name= "raylib.uh";

	var ust::filesystem_path raylib_header_converted=
		ust::path::join(
			build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( raylib_wrapper_target.name ),
			raylib_header_converted_base_name );

	var BK::CustomBuildStep mut raylib_header_convertion_step
	{
		.command= BK::CustomBuildStep::ExeCommand
		{
			.exe_path= cpp_header_converter_path,
			.command_line= ust::make_array</ust::string8/>( raylib_header, "-o", raylib_header_converted, "--", "-std=c11" ),
		},
		.comment= raylib_header_converted_base_name,
		.input_files= ust::make_array( raylib_header ),
		.output_files= ust::make_array( raylib_header_converted ),
	};

	raylib_wrapper_target.generated_public_header_files.push_back( raylib_header_converted_base_name );

	raylib_wrapper_target.external_libraries.push_back( raylib_compiled );

	if( is_target_windows )
	{
		raylib_wrapper_target.external_libraries.push_back( "gdi32.lib" );
		raylib_wrapper_target.external_libraries.push_back( "user32.lib" );
		raylib_wrapper_target.external_libraries.push_back( "shell32.lib" );
		raylib_wrapper_target.external_libraries.push_back( "winmm.lib" );
	}
	else
	{
		raylib_wrapper_target.external_libraries.push_back( "-ldl" );
	}

	//
	// Our end build targets.
	//

	var BK::BuildTarget mut map_viewer_target
	{
		.target_type = BK::BuildTargetType::Executable,
		.name= "map_viewer",
		.source_files= ust::make_array</ ust::string8 />( "map_viewer/main.u" ),
		.private_dependencies= ust::make_array(
			BK::DependencyName{ .name= common_lib_target.name },
			BK::DependencyName{ .name= raylib_wrapper_target.name } ),
	};

	var BK::BuildTarget mut model_viewer_target
	{
		.target_type = BK::BuildTargetType::Executable,
		.name= "model_viewer",
		.source_files= ust::make_array</ ust::string8 />( "model_viewer/main.u" ),
		.private_dependencies= ust::make_array(
			BK::DependencyName{ .name= common_lib_target.name },
			BK::DependencyName{ .name= raylib_wrapper_target.name } ),
	};

	var BK::BuildTarget mut archive_extractor_target
	{
		.target_type = BK::BuildTargetType::Executable,
		.name= "archive_extractor",
		.source_files= ust::make_array</ ust::string8 />( "archive_extractor/main.u" ),
		.private_dependencies= ust::make_array( BK::DependencyName{ .name= common_lib_target.name } ),
	};

	var BK::BuildTarget mut map_stats_target
	{
		.target_type= BK::BuildTargetType::Executable,
		.name= "map_stats",
		.source_files= ust::make_array</ ust::string8 />( "map_stats/main.u" ),
		.private_dependencies= ust::make_array( BK::DependencyName{ .name= common_lib_target.name } )
	};

	var BK::BuildTarget mut panzer_mortyr_target
	{
		.target_type = BK::BuildTargetType::Executable,
		.name= "panzer_mortyr",
		.private_dependencies= ust::make_array(
			BK::DependencyName{ .name= common_lib_target.name },
			BK::DependencyName{ .name= sdl_wrapper_target.name } ),
	};

	var [ ust::filesystem_path_view, 33 ] panzer_mortyr_source_files
	[
		"buffer_object.u",
		"buffer_utils.u",
		"caching_game_resources_loader.u",
		"camera_rotation_controller.u",
		"collisions.u",
		"command_line_options.u",
		"console.u",
		"console_out.u",
		"debug_visualization.u",
		"entities_description_file.u",
		"font_file.u",
		"game_filesystem.u",
		"game_logic.u",
		"game.u",
		"geometry_utils.u",
		"gl_state.u",
		"gpu_model.u",
		"hud_drawer.u",
		"image_loading.u",
		"main.u",
		"materials_property_file.u",
		"opengl_window.u",
		"performance_counter.u",
		"player_movement_controller.u",
		"player_tool_controller.u",
		"quads_hierarchy.u",
		"random.u",
		"settings.u",
		"shader_program.u",
		"text_drawer.u",
		"texture.u",
		"vertex_array_object.u",
		"world_drawer.u"
	];

	foreach( &f : panzer_mortyr_source_files )
	{
		panzer_mortyr_target.source_files.push_back( ust::path::join( "panzer_mortyr", f ) );
	}

	return BK::PackageInfo
	{
		.build_targets=
			ust::make_array(
				move(common_lib_target),
				move(sdl_wrapper_target),
				move(raylib_wrapper_target),
				move(map_viewer_target),
				move(model_viewer_target),
				move(archive_extractor_target),
				move(map_stats_target),
				move(panzer_mortyr_target) ),
		.custom_build_steps=
			ust::make_array(
				move( sdl_header_generate_step ),
				move( sdl_opengl_header_generate_step ),
				move( raylib_cmake_generate_step ),
				move( raylib_cmake_build_step ),
				move( raylib_header_convertion_step ) )
	};
}
