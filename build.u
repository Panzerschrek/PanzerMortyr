import "/build_system.iu"
import "/filesystem.iu"
import "/path_utils.iu"

fn GetPackageInfo( BK::BuildSystemInterface &mut build_system_interface ) : BK::PackageInfo
{
	var BK::TargetTriple target_triple= build_system_interface.GetTargetTriple();
	var bool is_host_windows= ust::constexpr_string_equals( compiler::target::os, "windows" );
	var bool is_target_windows= target_triple.operating_system == "windows";

	var ust::vector</BK::BuildTarget/> mut build_targets;
	var ust::vector</BK::CustomBuildStep/> mut custom_build_steps;

	// Common lib.

	auto& common_lib_target_name= "common_lib";

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type = BK::BuildTargetType::Library,
			.name= common_lib_target_name,
			.source_files= ust::make_array</ust::string8/>(
				"common_lib/src/billboards_description_file.u",
				"common_lib/src/game_params_file.u",
				"common_lib/src/map_loading.u",
				"common_lib/src/maps_description_file.u",
				"common_lib/src/materials_file.u",
				"common_lib/src/model_loading.u",
				"common_lib/src/string_iterators.u" ),
			.public_include_directories= ust::make_array</ust::string8/>( "common_lib/imports" ),
		} );

	//
	// C++ header converter.
	//

	auto build_system_executable_path= build_system_interface.GetBuildSystemExecutablePath();
	auto bin_path_opt= ust::path::get_parent_path( build_system_executable_path );
	var ust::filesystem_path bin_path= bin_path_opt.deref_or( ust::filesystem_path() );

	var ust::string8 cpp_header_converter_executable_name=
		ust::concat(
			"u.._cpp_header_converter", ( is_host_windows ? ust::string_view8(".exe") : ust::string_view8("") ) );

	var ust::filesystem_path cpp_header_converter_path=
		ust::path::join( bin_path, cpp_header_converter_executable_name );

	//
	// Cmake
	//

	var ust::string_view8 cmake_build_type=
		lambda[&]() : ust::string_view8
		{
			switch( build_system_interface.GetBuildConfiguration() )
			{
				BK::BuildConfiguration::Debug -> { return "Debug"; },
				BK::BuildConfiguration::Release -> { return  "Release"; },
				BK::BuildConfiguration::MinSizeRelease -> { return  "MinSizeRel"; },
			}
		}();

	var ust::string8 cmake_executable =
		ust::concat( "cmake", ( is_host_windows ? ust::string_view8(".exe") : ust::string_view8("") ) );

	//
	// SDL
	//

	auto& sdl_wrapper_target_name= "sdl";

	{
		// Build SDL from sources and link against it statically.
		// There is no reason to use SDL as shared library.
		// Static linking allows minimizing the number of files in PanzerMortyr destribution.
		// Also total size is minimized, since no unused SDL code parts are shipped.

		var ust::filesystem_path sdl_source_path=
			ust::path::join( build_system_interface.GetCurrentPackageSourceDirectory(), "SDL" );

		var ust::filesystem_path sdl_build_path=
			ust::path::join( build_system_interface.GetCurrentPackageBuildDirectory(), "sdl_build" );

		var ust::filesystem_path sdl_library_compiled=
			ust::path::join(
				sdl_build_path,
				( build_system_interface.GetBuildConfiguration() == BK::BuildConfiguration::Debug
					? ( is_target_windows
						? ust::filesystem_path_view( "SDL2d.lib" )
						: ust::filesystem_path_view( "libSDL2.a" ) )
					: ( is_target_windows
						? ust::filesystem_path_view( "SDL2.lib" )
						: ust::filesystem_path_view( "libSDL.a" ) ) ) );

		var ust::filesystem_path cmake_cache_file= ust::path::join( sdl_build_path, "CMakeCache.txt" );

		var [ ust::string8, 27 ] mut cmake_generation_command_line
		[
			"-S", sdl_source_path,
			"-B", sdl_build_path,
			ust::concat( "-DCMAKE_BUILD_TYPE=", cmake_build_type ),
			"-G", "Ninja",
			// Disable SDL2 functionality unused by PanzerMortyr.
			"-DSDL_DIRECTFB=OFF",
			"-DSDL_DIRECTX=OFF",
			"-DSDL_DISKAUDIO=OFF",
			"-DSDL_DUMMYAUDIO=OFF",
			"-DSDL_DUMMYVIDEO=OFF",
			"-DSDL_FILE=OFF",
			"-DSDL_FILESYSTEM=OFF",
			"-DSDL_HAPTIC=OFF",
			"-DSDL_HIDAPI=OFF",
			"-DSDL_JOYSTICK=OFF",
			"-DSDL_LOCALE=OFF",
			"-DSDL_OFFSCREEN=OFF",
			"-DSDL_OPENGLES=OFF",
			"-DSDL_POWER=OFF",
			"-DSDL_RENDER=OFF",
			"-DSDL_RENDER_D3D=OFF",
			"-DSDL_RENDER_METAL=OFF",
			"-DSDL_SENSOR=OFF",
			"-DSDL_TEST=OFF",
			"-DSDL_VULKAN=OFF",
		];

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= cmake_executable,
					.command_line( move(cmake_generation_command_line) ),
				},
				.input_files= ust::make_array( ust::path::join( sdl_source_path, "CMakeLists.txt" ) ),
				.output_files= ust::make_array( cmake_cache_file ),
				.comment= "cmake generation for sdl",
			} );

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= cmake_executable,
					.command_line= ust::make_array</ust::string8/>( "--build", sdl_build_path )
				},
				.input_files= ust::make_array( cmake_cache_file ),
				.output_files= ust::make_array( sdl_library_compiled ),
				.comment= "cmake build for sdl",
			} );

		var BK::BuildTarget mut sdl_wrapper_target
		{
			.target_type = BK::BuildTargetType::Library,
			.name= sdl_wrapper_target_name,
		};

		sdl_wrapper_target.external_libraries.push_back( sdl_library_compiled );

		if( !is_target_windows )
		{
			sdl_wrapper_target.external_libraries.push_back( "-ldl" );
		}

		var ust::filesystem_path sdl_opengl_header=
			ust::path::join(
				build_system_interface.GetCurrentPackageSourceDirectory(),
				"sdl_wrapper/sdl_with_opengl.h" );

		var ust::filesystem_path sdl_opengl_header_converted_base_name= "sdl_with_opengl.iu";

		var ust::filesystem_path sdl_opengl_header_converted=
			ust::path::join(
				build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( sdl_wrapper_target.name ),
				sdl_opengl_header_converted_base_name );

		sdl_wrapper_target.generated_public_header_files.push_back( sdl_opengl_header_converted_base_name );

		build_targets.push_back( move( sdl_wrapper_target ) );

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= cpp_header_converter_path,
					.command_line= ust::make_array</ust::string8/>(
						sdl_opengl_header,
						"-o",
						sdl_opengl_header_converted,
						"--",
						"-std=c11",
						"-I",
						ust::path::join( sdl_source_path, "include" ),
						// Set clang "--target" option matching our current target triple.
						ust::concat(
							"--target=",
							target_triple.architecture,
							"-",
							target_triple.vendor,
							"-",
							target_triple.operating_system,
							"-",
							target_triple.environment ) ),
				},
				.comment= sdl_opengl_header_converted_base_name,
				.input_files= ust::make_array( sdl_opengl_header ),
				.output_files= ust::make_array( sdl_opengl_header_converted ),
			} );
	}

	var bool mut use_raylib= false;

	var ust::filesystem_path raylib_src_path=
		ust::path::join( build_system_interface.GetCurrentPackageSourceDirectory(), "raylib" );

	if( !build_system_interface.GetConfigurationOption( "disable_raylib" ).empty() )
	{
		build_system_interface.LogInfo( "\"raylib\" is disabled via configuration options, bulding without it" );
	}
	else
	{
		result_match( ust::get_metadata_for_path( raylib_src_path ) )
		{
			Ok(m) ->
			{
				if( m.kind == ust::file_kind::directory )
				{
					use_raylib= true;
					build_system_interface.LogInfo( "Found \"raylib\", bulding with it" );
				}
			},
			Err(e) ->
			{
				build_system_interface.LogError( "Failed to find \"raylib\", building without it" );
			}
		}
	}

	if( use_raylib )
	{
		//
		// raylib build
		//

		auto& raylib_wrapper_target_name= "raylib_wrapper";

		{
			var BK::BuildTarget mut raylib_wrapper_target
			{
				.target_type = BK::BuildTargetType::Library,
				.name= raylib_wrapper_target_name,
			};

			var ust::filesystem_path raylib_build_path=
				ust::path::join( build_system_interface.GetCurrentPackageBuildDirectory(), "raylib_build" );

			var ust::filesystem_path cmake_cache_file=
				ust::path::join( raylib_build_path, "CMakeCache.txt" );

			var ust::filesystem_path raylib_compiled=
				ust::path::join(
					raylib_build_path,
					"raylib",
					( is_target_windows
						? ust::string_view8( "raylib.lib" )
						: ust::string_view8( "libraylib.a" ) ) );

			var ust::filesystem_path raylib_header= ust::path::join( raylib_src_path, "src", "raylib.h" );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= cmake_executable,
						.command_line= ust::make_array</ust::string8/>(
							"-S", raylib_src_path,
							"-B", raylib_build_path,
							"-DBUILD_EXAMPLES=OFF",
							ust::concat( "-DCMAKE_BUILD_TYPE=", cmake_build_type ),
							"-G", "Ninja" )
					},
					.input_files= ust::make_array( ust::path::join( raylib_src_path, "CMakeLists.txt" ) ),
					.output_files= ust::make_array( cmake_cache_file ),
					.comment= "cmake generation for raylib",
				} );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= cmake_executable,
						.command_line= ust::make_array</ust::string8/>( "--build", raylib_build_path )
					},
					.input_files= ust::make_array( cmake_cache_file ),
					.output_files= ust::make_array( raylib_compiled ),
					.comment= "cmake build for raylib",
				} );

			var ust::filesystem_path_view raylib_header_converted_base_name= "raylib.iu";

			var ust::filesystem_path raylib_header_converted=
				ust::path::join(
					build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( raylib_wrapper_target_name ),
					raylib_header_converted_base_name );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= cpp_header_converter_path,
						.command_line= ust::make_array</ust::string8/>( raylib_header, "-o", raylib_header_converted, "--", "-std=c11" ),
					},
					.comment= raylib_header_converted_base_name,
					.input_files= ust::make_array( raylib_header ),
					.output_files= ust::make_array( raylib_header_converted ),
				} );

			raylib_wrapper_target.generated_public_header_files.push_back( raylib_header_converted_base_name );

			raylib_wrapper_target.external_libraries.push_back( raylib_compiled );

			if( is_target_windows )
			{
				raylib_wrapper_target.external_libraries.push_back( "gdi32.lib" );
				raylib_wrapper_target.external_libraries.push_back( "user32.lib" );
				raylib_wrapper_target.external_libraries.push_back( "shell32.lib" );
				raylib_wrapper_target.external_libraries.push_back( "winmm.lib" );
			}
			else
			{
				raylib_wrapper_target.external_libraries.push_back( "-ldl" );
			}

			build_targets.push_back( move( raylib_wrapper_target ) );
		}

		build_targets.push_back(
			BK::BuildTarget
			{
				.target_type = BK::BuildTargetType::Executable,
				.name= "map_viewer",
				.source_files= ust::make_array</ ust::string8 />( "map_viewer/main.u" ),
				.private_dependencies= ust::make_array(
					BK::DependencyName{ .name= common_lib_target_name },
					BK::DependencyName{ .name= raylib_wrapper_target_name } ),
			} );

		build_targets.push_back(
			BK::BuildTarget
			{
				.target_type = BK::BuildTargetType::Executable,
				.name= "model_viewer",
				.source_files= ust::make_array</ ust::string8 />( "model_viewer/main.u" ),
				.private_dependencies= ust::make_array(
					BK::DependencyName{ .name= common_lib_target_name },
					BK::DependencyName{ .name= raylib_wrapper_target_name } ),
			} );

		build_targets.push_back(
			BK::BuildTarget
			{
				.target_type = BK::BuildTargetType::Executable,
				.name= "billboards_viewer",
				.source_files= ust::make_array</ ust::string8 />( "billboards_viewer/main.u" ),
				.private_dependencies= ust::make_array(
					BK::DependencyName{ .name= common_lib_target_name },
					BK::DependencyName{ .name= raylib_wrapper_target_name } ),
			} );
	}

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type = BK::BuildTargetType::Executable,
			.name= "archive_extractor",
			.source_files= ust::make_array</ ust::string8 />( "archive_extractor/main.u" ),
			.private_dependencies= ust::make_array( BK::DependencyName{ .name= common_lib_target_name } ),
		} );

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type= BK::BuildTargetType::Executable,
			.name= "map_stats",
			.source_files= ust::make_array</ ust::string8 />( "map_stats/main.u" ),
			.private_dependencies= ust::make_array( BK::DependencyName{ .name= common_lib_target_name } )
		} );

	var [ ust::filesystem_path_view, 52 ] panzer_mortyr_source_files
	[
		"billboards.u",
		"breaking_glass.u",
		"buffer_object.u",
		"buffer_utils.u",
		"caching_game_resources_loader.u",
		"camera_controller.u",
		"camera_utils.u",
		"caustics.u",
		"collisions.u",
		"command_line_options.u",
		"console.u",
		"console_out.u",
		"crosshair_drawer.u",
		"debug_visualization.u",
		"entities_description_file.u",
		"fog.u",
		"game.u",
		"game_data_search.u",
		"game_event_notification_drawer.u",
		"game_filesystem.u",
		"game_logic.u",
		"game_state_view_construction.u",
		"geometry_utils.u",
		"gl_capabilities.u",
		"gl_functions.u",
		"gl_state.u",
		"gpu_model.u",
		"hud_drawer.u",
		"image_drawer.u",
		"image_loading.u",
		"key_binding.u",
		"lighting.u",
		"main.u",
		"map_quad_utils.u",
		"materials_property_file.u",
		"menu.u",
		"opengl_window.u",
		"performance_counter.u",
		"player_movement_controller.u",
		"player_tool_controller.u",
		"quads_hierarchy.u",
		"random.u",
		"room_clusters_hierarchy.u",
		"settings.u",
		"shader_program.u",
		"sky.u",
		"text_drawer.u",
		"texture.u",
		"triangles_sorting.u",
		"vertex_array_object.u",
		"visibility_calculation.u",
		"world_drawer.u"
	];

	var ust::vector</ust::filesystem_path/> mut panzer_mortyr_source_files_full;

	foreach( &f : panzer_mortyr_source_files )
	{
		panzer_mortyr_source_files_full.push_back( ust::path::join( "panzer_mortyr", f ) );
	}

	var ust::vector</ ust::filesystem_path /> mut panzer_mortyr_external_libraries;

	if( is_target_windows )
	{
		var ust::string8 llvm_rc_executable_name=
			ust::concat( "llvm-rc", ( is_host_windows ? ust::string_view8(".exe") : ust::string_view8("") ) );

		var ust::filesystem_path llvm_rc_path=
			ust::path::join( bin_path, llvm_rc_executable_name );

		var ust::filesystem_path res_file_in=
			ust::path::join(
				build_system_interface.GetCurrentPackageSourceDirectory(),
				"panzer_mortyr/res.rc" );

		var ust::filesystem_path icon_file_in=
			ust::path::join(
				build_system_interface.GetCurrentPackageSourceDirectory(),
				"panzer_mortyr/icon.ico" );

		var ust::filesystem_path res_file_out=
			ust::path::join( build_system_interface.GetCurrentPackageBuildDirectory(), "res.rc.res" );

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= llvm_rc_path,
					.command_line= ust::make_array( res_file_in, "/fo", res_file_out ),
				},
				.comment= "panzer_mortyr Windows resource file",
				.input_files= ust::make_array( res_file_in, icon_file_in ),
				.output_files= ust::make_array( res_file_out ),
			} );

		panzer_mortyr_external_libraries.push_back( res_file_out );
	}

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type = BK::BuildTargetType::Executable,
			.name= "panzer_mortyr",
			.source_files= move( panzer_mortyr_source_files_full ),
			.private_dependencies= ust::make_array(
				BK::DependencyName{ .name= common_lib_target_name },
				BK::DependencyName{ .name= sdl_wrapper_target_name } ),
			.external_libraries= move( panzer_mortyr_external_libraries ),
		} );

	return BK::PackageInfo
	{
		.build_targets= move(build_targets),
		.custom_build_steps= move(custom_build_steps),
	};
}
