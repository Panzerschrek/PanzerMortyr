import "/build_system.iu"
import "/filesystem.iu"
import "/path_utils.iu"

fn GetPackageInfo( BK::BuildSystemInterface &mut build_system_interface ) : BK::PackageInfo
{
	var BK::TargetTriple target_triple= build_system_interface.GetTargetTriple();
	var bool is_target_windows= target_triple.operating_system == "windows";

	var BK::BuildConfiguration build_configuration= build_system_interface.GetBuildConfiguration();

	var ust::filesystem_path current_package_source_directory=
		build_system_interface.GetCurrentPackageSourceDirectory();

	var ust::filesystem_path current_package_build_directory=
		build_system_interface.GetCurrentPackageBuildDirectory();

	var ust::vector</BK::BuildTarget/> mut build_targets;
	var ust::vector</BK::CustomBuildStep/> mut custom_build_steps;

	// Common lib.

	auto& common_lib_target_name= "common_lib";

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type = BK::BuildTargetType::Library,
			.name= common_lib_target_name,
			.source_files= ust::make_array</ust::string8/>(
				"common_lib/src/billboards_description_file.u",
				"common_lib/src/game_params_file.u",
				"common_lib/src/map_loading.u",
				"common_lib/src/maps_description_file.u",
				"common_lib/src/materials_file.u",
				"common_lib/src/model_loading.u",
				"common_lib/src/string_iterators.u" ),
			.public_include_directories= ust::make_array</ust::string8/>( "common_lib/imports" ),
		} );

	//
	// C++ header converter.
	//

	auto build_system_executable_path= build_system_interface.GetBuildSystemExecutablePath();
	auto bin_path_opt= ust::path::get_parent_path( build_system_executable_path );
	var ust::filesystem_path bin_path= bin_path_opt.deref_or( ust::filesystem_path() );

	var ust::filesystem_path cpp_header_converter_path=
		ust::path::join( bin_path, GetExecutableFullName( "u.._cpp_header_converter" ) );

	// llvm-rc

	var ust::filesystem_path llvm_rc_path= ust::path::join( bin_path, GetExecutableFullName( "llvm-rc" ) );

	//
	// Cmake
	//

	var ust::string_view8 cmake_build_type_option=
		lambda[&]() : ust::string_view8
		{
			switch( build_configuration )
			{
				BK::BuildConfiguration::Debug -> { return "-DCMAKE_BUILD_TYPE=Debug"; },
				BK::BuildConfiguration::Release -> { return "-DCMAKE_BUILD_TYPE=Release"; },
				BK::BuildConfiguration::MinSizeRelease -> { return "-DCMAKE_BUILD_TYPE=MinSizeRel"; },
			}
		}();

	auto cmake_executable= GetExecutableFullName( "cmake" );

	//
	// SDL
	//

	auto& sdl_wrapper_target_name= "sdl";

	{
		// Build SDL from sources and link against it statically.
		// There is no reason to use SDL as shared library.
		// Static linking allows minimizing the number of files in PanzerMortyr destribution.
		// Also total size is minimized, since no unused SDL code parts are shipped.

		var ust::filesystem_path sdl_source_path= ust::path::join( current_package_source_directory, "SDL" );

		var ust::filesystem_path sdl_build_path= ust::path::join( current_package_build_directory, "sdl_build" );

		var ust::filesystem_path sdl_library_compiled=
			ust::path::join(
				sdl_build_path,
				( build_configuration == BK::BuildConfiguration::Debug
					? ( is_target_windows
						? ust::filesystem_path_view( "SDL2-staticd.lib" )
						: ust::filesystem_path_view( "libSDL2d.a" ) )
					: ( is_target_windows
						? ust::filesystem_path_view( "SDL2-static.lib" )
						: ust::filesystem_path_view( "libSDL2.a" ) ) ) );

		var ust::filesystem_path cmake_cache_file= ust::path::join( sdl_build_path, "CMakeCache.txt" );

		var [ ust::string8, 32 ] mut cmake_generation_command_line
		[
			"-S", sdl_source_path,
			"-B", sdl_build_path,
			cmake_build_type_option,
			"-G", "Ninja",
			// A hacky way to disable SDL dynamic API.
			// We don't really need it.
			// Disabling it allows removing indirection in SDL calls.
			// It also significantly reduces result executable size by allowing the linker to remove more unused functionality.
			"-DCMAKE_C_FLAGS=-DSDL_dynapi_h_ -DSDL_DYNAMIC_API=0",
			// Build only static library, but not shared library version.
			"-DSDL_STATIC=ON",
			"-DSDL_SHARED=OFF",
			"-DSDL_FORCE_STATIC_VCRT=ON", // Use static VS runtime.
			// Disable SDL2 functionality unused by PanzerMortyr.
			"-DSDL_DIRECTFB=OFF",
			"-DSDL_DIRECTX=OFF",
			"-DSDL_DISKAUDIO=OFF",
			"-DSDL_DUMMYAUDIO=OFF",
			"-DSDL_DUMMYVIDEO=OFF",
			"-DSDL_FILE=OFF",
			"-DSDL_FILESYSTEM=OFF",
			"-DSDL_HAPTIC=OFF",
			"-DSDL_HIDAPI=OFF",
			"-DSDL_JOYSTICK=OFF",
			"-DSDL_LOCALE=OFF",
			"-DSDL_OFFSCREEN=OFF",
			"-DSDL_OPENGLES=OFF",
			"-DSDL_POWER=OFF",
			"-DSDL_RENDER=OFF",
			"-DSDL_RENDER_D3D=OFF",
			"-DSDL_RENDER_METAL=OFF",
			"-DSDL_SENSOR=OFF",
			"-DSDL_TEST=OFF",
			"-DSDL_VULKAN=OFF",
			"-DSDL_STATIC_PIC=ON",
		];

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= cmake_executable,
					.command_line( move(cmake_generation_command_line) ),
				},
				.input_files= ust::make_array( ust::path::join( sdl_source_path, "CMakeLists.txt" ) ),
				.output_files= ust::make_array( cmake_cache_file ),
				.comment= "cmake generation for sdl",
			} );

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= cmake_executable,
					.command_line= ust::make_array</ust::string8/>( "--build", sdl_build_path )
				},
				.input_files= ust::make_array( cmake_cache_file ),
				.output_files= ust::make_array( sdl_library_compiled ),
				.comment= "cmake build for sdl",
			} );

		var BK::BuildTarget mut sdl_wrapper_target
		{
			.target_type = BK::BuildTargetType::Library,
			.name= sdl_wrapper_target_name,
		};

		sdl_wrapper_target.external_libraries.push_back( sdl_library_compiled );

		if( is_target_windows )
		{
			sdl_wrapper_target.external_libraries.push_back( "advapi32.lib" );
			sdl_wrapper_target.external_libraries.push_back( "gdi32.lib" );
			sdl_wrapper_target.external_libraries.push_back( "imm32.lib" );
			sdl_wrapper_target.external_libraries.push_back( "oleaut32.lib" );
			sdl_wrapper_target.external_libraries.push_back( "ole32.lib" );
			sdl_wrapper_target.external_libraries.push_back( "shell32.lib" );
			sdl_wrapper_target.external_libraries.push_back( "user32.lib" );
			sdl_wrapper_target.external_libraries.push_back( "version.lib" );
			sdl_wrapper_target.external_libraries.push_back( "winmm.lib" );
		}
		else
		{
			sdl_wrapper_target.external_libraries.push_back( "-ldl" );
		}

		var ust::filesystem_path sdl_opengl_header=
			ust::path::join( current_package_source_directory, "sdl_wrapper/sdl_with_opengl.h" );

		var ust::filesystem_path sdl_opengl_header_converted_base_name= "sdl_with_opengl.iu";

		var ust::filesystem_path sdl_opengl_header_converted=
			ust::path::join(
				build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( sdl_wrapper_target.name ),
				sdl_opengl_header_converted_base_name );

		sdl_wrapper_target.generated_public_header_files.push_back( sdl_opengl_header_converted_base_name );

		build_targets.push_back( move( sdl_wrapper_target ) );

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= cpp_header_converter_path,
					.command_line= ust::make_array</ust::string8/>(
						sdl_opengl_header,
						"-o",
						sdl_opengl_header_converted,
						"--",
						"-std=c11",
						"-I",
						ust::path::join( sdl_source_path, "include" ),
						GetCPPHeaderConverterTargetOption( target_triple ) ),
				},
				.comment= sdl_opengl_header_converted_base_name,
				.input_files= ust::make_array( sdl_opengl_header ),
				.output_files= ust::make_array( sdl_opengl_header_converted ),
			} );
	}

	var bool mut use_raylib= false;

	var ust::filesystem_path raylib_src_path= ust::path::join( current_package_source_directory, "raylib" );

	if( !build_system_interface.GetConfigurationOption( "disable_raylib" ).empty() )
	{
		build_system_interface.LogInfo( "\"raylib\" is disabled via configuration options, building without it" );
	}
	else
	{
		result_match( ust::get_metadata_for_path( raylib_src_path ) )
		{
			Ok(m) ->
			{
				if( m.kind == ust::file_kind::directory )
				{
					use_raylib= true;
					build_system_interface.LogInfo( "Found \"raylib\", building with it" );
				}
			},
			Err(e) ->
			{
				ust::ignore_unused(e);
				build_system_interface.LogError( "Failed to find \"raylib\", building without it" );
			}
		}
	}

	if( use_raylib )
	{
		//
		// raylib build
		//

		auto& raylib_wrapper_target_name= "raylib_wrapper";

		{
			var BK::BuildTarget mut raylib_wrapper_target
			{
				.target_type = BK::BuildTargetType::Library,
				.name= raylib_wrapper_target_name,
			};

			var ust::filesystem_path raylib_build_path=
				ust::path::join( current_package_build_directory, "raylib_build" );

			var ust::filesystem_path cmake_cache_file= ust::path::join( raylib_build_path, "CMakeCache.txt" );

			var ust::filesystem_path raylib_compiled=
				ust::path::join(
					raylib_build_path,
					"raylib",
					( is_target_windows
						? ust::string_view8( "raylib.lib" )
						: ust::string_view8( "libraylib.a" ) ) );

			var ust::filesystem_path raylib_header= ust::path::join( raylib_src_path, "src", "raylib.h" );

			var [ ust::string8, 36 ] mut cmake_generation_command_line
			[
				"-S", raylib_src_path,
				"-B", raylib_build_path,
				"-DBUILD_EXAMPLES=OFF",
				cmake_build_type_option,
				"-G", "Ninja",
				// Disable functionality unused in PanzerMortyr.
				"-DCUSTOMIZE_BUILD=ON",
				"-DSUPPORT_MODULE_RAUDIO=OFF",
				"-DSUPPORT_GESTURES_SYSTEM=OFF",
				"-DSUPPORT_SSH_KEYBOARD_RPI=OFF",
				"-DSUPPORT_SCREEN_CAPTURE=OFF",
				"-DSUPPORT_GIF_RECORDING=OFF",
				"-DSUPPORT_COMPRESSION_API=OFF",
				"-DSUPPORT_AUTOMATION_EVENTS=OFF",
				"-DSUPPORT_CLIPBOARD_IMAGE=OFF",
				"-DSUPPORT_QUADS_DRAW_MODE=OFF",
				"-DSUPPORT_FILEFORMAT_JPG=OFF",
				"-DSUPPORT_FILEFORMAT_GIF=OFF",
				"-DSUPPORT_FILEFORMAT_QOI=OFF",
				"-DSUPPORT_FILEFORMAT_DDS=OFF",
				"-DSUPPORT_FILEFORMAT_OBJ=OFF",
				"-DSUPPORT_FILEFORMAT_MTL=OFF",
				"-DSUPPORT_FILEFORMAT_IQM=OFF",
				"-DSUPPORT_FILEFORMAT_GLTF=OFF",
				"-DSUPPORT_FILEFORMAT_VOX=OFF",
				"-DSUPPORT_FILEFORMAT_M3D=OFF",
				"-DSUPPORT_FILEFORMAT_WAV=OFF",
				"-DSUPPORT_FILEFORMAT_OGG=OFF",
				"-DSUPPORT_FILEFORMAT_MP3=OFF",
				"-DSUPPORT_FILEFORMAT_TTF=OFF",
				"-DSUPPORT_FILEFORMAT_FNT=OFF",
				"-DSUPPORT_FILEFORMAT_MOD=OFF",
				"-DSUPPORT_FILEFORMAT_XM=OFF",
				"-DSUPPORT_FILEFORMAT_QOA=OFF",
			];

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= cmake_executable,
						.command_line( move(cmake_generation_command_line) ),
					},
					.input_files= ust::make_array( ust::path::join( raylib_src_path, "CMakeLists.txt" ) ),
					.output_files= ust::make_array( cmake_cache_file ),
					.comment= "cmake generation for raylib",
				} );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= cmake_executable,
						.command_line= ust::make_array</ust::string8/>( "--build", raylib_build_path )
					},
					.input_files= ust::make_array( cmake_cache_file ),
					.output_files= ust::make_array( raylib_compiled ),
					.comment= "cmake build for raylib",
				} );

			var ust::filesystem_path_view raylib_header_converted_base_name= "raylib.iu";

			var ust::filesystem_path raylib_header_converted=
				ust::path::join(
					build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( raylib_wrapper_target_name ),
					raylib_header_converted_base_name );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= cpp_header_converter_path,
						.command_line=
							ust::make_array</ust::string8/>(
								raylib_header,
								"-o",
								raylib_header_converted,
								"--",
								"-std=c11",
								GetCPPHeaderConverterTargetOption( target_triple ) ),
					},
					.comment= raylib_header_converted_base_name,
					.input_files= ust::make_array( raylib_header ),
					.output_files= ust::make_array( raylib_header_converted ),
				} );

			raylib_wrapper_target.generated_public_header_files.push_back( raylib_header_converted_base_name );

			raylib_wrapper_target.external_libraries.push_back( raylib_compiled );

			if( is_target_windows )
			{
				raylib_wrapper_target.external_libraries.push_back( "gdi32.lib" );
				raylib_wrapper_target.external_libraries.push_back( "user32.lib" );
				raylib_wrapper_target.external_libraries.push_back( "shell32.lib" );
				raylib_wrapper_target.external_libraries.push_back( "winmm.lib" );
			}
			else
			{
				raylib_wrapper_target.external_libraries.push_back( "-ldl" );
			}

			build_targets.push_back( move( raylib_wrapper_target ) );
		}

		//
		// Build targets using raylib
		//

		build_targets.push_back(
			BK::BuildTarget
			{
				.target_type = BK::BuildTargetType::Executable,
				.name= "map_viewer",
				.source_files= ust::make_array</ ust::string8 />( "map_viewer/main.u" ),
				.private_dependencies= ust::make_array(
					BK::DependencyName{ .name= common_lib_target_name },
					BK::DependencyName{ .name= raylib_wrapper_target_name } ),
			} );

		build_targets.push_back(
			BK::BuildTarget
			{
				.target_type = BK::BuildTargetType::Executable,
				.name= "model_viewer",
				.source_files= ust::make_array</ ust::string8 />( "model_viewer/main.u" ),
				.private_dependencies= ust::make_array(
					BK::DependencyName{ .name= common_lib_target_name },
					BK::DependencyName{ .name= raylib_wrapper_target_name } ),
			} );

		build_targets.push_back(
			BK::BuildTarget
			{
				.target_type = BK::BuildTargetType::Executable,
				.name= "billboards_viewer",
				.source_files= ust::make_array</ ust::string8 />( "billboards_viewer/main.u" ),
				.private_dependencies= ust::make_array(
					BK::DependencyName{ .name= common_lib_target_name },
					BK::DependencyName{ .name= raylib_wrapper_target_name } ),
			} );
	}

	//
	// FFmpeg
	//

	var bool mut use_ffmpeg= false;

	var ust::filesystem_path ffmpeg_src_path= ust::path::join( current_package_source_directory, "FFmpeg" );

	if( !build_system_interface.GetConfigurationOption( "disable_ffmpeg" ).empty() )
	{
		build_system_interface.LogInfo( "\"ffmpeg\" is disabled via configuration options, bulding without it" );
	}
	else
	{
		result_match( ust::get_metadata_for_path( ffmpeg_src_path ) )
		{
			Ok(m) ->
			{
				if( m.kind == ust::file_kind::directory )
				{
					use_ffmpeg= true;
					build_system_interface.LogInfo( "Found \"ffmpeg\", bulding with it" );
				}
			},
			Err(e) ->
			{
				ust::ignore_unused(e);
				build_system_interface.LogError( "Failed to find \"ffmpeg\", building without it" );
			}
		}
	}

	var ust::string_view8 ffmpeg_wrapper_target_name= "ffmpeg";

	if( use_ffmpeg )
	{
		var ust::filesystem_path ffmpeg_wrapper_source_path=
			ust::path::join( current_package_source_directory, "ffmpeg_wrapper" );

		var ust::filesystem_path ffmpeg_build_path= ust::path::join( current_package_build_directory, "ffmpeg_build" );

		var ust::filesystem_path ffmpeg_shared_library_path=
			ust::path::join(
				current_package_build_directory,
				( is_target_windows
					? ust::string_view8( "panzer_mortyr_ffmpeg.lib" )
					: ust::string_view8( "panzer_mortyr_ffmpeg.so" ) ) );

		var ust::filesystem_path ffmpeg_config_path= ust::path::join( ffmpeg_build_path, "config.h" );

		if( is_target_windows )
		{
			var ust::filesystem_path build_script=
				ust::path::join( ffmpeg_wrapper_source_path, "build_ffmpeg_windows.bat" );

			var ust::filesystem_path build_script_helper=
				ust::path::join( ffmpeg_wrapper_source_path, "configure_and_make_ffmpeg_windows.sh" );

			var ust::filesystem_path def_file=
				ust::path::join( ffmpeg_wrapper_source_path, "ffmpeg.def" );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= "cmd.exe",
						.command_line=
							ust::make_array</ust::string8/>( "/c", build_script, ffmpeg_src_path, ffmpeg_build_path ),
					},
					.comment= "external ffmpeg",
					.input_files=
						ust::make_array</ust::filesystem_path/>( build_script, build_script_helper, def_file ),
					.output_files=
						ust::make_array</ust::filesystem_path/>( ffmpeg_shared_library_path, ffmpeg_config_path ),
				} );
		}
		else
		{
			var ust::filesystem_path build_script=
				ust::path::join( ffmpeg_wrapper_source_path, "build_ffmpeg_gnu_linux.sh" );

			var ust::filesystem_path exmap_file=
				ust::path::join( ffmpeg_wrapper_source_path, "ffmpeg.exmap" );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= "bash",
						.command_line=
							ust::make_array</ust::string8/>( build_script, ffmpeg_src_path, ffmpeg_build_path ),
					},
					.comment= "external ffmpeg",
					.input_files= ust::make_array</ust::filesystem_path/>( build_script, exmap_file ),
					.output_files=
						ust::make_array</ust::filesystem_path/>( ffmpeg_shared_library_path, ffmpeg_config_path ),
				} );
		}

		var BK::BuildTarget mut ffmpeg_wrapper_target
		{
			.target_type = BK::BuildTargetType::Library,
			.name= ffmpeg_wrapper_target_name,
			.external_libraries= ust::make_array</ ust::filesystem_path />( ffmpeg_shared_library_path ),
		};

		var ust::filesystem_path ffmpeg_header= ust::path::join( ffmpeg_wrapper_source_path, "ffmpeg.h" );

		var ust::filesystem_path ffmpeg_header_converted_base_name= "ffmpeg.iu";

		var ust::filesystem_path ffmpeg_header_converted=
			ust::path::join(
				build_system_interface.GetCurrentPackageBuildTargetGeneratedPublicHeadersDirectory( ffmpeg_wrapper_target_name ),
				ffmpeg_header_converted_base_name );

		ffmpeg_wrapper_target.generated_public_header_files.push_back( ffmpeg_header_converted_base_name );

		build_targets.push_back( move( ffmpeg_wrapper_target ) );

		var [ ust::string8, 10 ] mut ffmpeg_header_command_line
		[
			ffmpeg_header,
			"-o",
			ffmpeg_header_converted,
			"--",
			"-std=c11",
			"-I",
			ust::path::join( ffmpeg_src_path ),
			"-I",
			ffmpeg_build_path,
			GetCPPHeaderConverterTargetOption( target_triple ),
		];

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= cpp_header_converter_path,
					.command_line= move(ffmpeg_header_command_line),
				},
				.comment= ffmpeg_header_converted_base_name,
				.input_files= ust::make_array( ffmpeg_header, ffmpeg_config_path ),
				.output_files= ust::make_array( ffmpeg_header_converted ),
			} );
	}

	//
	// Some helper tools
	//

	{
		auto& cd_image_extractor_source_dir= "cd_image_extractor";

		var BK::BuildTarget mut cd_image_extractor_target
		{
			.target_type = BK::BuildTargetType::Executable,
			.name= "cd_image_extractor",
			.source_files= ust::make_array</ ust::string8 />(
				cd_image_extractor_source_dir + "/main.u",
				cd_image_extractor_source_dir + "/cue_parser.u",
				cd_image_extractor_source_dir + "/cue_tracks_extractor.u",
				cd_image_extractor_source_dir + "/iso_parser.u" ),
			.private_dependencies= ust::make_array( BK::DependencyName{ .name= common_lib_target_name } ),
		};

		if( is_target_windows )
		{
			var ust::filesystem_path res_file_in=
				ust::path::join( current_package_source_directory, cd_image_extractor_source_dir, "res.rc" );

			var ust::filesystem_path icon_file_in=
				ust::path::join( current_package_source_directory, cd_image_extractor_source_dir, "icon.ico" );

			var ust::filesystem_path res_file_out=
				ust::path::join( current_package_build_directory, "cd_image_extractor_res.rc.res" );

			custom_build_steps.push_back(
				BK::CustomBuildStep
				{
					.command= BK::CustomBuildStep::ExeCommand
					{
						.exe_path= llvm_rc_path,
						.command_line= ust::make_array( res_file_in, "/fo", res_file_out ),
					},
					.comment= "cd_image_extractor Windows resource file",
					.input_files= ust::make_array( res_file_in, icon_file_in ),
					.output_files= ust::make_array( res_file_out ),
				} );

			cd_image_extractor_target.external_libraries.push_back( res_file_out );

			WindowsExecutableBuildTargetLinkAgainstStaticMSVCRuntime( cd_image_extractor_target.external_libraries );
		}

		build_targets.push_back( move( cd_image_extractor_target ) );
	}

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type = BK::BuildTargetType::Executable,
			.name= "archive_extractor",
			.source_files= ust::make_array</ ust::string8 />( "archive_extractor/main.u" ),
			.private_dependencies= ust::make_array( BK::DependencyName{ .name= common_lib_target_name } ),
		} );

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type= BK::BuildTargetType::Executable,
			.name= "map_stats",
			.source_files= ust::make_array</ ust::string8 />( "map_stats/main.u" ),
			.private_dependencies= ust::make_array( BK::DependencyName{ .name= common_lib_target_name } )
		} );

	//
	// PanzerMortyr
	//

	var [ ust::filesystem_path_view, 97 ] panzer_mortyr_source_files
	[
		"abstract_hud_drawer.u",
		"audio_mixer.u",
		"audio_out.u",
		"audio_processor.u",
		"audio_stream.u",
		"billboards.u",
		"breaking_glass.u",
		"caching_game_resources_loader.u",
		"camera_controller.u",
		"camera_utils.u",
		"cinematics.u",
		"clipping_polygon.u",
		"collisions.u",
		"command_line_options.u",
		"console.u",
		"console_out.u",
		"crosshair_drawer.u",
		"debug_visualization.u",
		"decals.u",
		"display_modes.u",
		"drawers_factory.u",
		"drawing_gl/buffer_object.u",
		"drawing_gl/buffer_utils.u",
		"drawing_gl/caustics.u",
		"drawing_gl/drawers_factory_gl.u",
		"drawing_gl/gl_capabilities.u",
		"drawing_gl/gl_functions.u",
		"drawing_gl/gl_state.u",
		"drawing_gl/gpu_model.u",
		"drawing_gl/hud_drawer_gl.u",
		"drawing_gl/image_drawer_gl.u",
		"drawing_gl/shader_program.u",
		"drawing_gl/sky.u",
		"drawing_gl/text_drawer_gl.u",
		"drawing_gl/texture.u",
		"drawing_gl/vertex_array_object.u",
		"drawing_gl/video_player_gl.u",
		"drawing_gl/window_gl.u",
		"drawing_gl/world_drawer_gl.u",
		"drawing_soft/drawers_factory_soft.u",
		"drawing_soft/hud_drawer_soft.u",
		"drawing_soft/image_drawer_soft.u",
		"drawing_soft/text_drawer_soft.u",
		"drawing_soft/video_player_soft.u",
		"drawing_soft/window_soft.u",
		"drawing_soft/world_drawer_soft.u",
		"entities_description_file.u",
		"extra_string_table.u",
		"fog.u",
		"game.u",
		"game_archive_filesystem.u",
		"game_data_search.u",
		"game_event_notification_drawer.u",
		"game_filesystem.u",
		"game_logic.u",
		"game_logic_sound.u",
		"game_state_view_construction.u",
		"geometry_utils.u",
		"global_navigation_graph_building.u",
		"global_navigation_graph_debug_visualization.u",
		"global_navigation_graph_utils.u",
		"image_loading.u",
		"image_saving.u",
		"input_state.u",
		"key_binding.u",
		"lighting.u",
		"loading_screen.u",
		"main.u",
		"map_quad_utils.u",
		"map_visibility_calculator.u",
		"map_visibility_visualization.u",
		"materials_property_file.u",
		"menu.u",
		"message_box.u",
		"music_streamer.u",
		"performance_counter.u",
		"physics_utils.u",
		"player_movement_controller.u",
		"player_tool_controller.u",
		"quads_hierarchy.u",
		"random.u",
		"regional_version.u",
		"room_clusters_bsp_tree.u",
		"room_clusters_bsp_tree_visualization.u",
		"room_clusters_hierarchy.u",
		"save_load.u",
		"savegame_screenshot.u",
		"settings.u",
		"sound_loading.u",
		"sounds_description_file.u",
		"spectator_mode.u",
		"string_table.u",
		"text_drawer_common.u",
		"triangles_sorting.u",
		"water_circles_hierarchy.u",
		"window_common.u",
		"world_audio_info_construction.u",
	];

	auto& panzer_mortir_source_dir= "panzer_mortyr";

	var ust::vector</ust::filesystem_path/> mut panzer_mortyr_source_files_full;

	foreach( &f : panzer_mortyr_source_files )
	{
		panzer_mortyr_source_files_full.push_back( ust::path::join( panzer_mortir_source_dir, f ) );
	}

	if( use_ffmpeg )
	{
		panzer_mortyr_source_files_full.push_back( ust::path::join( panzer_mortir_source_dir, "video_stream_ffmpeg.u" ) );
	}
	else
	{
		panzer_mortyr_source_files_full.push_back( ust::path::join( panzer_mortir_source_dir, "video_stream_stub.u" ) );
	}

	var ust::vector</ ust::filesystem_path /> mut panzer_mortyr_external_libraries;

	if( is_target_windows )
	{
		var ust::filesystem_path res_file_in=
			ust::path::join( current_package_source_directory, panzer_mortir_source_dir, "res.rc" );

		var ust::filesystem_path icon_file_in=
			ust::path::join( current_package_source_directory, panzer_mortir_source_dir, "icon.ico" );

		var ust::filesystem_path res_file_out=
			ust::path::join( current_package_build_directory, "panzer_mortyr_res.rc.res" );

		custom_build_steps.push_back(
			BK::CustomBuildStep
			{
				.command= BK::CustomBuildStep::ExeCommand
				{
					.exe_path= llvm_rc_path,
					.command_line= ust::make_array( res_file_in, "/fo", res_file_out ),
				},
				.comment= "panzer_mortyr Windows resource file",
				.input_files= ust::make_array( res_file_in, icon_file_in ),
				.output_files= ust::make_array( res_file_out ),
			} );

		panzer_mortyr_external_libraries.push_back( res_file_out );

		// Request 8MB of stack on the main thread.
		// We require so much, since we allocate heavy game structures on stack.
		panzer_mortyr_external_libraries.push_back( "-stack:8388608" );

		WindowsExecutableBuildTargetLinkAgainstStaticMSVCRuntime( panzer_mortyr_external_libraries );
	}
	else
	{
		// Set "rpath" to "$ORIGIN" to be able to load shared libraries from the same directory where the executable is located.
		panzer_mortyr_external_libraries.push_back( "-rpath=$ORIGIN" );
	}

	var ust::vector</ BK::DependencyName /> mut panzer_mortyr_dependencies=
		ust::make_array(
			BK::DependencyName{ .name= common_lib_target_name },
			BK::DependencyName{ .name= sdl_wrapper_target_name } );

	if( use_ffmpeg )
	{
		panzer_mortyr_dependencies.push_back( BK::DependencyName{ .name= ffmpeg_wrapper_target_name } );
	}

	build_targets.push_back(
		BK::BuildTarget
		{
			.target_type = BK::BuildTargetType::Executable,
			.name= "panzer_mortyr",
			.source_files= move( panzer_mortyr_source_files_full ),
			.private_dependencies= move( panzer_mortyr_dependencies ),
			.external_libraries= move( panzer_mortyr_external_libraries ),
		} );

	return BK::PackageInfo{ .build_targets= move( build_targets ), .custom_build_steps= move( custom_build_steps ) };
}

fn GetCPPHeaderConverterTargetOption( BK::TargetTriple& target_triple ) : ust::string8
{
	// Set clang "--target" option matching our current target triple.
	return
		ust::concat(
			"--target=",
			target_triple.architecture,
			"-",
			target_triple.vendor,
			"-",
			target_triple.operating_system,
			"-",
			target_triple.environment );
}

var bool is_host_windows= ust::constexpr_string_equals( compiler::target::os, "windows" );

template</size_type N/>
fn enable_if( is_host_windows ) GetExecutableFullName( [ char8, N ]& base_name ) : [ char8, N + 4s ]
{
	return base_name + ".exe";
}

template</size_type N/>
fn enable_if( !is_host_windows ) GetExecutableFullName( [ char8, N ]& base_name ) : [ char8, N ]
{
	return base_name;
}

fn WindowsExecutableBuildTargetLinkAgainstStaticMSVCRuntime(
	ust::vector</ ust::filesystem_path /> &mut external_libraries )
{
	// Disable "-defaultlib:libcmt" used by-default by Ü compiler.
	external_libraries.push_back( "-nodefaultlib:msvcrt" );
	// Enable "libcmt" instead of it.
	external_libraries.push_back( "-defaultlib:libcmt" );
}
