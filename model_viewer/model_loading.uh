import "/path.u"
import "/vector.u"
import "model_file.uh"

namespace PM
{

struct ModelData
{
	u32 num_vertices;
	u32 num_frames;

	// The actual triangles list contains lod0 triangles first, than lods data.
	u32 num_lod0_triangles;

	// Size is equal to number of all triangles.
	ust::vector</ObbTriangle/> triangles;

	// Size is equal to number of vertices.
	ust::vector</ObbVertexTextureCoordinates/> texture_coordinates;

	// Vertex positions data for frames (frame by frame).
	// Contains num_vertices * num_frames values.
	ust::vector</ObbVertexPosition/> vertex_positions_data;

	// Normals data for frames (frame by frame).
	// Contains num_vertices * num_frames values.
	ust::vector</ObbPerFrameTriangleNormal/> per_frame_triangle_normals;

	// Has values in range 1 to number of vertices + 10 (inclusive).
	// It doesn't look like some sort of nearby triangle index.
	// It may be some sort of adaptive LOD data.
	ust::vector</u32/> some_per_triangle_ints;

	// Has values in range number of vertices + 10 to number of triangles (inclusive).
	// It doesn't look like some sort of nearby vertex index.
	// It may be some sort of adaptive LOD data.
	ust::vector</u32/> some_per_vertex_ints;

	// A model usually has single texture collections, but it may be more (like for multiplayer character models).
	ust::vector</TextureCollection/> texture_collections;

	struct TextureCollection
	{
		TextureData ld_texture;

		// They are identical or almost identical.
		[ TextureData, 3 ] hd_textures;
	}

	struct TextureData
	{
		// Zero size means texture is skipped.
		[ u32, 2 ] size= zero_init;

		// Indexed image data (stored in row-per-row order).
		ust::vector</u8/> pixels_data;

		// Seems to be a palette in BGR format.
		[ u8, 768 ] palette= zero_init;
	}
}

fn LoadModel( ust::filesystem_path_view file_path ) : ust::optional</ModelData/>;

} // namespace PM
