namespace PM
{

struct ObbFileHeaderBase ordered
{
	auto c_expected_signature= "MORS";

	auto c_version4= 4u;
	auto c_version5= 5u;

	[ char8, 4 ] signature;

	 // Offset of texture data, starting from position after this structure.
	u32 texture_data_offset;

	// For now only versions 4 and 5 are known.
	// Version 5 is almost like version 4, byt extended header is a little bit longer and there is additional LOD data stored before texture data.
	u32 version_number;

	// It's usually "CODY".
	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ObbFileHeaderBase/>.size_of == 16s );

struct ObbFileHeaderExtended ordered
{
	var size_type c_size_version4= 24s * 4s;
	var size_type c_size_version5= 26s * 4s;

	// Fields with names ending with *_offset4 are offsets in 4-byte elements (DWORDS, u32-s) starting from this header end.

	u32 num_frames;
	i32 unknown01; // seems to be always 1.
	i32 unknown02; // seems to be always -1.
	u32 frame_postions_offset4;
	u32 frame_normals_offset4;
	i32 unknown05; // seems to be always -1
	u32 unknown06; // a small number, which is likely smaller than number of vertices/indices
	i32 texture_data_offset4;
	u32 num_vertices;
	u32 num_triangles;
	u32 this_struct_size4;
	u32 texture_coordinates_offset4;
	u32 unknown12; // Seems to be always 16777215. Maybe it's some sort of RGB-color?
	i32 unknown13; // seems to be always -1
	[ u32, 2 ] ld_texture_size;
	i32 unknown16; // looks like it's always 8
	u32 num_texture_collections; // usually it's 1, but it may be more.
	[ [ u32, 2 ], 3 ] hd_texture_sizes;
	// The two fields below are present only in format version 5.
	u32 per_triangle_ints_offset4;
	u32 per_vertex_ints_offset4;
}

static_assert( typeinfo</ObbFileHeaderExtended/>.size_of == 26s * 4s );

// A triangle is represented as 3 indices for vertices.
// For some reason  they are multiplied by 2 and thus should be divided to access vertices array.
type ObbTriangle= [ u32, 3 ];

static_assert( typeinfo</ObbTriangle/>.size_of == 12s );

type ObbVertexTextureCoordinates= [ f32, 2 ];

static_assert( typeinfo</ObbVertexTextureCoordinates/>.size_of == 8s );

struct ObbVertexPosition ordered
{
	[ f32, 3 ] coords;

	// Contains numbers in range 0 to 16383.
	// It seems to be normal angles packed into one number, lower 7 bits are asimuth, upper 7 bits are elevation.
	//
	// For some reason this normals aren't always correct.
	// They are wrong on some parts of models (like guns).
	// They are also broken in animation frames of dying characters.
	// Maybe it's normal relative to some reference frame (like texture basis?).
	u32 packed_normal_angles;
}

static_assert( typeinfo</ObbVertexPosition/>.size_of == 16s );

// Normal for each triangle for each frame (in polar coordinates).
struct ObbPerFrameTriangleNormal ordered
{
	// Azimuth in range 0 to 1023 mapped to 0 to TAU. Sometimes slightly negative values are possible.
	i16 azimuth;
	// Elevation in range 0 to 1023 mapped to 0 to TAU. Sometimes slightly negative values are possible.
	i16 elevation;
}

} // namespace PM
