namespace PM
{

struct ObbFileHeader ordered
{
	auto c_expected_signature= "MORS";

	[ char8, 4 ] signature;
	u32 num0; // Seems to be equal to offset of texture data - 16.
	u32 num1; // Seems to be always 5.

	[ char8, 4 ] body_marker;

	// more_data[0] is 1 for simple models, it's more for models of characters. Maybe it's frame count?
	// more_data[1] seems to be always 1.
	// more_data[2] seems to be always -1.
	// more_data[6] - a small number, which is likely smaller than number of vertices/indices.
	// more_data[8] - seems to be number of vertices.
	// more_data[9] - seems to be number of indices.
	// more_data[11] seems to be always 26.
	// more_data[13] seems to be always 16777215.
	// more_data[14] seems to be always -1.
	// more_data[15], more_data[16] - small texture dimensions.
	// data[17] - looks like it's always 8.
	// data[18] - looks like it's always 1.
	// more_data[19], more_data[20] - large texture dimensions.
	// more_data[21], more_data[22] - large texture dimensions.
	// more_data[23], more_data[24] - large texture dimensions.
	[ i32, 26 ] more_data;
}

// TODO - check if it's really only 16 bytes long.
//static_assert( typeinfo</ObbFileHeader/>.size_of == 120s );

struct ObbTriangle ordered
{
	[ i32, 3 ] indices;
}

static_assert( typeinfo</ObbTriangle/>.size_of == 12s );

type ObbVertexTextureCoordinates= [ f32, 2 ];

static_assert( typeinfo</ObbVertexTextureCoordinates/>.size_of == 8s );

type ObbVertexPosition= [ f32, 4 ];

static_assert( typeinfo</ObbVertexPosition/>.size_of == 16s );

type ObbStruct3= [ u8, 4 ];

} // namespace PM
