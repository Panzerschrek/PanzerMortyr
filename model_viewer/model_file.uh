namespace PM
{

struct ObbFileHeader ordered
{
	auto c_expected_signature= "MORS";

	[ char8, 4 ] signature;
	u32 num0;
	u32 num1;

	[ char8, 4 ] body_marker;
}

// TODO - check if it's really only 16 bytes long.
static_assert( typeinfo</ObbFileHeader/>.size_of == 16s );

struct ObbTriangle
{
	[ i32, 3 ] indices;
}

static_assert( typeinfo</ObbTriangle/>.size_of == 12s );

struct ObbVertex
{
	[ i8, 4 ] coords;
}

static_assert( typeinfo</ObbVertex/>.size_of == 4s );

} // namespace PM
