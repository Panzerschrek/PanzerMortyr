namespace PM
{

struct ObbFileHeaderBase ordered
{
	auto c_expected_signature= "MORS";

	[ char8, 4 ] signature;

	 // Offset of texture data, starting from position after this structure.
	u32 texture_data_offset;

	 // Seems to be always 5. Maybe it's version number?
	u32 num1;

	// It's usually "CODY".
	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ObbFileHeaderBase/>.size_of == 16s );

struct ObbFileHeaderExtended ordered
{
	// more_data[0] is frame count.
	// more_data[1] seems to be always 1.
	// more_data[2] seems to be always -1.
	// more_data[3] * 4 is equal to 26 + more_data[9] * 3 + more_data[8] * 2.
	// more_data[4] - more_data[3] is equal to more_data[0] * more_data[8] * 4.
	// more_data[5] seems to be always -1.
	// more_data[6] - a small number, which is likely smaller than number of vertices/indices.
	// more_data[8] - seems to be number of vertices.
	// more_data[9] - seems to be number of triangles.
	// more_data[10] seems to be always 26.
	// more_data[11] is always equal to more_data[9] * 3 + 26.
	// more_data[12] seems to be always 16777215.
	// more_data[13] seems to be always -1.
	// more_data[14], more_data[15] - small texture dimensions.
	// data[16] - looks like it's always 8.
	// data[17] - looks like it's number if HD texture triplets. Most models has only 1, but some has much more.
	// more_data[18], more_data[19] - large texture dimensions.
	// more_data[20], more_data[21] - large texture dimensions.
	// more_data[22], more_data[23] - large texture dimensions.
	// more_data[25] - more_data[24] is equal to number of triangles.
	// ( num0 - more_data[25] * 4 ) / 4 is equal to number of vertices.

	i32 num_frames;
	i32 unknown01;
	i32 unknown02;
	i32 unknown03;
	i32 unknown04;
	i32 unknown05;
	i32 unknown06;
	i32 unknown07;
	i32 num_vertices;
	i32 num_triangles;
	i32 unknown10;
	i32 unknown11;
	i32 unknown12;
	i32 unknown13;
	[ i32, 2 ] ld_texture_size;
	i32 unknown16;
	i32 num_texture_collections;
	[ [ i32, 2 ], 3 ] hd_texture_sizes;
	i32 unknown24;
	i32 unknown25;
}

static_assert( typeinfo</ObbFileHeaderExtended/>.size_of == 26s * 4s );

// A triangle is represented as 3 indices for vertices.
// For some reason  they are multiplied by 2 and thus should be divided to access vertices array.
type ObbTriangle= [ u32, 3 ];

static_assert( typeinfo</ObbTriangle/>.size_of == 12s );

type ObbVertexTextureCoordinates= [ f32, 2 ];

static_assert( typeinfo</ObbVertexTextureCoordinates/>.size_of == 8s );

type ObbVertexPosition= [ f32, 4 ];

static_assert( typeinfo</ObbVertexPosition/>.size_of == 16s );

// Normal for each triangle for each frame (in polar coordinates).
struct ObbPerFrameTriangleNormal
{
	// Azimuth in range 0 to 1023 mapped to 0 to TAU. Sometimes slightly negative values are possible.
	i16 azimuth;
	// Elevation in range 0 to 1023 mapped to 0 to TAU. Sometimes slightly negative values are possible.
	i16 elevation;
}

} // namespace PM
