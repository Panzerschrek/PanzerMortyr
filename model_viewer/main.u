import "/enum_string_conversions.u"
import "/file.u"
import "/file_helpers.u"
import "/main_wrapper.u"
import "/scoped_array.u"
import "/stdout.u"
import "/string_conversions.u"

import "/raylib_wrapper/raylib.uh"

import "model_file.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}

	var ust::filesystem_path_view model_file_path= args[1s];

	auto model_opt= LoadModel( model_file_path );
	if( model_opt.empty() )
	{
		return -1;
	}

	var ModelData& model= model_opt.try_deref();

	ust::stdout_print( ust::concat( "Num vertices: ", ust::to_string8( model.vertices.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num triangles: ", ust::to_string8( model.triangles.size() ), "\n" ) );

	if( false )
	{
		foreach( &t : model.triangles )
		{
			ust::stdout_print( ust::concat( "( ", ust::to_string8(t.indices[0]), ", ", ust::to_string8(t.indices[1]), ", ", ust::to_string8(t.indices[2]), " ); " ) );
		}

		ust::stderr_print( "\n" );
	}

	if( false )
	{
		var [ f32, 2 ] mut mins[ 9999.0f, 9999.0f ], mut maxs[ -9999.0f, -9999.0f ];
		foreach( &tc : model.texture_coordinates )
		{
			ust::min_assign( mins[0], tc[0] );
			ust::max_assign( maxs[0], tc[0] );
			ust::min_assign( mins[1], tc[1] );
			ust::max_assign( maxs[1], tc[1] );
		}
		for( auto mut i= 0s; i < 2s; ++i )
		{
			ust::stdout_print( ust::concat( "TC range ", ust::to_string8(i32(mins[i] * 1000.0f)), " to ", ust::to_string8(i32(maxs[i] * 1000.0f)), "\n" ) );
		}
	}

	if( true )
	{
		var i32 mut max_index= -10000;
		var size_type mut num_even_indices= 0s;
		foreach( &t : model.triangles )
		{
			foreach( index : t.indices )
			{
				ust::max_assign( max_index, index );
				if( (index & 1 ) == 0 )
				{
					++num_even_indices;
				}
			}
		}

		ust::stdout_print( ust::concat( "Max index is ", ust::to_string8(max_index), "\n" ) );
		ust::stdout_print( ust::concat( "Num even indices is ", ust::to_string8(num_even_indices), "\n" ) );
	}

	if( false )
	{
		ust::stdout_print( "Structs3: " );
		foreach( &s : model.structs3 )
		{
			ust::stderr_print( ust::concat( ust::concat( "( ", ust::to_string8( s[0] ), ", ", ust::to_string8( s[1] ), " ); " ) ) );
		}
		ust::stdout_print( "\n" );
	}

	if( false )
	{
		var [ i32, 2 ] mut mins[ 999999, 999999 ], mut maxs[ -999999, -999999 ];

		foreach( &s : model.structs3 )
		{
			ust::min_assign( mins[0], i32( s[0] ) );
			ust::max_assign( maxs[0], i32( s[0] ) );
			ust::min_assign( mins[1], i32( s[1] ) );
			ust::max_assign( maxs[1], i32( s[1] ) );
		}

		for( auto mut i= 0s; i < 2s; ++i )
		{
			ust::stdout_print( ust::concat( "Struct3 field range: ", ust::to_string8(mins[i]), " to ", ust::to_string8(maxs[i]), "\n" ) );
		}
	}

	unsafe( SetTraceLogLevel( i32( LOG_WARNING ) ) ); // Disable info and verbose log messages from Raylib.

	var i32 screen_width = 1024;
	var i32 screen_height = 768;
	unsafe( InitWindow( screen_width, screen_height, $<( cast_mut( "PanzerMortyr ModelViewer\0"[0] ) ) ) );

	if( !compiler::options::generate_debug_info )
	{
		unsafe( DisableCursor() );
	}

	unsafe( SetTargetFPS(60) );

	var ust::vector</f32/> mut mesh_positions;
	var ust::vector</f32/> mut mesh_texture_coordinates;
	foreach( pair : model.vertices.iter().zip( model.texture_coordinates.iter() ) )
	{
		mesh_positions.push_back( pair.first[0] );
		mesh_positions.push_back( pair.first[1] );
		mesh_positions.push_back( pair.first[2] );
		mesh_texture_coordinates.push_back( pair.second[0] );
		mesh_texture_coordinates.push_back( pair.second[1] );
	}

	var ust::vector</u16/> mut mesh_indices;
	foreach( &t : model.triangles )
	{
		mesh_indices.push_back( u16( t.indices[2] >> 1 ) );
		mesh_indices.push_back( u16( t.indices[1] >> 1 ) );
		mesh_indices.push_back( u16( t.indices[0] >> 1 ) );
	}

	var Mesh mut mesh= zero_init;
	mesh.vertexCount= i32( model.vertices.size() );
	mesh.vertices= unsafe( mesh_positions.data() );
	mesh.texcoords= unsafe( mesh_texture_coordinates.data() );
	mesh.triangleCount= i32( model.triangles.size() );
	mesh.indices= unsafe( mesh_indices.data() );

	unsafe( UploadMesh( $<(mesh), false ) );

	auto mut model_file_contents= ust::read_file_to_byte8_vector( model_file_path ).try_take();
	var size_type width= 512s;
	var size_type size_corrected= ( model_file_contents.size() + ( width - 1s ) ) / width * width;
	model_file_contents.resize( size_corrected, byte8(0u8) );

	var Image zmap_lam_image
	{
		.data= unsafe( model_file_contents.data() ),
		.mipmaps= 1,
		.width(width),
		.height( model_file_contents.size() / width ),
		.format( PIXELFORMAT_UNCOMPRESSED_GRAYSCALE ),
	};

	var Texture model_raw_data_texture= unsafe( LoadTextureFromImage( zmap_lam_image ) );

	var [ Material, 4 ] mut materials= zero_init;

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var size_type texture_size= 256s;
		scoped_array u8 mut texture_data_rgb[ texture_size * texture_size * 3s ]( 0u8 );

		var TextureData& src_texture_data= model.hd_textures[i];

		for( auto mut i= 0s; i < texture_size * texture_size; ++i )
		{
			var size_type index( src_texture_data.data[ i ] );
			texture_data_rgb[ i * 3s + 0s ]= src_texture_data.palette[ index * 3s + 2s ];
			texture_data_rgb[ i * 3s + 1s ]= src_texture_data.palette[ index * 3s + 1s ];
			texture_data_rgb[ i * 3s + 2s ]= src_texture_data.palette[ index * 3s + 0s ];
		}

		var Image texture_image
		{
			.data= unsafe( ust::ptr_cast_to_byte8( texture_data_rgb.data() ) ),
			.mipmaps= 1,
			.width(texture_size),
			.height(texture_size),
			.format( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ),
		};

		var Texture texture= unsafe( LoadTextureFromImage( texture_image ) );

		var Material material= unsafe( LoadMaterialDefault() );

		unsafe{ $>( material.maps ).texture = texture; }

		materials[i]= material;
	}

	{
		var size_type texture_size= 128s;
		scoped_array u8 mut texture_data_rgb[ texture_size * texture_size * 3s ]( 0u8 );

		var TextureData& src_texture_data= model.ld_texture;

		for( auto mut i= 0s; i < texture_size * texture_size; ++i )
		{
			var size_type index( src_texture_data.data[ i ] );
			texture_data_rgb[ i * 3s + 0s ]= src_texture_data.palette[ index * 3s + 2s ];
			texture_data_rgb[ i * 3s + 1s ]= src_texture_data.palette[ index * 3s + 1s ];
			texture_data_rgb[ i * 3s + 2s ]= src_texture_data.palette[ index * 3s + 0s ];
		}

		var Image texture_image
		{
			.data= unsafe( ust::ptr_cast_to_byte8( texture_data_rgb.data() ) ),
			.mipmaps= 1,
			.width(texture_size),
			.height(texture_size),
			.format( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ),
		};

		var Texture texture= unsafe( LoadTextureFromImage( texture_image ) );

		var Material material= unsafe( LoadMaterialDefault() );

		unsafe{ $>( material.maps ).texture = texture; }

		materials[3]= material;
	}

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	var size_type mut offset= 0s;

	var size_type mut material_index= 0s;

	var bool mut is_simple_mode= false;

	while( ! unsafe( WindowShouldClose() ) )
	{
		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		if( unsafe( IsKeyPressed( i32( 'Z' ) ) ) )
		{
			offset+= 1s;
			ust::stdout_print( ust::concat( "Offset is ", ust::to_string8(offset), "\n" ) );
		}

		if( unsafe( IsKeyPressed( i32( 'M' ) ) ) )
		{
			is_simple_mode = !is_simple_mode;
		}
		if( unsafe( IsKeyPressed( i32( 'T' ) ) ) )
		{
			++material_index;
		}

		unsafe( BeginDrawing() );
		{
			unsafe( ClearBackground( Color{ .r(32), .g(16), .b(8), .a(0) } ) );

			unsafe( DrawTexture( model_raw_data_texture, 0, 0, Color{ .r(255), .g(255), .b(255), .a(255) } ) );

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawCube( Vector3{ .x(1), .y(0), .z(0) }, 2.0f, 0.2f, 0.2f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(1), .z(0) }, 0.2f, 2.0f, 0.2f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(0), .z(1) }, 0.2f, 0.2f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );

				var f32 scale= 1.0f / 1.0f;

				foreach( &v : model.vertices.range() )
				{
					unsafe( DrawCubeWires(
						Vector3{ .x= f32(v[0]) * scale, .y= f32(v[1]) * scale, .z= f32(v[2]) * -scale },
						0.1f,
						0.1f,
						0.1f,
						Color{ .r(255), .g(0), .b(255), .a(255) } ) );
				}

				if( is_simple_mode )
				{
					foreach( &t : model.triangles )
					{
						var ObbVertexPosition& v0= model.vertices[ size_type( t.indices[0] ) / 2s ];
						var ObbVertexPosition& v1= model.vertices[ size_type( t.indices[1] ) / 2s ];
						var ObbVertexPosition& v2= model.vertices[ size_type( t.indices[2] ) / 2s ];

						var Vector3 p0{ .x= v0[0] * scale, .y= v0[1s] * scale, .z= v0[2] * -scale };
						var Vector3 p1{ .x= v1[0] * scale, .y= v1[1s] * scale, .z= v1[2] * -scale };
						var Vector3 p2{ .x= v2[0] * scale, .y= v2[1s] * scale, .z= v2[2] * -scale };

						var Color c{ .r(128), .g(128), .b(128), .a(128) };

						unsafe( DrawTriangle3D( p2, p1, p0, c ) );
					}
				}
				else
				{
					var Matrix mut matrix= zero_init;
					matrix.m0= scale;
					matrix.m5= scale;
					matrix.m10= -scale; // The original game seems to use Z down coordinate system. Flip it to be order to be displayed in OpenGL.
					matrix.m15= 1.0f;

					unsafe( DrawMesh( mesh, materials[ material_index % 4s ], matrix ) );
				}
			}
			unsafe( EndMode3D() );
		}
		unsafe( EndDrawing() );
	}

	// Do not care freeng here raylib objects like meshes, materials, textures. We quit anyway and this should release all resoources (even GPU-related).

	unsafe( CloseWindow() );

	return 0;
}

struct ModelData
{
	ust::vector</ObbTriangle/> triangles;
	ust::vector</ObbVertexTextureCoordinates/> texture_coordinates;
	ust::vector</ObbVertexPosition/> vertices;
	ust::vector</ObbStruct3/> structs3;

	TextureData ld_texture;

	// They are identical or almost identical.
	[ TextureData, 3 ] hd_textures;
}

struct TextureData
{
	ust::vector</u8/> data;
	[ u8, 768 ] palette= zero_init;
}

fn LoadModel( ust::filesystem_path_view file_path ) : ust::optional</ModelData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadModel( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadModel( ust::file_readable mut f ) : ust::optional</ModelData/>
{
	var ObbFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ObbFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading model file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ObbFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "Model header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num1 );
		m+= "\n";
		ust::stdout_print( m );

		ust::stdout_print( "Model extra nums:\n" );
		foreach( &n : header.more_data )
		{
			ust::stdout_print( ust::concat( ust::to_string8( n ), "\n" ) );
		}
	}

	var ModelData mut result;

	var size_type num_triangles( header.more_data[9] );

	result.triangles.resize( size_type( num_triangles ), ust::make_zeroed</ObbTriangle/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.triangles.data() ),
				result.triangles.size() * typeinfo</ObbTriangle/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	var size_type num_vertices( header.more_data[8] );

	result.texture_coordinates.resize( num_vertices, ust::make_zeroed</ObbVertexTextureCoordinates/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.texture_coordinates.data() ),
				result.texture_coordinates.size() * typeinfo</ObbVertexTextureCoordinates/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	result.vertices.resize( num_vertices, ust::make_zeroed</ObbVertexPosition/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.vertices.data() ),
				result.vertices.size() * typeinfo</ObbVertexPosition/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	result.structs3.resize( num_triangles, ust::make_zeroed</ObbStruct3/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs3.data() ),
				result.structs3.size() * typeinfo</ObbStruct3/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	// There is still at least one block of data before textures data, which likely contains some integer values.

	if_var( e : f.seek( u64( header.num0 ) + 16u64 ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to seek! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	result.ld_texture.data.resize( 128s * 128s, 0u8 );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.ld_texture.data.data() ),
				result.ld_texture.data.size() * typeinfo</u8/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<( result.ld_texture.palette ) ),
				typeinfo</ typeof( result.ld_texture.palette ) />.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var TextureData &mut texture_data= result.hd_textures[i];

		texture_data.data.resize( 256s * 256s, 0u8 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( texture_data.data.data() ),
					texture_data.data.size() * typeinfo</u8/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( $<( texture_data.palette ) ),
					typeinfo</ typeof( texture_data.palette ) />.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}

	return result;
}

} // namespace PM
