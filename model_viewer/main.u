import "/enum_string_conversions.u"
import "/file.u"
import "/file_helpers.u"
import "/main_wrapper.u"
import "/math.u"
import "/scoped_array.u"
import "/stdout.u"
import "/string_conversions.u"

import "/raylib_wrapper/raylib.uh"

import "model_file.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}

	var ust::filesystem_path_view model_file_path= args[1s];

	auto model_opt= LoadModel( model_file_path );
	if( model_opt.empty() )
	{
		return -1;
	}

	var ModelData& model= model_opt.try_deref();

	ust::stdout_print( ust::concat( "Num vertices: ", ust::to_string8( model.num_vertices ), "\n" ) );
	ust::stdout_print( ust::concat( "Num frames: ", ust::to_string8( model.num_frames ), "\n" ) );
	ust::stdout_print( ust::concat( "Num total frame vertices: ", ust::to_string8( model.num_vertices * model.num_frames ), "\n" ) );
	ust::stdout_print( ust::concat( "Num triangles: ", ust::to_string8( model.triangles.size() ), "\n" ) );

	if( false )
	{
		foreach( &t : model.triangles )
		{
			ust::stdout_print( ust::concat( "( ", ust::to_string8(t.indices[0]), ", ", ust::to_string8(t.indices[1]), ", ", ust::to_string8(t.indices[2]), " ); " ) );
		}

		ust::stderr_print( "\n" );
	}

	if( false )
	{
		var [ f32, 2 ] mut mins[ 9999.0f, 9999.0f ], mut maxs[ -9999.0f, -9999.0f ];
		foreach( &tc : model.texture_coordinates )
		{
			ust::min_assign( mins[0], tc[0] );
			ust::max_assign( maxs[0], tc[0] );
			ust::min_assign( mins[1], tc[1] );
			ust::max_assign( maxs[1], tc[1] );
		}
		for( auto mut i= 0s; i < 2s; ++i )
		{
			ust::stdout_print( ust::concat( "TC range ", ust::to_string8(i32(mins[i] * 1000.0f)), " to ", ust::to_string8(i32(maxs[i] * 1000.0f)), "\n" ) );
		}
	}

	if( true )
	{
		var i32 mut min_index= 1000000, mut max_index= -1000000;
		var size_type mut num_even_indices= 0s;
		foreach( &t : model.triangles )
		{
			foreach( index : t.indices )
			{
				ust::min_assign( min_index, index );
				ust::max_assign( max_index, index );
				if( (index & 1 ) == 0 )
				{
					++num_even_indices;
				}
			}
		}

		ust::stdout_print( ust::concat( "Min index is ", ust::to_string8(min_index), "\n" ) );
		ust::stdout_print( ust::concat( "Max index is ", ust::to_string8(max_index), "\n" ) );
		ust::stdout_print( ust::concat( "Num even indices is ", ust::to_string8(num_even_indices), "\n" ) );
	}

	if( false )
	{
		ust::stdout_print( "Structs3: " );
		foreach( &s : model.per_frame_triangle_normals )
		{
			ust::stderr_print( ust::concat( ust::concat( "( ", ust::to_string8( s.azimuth ), ", ", ust::to_string8( s.elevation ), " ); " ) ) );
		}
		ust::stdout_print( "\n" );
	}

	if( true )
	{
		var [ i32, 2 ] mut mins[ 999999, 999999 ], mut maxs[ -999999, -999999 ];

		foreach( &s : model.per_frame_triangle_normals )
		{
			ust::min_assign( mins[0], i32( s.azimuth ) );
			ust::max_assign( maxs[0], i32( s.azimuth ) );
			ust::min_assign( mins[1], i32( s.elevation ) );
			ust::max_assign( maxs[1], i32( s.elevation ) );
		}

		for( auto mut i= 0s; i < 2s; ++i )
		{
			ust::stdout_print( ust::concat( "Struct3 field range: ", ust::to_string8(mins[i]), " to ", ust::to_string8(maxs[i]), "\n" ) );
		}
	}

	if( true )
	{
		var i32 mut min= 0x7FFFFFFF, mut max= -0x7FFFFFFF;
		foreach( n : model.some_per_vertex_ints )
		{
			ust::min_assign( min, n );
			ust::max_assign( max, n );
		}
		ust::stdout_print( ust::concat( "Per-vertex ints are in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
	}
	if( true )
	{
		var i32 mut min= 0x7FFFFFFF, mut max= -0x7FFFFFFF;
		foreach( n : model.some_per_triangle_ints )
		{
			ust::min_assign( min, n );
			ust::max_assign( max, n );
		}
		ust::stdout_print( ust::concat( "Per-triangle ints are in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
	}
	if( false )
	{
		ust::stdout_print( "Per-vertex ints are:\n" );
		for( auto mut i= 0s; i < model.some_per_vertex_ints.size(); ++i )
		{
			ust::stdout_print( ust::concat( ust::to_string8( i ), ": ", ust::to_string8( model.some_per_vertex_ints[i] ), "\n" ) );
		}
		ust::stdout_print( "\n" );
	}
	if( false )
	{
		ust::stdout_print( "Per-triangle ints are:\n" );
		for( auto mut i= 0s; i < model.some_per_triangle_ints.size(); ++i )
		{
			ust::stdout_print( ust::concat( ust::to_string8( i ), ": ", ust::to_string8( model.some_per_triangle_ints[i] ), "\n" ) );
		}
		ust::stdout_print( "\n" );
	}

	unsafe( SetTraceLogLevel( i32( LOG_WARNING ) ) ); // Disable info and verbose log messages from Raylib.

	var i32 screen_width = 1024;
	var i32 screen_height = 768;
	unsafe( InitWindow( screen_width, screen_height, $<( cast_mut( "PanzerMortyr ModelViewer\0"[0] ) ) ) );

	if( !compiler::options::generate_debug_info )
	{
		unsafe( DisableCursor() );
	}

	unsafe( SetTargetFPS(60) );

	var ust::vector</f32/> mut mesh_positions;
	var ust::vector</f32/> mut mesh_texture_coordinates;
	foreach( pair : model.vertex_data.iter().zip( model.texture_coordinates.iter() ) )
	{
		mesh_positions.push_back( pair.first[0] );
		mesh_positions.push_back( pair.first[1] );
		mesh_positions.push_back( pair.first[2] );
		mesh_texture_coordinates.push_back( pair.second[0] );
		mesh_texture_coordinates.push_back( pair.second[1] );
	}

	var ust::vector</u16/> mut mesh_indices;
	foreach( &t : model.triangles )
	{
		mesh_indices.push_back( u16( t.indices[2] >> 1 ) );
		mesh_indices.push_back( u16( t.indices[1] >> 1 ) );
		mesh_indices.push_back( u16( t.indices[0] >> 1 ) );
	}

	var Mesh mut mesh= zero_init;
	mesh.vertexCount= i32( model.num_vertices );
	mesh.vertices= unsafe( mesh_positions.data() );
	mesh.texcoords= unsafe( mesh_texture_coordinates.data() );
	mesh.triangleCount= i32( model.triangles.size() );
	mesh.indices= unsafe( mesh_indices.data() );

	unsafe( UploadMesh( $<(mesh), true ) );

	auto mut model_file_contents= ust::read_file_to_byte8_vector( model_file_path ).try_take();
	var size_type width= 512s;
	var size_type size_corrected= ( model_file_contents.size() + ( width - 1s ) ) / width * width;
	model_file_contents.resize( size_corrected, byte8(0u8) );

	var Image zmap_lam_image
	{
		.data= unsafe( model_file_contents.data() ),
		.mipmaps= 1,
		.width(width),
		.height( model_file_contents.size() / width ),
		.format( PIXELFORMAT_UNCOMPRESSED_GRAYSCALE ),
	};

	if( false )
	{
		unsafe( ExportImage( zmap_lam_image, $<( cast_mut( "test.png\0"[0] ) ) ) );
	}

	var [ Material, 4 ] mut materials= zero_init;

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var TextureData& src_texture_data= model.hd_textures[i];

		var size_type area( src_texture_data.size[0] * src_texture_data.size[1] );

		scoped_array u8 mut texture_data_rgb[ area * 3s ]( 0u8 );

		for( auto mut i= 0s; i < area; ++i )
		{
			var size_type index( src_texture_data.data[ i ] );
			texture_data_rgb[ i * 3s + 0s ]= src_texture_data.palette[ index * 3s + 2s ];
			texture_data_rgb[ i * 3s + 1s ]= src_texture_data.palette[ index * 3s + 1s ];
			texture_data_rgb[ i * 3s + 2s ]= src_texture_data.palette[ index * 3s + 0s ];
		}

		var Image texture_image
		{
			.data= unsafe( ust::ptr_cast_to_byte8( texture_data_rgb.data() ) ),
			.mipmaps= 1,
			.width (src_texture_data.size[0]),
			.height(src_texture_data.size[1]),
			.format( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ),
		};

		var Texture texture= unsafe( LoadTextureFromImage( texture_image ) );

		var Material material= unsafe( LoadMaterialDefault() );

		unsafe{ $>( material.maps ).texture = texture; }

		materials[i]= material;
	}

	{
		var TextureData& src_texture_data= model.ld_texture;

		var size_type area( src_texture_data.size[0] * src_texture_data.size[1] );

		scoped_array u8 mut texture_data_rgb[ area * 3s ]( 0u8 );

		for( auto mut i= 0s; i < area; ++i )
		{
			var size_type index( src_texture_data.data[ i ] );
			texture_data_rgb[ i * 3s + 0s ]= src_texture_data.palette[ index * 3s + 2s ];
			texture_data_rgb[ i * 3s + 1s ]= src_texture_data.palette[ index * 3s + 1s ];
			texture_data_rgb[ i * 3s + 2s ]= src_texture_data.palette[ index * 3s + 0s ];
		}

		var Image texture_image
		{
			.data= unsafe( ust::ptr_cast_to_byte8( texture_data_rgb.data() ) ),
			.mipmaps= 1,
			.width (src_texture_data.size[0]),
			.height(src_texture_data.size[1]),
			.format( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ),
		};

		var Texture texture= unsafe( LoadTextureFromImage( texture_image ) );

		var Material material= unsafe( LoadMaterialDefault() );

		unsafe{ $>( material.maps ).texture = texture; }

		materials[3]= material;
	}

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	var size_type mut offset= 0s;

	var size_type mut material_index= 0s;

	var bool mut is_simple_mode= false, mut disable_animation= false;

	while( ! unsafe( WindowShouldClose() ) )
	{
		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		if( unsafe( IsKeyPressed( i32( 'Z' ) ) ) )
		{
			offset+= 1s;
			ust::stdout_print( ust::concat( "Offset is ", ust::to_string8(offset), "\n" ) );
		}

		if( unsafe( IsKeyPressed( i32( 'M' ) ) ) )
		{
			is_simple_mode = !is_simple_mode;
		}
		if( unsafe( IsKeyPressed( i32( 'T' ) ) ) )
		{
			++material_index;
		}
		if( unsafe( IsKeyPressed( i32( 'F' ) ) ) )
		{
			disable_animation= !disable_animation;
		}

		unsafe( BeginDrawing() );
		{
			unsafe( ClearBackground( Color{ .r(32), .g(16), .b(8), .a(0) } ) );

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawCubeWires( Vector3{ .x(1), .y(0), .z(0) }, 2.0f, 0.1f, 0.1f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(1), .z(0) }, 0.1f, 2.0f, 0.1f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(0), .z(1) }, 0.1f, 0.1f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );

				var f64 frame_rate= 10.0; // TODO - know what is actual framerate (some contant or per-model property).
				var u32 frame_index= ( disable_animation ? 0u : u32( unsafe( GetTime() ) * frame_rate ) % model.num_frames );

				var f32 scale= 1.0f / 4.0f;

				auto vertices_range= model.vertex_data.range().subrange( size_type( frame_index * model.num_vertices ), size_type( ( frame_index + 1u ) * model.num_vertices ) );

				auto triangle_normals_range= model.per_frame_triangle_normals.range().subrange( size_type( frame_index ) * model.triangles.size(), size_type( frame_index + 1u )  * model.triangles.size() );

				foreach( &v : vertices_range )
				{
					unsafe( DrawCubeWires(
						Vector3{ .x= f32(v[0]) * scale, .y= f32(v[1]) * scale, .z= f32(v[2]) * -scale },
						0.1f,
						0.1f,
						0.1f,
						Color{ .r(255), .g(0), .b(255), .a(255) } ) );
				}

				if( false )
				{
					for( auto mut i= 0u; i < model.num_vertices; ++i )
					{
						unsafe( DrawCubeWires(
							Vector3{ .x= 10.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							0.1f,
							0.1f,
							0.1f,
							Color{ .r(255), .g(0), .b(0), .a(255) } ) );

						unsafe( DrawCubeWires(
							Vector3{ .x= 10.0f, .y= 30.0f, .z= f32(i) * 0.2f },
							0.1f,
							0.1f,
							0.1f,
							Color{ .r(0), .g(255), .b(0), .a(255) } ) );

						unsafe( DrawLine3D(
							Vector3{ .x= 10.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							Vector3{ .x= 10.0f, .y= 30.0f, .z= f32( model.some_per_vertex_ints[ size_type(i) ] ) * 0.2f },
							Color{ .r(128), .g(128), .b(0), .a(255) } ) );
					}
				}

				if( false )
				{
					for( auto mut i= 0s; i < model.triangles.size(); ++i )
					{
						unsafe( DrawCubeWires(
							Vector3{ .x= 00.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							0.1f,
							0.1f,
							0.1f,
							Color{ .r(255), .g(0), .b(0), .a(255) } ) );

						unsafe( DrawCubeWires(
							Vector3{ .x= 00.0f, .y= 30.0f, .z= f32(i) * 0.2f },
							0.1f,
							0.1f,
							0.1f,
							Color{ .r(0), .g(255), .b(0), .a(255) } ) );

						unsafe( DrawLine3D(
							Vector3{ .x= 00.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							Vector3{ .x= 00.0f, .y= 30.0f, .z= f32( model.some_per_triangle_ints[ i ] ) * 0.2f },
							Color{ .r(128), .g(128), .b(0), .a(255) } ) );
					}
				}

				if( is_simple_mode )
				{
					foreach( pair : model.triangles.iter().zip( triangle_normals_range.iter() ) )
					{
						var ObbTriangle& t= pair.first;

						var ObbVertexPosition& v0= vertices_range[ size_type( t.indices[0] ) / 2s ];
						var ObbVertexPosition& v1= vertices_range[ size_type( t.indices[1] ) / 2s ];
						var ObbVertexPosition& v2= vertices_range[ size_type( t.indices[2] ) / 2s ];

						var Vector3 p0{ .x= v0[0] * scale, .y= v0[1s] * scale, .z= v0[2] * -scale };
						var Vector3 p1{ .x= v1[0] * scale, .y= v1[1s] * scale, .z= v1[2] * -scale };
						var Vector3 p2{ .x= v2[0] * scale, .y= v2[1s] * scale, .z= v2[2] * -scale };

						var ObbPerFrameTriangleNormal& normal_angles= pair.second;

						var f32 c_tau= 2.0f * 3.1415926535f;

						var f32 azimuth= f32( normal_angles.azimuth ) * ( c_tau / 1024.0f );
						var f32 elevation= f32( normal_angles.elevation ) * ( c_tau / 1024.0f );

						var f32 azimut_sin= ust::sin( azimuth );
						var f32 azimut_cos= ust::cos( azimuth );

						var f32 elevation_sin= ust::sin( elevation );
						var f32 elevation_cos= ust::cos( elevation );

						var Vector3 normal{ .x= elevation_cos * azimut_sin, .y= elevation_cos * azimut_cos, .z= elevation_sin };

						var Color c{ .r( i32(normal.x * 126.9f) + 128 ), .g( i32(normal.y * 126.9f) + 128 ), .b( i32(normal.z * 126.9f) + 128 ), .a(255) };

						unsafe( DrawTriangle3D( p2, p1, p0, c ) );
					}
				}
				else
				{
					for( auto mut i= 0u; i < model.num_vertices; ++i )
					{
						var size_type src( frame_index * model.num_vertices + i );
						var size_type dst= size_type( i * 3u + 0u );
						mesh_positions[ dst + 0s ]= model.vertex_data[ src ][0];
						mesh_positions[ dst + 1s ]= model.vertex_data[ src ][1];
						mesh_positions[ dst + 2s ]= model.vertex_data[ src ][2];
					}

					unsafe( UpdateMeshBuffer(
						mesh,
						0,
						ust::ptr_cast_to_byte8( mesh_positions.data() ),
						i32( mesh_positions.size() * typeinfo</f32/>.size_of ),
						0 ) );

					var Matrix mut matrix= zero_init;
					matrix.m0= scale;
					matrix.m5= scale;
					matrix.m10= -scale; // The original game seems to use Z down coordinate system. Flip it to be order to be displayed in OpenGL.
					matrix.m15= 1.0f;

					unsafe( DrawMesh( mesh, materials[ material_index % 4s ], matrix ) );
				}
			}
			unsafe( EndMode3D() );
		}
		unsafe( EndDrawing() );
	}

	// Do not care freeng here raylib objects like meshes, materials, textures. We quit anyway and this should release all resoources (even GPU-related).

	unsafe( CloseWindow() );

	return 0;
}

struct ModelData
{
	u32 num_vertices;
	u32 num_frames;

	ust::vector</ObbTriangle/> triangles;
	ust::vector</ObbVertexTextureCoordinates/> texture_coordinates;

	// Vertex data for frames (frame by frame).
	// Contains num_vertices * num_frames values.
	ust::vector</ObbVertexPosition/> vertex_data;

	ust::vector</ObbPerFrameTriangleNormal/> per_frame_triangle_normals;

	// Has values in range 1 to number of vertices + 10 (inclusive).
	// It doesn't look like some sort of nearby vertex index.
	ust::vector</i32/> some_per_vertex_ints;

	// Has values in range 2 to number of triangles (inclusive).
	// It doesn't look like some sort of nearby triangle index.
	ust::vector</i32/> some_per_triangle_ints;

	TextureData ld_texture;

	// They are identical or almost identical.
	[ TextureData, 3 ] hd_textures;
}

struct TextureData
{
	[ u32, 2 ] size= zero_init;
	ust::vector</u8/> data;
	[ u8, 768 ] palette= zero_init;
}

fn LoadModel( ust::filesystem_path_view file_path ) : ust::optional</ModelData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadModel( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadModel( ust::file_readable mut f ) : ust::optional</ModelData/>
{
	var ObbFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ObbFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading model file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ObbFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "Model header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num1 );
		m+= "\n";
		ust::stdout_print( m );

		ust::stdout_print( "Model extra nums:\n" );
		foreach( &n : header.more_data )
		{
			ust::stdout_print( ust::concat( ust::to_string8( n ), "\n" ) );
		}
	}

	var ModelData mut result
	{
		.num_vertices( header.more_data[8] ),
		.num_frames( header.more_data[0] ),
	};

	var size_type num_triangles( header.more_data[9] );

	result.triangles.resize( size_type( num_triangles ), ust::make_zeroed</ObbTriangle/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.triangles.data() ),
				result.triangles.size() * typeinfo</ObbTriangle/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	result.texture_coordinates.resize( size_type( result.num_vertices ), ust::make_zeroed</ObbVertexTextureCoordinates/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.texture_coordinates.data() ),
				result.texture_coordinates.size() * typeinfo</ObbVertexTextureCoordinates/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	result.vertex_data.resize( size_type( result.num_vertices * result.num_frames ), ust::make_zeroed</ObbVertexPosition/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.vertex_data.data() ),
				result.vertex_data.size() * typeinfo</ObbVertexPosition/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	result.per_frame_triangle_normals.resize( num_triangles * size_type( result.num_frames ), ust::make_zeroed</ObbPerFrameTriangleNormal/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.per_frame_triangle_normals.data() ),
				result.per_frame_triangle_normals.size() * typeinfo</ObbPerFrameTriangleNormal/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	// After frame vertex data we have 2 blocks of data - which are just 32-bit integers for vertices and triangles.
	// Its meaning is unclear.

	result.some_per_vertex_ints.resize( size_type( result.num_vertices ), 0 );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.some_per_vertex_ints.data() ),
				result.some_per_vertex_ints.size() * typeinfo</i32/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	result.some_per_triangle_ints.resize( num_triangles, 0 );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.some_per_triangle_ints.data() ),
				result.some_per_triangle_ints.size() * typeinfo</i32/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		result.ld_texture.size[0]= u32( header.more_data[14] );
		result.ld_texture.size[1]= u32( header.more_data[15] );

		result.ld_texture.data.resize( 128s * 128s, 0u8 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.ld_texture.data.data() ),
					result.ld_texture.data.size() * typeinfo</u8/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( $<( result.ld_texture.palette ) ),
					typeinfo</ typeof( result.ld_texture.palette ) />.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var TextureData &mut texture_data= result.hd_textures[i];

		texture_data.size[0]= u32( header.more_data[ 18s + i * 2s + 0s ] );
		texture_data.size[1]= u32( header.more_data[ 18s + i * 2s + 1s ] );

		texture_data.data.resize( 256s * 256s, 0u8 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( texture_data.data.data() ),
					texture_data.data.size() * typeinfo</u8/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( $<( texture_data.palette ) ),
					typeinfo</ typeof( texture_data.palette ) />.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}

	return result;
}

} // namespace PM
