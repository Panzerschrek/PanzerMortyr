import "/file_helpers.iu"
import "/main_wrapper.iu"
import "/math.iu"
import "/scoped_array.iu"
import "/stdout.iu"
import "/string_conversions.iu"

import "/raylib_wrapper/raylib.iu"

import "/common_lib/model_loading.iu"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}

	var ust::filesystem_path_view model_file_path= args[1s];

	if( false )
	{
		auto mut model_file_contents= ust::read_file_to_byte8_vector( model_file_path ).try_take();
		var size_type width= 512s;
		var size_type size_corrected= ( model_file_contents.size() + ( width - 1s ) ) / width * width;
		model_file_contents.resize( size_corrected, byte8(0u8) );

		var Image image
		{
			.data= unsafe( model_file_contents.data() ),
			.mipmaps= 1,
			.width(width),
			.height( model_file_contents.size() / width ),
			.format( PIXELFORMAT_UNCOMPRESSED_GRAYSCALE ),
		};

		unsafe( ExportImage( image, $<( cast_mut( "test.png\0"[0] ) ) ) );
	}

	auto model_opt= LoadModel( model_file_path );
	if( model_opt.empty() )
	{
		return -1;
	}

	var ModelData& model= model_opt.try_deref();

	ust::stdout_print( ust::concat( "Num vertices: ", ust::to_string8( model.num_vertices ), "\n" ) );
	ust::stdout_print( ust::concat( "Num frames: ", ust::to_string8( model.num_frames ), "\n" ) );
	ust::stdout_print( ust::concat( "Num total frame vertices: ", ust::to_string8( model.num_vertices * model.num_frames ), "\n" ) );
	ust::stdout_print( ust::concat( "Num lod0 triangles: ", ust::to_string8( model.num_lod0_triangles ), "\n" ) );
	ust::stdout_print( ust::concat( "Num total triangles: ", ust::to_string8( model.triangles.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num texture collections: ", ust::to_string8( model.texture_collections.size() ), "\n" ) );

	if( !model.some_per_triangle_ints.empty() )
	{
		var u32 mut min= 0xFFFFFFFFu, mut max= 0u;
		foreach( n : model.some_per_triangle_ints )
		{
			ust::min_assign( min, n );
			ust::max_assign( max, n );
		}
		ust::stdout_print( ust::concat( "Per-triangle ints are in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
	}
	if( !model.some_per_vertex_ints.empty() )
	{
		var u32 mut min= 0xFFFFFFFFu, mut max= 0u;
		foreach( n : model.some_per_vertex_ints )
		{
			ust::min_assign( min, n );
			ust::max_assign( max, n );
		}
		ust::stdout_print( ust::concat( "Per-vertex ints are in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
	}

	if( false )
	{
		ust::stdout_print( "Per-triangle ints are:\n" );
		for( auto mut i= 0s; i < model.some_per_triangle_ints.size(); ++i )
		{
			ust::stdout_print( ust::concat( ust::to_string8( i ), ": ", ust::to_string8( model.some_per_triangle_ints[i] ), "\n" ) );
		}
		ust::stdout_print( "\n" );
	}
	if( false )
	{
		ust::stdout_print( "Per-vertex ints are:\n" );
		for( auto mut i= 0s; i < model.some_per_vertex_ints.size(); ++i )
		{
			ust::stdout_print( ust::concat( ust::to_string8( i ), ": ", ust::to_string8( model.some_per_vertex_ints[i] ), "\n" ) );
		}
		ust::stdout_print( "\n" );
	}

	if( true )
	{
		var u32 mut min= 0xFFFFFFFFu, mut max= 0u;
		foreach( &v : model.vertex_positions_data )
		{
			ust::min_assign( min, v.packed_normal_angles );
			ust::max_assign( max, v.packed_normal_angles );
		}

		ust::stdout_print( ust::concat( "Per-vertex last component is in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
	}

	unsafe( SetTraceLogLevel( i32( LOG_WARNING ) ) ); // Disable info and verbose log messages from Raylib.

	var i32 screen_width = 1024;
	var i32 screen_height = 768;
	unsafe( InitWindow( screen_width, screen_height, $<( cast_mut( "PanzerMortyr ModelViewer\0"[0] ) ) ) );

	if( !compiler::options::generate_debug_info )
	{
		unsafe( DisableCursor() );
	}

	unsafe( SetTargetFPS(60) );

	var ust::vector</f32/> mut mesh_positions;
	var ust::vector</f32/> mut mesh_texture_coordinates;
	foreach( pair : model.vertex_positions_data.iter().zip( model.texture_coordinates.iter() ) )
	{
		mesh_positions.push_back( pair.first.coords[0] );
		mesh_positions.push_back( pair.first.coords[1] );
		mesh_positions.push_back( pair.first.coords[2] );
		mesh_texture_coordinates.push_back( pair.second[0] );
		mesh_texture_coordinates.push_back( pair.second[1] );
	}

	var ust::vector</u16/> mut mesh_indices;
	foreach( &t : model.triangles.range().subrange_end( size_type( model.num_lod0_triangles ) ) )
	{
		mesh_indices.push_back( u16( t[2] >> 1 ) );
		mesh_indices.push_back( u16( t[1] >> 1 ) );
		mesh_indices.push_back( u16( t[0] >> 1 ) );
	}

	var Mesh mut mesh= zero_init;
	mesh.vertexCount= i32( model.num_vertices );
	mesh.vertices= unsafe( mesh_positions.data() );
	mesh.texcoords= unsafe( mesh_texture_coordinates.data() );
	mesh.triangleCount= i32( model.num_lod0_triangles );
	mesh.indices= unsafe( mesh_indices.data() );

	unsafe( UploadMesh( $<(mesh), true /* dynamic= true, since we update vertices to show animation */ ) );

	var ust::vector</Material/> mut materials;

	foreach( &texture_collection : model.texture_collections )
	{
		foreach( &src_texture_data :
			ust::array_view_imut</ ModelData::TextureData />( texture_collection.hd_textures ).iter().chain(
				ust::single_element_array_view( texture_collection.ld_texture ).iter() ) )
		{
			var size_type area( src_texture_data.size[0] * src_texture_data.size[1] );

			if( area == 0s )
			{
				continue;
			}

			scoped_array u8 mut texture_data_rgb[ area * 3s ]( 0u8 );

			for( auto mut i= 0s; i < area; ++i )
			{
				var size_type index( src_texture_data.pixels_data[i] );
				texture_data_rgb[ i * 3s + 0s ]= src_texture_data.palette[ index * 3s + 2s ];
				texture_data_rgb[ i * 3s + 1s ]= src_texture_data.palette[ index * 3s + 1s ];
				texture_data_rgb[ i * 3s + 2s ]= src_texture_data.palette[ index * 3s + 0s ];
			}

			var Texture texture=
				unsafe( LoadTextureFromImage(
					Image
					{
						.data= unsafe( ust::ptr_cast_to_byte8( texture_data_rgb.data() ) ),
						.mipmaps= 1,
						.width ( src_texture_data.size[0] ),
						.height( src_texture_data.size[1] ),
						.format( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ),
					} ) );

			var Material mut material= unsafe( LoadMaterialDefault() );

			unsafe{ $>( material.maps ).texture = texture; }

			materials.push_back( move(material) );
		}
	}

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	var size_type mut material_index= 0s;

	var bool mut is_simple_mode= false, mut disable_animation= false, mut display_vertices= true, mut display_vertex_normals= false;

	while( ! unsafe( WindowShouldClose() ) )
	{
		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		if( unsafe( IsKeyPressed( i32( 'M' ) ) ) )
		{
			is_simple_mode = !is_simple_mode;
		}
		if( unsafe( IsKeyPressed( i32( 'T' ) ) ) )
		{
			++material_index;
		}
		if( unsafe( IsKeyPressed( i32( 'F' ) ) ) )
		{
			disable_animation= !disable_animation;
		}
		if( unsafe( IsKeyPressed( i32( 'V' ) ) ) )
		{
			display_vertices= !display_vertices;
		}
		if( unsafe( IsKeyPressed( i32( 'N' ) ) ) )
		{
			display_vertex_normals= !display_vertex_normals;
		}

		unsafe( BeginDrawing() );
		{
			unsafe( ClearBackground( Color{ .r(32), .g(16), .b(8), .a(0) } ) );

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawCubeWires( Vector3{ .x(1), .y(0), .z( 0) }, 2.0f, 0.1f, 0.1f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(1), .z( 0) }, 0.1f, 2.0f, 0.1f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(0), .z(-1) }, 0.1f, 0.1f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );

				var f64 frame_rate= 15.0; // The game runs in fixed steps roughly 30 times in a second, there are two animation frames for each step.
				var u32 frame_index= ( disable_animation ? 0u : u32( unsafe( GetTime() ) * frame_rate ) % model.num_frames );

				// Use small scale to be able to move camera fast enough.
				var f32 scale= 1.0f / 4.0f;

				auto vertex_positions_range= model.vertex_positions_data.range().subrange( size_type( frame_index * model.num_vertices ), size_type( ( frame_index + 1u ) * model.num_vertices ) );

				auto triangle_normals_range= model.per_frame_triangle_normals.range().subrange( size_type( frame_index ) * model.triangles.size(), size_type( frame_index + 1u )  * model.triangles.size() );

				if( display_vertices )
				{
					foreach( &v : vertex_positions_range )
					{
						unsafe( DrawCubeWires(
							Vector3{ .x= f32(v.coords[0]) * scale, .y= f32(v.coords[1]) * scale, .z= f32(v.coords[2]) * -scale },
							0.1f, 0.1f, 0.1f,
							Color{ .r(255), .g(0), .b(255), .a(255) } ) );
					}
				}

				if( display_vertex_normals )
				{
					foreach( &v : vertex_positions_range )
					{
						var f32 azimuth= ( f32( v.packed_normal_angles & 127u )  ) * ( c_tau / 128.0f );
						var f32 elevation= ( f32( v.packed_normal_angles >> 7u ) ) * ( c_tau / 128.0f );

						var f32 azimut_sin= ust::sin( azimuth );
						var f32 azimut_cos= ust::cos( azimuth );

						var f32 elevation_sin= ust::sin( elevation );
						var f32 elevation_cos= ust::cos( elevation );

						var Vector3 normal{ .x= -elevation_cos * azimut_sin, .y= -elevation_cos * azimut_cos, .z= -elevation_sin };

						unsafe( DrawLine3D(
							Vector3{ .x= f32(v.coords[0]) * scale, .y= f32(v.coords[1]) * scale, .z= f32(v.coords[2]) * -scale },
							Vector3{ .x= f32(v.coords[0]) * scale + 0.5f * normal.x, .y= f32(v.coords[1]) * scale  + 0.5f * normal.y, .z= f32(v.coords[2]) * -scale  + 0.5f * normal.z },
							Color{ .r(128), .g(128), .b(0), .a(255) } ) );
					}
				}

				if( false )
				{
					for( auto mut i= 0s; i < model.some_per_triangle_ints.size(); ++i )
					{
						unsafe( DrawCubeWires(
							Vector3{ .x= 00.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							0.1f, 0.1f, 0.1f,
							Color{ .r(255), .g(0), .b(0), .a(255) } ) );

						unsafe( DrawCubeWires(
							Vector3{ .x= 00.0f, .y= 50.0f, .z= f32(i) * 0.2f },
							0.1f, 0.1f, 0.1f,
							Color{ .r(0), .g(255), .b(0), .a(255) } ) );

						unsafe( DrawLine3D(
							Vector3{ .x= 00.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							Vector3{ .x= 00.0f, .y= 50.0f, .z= f32( model.some_per_triangle_ints[ i ] ) * 0.2f },
							Color{ .r(128), .g(128), .b(0), .a(255) } ) );
					}
				}

				if( false )
				{
					for( auto mut i= 0s; i < model.some_per_vertex_ints.size(); ++i )
					{
						unsafe( DrawCubeWires(
							Vector3{ .x= 10.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							0.1f, 0.1f, 0.1f,
							Color{ .r(255), .g(0), .b(0), .a(255) } ) );

						unsafe( DrawCubeWires(
							Vector3{ .x= 10.0f, .y= 50.0f, .z= f32(i) * 0.2f },
							0.1f, 0.1f, 0.1f,
							Color{ .r(0), .g(255), .b(0), .a(255) } ) );

						unsafe( DrawLine3D(
							Vector3{ .x= 10.0f, .y= 10.0f, .z= f32(i) * 0.2f },
							Vector3{ .x= 10.0f, .y= 50.0f, .z= f32( model.some_per_vertex_ints[ i ] ) * 0.2f },
							Color{ .r(128), .g(128), .b(0), .a(255) } ) );
					}
				}

				if( is_simple_mode )
				{
					auto triangles_range= model.triangles.range().subrange_end( size_type( model.num_lod0_triangles ) );
					auto normals_range= triangle_normals_range.subrange_end( size_type( model.num_lod0_triangles ) );
					foreach( pair : triangles_range.iter().zip( normals_range.iter() ) )
					{
						var ObbTriangle& t= pair.first;

						var ObbVertexPosition& v0= vertex_positions_range[ size_type( t[0] ) >> 1 ];
						var ObbVertexPosition& v1= vertex_positions_range[ size_type( t[1] ) >> 1 ];
						var ObbVertexPosition& v2= vertex_positions_range[ size_type( t[2] ) >> 1 ];

						var Vector3 p0{ .x= v0.coords[0] * scale, .y= v0.coords[1s] * scale, .z= v0.coords[2] * -scale };
						var Vector3 p1{ .x= v1.coords[0] * scale, .y= v1.coords[1s] * scale, .z= v1.coords[2] * -scale };
						var Vector3 p2{ .x= v2.coords[0] * scale, .y= v2.coords[1s] * scale, .z= v2.coords[2] * -scale };

						var ObbPerFrameTriangleNormal& normal_angles= pair.second;

						var f32 azimuth= f32( normal_angles.azimuth ) * ( c_tau / 1024.0f );
						var f32 elevation= f32( normal_angles.elevation ) * ( c_tau / 1024.0f );

						var f32 azimut_sin= ust::sin( azimuth );
						var f32 azimut_cos= ust::cos( azimuth );

						var f32 elevation_sin= ust::sin( elevation );
						var f32 elevation_cos= ust::cos( elevation );

						var Vector3 normal{ .x= elevation_cos * azimut_sin, .y= elevation_cos * azimut_cos, .z= elevation_sin };

						var Color c{ .r( i32(normal.x * 126.9f) + 128 ), .g( i32(normal.y * 126.9f) + 128 ), .b( i32(normal.z * 126.9f) + 128 ), .a(128) };

						unsafe( DrawTriangle3D( p2, p1, p0, c ) );
					}
				}
				else
				{
					for( auto mut i= 0u; i < model.num_vertices; ++i )
					{
						var ObbVertexPosition& src= model.vertex_positions_data[ size_type( frame_index * model.num_vertices + i ) ];
						var size_type dst_index= size_type( i * 3u + 0u );
						mesh_positions[ dst_index + 0s ]= src.coords[0];
						mesh_positions[ dst_index + 1s ]= src.coords[1];
						mesh_positions[ dst_index + 2s ]= src.coords[2];
					}

					unsafe( UpdateMeshBuffer(
						mesh,
						0, // RL_DEFAULT_SHADER_ATTRIB_LOCATION_POSITION
						ust::ptr_cast_to_byte8( mesh_positions.data() ),
						i32( mesh_positions.size() * typeinfo</f32/>.size_of ),
						0 ) );

					var Matrix mut matrix= zero_init;
					matrix.m0= scale;
					matrix.m5= scale;
					matrix.m10= -scale; // The original game seems to use Z down coordinate system. Flip it to be order to be displayed in OpenGL.
					matrix.m15= 1.0f;

					unsafe( DrawMesh( mesh, cast_imut(materials)[ material_index % cast_imut(materials).size() ], matrix ) );
				}
			}
			unsafe( EndMode3D() );
		}
		unsafe( EndDrawing() );
	}

	// Do not care freeng here raylib objects like meshes, materials, textures. We quit anyway and this should release all resoources (even GPU-related).

	unsafe( CloseWindow() );

	return 0;
}

var f32 c_tau= 2.0f * 3.1415926535f;

} // namespace PM
