import "/hash_map.u"
import "/main_wrapper.u"
import "/path_utils.u"
import "/stdout.u"
import "/string_conversions.u"

import "/common_lib/map_loading.uh"
import "/common_lib/maps_description_file.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}

	var ust::filesystem_path_view maps_dir= args[1s];

	auto maps_description_opt= LoadMapsDescriptionFile( maps_dir );
	if( maps_description_opt.empty() )
	{
		return -1;
	}

	var MapsDescription& maps_description= maps_description_opt.try_deref();

	var size_type mut max_clusters= 0s;
	var u32 mut max_clusters_map= ~0u;

	var size_type mut max_root_clusters= 0s;
	var u32 mut max_root_clusters_map= ~0u;

	var size_type mut max_light_sources= 0s;
	var u32 mut max_light_sources_map= ~0u;

	var size_type mut max_quads= 0s;
	var u32 mut max_quads_map= ~0u;

	var size_type mut max_entities= 0s;
	var u32 mut max_entities_map= ~0u;

	var size_type mut max_active_entities= 0s;
	var u32 mut max_active_entities_map= ~0u;

	var size_type mut max_tessellated_vertices= 0s;
	var u32 mut max_tessellated_vertices_map= ~0u;

	var size_type mut max_tessellated_triangles= 0s;
	var u32 mut max_tessellated_triangles_map= ~0u;

	var size_type mut max_rain_droplets= 0s;
	var u32 mut max_rain_droplets_map= ~0u;

	var size_type mut max_navigation_graphs= 0s;
	var u32 mut max_navigation_graphs_map= ~0u;

	var ust::hash_map</u32, u32/> mut map_transitions;

	var [ i32, 3 ] mut max_coordinates[ -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF ], mut min_coordinates[ 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF ];

	var [ i32, 3 ] mut max_cluster_dimensions[ 0, 0, 0 ];

	var [ i32, 3 ] mut max_map_quad_dimensions[ 0, 0, 0 ];

	foreach( &val : maps_description.maps )
	{
		var u32 map_index= val.key();

		if( map_index == 0u )
		{
			continue;
		}

		var MapsDescription::MapDescription& map_description= val.value();

		ust::stdout_print( ust::concat( "Loading map ", ust::to_string8( map_index ), "\n" ) );

		var ust::filesystem_path zmap_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( map_description.wall_files[0] ) );
		var ust::filesystem_path zvox_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( map_description.wall_files[1] ) );
		var ust::filesystem_path zpoz_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( map_description.positions_file ) );
		var ust::filesystem_path zmap_lam_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( GetZmapLamFileName( map_index ) ) );
		var ust::filesystem_path zmap_lem_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( GetZmapLemFileName( map_index ) ) );
		var ust::filesystem_path mapa_way_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( GetMapaWayFileName( map_index ) ) );

		auto map_opt= LoadMap(
			zmap_file_path,
			zvox_file_path,
			zpoz_file_path,
			zmap_lam_file_path,
			zmap_lem_file_path,
			mapa_way_file_path );

		if( map_opt.empty() )
		{
			ust::stderr_print( ust::concat( "Failed to load map ", ust::to_string8( map_index ), "\n" ) );
			continue;
		}

		var MapData& map= map_opt.try_deref();

		ust::stdout_print( "\n" );
		ust::stdout_print( ust::concat( "Num zmap quads: ", ust::to_string8( map.zmap.quads.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zmap light shaft boxes: ", ust::to_string8( map.zmap.light_shaft_boxes.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zpoz entities: ", ust::to_string8( map.zpoz.entities.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zpoz entity navigation infos: ", ust::to_string8( map.zpoz.entity_navigation_infos.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zpoz multiplayer spawn points: ", ust::to_string8( map.zpoz.multiplayer_spawn_points.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zpoz clusters: ", ust::to_string8( map.zpoz.clusters.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zpoz cluster indices: ", ust::to_string8( map.zpoz.cluster_indices.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zvox trigger volumes: ", ust::to_string8( map.zvox.trigger_volumes.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zvox dynamic cluster extra infos: ", ust::to_string8( map.zvox.dynamic_cluster_extra_infos.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zvox fog volumes: ", ust::to_string8( map.zvox.fog_volumes.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zvox clusters: ", ust::to_string8( map.zvox.clusters.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zvox light sources: ", ust::to_string8( map.zvox.light_sources.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zmap.lam tessellated quads: ", ust::to_string8( map.zmap_lam.tessellated_quads.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zmap.lam tessellated quads data size: ", ust::to_string8( map.zmap_lam.tessellated_quads_data.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zmap.lam rain droplets: ", ust::to_string8( map.zmap_lam.rain_droplets.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "zmap.lam clusters rain visibility data size: ", ust::to_string8( map.zmap_lam.clusters_rain_visibility_data.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num zmap.lem clusters: ", ust::to_string8( map.zmap_lem.clusters_sky_visibility_data.size() ), "\n" ) );
		ust::stdout_print( ust::concat( "Num mapa.way navigation graphs: ", ust::to_string8( map.mapa_way.navigation_graphs.size() ), "\n" ) );
		ust::stdout_print( "\n" );

		if( map.zvox.clusters.size() > max_clusters )
		{
			max_clusters= map.zvox.clusters.size();
			max_clusters_map= map_index;
		}

		{
			var size_type mut num_root_clusters= 0s;
			foreach( &c : map.zvox.clusters )
			{
				if( c.c.num_children_clusters >= 0 )
				{
					++num_root_clusters;
				}
			}

			if( num_root_clusters > max_root_clusters )
			{
				max_root_clusters= num_root_clusters;
				max_root_clusters_map= map_index;
			}
		}

		if( map.zvox.light_sources.size() > max_light_sources )
		{
			max_light_sources= map.zvox.light_sources.size();
			max_light_sources_map= map_index;
		}

		if( map.zmap.quads.size() > max_quads )
		{
			max_quads= map.zmap.quads.size();
			max_quads_map= map_index;
		}

		if( map.zpoz.entities.size() > max_entities )
		{
			max_entities= map.zpoz.entities.size();
			max_entities_map= map_index;
		}

		{
			var size_type mut num_active_entities= 0s;
			foreach( &entity : map.zpoz.entities )
			{
				if( i32( entity.alive_flag ) != 0 )
				{
					++num_active_entities;
				}
			}

			if( num_active_entities > max_active_entities )
			{
				max_active_entities= num_active_entities;
				max_active_entities_map= map_index;
			}
		}

		{
			var size_type mut num_tessellated_vertices= 0s;
			foreach( &q : map.zmap_lam.tessellated_quads )
			{
				num_tessellated_vertices+= size_type( q.vertex_count );
			}

			if( num_tessellated_vertices > max_tessellated_vertices )
			{
				max_tessellated_vertices= num_tessellated_vertices;
				max_tessellated_vertices_map= map_index;
			}
		}

		{
			var size_type mut num_tessellated_triangles= 0s;

			foreach( &q : map.zmap_lam.tessellated_quads )
			{
				var size_type tessellated_vertex_count( q.vertex_count );

				if( tessellated_vertex_count == 0s )
				{
					continue;
				}

				var size_type tessellatted_quad_data_offset( q.data_offset );

				var ust::array_view_imut</byte32/> vertex_data=
					map.zmap_lam.tessellated_quads_data.range().subrange(
						tessellatted_quad_data_offset,
						tessellatted_quad_data_offset + tessellated_vertex_count * 6s );

				var size_type polygons_data_offset= tessellatted_quad_data_offset + tessellated_vertex_count * 6s;

				var size_type polygon_count( u32( map.zmap_lam.tessellated_quads_data[ polygons_data_offset ] ) );

				var ust::array_view_imut</byte32/> polygons_data=
					map.zmap_lam.tessellated_quads_data .range().subrange(
						polygons_data_offset + 2s,
						polygons_data_offset + 2s + polygon_count * 8s );

				for( auto mut i= 0s; i < polygon_count; ++i )
				{
					var ust::array_view_imut</byte32/> polygon_data= polygons_data.subrange( i * 8s, i * 8s + 8s );

					var size_type polygon_vertex_count( u32( polygon_data[0s] ) );
					var size_type polygon_triangle_count= polygon_vertex_count - 2s;

					num_tessellated_triangles+= polygon_triangle_count;
				}
			}

			if( num_tessellated_triangles > max_tessellated_triangles )
			{
				max_tessellated_triangles= num_tessellated_triangles;
				max_tessellated_triangles_map= map_index;
			}
		}

		if( map.zmap_lam.rain_droplets.size() > max_rain_droplets )
		{
			max_rain_droplets= map.zmap_lam.rain_droplets.size();
			max_rain_droplets_map= map_index;
		}

		if( map.mapa_way.navigation_graphs.size() > max_navigation_graphs )
		{
			max_navigation_graphs= map.mapa_way.navigation_graphs.size();
			max_navigation_graphs_map= map_index;
		}

		foreach( &trigger_volume : map.zvox.trigger_volumes )
		{
			if( trigger_volume.trigger_type == 1 )
			{
				map_transitions.insert_new( map_index, u32( trigger_volume.trigger_param ) );
			}
		}

		foreach( &cluster : map.zvox.clusters )
		{
			for( auto mut i= 0u; i < 3u; ++i )
			{
				ust::min_assign( min_coordinates[i], cluster.c.center[i] - cluster.c.bounding_box_half_size[i] );
				ust::max_assign( max_coordinates[i], cluster.c.center[i] + cluster.c.bounding_box_half_size[i] );
				ust::max_assign( max_cluster_dimensions[i], cluster.c.bounding_box_half_size[i] * 2 );
			}
		}

		foreach( &quad : map.zmap.quads )
		{
			for( auto mut i= 0u; i < 3u; ++i )
			{
				// This box is slightly bigger than actual dimensions, but it's not problematic to overestimate dimensions a little bit.
				ust::max_assign( max_map_quad_dimensions[i], i32( quad.bounding_box_half_size[i] ) * 2 );
			}
		}
	}

	ust::stdout_print( "\nMap sequence is:\n" );
	{
		var u32 mut current_map_index= 41u; // Start map.
		loop
		{
			var ust::string_view8 mut map_name;
			if_var( &map_description : maps_description.maps.find( current_map_index ) )
			{
				map_name= map_description.caption;
			}

			ust::stdout_print( ust::concat( ust::to_string8( current_map_index ), ": ", map_name, "\n" ) );
			if_var( &next_map : map_transitions.find( current_map_index ) )
			{
				current_map_index= next_map;
			}
			else
			{
				break;
			}
		}
	}
	ust::stdout_print( "\n" );

	ust::stdout_print( "\n" );
	ust::stdout_print( ust::concat( "Max clusters is ", ust::to_string8( max_clusters ), " on map ", ust::to_string8( max_clusters_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max root clusters is ", ust::to_string8( max_root_clusters ), " on map ", ust::to_string8( max_root_clusters_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max light sources is ", ust::to_string8( max_light_sources ), " on map ", ust::to_string8( max_light_sources_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max quads is ", ust::to_string8( max_quads ), " on map ", ust::to_string8( max_quads_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max entities is ", ust::to_string8( max_entities ), " on map ", ust::to_string8( max_entities_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max active entities is ", ust::to_string8( max_active_entities ), " on map ", ust::to_string8( max_active_entities_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max tessellated vertices is ", ust::to_string8( max_tessellated_vertices ), " on map ", ust::to_string8( max_tessellated_vertices_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max tessellated triangles is ", ust::to_string8( max_tessellated_triangles ), " on map ", ust::to_string8( max_tessellated_triangles_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max rain droplets is ", ust::to_string8( max_rain_droplets ), " on map ", ust::to_string8( max_rain_droplets_map ), "\n" ) );
	ust::stdout_print( ust::concat( "Max navigation graphs is ", ust::to_string8( max_navigation_graphs ), " on map ", ust::to_string8( max_navigation_graphs_map ), "\n" ) );

	ust::stdout_print(
		ust::concat(
			"Min coordinates are ",
			ust::to_string8( min_coordinates[0] ),
			" ",
			ust::to_string8( min_coordinates[1] ),
			" ",
			ust::to_string8( min_coordinates[2] ),
			"\n" ) );

	ust::stdout_print(
		ust::concat(
			"Max coordinates are ",
			ust::to_string8( max_coordinates[0] ),
			" ",
			ust::to_string8( max_coordinates[1] ),
			" ",
			ust::to_string8( max_coordinates[2] ),
			"\n" ) );

	ust::stdout_print(
		ust::concat(
			"Max cluster dimensions are ",
			ust::to_string8( max_cluster_dimensions[0] ),
			" ",
			ust::to_string8( max_cluster_dimensions[1] ),
			" ",
			ust::to_string8( max_cluster_dimensions[2] ),
			"\n" ) );

	ust::stdout_print(
		ust::concat(
			"Max map quad dimensions are ",
			ust::to_string8( max_map_quad_dimensions[0] ),
			" ",
			ust::to_string8( max_map_quad_dimensions[1] ),
			" ",
			ust::to_string8( max_map_quad_dimensions[2] ),
			"\n" ) );

	return 0;
}

} // namespace PM
