import "/main_wrapper.u"
import "/path_utils.u"
import "/stdout.u"

import "/raylib_wrapper/raylib.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}

	var ust::filesystem_path_view data_dir= args[1s];

	unsafe( SetTraceLogLevel( i32( LOG_WARNING ) ) ); // Disable info and verbose log messages from Raylib.

	var i32 screen_width = 1024;
	var i32 screen_height = 768;
	unsafe( InitWindow( screen_width, screen_height, $<( cast_mut( "PanzerMortyr BillboardsViewer\0"[0] ) ) ) );

	if( !compiler::options::generate_debug_info )
	{
		unsafe( DisableCursor() );
	}

	unsafe( SetTargetFPS(60) );

	var Texture mut texture= zero_init;
	{
		var ust::filesystem_path mut path= ust::path::join( data_dir, "ZBRA000.BMP\0" );
		texture= unsafe( LoadTexture( path.data() ) );
	}

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	while( ! unsafe( WindowShouldClose() ) )
	{
		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		unsafe( BeginDrawing() );
		{
			unsafe( ClearBackground( Color{ .r(32), .g(16), .b(8), .a(0) } ) );

			unsafe( DrawTexture( texture, 10, 20, Color{ .r(255), .g(255), .b(255), .a(255) } ) );

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawCubeWires( Vector3{ .x(1), .y(0), .z( 0) }, 2.0f, 0.1f, 0.1f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(1), .z( 0) }, 0.1f, 2.0f, 0.1f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(0), .z(-1) }, 0.1f, 0.1f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );
			}
			unsafe( EndMode3D() );
		}
		unsafe( EndDrawing() );
	}

	// Do not care freeng here raylib objects like meshes, materials, textures. We quit anyway and this should release all resoources (even GPU-related).

	unsafe( CloseWindow() );

	return 0;
}

} // namespace PM
