import "/hash_map.u"
import "/main_wrapper.u"
import "/path_utils.u"
import "/stdout.u"

import "/raylib_wrapper/raylib.uh"

import "/common_lib/billboards_description_file.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}

	var ust::filesystem_path_view data_dir= args[1s];

	auto billboards_description_opt= LoadBillboardsDescriptionFile( data_dir );
	if( billboards_description_opt.empty() )
	{
		return -1;
	}

	var BillboardsDescription& billboards_description= billboards_description_opt.try_deref();
	ust::ignore_unused( billboards_description );

	unsafe( SetTraceLogLevel( i32( LOG_WARNING ) ) ); // Disable info and verbose log messages from Raylib.

	var u32 screen_width = 1888u;
	var u32 screen_height = 928u;
	unsafe( InitWindow( i32( screen_width ), i32( screen_height ), $<( cast_mut( "PanzerMortyr BillboardsViewer\0"[0] ) ) ) );

	if( !compiler::options::generate_debug_info )
	{
		unsafe( DisableCursor() );
	}

	unsafe( SetTargetFPS(60) );

	var u32 c_num_textures= 5u;
	var [ Texture, c_num_textures ] mut textures= zero_init;

	for( auto mut i= 0u; i < c_num_textures; ++i )
	{
		auto mut name= "ZBRA000.BMP\0";
		name[6]= char8( u32( '0' ) + i );
		var ust::filesystem_path mut path= ust::path::join( data_dir, name );
		textures[i]= unsafe( LoadTexture( path.data() ) );
	}

	var ust::hash_map</u32, u32/> mut texture_number_to_index_map;
	texture_number_to_index_map.insert_new( 997u, 0u );
	texture_number_to_index_map.insert_new( 621u, 1u );
	texture_number_to_index_map.insert_new( 721u, 1u );
	texture_number_to_index_map.insert_new( 998u, 1u );
	texture_number_to_index_map.insert_new( 818u, 4u );

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	var u32 mut scroll= 0u;

	while( ! unsafe( WindowShouldClose() ) )
	{
		if( unsafe( IsKeyPressed( i32( '[' ) ) ) )
		{
			scroll+= 64u;
		}
		if( unsafe( IsKeyPressed( i32( ']' ) ) ) )
		{
			if( scroll >= 64u )
			{
				scroll-= 64u;
			}
		}

		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		unsafe( BeginDrawing() );
		{
			unsafe( ClearBackground( Color{ .r(32), .g(16), .b(8), .a(0) } ) );

			var Color white{ .r(255), .g(255), .b(255), .a(255) };

			if( scroll == 0u )
			{
				for( auto mut i= 0u; i < c_num_textures; ++i )
				{
					unsafe( DrawTexture( textures[i], i32( i * 256u ), 0, white ) );
				}
			}

			var u32 mut x= 0u, mut y= 260u;
			var u32 mut max_size_y_in_current_row= 0u;
			var u32 padding_x= 2u, padding_y= 16u, billboard_y_offset= 10u;

			for( auto mut i= 0s; i < billboards_description.size(); ++i )
			{
				var BillboardDescription& billboard= billboards_description[i];

				var u32 size_x( ust::max( 1, billboard.xk - billboard.xp ) );
				var u32 size_y( ust::max( 1, billboard.yk - billboard.yp ) );

				if( x + size_x + padding_x > screen_width )
				{
					x= 0u;
					y+= max_size_y_in_current_row;
					y+= padding_y;
					max_size_y_in_current_row= 0u;
				}

				if( y >= scroll )
				{
					var u32 y_corrected= y - scroll;

					var [ char8, 4 ] mut num= "000\0";
					num[0]= char8( i / 100s % 10s + size_type( '0' ) );
					num[1]= char8( i /  10s % 10s + size_type( '0' ) );
					num[2]= char8( i /   1s % 10s + size_type( '0' ) );

					unsafe( DrawText( $<( num[0] ), i32( x + size_x / 2u ) - 10, i32( y_corrected ), 8, white ) );

					if_var( texture_index : texture_number_to_index_map.find( billboard.tek ) )
					{
						unsafe( DrawTextureRec(
							textures[ texture_index ],
							Rectangle{ .x( billboard.xp ), .y( billboard.yp ), .width( size_x ), .height( size_y ) },
							Vector2{ .x(x), .y( y_corrected + billboard_y_offset ) },
							white ) );
					}

					unsafe( DrawPixel(
						i32( x ) + billboard.dx * 2,
						i32( y_corrected + billboard_y_offset ) + billboard.dy * 2,
						Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				}

				x+= ust::max( 32u, size_x + padding_x );
				ust::max_assign( max_size_y_in_current_row, size_y );
			}

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawCubeWires( Vector3{ .x(1), .y(0), .z( 0) }, 2.0f, 0.1f, 0.1f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(1), .z( 0) }, 0.1f, 2.0f, 0.1f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCubeWires( Vector3{ .x(0), .y(0), .z(-1) }, 0.1f, 0.1f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );
			}
			unsafe( EndMode3D() );
		}
		unsafe( EndDrawing() );
	}

	// Do not care freeng here raylib objects like meshes, materials, textures. We quit anyway and this should release all resoources (even GPU-related).

	unsafe( CloseWindow() );

	return 0;
}

} // namespace PM
