import "/enum_string_conversions.u"
import "/file_helpers.u"
import "/path_utils.u"
import "/stdout.u"
import "maps_description_file.uh"

namespace PM
{

fn LoadMapsDescriptionFile( ust::filesystem_path_view maps_directory ) : ust::optional</MapsDescription/>
{
	var ust::filesystem_path file_path= ust::path::join( maps_directory, "ICE.STD" );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseMapsDescriptionFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseMapsDescriptionFile( ust::string_view8 file_contents ) : ust::optional</MapsDescription/>
{
	var MapsDescription mut maps_description;

	ust::stdout_print( file_contents );

	return maps_description;
}

} // namespace PM
