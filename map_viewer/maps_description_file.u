import "/enum_string_conversions.u"
import "/file_helpers.u"
import "/integer_parsing.u"
import "/path_utils.u"
import "/stdout.u"
import "/string_conversions.u"
import "maps_description_file.uh"
import "string_iterators.uh"

namespace PM
{

fn LoadMapsDescriptionFile( ust::filesystem_path_view maps_directory ) : ust::optional</MapsDescription/>
{
	var ust::filesystem_path file_path= ust::path::join( maps_directory, "ICE.STD" );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseMapsDescriptionFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseMapsDescriptionFile( ust::string_view8 file_contents ) : ust::optional</MapsDescription/>
{
	var MapsDescription mut maps_description;

	var ust::optional</ tup[ u32, MapsDescription::MapDescription ] /> mut current_map;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "etap" )
		{
			if( !current_map.empty() )
			{
				auto [ index, mut m ]= current_map.try_take();
				maps_description.maps.insert_new( index, move(m) );
			}

			auto index_str_opt= words_it.next();
			if( index_str_opt.empty() )
			{
				continue;
			}
			auto index_opt= ust::parse_integer_exact</u32/>( index_str_opt.try_deref() );
			if( index_opt.empty() )
			{
				continue;
			}

			current_map.reset( ust::make_tuple( index_opt.try_deref(), MapsDescription::MapDescription{} ) );
		}
	}

	if( !current_map.empty() )
	{
		auto [ index, mut m ]= current_map.try_take();
		maps_description.maps.insert_new( index, move(m) );
	}

	foreach( &pair : maps_description.maps )
	{
		ust::stdout_print( ust::concat( "Map ", ust::to_string8( pair.key() ), "\n" ) );
	}

	return maps_description;
}

} // namespace PM
