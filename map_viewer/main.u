import "/enum_string_conversions.u"
import "/file.u"
import "/file_helpers.u"
import "/main_wrapper.u"
import "/math.u"
import "/path_utils.u"
import "/scoped_array.u"
import "/stdout.u"
import "/string_conversions.u"
import "/vector.u"

import "/raylib_wrapper/raylib.uh"

import "map_files.uh"
import "materials_file.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 5s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}
	var ust::string_view8 zmap_file_path= args[1s];
	var ust::string_view8 zvox_file_path= args[2s];
	var ust::string_view8 zpoz_file_path= args[3s];
	var ust::string_view8 zmap_lam_file_path= args[4s];

	auto map_opt= LoadMap( zmap_file_path, zvox_file_path, zpoz_file_path, zmap_lam_file_path );
	if( map_opt.empty() )
	{
		return -1;
	}

	var MapData& map= map_opt.try_deref();

	ust::stdout_print( ust::concat( "Num quads: ", ust::to_string8( map.zmap.quads.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num entities: ", ust::to_string8( map.zpos.entities.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num lights: ", ust::to_string8( map.zpos.light_sources.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zpoz struct1: ", ust::to_string8( map.zpos.structs1.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap.lam structs0: ", ust::to_string8( map.zmap_lam.structs0.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap.lam structs1: ", ust::to_string8( map.zmap_lam.structs1.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap.lam structs2: ", ust::to_string8( map.zmap_lam.structs2.size() ), "\n" ) );

	var ust::optional</ust::filesystem_path_view/> map_dir= ust::path::get_parent_path( zmap_file_path );
	if( map_dir.empty() )
	{
		ust::stderr_print( "Can't get parent directory for the map file!\n" );
		return -1;
	}

	auto materials = LoadMaterialsFile( map_dir.try_deref() );
	if( materials.empty() )
	{
		return -1;
	}

	var i32 screen_width = 1024;
	var i32 screen_height = 768;

	unsafe( InitWindow( screen_width, screen_height, $<( cast_mut( "PanzerMortyr MapViewer\0"[0] ) ) ) );

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	if( !compiler::options::generate_debug_info )
	{
		unsafe( DisableCursor() );
	}

	unsafe( SetTargetFPS(60) );

	var [ ust::vector</byte8/>, 2 ] mut palettes;
	var [ Texture, 2 ] mut palette_textures= zero_init;

	var ust::vector</Material/> mut block_materials;
	var ust::vector</Texture/> mut block_textures;

	with( &block : materials.try_deref().blocks[ 41u ] )
	{
		for( auto mut i= 0s; i < 2s; ++i )
		{
			var ust::filesystem_path palette_file_path=
				ust::path::join(
					map_dir.try_deref(),
					ConvertToUppercase(
						( i == 0s ? block.palette0.file_name : block.palette1.file_name ) ) );

			result_match( ust::read_file_to_byte8_vector( palette_file_path ) )
			{
				Ok( mut contents ) ->
				{
					if( contents.size() != 768s )
					{
						ust::stderr_print( ust::concat( "Invalid palette size ", ust::to_string8( contents.size() ), "!\n" ) );
						return -1;
					}
					ust::stdout_print( ust::concat( "Loaded palette \"", palette_file_path, "\"\n" ) );
					palettes[i]= move(contents);

					for( auto mut j= 0s; j < 256s; ++j )
					{
						palettes[i].swap( j * 3s, j * 3s + 2s );
					}

					palette_textures[i]=
						unsafe( LoadTextureFromImage(
							Image
							{
								.data= palettes[i].data(),
								.width= 16,
								.height= 16,
								.mipmaps= 1,
								.format( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ),
							} ) );

					if( palette_textures[i].id == 0u )
					{
						ust::stdout_print( "Failed to create palette texture!\n" );
						return -1;
					}
				},
				Err( e ) ->
				{
					ust::stderr_print( ust::concat( "Failed to load palette! Error: ", ust::enum_to_string( e ), "\n" ) );
					return -1;
				},
			}
		}

		foreach( &block_texture : block.textures )
		{
			auto mut image_file_nt= ust::path::join( map_dir.try_deref(), ConvertToUppercase( block_texture.mips[1] ) );
			image_file_nt+= "\0";

			var Image image= unsafe( LoadImage( image_file_nt.data() ) );
			if( ust::is_nullptr( image.data ) )
			{
				ust::stderr_print( ust::concat( "Failed to load image\"" , image_file_nt, "\"!\n" ) );
				return -1;
			}
			if( image.format != i32( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ) )
			{
				ust::stderr_print( ust::concat( "Invalid pixel format o image\"" , image_file_nt, "\"!\n" ) );
				return -1;
			}

			var u32 tile_size_x= u32( image.width ) >> 1u;
			var u32 tile_size_y= u32( image.height ) >> 1u;

			type PixelType= [ u8, 3 ];

			scoped_array PixelType mut tile_data[ size_type(tile_size_x * tile_size_y ) ]( ust::make_array( 0u8, 0u8, 0u8 ) );

			var $(PixelType) image_data= unsafe( ust::byte_ptr_cast</PixelType/>( image.data ) );

			for( auto mut tile_y= 0u; tile_y < 2u; ++tile_y )
			{
				for( auto mut tile_x= 0u; tile_x < 2u; ++tile_x )
				{
					var u32 src_y= tile_y * tile_size_y;
					var u32 src_x= tile_x * tile_size_x;
					unsafe
					{
						var $(PixelType) tile_src_data= image_data + src_x + src_y * u32(image.width);

						for( auto mut y= 0u; y < tile_size_y; ++y )
						{
							for( auto mut x= 0u; x < tile_size_x; ++x )
							{
								tile_data[ size_type( x + y * tile_size_x ) ]= $>( tile_src_data + x + y * u32( image.width ) );
							}
						}

						var Image tile_image
						{
							.data= ust::ptr_cast_to_byte8( tile_data.data() ),
							.width( tile_size_x ),
							.height( tile_size_y ),
							.mipmaps(1),
							.format= image.format,
						};

						var Texture mut texture = LoadTextureFromImage( tile_image );
						if( texture.id == 0u )
						{
							ust::stderr_print( "Failed to load test texture from image!\n" );
							return -1;
						}

						var Material mut material= LoadMaterialDefault();

						$>( material.maps ).texture = texture;

						block_materials.push_back( move(material) );
						block_textures.push_back( move(texture) );
					}
				}
			}

			unsafe( UnloadImage( image ) );
		}
	}

	var ust::vector</f32/> mut mesh_vertices;
	var ust::vector</f32/> mut mesh_texture_coordinates;
	var ust::vector</u8/> mut mesh_colors;

	var ust::vector</tup[ size_type, size_type ] /> mut vertex_offsets_and_counts( block_materials.size(), ust::make_tuple( 0s, 0s ) );

	for( auto mut i= 0s; i < block_materials.size(); ++i )
	{
		vertex_offsets_and_counts[i][0]= mesh_vertices.size() / 3s;

		var size_type mut num_quads_with_this_texture= 0s;

		foreach( pair : map.zmap.quads.iter().zip( map.zmap_lam.structs0.iter() ) )
		{
			var ZmapQuad& s= pair.first;

			if( size_type( s.texture_id ) != i )
			{
				continue;
			}

			var [ i32, 3 ] pos[ (s.center[0]), (s.center[1]), (s.center[2]) ];

			var [ i32, 3 ] shift0[ (s.vertices[0][0]), (s.vertices[0][1]), (s.vertices[0][2]) ];
			var [ i32, 3 ] shift1[ (s.vertices[1][0]), (s.vertices[1][1]), (s.vertices[1][2]) ];
			var [ i32, 3 ] shift2[ (s.vertices[2][0]), (s.vertices[2][1]), (s.vertices[2][2]) ];
			var [ i32, 3 ] shift3[ (s.vertices[3][0]), (s.vertices[3][1]), (s.vertices[3][2]) ];

			var [ i32, 3 ] shifts_min
			[
				ust::min( ust::min(shift0[0], shift1[0]), ust::min(shift2[0], shift3[0]) ),
				ust::min( ust::min(shift0[1], shift1[1]), ust::min(shift2[1], shift3[1]) ),
				ust::min( ust::min(shift0[2], shift1[2]), ust::min(shift2[2], shift3[2]) ),
			];
			var [ i32, 3 ] shifts_max
			[
				ust::max( ust::max(shift0[0], shift1[0]), ust::max(shift2[0], shift3[0]) ),
				ust::max( ust::max(shift0[1], shift1[1]), ust::max(shift2[1], shift3[1]) ),
				ust::max( ust::max(shift0[2], shift1[2]), ust::max(shift2[2], shift3[2]) ),
			];

			var [ i32, 3 ] center
			[
				// Using signed integer division by two is important here.
				// Using fractional numbers or bit-shift isn't correct, because this leads to gaps in map geometry.
				0 + ( shifts_min[0] + shifts_max[0] ) / 2,
				0 + ( shifts_min[1] + shifts_max[1] ) / 2,
				0 + ( shifts_min[2] + shifts_max[2] ) / 2,
			];

			var [ Color, 4 ] colors
			[
				{ .r(255), .g(255), .b(255), .a(255) },
				{ .r(255), .g(255), .b(255), .a(255) },
				{ .r(255), .g(255), .b(255), .a(255) },
				{ .r(255), .g(255), .b(255), .a(255) },
			];

			var Vector3 pos0{ .x( pos[0] - center[0] + shift0[0] ), .y( pos[1] - center[1] + shift0[1] ), .z( pos[2] - center[2] + shift0[2] ) };
			var Vector3 pos1{ .x( pos[0] - center[0] + shift1[0] ), .y( pos[1] - center[1] + shift1[1] ), .z( pos[2] - center[2] + shift1[2] ) };
			var Vector3 pos2{ .x( pos[0] - center[0] + shift2[0] ), .y( pos[1] - center[1] + shift2[1] ), .z( pos[2] - center[2] + shift2[2] ) };
			var Vector3 pos3{ .x( pos[0] - center[0] + shift3[0] ), .y( pos[1] - center[1] + shift3[1] ), .z( pos[2] - center[2] + shift3[2] ) };

			var Vector3 mut u_vec{ .x= 0.0f, .y= 1.0f, .z= 0.0f };
			var Vector3 mut v_vec{ .x= 1.0f, .y= 0.0f, .z= 0.0f };

			var f32 c_tau= 2.0f * 3.1415926535f;

			// TODO - fix this code.
			// In rare cases with non-zero roll result texture basis isn't correct.
			{
				var f32 angle= f32( s.texture_roll ) * ( -c_tau / 256.0f );
				var f32 c= ust::cos(angle);
				var f32 s= ust::sin(angle);

				u_vec= Vector3{ .x= u_vec.x * c - u_vec.y * s, .y= u_vec.x * s + u_vec.y * c, .z= u_vec.z };
				v_vec= Vector3{ .x= v_vec.x * c - v_vec.y * s, .y= v_vec.x * s + v_vec.y * c, .z= v_vec.z };
			}
			{
				var f32 angle= ( f32( s.normal_elevation ) + 256.0f ) * ( c_tau / 1024.0f );
				var f32 c= ust::cos(angle);
				var f32 s= ust::sin(angle);

				u_vec= Vector3{ .x= u_vec.x * c - u_vec.z * s, .y= u_vec.y, .z= u_vec.x * s + u_vec.z * c };
				v_vec= Vector3{ .x= v_vec.x * c - v_vec.z * s, .y= v_vec.y, .z= v_vec.x * s + v_vec.z * c };
			}
			{
				var f32 angle= ( 768.0f - f32(s.normal_azimuth) ) * ( c_tau / 1024.0f );
				var f32 c= ust::cos(angle);
				var f32 s= ust::sin(angle);

				u_vec= Vector3{ .x= u_vec.x * c - u_vec.y * s, .y= u_vec.x * s + u_vec.y * c, .z= u_vec.z };
				v_vec= Vector3{ .x= v_vec.x * c - v_vec.y * s, .y= v_vec.x * s + v_vec.y * c, .z= v_vec.z };
			}

			var Vector2 tc_offset{ .x( s.tc_offset[0] ), .y( s.tc_offset[1] ), 	};

			// It seems like all textures (or at least the majority of them) have identical scale.
			var f32 ts_scale= 1.0f / 128.0f;

			var Vector2 tc0
			{
				.x= ( f32( shift0[0] - shift0[0] ) * u_vec.x + f32(shift0[1] - shift0[1]) * u_vec.y + f32(shift0[2]  - shift0[2]) * u_vec.z + tc_offset.x ) * ts_scale ,
				.y= ( f32( shift0[0] - shift0[0] ) * v_vec.x + f32(shift0[1] - shift0[1]) * v_vec.y + f32(shift0[2]  - shift0[2]) * v_vec.z + tc_offset.y ) * ts_scale,
			};
			var Vector2 tc1
			{
				.x= ( f32( shift1[0] - shift0[0] ) * u_vec.x + f32(shift1[1] - shift0[1]) * u_vec.y + f32(shift1[2]  - shift0[2]) * u_vec.z + tc_offset.x ) * ts_scale,
				.y= ( f32( shift1[0] - shift0[0] ) * v_vec.x + f32(shift1[1] - shift0[1]) * v_vec.y + f32(shift1[2]  - shift0[2]) * v_vec.z + tc_offset.y ) * ts_scale,
			};
			var Vector2 tc2
			{
				.x= ( f32( shift2[0] - shift0[0] ) * u_vec.x + f32(shift2[1] - shift0[1]) * u_vec.y + f32(shift2[2]  - shift0[2]) * u_vec.z + tc_offset.x ) * ts_scale,
				.y= ( f32( shift2[0] - shift0[0] ) * v_vec.x + f32(shift2[1] - shift0[1]) * v_vec.y + f32(shift2[2]  - shift0[2]) * v_vec.z + tc_offset.y ) * ts_scale,
			};
			var Vector2 tc3
			{
				.x= ( f32( shift3[0] - shift0[0] ) * u_vec.x + f32(shift3[1] - shift0[1]) * u_vec.y + f32(shift3[2]  - shift0[2]) * u_vec.z + tc_offset.x ) * ts_scale,
				.y= ( f32( shift3[0] - shift0[0] ) * v_vec.x + f32(shift3[1] - shift0[1]) * v_vec.y + f32(shift3[2]  - shift0[2]) * v_vec.z + tc_offset.y ) * ts_scale,
			};

			mesh_vertices.push_back( pos2.x );
			mesh_vertices.push_back( pos2.y );
			mesh_vertices.push_back( pos2.z );
			mesh_texture_coordinates.push_back( tc2.x );
			mesh_texture_coordinates.push_back( tc2.y );
			mesh_colors.push_back( colors[2].r );
			mesh_colors.push_back( colors[2].g );
			mesh_colors.push_back( colors[2].b );
			mesh_colors.push_back( colors[2].a );

			mesh_vertices.push_back( pos1.x );
			mesh_vertices.push_back( pos1.y );
			mesh_vertices.push_back( pos1.z );
			mesh_texture_coordinates.push_back( tc1.x );
			mesh_texture_coordinates.push_back( tc1.y );
			mesh_colors.push_back( colors[1].r );
			mesh_colors.push_back( colors[1].g );
			mesh_colors.push_back( colors[1].b );
			mesh_colors.push_back( colors[1].a );

			mesh_vertices.push_back( pos0.x );
			mesh_vertices.push_back( pos0.y );
			mesh_vertices.push_back( pos0.z );
			mesh_texture_coordinates.push_back( tc0.x );
			mesh_texture_coordinates.push_back( tc0.y );
			mesh_colors.push_back( colors[0].r );
			mesh_colors.push_back( colors[0].g );
			mesh_colors.push_back( colors[0].b );
			mesh_colors.push_back( colors[0].a );

			mesh_vertices.push_back( pos3.x );
			mesh_vertices.push_back( pos3.y );
			mesh_vertices.push_back( pos3.z );
			mesh_texture_coordinates.push_back( tc3.x );
			mesh_texture_coordinates.push_back( tc3.y );
			mesh_colors.push_back( colors[3].r );
			mesh_colors.push_back( colors[3].g );
			mesh_colors.push_back( colors[3].b );
			mesh_colors.push_back( colors[3].a );

			mesh_vertices.push_back( pos2.x );
			mesh_vertices.push_back( pos2.y );
			mesh_vertices.push_back( pos2.z );
			mesh_texture_coordinates.push_back( tc2.x );
			mesh_texture_coordinates.push_back( tc2.y );
			mesh_colors.push_back( colors[2].r );
			mesh_colors.push_back( colors[2].g );
			mesh_colors.push_back( colors[2].b );
			mesh_colors.push_back( colors[2].a );

			mesh_vertices.push_back( pos0.x );
			mesh_vertices.push_back( pos0.y );
			mesh_vertices.push_back( pos0.z );
			mesh_texture_coordinates.push_back( tc0.x );
			mesh_texture_coordinates.push_back( tc0.y );
			mesh_colors.push_back( colors[0].r );
			mesh_colors.push_back( colors[0].g );
			mesh_colors.push_back( colors[0].b );
			mesh_colors.push_back( colors[0].a );

			++num_quads_with_this_texture;
		}

		vertex_offsets_and_counts[i][1]= num_quads_with_this_texture * 6s;
	}

	var ust::vector</Mesh/> mut per_texture_meshes;

	for( auto mut i= 0s; i < block_materials.size(); ++i )
	{
		var size_type vertex_offset= vertex_offsets_and_counts[i][0];
		var size_type num_vertices= vertex_offsets_and_counts[i][1];

		var Mesh mut mesh
		{
			.vertexCount( num_vertices ),
			.triangleCount( num_vertices / 3s ),
			.vertices= unsafe( mesh_vertices.data() + vertex_offset * 3s ),
			.texcoords= unsafe( mesh_texture_coordinates.data() + vertex_offset * 2s ),
			.texcoords2= zero_init,
			.normals= zero_init,
			.tangents= zero_init,
			.colors= unsafe( mesh_colors.data() + vertex_offset * 4s ),
			.indices= zero_init,
			.animVertices= zero_init,
			.animNormals= zero_init,
			.boneIds= zero_init,
			.boneWeights= zero_init,
			.boneMatrices= zero_init,
			.boneCount= zero_init,
			.vaoId= zero_init,
			.vboId= zero_init,
		};

		unsafe( UploadMesh( $<(mesh), false ) );
		per_texture_meshes.push_back( move(mesh) );
	}

	auto mut digits_dexture_file_nt= ust::path::join( map_dir.try_deref(), "PANBL.BMP" );
	digits_dexture_file_nt+= "\0";
	var Texture digits_dexture= unsafe( LoadTexture( digits_dexture_file_nt.data() ) );
	if( digits_dexture.id == 0u )
	{
		ust::stdout_print( "Failed to load digits texture!\n" );
		return -1;
	}

	var Material mut digits_material= unsafe( LoadMaterialDefault() );
	unsafe{ $>( digits_material.maps ).texture = digits_dexture; }

	var ust::vector</f32/> mut digit_mesh_vertices;
	var ust::vector</f32/> mut digit_mesh_texture_coordinatess;

	var f32 digit_half_width= 4.0f;
	var f32 digit_half_height= 8.0f;

	for( auto mut i= 0u; i < 11u; ++i )
	{
		var [ Vector3, 4 ] pos
		[
			{ .x= -digit_half_width, .y= -digit_half_height, .z= 0.0f },
			{ .x= -digit_half_width, .y=  digit_half_height, .z= 0.0f },
			{ .x=  digit_half_width, .y=  digit_half_height, .z= 0.0f },
			{ .x=  digit_half_width, .y= -digit_half_height, .z= 0.0f },
		];

		var f32 glyph_width= 1.0f / 16.0f;
		var f32 glyph_height= 1.0f / 8.0f;
		var [ Vector2, 4 ] tc
		[
			{ .x= glyph_width * f32( i + 1u ), .y= 0.0f },
			{ .x= glyph_width * f32( i + 1u ), .y= glyph_height },
			{ .x= glyph_width * f32(i), .y= glyph_height },
			{ .x= glyph_width * f32(i), .y= 0.0f },
		];

		digit_mesh_vertices.push_back( pos[2].x );
		digit_mesh_vertices.push_back( pos[2].y );
		digit_mesh_vertices.push_back( pos[2].z );
		digit_mesh_texture_coordinatess.push_back( tc[2].x );
		digit_mesh_texture_coordinatess.push_back( tc[2].y );

		digit_mesh_vertices.push_back( pos[1].x );
		digit_mesh_vertices.push_back( pos[1].y );
		digit_mesh_vertices.push_back( pos[1].z );
		digit_mesh_texture_coordinatess.push_back( tc[1].x );
		digit_mesh_texture_coordinatess.push_back( tc[1].y );

		digit_mesh_vertices.push_back( pos[0].x );
		digit_mesh_vertices.push_back( pos[0].y );
		digit_mesh_vertices.push_back( pos[0].z );
		digit_mesh_texture_coordinatess.push_back( tc[0].x );
		digit_mesh_texture_coordinatess.push_back( tc[0].y );

		digit_mesh_vertices.push_back( pos[3].x );
		digit_mesh_vertices.push_back( pos[3].y );
		digit_mesh_vertices.push_back( pos[3].z );
		digit_mesh_texture_coordinatess.push_back( tc[3].x );
		digit_mesh_texture_coordinatess.push_back( tc[3].y );

		digit_mesh_vertices.push_back( pos[2].x );
		digit_mesh_vertices.push_back( pos[2].y );
		digit_mesh_vertices.push_back( pos[2].z );
		digit_mesh_texture_coordinatess.push_back( tc[2].x );
		digit_mesh_texture_coordinatess.push_back( tc[2].y );

		digit_mesh_vertices.push_back( pos[0].x );
		digit_mesh_vertices.push_back( pos[0].y );
		digit_mesh_vertices.push_back( pos[0].z );
		digit_mesh_texture_coordinatess.push_back( tc[0].x );
		digit_mesh_texture_coordinatess.push_back( tc[0].y );
	}

	var [ Mesh, 11 ] mut digit_meshes= zero_init; // The last one is minus sign.

	for( var size_type mut i= 0s; i < 11s; ++i )
	{
		var size_type vertex_offset= 6s * i;

		var Mesh &mut mesh= digit_meshes[i];
		mesh.vertexCount= 6;
		mesh.triangleCount= 2;
		mesh.vertices= unsafe( digit_mesh_vertices.data() + vertex_offset * 3s );
		mesh.texcoords= unsafe( digit_mesh_texture_coordinatess.data() + vertex_offset * 2s );

		unsafe( UploadMesh( $<(mesh), false ) );
	}

	var size_type mut offset= 0s;

	var bool mut display_map= true, mut display_zvox_structs1= true, mut display_entities= true, mut display_lights= true;

	while( ! unsafe( WindowShouldClose() ) )
	{
		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		if( unsafe( IsKeyPressed( i32( 'M' ) ) ) )
		{
			display_map= !display_map;
		}
		if( unsafe( IsKeyPressed( i32( 'K' ) ) ) )
		{
			display_zvox_structs1= !display_zvox_structs1;
		}
		if( unsafe( IsKeyPressed( i32( 'E' ) ) ) )
		{
			display_entities= !display_entities;
		}
		if( unsafe( IsKeyPressed( i32( 'L' ) ) ) )
		{
			display_lights= !display_lights;
		}

		if( unsafe( IsKeyPressed( i32( 'Z' ) ) ) )
		{
			offset+= 1s;
			ust::stdout_print( ust::concat( "Offset is ", ust::to_string8(offset), "\n" ) );
		}

		unsafe( BeginDrawing() );
		{
			unsafe( ClearBackground( Color{ .r(32), .g(16), .b(8), .a(0) } ) );

			unsafe( DrawTextureEx( palette_textures[0], Vector2{ .x= 0.0f, .y= 0.0f }, 0.0f, 8.0f, Color{ .r(255), .g(255), .b(255), .a(255) } ) );
			unsafe( DrawTextureEx( palette_textures[1], Vector2{ .x= 140.0f, .y= 0.0f }, 0.0f, 8.0f, Color{ .r(255), .g(255), .b(255), .a(255) } ) );

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawCube( Vector3{ .x(1), .y(0), .z(0) }, 2.0f, 0.2f, 0.2f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(1), .z(0) }, 0.2f, 2.0f, 0.2f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(0), .z(1) }, 0.2f, 0.2f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );

				// The original game uses units with pixel size.
				// Scale it a little bit down, since camera controller operates with larger units.
				var f32 scale= 1.0f / 64.0f;

				var Matrix mut matrix= zero_init;
				matrix.m0= scale;
				matrix.m5= scale;
				matrix.m10= -scale; // The original game seems to use Z down coordinate system. Flip it to be order to be displayed in OpenGL.
				matrix.m15= 1.0f;

				auto draw_number=
					lambda[&]( i32 mut num, Vector3 pos ) unsafe
					{
						var Matrix mut digit_matrix= zero_init;
						digit_matrix.m0= scale;
						digit_matrix.m5= scale;
						digit_matrix.m10= -scale;
						digit_matrix.m15= 1.0f;
						digit_matrix.m12= pos.x * scale;
						digit_matrix.m13= pos.y * scale;
						digit_matrix.m14= -pos.z * scale;

						var bool mut is_negative= false;
						if( num < 0 )
						{
							is_negative= true;
							num= -num;
						}

						loop
						{
							unsafe( DrawMesh( digit_meshes[ u32( num ) % 10u ], digits_material, digit_matrix ) );
							digit_matrix.m12 += scale * digit_half_width * 2.0f;
							num/= 10;
							if( num == 0 )
							{
								break;
							}
						}

						if( is_negative )
						{
							unsafe( DrawMesh( digit_meshes[ 10 ], digits_material, digit_matrix ) );
						}
					};

				if( display_map )
				{
					for( auto mut i= 0s; i < block_materials.size(); ++i )
					{
						unsafe( DrawMesh( per_texture_meshes[i], block_materials[i], matrix ) );
					}
				}

				if( display_zvox_structs1 )
				{
					foreach( &s : map.zvox.light_sources )
					{
						var Color color{ .r(255), .g(0), .b(255), .a(255) };

						var Vector3 pos{ .x= f32(s.position[0s]) * scale, .y= f32(s.position[1s]) * scale, .z= f32(s.position[2s]) * -scale };

						unsafe( DrawCube( pos, 0.1f, 0.1f, 0.3f, color ) );

						var f32 radius= ust::min( 32.0f, ust::max( 0.1f, f32(s.radius) * scale ) );

						unsafe( DrawSphereWires( pos, radius, 6, 8, color ) );
					}
				}

				if( display_entities )
				{
					foreach( &entity : map.zpos.entities )
					{
						if( entity.alive_flag == 0u16 )
						{
							continue;
						}

						var Color color{ .r(u32(entity.kind) * 37u), .g(u32(entity.kind) * 1179u), .b(u32(entity.kind) * 5423u), .a(255) };

						var Vector3 pos{ .x= f32(entity.position[0s]) * scale, .y= f32(entity.position[1s]) * scale, .z= f32(entity.position[2s]) * -scale };

						unsafe( DrawCube( pos, 0.4f, 0.4f, 0.6f, color ) );

						unsafe( draw_number( i32( entity.kind ), Vector3{ .x(entity.position[0s]), .y(entity.position[1s]), .z( i32(entity.position[2s]) - 24 ) } ) );
					}
				}

				if( false )
				{
					foreach( &s : map.zpos.structs1 )
					{
						var Color color{ .r(0), .g(255), .b(0), .a(255) };

						var Vector3 pos{ .x= f32(s.data[0s + offset]) * scale, .y= f32(s.data[1s + offset]) * scale, .z= f32(s.data[2s + offset]) * -scale };

						unsafe( DrawCube( pos, 0.2f, 0.2f, 0.2f, color ) );
					}
				}

				if( display_lights )
				{
					foreach( &pair : map.zpos.light_sources.iter().zip( map.zpos.light_sources_extra.iter() ) )
					{
						var ZpozLightSource& light_source= pair.first;
						var ZpozLightSourceExtraData& light_source_extra= pair.second;

						var Vector3 pos{ .x= f32(light_source.position[0]) * scale, .y= f32(light_source.position[1]) * scale, .z= f32(light_source.position[2]) * -scale };
						var f32 radius= ust::min( 32.0f, ust::max( 0.1f, f32(light_source.radius) * scale ) );

						var Color color{ .r(light_source.power >> 1u), .g(light_source.power >> 1u), .b(light_source.power >> 1u), .a(255) };

						unsafe( DrawSphereWires( pos, radius, 6, 8, color ) );
						unsafe( DrawCube( pos, 0.15f, 0.15f, 0.15f, color ) );

						unsafe( draw_number( i32( light_source.power ), Vector3{ .x(light_source.position[0s]), .y(light_source.position[1s]), .z( i32(light_source.position[2s]) - 24 ) } ) );

						ust::ignore_unused( light_source_extra );
					}
				}
			}
			unsafe( EndMode3D() );
		}

		unsafe( EndDrawing() );
	}

	unsafe( CloseWindow() );

	return 0;
}

struct MapData
{
	ZmapData zmap;
	ZvoxData zvox;
	ZpozData zpos;
	ZmapLamData zmap_lam;
}

struct ZmapData
{
	ust::vector</ZmapQuad/> quads;
}

struct ZvoxData
{
	ust::vector</ZvoxStruct0/> structs0;
	ust::vector</ZvoxLightSource/> light_sources;
}

struct ZpozData
{
	ust::vector</ZpozEntity/> entities;
	ust::vector</ZpozStruct1/> structs1;
	ust::vector</ZpozLightSource/> light_sources;
	ust::vector</ZpozLightSourceExtraData/> light_sources_extra;
	ust::vector</ZPozStruct3/> structs3;
}

struct ZmapLamData
{
	ust::vector</ZmapLamStruct0/> structs0;
	ust::vector</ZmapLamStruct1/> structs1;
	ust::vector</ZmapLamStruct2/> structs2;
}

fn LoadMap(
	ust::filesystem_path_view zmap_file_path,
	ust::filesystem_path_view zvox_file_path,
	ust::filesystem_path_view zpoz_file_path,
	ust::filesystem_path_view zmap_lam_file_path ) : ust::optional</MapData/>
{
	auto mut zmap_data= LoadZmapFile( zmap_file_path );
	auto mut zvox_data= LoadZvoxFile( zvox_file_path );
	auto mut zpoz_data= LoadZpozFile( zpoz_file_path );
	auto mut zmap_lam_data= LoadZmapLamFile( zmap_lam_file_path );

	if( zmap_data.empty() || zvox_data.empty() || zpoz_data.empty() || zmap_lam_data.empty() )
	{
		return ust::null_optional;
	}

	return MapData
	{
		.zmap= zmap_data.try_take(),
		.zvox= zvox_data.try_take(),
		.zpos= zpoz_data.try_take(),
		.zmap_lam= zmap_lam_data.try_take(),
	};
}

fn LoadZmapFile( ust::filesystem_path_view file_path ) : ust::optional</ZmapData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadZmapFile( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZmapFile( ust::file_readable mut f ) : ust::optional</ZmapData/>
{
	var ZMapFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZMapFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ZMapFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	var ZmapData mut result;

	var ZmapQuad dummy_quad= zero_init;

	result.quads.resize( size_type( header.num_quads ), dummy_quad );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.quads.data() ),
				result.quads.size() * typeinfo</ZmapQuad/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), ", \n" ) );
		return ust::null_optional;
	}

	return result;
}

fn LoadZvoxFile( ust::filesystem_path_view file_path ) : ust::optional</ZvoxData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadZvoxFile( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZvoxFile( ust::file_readable mut f ) : ust::optional</ZvoxData/>
{
	var ZVoxFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZVoxFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ZVoxFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	var ZvoxData mut result;

	{
		var ZvoxStruct0 mut dummy_struct0= zero_init;
		result.structs0.resize( size_type( header.num_structs0 ), dummy_struct0 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.structs0.data() ),
					result.structs0.size() * typeinfo</ZvoxStruct0/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	{
		var ZvoxLightSource mut dummy_struct1= zero_init;
		result.light_sources.resize( size_type( header.num_structs1 ), dummy_struct1 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.light_sources.data() ),
					result.light_sources.size() * typeinfo</ZvoxLightSource/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	// There is at least one more data block left in this file, which size and meaning isn't known yet.

	return result;
}

fn LoadZpozFile( ust::filesystem_path_view file_path ) : ust::optional</ZpozData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadZpozFile( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZpozFile( ust::file_readable mut f ) : ust::optional</ZpozData/>
{
	var ZPozFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZPozFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ZPozFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	var u64 mut file_size(0);
	result_match( f.get_metatada() )
	{
		Ok(m) -> { file_size= m.size; },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error getting archive file size: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}

	var ZpozData mut result;

	{
		var ZpozEntity dummy_entity= zero_init;
		result.entities.resize( size_type( header.num_entities ), dummy_entity );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.entities.data() ),
					result.entities.size() * typeinfo</ZpozEntity/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	{
		var ZpozStruct1 dummy_struct1= zero_init;
		result.structs1.resize( size_type( header.num_structs1 ), dummy_struct1 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.structs1.data() ),
					result.structs1.size() * typeinfo</ZpozStruct1/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	var ZPozIntermediateHeader mut intermediate_header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(intermediate_header) ),
				 typeinfo</ZPozIntermediateHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		var ZpozLightSource dummy_light_source= zero_init;
		result.light_sources.resize( size_type( intermediate_header.num_light_sources ), dummy_light_source );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.light_sources.data() ),
					result.light_sources.size() * typeinfo</ZpozLightSource/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	{
		var ZpozLightSourceExtraData dummy_light_source_extra_data= zero_init;
		result.light_sources_extra.resize( size_type( intermediate_header.num_light_sources ), dummy_light_source_extra_data );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.light_sources_extra.data() ),
					result.light_sources_extra.size() * typeinfo</ZpozLightSourceExtraData/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	{
		var size_type offset=
			typeinfo</ZPozFileHeader/>.size_of +
			result.entities.size() * typeinfo</ZpozEntity/>.size_of +
			result.structs1.size() * typeinfo</ZpozStruct1/>.size_of +
			typeinfo</ZPozIntermediateHeader/>.size_of +
			result.light_sources.size() * typeinfo</ZpozLightSource/>.size_of +
			result.light_sources_extra.size() * typeinfo</ZpozLightSourceExtraData/>.size_of;

		var size_type num_structs3= ( size_type( file_size ) - offset ) /typeinfo</ZPozStruct3/>.size_of;

		var ZPozStruct3 dummy_struct3= zero_init;
		result.structs3.resize( num_structs3, dummy_struct3 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.structs3.data() ),
					result.structs3.size() * typeinfo</ZPozStruct3/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	var i32 mut max_struct3_data= 0;
	foreach( &s : result.structs3 )
	{
		ust::max_assign( max_struct3_data, s.data[0] );
	}
	ust::stdout_print( ust::concat( "Max struct3 data is ", ust::to_string8( max_struct3_data ), "\n" ) );

	return result;
}

