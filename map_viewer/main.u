import "/enum_string_conversions.u"
import "/file.u"
import "/file_helpers.u"
import "/hash_set.u"
import "/integer_parsing.u"
import "/main_wrapper.u"
import "/math.u"
import "/path_utils.u"
import "/scoped_array.u"
import "/stdout.u"
import "/string_conversions.u"
import "/vector.u"

import "/raylib_wrapper/raylib.uh"

import "/common_lib/game_params_file.uh"
import "/common_lib/map_loading.uh"
import "/common_lib/maps_description_file.uh"
import "/common_lib/materials_file.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() < 3s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}

	var ust::filesystem_path_view maps_dir= args[1s];
	var ust::optional</u32/> map_index_opt= ust::parse_integer_exact</u32/>( args[2s] );

	if( map_index_opt.empty() )
	{
		ust::stderr_print( "Failed to parse map index!\n" );
		return -1;
	}

	var u32 map_index= map_index_opt.try_deref();

	auto maps_description_opt = LoadMapsDescriptionFile( maps_dir );
	if( maps_description_opt.empty() )
	{
		return -1;
	}

	var MapsDescription& maps_description= maps_description_opt.try_deref();

	auto game_params_opt = LoadGameParamsFile( maps_dir );
	if( game_params_opt.empty() )
	{
		return -1;
	}

	var GameParams& game_params= game_params_opt.try_deref();

	if( size_type(map_index) >= maps_description.maps.size() )
	{
		ust::stderr_print( "No map with given number found!\n" );
		return -1;
	}

	var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type(map_index) ];

	var ust::filesystem_path zmap_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( map_description.wall_files[0] ) );
	var ust::filesystem_path zvox_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( map_description.wall_files[1] ) );
	var ust::filesystem_path zpoz_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( map_description.positions_file ) );
	var ust::filesystem_path zmap_lam_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( GetZmapLamFileName( map_index ) ) );
	var ust::filesystem_path zmap_lem_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( GetZmapLemFileName( map_index ) ) );
	var ust::filesystem_path mapa_way_file_path= ust::path::join( maps_dir, ConvertResourceStringToStringView( GetMapaWayFileName( map_index ) ) );

	if( false )
	{
		auto mut file_contents= ust::read_file_to_byte8_vector( mapa_way_file_path ).try_take();
		var size_type width= 512s;
		var size_type size_corrected= ( file_contents.size() + ( width - 1s ) ) / width * width;
		file_contents.resize( size_corrected, byte8(0u8) );

		var Image image
		{
			.data= unsafe( file_contents.data() ),
			.mipmaps= 1,
			.width(width),
			.height( file_contents.size() / width ),
			.format( PIXELFORMAT_UNCOMPRESSED_GRAYSCALE ),
		};

		unsafe( ExportImage( image, $<( cast_mut( "test.png\0"[0] ) ) ) );
	}

	auto map_opt= LoadMap(
		zmap_file_path,
		zvox_file_path,
		zpoz_file_path,
		zmap_lam_file_path,
		zmap_lem_file_path,
		mapa_way_file_path );

	if( map_opt.empty() )
	{
		return -1;
	}

	var MapData& map= map_opt.try_deref();

	ust::stdout_print( "\n" );
	ust::stdout_print( ust::concat( "Num zmap quads: ", ust::to_string8( map.zmap.quads.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap light shaft boxes: ", ust::to_string8( map.zmap.light_shaft_boxes.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zpoz entities: ", ust::to_string8( map.zpoz.entities.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zpoz entity navigation infos: ", ust::to_string8( map.zpoz.entity_navigation_infos.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zpoz multiplayer spawn points: ", ust::to_string8( map.zpoz.multiplayer_spawn_points.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zpoz clusters: ", ust::to_string8( map.zpoz.clusters.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zpoz cluster indices: ", ust::to_string8( map.zpoz.cluster_indices.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zvox trigger volumes: ", ust::to_string8( map.zvox.trigger_volumes.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zvox dynamic cluster extra infos: ", ust::to_string8( map.zvox.dynamic_cluster_extra_infos.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zvox fog volumes: ", ust::to_string8( map.zvox.fog_volumes.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zvox clusters: ", ust::to_string8( map.zvox.clusters.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zvox light sources: ", ust::to_string8( map.zvox.light_sources.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap.lam tessellated quads: ", ust::to_string8( map.zmap_lam.tessellated_quads.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap.lam tessellated quads data size: ", ust::to_string8( map.zmap_lam.tessellated_quads_data.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap.lam rain droplets: ", ust::to_string8( map.zmap_lam.rain_droplets.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "zmap.lam clusters rain visibility data size: ", ust::to_string8( map.zmap_lam.clusters_rain_visibility_data.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num zmap.lem clusters: ", ust::to_string8( map.zmap_lem.clusters_sky_light_data.size() ), "\n" ) );
	ust::stdout_print( ust::concat( "Num mapa.way navigation graphs: ", ust::to_string8( map.mapa_way.navigation_graphs.size() ), "\n" ) );
	ust::stdout_print( "\n" );

	{
		var size_type mut num_mirror_quads= 0s;
		foreach( &quad : map.zmap.quads )
		{
			if( u32( quad.texture_id ) ==
				MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Mirror ) ] )
			{
				++num_mirror_quads;
			}
		}
		ust::stdout_print( ust::concat( "Num mirror quads: ", ust::to_string8( num_mirror_quads ), "\n" ) );
	}

	auto materials_opt = LoadMaterialsFile( maps_dir );
	if( materials_opt.empty() )
	{
		return -1;
	}

	var MaterialsDescription& materials= materials_opt.try_deref();

	// Initialize Raylib before loading textures.

	unsafe( SetTraceLogLevel( i32( LOG_WARNING ) ) ); // Disable info and verbose log messages from Raylib.

	var i32 screen_width = 1024;
	var i32 screen_height = 768;
	unsafe( InitWindow( screen_width, screen_height, $<( cast_mut( "PanzerMortyr MapViewer\0"[0] ) ) ) );

	if( !compiler::options::generate_debug_info )
	{
		unsafe( DisableCursor() );
	}

	unsafe( SetTargetFPS(60) );

	auto mapterials_block_opt= materials.blocks.find( map_description.materials_block );
	if( mapterials_block_opt.empty() )
	{
		ust::stderr_print( "Can't find materials block!\n" );
		return -1;
	}

	var MaterialsDescription::Block& materials_block= mapterials_block_opt.try_deref();

	var ust::vector</Material/> mut block_materials;
	var ust::vector</Texture/> mut block_textures;

	foreach( &block_texture : materials_block.textures )
	{
		auto mut image_file_nt= ust::path::join( maps_dir, ConvertResourceStringToStringView( block_texture.mips[1] ) );
		image_file_nt+= "\0";

		var Image image= unsafe( LoadImage( image_file_nt.data() ) );
		if( ust::is_nullptr( image.data ) )
		{
			ust::stderr_print( ust::concat( "Failed to load image\"" , image_file_nt, "\"!\n" ) );
			return -1;
		}
		if( image.format != i32( PIXELFORMAT_UNCOMPRESSED_R8G8B8 ) )
		{
			ust::stderr_print( ust::concat( "Invalid pixel format o image\"" , image_file_nt, "\"!\n" ) );
			return -1;
		}
		if( u32( image.width  ) != MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_x ||
			u32( image.height ) != MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_y )
		{
			ust::stderr_print( ust::concat( "Invalid dimensions for image\"" , image_file_nt, "\"!\n" ) );
			return -1;
		}

		type PixelType= [ u8, 3 ];
		var u32 tile_area= MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_size;

		scoped_array PixelType mut tile_data[ size_type( tile_area ) ]( ust::make_array( 0u8, 0u8, 0u8 ) );

		var $(PixelType) image_data= unsafe( ust::byte_ptr_cast</PixelType/>( image.data ) );

		for( auto mut tile_y= 0u; tile_y < MaterialsDescription::c_texture_file_num_tiles_y; ++tile_y )
		{
			var u32 src_y= tile_y * MaterialsDescription::c_texture_size;

			for( auto mut tile_x= 0u; tile_x < MaterialsDescription::c_texture_file_num_tiles_x; ++tile_x )
			{
				var u32 src_x= tile_x * MaterialsDescription::c_texture_size;

				unsafe
				{
					var $(PixelType) tile_src_data= image_data + src_x + src_y * u32(image.width);

					for( auto mut y= 0u; y < MaterialsDescription::c_texture_size; ++y )
					{
						tile_data.subrange_start( size_type( y * MaterialsDescription::c_texture_size ) ).copy_from(
							ust::array_view_imut</PixelType/>(
								tile_src_data + y * u32( image.width ),
								size_type( MaterialsDescription::c_texture_size ) ) );
					}

					var Texture mut texture =
						LoadTextureFromImage(
							Image
							{
								.data= ust::ptr_cast_to_byte8( tile_data.data() ),
								.width ( MaterialsDescription::c_texture_size ),
								.height( MaterialsDescription::c_texture_size ),
								.mipmaps(1),
								.format= image.format,
							} );

					if( texture.id == 0u )
					{
						ust::stderr_print( "Failed to load test texture from image!\n" );
						return -1;
					}

					var Material mut material= LoadMaterialDefault();

					$>( material.maps ).texture = texture;

					block_materials.push_back( move(material) );
					block_textures.push_back( move(texture) );
				}
			}
		}

		unsafe( UnloadImage( image ) );
	}

	// Dummy material for polygons with strange material numbers.
	block_materials.push_back( unsafe( LoadMaterialDefault() ) );

	{
		var ust::hash_set</size_type/> mut missing_materials;
		foreach( &q : map.zmap.quads ) label enumerate_quads
		{
			var size_type index( q.texture_id );
			if( index >= block_materials.size() - 1s )
			{
				foreach( known_texture_index : MaterialsDescription::c_special_material_texture_indices )
				{
					if( index == size_type(known_texture_index) )
					{
						continue label enumerate_quads;
					}
				}
				missing_materials.insert(index);
			}
		}

		if( !missing_materials.empty() )
		{
			ust::stdout_print( "Missing materials: " );
			foreach( m : missing_materials )
			{
				ust::stdout_print( ust::concat( ust::to_string8( m ), " " ) );
			}
			ust::stdout_print( "\n" );
		}
	}

	var ust::vector</f32/> mut mesh_vertices;
	var ust::vector</f32/> mut mesh_texture_coordinates;
	var ust::vector</u8/> mut mesh_colors;
	var ust::vector</u16/> mut mesh_indices;

	scoped_array MeshPart mut mesh_parts[ block_materials.size() ]( ust::make_zeroed</MeshPart/>() );

	for( auto mut i= 0s; i < block_materials.size(); ++i )
	{
		var size_type mesh_first_vertex_index= mesh_vertices.size() / 3s;

		mesh_parts[i].first_vertex_index= mesh_first_vertex_index;
		mesh_parts[i].first_index= mesh_indices.size();

		var size_type mut num_triangles_with_this_texture= 0s;

		foreach( &cluster : map.zvox.clusters )
		{
			for( auto mut q= size_type( cluster.c.first_quad_index );
				q < size_type( cluster.c.first_quad_index ) + size_type( cluster.num_quads );
				++q )
			{
				var ZmapQuad& quad= map.zmap.quads[q];

				// TODO - optimize this lookup, use a hash-map instead.
				var ust::optional</size_type/> mut special_material_opt;
				for( auto mut j= 0s; j < typeinfo</MaterialsDescription::SpecialMaterial/>.element_count; ++j )
				{
					if( u32( quad.texture_id ) == MaterialsDescription::c_special_material_texture_indices[j] )
					{
						special_material_opt= j;
						break;
					}
				}

				if_var( special_material_index : special_material_opt )
				{
					if( materials_block.special_material_indices[ special_material_index ] != u32(i) )
					{
						continue;
					}
				}
				else
				{
					if( size_type( quad.texture_id ) != i &&
						// Move quads with materials outside block materials list into the last group (with dummy material).
						!( i == block_materials.size() - 1s && size_type( quad.texture_id ) >= block_materials.size() ) )
					{
						continue;
					}
				}

				var size_type first_quad_vertex_index= mesh_vertices.size() / 3s - mesh_first_vertex_index;

				if( q >= map.zmap_lam.tessellated_quads.size() || map.zmap_lam.tessellated_quads[q].vertex_count == 0u )
				{
					// Fallback for cases where tessellated data isn't available - like for dynamic polygons (doors, elevators, buttons).

					var [ Color, 4 ] colors
					[
						{ .r(255), .g(255), .b(255), .a(255) } ...
					];

					var Vector3 mut u_vec{ .x= 0.0f, .y= 1.0f, .z= 0.0f };
					var Vector3 mut v_vec{ .x= 1.0f, .y= 0.0f, .z= 0.0f };

					var f32 c_tau= 2.0f * 3.1415926535f;

					{
						var f32 angle= f32( i32( quad.packed_texture_roll_scale ) & ~15 ) * ( -c_tau / 256.0f );
						var f32 c= ust::cos(angle);
						var f32 s= ust::sin(angle);

						u_vec= Vector3{ .x= u_vec.x * c - u_vec.y * s, .y= u_vec.x * s + u_vec.y * c, .z= u_vec.z };
						v_vec= Vector3{ .x= v_vec.x * c - v_vec.y * s, .y= v_vec.x * s + v_vec.y * c, .z= v_vec.z };
					}
					{
						var f32 angle= ( f32( quad.normal_elevation ) + 256.0f ) * ( c_tau / 1024.0f );
						var f32 c= ust::cos(angle);
						var f32 s= ust::sin(angle);

						u_vec= Vector3{ .x= u_vec.x * c - u_vec.z * s, .y= u_vec.y, .z= u_vec.x * s + u_vec.z * c };
						v_vec= Vector3{ .x= v_vec.x * c - v_vec.z * s, .y= v_vec.y, .z= v_vec.x * s + v_vec.z * c };
					}
					{
						var f32 angle= ( 768.0f - f32(quad.normal_azimuth) ) * ( c_tau / 1024.0f );
						var f32 c= ust::cos(angle);
						var f32 s= ust::sin(angle);

						u_vec= Vector3{ .x= u_vec.x * c - u_vec.y * s, .y= u_vec.x * s + u_vec.y * c, .z= u_vec.z };
						v_vec= Vector3{ .x= v_vec.x * c - v_vec.y * s, .y= v_vec.x * s + v_vec.y * c, .z= v_vec.z };
					}
					{
						// Use experimentally-found factor for texture basis scaling.
						// This code may be wrong.
						// It should map bits 8 to scale 1.25.
						// Bits 9 are roughly mapped to scale 1.5.
						// Bits 10 are roughly mapped to scale 1.75.
						// Bits 12 are roughly mapped to scale 2.25.
						// Bits 14 are roughly mapped to scale 2.75.
						var f32 vecs_scale= ust::max( 1.0f, f32( i32( quad.packed_texture_roll_scale ) & 15 ) * 0.25f - 0.75f );
						u_vec.x*= vecs_scale;
						u_vec.y*= vecs_scale;
						u_vec.z*= vecs_scale;
						v_vec.x*= vecs_scale;
						v_vec.y*= vecs_scale;
						v_vec.z*= vecs_scale;
					}

					var Vector2 tc_offset{ .x( quad.tc_offset[0] ), .y( quad.tc_offset[1] ), 	};

					// OpenGL uses normalized texture coordinates.
					var f32 ts_scale= 1.0f / f32( MaterialsDescription::c_texture_size );

					for( auto mut i= 0s; i < 4s; ++i )
					{
						var [ f32, 3 ] rel_shift
						[
							( i32( quad.vertices[i][0] ) - i32( quad.vertices[0][0] ) ),
							( i32( quad.vertices[i][1] ) - i32( quad.vertices[0][1] ) ),
							( i32( quad.vertices[i][2] ) - i32( quad.vertices[0][2] ) )
						];

						mesh_texture_coordinates.push_back( ( rel_shift[0] * u_vec.x + rel_shift[1] * u_vec.y + rel_shift[2] * u_vec.z + tc_offset.x ) * ts_scale );
						mesh_texture_coordinates.push_back( ( rel_shift[0] * v_vec.x + rel_shift[1] * v_vec.y + rel_shift[2] * v_vec.z + tc_offset.y ) * ts_scale );
						mesh_vertices.push_back( f32( cluster.c.center[0] + i32( quad.vertices[i][0] ) ) );
						mesh_vertices.push_back( f32( cluster.c.center[1] + i32( quad.vertices[i][1] ) ) );
						mesh_vertices.push_back( f32( cluster.c.center[2] + i32( quad.vertices[i][2] ) ) );
						mesh_colors.push_back( colors[i].r );
						mesh_colors.push_back( colors[i].g );
						mesh_colors.push_back( colors[i].b );
						mesh_colors.push_back( colors[i].a );
					}

					mesh_indices.push_back( u16( first_quad_vertex_index + 2s ) );
					mesh_indices.push_back( u16( first_quad_vertex_index + 1s ) );
					mesh_indices.push_back( u16( first_quad_vertex_index + 0s ) );
					mesh_indices.push_back( u16( first_quad_vertex_index + 3s ) );
					mesh_indices.push_back( u16( first_quad_vertex_index + 2s ) );
					mesh_indices.push_back( u16( first_quad_vertex_index + 0s ) );

					num_triangles_with_this_texture+= 2s;
				}
				else
				{
					var ZmapLamTesselaltedQuad& tessellated_quad= map.zmap_lam.tessellated_quads[q];

					var size_type tessellated_vertex_count( tessellated_quad.vertex_count );

					var size_type tessellatted_quad_data_offset( tessellated_quad.data_offset );

					var ust::array_view_imut</byte32/> vertex_data=
						map.zmap_lam.tessellated_quads_data.range().subrange(
							tessellatted_quad_data_offset,
							tessellatted_quad_data_offset + tessellated_vertex_count * 6s );

					for( auto mut i= 0s; i < tessellated_vertex_count; ++i )
					{
						var f32 x( vertex_data[ i * 6s + 0s ] );
						var f32 y( vertex_data[ i * 6s + 1s ] );
						var f32 z( vertex_data[ i * 6s + 2s ] );
						var f32 u( vertex_data[ i * 6s + 3s ] );
						var f32 v( vertex_data[ i * 6s + 4s ] );
						var u32 c( vertex_data[ i * 6s + 5s ] );

						mesh_vertices.push_back( f32( cluster.c.center[0] ) + x );
						mesh_vertices.push_back( f32( cluster.c.center[1] ) + y );
						mesh_vertices.push_back( f32( cluster.c.center[2] ) + z );
						mesh_texture_coordinates.push_back( u );
						mesh_texture_coordinates.push_back( v );
						mesh_colors.push_back( u8( ( c >> 16 ) & 255u ) );
						mesh_colors.push_back( u8( ( c >> 8 ) & 255u ) );
						mesh_colors.push_back( u8( c & 255u ) );
						mesh_colors.push_back( 255u8 );
					}

					var size_type polygons_data_offset= tessellatted_quad_data_offset + tessellated_vertex_count * 6s;

					var size_type polygon_count( u32( map.zmap_lam.tessellated_quads_data[ polygons_data_offset ] ) );

					var ust::array_view_imut</byte32/> polygons_data=
						map.zmap_lam.tessellated_quads_data.range().subrange(
							polygons_data_offset + 2s,
							polygons_data_offset + 2s + polygon_count * 8s );

					for( auto mut i= 0s; i < polygon_count; ++i )
					{
						var ust::array_view_imut</byte32/> polygon_data= polygons_data.subrange( i * 8s, i * 8s + 8s );

						var size_type polygon_vertex_count( u32( polygon_data[0s] ) );

						var size_type polygon_triangle_count= polygon_vertex_count - 2s;

						for( auto mut j= 0s; j < polygon_triangle_count; ++j )
						{
							var size_type i0( u32( polygon_data[ 2s + 0s ] ) );
							var size_type i1( u32( polygon_data[ 2s + j + 1s ] ) );
							var size_type i2( u32( polygon_data[ 2s + j + 2s ] ) );

							mesh_indices.push_back( u16( first_quad_vertex_index + i2 ) );
							mesh_indices.push_back( u16( first_quad_vertex_index + i1 ) );
							mesh_indices.push_back( u16( first_quad_vertex_index + i0 ) );
						}

						num_triangles_with_this_texture+= polygon_triangle_count;
					}
				}
			}
		}

		mesh_parts[i].num_triangles= num_triangles_with_this_texture;
		mesh_parts[i].num_vertices= mesh_vertices.size() / 3s - mesh_first_vertex_index;
	}

	scoped_array Mesh mut per_texture_meshes[ block_materials.size() ]( ust::make_zeroed</Mesh/>() );

	for( auto mut i= 0s; i < block_materials.size(); ++i )
	{
		var Mesh& mut mesh= per_texture_meshes[i];

		var MeshPart& mesh_part= mesh_parts[i];

		mesh.vertexCount= i32( mesh_part.num_vertices );
		mesh.triangleCount= i32( mesh_part.num_triangles );
		mesh.vertices= unsafe( mesh_vertices.data() + mesh_part.first_vertex_index * 3s );
		mesh.texcoords= unsafe( mesh_texture_coordinates.data() + mesh_part.first_vertex_index * 2s );
		mesh.colors= unsafe( mesh_colors.data() + mesh_part.first_vertex_index * 4s );
		mesh.indices= unsafe( mesh_indices.data() + mesh_part.first_index );

		unsafe( UploadMesh( $<(mesh), false ) );
	}

	scoped_array ust::vector</u32/> mut dynamic_cluster_extra_info_clusters[ map.zvox.dynamic_cluster_extra_infos.size() ];

	for( auto mut cluster_index= 0s; cluster_index < map.zvox.clusters.size(); ++cluster_index )
	{
		var i32 dynamic_cluster_extra_info_index= map.zvox.clusters[ cluster_index ].dynamic_cluster_extra_info_index;
		if( dynamic_cluster_extra_info_index >= 0 && size_type(dynamic_cluster_extra_info_index) < dynamic_cluster_extra_info_clusters.size() )
		{
			dynamic_cluster_extra_info_clusters[ size_type(dynamic_cluster_extra_info_index) ].push_back( u32(cluster_index) );
		}
	}

	var ust::hash_map</u32, Texture/> mut note_textures;

	auto mut digits_dexture_file_nt= ust::path::join( maps_dir, "PANBL.BMP" );
	digits_dexture_file_nt+= "\0";
	var Texture digits_dexture= unsafe( LoadTexture( digits_dexture_file_nt.data() ) );
	if( digits_dexture.id == 0u )
	{
		ust::stdout_print( "Failed to load digits texture!\n" );
		return -1;
	}

	var Material mut digits_material= unsafe( LoadMaterialDefault() );
	unsafe{ $>( digits_material.maps ).texture = digits_dexture; }

	var ust::vector</f32/> mut digit_mesh_vertices;
	var ust::vector</f32/> mut digit_mesh_texture_coordinatess;

	var f32 digit_half_width= 4.0f;
	var f32 digit_half_height= 8.0f;

	for( auto mut i= 0u; i < 11u; ++i )
	{
		var [ Vector3, 4 ] pos
		[
			{ .x= -digit_half_width, .y= -digit_half_height, .z= 0.0f },
			{ .x= -digit_half_width, .y=  digit_half_height, .z= 0.0f },
			{ .x=  digit_half_width, .y=  digit_half_height, .z= 0.0f },
			{ .x=  digit_half_width, .y= -digit_half_height, .z= 0.0f },
		];

		var f32 glyph_width= 1.0f / 16.0f;
		var f32 glyph_height= 1.0f / 8.0f;
		var [ Vector2, 4 ] tc
		[
			{ .x= glyph_width * f32( i + 1u ), .y= 0.0f },
			{ .x= glyph_width * f32( i + 1u ), .y= glyph_height },
			{ .x= glyph_width * f32(i), .y= glyph_height },
			{ .x= glyph_width * f32(i), .y= 0.0f },
		];

		digit_mesh_vertices.push_back( pos[2].x );
		digit_mesh_vertices.push_back( pos[2].y );
		digit_mesh_vertices.push_back( pos[2].z );
		digit_mesh_texture_coordinatess.push_back( tc[2].x );
		digit_mesh_texture_coordinatess.push_back( tc[2].y );

		digit_mesh_vertices.push_back( pos[1].x );
		digit_mesh_vertices.push_back( pos[1].y );
		digit_mesh_vertices.push_back( pos[1].z );
		digit_mesh_texture_coordinatess.push_back( tc[1].x );
		digit_mesh_texture_coordinatess.push_back( tc[1].y );

		digit_mesh_vertices.push_back( pos[0].x );
		digit_mesh_vertices.push_back( pos[0].y );
		digit_mesh_vertices.push_back( pos[0].z );
		digit_mesh_texture_coordinatess.push_back( tc[0].x );
		digit_mesh_texture_coordinatess.push_back( tc[0].y );

		digit_mesh_vertices.push_back( pos[3].x );
		digit_mesh_vertices.push_back( pos[3].y );
		digit_mesh_vertices.push_back( pos[3].z );
		digit_mesh_texture_coordinatess.push_back( tc[3].x );
		digit_mesh_texture_coordinatess.push_back( tc[3].y );

		digit_mesh_vertices.push_back( pos[2].x );
		digit_mesh_vertices.push_back( pos[2].y );
		digit_mesh_vertices.push_back( pos[2].z );
		digit_mesh_texture_coordinatess.push_back( tc[2].x );
		digit_mesh_texture_coordinatess.push_back( tc[2].y );

		digit_mesh_vertices.push_back( pos[0].x );
		digit_mesh_vertices.push_back( pos[0].y );
		digit_mesh_vertices.push_back( pos[0].z );
		digit_mesh_texture_coordinatess.push_back( tc[0].x );
		digit_mesh_texture_coordinatess.push_back( tc[0].y );
	}

	var [ Mesh, 11 ] mut digit_meshes= zero_init; // The last one is minus sign.

	for( var size_type mut i= 0s; i < 11s; ++i )
	{
		var size_type vertex_offset= 6s * i;

		var Mesh &mut mesh= digit_meshes[i];
		mesh.vertexCount= 6;
		mesh.triangleCount= 2;
		mesh.vertices= unsafe( digit_mesh_vertices.data() + vertex_offset * 3s );
		mesh.texcoords= unsafe( digit_mesh_texture_coordinatess.data() + vertex_offset * 2s );

		unsafe( UploadMesh( $<(mesh), false ) );
	}

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	var size_type mut offset= 0s;

	var bool
		mut display_map= true,
		mut display_bounding_boxes= false,
		mut display_entities= true,
		mut display_clusters= false,
		mut display_light_sources= true,
		mut display_zvox_trigger_volumes= true,
		mut display_visibility_information= false,
		mut display_sky_light= false,
		mut display_navigation_graps= false,
		mut display_rain= false,
		mut display_fog_volumes= true,
		mut display_multiplayer_spawn_points= true,
		mut display_light_shaft_boxes= true,
		mut display_dynamic_clusters= true;

	while( ! unsafe( WindowShouldClose() ) )
	{
		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		if( unsafe( IsKeyPressed( i32( 'M' ) ) ) )
		{
			display_map= !display_map;
		}
		if( unsafe( IsKeyPressed( i32( 'B' ) ) ) )
		{
			display_bounding_boxes= !display_bounding_boxes;
		}
		if( unsafe( IsKeyPressed( i32( 'E' ) ) ) )
		{
			display_entities= !display_entities;
		}
		if( unsafe( IsKeyPressed( i32( 'C' ) ) ) )
		{
			display_clusters= !display_clusters;
		}
		if( unsafe( IsKeyPressed( i32( 'L' ) ) ) )
		{
			display_light_sources= !display_light_sources;
		}
		if( unsafe( IsKeyPressed( i32( 'T' ) ) ) )
		{
			display_zvox_trigger_volumes= !display_zvox_trigger_volumes;
		}
		if( unsafe( IsKeyPressed( i32( 'V' ) ) ) )
		{
			display_visibility_information= !display_visibility_information;
		}
		if( unsafe( IsKeyPressed( i32( 'R' ) ) ) )
		{
			display_sky_light= !display_sky_light;
		}
		if( unsafe( IsKeyPressed( i32( 'G' ) ) ) )
		{
			display_navigation_graps= !display_navigation_graps;
		}
		if( unsafe( IsKeyPressed( i32( 'Y' ) ) ) )
		{
			display_rain= !display_rain;
		}
		if( unsafe( IsKeyPressed( i32( 'F' ) ) ) )
		{
			display_fog_volumes= !display_fog_volumes;
		}
		if( unsafe( IsKeyPressed( i32( 'P' ) ) ) )
		{
			display_multiplayer_spawn_points= !display_multiplayer_spawn_points;
		}
		if( unsafe( IsKeyPressed( i32( 'I' ) ) ) )
		{
			display_light_shaft_boxes= !display_light_shaft_boxes;
		}
		if( unsafe( IsKeyPressed( i32( 'X' ) ) ) )
		{
			display_dynamic_clusters= !display_dynamic_clusters;
		}

		if( unsafe( IsKeyPressed( i32( 'Z' ) ) ) )
		{
			offset+= 1s;
			ust::stdout_print( ust::concat( "Offset is ", ust::to_string8(offset), "\n" ) );
		}

		unsafe( BeginDrawing() );
		{
			var f64 current_time= unsafe( GetTime() );

			unsafe( ClearBackground(
				Color
				{
					.r( ( u32( map_description.sky_colors[0][2] ) + u32( map_description.sky_colors[1][2] ) ) >> 1 ),
					.g( ( u32( map_description.sky_colors[0][1] ) + u32( map_description.sky_colors[1][1] ) ) >> 1 ),
					.b( ( u32( map_description.sky_colors[0][0] ) + u32( map_description.sky_colors[1][0] ) ) >> 1 ),
					.a(0)
				} ) );

			// The original game uses units with pixel size.
			// Scale it a little bit down, since camera controller operates with larger units.
			var f32 scale= 1.0f / 64.0f;

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawCube( Vector3{ .x(1), .y(0), .z( 0) }, 2.0f, 0.2f, 0.2f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(1), .z( 0) }, 0.2f, 2.0f, 0.2f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(0), .z(-1) }, 0.2f, 0.2f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );

				var Matrix mut matrix= zero_init;
				matrix.m0= scale;
				matrix.m5= scale;
				matrix.m10= -scale; // The original game seems to use Z down coordinate system. Flip it to be order to be displayed in OpenGL.
				matrix.m15= 1.0f;

				auto draw_number=
					lambda[&]( i32 mut num, Vector3 pos ) unsafe
					{
						var Matrix mut digit_matrix= zero_init;
						digit_matrix.m0= scale;
						digit_matrix.m5= scale;
						digit_matrix.m10= -scale;
						digit_matrix.m15= 1.0f;
						digit_matrix.m12= pos.x * scale;
						digit_matrix.m13= pos.y * scale;
						digit_matrix.m14= -pos.z * scale;

						var bool mut is_negative= false;
						if( num < 0 )
						{
							is_negative= true;
							num= -num;
						}

						loop
						{
							unsafe( DrawMesh( digit_meshes[ u32( num ) % 10u ], digits_material, digit_matrix ) );
							digit_matrix.m12 += scale * digit_half_width * 2.0f;
							num/= 10;
							if( num == 0 )
							{
								break;
							}
						}

						if( is_negative )
						{
							unsafe( DrawMesh( digit_meshes[ 10 ], digits_material, digit_matrix ) );
						}
					};

				if( display_map )
				{
					for( auto mut i= 0s; i < block_materials.size(); ++i )
					{
						unsafe( DrawMesh( per_texture_meshes[i], block_materials[i], matrix ) );
					}
				}

				if( display_light_shaft_boxes )
				{
					var [ Vector3, 8 ] mut vertices= zero_init;

					foreach( &light_shaft_box : map.zmap.light_shaft_boxes )
					{
						if( light_shaft_box.enabled_flag <= 0 )
						{
							continue;
						}

						var Vector3 center
						{
							.x= f32(light_shaft_box.center[0]) * scale,
							.y= f32(light_shaft_box.center[1]) * scale,
							.z= f32(light_shaft_box.center[2]) * -scale
						};

						var Color color
						{
							.r(light_shaft_box.color_top >> 16),
							.g(light_shaft_box.color_top >> 8),
							.b(light_shaft_box.color_top), .a(128)
						};

						unsafe( DrawCube( center, 0.1f, 0.1f, 0.1f, Color{ .r= color.r, .g= color.g, .b= color.b, .a(255) } ) );

						for( auto mut i= 0u; i < 8u; ++i )
						{
							auto& in_vertex= light_shaft_box.vertices[i];

							vertices[i]=
								Vector3
								{
									.x= center.x + f32(in_vertex[0]) * scale,
									.y= center.y + f32(in_vertex[1]) * scale,
									.z= center.z + f32(in_vertex[2]) * -scale
								};
						}

						unsafe( DrawTriangle3D( vertices[1], vertices[0], vertices[4], color ) );
						unsafe( DrawTriangle3D( vertices[5], vertices[1], vertices[4], color ) );

						unsafe( DrawTriangle3D( vertices[3], vertices[2], vertices[6], color ) );
						unsafe( DrawTriangle3D( vertices[7], vertices[3], vertices[6], color ) );

						unsafe( DrawTriangle3D( vertices[2], vertices[1], vertices[5], color ) );
						unsafe( DrawTriangle3D( vertices[2], vertices[5], vertices[6], color ) );

						unsafe( DrawTriangle3D( vertices[0], vertices[3], vertices[7], color ) );
						unsafe( DrawTriangle3D( vertices[0], vertices[7], vertices[4], color ) );

						unsafe( DrawCubeWires(
							center,
							f32(light_shaft_box.bounding_box_half_size[0]) * scale * 2.0f,
							f32(light_shaft_box.bounding_box_half_size[1]) * scale * 2.0f,
							f32(light_shaft_box.bounding_box_half_size[2]) * scale * 2.0f,
							color ) );
					}
				}

				if( false )
				{
					foreach( &q : map.zmap.quads )
					{
						if( i32(q.texture_roll) == 0 )
						{
							continue;
						}

						unsafe( draw_number( i32( q.texture_roll ), Vector3{ .x(q.center[0s]), .y(q.center[1s]), .z( i32(q.center[2s]) - 1 ) } ) );
					}
				}

				if( display_dynamic_clusters )
				{
					for( auto mut cluster_index= 0s; cluster_index < map.zvox.clusters.size(); ++cluster_index )
					{
						var ZvoxCluster& cluster= map.zvox.clusters[ cluster_index ];

						if( cluster.cluster_type == 0u8 )
						{
							continue;
						}

						var Vector3 pos{ .x= f32(cluster.c.center[0s]) * scale, .y= f32(cluster.c.center[1s]) * scale, .z= f32(cluster.c.center[2s]) * -scale };

						if( cluster.cluster_type == 82u8 )
						{
							// A note.
							var u32 note_index( cluster.light_sources_begin );

							var Texture& texture=
								note_textures.find_or_construct_new(
									note_index,
									lambda[&]() : Texture
									{
										auto mut name= "NOTE000.BMP\0"; // It's null terminated to be able to pass it to C function.
										name[4]= char8( u32('0') + note_index / 100u % 10u );
										name[5]= char8( u32('0') + note_index /  10u % 10u );
										name[6]= char8( u32('0') + note_index /   1u % 10u );
										var ust::filesystem_path mut p= ust::path::join( maps_dir, name );
										return unsafe( LoadTexture( p.data() ) );
									} );

							unsafe( DrawBillboardPro(
								camera,
								texture,
								Rectangle{ .x(0), .y(0), .width(texture.width), .height(texture.height) },
								pos,
								Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
								Vector2{ .x= 1.0f, .y=  f32(texture.height) / f32(texture.width) },
								Vector2{ .x= 0.5f, .y= -0.5f },
								0.0f,
								Color{ .r(255), .g(255), .b(255), .a(200) } ) );
						}
						else
						{
							var Color color{ .r(u32(cluster_index) * 37u), .g(u32(cluster_index) * 1179u), .b(u32(cluster_index) * 5423u), .a(255) };

							unsafe( DrawCubeWires(
								pos,
								f32(cluster.c.bounding_box_half_size[0]) * scale * 2.0f,
								f32(cluster.c.bounding_box_half_size[1]) * scale * 2.0f,
								f32(cluster.c.bounding_box_half_size[2]) * scale * 2.0f,
								color ) );

							var Vector3 direction_vec= GetDynamicClustertMovementDirection( u32( cluster.cluster_type ) );

							var f32 move_dinstance= f32(cluster.light_sources_begin) * scale;

							unsafe( DrawLine3D(
								Vector3
								{
									.x= pos.x + direction_vec.x * ( f32(cluster.c.bounding_box_half_size[0]) * scale ),
									.y= pos.y + direction_vec.y * ( f32(cluster.c.bounding_box_half_size[1]) * scale ),
									.z= pos.z + direction_vec.z * ( f32(cluster.c.bounding_box_half_size[2]) * scale ),
								},
								Vector3
								{
									.x= pos.x + direction_vec.x * ( f32(cluster.c.bounding_box_half_size[0]) * scale + move_dinstance ),
									.y= pos.y + direction_vec.y * ( f32(cluster.c.bounding_box_half_size[1]) * scale + move_dinstance ),
									.z= pos.z + direction_vec.z * ( f32(cluster.c.bounding_box_half_size[2]) * scale + move_dinstance ),
								},
								color ) );

							unsafe( draw_number( i32( cluster.cluster_type ), Vector3{ .x(cluster.c.center[0s]), .y(cluster.c.center[1s]), .z( i32(cluster.c.center[2s] - 32 ) ) } ) );
						}
					}

					// Display links between dynamic clusters.

					var ust::array_view_imut</ ust::vector</u32/> /> dynamic_cluster_extra_info_clusters_ref= dynamic_cluster_extra_info_clusters;

					for( auto mut dynamic_cluster_extra_info_index= 0s;
						dynamic_cluster_extra_info_index < dynamic_cluster_extra_info_clusters_ref.size();
						++dynamic_cluster_extra_info_index )
					{
						var ZvoxDynamicClusterExtraInfo& info= map.zvox.dynamic_cluster_extra_infos[ dynamic_cluster_extra_info_index ];

						if( info.other_info_index >= 0 &&
							size_type(info.other_info_index) < dynamic_cluster_extra_info_clusters_ref.size() )
						{
							foreach( cluster_index : dynamic_cluster_extra_info_clusters_ref[ dynamic_cluster_extra_info_index ] )
							{
								var Color color{ .r(u32(cluster_index) * 37u), .g(u32(cluster_index) * 1179u), .b(u32(cluster_index) * 5423u), .a(255) };

								var ZvoxCluster& cluster= map.zvox.clusters[ size_type(cluster_index) ];

								var Vector3 pos{ .x= f32(cluster.c.center[0s]) * scale, .y= f32(cluster.c.center[1s]) * scale, .z= f32(cluster.c.center[2s]) * -scale };

								if( size_type(info.other_info_index) == dynamic_cluster_extra_info_index )
								{
									// Self-reference.
									// But it looks like there is no such self-references in the original game - all doors and platforms require a button to operate.
									unsafe( DrawCube( pos, 0.05f, 0.05f, 0.05f, color ) );
								}
								else
								{
									foreach( other_cluster_index : dynamic_cluster_extra_info_clusters_ref[ size_type(info.other_info_index) ] )
									{
										var ZvoxCluster& other_cluster= map.zvox.clusters[ size_type(other_cluster_index) ];

										var Vector3 other_pos{ .x= f32(other_cluster.c.center[0s]) * scale, .y= f32(other_cluster.c.center[1s]) * scale, .z= f32(other_cluster.c.center[2s]) * -scale };

										unsafe( DrawLine3D( pos, other_pos, color ) );
									}
								}
							}
						}
					}
				}

				if( display_bounding_boxes )
				{
					foreach( &s : map.zmap.quads )
					{
						var Color color
						{
							.r(s.bounding_box_half_size[0] >> 1),
							.g(s.bounding_box_half_size[1] >> 1),
							.b(s.bounding_box_half_size[2] >> 1),
							.a(255)
						};
						var Vector3 pos{ .x= f32(s.center[0s]) * scale, .y= f32(s.center[1s]) * scale, .z= f32(s.center[2s]) * -scale };
						unsafe( DrawCubeWires(
							pos,
							f32(s.bounding_box_half_size[0]) * 2.0f * scale,
							f32(s.bounding_box_half_size[1]) * 2.0f * scale,
							f32(s.bounding_box_half_size[2]) * 2.0f * scale,
							color ) );
					}
				}

				if( display_clusters )
				{
					for( auto mut cluster_index= 0s; cluster_index < map.zvox.clusters.size(); ++cluster_index )
					{
						var ZvoxCluster& cluster= map.zvox.clusters[cluster_index];

						var Color mut color{ .r(cluster.c.bounding_box_half_size[0]), .g(cluster.c.bounding_box_half_size[1]), .b(cluster.c.bounding_box_half_size[2]), .a(128) };

						var Vector3 pos{ .x= f32(cluster.c.center[0s]) * scale, .y= f32(cluster.c.center[1s]) * scale, .z= f32(cluster.c.center[2s]) * -scale };

						unsafe( DrawCube( pos, 0.1f, 0.1f, 0.1f, color ) );

						color.a= 255u8;
						unsafe( DrawCubeWires(
							pos,
							f32(cluster.c.bounding_box_half_size[0]) * scale * 2.0f,
							f32(cluster.c.bounding_box_half_size[1]) * scale * 2.0f,
							f32(cluster.c.bounding_box_half_size[2]) * scale * 2.0f,
							color ) );

						unsafe( draw_number( i32( cluster_index ), Vector3{ .x(cluster.c.center[0s]), .y(cluster.c.center[1s]), .z( i32(cluster.c.center[2s] - 24) ) } ) );

						if( false )
						{
							// This cluster has several linked quads numbered sequentially.
							for( auto mut i= 0u; i < u32( cluster.num_quads ); ++i )
							{
								var ZmapQuad& quad= map.zmap.quads[ size_type( u32( cluster.c.first_quad_index ) + i ) ];
								var Vector3 quad_pos{ .x= f32(quad.center[0]) * scale, .y= f32(quad.center[1]) * scale, .z= f32(quad.center[2]) * -scale };
								var Color quad_color{ .r(16u), .g(144u), .b(16u), .a(255) };
								unsafe( DrawCube( quad_pos, 0.05f, 0.05f, 0.05f, quad_color ) );
								unsafe( DrawLine3D( pos, quad_pos, quad_color ) );
							}
						}
						if( false )
						{
							// Children clusters are located after this cluster.
							if( cluster.c.num_children_clusters >= 0 )
							{
								for( auto mut i= 0s; i < size_type(cluster.c.num_children_clusters); ++i )
								{
									var ZvoxCluster& other_cluster= map.zvox.clusters[ cluster_index + 1s + i ];
									var Vector3 other_pos{ .x= f32(other_cluster.c.center[0]) * scale, .y= f32(other_cluster.c.center[1]) * scale, .z= f32(other_cluster.c.center[2]) * -scale };
									unsafe( DrawLine3D( pos, other_pos, Color{ .r(16u), .g(144u), .b(144u), .a(255) } ) );
								}
							}
						}
					}

					foreach( &s : map.zvox.clusters )
					{
						var Color mut color{ .r(s.c.bounding_box_half_size[0]), .g(s.c.bounding_box_half_size[1]), .b(s.c.bounding_box_half_size[2]), .a(96) };

						var Vector3 pos{ .x= f32(s.c.center[0s]) * scale, .y= f32(s.c.center[1s]) * scale, .z= f32(s.c.center[2s]) * -scale };

						unsafe( DrawCube(
							pos,
							f32(s.c.bounding_box_half_size[0]) * scale * 2.0f,
							f32(s.c.bounding_box_half_size[1]) * scale * 2.0f,
							f32(s.c.bounding_box_half_size[2]) * scale * 2.0f,
							color ) );
					}
				}

				if( display_visibility_information )
				{
					foreach( pair : map.zpoz.clusters.iter().zip( map.zpoz.clusters_visibility_data.iter() ) )
					{
						var ZpozCluster& cluster= pair.first;

						var Vector3 pos{ .x= f32(cluster.center[0s]) * scale, .y= f32(cluster.center[1s]) * scale, .z= f32(cluster.center[2s]) * -scale };

						var i32 bias= i32(map.zpoz.clusters.size()) * 4;
						if( pair.second.data[0] != -1 )
						{
							var size_type some_offset( pair.second.data[2] - bias );

							// We have 2 subranges for both pairs of indices.
							var size_type size0( map.zpoz.cluster_indices[ some_offset  ] );
							var size_type subrange0_start= some_offset + 8s;
							var size_type size1( map.zpoz.cluster_indices[ subrange0_start + size0 ] );
							var size_type subrange1_start= subrange0_start + size_type(size0) + 8s;

							ust::ignore_unused( size0 );
							ust::ignore_unused( subrange0_start );
							ust::ignore_unused( size1 );
							ust::ignore_unused( subrange1_start );

							for( auto mut i= 0s; i < size0; ++i )
							{
								var size_type index( map.zpoz.cluster_indices[ subrange0_start + i ] );

								var ZpozCluster& other_cluster= map.zpoz.clusters[ index ];

								var Vector3 other_pos{ .x= f32(other_cluster.center[0s]) * scale, .y= f32(other_cluster.center[1s]) * scale, .z= f32(other_cluster.center[2s]) * -scale };
								var Color color{ .r(16u), .g(200u), .b(16u), .a(200u) };
								unsafe( DrawLine3D( pos, other_pos, color ) );
							}
						}
					}
				}

				if( display_sky_light )
				{
					foreach( pair : map.zvox.clusters.iter().zip( map.zmap_lem.clusters_sky_light_data.iter() ) )
					{
						var ZvoxCluster& cluster= pair.first;

						if( cluster.c.num_children_clusters < 0 )
						{
							// Ignore non-room clusters.
							continue;
						}

						var ZmapLemClusterSkyLightData& sky_light_data= pair.second;

						var bool mut all_zeros= true;
						foreach( n : sky_light_data.light )
						{
							all_zeros &= n == 0u;
						}

						if( all_zeros )
						{
							continue;
						}

						var Vector3 start{ .x= f32(cluster.c.center[0s] - cluster.c.bounding_box_half_size[0]) * scale, .y= f32(cluster.c.center[1s] - cluster.c.bounding_box_half_size[1]) * scale, .z= f32(cluster.c.center[2s] - cluster.c.bounding_box_half_size[2]) * -scale };
						var Vector3 end{ .x= f32(cluster.c.center[0s] + cluster.c.bounding_box_half_size[0]) * scale, .y= f32(cluster.c.center[1s] + cluster.c.bounding_box_half_size[1]) * scale, .z= f32(cluster.c.center[2s] + cluster.c.bounding_box_half_size[2]) * -scale };

						var u32 size_x= 4u;
						var u32 size_y= 4u;
						var u32 size_z= 4u;
						var u32 dz= u32(offset & 3s);
						var f32 quad_size_x= (start.x - end.x) / f32(size_x);
						var f32 quad_size_y= (start.y - end.y) / f32(size_y);
						var f32 quad_size_z= (start.z - end.z) / f32(size_z);
						for( auto mut dy= 0u; dy < size_y; ++dy )
						{
							for( auto mut dx= 0u; dx < size_x; ++dx )
							{
								var u32 val= sky_light_data.light[ dx + dy * size_x + dz * size_x * size_y ];

								if( val != 0u )
								{
									var Vector3 pos{ .x= start.x + (end.x - start.x) * ( f32(dx) + 0.5f ) / f32(size_x), .y= start.y + (end.y - start.y) * ( f32(dy) + 0.5f ) / f32(size_y), .z= start.z + (end.z - start.z) * ( f32(dz) + 0.5f ) / f32(size_z) };
									var Color mut color{ .r( ( val >> 16u ) & 255u ), .g( ( val >> 8u ) & 255u ), .b( ( val >> 0u ) & 255u ), .a(32) };
									unsafe( DrawCube( pos, quad_size_x, quad_size_y, quad_size_z, color ) );
									color.a= 255u8;
									unsafe( DrawCubeWires( pos, quad_size_x, quad_size_y, quad_size_z, color ) );
								}
							}
						}
					}
				}

				if( display_light_sources )
				{
					foreach( &cluster : map.zvox.clusters )
					{
						// This cluster has several linked light sources.
						for( auto mut i= cluster.light_sources_begin; i < cluster.light_sources_end; ++i )
						{
							var ZvoxLightSource& light= map.zvox.light_sources[ size_type( i ) ];

							auto& src_color= game_params.light_colors[ ( u32(light.packed_corona_color_index) >> 3 ) & 31u ];

							var Color color{ .r(src_color[2s]), .g(src_color[1s]), .b(src_color[0s]), .a(255) };

							var Vector3 pos{ .x= f32(cluster.c.center[0] + light.offset[0s]) * scale, .y= f32(cluster.c.center[1] + light.offset[1s]) * scale, .z= f32(cluster.c.center[2] + light.offset[2s]) * -scale };
							unsafe( DrawSphere( pos, 0.0625f, color ) );

							if( true )
							{
								unsafe( draw_number( i32( light.power ), Vector3{ .x(cluster.c.center[0s] + light.offset[0s]), .y(cluster.c.center[1s] + light.offset[1s]), .z( i32(cluster.c.center[2s] + light.offset[2s] - 32 ) ) } ) );
							}

							// Experimental estimation of light power.
							var i32 power= 160 - i32(light.power);

							// Radius of area with eqaul (near to zero) light flux for given power.
							var f32 mut radius= ust::sqrt( f32(power) / 8.0f * 65536.0f ) * scale;

							// Display radius slightly less than the correct one - otherwise it looks too ugly.
							var f32 radius_scaled= radius / 4.0f;

							unsafe( DrawSphereWires( pos, radius_scaled, 8, 12, color ) );

							if( ( u32( light.packed_corona_color_index ) & 7u ) == 0u )
							{
								unsafe( DrawBillboardPro(
									camera,
									block_textures[126s],
									Rectangle{ .x(0), .y(0), .width(128), .height(128) },
									pos,
									Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
									Vector2{ .x= 0.5f, .y= 0.5f },
									Vector2{ .x= 0.25f, .y= 0.25f },
									0.0f,
									Color{ .r(255), .g(255), .b(255), .a(200) } ) );
							}
							if( ( u32( light.packed_corona_color_index ) & 7u ) == 3u )
							{
								var u32 frame= u32( current_time * 6.0) % 24u;
								var u32 tile_x= frame % 6u;
								var u32 tile_y= frame / 6u;

								unsafe( DrawBillboardPro(
									camera,
									block_textures[136s],
									Rectangle{ .x(128u * tile_x / 3u), .y(128u * tile_y / 4u), .width(128u / 3u), .height(128u / 4u) },
									pos,
									Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f },
									Vector2{ .x= 0.5f, .y= 0.5f },
									Vector2{ .x= 0.25f, .y= 0.25f },
									0.0f,
									Color{ .r(255), .g(255), .b(255), .a(200) } ) );
							}
						}
					}
				}

				if( display_entities )
				{
					foreach( &entity : map.zpoz.entities )
					{
						if( entity.alive_flag == 0u16 )
						{
							continue;
						}

						var Color color{ .r(u32(entity.kind) * 37u), .g(u32(entity.kind) * 1179u), .b(u32(entity.kind) * 5423u), .a(255) };

						var Vector3 pos{ .x= f32(entity.position[0s]) * scale, .y= f32(entity.position[1s]) * scale, .z= f32(entity.position[2s]) * -scale };

						unsafe( DrawCube( pos, 0.4f, 0.4f, 0.6f, color ) );

						unsafe( draw_number( i32( entity.kind ), Vector3{ .x(entity.position[0s]), .y(entity.position[1s]), .z( i32(entity.position[2s]) - 24 ) } ) );

						var size_type navigation_info_index( entity.data[16] );
						if( navigation_info_index < map.zpoz.entity_navigation_infos.size() )
						{
							var ZpozEntityNavigationInfo& navigation_info= map.zpoz.entity_navigation_infos[ navigation_info_index ];

							if( navigation_info.num_patrolling_points > 0u )
							{
								var Color point_color{ .r( u32(color.r) >> 2 ), .g( u32(color.g) >> 2 ), .b( u32(color.b) >> 2 ), .a= color.a };

								var u32 last_point_index= navigation_info.num_patrolling_points - 1u;
								var Vector3 mut prev_point_pos
								{
									.x= f32(navigation_info.patrolling_point_coords[last_point_index +  0u]) * scale,
									.y= f32(navigation_info.patrolling_point_coords[last_point_index + 16u]) * scale,
									.z= f32(navigation_info.patrolling_point_coords[last_point_index + 32u]) * -scale
								};

								for( auto mut point_index= 0u; point_index < navigation_info.num_patrolling_points; ++point_index )
								{
									var Vector3 point_pos
									{
										.x= f32(navigation_info.patrolling_point_coords[point_index +  0u]) * scale,
										.y= f32(navigation_info.patrolling_point_coords[point_index + 16u]) * scale,
										.z= f32(navigation_info.patrolling_point_coords[point_index + 32u]) * -scale
									};

									unsafe( DrawCube( point_pos, 0.2f, 0.2f, 0.2f, point_color ) );

									unsafe( DrawLine3D( prev_point_pos, point_pos, point_color ) );

									prev_point_pos= point_pos;
								}
							}

							if( navigation_info.spawn_trigger_is_present != 0u )
							{
								var Vector3 box_center
								{
									.x= f32(navigation_info.spawn_trigger_box_center[0]) * scale,
									.y= f32(navigation_info.spawn_trigger_box_center[1]) * scale,
									.z= f32(navigation_info.spawn_trigger_box_center[2]) * -scale
								};

								unsafe( DrawCubeWires(
									box_center,
									f32(navigation_info.spawn_trigger_box_half_size[0]) * scale * 2.0f,
									f32(navigation_info.spawn_trigger_box_half_size[1]) * scale * 2.0f,
									f32(navigation_info.spawn_trigger_box_half_size[2]) * scale * 2.0f,
									color ) );

								unsafe( DrawLine3D( pos, box_center, color ) );
							}
						}
					}
				}

				if( display_multiplayer_spawn_points )
				{
					foreach( &s : map.zpoz.multiplayer_spawn_points )
					{
						var Color color{ .r(30), .g(240), .b(20), .a(128) };
						var Vector3 pos{ .x= f32(s.data[1]) * scale, .y= f32(s.data[2]) * scale, .z= f32(s.data[3]) * -scale };

						unsafe( DrawSphere( pos, 0.4f, color ) );

						unsafe( draw_number( i32( s.data[offset] ), Vector3{ .x(s.data[1]), .y(s.data[2]), .z( i32(s.data[3]) ) } ) );
					}
				}

				if( display_zvox_trigger_volumes )
				{
					foreach( &s : map.zvox.trigger_volumes )
					{
						var Color color{ .r(255), .g(0), .b(0), .a(128) };
						var Vector3 pos{ .x= f32(s.center[0]) * scale, .y= f32(s.center[1]) * scale, .z= f32(s.center[2]) * -scale };

						unsafe( DrawCubeWires(
							pos,
							2.0f * f32(s.bounding_box_half_size[0]) * scale,
							2.0f * f32(s.bounding_box_half_size[1]) * scale,
							2.0f * f32(s.bounding_box_half_size[2]) * -scale,
							color ) );

						unsafe( draw_number( i32( s.trigger_param ), Vector3{ .x(s.center[0]), .y(s.center[1]), .z( i32(s.center[2]) ) } ) );
					}
				}

				if( display_fog_volumes )
				{
					foreach( &s : map.zvox.fog_volumes )
					{
						var Color color{ .r(0), .g(255), .b(255), .a(255) };
						var Vector3 pos{ .x= f32(s.center[0]) * scale, .y= f32(s.center[1]) * scale, .z= f32(s.center[2]) * -scale };

						unsafe( DrawCubeWires(
							pos,
							2.0f * f32(s.bounding_box_half_size[0]) * scale,
							2.0f * f32(s.bounding_box_half_size[1]) * scale,
							2.0f * f32(s.bounding_box_half_size[2]) * -scale, color ) );
					}
				}

				if( display_rain )
				{
					// Experimentally-calculated vector. TODO - maybe express it via angles?
					var Vector3 constexpr c_move_vec{ .x= 0.235f, .y= 0.235f, .z= -0.943f };

					var f32 base_phase= f32( current_time );

					foreach( &rain_droplet : map.zmap_lam.rain_droplets )
					{
						var Vector3 pos{ .x= rain_droplet.position[0] * scale, .y= rain_droplet.position[1] * scale, .z= rain_droplet.position[2] * -scale };

						var f32 dist= rain_droplet.travel_distance * scale;

						var f32 phase_scaled= ( base_phase + f32( rain_droplet.movement_phase ) ) / ust::max( 1.0f, dist );
						var f32 lerp= 1.0f - ( phase_scaled  - ust::floor( phase_scaled ) );

						var Vector3 pos_offset{ .x= pos.x + dist * c_move_vec.x, .y= pos.y + dist * c_move_vec.y, .z= pos.z + dist * c_move_vec.z };

						var Vector3 pos_lerp{ .x= pos.x * lerp + pos_offset.x * ( 1.0f - lerp ), .y= pos.y * lerp + pos_offset.y * ( 1.0f - lerp ), .z= pos.z * lerp + pos_offset.z * ( 1.0f - lerp ) };

						unsafe( DrawCube( pos_lerp, 0.05f, 0.05f, 0.05f, Color{ .r(rain_droplet.color_brga >> 16), .g(rain_droplet.color_brga >> 8), .b(rain_droplet.color_brga), .a(255) } ) );

						var Color color{ .r(0), .g(255), .b(0), .a(255) };

						if( false )
						{
							auto& q= map.zmap.quads[ size_type( rain_droplet.quad_index ) ];

							unsafe( DrawLine3D(
								pos,
								Vector3{ .x= f32(q.center[0]) * scale, .y= f32(q.center[1s]) * scale, .z= f32(q.center[2]) * -scale },
								color ) );
						}

						if( false )
						{
							auto& c= map.zvox.clusters[ size_type( rain_droplet.cluster_index ) ].c;

							unsafe( DrawLine3D(
								pos,
								Vector3{ .x= f32(c.center[0]) * scale, .y= f32(c.center[1s]) * scale, .z= f32(c.center[2]) * -scale },
								color ) );
						}
					}
				}

				if( display_navigation_graps )
				{
					var ZpozEntity& entity= map.zpoz.entities[offset];

					var size_type graph_index( entity.data[16] );

					if( graph_index < map.mapa_way.navigation_graphs.size() )
					{
						var MapaWayNavigationGraph& graph= map.mapa_way.navigation_graphs[ graph_index ];

						var Color color{ .r(graph_index * 73s), .g(graph_index * 137s), .b(graph_index * 279s ), .a(255) };

						for( auto mut j= 0s; j < size_type( graph.num_nodes ); ++j )
						{
							var MapaWayNavigationGraphNode& node= graph.nodes[j];

							var Vector3 pos{ .x= f32(node.position[0]) * scale, .y= f32(node.position[1]) * scale, .z= f32(node.position[2]) * -scale };

							unsafe( DrawCube( pos, 0.2f, 0.2f, 0.2f, color ) );

							if( node.unknown3 != 0 )
							{
								unsafe( draw_number( node.unknown3, Vector3{ .x(node.position[0]), .y(node.position[1] ), .z( i32(node.position[2]) - 9 ) } ) );
							}

							for( auto mut k= 0s; k < size_type( graph.num_nodes ); ++k )
							{
								if( k == j )
								{
									continue;
								}

								var size_type l= size_type( graph.routing_matrix[j][k] );
								if( l < size_type( graph.num_nodes ) )
								{
									var MapaWayNavigationGraphNode& other_node= graph.nodes[l];

									var Vector3 other_pos{ .x= f32(other_node.position[0]) * scale, .y= f32(other_node.position[1]) * scale, .z= f32(other_node.position[2]) * -scale };

									unsafe( DrawLine3D( pos, other_pos, color ) );
								}
							}
						}
					}
				}

				if( false )
				{
					for( auto mut c= 0s; c < map.zvox.clusters.size(); ++c )
					{
						auto& cluster= map.zvox.clusters[c].c;
						var Vector3 pos{ .x= f32(cluster.center[0s]) * scale, .y= f32(cluster.center[1s]) * scale, .z= f32(cluster.center[2s]) * -scale };

						var u32 offset_start= map.zmap_lam.clusters_rain_visibility_data[ c * 2s + 0s ];
						var u32 offset_end= map.zmap_lam.clusters_rain_visibility_data[ c * 2s + 1s ];
						for( auto mut offset= offset_start; offset < offset_end; ++offset )
						{
							var u32 other_c= map.zmap_lam.clusters_rain_visibility_data[ size_type( offset )  ];
							auto& other_cluster= map.zvox.clusters[ size_type(other_c) ].c;

							unsafe( DrawLine3D(
								pos,
								Vector3{ .x= f32(other_cluster.center[0s]) * scale, .y= f32(other_cluster.center[1s]) * scale, .z= f32(other_cluster.center[2s]) * -scale },
								Color{ .r(c * 37s), .g(c * 157s), .b(c * 1293s), .a(255) } ) );
						}
					}
				}
			}
			unsafe( EndMode3D() );


			{
				var ust::string8 mut text;
				text+= "Camera position: ";
				text+= ust::to_string8( i32( camera.position.x / scale ) );
				text+= ", ";
				text+= ust::to_string8( i32( camera.position.y / scale ) );
				text+= ", ";
				text+= ust::to_string8( i32( camera.position.z / -scale ) );
				text+= "\0";

				unsafe( DrawText( text.data(), 0, 0, 12, Color{ .r(240), .g(240), .b(240), .a(255) } ) );
			}

		}

		unsafe( EndDrawing() );
	}

	// Do not care freeng here raylib objects like meshes, materials, textures. We quit anyway and this should release all resoources (even GPU-related).

	unsafe( CloseWindow() );

	return 0;
}

struct MeshPart
{
	size_type first_vertex_index;
	size_type first_index;
	size_type num_triangles;
	size_type num_vertices;
}

fn GetDynamicClustertMovementDirection( u32 cluster_type ) : Vector3
{
	// These values are experimentally-found.
	switch( cluster_type )
	{
		      58u, 74u -> { return Vector3{ .x= 1.0f, .y= 0.0f, .z= 0.0f }; },
		44u,  62u, 78u -> { return Vector3{ .x= -1.0f, .y= 0.0f, .z= 0.0f }; },
		38u,  56u, 72u -> { return Vector3{ .x= 0.0f, .y= 1.0f, .z= 0.0f }; },
		34u,  52u, 68u -> { return Vector3{ .x= 0.0f, .y= -1.0f, .z= 0.0f }; },
		16u, 26u, 30u -> { return Vector3{ .x= 0.0f, .y= 0.0f, .z= 1.0f }; },
		24u, 28u -> { return Vector3{ .x= 0.0f, .y= 0.0f, .z= -1.0f }; },
		default -> { return Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f }; },
	}
}

} // namespace PM
