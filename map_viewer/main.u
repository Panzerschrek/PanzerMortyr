import "/enum_string_conversions.u"
import "/file.u"
import "/main_wrapper.u"
import "/math.u"
import "/path.u"
import "/stdout.u"
import "/string_conversions.u"
import "/vector.u"

import "/raylib_wrapper/raylib.uh"

pretty_main
{
	if( args.size() < 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}
	var ust::string_view8 map_file_path= args[1s];

	auto map_opt= LoadMap( map_file_path );
	if( map_opt.empty() )
	{
		return -1;
	}

	var i32 screen_width = 1024;
	var i32 screen_height = 768;

	unsafe( InitWindow( screen_width, screen_height, $<( cast_mut( "PanzerMortyr MapViewer\0"[0] ) ) ) );

	var Camera3D mut camera
	{
		.position = Vector3{ .x= 10.0f, .y= 10.0f, .z= 10.0f },
		.target = Vector3{ .x= 0.0f, .y= 0.0f, .z= 0.0f },
		.up = Vector3{ .x= 0.0f, .y= 0.0f, .z= -1.0f },
		.fovy = 75.0f,
		.projection( CAMERA_PERSPECTIVE )
	};

	unsafe( DisableCursor() );

	unsafe( SetTargetFPS(60) );

	var u32 mut offset= 1u;

	while( ! unsafe( WindowShouldClose() ) )
	{
		unsafe( UpdateCamera( $<(camera), i32( CAMERA_FREE ) ) );

		if( unsafe( IsKeyPressed( i32( 'Z' ) ) ) )
		{
			++offset;
			ust::stdout_print( ust::concat( "Offset is ", ust::to_string8(offset), "\n" ) );
		}

		unsafe(  BeginDrawing() );
		{
			unsafe( ClearBackground( Color{ .r(32), .g(16), .b(8), .a(0) } ) );

			unsafe( BeginMode3D(camera) );
			{
				unsafe( DrawGrid( 128, 1.0f ) );

				unsafe( DrawCube( Vector3{ .x(1), .y(0), .z(0) }, 2.0f, 0.2f, 0.2f, Color{ .r(255), .g(0), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(1), .z(0) }, 0.2f, 2.0f, 0.2f, Color{ .r(0), .g(255), .b(0), .a(255) } ) );
				unsafe( DrawCube( Vector3{ .x(0), .y(0), .z(1) }, 0.2f, 0.2f, 2.0f, Color{ .r(0), .g(0), .b(255), .a(255) } ) );

				var f32 scale= 1.0f / 64.0f;
				foreach( &s : map_opt.try_deref().structs )
				{
					ust::ignore_unused( s.data0 );
					ust::ignore_unused( s.data1 );
					var Vector3 mut pos{ .x(s.center[0u]), .y(s.center[1u]), .z(s.center[2u]) };
					pos.x*= -scale;
					pos.y*= scale;
					pos.z*= scale;
					//var Color c{ .r(255), .g(0), .b(255), .a(255) };
					var Color c{ .r(i32(s.data1[0])), .g(i32(s.data1[0])), .b(i32(s.data1[0])), .a(255) };
					unsafe( DrawCube( pos, 0.1f, 0.1f, 0.1f, Color{ .r(255), .g(0), .b(255), .a(255) } ) );

					var f32 shift_scale= scale;

					var Vector3 shift0{ .x= - f32(s.data0[offset + 0u]) * shift_scale, .y= f32(s.data0[offset + 1u]) * shift_scale, .z= f32(s.data0[offset + 2u]) * shift_scale };
					var Vector3 shift1{ .x= - f32(s.data0[offset + 3u]) * shift_scale, .y= f32(s.data0[offset + 4u]) * shift_scale, .z= f32(s.data0[offset + 5u]) * shift_scale };
					var Vector3 shift2{ .x= - f32(s.data0[offset + 6u]) * shift_scale, .y= f32(s.data0[offset + 7u]) * shift_scale, .z= f32(s.data0[offset + 8u]) * shift_scale };
					var Vector3 shift3{ .x= - f32(s.data0[offset + 9u]) * shift_scale, .y= f32(s.data0[offset + 10u]) * shift_scale, .z= f32(s.data0[offset + 11u]) * shift_scale };

					var Vector3 center
					{
						.x= ( shift0.x + shift1.x + shift2.x + shift3.x ) / 4.0f,
						.y= ( shift0.y + shift1.y + shift2.y + shift3.y ) / 4.0f,
						.z= ( shift0.z + shift1.z + shift2.z + shift3.z ) / 4.0f,
					};

					var Vector3 pos0{ .x= pos.x - center.x + shift0.x, .y= pos.y - center.y + shift0.y, .z= pos.z - center.z + shift0.z };
					var Vector3 pos1{ .x= pos.x - center.x + shift1.x, .y= pos.y - center.y + shift1.y, .z= pos.z - center.z + shift1.z };
					var Vector3 pos2{ .x= pos.x - center.x + shift2.x, .y= pos.y - center.y + shift2.y, .z= pos.z - center.z + shift2.z };
					var Vector3 pos3{ .x= pos.x - center.x + shift3.x, .y= pos.y - center.y + shift3.y, .z= pos.z - center.z + shift3.z };
					unsafe( DrawTriangle3D( pos0, pos1, pos2, c ) );
					unsafe( DrawTriangle3D( pos0, pos2, pos3, c ) );

					unsafe( DrawTriangle3D( pos2, pos1, pos0, c ) );
					unsafe( DrawTriangle3D( pos3, pos2, pos0, c ) );
				}
			}
			unsafe( EndMode3D() );
		}
		unsafe( EndDrawing() );
	}

	unsafe( CloseWindow() );

	return 0;
}

struct MapData
{
	ust::vector</MapStruct/> structs;
}

struct MapStruct ordered
{
	[ i16, 17 ] data0;
	[ i16, 3 ] center;
	[ u16, 4  ] data1;
}

static_assert( typeinfo</MapStruct/>.size_of == 48s );

fn LoadMap( ust::filesystem_path_view file_path ) : ust::optional</MapData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadMap( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening archive file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadMap( ust::file_readable mut f ) : ust::optional</MapData/>
{
	var u64 mut file_size(0);
	result_match( f.get_metatada() )
	{
		Ok(m) -> { file_size= m.size; },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error getting archive file size: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}

	f.seek( 32u64 ).is_ok();

	ust::stdout_print( ust::concat( "Has size ", ust::to_string8(file_size), " bytes\n" ) );

	var size_type num_structs= size_type(file_size - 32u64 - 896u64 ) / typeinfo</MapStruct/>.size_of - 4s;

	var MapData mut result;

	var MapStruct dummy_struct= zero_init;

	result.structs.resize( num_structs, dummy_struct );

	auto read_res=
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs.data() ),
				result.structs.size() * typeinfo</MapStruct/>.size_of ) ) );

	if( read_res.is_error() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( read_res.try_deref_error() ), ", \n" ) );
		return ust::null_optional;
	}

	return result;
}
