			return ust::null_optional;
		}
	}
}

fn LoadZmapLamFile( ust::file_readable mut f ) : ust::optional</ZmapLamData/>
{
	var ZmapLamHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZPozFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	var ZmapLamData mut result;

	{
		var ZmapLamStruct0 dummy_struct0= zero_init;
		result.structs0.resize( size_type( header.num_structs0 ), dummy_struct0 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.structs0.data() ),
					result.structs0.size() * typeinfo</ZmapLamStruct0/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	{
		var ZmapLamStruct1 dummy_struct1= zero_init;
		result.structs1.resize( size_type( header.num_structs1 ), dummy_struct1 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.structs1.data() ),
					result.structs1.size() * typeinfo</ZmapLamStruct1/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}
	{
		var ZmapLamStruct2 dummy_struct2= zero_init;
		result.structs2.resize( size_type( header.num_structs2 ), dummy_struct2 );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.structs2.data() ),
					result.structs2.size() * typeinfo</ZmapLamStruct2/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	// There is some data still left - at least several kilobytes. It's at least one more block.

	{
		var i32 mut min_index= 0;
		var i32 mut max_index= 0;
		foreach( &s : result.structs0 )
		{
			foreach( i : s.data )
			{
				ust::min_assign( min_index, i );
				ust::max_assign( max_index, i );
			}
		}

		ust::stdout_print( ust::concat( "ZMAP*.LAM indices are in range ", ust::to_string8(min_index), " to ", ust::to_string8(max_index), "\n" ) );
	}
	{
		var i32 mut min_index= 0;
		var i32 mut max_index= 0;
		foreach( &s : result.structs1 )
		{
			foreach( i : s.data )
			{
				ust::min_assign( min_index, i );
				ust::max_assign( max_index, i );
			}
		}

		ust::stdout_print( ust::concat( "ZMAP*.LAM structs1 are in range ", ust::to_string8(min_index), " to ", ust::to_string8(max_index), "\n" ) );
	}

	return result;
}

fn ConvertToUppercase( ust::string_view8 s ) : ust::string8
{
	return ust::string8::from_mapped_range(
		s,
		lambda( char8 c ) : char8
		{
			if( c >= 'a' && c <= 'z' )
			{
				return char8( u32(c) - u32('a') + u32('A') );
			}
			return c;
		} );
}

} // namespace PM
