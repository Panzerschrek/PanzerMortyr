fn LoadZmapLamFile( ust::file_readable mut f ) : ust::optional</ZmapLamData/>
{
	var ZmapLamHeader mut header= zero_init;

	if_var( e : f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "ZMAP*.LAM header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs0 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs1 );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs2 );
		m+= ", ";
		m+= ust::to_string8( header.num6 );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapLamData mut result;

	result.structs0.resize( size_type( header.num_structs0 ), ust::make_zeroed</ZmapLamStruct0/>() );

	if_var( e : f.read_exact( result.structs0.range().to_byte8_range()  ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.structs1.resize( size_type( header.num_structs1 ), ust::make_zeroed</ZmapLamStruct1/>() );

	if_var( e : f.read_exact( result.structs1.range().to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.structs2.resize( size_type( header.num_structs2 ), ust::make_zeroed</ZmapLamStruct2/>() );

	if_var( e : f.read_exact( result.structs2.range().to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	// There is some data still left - at least several kilobytes. It's at least one more block.

	return result;
}

