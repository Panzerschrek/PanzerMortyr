import "/enum_string_conversions.u"
import "/file.u"
import "/hash_set.u"
import "/stdout.u"
import "/string.u"
import "/string_conversions.u"
import "map_loading.uh"

namespace PM
{


fn LoadMap(
	ust::filesystem_path_view zmap_file_path,
	ust::filesystem_path_view zvox_file_path,
	ust::filesystem_path_view zpoz_file_path,
	ust::filesystem_path_view zmap_lam_file_path,
	ust::filesystem_path_view zmap_lem_file_path ) : ust::optional</MapData/>
{
	auto mut zmap_data= LoadZmapFile( zmap_file_path );
	auto mut zvox_data= LoadZvoxFile( zvox_file_path );
	auto mut zpoz_data= LoadZpozFile( zpoz_file_path );
	auto mut zmap_lam_data= LoadZmapLamFile( zmap_lam_file_path );
	auto mut zmap_lem_data= LoadZmapLemFile( zmap_lem_file_path );

	if( zmap_data.empty() ||
		zvox_data.empty() ||
		zpoz_data.empty() ||
		zmap_lam_data.empty() ||
		zmap_lem_data.empty() )
	{
		return ust::null_optional;
	}

	return MapData
	{
		.zmap= zmap_data.try_take(),
		.zvox= zvox_data.try_take(),
		.zpoz= zpoz_data.try_take(),
		.zmap_lam= zmap_lam_data.try_take(),
		.zmap_lem= zmap_lem_data.try_take(),
	};
}

fn LoadZmapFile( ust::filesystem_path_view file_path ) : ust::optional</ZmapData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadZmapFile( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZmapFile( ust::file_readable mut f ) : ust::optional</ZmapData/>
{
	var ZMapFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZMapFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ZMapFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "ZMAP header nums: ";
		m+= ust::to_string8( header.num_quads );
		m+= ", ";
		m+= ust::to_string8( header.presumable_some_other_num );
		m+= ", ";
		m+= ust::to_string8( header.data[0] );
		m+= ", ";
		m+= ust::to_string8( header.data[1] );
		m+= ", ";
		m+= ust::to_string8( header.data[2] );
		m+= ", ";
		m+= ust::to_string8( header.data[3] );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapData mut result;

	result.quads.resize( size_type( header.num_quads ), ust::make_zeroed</ZmapQuad/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.quads.data() ),
				result.quads.size() * typeinfo</ZmapQuad/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), ", \n" ) );
		return ust::null_optional;
	}

	return result;
}

fn LoadZvoxFile( ust::filesystem_path_view file_path ) : ust::optional</ZvoxData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadZvoxFile( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZvoxFile( ust::file_readable mut f ) : ust::optional</ZvoxData/>
{
	var ZVoxFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZVoxFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ZVoxFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "ZVOX header nums: ";
		m+= ust::to_string8( header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( header.num_structs0 );
		m+= ", ";
		m+= ust::to_string8( header.num_light_sources );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num5 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZvoxData mut result;

	result.structs0.resize( size_type( header.num4 ), ust::make_zeroed</ZvoxStruct0/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs0.data() ),
				result.structs0.size() * typeinfo</ZvoxStruct0/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.structs1.resize( size_type( header.num3 ), ust::make_zeroed</ZvoxStruct1/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs1.data() ),
				result.structs1.size() * typeinfo</ZvoxStruct1/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.clusters.resize( size_type( header.num_clusters ), ust::make_zeroed</ZvoxCluster/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.clusters.data() ),
				result.clusters.size() * typeinfo</ZvoxCluster/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.light_sources.resize( size_type( header.num_light_sources ), ust::make_zeroed</ZvoxLightSource/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.light_sources.data() ),
				result.light_sources.size() * typeinfo</ZvoxLightSource/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	// There is at least one more data block left in this file, which size and meaning isn't known yet.
	// But it is filled with zeros, at least in some cases.

	if( false )
	{
		var [ i32, 10 ] mut mins[  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF,  0x7FFFFFFF ];
		var [ i32, 10 ] mut maxs[ -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF, -0x7FFFFFFF ];
		foreach( &s : result.structs0 )
		{
			for( auto mut i= 0s; i < 10s; ++i )
			{
				ust::min_assign( mins[i], s.data[i] );
				ust::max_assign( maxs[i], s.data[i] );
			}
		}

		for( auto mut i= 0s; i < 10s; ++i )
		{
			ust::stdout_print( ust::concat( "ZVOX struct0 field ", ust::to_string8(i), " minmax are ", ust::to_string8( mins[i] ), " ", ust::to_string8( maxs[i] ), "\n" ) );
		}
	}

	if( false )
	{
		var i32 mut min_data2= 99999999, mut max_data2= -99999999;
		var i32 mut min_data4= 99999999, mut max_data4= -99999999;
		foreach( &s : result.clusters )
		{
			ust::min_assign( min_data2, s.light_sources_begin );
			ust::max_assign( max_data2, s.light_sources_begin );
			ust::min_assign( min_data4, s.light_sources_end );
			ust::max_assign( max_data4, s.light_sources_end );
		}
		ust::stdout_print( ust::concat( "ZVOX clusters data1[2] min/max: ", ust::to_string8(min_data2), ", ", ust::to_string8(max_data2), "\n" ) );
		ust::stdout_print( ust::concat( "ZVOX clusters data1[4] min/max: ", ust::to_string8(min_data4), ", ", ust::to_string8(max_data4), "\n" ) );
	}

	if( false )
	{
		var [ i32, 3 ] mut mins[ 999999, 999999, 999999, ], mut maxs[ -999999, -999999, -999999 ];
		var [ i16, 2 ] mut extra_mins[ (9999), (9999) ], mut extra_maxs[ (-9999), (-9999) ];
		foreach( &s : result.light_sources )
		{
			for( auto mut i= 0s; i < 3s; ++i )
			{
				ust::min_assign( mins[i], s.offset[i] );
				ust::max_assign( maxs[i], s.offset[i] );
			}
			for( auto mut i= 0s; i < 2s; ++i )
			{
				ust::min_assign( extra_mins[i], s.data1[i] );
				ust::max_assign( extra_maxs[i], s.data1[i] );
			}
		}
		ust::stdout_print( ust::concat( "ZVOX light sources mins: ", ust::to_string8(mins[0]), ", ", ust::to_string8(mins[1]), ", ", ust::to_string8(mins[2]), "\n" ) );
		ust::stdout_print( ust::concat( "ZVOX light sources maxs: ", ust::to_string8(maxs[0]), ", ", ust::to_string8(maxs[1]), ", ", ust::to_string8(maxs[2]), "\n" ) );
		ust::stdout_print( ust::concat( "ZVOX light sources extra mins: ", ust::to_string8(extra_mins[0]), ", ", ust::to_string8(extra_mins[1]), "\n" ) );
		ust::stdout_print( ust::concat( "ZVOX light sources extra maxs: ", ust::to_string8(extra_maxs[0]), ", ", ust::to_string8(extra_maxs[1]), "\n" ) );
	}

	return result;
}

fn LoadZpozFile( ust::filesystem_path_view file_path ) : ust::optional</ZpozData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadZpozFile( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZpozFile( ust::file_readable mut f ) : ust::optional</ZpozData/>
{
	var ZPozFileHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZPozFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ZPozFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	var u64 mut file_size(0);
	result_match( f.get_metatada() )
	{
		Ok(m) -> { file_size= m.size; },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error getting archive file size: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}

	{
		var ust::string8 mut m;
		m+= "ZPOZ header nums: ";
		m+= ust::to_string8( header.num_entities );
		m+= ", ";
		m+= ust::to_string8( header.num_structs1 );
		m+= ", ";
		m+= ust::to_string8( header.data[0] );
		m+= ", ";
		m+= ust::to_string8( header.data[1] );
		m+= ", ";
		m+= ust::to_string8( header.data[2] );
		m+= ", ";
		m+= ust::to_string8( header.data[3] );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZpozData mut result;

	result.entities.resize( size_type( header.num_entities ), ust::make_zeroed</ZpozEntity/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.entities.data() ),
				result.entities.size() * typeinfo</ZpozEntity/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.structs1.resize( size_type( header.num_structs1 ), ust::make_zeroed</ZpozStruct1/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs1.data() ),
				result.structs1.size() * typeinfo</ZpozStruct1/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	var ZPozIntermediateHeader mut intermediate_header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(intermediate_header) ),
				 typeinfo</ZPozIntermediateHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "ZPOZ intermediate header nums: ";
		m+= ust::to_string8( intermediate_header.num0 );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num_visibility_info_ints );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num2 );
		m+= "\n";
		ust::stdout_print( m );
	}

	result.clusters.resize( size_type( intermediate_header.num_clusters ), ust::make_zeroed</ZpozCluster/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.clusters.data() ),
				result.clusters.size() * typeinfo</ZpozCluster/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.clusters_visibility_data.resize( size_type( intermediate_header.num_clusters ), ust::make_zeroed</ZpozClusterVisibilityData/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.clusters_visibility_data.data() ),
				result.clusters_visibility_data.size() * typeinfo</ZpozClusterVisibilityData/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	{
		var size_type num_cluster_indices=
			size_type( intermediate_header.num_visibility_info_ints ) -
			size_type( intermediate_header.num_clusters ) * ( typeinfo</ZpozClusterVisibilityData/>.size_of / typeinfo</u32/>.size_of );

		result.cluster_indices.resize( num_cluster_indices, ust::make_zeroed</ZPozClusterIndex/>() );

		if_var( e :
			f.read_exact(
				unsafe( ust::array_view_mut</byte8/>(
					ust::ptr_cast_to_byte8( result.cluster_indices.data() ),
					result.cluster_indices.size() * typeinfo</ZPozClusterIndex/>.size_of ) ) ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	if( false )
	{
		for( auto mut field_index= 0s; field_index < 328s / 4s; ++field_index )
		{
			var i32 mut min_value= 0x7FFFFFFF, mut max_value= -0x7FFFFFFF;
			foreach( &s : result.structs1 )
			{
				ust::min_assign( min_value, s.data[field_index] );
				ust::max_assign( max_value, s.data[field_index] );
			}
			ust::stdout_print( ust::concat( "ZPOZ struct1 field ", ust::to_string8( field_index ), " min/max values are ", ust::to_string8( min_value ), " and ", ust::to_string8( max_value ), "\n" ) );
		}
	}

	if( false )
	{
		var [ i32, 4 ] mut min_offset[ 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF, 0x7FFFFFFF ];
		var [ i32, 4 ] mut max_offset= zero_init;
		var size_type mut num_non_negative_offsets= 0s;
		foreach( &s : result.clusters_visibility_data )
		{
			for( auto mut i= 0s; i < 4s; ++i )
			{
				if( s.data[i] != -1 )
				{
					ust::min_assign( min_offset[i], s.data[i] );
					ust::max_assign( max_offset[i], s.data[i] );
				}
			}
			foreach( offset : s.data )
			{
				if( offset >= 0 )
				{
					++num_non_negative_offsets;
				}
			}
		}
		for( auto mut i= 0s; i < 4s; ++i )
		{
			ust::stdout_print( ust::concat( "Min cluster visibility info offset is ", ust::to_string8( min_offset[i] ),"\n" ) );
			ust::stdout_print( ust::concat( "Max cluster visibility info offset is ", ust::to_string8( max_offset[i] ),"\n" ) );
		}
		ust::stdout_print( ust::concat( "Has ", ust::to_string8(num_non_negative_offsets), " non-negative offsets\n" ) );
	}

	if( false )
	{
		var i32 mut min_index= 0x7FFFFFFF;
		var i32 mut max_index= 0;
		foreach( &i : result.cluster_indices )
		{
			ust::min_assign( min_index, i );
			ust::max_assign( max_index, i );
		}
		ust::stdout_print( ust::concat( "Min zpoz cluster index is ", ust::to_string8( min_index ), "\n" ) );
		ust::stdout_print( ust::concat( "Max zpoz cluster index is ", ust::to_string8( max_index ), "\n" ) );
	}

	return result;
}

