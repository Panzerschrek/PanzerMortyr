			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZmapLamFile( ust::file_readable mut f ) : ust::optional</ZmapLamData/>
{
	var ZmapLamHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZPozFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "ZMAP*.LAM header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs0 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs1 );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs2 );
		m+= ", ";
		m+= ust::to_string8( header.num6 );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapLamData mut result;

	result.structs0.resize( size_type( header.num_structs0 ), ust::make_zeroed</ZmapLamStruct0/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs0.data() ),
				result.structs0.size() * typeinfo</ZmapLamStruct0/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.structs1.resize( size_type( header.num_structs1 ), ust::make_zeroed</ZmapLamStruct1/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs1.data() ),
				result.structs1.size() * typeinfo</ZmapLamStruct1/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.structs2.resize( size_type( header.num_structs2 ), ust::make_zeroed</ZmapLamStruct2/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.structs2.data() ),
				result.structs2.size() * typeinfo</ZmapLamStruct2/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	// There is some data still left - at least several kilobytes. It's at least one more block.

	if( false )
	{
		var [ i32, 2 ] mut mins[ 0x7FFFFFFF, 0x7FFFFFFF ], mut maxs[ -0x7FFFFFFF, -0x7FFFFFFF ];
		foreach( &s : result.structs0 )
		{
			ust::min_assign( mins[0], s.data[0] );
			ust::max_assign( maxs[0], s.data[0] );
			ust::min_assign( mins[1], s.data[1] );
			ust::max_assign( maxs[1], s.data[1] );
		}

		ust::stdout_print( ust::concat( "ZMAP*.LAM fields 0 are in range ", ust::to_string8(mins[0]), " to ", ust::to_string8(maxs[0]), "\n" ) );
		ust::stdout_print( ust::concat( "ZMAP*.LAM fields 1 are in range ", ust::to_string8(mins[1]), " to ", ust::to_string8(maxs[1]), "\n" ) );
	}
	if( false )
	{
		var i32 mut min_index= 0x7FFFFFFF;
		var i32 mut max_index= -0x7FFFFFFF;
		var ust::hash_set</i32/> mut unique_values;
		foreach( &s : result.structs1 )
		{
			ust::min_assign( min_index, i32(s.data[1]) );
			ust::max_assign( max_index, i32(s.data[1]) );
			unique_values.insert( i32(s.data[1]) );
		}

		ust::stdout_print( ust::concat( "ZMAP*.LAM structs1 are in range ", ust::to_string8(min_index), " to ", ust::to_string8(max_index), "\n" ) );
		ust::stdout_print( ust::concat( "ZMAP*.LAM structs1 num unique values: ", ust::to_string8(unique_values.size()), "\n" ) );
	}

	if( false )
	{
		ust::stdout_print( "Per-quad ZMAP*.LAM ranges: \n" );
		foreach( &s : result.structs0 )
		{
			ust::stdout_print( ust::concat( "( ", ust::to_string8(s.data[0] ), ", ", ust::to_string8( s.data[1] ),  " );\n" ) );
		}
		ust::stdout_print( "\n" );

		ust::stdout_print( "Per-quad ZMAP*.LAM data: \n" );
		foreach( &s : result.structs0 )
		{
			var size_type count( s.data[1] );
			var size_type offset( s.data[0] );

			var ust::string8 mut str;
			str+= "( ";
			for( auto mut i= 0s; i < count; ++i )
			{
				str+= ust::to_string8( u32( result.structs1[ offset + i ].data[1] ) );
				str+= ", ";
			}
			str+= ");\n";
			ust::stdout_print( str );

		}
		ust::stdout_print( "\n" );
	}

	if( false )
	{
		var [ i32, 16 ] mut mins= zero_init;
		var [ i32, 16 ] mut maxs= zero_init;
		for( auto mut i= 0s; i < 16s; ++i )
		{
			mins[i]= 0x7FFFFFFF;
			maxs[i]= -0x7FFFFFFF;
		}

		foreach( &s : result.structs2 )
		{
			for( auto mut i= 0s; i < 16s; ++i )
			{
				ust::min_assign( mins[i], s.data[i] );
				ust::max_assign( maxs[i], s.data[i] );
			}
		}

		for( auto mut i= 0s; i < 16s; ++i )
		{
			ust::stdout_print( ust::concat( "ZMAP*.LAM structs2 field ", ust::to_string8(i), " is in range ", ust::to_string8(mins[i]), " to ", ust::to_string8(maxs[i]), "\n" ) );
		}
	}

	return result;
}

fn LoadZmapLemFile( ust::filesystem_path_view file_path ) : ust::optional</ZmapLemData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) -> { return LoadZmapLemFile( move(f) ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZmapLemFile( ust::file_readable mut f ) : ust::optional</ZmapLemData/>
{
	var ZmapLemHeader mut header= zero_init;

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( $<(header) ),
				 typeinfo</ZPozFileHeader/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "ZMAP*.LEM header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( header.num2 );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num5 );
		m+= ", ";
		m+= ust::to_string8( header.num6 );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapLemData mut result;

	result.clusters_sky_visibility_data.resize( size_type( header.num_clusters ), ust::make_zeroed</ZmapLemClusterSkyVisibilityData/>() );

	if_var( e :
		f.read_exact(
			unsafe( ust::array_view_mut</byte8/>(
				ust::ptr_cast_to_byte8( result.clusters_sky_visibility_data.data() ),
				result.clusters_sky_visibility_data.size() * typeinfo</ZmapLemClusterSkyVisibilityData/>.size_of ) ) ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	if( false )
	{
		for( auto mut field_index= 0s; field_index < 64s; ++field_index )
		{
			var u32 mut min_value= 0u, mut max_value= 0xFFFFFFFFu;
			var ust::hash_set</u32/> mut present_values;
			foreach( &s : result.clusters_sky_visibility_data )
			{
				ust::min_assign( min_value, s.data[field_index] );
				ust::max_assign( max_value, s.data[field_index] );
				present_values.insert( s.data[field_index] );
			}
			ust::stdout_print( ust::concat( "ZMAP*.LEM cluster data field ", ust::to_string8( field_index ), " min/max values are ", ust::to_string8( min_value ), " and ", ust::to_string8( max_value ), "\n" ) );

			var ust::string8 mut s;
			s+= "Present values: ";
			foreach( v : present_values )
			{
				s+= ust::to_string8(v);
				s+= " ";
			}
			s+= "\n";
			ust::stdout_print(s);
		}
	}

	return result;
}

} // namespace PM
