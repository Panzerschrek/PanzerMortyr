fn LoadMapaWayFile( ust::file_readable mut f ) : ust::optional</MapaWayData/>
{
	var MapaWayFileHeader mut header= zero_init;

	if_var( e : f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "MAPA*.WAY header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num1 );
		m+= ", ";
		m+= ust::to_string8( header.num2 );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num5 );
		m+= ", ";
		m+= ust::to_string8( header.num6 );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var MapaWayData mut result;

	result.structs0.resize( size_type( header.num1 ), ust::make_zeroed</MapaWayStruct0/>() );

	if_var( e : f.read_exact( result.structs0.range().to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	if( false )
	{
		for( auto mut i= 0s; i < 16s; ++i )
		{
			var i32 mut min= 0x7FFFFFFF, mut max= -0x7FFFFFFF;
			foreach( &s : result.structs0 )
			{
				ust::min_assign( min, s.data[i] );
				ust::max_assign( max, s.data[i] );
			}
			ust::stdout_print( ust::concat( "MAPA.WAY structs0 field ", ust::to_string8(i), " is in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
		}
	}

	if( false )
	{
		foreach( &s0 : result.structs0 )
		{
			var size_type num_elements( s0.data[0] );

			ust::stdout_print( ust::concat( "MAPA.WAY struct0 num elements is ", ust::to_string8( num_elements ), "\n" ) );

			{
				var i32 mut min= 0x7FFFFFFF, mut max= -0x7FFFFFFF;
				for( auto mut y= 0s; y < num_elements; ++y )
				{
					for( auto mut x= y + 1s; x < num_elements; ++x )
					{
						var i32 x( s0.matrix[y][x] );
						ust::min_assign( min, x );
						ust::max_assign( max, x );
					}
				}
				ust::stdout_print( ust::concat( "MAPA.WAY matrix upper values are in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
			}
			{
				var i32 mut min= 0x7FFFFFFF, mut max= -0x7FFFFFFF;
				for( auto mut y= 0s; y < num_elements; ++y )
				{
					for( auto mut x= 0s; x < y; ++x )
					{
						var i32 x( s0.matrix[y][x] );
						ust::min_assign( min, x );
						ust::max_assign( max, x );
					}
				}
				ust::stdout_print( ust::concat( "MAPA.WAY matrix lower values are in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
			}
		}
	}

	return result;
}

} // namespace PM
