fn LoadZpozFile( ust::file_readable mut f ) : ust::optional</ZpozData/>
{
	var ZPozFileHeader mut header= zero_init;

	if_var( e : f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	if( header.signature != ZPozFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::null_optional;
	}

	var u64 mut file_size(0);
	result_match( f.get_metatada() )
	{
		Ok(m) -> { file_size= m.size; },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error getting archive file size: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}

	{
		var ust::string8 mut m;
		m+= "ZPOZ header nums: ";
		m+= ust::to_string8( header.num_entities );
		m+= ", ";
		m+= ust::to_string8( header.num_structs1 );
		m+= ", ";
		m+= ust::to_string8( header.data[0] );
		m+= ", ";
		m+= ust::to_string8( header.data[1] );
		m+= ", ";
		m+= ust::to_string8( header.data[2] );
		m+= ", ";
		m+= ust::to_string8( header.data[3] );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZpozData mut result;

	result.entities.resize( size_type( header.num_entities ), ust::make_zeroed</ZpozEntity/>() );

	if_var( e : f.read_exact( result.entities.range().to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.structs1.resize( size_type( header.num_structs1 ), ust::make_zeroed</ZpozStruct1/>() );

	if_var( e : f.read_exact( result.structs1.range().to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	var ZPozIntermediateHeader mut intermediate_header= zero_init;

	if_var( e : f.read_exact( ust::single_element_array_view( intermediate_header ).to_byte8_range()  ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
		return ust::null_optional;
	}

	{
		var ust::string8 mut m;
		m+= "ZPOZ intermediate header nums: ";
		m+= ust::to_string8( intermediate_header.num0 );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num_visibility_info_ints );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num2 );
		m+= "\n";
		ust::stdout_print( m );
	}

	result.clusters.resize( size_type( intermediate_header.num_clusters ), ust::make_zeroed</ZpozCluster/>() );

	if_var( e : f.read_exact( result.clusters.range().to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	result.clusters_visibility_data.resize( size_type( intermediate_header.num_clusters ), ust::make_zeroed</ZpozClusterVisibilityData/>() );

	if_var( e : f.read_exact( result.clusters_visibility_data.range().to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
		return ust::null_optional;
	}

	{
		var size_type num_cluster_indices=
			size_type( intermediate_header.num_visibility_info_ints ) -
			size_type( intermediate_header.num_clusters ) * ( typeinfo</ZpozClusterVisibilityData/>.size_of / typeinfo</u32/>.size_of );

		result.cluster_indices.resize( num_cluster_indices, ust::make_zeroed</ZPozClusterIndex/>() );

		if_var( e : f.read_exact( result.cluster_indices.range().to_byte8_range() ).as_error_ref() )
		{
			ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string( e ), "!\n" ) );
			return ust::null_optional;
		}
	}

	return result;
}

