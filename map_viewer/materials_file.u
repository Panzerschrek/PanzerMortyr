import "/enum_string_conversions.u"
import "/file_helpers.u"
import "/path_utils.u"
import "/stdout.u"
import "materials_file.uh"

fn LoadMaterialsFile( ust::filesystem_path_view maps_directory ) : ust::optional</MaterialsDescription/>
{
	var ust::filesystem_path file_path= ust::path::join( maps_directory, "TXTAB.STD" );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			ust::stdout_print( contents );
			return MaterialsDescription{};
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}
