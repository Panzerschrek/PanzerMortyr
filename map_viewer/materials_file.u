import "/enum_string_conversions.u"
import "/file_helpers.u"
import "/path_utils.u"
import "/stdout.u"
import "materials_file.uh"

fn LoadMaterialsFile( ust::filesystem_path_view maps_directory ) : ust::optional</MaterialsDescription/>
{
	var ust::filesystem_path file_path= ust::path::join( maps_directory, "TXTAB.STD" );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseMaterialsFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseMaterialsFile( ust::string_view8 file_contents ) : MaterialsDescription
{
	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		ust::stdout_print( ust::concat( "LINE: \"\"\"", line, "\"\"\"\nWORDS: " ) );
		foreach( word : ust::wrap_raw_iterator( WordsIterator( line ) ) )
		{
			ust::stdout_print( ust::concat( "\"", word, "\" " ) );
		}
		ust::stdout_print( "\n" );
	}

	return MaterialsDescription{};
}

class LinesRawIterator
{
public:
	fn constructor( ust::string_view8 s ) @( ust::reference_notation::pollution::param0_param_1_inner_reference )
		( s_= s )
	{}

	fn next( mut this ) : ust::optional</ust::string_view8/> @( ust::reference_notation::return_inner_references::param0_inner_reference0 )
	{
		loop
		{
			if( s_.empty() )
			{
				return ust::null_optional;
			}

			var size_type mut end= 0s;
			var size_type mut string_end= 0s;
			while( end < s_.size() )
			{
				if( s_.subrange_start(end).starts_with( "\r\n" ) )
				{
					string_end= end;
					end= string_end + 2s;
					break;
				}
				else if( s_.subrange_start(end).starts_with( "\n" ) )
				{
					string_end= end;
					end= string_end + 1s;
					break;
				}
				++end;
			}

			auto res= s_.subrange_end( string_end );

			for( auto mut i= 0s; i < end; ++i )
			{
				s_.drop_front();
			}
			if( !s_.empty() )
			{
				s_.drop_front();
			}

			if( !res.empty() )
			{
				return res;
			}
		}
	}

private:
	ust::string_view8 s_;
}

class WordsIterator
{
public:
	fn constructor( ust::string_view8 s ) @( ust::reference_notation::pollution::param0_param_1_inner_reference )
		( s_= s )
	{}

	fn next( mut this ) : ust::optional</ust::string_view8/> @( ust::reference_notation::return_inner_references::param0_inner_reference0 )
	{
		loop
		{
			if( s_.empty() )
			{
				return ust::null_optional;
			}

			var size_type mut end= 0s;
			while( end < s_.size() && !( s_[end] == ' ' || s_[end] == '\t' ) )
			{
				++end;
			}

			auto res= s_.subrange_end( end );

			for( auto mut i= 0s; i < end; ++i )
			{
				s_.drop_front();
			}
			if( !s_.empty() )
			{
				s_.drop_front();
			}

			if( !res.empty() )
			{
				return res;
			}
		}
	}

private:
	ust::string_view8 s_;
}
