import "string_iterators.uh"

namespace PM
{

fn LinesRawIterator::constructor( ust::string_view8 s ) @( ust::reference_notation::pollution::param0_param_1_inner_reference )
	( s_= s )
{}

fn LinesRawIterator::next( mut this ) : ust::optional</ust::string_view8/> @( ust::reference_notation::return_inner_references::param0_inner_reference0 )
{
	loop
	{
		if( s_.empty() )
		{
			return ust::null_optional;
		}

		var size_type mut end= 0s;
		var size_type mut string_end= 0s;
		while( end < s_.size() )
		{
			if( s_.subrange_start(end).starts_with( "\r\n" ) )
			{
				string_end= end;
				end= string_end + 2s;
				break;
			}
			else if( s_.subrange_start(end).starts_with( "\n" ) )
			{
				string_end= end;
				end= string_end + 1s;
				break;
			}
			++end;
		}

		auto res= s_.subrange_end( string_end );

		for( auto mut i= 0s; i < end; ++i )
		{
			s_.drop_front();
		}
		if( !s_.empty() )
		{
			s_.drop_front();
		}

		if( !res.empty() )
		{
			return res;
		}
	}
}

fn WordsIterator::constructor( ust::string_view8 s ) @( ust::reference_notation::pollution::param0_param_1_inner_reference )
	( s_= s )
{}

fn WordsIterator::next( mut this ) : ust::optional</ust::string_view8/> @( ust::reference_notation::return_inner_references::param0_inner_reference0 )
	{
		loop
		{
			if( s_.empty() )
			{
				return ust::null_optional;
			}

			var size_type mut end= 0s;
			while( end < s_.size() && !( s_[end] == ' ' || s_[end] == '\t' ) )
			{
				++end;
			}

			auto res= s_.subrange_end( end );

			for( auto mut i= 0s; i < end; ++i )
			{
				s_.drop_front();
			}
			if( !s_.empty() )
			{
				s_.drop_front();
			}

			if( !res.empty() )
			{
				return res;
			}
		}
	}

} // namespace PM
