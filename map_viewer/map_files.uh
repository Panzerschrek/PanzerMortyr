struct ZMapFileHeader ordered
{
	auto c_expected_signature= "MAPA";

	[ char8, 4 ] signature;
	u32 num_quads;
	u32 presumable_some_other_num;

	[ u32, 4 ] data;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZMapFileHeader/>.size_of == 32s );

struct MapQuad ordered
{
	// Value divided by 4 represent actual texture in the block, two minor bits represent a subquad from a 2x2 grid.
	u16 texture_id;

	// Relative positions of vertices (relative to the center).
	[ [ i16, 3 ], 4 ] vertices;

	// Value in range 0 to 1024 representing normal azimuth (mapped to range from 0 to 2 PI ).
	u16 normal_azimuth;

	// Texture coordinates offset (in pixels) for vertex #0.
	[ i8, 2 ] tc_offset;

	// Value in range 0 to 255 mapped to angles 0 to 2 PI.
	u8 texture_roll;

	[ u8, 1 ] data0;

	// Value in range 768 to 1024 mapped to angles -PI/2 to 0 for faces facing down.
	// Value in range 0 to 256 mapped to angles 0 to PI/2 for faces facing up.
	u16 normal_elevation;

	// Global coordinates of the quad center.
	[ i16, 3 ] center;

	[ u16, 4  ] data1; // The last word is presumably window/breakable flag.
}

static_assert( typeinfo</MapQuad/>.size_of == 48s );

struct ZPosFileHeader ordered
{
	auto c_expected_signature= "POZC";

	[ char8, 4 ] signature;
	u32 num_structs0;
	u32 num_structs1;

	[ u32, 4 ] data;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZPosFileHeader/>.size_of == 32s );

// Presumably an entity struct.
struct ZposStruct0 ordered
{
	u16 kind; // Presumably entity kind. Maybe only lower 8 bits are used.
	[ i16, 3 ] position;
	[ i16, 28 ] data;
}

static_assert( typeinfo</ZposStruct0/>.size_of == 64s );

struct ZposStruct1 ordered
{
	[ i16, 328 / 2 ] data;
}

static_assert( typeinfo</ZposStruct1/>.size_of == 328s );

struct ZPosIntermediateHeader ordered
{
	u32 num0;
	u32 num1;
	u32 num_structs2;
	u32 num2;
}

static_assert( typeinfo</ZPosIntermediateHeader/>.size_of == 16s );

// Presumably a light source.
struct ZposStruct2 ordered
{
	[ i32, 3 ] position;
	i32 radius;
	[ u32, 1 ] data0;
	u32 power; // Not sure, but it's likely a light power value.
	[ u32, 2 ] data1;
}

static_assert( typeinfo</ZposStruct2/>.size_of == 32s );

struct ZPosStruct2ExtraData ordered
{
	[ i32, 4 ] data;
}

static_assert( typeinfo</ZPosStruct2ExtraData/>.size_of == 16s );

// The rest of a ZPOZ file contains not so large 32-bit numbers.
// Presumably it's light source indices.
struct ZPosStruct3
{
	[ i32, 1 ] data;
}
