namespace PM
{

struct ZMapFileHeader ordered
{
	auto c_expected_signature= "MAPA";

	[ char8, 4 ] signature;
	u32 num_quads;
	u32 presumable_some_other_num;

	[ u32, 4 ] data;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZMapFileHeader/>.size_of == 32s );

struct ZmapQuad ordered
{
	// Value divided by 4 represent actual texture in the block, two minor bits represent a subquad from a 2x2 grid.
	u16 texture_id;

	// Relative positions of vertices (relative to the center).
	[ [ i16, 3 ], 4 ] vertices;

	// Value in range 0 to 1024 representing normal azimuth (mapped to range from 0 to 2 PI ).
	u16 normal_azimuth;

	// Texture coordinates offset (in pixels) for vertex #0.
	[ i8, 2 ] tc_offset;

	// Value in range 0 to 255 mapped to angles 0 to 2 PI.
	u8 texture_roll;

	[ u8, 1 ] data0;

	// Value in range 768 to 1024 mapped to angles -PI/2 to 0 for faces facing down.
	// Value in range 0 to 256 mapped to angles 0 to PI/2 for faces facing up.
	u16 normal_elevation;

	// Global coordinates of the quad center.
	[ i16, 3 ] center;

	// data1[0], data1[1], data1[2] - small positive integers, usually the same for polygons using the same texture.
	// data[3] is presumably window/breakable flag.
	[ i16, 4  ] data1;
}

static_assert( typeinfo</ZmapQuad/>.size_of == 48s );

struct ZVoxFileHeader ordered
{
	auto c_expected_signature= "VOXA";

	[ char8, 4 ] signature;
	u32 num_structs1;
	u32 num_structs0;
	u32 num2;
	u32 num3;
	u32 num4;
	u32 num5;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZVoxFileHeader/>.size_of == 32s );

struct ZvoxStruct0 ordered
{
	[ i32, 8 ] data;
}

static_assert( typeinfo</ZvoxStruct0/>.size_of == 32s );

// It looks like it's a light source (positions are identical to positions in ZPOZ file).
struct ZvoxLightSource ordered
{
	// All fields below has identical values to fileds of ZpozLightSource struct.
	[ i32, 3 ] position;
	i32 radius; // identical to radius in ZpozLightSource struct.
	[ i32, 4 ] data1;
	// data[0] - small positive values (non-unuque).
	[ i32, 8 ] data0;
}

static_assert( typeinfo</ZvoxLightSource/>.size_of == 64s );

struct ZPozFileHeader ordered
{
	auto c_expected_signature= "POZC";

	[ char8, 4 ] signature;
	u32 num_entities;
	u32 num_structs1;

	[ u32, 4 ] data;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZPozFileHeader/>.size_of == 32s );

// Presumably an entity struct.
struct ZpozEntity ordered
{
	// Identical to the "aktor" field in a "ZINF.STD" file.
	// Maybe only lower 8 bits are used.
	u16 kind;

	[ i16, 3 ] position;

	// data[0] - always (or almost always) 0.
	// data[1] -always (or almost always) -1.
	// data[4] - some sort of flags or maybe angle.
	// data[16] - sequential numbers for enemies, -1 for other entities.
	// data[19] - 0 for enemies, 5 for pick-ups, 10 for some entities in an isolated box (skyroom?), 20 for grids.
	// data[23] - sequential numbers for all entities.
	[ i16, 27 ] data;
	// It seems to be 0 for out-of-the-bounds entities.
	u16 alive_flag;
}

static_assert( typeinfo</ZpozEntity/>.size_of == 64s );

// For now an unknown struct.
// It seems to contain no positions.
struct ZpozStruct1 ordered
{
	// data[0] is small positive integer (like 2).
	// data[2] and data[3] are positive integers, not huge, but not small. They are usually equal to each otger.
	// data[18] and data[19] are usually negative integers, usually equal to each other.
	// data[34] and data[35] are usually negative integers, equal to each other or at least near to each other.
	[ i32, 328 / 4 ] data;
}

static_assert( typeinfo</ZpozStruct1/>.size_of == 328s );

// There is an intermediate header after first two data blocks.
struct ZPozIntermediateHeader ordered
{
	u32 num0;
	u32 num1;
	u32 num_light_sources;
	u32 num2;
}

static_assert( typeinfo</ZPozIntermediateHeader/>.size_of == 16s );

// Presumably a light source.
struct ZpozLightSource ordered
{
	[ i32, 3 ] position;
	i32 radius;
	// Contains integer numbers up to 320 with small number of bits set. Maybe it's some sort of flags?
	[ u32, 1 ] data0;
	u32 power; // Not sure, but it's likely a light power value.
	// data1[0] - mostly -1, sometimes 0 or a small positive value.
	// data1[1] - large positive values, possibly unique. Maybe it's an offset to some array (extra light data?).
	[ u32, 2 ] data1;
}

static_assert( typeinfo</ZpozLightSource/>.size_of == 32s );

struct ZpozLightSourceExtraData ordered
{
	// Usually it's all minus ones.
	// But sometimes there are not so large (16-bit) positive values, which generally increase (but not always).
	// Maximum value is slightly less than ZPosIntermediateHeader.num1.
	[ i32, 4 ] data;
}

static_assert( typeinfo</ZpozLightSourceExtraData/>.size_of == 16s );

// The rest of a ZPOZ file contains not so large 32-bit numbers.
// Presumably it's light source indices.
struct ZPozStruct3
{
	[ i32, 1 ] data;
}

} // namespace PM
