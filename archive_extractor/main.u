import "/enum_string_conversions.u"
import "/file.u"
import "/filesystem.u"
import "/main_wrapper.u"
import "/path_utils.u"
import "/scoped_array.u"
import "/stdout.u"
import "/string_conversions.u"
import "/common_lib/archive_file.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	if( args.size() <= 2s )
	{
		ust::stderr_print( "Not enough arguments!\n" );
		return -1;
	}
	var ust::string_view8 archive_file_path= args[1s];
	var ust::string_view8 out_directory= args[2s];

	ust::stdout_print( ust::concat( "Reading archive file \"", archive_file_path, "\"\n" ) );
	ust::stdout_print( ust::concat( "Extracting files into directory \"", out_directory, "\"\n" ) );

	result_match( ust::get_metadata_for_path( out_directory ) )
	{
		Ok(m) ->
		{
			if( m.kind != ust::file_kind::directory )
			{
				ust::stderr_print( ust::concat( "Path \"", out_directory, "\" is not a directory!\n" ) );
				return -1;
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Can't get metadata for directory \"", out_directory, "\"! Error: ", ust::enum_to_string(e), ", \n" ) );
			return -1;
		}
	}

	result_match( ust::file_readable::open( archive_file_path ) )
	{
		Ok( mut f ) -> { return ( ProcessArchiveFile( move(f), out_directory ) ? 0 : -1 ); },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening archive file: ", ust::enum_to_string( e ), "\n" ) );
			return -1;
		}
	}
}

fn nodiscard ProcessArchiveFile( ust::file_readable mut f, ust::filesystem_path_view out_directory ) : bool
{
	var u64 mut file_size(0);
	result_match( f.get_metatada() )
	{
		Ok(m) -> { file_size= m.size; },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error getting archive file size: ", ust::enum_to_string( e ), "\n" ) );
			return false;
		}
	}

	ust::stdout_print( ust::concat( "Has size ", ust::to_string8(file_size), " bytes\n" ) );

	var ArchiveHeader mut archive_header= zero_init;

	result_match( f.read_exact( ust::single_element_array_view( archive_header ).to_byte8_range() ) )
	{
		Ok(v) ->
		{
			ust::ignore_unused(v);
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error reading archive header: ", ust::enum_to_string( e ), "\n" ) );
			return false;
		}
	}

	if( archive_header.id != ArchiveHeader::c_expected_id )
	{
		ust::stderr_print( ust::concat( "Unexpected file ID, expected ", ust::to_string8(ArchiveHeader::c_expected_id), ",got ", ust::to_string8(archive_header.id), "!\n" ) );
		return false;
	}

	ust::ignore_unused( archive_header.some );

	ust::stdout_print( ust::concat( "Has archive with ", ust::to_string8( archive_header.num_files ), " files\n" ) );

	if( u64( typeinfo</ArchiveHeader/>.size_of ) + u64(archive_header.num_files) * u64( typeinfo</ArchiveFileHeader/>.size_of ) > file_size )
	{
		ust::stderr_print( "Entry table size is bigger than file size!\n" );
		return false;
	}

	scoped_array ArchiveFileHeader mut archive_headers[ size_type(archive_header.num_files) ]( ust::make_zeroed</ArchiveFileHeader/>() );

	result_match( f.read_exact( archive_headers.to_byte8_range() ) )
	{
		Ok(v) ->
		{
			ust::ignore_unused(v);
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error reading archive file headers: ", ust::enum_to_string( e ), "\n" ) );
			return false;
		}
	}

	var size_type buff_size= 65536s;
	var [ byte8, buff_size ] mut buff= zero_init;

	foreach( &header : archive_headers ) label files_extracting
	{
		var ust::string_view8 mut name= header.name;
		while( !name.empty() && name.back() == '\0' )
		{
			name.drop_back();
		}

		// Convert file name to uppercase, since files in the archive have sometimes mixed cases and working with mixed case is painful on case-sensetive filesystems.
		var ust::string8 name_uppercase= ConvertToUppercase( name );

		if( u64( header.offset ) + u64( header.size ) > file_size )
		{
			ust::stderr_print( ust::concat( "File \"", name_uppercase, "\" is out of bounds!\n" ) );
			continue;
		}

		ust::stdout_print( ust::concat( "Extracting file \"", name_uppercase, "\" with size ", ust::to_string8(header.size), " at offset ", ust::to_string8(header.offset), "\n" ) );

		var ust::filesystem_path out_file_path= ust::path::join( out_directory, name_uppercase );

		result_match( ust::file_writeable::create( out_file_path ) )
		{
			Ok( mut out_file ) ->
			{
				result_match( f.seek( u64( header.offset ) ) )
				{
					Ok(v) -> { ust::ignore_unused(v); },
					Err(e) ->
					{
						ust::stderr_print( ust::concat( "Failed to seek! Error: ", ust::enum_to_string(e), ", \n" ) );
						continue;
					},
				}

				for( auto mut offset= 0u32; offset < header.size; )
				{
					var size_type num_bytes_to_read= ust::min( buff_size, size_type( header.size - offset ) );

					result_match( f.read( ust::array_view_mut</byte8/>( buff ).subrange_end( num_bytes_to_read ) ) )
					{
						Ok( bytes_read ) ->
						{
							if( bytes_read == 0s )
							{
								ust::stderr_print( "Read size is zero!\n" );
								continue label files_extracting;
							}

							result_match( out_file.write_all( ust::array_view_imut</byte8/>( buff ).subrange_end( bytes_read ) ) )
							{
								Ok(v) -> { ust::ignore_unused(v); },
								Err(e) ->
								{
									ust::stderr_print( ust::concat( "Failed to write! Error: ", ust::enum_to_string(e), ", \n" ) );
									continue label files_extracting;
								},
							}

							offset+= u32(bytes_read);
						},
						Err(e) ->
						{
							ust::stderr_print( ust::concat( "Failed to read! Error: ", ust::enum_to_string(e), ", \n" ) );
							continue label files_extracting;
						}
					}
				}
			},
			Err(e) ->
			{
				ust::stderr_print( ust::concat( "Failed to create file \"", out_file_path, "\"! Error: ", ust::enum_to_string(e), ", \n" ) );
				continue;
			}
		}
	}

	ust::ignore_unused(archive_headers.front().some);

	return true;
}

fn ConvertToUppercase( ust::string_view8 s ) : ust::string8
{
	return ust::string8::from_mapped_range(
		s,
		lambda( char8 c ) : char8
		{
			if( c >= 'a' && c <= 'z' )
			{
				return char8( u32(c) - u32('a') + u32('A') );
			}
			return c;
		} );
}


} // namespace PM
