import "/hash_map.u"
import "/path.u"
import "/string.u"
import "/vector.u"

namespace PM
{

struct MaterialsDescription
{
	Blocks blocks;

	type Blocks= ust::hash_map</u32, Block/>;

	struct Block
	{
		PaletteDescription palette0;
		PaletteDescription palette1;
		ust::vector</Texture/> textures;

		[ u32, typeinfo</SpecialMaterial/>.element_count ] special_material_indices= zero_init;
	}

	struct PaletteDescription
	{
		ust::string8 file_name;
		ust::string8 extra_file_name; // It seems to be some sort of blending table.
		u32 some_number= 0u;
	}

	struct Texture
	{
		[ ust::string8, 4 ] mips;
		[ ust::string8, 4 ] materials;
	}

	enum SpecialMaterial
	{
		Sky,
		Water,
		Glass,
		Lava,
		Mirror,
	}

	// Experimental data.
	var [ u32, typeinfo</SpecialMaterial/>.element_count ] c_special_material_texture_indices
	[
		1012u,
		1011u,
		1002u,
		1031u,
		1036u,
	];

	// All (or at least all map) textures are squares with identical size.
	var u32 c_texture_size= 128u;

	// All texture files contain 2x2 tiles for actual textures.
	var u32 c_texture_file_num_tiles_x= 2u;
	var u32 c_texture_file_num_tiles_y= 2u;
}

auto& c_materials_file_name= "TXTAB.STD";

fn LoadMaterialsFile( ust::filesystem_path_view maps_directory ) : ust::optional</MaterialsDescription/>;
fn ParseMaterialsFile( ust::string_view8 file_contents ) : MaterialsDescription;

} // namespace PM
