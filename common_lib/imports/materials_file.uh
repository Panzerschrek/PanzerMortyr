import "/hash_map.u"
import "/path.u"
import "/string.u"
import "/vector.u"
import "resource_string.uh"

namespace PM
{

struct MaterialsDescription
{
	Blocks blocks;

	type Blocks= ust::hash_map</u32, Block/>;

	struct Block
	{
		PaletteDescription palette0;
		PaletteDescription palette1;

		// Actually all blocks have the same number of textures which is 35.
		ust::vector</Texture/> textures;

		[ u32, typeinfo</SpecialMaterial/>.element_count ] special_material_indices[ ~0u ... ];
	}

	struct PaletteDescription
	{
		ResourceString file_name= zero_init;
		ResourceString extra_file_name= zero_init; // It seems to be some sort of blending table.
		u32 some_number= 0u;
	}

	struct Texture
	{
		[ ResourceString, 4 ] mips;
		[ ust::string8, 4 ] materials;
	}

	enum SpecialMaterial
	{
		Glass,
		// Some sort of animated texture with 8 frames of size 128x64.
		Film,
		Water,
		Sky,
		// Some sort of animated texture with 4 frames of size 64x64.
		Valve,
		// Is present on maps 4 and 19. It seems to be also valve. Maybe it's a different phase?
		Unknown1014,
		// Is present on some quads on map 29 - slightly lower than sky quads.
		Unknown1019,
		// Is present only on map 18. It seems like some sort of acid or water material.
		AcidAlternative,
		Window,
		Acid,
		Lava,
		Mirror,
		// Seems to be non-breakable glass with face culling enabled.
		ArmoredGlass,
	}

	// Experimental data.
	var [ u32, typeinfo</SpecialMaterial/>.element_count ] c_special_material_texture_indices
	[
		1002u,
		1003u,
		1011u,
		1012u,
		1013u,
		1014u,
		1019u,
		1021u,
		1025u,
		1026u,
		1031u,
		1036u,
		1038u,
	];

	// All (or at least all map) textures are squares with identical size.
	var u32 c_texture_size= 128u;

	// All texture files contain 2x2 tiles for actual textures.
	var u32 c_texture_file_num_tiles_x= 2u;
	var u32 c_texture_file_num_tiles_y= 2u;
}

var ResourceString& c_materials_file_name= "TXTAB.STD\0\0\0\0\0\0\0";

fn LoadMaterialsFile( ust::filesystem_path_view maps_directory ) : ust::optional</MaterialsDescription/>;
fn ParseMaterialsFile( ust::string_view8 file_contents ) : MaterialsDescription;

} // namespace PM
