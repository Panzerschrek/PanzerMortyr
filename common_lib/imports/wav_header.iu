namespace PM
{

// See https://en.wikipedia.org/wiki/WAV#WAV_file_header.

struct WavHeader ordered
{
	var [ char8, 4 ] c_expected_file_type_block_id= "RIFF";
	var [ char8, 4 ] c_expected_file_format_id= "WAVE";
	var [ char8, 4 ] c_expected_format_block_id= "fmt ";
	var [ char8, 4 ] c_expected_data_block_id= "data";

	[ char8, 4 ] file_type_block_id;
	u32 file_size;
	[ char8, 4 ] file_format_id;

	[ char8, 4 ] format_block_id;
	u32 block_size;
	u16 audio_format;
	u16 num_channels;
	u32 frequency;
	u32 bytes_per_sec;
	u16 bytes_per_block;
	u16 bits_per_sample;

	[ char8, 4 ] data_block_id;
	u32 data_size;
}

static_assert( typeinfo</WavHeader/>.size_of == 44s, "Invalid size!" );

} // namespace PM
