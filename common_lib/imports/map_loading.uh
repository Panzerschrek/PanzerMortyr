import "/file.u"
import "/vector.u"
import "map_files.uh"

namespace PM
{

struct MapData
{
	ZmapData zmap;
	ZvoxData zvox;
	ZpozData zpoz;
	ZmapLamData zmap_lam;
	ZmapLemData zmap_lem;
	MapaWayData mapa_way;
}

struct ZmapData
{
	ust::vector</ZmapQuad/> quads;
}

struct ZvoxData
{
	ust::vector</ZvoxStruct0/> structs0;
	ust::vector</ZvoxStruct1/> structs1;
	ust::vector</ZvoxCluster/> clusters;
	ust::vector</ZvoxLightSource/> light_sources;
}

struct ZpozData
{
	ust::vector</ZpozEntity/> entities;
	ust::vector</ZpozStruct1/> structs1;
	ust::vector</ZpozCluster/> clusters;
	ust::vector</ZpozClusterVisibilityData/> clusters_visibility_data;
	ust::vector</ZPozClusterIndex/> cluster_indices;
}

struct ZmapLamData
{
	ust::vector</ZmapLamStruct0/> structs0;
	ust::vector</ZmapLamStruct1/> structs1;
	ust::vector</ZmapLamStruct2/> structs2;
}

struct ZmapLemData
{
	ust::vector</ZmapLemClusterSkyVisibilityData/> clusters_sky_visibility_data;
}

struct MapaWayData
{
	ust::vector</MapaWayNavigationGraph/> navigation_graphs;
}

fn LoadMap(
	ust::filesystem_path_view zmap_file_path,
	ust::filesystem_path_view zvox_file_path,
	ust::filesystem_path_view zpoz_file_path,
	ust::filesystem_path_view zmap_lam_file_path,
	ust::filesystem_path_view zmap_lem_file_path,
	ust::filesystem_path_view mapa_way_file_path ) : ust::optional</MapData/>;

fn LoadZmapLemFile( ust::file_readable &mut f ) : ust::io_result</ZmapLemData/>;
fn LoadMapaWayFile( ust::file_readable &mut f ) : ust::io_result</MapaWayData/>;

} // namespace PM
