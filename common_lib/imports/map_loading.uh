import "/file.u"
import "/vector.u"
import "map_files.uh"

namespace PM
{

struct MapData
{
	ZmapData zmap;
	ZvoxData zvox;
	ZpozData zpoz;
	ZmapLamData zmap_lam;
	ZmapLemData zmap_lem;
	MapaWayData mapa_way;
}

struct ZmapData
{
	ust::vector</ZmapQuad/> quads;
}

struct ZvoxData
{
	ust::vector</ZvoxTriggerVolume/> trigger_volumes;
	ust::vector</ZvoxStruct1/> structs1;
	ust::vector</ZvoxFogVolume/> fog_volumes;
	ust::vector</ZvoxCluster/> clusters;
	ust::vector</ZvoxLightSource/> light_sources;
}

struct ZpozData
{
	ust::vector</ZpozEntity/> entities;
	ust::vector</ZpozStruct1/> structs1;
	ust::vector</ZpozMultiplayerSpawnPoint/> multiplayer_spawn_points;
	ust::vector</ZpozCluster/> clusters;
	ust::vector</ZpozClusterVisibilityData/> clusters_visibility_data;
	ust::vector</ZPozClusterIndex/> cluster_indices;
}

struct ZmapLamData
{
	ust::vector</ZmapLamTesselaltedQuad/> tessellated_quads;
	ust::vector</ZmapLamTessellatedQuadsData/> tessellated_quads_data;
	ust::vector</ZmapLamRainDroplet/> rain_droplets;
	ust::vector</ZmapLamClusterRainInfo/> clusters_rain_info;

	// First is stores pairs of ints for clusters - start/end offsets.
	// Then numbers for these offsets are stored.
	// It looks like some sort of visibility information, but only for clusters with at least partial sky/rain/snow visibility.
	ust::vector</u32/> clusters_rain_visibility_data;
}

struct ZmapLemData
{
	ust::vector</ZmapLemClusterSkyVisibilityData/> clusters_sky_visibility_data;
}

struct MapaWayData
{
	ust::vector</MapaWayNavigationGraph/> navigation_graphs;
}

fn GetZmapLamFileName( u32 map_index ) : ust::filesystem_path;
fn GetZmapLemFileName( u32 map_index ) : ust::filesystem_path;
fn GetMapaWayFileName( u32 map_index ) : ust::filesystem_path;

fn LoadMap(
	ust::filesystem_path_view zmap_file_path,
	ust::filesystem_path_view zvox_file_path,
	ust::filesystem_path_view zpoz_file_path,
	ust::filesystem_path_view zmap_lam_file_path,
	ust::filesystem_path_view zmap_lem_file_path,
	ust::filesystem_path_view mapa_way_file_path ) : ust::optional</MapData/>;

fn LoadZmapFile( ust::file_readable &mut f ) : ust::io_result</ZmapData/>;
fn LoadZvoxFile( ust::file_readable &mut f ) : ust::io_result</ZvoxData/>;
fn LoadZpozFile( ust::file_readable &mut f ) : ust::io_result</ZpozData/>;
fn LoadZmapLamFile( ust::file_readable &mut f, size_type num_clusters ) : ust::io_result</ZmapLamData/>;
fn LoadZmapLemFile( ust::file_readable &mut f ) : ust::io_result</ZmapLemData/>;
fn LoadMapaWayFile( ust::file_readable &mut f ) : ust::io_result</MapaWayData/>;

} // namespace PM
