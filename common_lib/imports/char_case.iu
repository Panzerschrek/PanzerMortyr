import "/string.iu"

namespace PM
{

fn ToUpper( char8 c ) : char8
{
	if( ( c >= 'a' ) & ( c <= 'z' ) )
	{
		return char8( u32(c) - u32('a') + u32('A') );
	}

	return c;
}

fn ToLower( char8 c ) : char8
{
	if( ( c >= 'A' ) & ( c <= 'Z' ) )
	{
		return char8( u32(c) - u32('A') + u32('a') );
	}

	return c;
}

fn CharsAreCaseInsensetiveEqual( char8 l, char8 r ) : bool
{
	return ToLower( l ) == ToLower( r );
}

fn StringsAreCaseInsensetiveEqual( ust::string_view8 l, ust::string_view8 r ) : bool
{
	if( l.size() != r.size() )
	{
		return false;
	}

	foreach( pair : l.iter().zip( r.iter() ) )
	{
		if( !CharsAreCaseInsensetiveEqual( pair.first, pair.second ) )
		{
			return false;
		}
	}

	return true;
}

} // namespace PM
