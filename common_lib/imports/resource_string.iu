import "char_case.iu"

namespace PM
{

// String representing a game resource file - within a game archive or a directory.
// Its size is maximum 12 characters, unused places are filled with zeros.
// It's ASCII only, it should be (generally) upper-case.
type ResourceString= [ char8, 12 ];

fn ConvertToUppercase( ResourceString& s ) : ResourceString
{
	var ResourceString mut res= s;
	foreach( &mut c : res )
	{
		c= ToUpper(c);
	}

	return res;
}

// Convets to upper case and if doesn't fit - truncates.
fn ConvertStringToResourceString( ust::string_view8 s ) : ResourceString
{
	var ResourceString mut res= zero_init;

	foreach( pair : s.iter().zip( ust::array_view_mut</char8/>( res ).iter() ) )
	{
		pair.second= ToUpper( pair.first );
	}

	return res;
}

fn ConvertResourceStringToStringView( ResourceString& s ) : ust::string_view8 @( ust::reference_notation::return_inner_references::param0 )
{
	var ust::string_view8 mut res= s;
	while( !res.empty() && res.back() == '\0' )
	{
		res.drop_back();
	}

	return res;
}

struct ResourceStringCompare
{
	op()( this, ResourceString& l, ResourceString& r ) : bool
	{
		// TODO - avoid comparing strings character by character.
		for( auto mut i= 0s; i < typeinfo</ResourceString/>.element_count; ++i )
		{
			var char8 c_l= l[i];
			var char8 c_r= r[i];
			if( c_l != c_r )
			{
				return c_l < c_r;
			}
		}
		return false;
	}
}

} // namespace PM
