namespace PM
{

struct ZMapFileHeader ordered
{
	auto c_expected_signature= "MAPA";

	[ char8, 4 ] signature;
	u32 num_quads;
	u32 presumable_some_other_num;

	[ u32, 4 ] data;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZMapFileHeader/>.size_of == 32s );

struct ZmapQuad ordered
{
	// Value divided by 4 represent actual texture in the block, two minor bits represent a subquad from a 2x2 grid.
	// Value 1002 is lantern breakable glass.
	// Value 1011 is water.
	// Value 1012 is sky.
	// Value 1031 is semitransparent red glowing texture on the statue on the first level.
	u16 texture_id;

	// Relative positions of vertices (relative to the center).
	[ [ i16, 3 ], 4 ] vertices;

	// Value in range 0 to 1024 representing normal azimuth (mapped to range from 0 to 2 PI ).
	u16 normal_azimuth;

	// Texture coordinates offset (in pixels) for vertex #0.
	[ i8, 2 ] tc_offset;

	// Value in range 0 to 255 mapped to angles 0 to 2 PI.
	// For some reason lower bits seems to be also used for texture scale.
	u8 texture_roll;

	// Seems to be always zero.
	u8 data0;

	// Value in range 768 to 1024 mapped to angles -PI/2 to 0 for faces facing down.
	// Value in range 0 to 256 mapped to angles 0 to PI/2 for faces facing up.
	u16 normal_elevation;

	// Global coordinates of the quad center.
	[ i16, 3 ] center;

	// Contains half size of the bounding box, which includes the whole quad + some fixed padding (~20 units) in each dimension.
	// Presumably this padding is needed for physics (player collisions?).
	[ i16, 3 ] bounding_box_half_size;

	// Contains non-zero for emissive surfaces. Also it may contain some flag for breakable surfaces (windows).
	i16 data1;
}

static_assert( typeinfo</ZmapQuad/>.size_of == 48s );

struct ZVoxFileHeader ordered
{
	auto c_expected_signature= "VOXA";

	[ char8, 4 ] signature;
	u32 num_clusters;
	u32 num_structs0;
	u32 num_light_sources;
	u32 num3;
	u32 num4;
	u32 num5;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZVoxFileHeader/>.size_of == 32s );

// Some sort of box-shaped invisible entity.
// Maybe it's a trigger?
// There are only few of them and one of them is placed where level ends.
struct ZvoxStruct0 ordered
{
	// data[0], data[1], data[2] - presumably a center of a bounding box.
	// data[3], data[4], data[5] - presumably half size of a bounding box.
	// data[6] - always -1.
	// data[7] - always -1.
	// data[8] - 1 for map exit, 0 for other volumens.
	// data[9] - -1 or small positive integers.
	[ i32, 10 ] data;
}

static_assert( typeinfo</ZvoxStruct0/>.size_of == 40s );

struct ZvoxStruct1 ordered
{
	// data[3] is 1 or -1.
	// data[4] is 0 or 1.
	// Other fields are zero.
	[ i32, 8 ] data;
}

static_assert( typeinfo</ZvoxStruct1/>.size_of == 32s );

// Cluster with extra data (additional to data stored in cluster struct in ZPOZ file).
struct ZvoxCluster ordered
{
	ZpozCluster c;

	// Contains number of quads which belong to this cluster.
	i32 num_quads;

	//  Always minus one, except 0 for a button and 1 for a door opeated by this button.
	i32 unknown1;

	// First ZvoxLightSource index.
	// May have different meaning for button/door clusters.
	// For a button it's 8 and for a door it's 96 (with light_sources_end equal to 0).
	i32 light_sources_begin;

	// In most cases zero, but sometimes large (16-bit) non-unique positive numbers (with minor byte zero). 74 for button, 26 for door.
	// Usually clusters with non-zero large values represent large volumes of air or water.
	// Different values are assigned to different kinds of area?
	i32 unknown3;

	// Last ZvoxLightSource index (not including).
	i32 light_sources_end;

	// Mostly minus one, but sometimes non-unique negative values like -242.
	// It seems like values slightly greater than -256 represent ambient sound sources with sound index equal to ambient_sound_index + 256.
	i32 ambient_sound_index;

	// Mostly zero, equal to 1 for water volumes, is 8 for button.
	i32 contents;

	// Always zero.
	i32 unknown7;
}

static_assert( typeinfo</ZvoxCluster/>.size_of == 64s );

struct ZvoxLightSource ordered
{
	// Position of this light source relative to the center of its parent cluster.
	[ i32, 3 ] offset;
	// It seems to be pairs of small 16-bit integers (mostly positive, but rarely negative).
	// data1[0] is 11, 19 or 35 for light sources with flame sprites (minor 3 bits are equal to 3).
	// data1[0] has minor 3 bits equal to 0 for light sources with coronas (street lamps).
	// data1[0] with 3 minor bits zeroed and then multiplyed by 2 seems to be an index in the "de_kolory" palette representing light source color.
	[ i16, 2 ] data1;
}

static_assert( typeinfo</ZvoxLightSource/>.size_of == 16s );

struct ZPozFileHeader ordered
{
	auto c_expected_signature= "POZC";

	[ char8, 4 ] signature;
	u32 num_entities;
	u32 num_structs1; // Seems to be equal to number of structs in "MAPA*.WAY" file. Or is it just a coincidence?

	[ u32, 4 ] data;

	[ char8, 4 ] body_marker;
}

static_assert( typeinfo</ZPozFileHeader/>.size_of == 32s );

// Presumably an entity struct.
struct ZpozEntity ordered
{
	// Identical to the "aktor" field in a "ZINF.STD" file.
	// Maybe only lower 8 bits are used.
	u16 kind;

	[ i16, 3 ] position;

	// data[0] - always (or almost always) 0.
	// data[1] -always (or almost always) -1.
	// data[4] - some sort of flags or maybe angle.
	// data[16] - sequential numbers for enemies, -1 for other entities. It looks like an index into the graps array of "MAPA*.WAY" file with corresponding navigation graph.
	// data[19] - 0 for enemies, 5 for pick-ups, 10 for some entities in an isolated box (skyroom?), 20 for grids.
	// data[23] - sequential numbers for all entities.
	[ i16, 27 ] data;
	// It seems to be 0 for out-of-the-bounds entities.
	u16 alive_flag;
}

static_assert( typeinfo</ZpozEntity/>.size_of == 64s );

// For now an unknown struct.
// It seems to contain no positions.
struct ZpozStruct1 ordered
{
	// data[0] is small positive integer (like 2 or 3).
	// data[2] contains integers in range -5456 to 2936.
	// data[3] contains integers in range -5456 to 2936.
	// data[2] and data[3] are near to each other (difference may be positive or negative).
	// data[4] contains integers in range -3296 to 0.
	// data[18] contains integers in range -3200 to -32.
	// data[19] contains integers in range -3200 to -16.
	// data[18] and data[19] are near to each other (difference may be positive or negative).
	// data[20] contains integers in range -256 to 0.
	// data[34] contains integers in range -800 to 1920.
	// data[35] contains integers in range -800 to 1920.
	// data[34] and data[35] are always equal to each other.
	// data[36] contains integers in range 0 to 192.
	// data[50] contains integers in range -3104 to 0.
	// data[51] contains integers in range -192 to 0.
	// data[52] contains integers in range 0 to 32.
	// data[53] contains integers in range 0 to 160.
	// data[54] contains integers in range 0 to 160.
	// data[55] contains integers in range 0 to 160.
	// data[53], data[54], data[55], are equal to each other. data[52] with rare exceptions equal to data[53].
	// data[56] contains integers in range 0 to 1.
	// Other fields are zeros.
	[ i32, 82 ] data;
}

static_assert( typeinfo</ZpozStruct1/>.size_of == 328s );

// There is an intermediate header after first two data blocks.
struct ZPozIntermediateHeader ordered
{
	u32 num0;
	u32 num_visibility_info_ints;
	u32 num_clusters;
	u32 num2;
}

static_assert( typeinfo</ZPozIntermediateHeader/>.size_of == 16s );

// Cluster contains several polygons and may contain light sources.
struct ZpozCluster ordered
{
	[ i32, 3 ] center;

	// Represents a box around this cluster. At least for the majority of them.
	[ i32, 3 ] bounding_box_half_size;

	// Contains number of children clusters (located within its boundaries).
	// For clusters with no parent and no children it seems to be zero.
	// For clusters located within boundaries of an another clusters it's -1.
	// Children clusters are stored in clusters array directly after their parent cluster.
	i32 num_children_clusters;

	// Index of the first related quad.
	u32 first_quad_index;
}

static_assert( typeinfo</ZpozCluster/>.size_of == 32s );

struct ZpozClusterVisibilityData ordered
{
	// Usually it's all minus ones.
	// But sometimes there are not so large (16-bit) positive values, which generally increase (but not always).
	// Maximum value is slightly less than ZPosIntermediateHeader.num1.
	// data[1] - data[0] and data[3] - data[2] are always positive values (roughly between 10 and 100).
	// If num_clusters * 4 is subtracted from these values, all them fit into number of cluster indices.
	// It seems like data[0] to data[1] and data[2] to data[3] represent two spans it cluster index array.
	// it looks like visibility information (which clusters are visible from this cluster).
	// It's unclear why we have two ranges here. Maybe one is for camera and another is for lights?
	// Both ranges have format like N 0 0 0 0 0 0 0 [ N nums ] M 0 0 0 0 0 0 0 [ M nums ].
	// So, each range contains two subranges inside. There is only prefix of 8 numbers, first number is count, other 7 are always zero.
	// All 4 subranges mostly contain the same cluster numbers, but sometimes there are a couple of less or more numbers.
	[ i32, 4 ] data;
}

static_assert( typeinfo</ZpozClusterVisibilityData/>.size_of == 16s );

// The rest of a ZPOZ file contains cluster indices (addressed by ZpozClusterExtra structures).
type ZPozClusterIndex= i32;

struct ZmapLamHeader ordered
{
	u32 num0;
	u32 num_tessellated_quads;
	u32 tessellated_quads_data_size;
	u32 num3;
	u32 num4;
	u32 num_structs2;
	u32 num6;
	u32 num7;
}

static_assert( typeinfo</ZmapLamHeader/>.size_of == 32s );

// This struct represent a tessellated quad.
struct ZmapLamTesselaltedQuad ordered
{
	u32 data_offset;
	u32 vertex_count;

	// Actual data is stored in separate array at data_offset.
	// First structs consisting of 6 "f32" values follow,
	// with first 3 values equal to vertex position in relative form (like vertex offsets in ZmapQuad strure),
	// with 2 values representing normalized texture coordinates,
	// with single 32-bit value representing BRGA color (precalculated light).
	//
	// The number of this structs is equal to vertex count.
	//
	// Then follows a variable-length array consisting of integer values.
	// Value0 is number of polygons.
	// Value1 is always zero.
	// Then follow groups of 8 integers with count equal to number of polygons.
	// In each group value0 is number of polygon vertices (up to 6), value1 is always zero, than vertex indices follow.
}

static_assert( typeinfo</ZmapLamTesselaltedQuad/>.size_of == 8s );

// It's "f32" values for vertex positions and texture coordinates, BGRA color packed in "u32" and "u32" values for counts/indices of polygons.
type ZmapLamTessellatedQuadsData= byte32;

static_assert( typeinfo</ZmapLamTessellatedQuadsData/>.size_of == 4s );

struct ZmapLamStruct2 ordered
{
	// data[0] is in range -1040187392 to 1157070848.
	// data[1] is in range -1040187392 to 1130364928.
	// data[2] is in range -1006370816 to -1003487232.
	// data[3] is in range 1116193718 to 1146920456
	// data[4] is in range 0 to 875
	// data[5] is in range 10526880 to 11776947.
	// data[6] is in range 1 to 13389.
	// data[7] is in range 0 to 344.
	// data[8] is in range 0 to 1154711552, but mostly is zero.
	// data[9] is in range -996966400 to 0, but mostly is zero.
	// data[10] is in range -1006108672 to 0, but mostly is zero.
	// data[11] is always zero.
	// data[12] is in range 0 to 1154711552, but mostly is zero.
	// data[13] is in range -996966400 to 0, but mostly is zero.
	// data[14] is in range -1006108672 to 0, but mostly is zero.
	// data[15] is always zero.
	[ i32, 16 ] data;
}

static_assert( typeinfo</ZmapLamStruct2/>.size_of == 64s );

struct ZmapLemHeader ordered
{
	u32 num0;
	 // Is equal to number of map clusters.
	u32 num_clusters;
	u32 num2;
	u32 num3;
	u32 num4;
	u32 num5;
	u32 num6;
	u32 num7;
}

static_assert( typeinfo</ZmapLemHeader/>.size_of == 32s );

// Per-cluster sky visibility used at least for effects like rain and snow.
struct ZmapLemClusterSkyVisibilityData ordered
{
	// Only clusters under sky have non-zero values.
	// It's likely some sort of sky visibility for effects like rain and snow.
	// It looks like a rough grid 4x4x4 within cluster boundaries with non-zero voxels representing areas where it can rain/snow.
	// Voxels are addresed likle data[ x + y * 4 + z * 16 ].
	// For non-obstructed voxels under sky it usually contains bytes with values 0xFF, 0xFF, 0xFF, 0x00.
	// For water voxels under sky it's more like 0xFF, 0x99, 0x99, 0x00.
	// Generally values in bytes 1 and 2 are smaller for lower voels.
	[ u32, 64 ] data;
}

static_assert( typeinfo</ZmapLemClusterSkyVisibilityData/>.size_of == 256s );

struct MapaWayFileHeader ordered
{
	// It seems like all files of this type have this signature.
	var [ char8, 4 ] c_expected_signature[ (0x92), (0x2d), (0x00), (0x00) ];

	[ char8, 4 ] signature;

	u32 num_navigation_graphs;

	// This value multiplied by 4 is 32 bytes less than total file size.
	// It's likely contents size in 32-bit integers (excluding header size).
	u32 num2;

	u32 num3;
	u32 num4;
	u32 num5;
	u32 num6;
	u32 num7;
}

static_assert( typeinfo</MapaWayFileHeader/>.size_of == 32s );

// Navigation graph, used presumably by bots.
// A navigation graph is a collection of up to 128 nodes placed in some map area.
struct MapaWayNavigationGraph ordered
{
	var size_type c_max_nodes= 128s;

	u32 num_nodes;
	i32 unknown1; // Is always 0.
	i32 unknown2; // Is 0 for non-empty graphs and -1 for empty ones.
	i32 unknown3; // Is always 650000000.
	i32 unknown4; // Is always -1.
	i32 unknown5; // Is -1 for empty graphs or a value staring from 1 for non-empty ones (presumably up to number of nodes).
	i32 unknown6; // Is always 0.
	i32 unknown7; // Is always -1.
	i32 unknown8; // Is always 650000000.
	i32 unknown9; // Is always -1.
	i32 unknown10; // Is always -1.
	i32 unknown11; // Is always 0.
	i32 unknown12; // Is always 0.
	i32 unknown13; // Is always 0.
	i32 unknown14; // Is always 0.
	i32 unknown15; // Is always 0.

	[ MapaWayNavigationGraphNode, c_max_nodes ] nodes;

	// routing_matrix[j][k] contains index of node "l" which should be taken to move from node "j" to node "k" using the shortest possible path.
	// Unused rows/columns are always -1.
	// Values on the main diagonal are always -1.
	[ [ i16, c_max_nodes ], c_max_nodes ] routing_matrix;
}

static_assert( typeinfo</MapaWayNavigationGraph/>.size_of == 36928s );

// Navigation graph node.
// Nodes are placed at floor level (except for flying entities).
struct MapaWayNavigationGraphNode ordered
{
	// Absolute world position of this node.
	[ i32, 3 ] position;

	i32 unknown3; // Is in range -1 to 34. It's mostly 0, sometimes -1 (where a corresponding enemy is placed), sometimes is a positive values near some pick-ups.
	i32 unknown4; // Is in range 0 to 29. it's almost always 0 except a couple of cases with values like 4, 5, 29.
	i32 unknown5; // Is always 0.
	i32 unknown6; // Is always 0.
	i32 unknown7; // Is always 0.
}

static_assert( typeinfo</MapaWayNavigationGraphNode/>.size_of == 32s );

} // namespace PM
