import "/string.iu"

namespace PM
{

class LinesRawIterator
{
public:
	fn constructor( ust::string_view8 s ) @( ust::reference_notation::pollution::param0_param_1_inner_reference );

	fn next( mut this ) : ust::optional</ust::string_view8/> @( ust::reference_notation::return_inner_references::param0_inner_reference0 );

private:
	ust::string_view8 s_;
}

class WordsIterator
{
public:
	fn constructor( ust::string_view8 s ) @( ust::reference_notation::pollution::param0_param_1_inner_reference );

	fn next( mut this ) : ust::optional</ust::string_view8/> @( ust::reference_notation::return_inner_references::param0_inner_reference0 );

private:
	ust::string_view8 s_;
}

fn ExtractSpaceSeparatedWords( ust::iterator</WordsIterator/> &mut words_it ) : ust::string8
{
	var ust::string8 mut res;
	loop
	{
		auto word_opt= words_it.next();
		if( word_opt.empty() )
		{
			break;
		}

		if( !res.empty() )
		{
			res.push_back( ' ' );
		}
		res+= word_opt.try_deref();
	}

	return res;
}

} // namespace PM
