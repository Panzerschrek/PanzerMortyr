import "/hash_map.u"
import "/path.u"
import "/string.u"
import "resource_string.uh"

namespace PM
{

struct MapsDescription
{
	ust::hash_map</u32, MapDescription/> maps;

	struct MapDescription
	{
		[ ResourceString, 2 ] wall_files= zero_init;
		u32 materials_block= 0xFFFFFFFFu;
		ust::string8 positions_file;
		ust::string8 spectrum_file;
		[ ust::string8, 8 ] ambient_sound_files;
		u32 precipitation_kind= 0u; // TODO - use an enum?
		u32 sky_model= 0u; // TODO - use an enum?

		// Colors in BRG order.
		// First color may be fog color.
		[ [ u8, 3 ], 2 ] sky_colors= zero_init;

		bool linear_fog_enabled= true;
		[ u8, 3 ] fog_color= zero_init;

		ust::string8 entities_info_file;

		ust::string8 caption;
		[ u32, 2 ] cd_tracks_range= zero_init;
	}
}

auto& c_maps_description_file_name= "ICE.STD";

fn LoadMapsDescriptionFile( ust::filesystem_path_view maps_directory ) : ust::optional</MapsDescription/>;
fn ParseMapsDescriptionFile( ust::string_view8 file_contents ) : ust::optional</MapsDescription/>;

} // namespace PM
