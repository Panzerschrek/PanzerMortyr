import "resource_string.iu"

namespace PM
{

struct ArchiveHeader ordered
{
	var u32 c_expected_id= 0x4B555041u;

	u32 id;
	u32 num_files;
	[ u32, 6 ] some;
}

static_assert( typeinfo</ArchiveFileHeader/>.size_of == 32s );

struct ArchiveFileHeader ordered
{
	u32 size;
	u32 offset;
	[ u32, 2 ] some;
	ResourceString name;
	[ char8, 4 ] unused;
}

static_assert( typeinfo</ArchiveFileHeader/>.size_of == 32s );

} // namespace PM
