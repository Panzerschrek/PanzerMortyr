import "/path.iu"
import "/string.iu"
import "/vector.iu"
import "resource_string.iu"

namespace PM
{

struct MapsDescription
{
	ust::vector</ MapDescription /> maps;

	struct MapDescription
	{
		// ZMAP*.ANT and ZVOX*.ANT files.
		[ ResourceString, 2 ] wall_files= zero_init; // sciany

		u32 materials_block= 0xFFFFFFFFu; // tekstury

		// ZPOZ*.ANT file.
		ResourceString positions_file= zero_init; // pozycje

		// Is always "horyzont.raw".
		ResourceString horizont_file= zero_init; // widmo

		// names of ambiend sound files played on this map.
		[ ResourceString, 8 ] ambient_sound_files= zero_init; // glos

		// 0 for none.
		// 1 for snow.
		// 2 for rain.
		u32 precipitation_kind= 0u; // opad

		// Is 1 or 2 or 3.
		u32 sky_model= 0u; // model_nieba

		// 0 for singleplayer.
		// 1 for deathmatch.
		// 2 for cooperative.
		// 4 for capture the flag.
		u32 game_mode= 0u; // gatunek_gry

		// Value0 is entity index which should be collected/destroyed before leaving the map.
		// Value1 is always -1.
		// Value2 is message displayed while entering the map end trigger without compleating this condition.
		tup[ u32, i32, ust::string8 ] leave_condition[ 0u, -1, "" ]; // warunek

		// Colors in BRG order.
		// It looks like the sky is drawn as gradient between two these colors.
		// Provide a default value for maps without colors specified, like maps 5, 6, 34.
		// These values are experiementally-found.
		[ [ u8, 3 ], 2 ] sky_colors[ [ (128), (128), (0) ], [ (128), (128), (255) ] ]; // kolory_nieba

		bool linear_fog_enabled= false; // mgla_liniowa_dozwolona

		[ u8, 3 ] sky_light= zero_init; // swiatlo_od_nieba

		[ u8, 3 ] fog_color= zero_init; // zamglenie_powietrze

		// May be empty, in this case the default info file is used.
		ResourceString entities_info_file= zero_init; // info_data

		// What name is displayed for this map.
		ust::string8 caption;

		[ u32, 2 ] cd_tracks_range= zero_init; // cd_tracks_range
	}
}

var ResourceString& c_maps_description_file_name= "ICE.STD\0\0\0\0\0\0\0\0\0";

fn LoadMapsDescriptionFile( ust::filesystem_path_view maps_directory ) : ust::optional</MapsDescription/>;
fn ParseMapsDescriptionFile( ust::string_view8 file_contents ) : ust::optional</MapsDescription/>;

} // namespace PM
