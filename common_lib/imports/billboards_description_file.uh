import "/path.u"
import "/vector.u"
import "resource_string.uh"

namespace PM
{

struct BillboardDescription
{
	// Represents billboard size (in world units).
	u32 dx= 0u;
	u32 dy= 0u;

	u32 xp= 0u; // Start U coordinate in atlas.
	u32 yp= 0u; // start V coordinate in atlas.

	u32 xk= 0u; // End U coordinate in atlas.
	u32 yk= 0u; // End V coordinate in atlas.

	// Almost always zero, is 0.25 for some flame sprites.
	// TODO - support floating-point values.
	u32 dz= 0u;

	// Texture index in some strange form.
	// There are following numbers in use:
	// 621 - ZBRA001.BMP, ZBRA001E.BMP, ZBRA001F.BMP, ZBRA001G.BMP, ZBRA001K.BMP. Billboards with this texture use alpha-test (black color is turned into alpha 0).
	// 721 - ZBRA001.BMP, ZBRA001E.BMP, ZBRA001F.BMP, ZBRA001G.BMP, ZBRA001K.BMP. Billboards with this texture index look black.
	// 818 - ZBRA004.BMP, ZBRA004F.BMP.
	// 819 - ZBRA003.BMP.
	// 820 - ZBRA000.BMP.
	// 821 - ZBRA001K.BMP.
	// 997 - ZBRA000.BMP.
	// 998 - ZBRA001.BMP, ZBRA001E.BMP, ZBRA001F.BMP, ZBRA001G.BMP, ZBRA001K.BMP.  Billboards with this texture use blending (looks like additive blending).
	// Values in range 801 to 816 represent tiles in 4x4 grid in file ZBRA002.BMP.
	u32 tek= 0u;
}

type BillboardsDescription= ust::vector</BillboardDescription/>;

namespace BillboardConstants
{

var u32
	c_texture0= 997u,
	c_texture1= 998u,
	c_texture1_black= 621u,
	c_texture1_alpha_test= 721u,
	c_texture2_first_tile= 801u, c_texture2_last_tile= 816u,
	c_texture4= 818u;

var u32
	c_id_bubble= 3u,
	c_id_light_corona= 95u,
	c_id_first_static_light_source_flame= 113u, c_num_static_light_source_flames= 24u,
	c_id_first_smoke_trail_particle= 165u, c_num_smoke_trail_particles= 8u,
	c_star_id= 214u,
	c_id_first_flamethrower_trail_particle= 215u, c_num_flamethrower_trail_particles= 16u;

var [ u32, 30 ] c_shot_ids
[
	~0u,
	144u,
	145u,
	146u,
	147u,
	148u,
	149u,
	150u,
	~0u,
	~0u,
	151u,
	152u,
	153u,
	154u,
	155u,
	156u,
	157u,
	158u,
	159u,
	160u,
	~0u,
	~0u,
	~0u,
	~0u,
	137u,
	138u,
	161u,
	162u,
	163u,
	164u,
];

} // namespace BillboardConstants

var ResourceString& c_billboards_description_file_name= "BLIKI.STD\0\0\0\0\0\0\0";

fn LoadBillboardsDescriptionFile( ust::filesystem_path_view game_files_directory ) : ust::optional</BillboardsDescription/>;
fn ParseBillboardsDescriptionFile( ust::string_view8 file_contents ) : BillboardsDescription;

} // namespace PM
