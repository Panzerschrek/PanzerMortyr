import "/enum_string_conversions.u"
import "/stdout.u"
import "/string.u"
import "/string_conversions.u"
import "/common_lib/model_loading.uh"

namespace PM
{

fn LoadModel( ust::filesystem_path_view file_path ) : ust::optional</ModelData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) ->
		{
			result_match( LoadModel( f ) )
			{
				Ok( mut m ) -> { return move(m); },
				Err( e ) ->
				{
					ust::stderr_print( ust::concat( "Error reading model file: ", ust::enum_to_string( e ), "\n" ) );
					return ust::null_optional;
				}
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadModel( ust::file_readable &mut f ) : ust::io_result</ModelData/>
{
	var ObbFileHeaderBase mut header_base= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header_base ).to_byte8_range() ) );

	if( header_base.signature != ObbFileHeaderBase::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header_base.signature, "\"!" ) );
		return ust::io_error::other;
	}

	var ObbFileHeaderExtended mut header_extended= zero_init;
	result_check_or_return(
		f.read_exact(
			ust::single_element_array_view( header_extended ).to_byte8_range().subrange_end(
				( header_base.version_number == ObbFileHeaderBase::c_version5
					? ObbFileHeaderExtended::c_size_version5
					: ObbFileHeaderExtended::c_size_version4 ) ) ) );

	if( false )
	{
		var ust::string8 mut m;
		m+= "Model header nums: ";
		m+= ust::to_string8( header_base.texture_data_offset );
		m+= ", ";
		m+= ust::to_string8( header_base.version_number );
		m+= "\n";
		ust::stdout_print( m );

		var [ i32, 26 ] mut nums_raw= zero_init;
		ust::array_view_mut</i32/>( nums_raw ).to_byte8_range().copy_from( ust::single_element_array_view( header_extended ).to_byte8_range() );

		ust::stdout_print( "Model extra nums:\n" );
		foreach( &n : nums_raw )
		{
			ust::stdout_print( ust::concat( ust::to_string8( n ), "\n" ) );
		}
	}

	var ModelData mut result
	{
		.num_vertices( header_extended.num_vertices ),
		.num_frames( ust::max( 1u, header_extended.num_frames ) ),
		.num_lod0_triangles( header_extended.num_triangles ) // update it later if needed
	};

	var size_type num_triangles( header_extended.num_triangles );

	result.triangles.resize( size_type( num_triangles ), ust::make_zeroed</ObbTriangle/>() );
	result_check_or_return( f.read_exact( result.triangles.range().to_byte8_range() ) );

	result.texture_coordinates.resize( size_type( result.num_vertices ), ust::make_zeroed</ObbVertexTextureCoordinates/>() );
	result_check_or_return( f.read_exact( result.texture_coordinates.range().to_byte8_range() ) );

	result.vertex_positions_data.resize( size_type( result.num_vertices * result.num_frames ), ust::make_zeroed</ObbVertexPosition/>() );
	result_check_or_return( f.read_exact( result.vertex_positions_data.range().to_byte8_range() ) );

	result.per_frame_triangle_normals.resize( num_triangles * size_type( result.num_frames ), ust::make_zeroed</ObbPerFrameTriangleNormal/>() );
	result_check_or_return( f.read_exact( result.per_frame_triangle_normals.range().to_byte8_range() ) );

	if( header_base.version_number == ObbFileHeaderBase::c_version5 )
	{
		// After frame vertex data we have 2 blocks of data - which are just 32-bit integers for vertices and triangles.
		// Its exact meaning is unclear.

		result.some_per_triangle_ints.resize( num_triangles, 0u );
		result_check_or_return( f.read_exact( result.some_per_triangle_ints.range().to_byte8_range() ) );

		result.some_per_vertex_ints.resize( size_type( result.num_vertices ), 0u );
		result_check_or_return( f.read_exact( result.some_per_vertex_ints.range().to_byte8_range() ) );

		// This lods data is stored in some complex way, it's for now uncelar what it is.
		// But analysys of this data has shown, how to extract at least number of lod0 triangles.

		var u32 num= result.some_per_vertex_ints.front();
		if( size_type(num) <= num_triangles )
		{
			result.num_lod0_triangles= num;
		}
	}

	result.texture_collections.resize( size_type( header_extended.num_texture_collections ) );

	foreach( &mut texture_collection : result.texture_collections )
	{
		{
			var ModelData::TextureData &mut texture_data= texture_collection.ld_texture;

			texture_data.size[0]= header_extended.ld_texture_size[0];
			texture_data.size[1]= header_extended.ld_texture_size[1];

			texture_data.pixels_data.resize( size_type( texture_data.size[0] * texture_data.size[1] ), 0u8 );

			if( texture_data.pixels_data.size() == 0s )
			{
				continue;
			}

			result_check_or_return( f.read_exact( texture_data.pixels_data.range().to_byte8_range() ) );
			result_check_or_return( f.read_exact( ust::array_view_mut</u8/>( texture_data.palette ).to_byte8_range() ) );
		}

		for( auto mut i= 0s; i < 3s; ++i )
		{
			var ModelData::TextureData &mut texture_data= texture_collection.hd_textures[i];

			texture_data.size[0]= header_extended.hd_texture_sizes[i][0];
			texture_data.size[1]= header_extended.hd_texture_sizes[i][1];

			texture_data.pixels_data.resize( size_type( texture_data.size[0] * texture_data.size[1] ), 0u8 );

			if( texture_data.pixels_data.size() == 0s )
			{
				continue;
			}

			result_check_or_return( f.read_exact( texture_data.pixels_data.range().to_byte8_range() ) );
			result_check_or_return( f.read_exact( ust::array_view_mut</u8/>( texture_data.palette ).to_byte8_range() ) );
		}
	}

	return result;
}

} // namespace PM
