import "/enum_string_conversions.u"
import "/file_helpers.u"
import "/integer_parsing.u"
import "/path_utils.u"
import "/stdout.u"
import "/string_conversions.u"
import "/common_lib/materials_file.uh"
import "/common_lib/string_iterators.uh"

namespace PM
{

fn LoadMaterialsFile( ust::filesystem_path_view maps_directory ) : ust::optional</MaterialsDescription/>
{
	var ust::filesystem_path file_path= ust::path::join( maps_directory, "TXTAB.STD" );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseMaterialsFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseMaterialsFile( ust::string_view8 file_contents ) : MaterialsDescription
{
	// TODO - load here other special materials.
	var [ tup[ ust::string_view8, MaterialsDescription::SpecialMaterial ], 4 ] special_material_names
	[
		[ "set_niebo_data", MaterialsDescription::SpecialMaterial::Sky ],
		[ "set_woda_data", MaterialsDescription::SpecialMaterial::Water ],
		[ "set_szyba_data", MaterialsDescription::SpecialMaterial::Glass ],
		[ "set_lawa_data", MaterialsDescription::SpecialMaterial::Lava ],
	];

	var MaterialsDescription mut materials_description;

	var MaterialsDescription::Block mut current_block;
	var u32 mut current_block_index= 0xFFFFFFFFu;

	var ust::optional</MaterialsDescription::Texture/> mut current_texture;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) ) label lines_loop
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "blok" )
		{
			if( current_block_index != 0xFFFFFFFFu )
			{
				if( !current_texture.empty() )
				{
					current_block.textures.push_back( current_texture.try_take() );
				}

				materials_description.blocks.insert_new( current_block_index, take( current_block ) );
			}

			auto block_index_str_opt= words_it.next();
			if( block_index_str_opt.empty() )
			{
				continue;
			}
			auto index_opt= ust::parse_integer_exact</u32/>( block_index_str_opt.try_deref() );
			if( index_opt.empty() )
			{
				continue;
			}
			current_block_index= index_opt.try_deref();
		}
		else if( first_word == "de_kolory" || first_word == "do_kolory" )
		{
			var MaterialsDescription::PaletteDescription mut palette_description;

			auto equal_sign_opt= words_it.next();
			if( equal_sign_opt.empty() || equal_sign_opt.try_deref() != "=" )
			{
				continue;
			}

			auto file_name_opt= words_it.next();
			if( file_name_opt.empty() )
			{
				continue;
			}

			palette_description.file_name= file_name_opt.try_deref();

			if_var( extra_file_name : words_it.next() )
			{
				palette_description.extra_file_name= extra_file_name;
			}

			if_var( some_number_str : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( some_number_str ) )
				{
					palette_description.some_number= n;
				}
			}

			( first_word == "de_kolory" ? current_block.palette0 : current_block.palette1 )= move(palette_description);
		}
		else if( first_word == "mipmapa" )
		{
			if( !current_texture.empty() )
			{
				current_block.textures.push_back( current_texture.try_take() );
			}

			var MaterialsDescription::Texture mut t;

			for( auto mut i= 0u; i < 4u; ++i )
			{
				auto image_file_opt= words_it.next();
				if( image_file_opt.empty() )
				{
					break;
				}
				t.mips[i]= image_file_opt.try_deref();
			}

			current_texture.reset( move(t) );
		}
		else if( first_word == "material" )
		{
			if( !current_texture.empty() )
			{
				auto index_str_opt= words_it.next();
				auto name_opt= words_it.next();
				if( index_str_opt.empty() || name_opt.empty() )
				{
					continue;
				}

				auto index_opt= ust::parse_integer_exact</u32/>( index_str_opt.try_deref() );
				if( index_opt.empty() )
				{
					continue;
				}
				var u32 index= index_opt.try_deref();
				if( index >= 4u )
				{
					continue;
				}
				current_texture.try_deref().materials[index]= name_opt.try_deref();
			}
		}
		else
		{
			foreach( &pair : special_material_names )
			{
				if( first_word == pair[0] )
				{
					var u32 mut index= u32( current_block.textures.size() ) << 2;
					if_var( &num_str : words_it.next() )
					{
						if_var( num : ust::parse_integer_exact</u32/>( num_str ) )
						{
							index+= num;
						}
					}
					current_block.special_material_indices[ size_type( pair[1] ) ]= index;

					continue label lines_loop;
				}
			}

		}
	}

	if( !current_texture.empty() )
	{
		current_block.textures.push_back( current_texture.try_take() );
	}

	if( current_block_index != 0xFFFFFFFFu )
	{
		materials_description.blocks.insert_new( current_block_index, take( current_block ) );
	}

	return materials_description;
}

} // namespace PM
