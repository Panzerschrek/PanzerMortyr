import "/enum_string_conversions.iu"
import "/file_helpers.iu"
import "/integer_parsing.iu"
import "/path_utils.iu"
import "/stdout.iu"
import "/string_conversions.iu"
import "/common_lib/materials_file.iu"
import "/common_lib/string_iterators.iu"

namespace PM
{

fn LoadMaterialsFile( ust::filesystem_path_view maps_directory ) : ust::optional</MaterialsDescription/>
{
	var ust::filesystem_path file_path= ust::path::join( maps_directory, ConvertResourceStringToStringView( c_materials_file_name ) );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseMaterialsFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseMaterialsFile( ust::string_view8 file_contents ) : MaterialsDescription
{
	// TODO - handle also "set_plakat_data", "set_podloga_data" (tekstura dla podlogi ruchomych obiektow), "set_swiatlo_data", "set_rusztowanie_data".
	var [ tup[ ust::string_view8, MaterialsDescription::SpecialMaterial ], 10 ] special_material_names
	[
		[ "set_szyba_data", MaterialsDescription::SpecialMaterial::Glass ],
		[ "set_film_data", MaterialsDescription::SpecialMaterial::Film ],
		[ "set_woda_data", MaterialsDescription::SpecialMaterial::Water ],
		[ "set_niebo_data", MaterialsDescription::SpecialMaterial::Sky ],
		[ "set_wentyl_data", MaterialsDescription::SpecialMaterial::Valve ],
		[ "set_okno_data", MaterialsDescription::SpecialMaterial::Window ],
		[ "set_kwas_data", MaterialsDescription::SpecialMaterial::Acid ],
		[ "set_lawa_data", MaterialsDescription::SpecialMaterial::Lava ],
		[ "set_lustro_data", MaterialsDescription::SpecialMaterial::Mirror ],
		[ "set_szyba_panc_data", MaterialsDescription::SpecialMaterial::ArmoredGlass ],
	];

	var MaterialsDescription mut materials_description;

	var MaterialsDescription::Block mut current_block;
	var u32 mut current_block_index= 0xFFFFFFFFu;

	var ust::optional</MaterialsDescription::Texture/> mut current_texture;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) ) label lines_loop
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "blok" )
		{
			if( current_block_index != 0xFFFFFFFFu )
			{
				if( !current_texture.empty() )
				{
					current_block.textures.push_back( current_texture.try_take() );
				}

				materials_description.blocks.insert_new( current_block_index, take( current_block ) );
			}

			auto block_index_str_opt= words_it.next();
			if( block_index_str_opt.empty() )
			{
				continue;
			}
			auto index_opt= TryParseIntegerWithLeadingZeros( block_index_str_opt.try_deref() );
			if( index_opt.empty() )
			{
				continue;
			}
			current_block_index= index_opt.try_deref();
		}
		else if( first_word == "de_kolory" || first_word == "do_kolory" )
		{
			var MaterialsDescription::PaletteDescription mut palette_description;

			auto equal_sign_opt= words_it.next();
			if( equal_sign_opt.empty() || equal_sign_opt.try_deref() != "=" )
			{
				continue;
			}

			auto file_name_opt= words_it.next();
			if( file_name_opt.empty() )
			{
				continue;
			}

			palette_description.file_name= ConvertStringToResourceString( file_name_opt.try_deref() );

			if_var( extra_file_name : words_it.next() )
			{
				palette_description.extra_file_name= ConvertStringToResourceString( extra_file_name );
			}

			if_var( some_number_str : words_it.next() )
			{
				if_var( n : TryParseIntegerWithLeadingZeros( some_number_str ) )
				{
					palette_description.some_number= n;
				}
			}

			( first_word == "de_kolory" ? current_block.palette0 : current_block.palette1 )= move(palette_description);
		}
		else if( first_word == "mipmapa" )
		{
			if( !current_texture.empty() )
			{
				current_block.textures.push_back( current_texture.try_take() );
			}

			var MaterialsDescription::Texture mut t{ .mips= zero_init };

			for( auto mut i= 0u; i < 4u; ++i )
			{
				auto image_file_opt= words_it.next();
				if( image_file_opt.empty() )
				{
					break;
				}
				t.mips[i]= ConvertStringToResourceString( image_file_opt.try_deref() );
			}

			current_texture.reset( move(t) );
		}
		else if( first_word == "material" )
		{
			if( !current_texture.empty() )
			{
				auto index_str_opt= words_it.next();
				auto name_opt= words_it.next();
				if( index_str_opt.empty() || name_opt.empty() )
				{
					continue;
				}

				auto index_opt= TryParseIntegerWithLeadingZeros( index_str_opt.try_deref() );
				if( index_opt.empty() )
				{
					continue;
				}
				var u32 index= index_opt.try_deref();
				if( index >= 4u )
				{
					continue;
				}
				current_texture.try_deref().materials[index]= name_opt.try_deref();
			}
		}
		else
		{
			foreach( &pair : special_material_names )
			{
				if( first_word == pair[0] )
				{
					var u32 mut index= u32( current_block.textures.size() ) << 2;
					if_var( &num_str : words_it.next() )
					{
						if_var( num : TryParseIntegerWithLeadingZeros( num_str ) )
						{
							index+= num;
						}
					}
					current_block.special_material_indices[ size_type( pair[1] ) ]= index;

					continue label lines_loop;
				}
			}

		}
	}

	if( !current_texture.empty() )
	{
		current_block.textures.push_back( current_texture.try_take() );
	}

	if( current_block_index != 0xFFFFFFFFu )
	{
		materials_description.blocks.insert_new( current_block_index, take( current_block ) );
	}

	// Apply some special material tweaks.
	foreach( &mut block_pair : materials_description.blocks )
	{
		auto &mut block= block_pair.value();

		// If no armored glass special material was specified, assume it to be the same as regular glass.
		if( block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::ArmoredGlass ) ] == ~0u )
		{
			block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::ArmoredGlass ) ]=
				block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ];
		}

		// Different valve phases.
		if( block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::ValveAlternative ) ] == ~0u )
		{
			block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::ValveAlternative ) ]=
				block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::Valve ) ];
		}

		// Alternative acid.
		if( block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::AcidAlternative ) ] == ~0u )
		{
			block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::AcidAlternative ) ]=
				block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::Acid ) ];
		}
	}

	return materials_description;
}

// This config has sometimes integers with leading zeros. We should parse them properly.
fn TryParseIntegerWithLeadingZeros( ust::string_view8 mut s ) : ust::optional</u32/>
{
	while( !s.empty() && s.front() == '0' )
	{
		s.drop_front();
	}

	if( s.empty() )
	{
		return 0u;
	}

	return ust::parse_integer_exact</u32/>( s );
}

} // namespace PM
