import "/scoped_array.iu"
import "/enum_string_conversions.iu"
import "/stdout.iu"
import "/common_lib/logger.iu"

namespace PM
{

fn Logger::constructor( ust::filesystem_path_view log_file_path )
	( file_= OpenOrCreateLogFile( log_file_path ) )
{
}

fn Logger::LogLine( mut this, ust::string_view8 line )
{
	scoped_array char8 line_with_end_char[ line.size() + 1s ]( line.iter().chain( ust::string_view8( "\n" ).iter() ) );

	// Write into stdout.
	ust::stdout_print( line_with_end_char );

	// Write into a file. Ignore write errors, since we can't process them properly.
	if_var( &mut file : file_ )
	{
		auto res= file.write_all( line_with_end_char.to_byte8_range() );
		ust::ignore_unused( res );
	}
}

fn OpenOrCreateLogFile( ust::filesystem_path_view log_file_path ) : ust::optional</ ust::file_writeable />
{
	result_match( ust::file_writeable::create( log_file_path ) )
	{
		Ok( mut f ) -> { return f; },
		Err( e ) ->
		{
			ust::stderr_print(
				ust::concat(
					"Failed to open log file \"",
					log_file_path,
					"\" for writing! Error: ",
					ust::enum_to_string(e),
					"\n" ) );

			return ust::null_optional;
		},
	}
}

} // namespace PM
