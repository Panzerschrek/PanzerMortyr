import "/enum_string_conversions.u"
import "/file_helpers.u"
import "/integer_parsing.u"
import "/path_utils.u"
import "/stdout.u"
import "/common_lib/billboards_description_file.uh"
import "/common_lib/string_iterators.uh"

namespace PM
{

fn LoadBillboardsDescriptionFile( ust::filesystem_path_view game_files_directory ) : ust::optional</BillboardsDescription/>
{
	var ust::filesystem_path file_path=
		ust::path::join( game_files_directory,  ConvertResourceStringToStringView( c_billboards_description_file_name ) );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseBillboardsDescriptionFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseBillboardsDescriptionFile( ust::string_view8 file_contents ) : BillboardsDescription
{
	var BillboardsDescription mut billboards_description;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		if( words_it.next() == ust::string_view8( "blik" ) )
		{
			var size_type mut index= ~0s;
			TryParseNumber( index, words_it );

			var BillboardDescription mut billboard_description;
			TryParseNumber( billboard_description.dx, words_it );
			TryParseNumber( billboard_description.dy, words_it );
			TryParseNumber( billboard_description.xp, words_it );
			TryParseNumber( billboard_description.yp, words_it );
			TryParseNumber( billboard_description.xk, words_it );
			TryParseNumber( billboard_description.yk, words_it );
			TryParseNumber( billboard_description.dz, words_it );
			TryParseNumber( billboard_description.tek, words_it );

			if( index < billboards_description.size() )
			{
				billboards_description[index]= move(billboard_description);
			}
			else if( index == billboards_description.size() )
			{
				billboards_description.push_back( move(billboard_description) );
			}
			else
			{
				if( index > billboards_description.size() )
				{
					billboards_description.resize( index + 1s );
				}
				billboards_description[ index ]= move(billboard_description);
			}
		}
	}

	return billboards_description;
}

template</type T/>
fn TryParseNumber( T &mut num, ust::iterator</ WordsIterator /> &mut words_it )
{
	if_var( s : words_it.next() )
	{
		if_var( num_parsed : ust::parse_integer_exact</T/>( s ) )
		{
			num= num_parsed;
		}
	}
}

} // namespace PM
