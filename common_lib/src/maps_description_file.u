import "/enum_string_conversions.iu"
import "/file_helpers.iu"
import "/integer_parsing.iu"
import "/path_utils.iu"
import "/stdout.iu"
import "/common_lib/maps_description_file.iu"
import "/common_lib/string_iterators.iu"

namespace PM
{

fn LoadMapsDescriptionFile( ust::filesystem_path_view maps_directory ) : ust::optional</MapsDescription/>
{
	var ust::filesystem_path file_path= ust::path::join( maps_directory, ConvertResourceStringToStringView( c_maps_description_file_name ) );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseMapsDescriptionFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseMapsDescriptionFile( ust::string_view8 file_contents ) : ust::optional</MapsDescription/>
{
	var MapsDescription mut maps_description;

	var ust::optional</ tup[ u32, MapsDescription::MapDescription ] /> mut current_map;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "etap" )
		{
			if( !current_map.empty() )
			{
				auto [ index, mut m ]= current_map.try_take();
				var size_type index_s( index );

				if( index_s == 8000s )
				{
					// Map 8000 is broken and its index is too high for even storing it.
					move(m);
				}
				else if( index_s >= 64s )
				{
					ust::stdout_print( "Too high map number!\n" );
					move(m);
				}
				else if( index_s == maps_description.maps.size() )
				{
					maps_description.maps.push_back( move(m) );
				}
				else
				{
					if( index_s > maps_description.maps.size() )
					{
						maps_description.maps.resize( index_s + 1s );
					}
					maps_description.maps[ index_s ]= move(m);
				}
			}

			auto index_str_opt= words_it.next();
			if( index_str_opt.empty() )
			{
				continue;
			}
			auto index_opt= ust::parse_integer_exact</u32/>( index_str_opt.try_deref() );
			if( index_opt.empty() )
			{
				continue;
			}

			current_map.reset( ust::make_tuple( index_opt.try_deref(), MapsDescription::MapDescription{} ) );
		}
		else if( first_word == "sciany" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			auto zmap_ant_file_name_opt= words_it.next();
			auto zvox_ant_file_name_opt= words_it.next();
			if( zmap_ant_file_name_opt.empty() || zvox_ant_file_name_opt.empty() )
			{
				continue;
			}

			current_map.try_deref()[1].wall_files[0]= ConvertStringToResourceString( zmap_ant_file_name_opt.try_deref() );
			current_map.try_deref()[1].wall_files[1]= ConvertStringToResourceString( zvox_ant_file_name_opt.try_deref() );
		}
		else if( first_word == "tekstury" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			if_var( &num_str : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( num_str ) )
				{
					current_map.try_deref()[1].materials_block= n;
				}
			}
		}
		else if( first_word == "pozycje" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			auto zpoz_ant_file_name_opt= words_it.next();
			if( zpoz_ant_file_name_opt.empty() )
			{
				continue;
			}

			current_map.try_deref()[1].positions_file= ConvertStringToResourceString( zpoz_ant_file_name_opt.try_deref() );

			// For now ignore number after this file - it seems to be always zero.
		}
		else if( first_word == "info_data" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if_var( &s : words_it.next() )
			{
				current_map.try_deref()[1].entities_info_file= ConvertStringToResourceString( s );
			}
		}
		else if( first_word == "model_nieba" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			if_var( s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( s ) )
				{
					current_map.try_deref()[1].sky_model= n;
				}
			}
		}
		else if( first_word == "opad" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			if_var( s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( s ) )
				{
					current_map.try_deref()[1].precipitation_kind= n;
				}
			}
		}
		else if( first_word == "kolory_nieba" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			auto &mut colors= current_map.try_deref()[1].sky_colors;

			for( auto mut i= 0s; i < 2s; ++i )
			{
				for( auto mut j= 0s; j < 3s; ++j )
				{
					if_var( &num_str : words_it.next() )
					{
						if_var( n : ust::parse_integer_exact</u32/>( num_str ) )
						{
							colors[i][j]= u8(n);
						}
					}
				}
			}
		}
		else if( first_word == "zamglenie_powietrze" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			auto &mut fog_color= current_map.try_deref()[1].fog_color;

			var size_type mut i_start= 0s;
			if_var( s : words_it.next() )
			{
				if( s != "=" )
				{
					if_var( n : ust::parse_integer_exact</u8/>( s ) )
					{
						fog_color[0]= n;
						++i_start;
					}
				}
			}

			for( auto mut i= i_start; i < 3s; ++i )
			{
				if_var( s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u8/>( s ) )
					{
						fog_color[i]= n;
					}
				}
			}
		}
		else if( first_word == "mgla_liniowa_dozwolona" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			if_var( s : words_it.next() )
			{
				if( s == "1" || s == "TRUE" )
				{
					current_map.try_deref()[1].linear_fog_enabled= true;
				}
				else if( s == "0" || s == "FALSE" )
				{
					current_map.try_deref()[1].linear_fog_enabled= false;
				}
			}
		}
		else if( first_word == "gatunek_gry" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if_var( &num_str : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( num_str ) )
				{
					current_map.try_deref()[1].game_mode= n;
				}
			}

			current_map.try_deref()[1].caption= ExtractSpaceSeparatedWords( words_it );
		}
		else if( first_word == "warunek" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			var MapsDescription::MapDescription &mut map_description= current_map.try_deref()[1];

			if_var( num_str : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</i32/>( num_str ) )
				{
					map_description.leave_condition[0]= n;
				}
			}

			if_var( num_str : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</i32/>( num_str ) )
				{
					map_description.leave_condition[1]= n;
				}
			}

			map_description.leave_condition[2]= ExtractSpaceSeparatedWords( words_it );
		}
		else if( first_word == "glos" )
		{
			if( current_map.empty() )
			{
				continue;
			}

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			var MapsDescription::MapDescription &mut map_description= current_map.try_deref()[1];

			if_var( num_str : words_it.next() )
			{
				if_var( sound_index : ust::parse_integer_exact</u32/>( num_str ) )
				{
					if( size_type( sound_index ) < typeinfo</ typeof( map_description.ambient_sound_files ) />.element_count )
					{
						var ResourceString &mut out_file_name= map_description.ambient_sound_files[ sound_index ];
						if_var( &file_name : words_it.next() )
						{
							out_file_name= ConvertStringToResourceString( file_name );
						}
					}
				}
			}
		}
		else if( first_word == "usun_zawartosc_kieszeni" )
		{
			if_var( &mut map_pair : current_map )
			{
				map_pair[1].reset_player_inventory= true;
			}
		}

		// TODO - read other properties.
	}

	if( !current_map.empty() )
	{
		auto [ index, mut m ]= current_map.try_take();
		var size_type index_s( index );

		if( index_s == 8000s )
		{
			// Map 8000 is broken and its index is too high for even storing it.
			move(m);
		}
		else if( index_s >= 64s )
		{
			ust::stdout_print( "Too high map number!\n" );
			move(m);
		}
		else if( index_s == maps_description.maps.size() )
		{
			maps_description.maps.push_back( move(m) );
		}
		else
		{
			if( index_s > maps_description.maps.size() )
			{
				maps_description.maps.resize( index_s + 1s );
			}
			maps_description.maps[ index_s ]= move(m);
		}
	}

	return maps_description;
}

} // namespace PM
