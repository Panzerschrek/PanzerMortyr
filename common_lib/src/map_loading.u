		}
	}
}

fn LoadZmapLemFile( ust::file_readable &mut f ) : ust::io_result</ZmapLemData/>
{
	var ZmapLemHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( false )
	{
		var ust::string8 mut m;
		m+= "ZMAP*.LEM header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( header.num2 );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num5 );
		m+= ", ";
		m+= ust::to_string8( header.num6 );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapLemData mut result;

	result.clusters_sky_light_data.resize( size_type( header.num_clusters ), ust::make_zeroed</ZmapLemClusterSkyLightData/>() );
	result_check_or_return( f.read_exact( result.clusters_sky_light_data.range().to_byte8_range() ) );

	return result;
}

fn LoadMapaWayFile( ust::filesystem_path_view file_path ) : ust::optional</MapaWayData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) ->
		{
			result_match( LoadMapaWayFile( f ) )
			{
				Ok( mut d ) -> { return move(d); },
				Err( e ) ->
				{
					ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
					return ust::null_optional;
				},
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadMapaWayFile( ust::file_readable &mut f ) : ust::io_result</MapaWayData/>
{
	var MapaWayFileHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( header.signature != MapaWayFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::io_error::other;
	}

	if( false )
	{
		var ust::string8 mut m;
		m+= "MAPA*.WAY header nums: ";
		m+= ust::to_string8( header.num_navigation_graphs );
		m+= ", ";
		m+= ust::to_string8( header.num2 );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num5 );
		m+= ", ";
		m+= ust::to_string8( header.num6 );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var MapaWayData mut result;

	result.navigation_graphs.resize( size_type( header.num_navigation_graphs ), ust::make_zeroed</MapaWayNavigationGraph/>() );
	result_check_or_return( f.read_exact( result.navigation_graphs.range().to_byte8_range() ) );

	if( false )
	{
		foreach( &graph : result.navigation_graphs )
		{
			var size_type num_elements( graph.num_nodes );

			ust::stdout_print( ust::concat( "MAPA.WAY graph num elements is ", ust::to_string8( num_elements ), "\n" ) );

			var i32 mut min= 0x7FFFFFFF, mut max= -0x7FFFFFFF;
			for( auto mut y= 0s; y < num_elements; ++y )
			{
				for( auto mut x= 0s; x < num_elements; ++x )
				{
					var i32 x( graph.routing_matrix[y][x] );
					ust::min_assign( min, x );
					ust::max_assign( max, x );
				}
			}
			ust::stdout_print( ust::concat( "MAPA.WAY routing matrix values are in range ", ust::to_string8(min), " to ", ust::to_string8(max), "\n" ) );
		}
	}

	if( false )
	{
		var size_type mut num_nodes= 0s;
		foreach( &graph : result.navigation_graphs )
		{
			num_nodes+= size_type( graph.num_nodes );
		}
		ust::stdout_print( ust::concat( "MAPA*.WAY total nodes: ", ust::to_string8(num_nodes), "\n" ) );
	}

	return result;
}

var size_type constexpr c_map29_num_clusters= 171s;
var size_type constexpr c_map29_first_elevator_cluster_index= 4s;
var size_type constexpr c_map29_last_elevator_cluster_index= 15s;

var size_type constexpr c_map33_num_quads= 4663s;

} // namespace PM
