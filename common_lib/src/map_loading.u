import "/enum_string_conversions.iu"
import "/stdout.iu"
import "/string.iu"
import "/string_conversions.iu"
import "/common_lib/map_loading.iu"

namespace PM
{

fn GetZmapLamFileName( u32 map_index ) : ResourceString
{
	var ResourceString mut res= "ZMAP00.LAM\0\0";
	res[4]= char8( u32('0') + map_index / 10u % 10u );
	res[5]= char8( u32('0') + map_index /  1u % 10u );
	return res;
}

fn GetZmapLemFileName( u32 map_index ) : ResourceString
{
	var ResourceString mut res= "ZMAP00.LEM\0\0";
	res[4]= char8( u32('0') + map_index / 10u % 10u );
	res[5]= char8( u32('0') + map_index /  1u % 10u );
	return res;
}

fn GetMapaWayFileName( u32 map_index ) : ResourceString
{
	var ResourceString mut res= "MAPA000.WAY\0";
	res[4]= char8( u32('0') + map_index / 100u % 10u );
	res[5]= char8( u32('0') + map_index /  10u % 10u );
	res[6]= char8( u32('0') + map_index /   1u % 10u );
	return res;
}

fn LoadMap(
	ust::filesystem_path_view zmap_file_path,
	ust::filesystem_path_view zvox_file_path,
	ust::filesystem_path_view zpoz_file_path,
	ust::filesystem_path_view zmap_lam_file_path,
	ust::filesystem_path_view zmap_lem_file_path,
	ust::filesystem_path_view mapa_way_file_path ) : ust::optional</MapData/>
{

	auto mut zvox_data= LoadZvoxFile( zvox_file_path );
	if( zvox_data.empty() )
	{
		return ust::null_optional;
	}
	var size_type num_clusters= zvox_data.try_deref().clusters.size();

	auto mut zmap_data= LoadZmapFile( zmap_file_path, zvox_data.try_deref() );

	auto mut zpoz_data= LoadZpozFile( zpoz_file_path );
	auto mut zmap_lam_data= LoadZmapLamFile( zmap_lam_file_path, num_clusters );
	auto mut zmap_lem_data= LoadZmapLemFile( zmap_lem_file_path );
	auto mut mapa_way_data= LoadMapaWayFile( mapa_way_file_path );

	if( zmap_data.empty() || zvox_data.empty() || zpoz_data.empty() )
	{
		return ust::null_optional;
	}

	var MapData mut map_data
	{
		.zmap= zmap_data.try_take(),
		.zvox= zvox_data.try_take(),
		.zpoz= zpoz_data.try_take(),
	};

	if( !zmap_lam_data.empty() )
	{
		map_data.zmap_lam= zmap_lam_data.try_take();
	}

	if( !zmap_lem_data.empty() )
	{
		map_data.zmap_lem= zmap_lem_data.try_take();
	}

	if( !mapa_way_data.empty() )
	{
		map_data.mapa_way= mapa_way_data.try_take();
	}

	return map_data;
}

fn LoadZmapFile( ust::filesystem_path_view file_path, ZvoxData& zvox_data ) : ust::optional</ZmapData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) ->
		{
			result_match( LoadZmapFile( f, zvox_data ) )
			{
				Ok( mut d ) -> { return move(d); },
				Err(e) ->
				{
					ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
					return ust::null_optional;
				}
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZmapFile( ust::file_readable &mut f, ZvoxData& zvox_data ) : ust::io_result</ZmapData/>
{
	var ZMapFileHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( header.signature != ZMapFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::io_error::other;
	}

	if( false )
	{
		var ust::string8 mut m;
		m+= "ZMAP header nums: ";
		m+= ust::to_string8( header.num_quads );
		m+= ", ";
		m+= ust::to_string8( header.unknown8 );
		m+= ", ";
		m+= ust::to_string8( header.num_light_shaft_boxes );
		m+= ", ";
		m+= ust::to_string8( header.unknown16 );
		m+= ", ";
		m+= ust::to_string8( header.unknown20 );
		m+= ", ";
		m+= ust::to_string8( header.unknown24 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapData mut result;

	result.quads.resize( size_type( header.num_quads ), ust::make_zeroed</ZmapQuad/>() );
	result_check_or_return( f.read_exact( result.quads.range().to_byte8_range() ) );

	result.light_shaft_boxes.resize( size_type( header.num_light_shaft_boxes ), ust::make_zeroed</ZmapLightShaftsBox/>() );
	result_check_or_return( f.read_exact( result.light_shaft_boxes.range().to_byte8_range() ) );

	// HACK!
	// On map 33 there is a wall blocking player's movement towards the map's exit.
	// The original game allows passing it, but only in one way.
	// But in PanzerMortyr physics works differently from the original and thus passing this wall is impossible.
	// So, detect this wall and correct coordinates of one of its sides.
	if( result.quads.size() == c_map33_num_quads )
	{
		var ZmapQuad &mut quad= result.quads[ 2446s ];

		if( quad.texture_id == 84u16 &&
			quad.center == ust::make_array( 704i16, -3024i16, -136i16 ) &&
			quad.bounding_box_half_size == ust::make_array( 340i16, 20i16, 156i16 )  )
		{
			var i16 fix_x= -192i16;
			quad.vertices[0][0]= fix_x;
			quad.vertices[3][0]= fix_x;
		}
	}

	// HACK!
	// On map 33 there is a secret area accessible via a water passage.
	// But due to the way how physics in PanzerMortyr works, it's impossible to leave water in this area.
	// Slightly modify quads of the area around the water pit, so that jumping out of water is possible.
	if( result.quads.size() == c_map33_num_quads )
	{
		{
			var ZmapQuad &mut quad= result.quads[ 1724s ];
			if( quad.vertices[0][0] == 60i16 && quad.vertices[3][0] == 64i16 )
			{
				quad.vertices[0][0]= 54i16;
				quad.vertices[3][0]= 58i16;
			}
		}
		{
			var ZmapQuad &mut quad= result.quads[ 1725s ];
			if( quad.vertices[0][1] == -96i16 && quad.vertices[1][1] == -96i16 )
			{
				quad.vertices[0][1]= -90i16;
				quad.vertices[1][1]= -90i16;
			}
		}
		{
			var ZmapQuad &mut quad= result.quads[ 1726s ];
			if( quad.vertices[1][0] == -84i16 && quad.vertices[2][0] == -92i16 )
			{
				quad.vertices[1][0]= -78i16;
				quad.vertices[2][0]= -86i16;
			}
		}
		{
			var ZmapQuad &mut quad= result.quads[ 1727s ];
			if( quad.vertices[2][1] == 44i16 && quad.vertices[3][1] == 56i16 )
			{
				quad.vertices[2][1]= 38i16;
				quad.vertices[3][1]= 50i16;
			}
		}
	}

	// HACK!
	// Fix coordinates of map end elevator quads belonging to elevator clusters combined to one.
	if( zvox_data.clusters.size() == c_map29_num_clusters )
	{
		var ZvoxCluster& first_elevator_cluster= zvox_data.clusters[ c_map29_first_elevator_cluster_index ];

		for( auto mut q= first_elevator_cluster.c.first_quad_index;
			q < first_elevator_cluster.c.first_quad_index + u32( first_elevator_cluster.num_quads );
			++q )
		{
			var [ i32, 3 ] mut quad_center= zero_init;

			var ZmapQuad &mut quad= result.quads[ size_type(q) ];
			{
				auto& v= quad.vertices;

				var [ i32, 3 ] quad_bbox_min
				[
					( ust::min( ust::min( v[0][0], v[1][0] ), ust::min( v[2][0], v[3][0] ) ) ),
					( ust::min( ust::min( v[0][1], v[1][1] ), ust::min( v[2][1], v[3][1] ) ) ),
					( ust::min( ust::min( v[0][2], v[1][2] ), ust::min( v[2][2], v[3][2] ) ) ),
				];
				var [ i32, 3 ] quad_bbox_max
				[
					( ust::max( ust::max( v[0][0], v[1][0] ), ust::max( v[2][0], v[3][0] ) ) ),
					( ust::max( ust::max( v[0][1], v[1][1] ), ust::max( v[2][1], v[3][1] ) ) ),
					( ust::max( ust::max( v[0][2], v[1][2] ), ust::max( v[2][2], v[3][2] ) ) ),
				];

				quad_center[0]= ( quad_bbox_min[0] + quad_bbox_max[0] ) / 2;
				quad_center[1]= ( quad_bbox_min[1] + quad_bbox_max[1] ) / 2;
				quad_center[2]= ( quad_bbox_min[2] + quad_bbox_max[2] ) / 2;
			}

			var [ i32, 3 ] relative_offset
			[
				i32( quad.center[0] ) - quad_center[0] - first_elevator_cluster.c.center[0],
				i32( quad.center[1] ) - quad_center[1] - first_elevator_cluster.c.center[1],
				i32( quad.center[2] ) - quad_center[2] - first_elevator_cluster.c.center[2],
			];

			foreach( &mut v : quad.vertices )
			{
				v[0]= i16( i32( v[0] ) + relative_offset[0] );
				v[1]= i16( i32( v[1] ) + relative_offset[1] );
				v[2]= i16( i32( v[2] ) + relative_offset[2] );
			}
		}
	}

	return result;
}

fn LoadZvoxFile( ust::filesystem_path_view file_path ) : ust::optional</ZvoxData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) ->
		{
			result_match( LoadZvoxFile( f ) )
			{
				Ok( mut d ) -> { return move(d); },
				Err(e) ->
				{
					ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
					return ust::null_optional;
				}
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZvoxFile( ust::file_readable &mut f ) : ust::io_result</ZvoxData/>
{
	var ZVoxFileHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( header.signature != ZVoxFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::io_error::other;
	}

	if( false )
	{
		var ust::string8 mut m;
		m+= "ZVOX header nums: ";
		m+= ust::to_string8( header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( header.unknown8 );
		m+= ", ";
		m+= ust::to_string8( header.num_light_sources );
		m+= ", ";
		m+= ust::to_string8( header.num_dynamic_cluster_extra_infos );
		m+= ", ";
		m+= ust::to_string8( header.num_trigger_volumes );
		m+= ", ";
		m+= ust::to_string8( header.num_fog_volumes );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZvoxData mut result;

	result.fog_volumes.resize( size_type( header.num_fog_volumes ), ust::make_zeroed</ZvoxFogVolume/>() );
	result_check_or_return( f.read_exact( result.fog_volumes.range().to_byte8_range() ) );

	result.trigger_volumes.resize( size_type( header.num_trigger_volumes ), ust::make_zeroed</ZvoxTriggerVolume/>() );
	result_check_or_return( f.read_exact( result.trigger_volumes.range().to_byte8_range() ) );

	result.dynamic_cluster_extra_infos.resize( size_type( header.num_dynamic_cluster_extra_infos ), ust::make_zeroed</ZvoxDynamicClusterExtraInfo/>() );
	result_check_or_return( f.read_exact( result.dynamic_cluster_extra_infos.range().to_byte8_range() ) );

	result.clusters.resize( size_type( header.num_clusters ), ust::make_zeroed</ZvoxCluster/>() );
	result_check_or_return( f.read_exact( result.clusters.range().to_byte8_range() ) );

	result.light_sources.resize( size_type( header.num_light_sources ), ust::make_zeroed</ZvoxLightSource/>() );
	result_check_or_return( f.read_exact( result.light_sources.range().to_byte8_range() ) );

	result.per_cluster_nums.resize( size_type( header.num_clusters ), 0u );
	result_check_or_return( f.read_exact( result.per_cluster_nums.range().to_byte8_range() ) );

	// HACK!
	// There is a cluster on map 29, which is too short and doesn't contact the cluster below it as it should.
	// This leads to broken visibility calculations in area near it.
	// So, extend it slightly downwards.
	if( result.clusters.size() == c_map29_num_clusters )
	{
		var ZvoxCluster &mut cluster= result.clusters[ 16s ];

		if( cluster.c.center == ust::make_array( 688, -816, -136 ) &&
			cluster.c.bounding_box_half_size == ust::make_array( 320, 320, 248 ) )
		{
			cluster.c.center[2]+= 32;
			cluster.c.bounding_box_half_size[2]+= 32;
		}
	}

	// HACK!
	// Combining clusters of the map end elevator together.
	// Otherwise it works poorly.
	// They may block each other if the player is located inside.
	// Sounds are also emitted for each such clusters, which we want to avoid.
	if( result.clusters.size() == c_map29_num_clusters )
	{
		var bool mut has_consecutive_quads= true;
		var bool mut has_equal_type= true;
		var bool mut has_equal_move_distance= true;

		{
			var ZvoxCluster& first_elevator_cluster= result.clusters[ c_map29_first_elevator_cluster_index ];

			var u32 mut last_quad_index= first_elevator_cluster.c.first_quad_index;

			for( auto mut i= c_map29_first_elevator_cluster_index; i <= c_map29_last_elevator_cluster_index; ++i )
			{
				var ZvoxCluster& cluster= cast_imut( result.clusters )[i];

				has_consecutive_quads &= cluster.c.first_quad_index == last_quad_index;
				last_quad_index= cluster.c.first_quad_index + u32( cluster.num_quads );

				has_equal_type &= cluster.cluster_type == first_elevator_cluster.cluster_type;
				has_equal_move_distance &= cluster.light_sources_begin == first_elevator_cluster.light_sources_begin;
			}
		}

		if( has_consecutive_quads && has_equal_type && has_equal_move_distance )
		{
			var ZvoxCluster mut first_elevator_cluster= result.clusters[ c_map29_first_elevator_cluster_index ];

			// Calculate combined bbox.

			var [ i32, 3 ]
				mut bbox_min
				[
					first_elevator_cluster.c.center[0] - first_elevator_cluster.c.bounding_box_half_size[0],
					first_elevator_cluster.c.center[1] - first_elevator_cluster.c.bounding_box_half_size[1],
					first_elevator_cluster.c.center[2] - first_elevator_cluster.c.bounding_box_half_size[2],
				],
				mut bbox_max
				[
					first_elevator_cluster.c.center[0] + first_elevator_cluster.c.bounding_box_half_size[0],
					first_elevator_cluster.c.center[1] + first_elevator_cluster.c.bounding_box_half_size[1],
					first_elevator_cluster.c.center[2] + first_elevator_cluster.c.bounding_box_half_size[2],
				];

			for( auto mut i= c_map29_first_elevator_cluster_index; i <= c_map29_last_elevator_cluster_index; ++i )
			{
				var ZvoxCluster& cluster= result.clusters[i];
				ust::min_assign( bbox_min[0], cluster.c.center[0] - cluster.c.bounding_box_half_size[0] );
				ust::min_assign( bbox_min[1], cluster.c.center[1] - cluster.c.bounding_box_half_size[1] );
				ust::min_assign( bbox_min[2], cluster.c.center[2] - cluster.c.bounding_box_half_size[2] );
				ust::max_assign( bbox_max[0], cluster.c.center[0] + cluster.c.bounding_box_half_size[0] );
				ust::max_assign( bbox_max[1], cluster.c.center[1] + cluster.c.bounding_box_half_size[1] );
				ust::max_assign( bbox_max[2], cluster.c.center[2] + cluster.c.bounding_box_half_size[2] );
			}

			var [ i32, 3 ] bbox_center
			[
				( ( bbox_min[0] + bbox_max[0] ) >> 1 ),
				( ( bbox_min[1] + bbox_max[1] ) >> 1 ),
				( ( bbox_min[2] + bbox_max[2] ) >> 1 ),
			];

			var [ i32, 3 ] bbox_half_size
			[
				ust::max( bbox_center[0] - bbox_min[0], bbox_max[0] - bbox_center[0] ),
				ust::max( bbox_center[1] - bbox_min[1], bbox_max[1] - bbox_center[1] ),
				ust::max( bbox_center[2] - bbox_min[2], bbox_max[2] - bbox_center[2] ),
			];

			first_elevator_cluster.c.center= bbox_center;
			first_elevator_cluster.c.bounding_box_half_size= bbox_half_size;

			// Combine all quads of elevator clusters into quads of the first elevator cluster.

			var ZvoxCluster last_elevator_cluster= result.clusters[ c_map29_last_elevator_cluster_index ];

			var u32 last_quad= last_elevator_cluster.c.first_quad_index + u32( last_elevator_cluster.num_quads );

			first_elevator_cluster.num_quads= i32( last_quad - first_elevator_cluster.c.first_quad_index );

			result.clusters[ c_map29_first_elevator_cluster_index ]= move( first_elevator_cluster );

			// Turn remaining elevator clusters into regular ones and remove all quads.
			for( auto mut i= c_map29_first_elevator_cluster_index + 1s; i <= c_map29_last_elevator_cluster_index; ++i )
			{
				var ZvoxCluster &mut cluster= result.clusters[i];
				cluster.num_quads= 0;
				cluster.cluster_type= ZvoxCluster::c_cluster_type_regular;
			}
		}
	}

	return result;
}

fn LoadZpozFile( ust::filesystem_path_view file_path ) : ust::optional</ZpozData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) ->
		{
			result_match( LoadZpozFile( f ) )
			{
				Ok( mut d ) -> { return move(d); },
				Err( e ) ->
				{
					ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
					return ust::null_optional;
				},
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZpozFile( ust::file_readable &mut f ) : ust::io_result</ZpozData/>
{
	var ZPozFileHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( header.signature != ZPozFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::io_error::other;
	}

	if( false )
	{
		var ust::string8 mut m;
		m+= "ZPOZ header nums: ";
		m+= ust::to_string8( header.num_entities );
		m+= ", ";
		m+= ust::to_string8( header.num_entity_navigation_infos );
		m+= ", ";
		m+= ust::to_string8( header.num_multiplayer_spawn_points );
		m+= ", ";
		m+= ust::to_string8( header.unknown16 );
		m+= ", ";
		m+= ust::to_string8( header.unknown20 );
		m+= ", ";
		m+= ust::to_string8( header.unknown24 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZpozData mut result;

	result.entities.resize( size_type( header.num_entities ), ust::make_zeroed</ZpozEntity/>() );
	result_check_or_return( f.read_exact( result.entities.range().to_byte8_range() ) );

	result.entity_navigation_infos.resize( size_type( header.num_entity_navigation_infos ), ust::make_zeroed</ZpozEntityNavigationInfo/>() );
	result_check_or_return( f.read_exact( result.entity_navigation_infos.range().to_byte8_range() ) );

	result.multiplayer_spawn_points.resize( size_type(  header.num_multiplayer_spawn_points ), ust::make_zeroed</ZpozMultiplayerSpawnPoint/>() );
	result_check_or_return( f.read_exact( result.multiplayer_spawn_points.range().to_byte8_range() ) );

	var ZPozIntermediateHeader mut intermediate_header= zero_init;

	result_match( f.read_exact( ust::single_element_array_view( intermediate_header ).to_byte8_range() ) )
	{
		Ok(v) -> { ust::ignore_unused(v); },
		Err(e) ->
		{
			// If we got end of file - just ignore the rest.
			// TODO - fix this in case of reading archive file.
			if( e == ust::io_error::unexpected_end_of_file )
			{
				return result;
			}
			return e;
		}
	}

	if( false )
	{
		var ust::string8 mut m;
		m+= "ZPOZ intermediate header nums: ";
		m+= ust::to_string8( intermediate_header.num0 );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num_visibility_info_ints );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( intermediate_header.num2 );
		m+= "\n";
		ust::stdout_print( m );
	}

	result.clusters.resize( size_type( intermediate_header.num_clusters ), ust::make_zeroed</ZpozCluster/>() );
	result_check_or_return( f.read_exact( result.clusters.range().to_byte8_range() ) );

	result.clusters_visibility_data.resize( size_type( intermediate_header.num_clusters ), ust::make_zeroed</ZpozClusterVisibilityData/>() );
	result_check_or_return( f.read_exact( result.clusters_visibility_data.range().to_byte8_range() ) );

	{
		var size_type num_cluster_indices=
			size_type( intermediate_header.num_visibility_info_ints ) -
			size_type( intermediate_header.num_clusters ) * ( typeinfo</ZpozClusterVisibilityData/>.size_of / typeinfo</u32/>.size_of );

		result.cluster_indices.resize( num_cluster_indices, ust::make_zeroed</ZPozClusterIndex/>() );
		result_check_or_return( f.read_exact( result.cluster_indices.range().to_byte8_range() ) );
	}

	// HACK!
	// There is a cluster on map 29, which is too short and doesn't contact the cluster below it as it should.
	// This leads to broken visibility calculations in area near it.
	// So, extend it slightly downwards.
	if( result.clusters.size() == 171s )
	{
		var ZpozCluster &mut cluster= result.clusters[ 16s ];

		if( cluster.center == ust::make_array( 688, -816, -136 ) &&
			cluster.bounding_box_half_size == ust::make_array( 320, 320, 248 ) )
		{
			cluster.center[2]+= 32;
			cluster.bounding_box_half_size[2]+= 32;
		}
	}

	return result;
}

fn LoadZmapLamFile( ust::filesystem_path_view file_path, size_type num_clusters ) : ust::optional</ZmapLamData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) ->
		{
			result_match( LoadZmapLamFile( f, num_clusters ) )
			{
				Ok( mut d ) -> { return move(d); },
				Err( e ) ->
				{
					ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
					return ust::null_optional;
				}
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZmapLamFile( ust::file_readable &mut f, size_type num_clusters ) : ust::io_result</ZmapLamData/>
{
	var ZmapLamHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( false )
	{
		var ust::string8 mut m;
		m+= "ZMAP*.LAM header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num_tessellated_quads );
		m+= ", ";
		m+= ust::to_string8( header.tessellated_quads_data_size );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num_rain_droplets );
		m+= ", ";
		m+= ust::to_string8( header.clusters_rain_visibility_data_size );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapLamData mut result;

	result.tessellated_quads.resize( size_type( header.num_tessellated_quads ), ust::make_zeroed</ZmapLamTesselaltedQuad/>() );
	result_check_or_return( f.read_exact( result.tessellated_quads.range().to_byte8_range() ) );

	result.tessellated_quads_data.resize( size_type( header.tessellated_quads_data_size ), ust::make_zeroed</ZmapLamTessellatedQuadsData/>() );
	result_check_or_return( f.read_exact( result.tessellated_quads_data.range().to_byte8_range() ) );

	if( header.num_rain_droplets > 0u )
	{
		result.rain_droplets.resize( size_type( header.num_rain_droplets ), ust::make_zeroed</ZmapLamRainDroplet/>() );
		result_check_or_return( f.read_exact( result.rain_droplets.range().to_byte8_range() ) );

		result.clusters_rain_info.resize( num_clusters, ust::make_zeroed</ZmapLamClusterRainInfo/>() );
		result_check_or_return( f.read_exact( result.clusters_rain_info.range().to_byte8_range() ) );

		result.clusters_rain_visibility_data.resize( size_type( header.clusters_rain_visibility_data_size ), 0u );
		result_check_or_return( f.read_exact( result.clusters_rain_visibility_data.range().to_byte8_range() ) );
	}

	return result;
}

fn LoadZmapLemFile( ust::filesystem_path_view file_path ) : ust::optional</ZmapLemData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
