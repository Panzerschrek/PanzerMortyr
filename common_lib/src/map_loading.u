fn LoadZmapLamFile( ust::file_readable &mut f ) : ust::io_result</ZmapLamData/>
{
	var ZmapLamHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	{
		var ust::string8 mut m;
		m+= "ZMAP*.LAM header nums: ";
		m+= ust::to_string8( header.num0 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs0 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs1 );
		m+= ", ";
		m+= ust::to_string8( header.num3 );
		m+= ", ";
		m+= ust::to_string8( header.num4 );
		m+= ", ";
		m+= ust::to_string8( header.num_structs2 );
		m+= ", ";
		m+= ust::to_string8( header.num6 );
		m+= ", ";
		m+= ust::to_string8( header.num7 );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapLamData mut result;

	result.structs0.resize( size_type( header.num_structs0 ), ust::make_zeroed</ZmapLamStruct0/>() );
	result_check_or_return( f.read_exact( result.structs0.range().to_byte8_range() ) );

	result.structs1.resize( size_type( header.num_structs1 ), ust::make_zeroed</ZmapLamStruct1/>() );
	result_check_or_return( f.read_exact( result.structs1.range().to_byte8_range() ) );

	result.structs2.resize( size_type( header.num_structs2 ), ust::make_zeroed</ZmapLamStruct2/>() );
	result_check_or_return( f.read_exact( result.structs2.range().to_byte8_range() ) );

	// There is some data still left - at least several kilobytes. It's at least one more block.

	if( false )
	{
		auto mut structs0_copy= result.structs0;
		ust::sort_by_key( structs0_copy, lambda( ZmapLamStruct0& s ) : i32 { return s.data[0]; } );

		for( auto mut i = 0s; i + 1s < structs0_copy.size(); ++i )
		{
			var i32 count= structs0_copy[i + 1s].data[0] - structs0_copy[i].data[0];
			ust::stdout_print( ust::concat( "Quad ", ust::to_string8(i), " num is ", ust::to_string8( structs0_copy[i].data[1] ), " count is ", ust::to_string8(count), "\n" ) );

			for( auto mut j= 0; j < count; ++j )
			{
				auto& s= result.structs1[ size_type( structs0_copy[i].data[0] + j ) ];
				ust::stdout_print( ust::concat( ust::to_string8( i32(s.data) ), ", " ) );
			}
			ust::stdout_print( "\n" );
		}

		var f32 mut min_coord= 1.0e24f, mut max_coord= -1.0e24f;
		var f32 mut min_coord3= 1.0e24f, mut max_coord3= -1.0e24f;
		var f32 mut min_coord4= 1.0e24f, mut max_coord4= -1.0e24f;
		var f32 mut min_coord5= 1.0e24f, mut max_coord5= -1.0e24f;
		var i32 mut min_index= 0x7FFFFFFF, mut max_index= -0x7FFFFFFF;

		for( auto mut i = 20s; i + 1s < structs0_copy.size(); ++i )
		{
			var i32 header_count= structs0_copy[i].data[1];
			var i32 count= structs0_copy[i + 1s].data[0] - structs0_copy[i].data[0];

			for( var i32 mut j= 0; j < header_count; ++j )
			{
				auto& sx= cast_imut(result).structs1[ size_type( structs0_copy[i].data[0] + j * 6 + 0 ) ];
				auto& sy= cast_imut(result).structs1[ size_type( structs0_copy[i].data[0] + j * 6 + 1 ) ];
				auto& sz= cast_imut(result).structs1[ size_type( structs0_copy[i].data[0] + j * 6 + 2 ) ];
				auto& s3= cast_imut(result).structs1[ size_type( structs0_copy[i].data[0] + j * 6 + 3 ) ];
				auto& s4= cast_imut(result).structs1[ size_type( structs0_copy[i].data[0] + j * 6 + 4 ) ];
				auto& s5= cast_imut(result).structs1[ size_type( structs0_copy[i].data[0] + j * 6 + 5 ) ];

				var f32 x( sx.data );
				var f32 y( sy.data );
				var f32 z( sz.data );
				var f32 v3( s3.data );
				var f32 v4( s4.data );
				var f32 v5( s5.data );

				ust::min_assign( min_coord, x );
				ust::max_assign( max_coord, x );
				ust::min_assign( min_coord, y );
				ust::max_assign( max_coord, y );
				ust::min_assign( min_coord, z );
				ust::max_assign( max_coord, z );
				ust::min_assign( min_coord3, v3 );
				ust::max_assign( max_coord3, v3 );
				ust::min_assign( min_coord4, v4 );
				ust::max_assign( max_coord4, v4 );
				ust::min_assign( min_coord5, v5 );
				ust::max_assign( max_coord5, v5 );
			}

			for( var i32 mut j= header_count * 6; j < count; ++j )
			{
				auto& s= result.structs1[ size_type( structs0_copy[i].data[0] + j ) ];
				var i32 index( s.data );
				ust::min_assign( min_index, index );
				ust::max_assign( max_index, index );
			}
		}

		ust::stdout_print( ust::concat( "ZMAP LAM per-quad coords are in range ", ust::to_string8( i32(min_coord * 1000.0f ) ), " to ", ust::to_string8( i32( max_coord * 1000.0f ) ), "\n" ) );
		ust::stdout_print( ust::concat( "ZMAP LAM per-quad coords3 are in range ", ust::to_string8( i32(min_coord3 * 1000.0f ) ), " to ", ust::to_string8( i32( max_coord3 * 1000.0f ) ), "\n" ) );
		ust::stdout_print( ust::concat( "ZMAP LAM per-quad coords4 are in range ", ust::to_string8( i32(min_coord4 * 1000.0f ) ), " to ", ust::to_string8( i32( max_coord4 * 1000.0f ) ), "\n" ) );
		ust::stdout_print( ust::concat( "ZMAP LAM per-quad coords5 are in range ", ust::to_string8( i32(min_coord5 * 1000.0f ) ), " to ", ust::to_string8( i32( max_coord5 * 1000.0f ) ), "\n" ) );
		ust::stdout_print( ust::concat( "ZMAP LAM per-quad indices are in range ", ust::to_string8(min_index), " to ", ust::to_string8(max_index), "\n" ) );
	}

	return result;
}

