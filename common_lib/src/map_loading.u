import "/enum_string_conversions.u"
import "/stdout.u"
import "/string.u"
import "/string_conversions.u"
import "/common_lib/map_loading.uh"

namespace PM
{

fn GetZmapLamFileName( u32 map_index ) : ResourceString
{
	var ResourceString mut res= "ZMAP00.LAM\0\0\0\0\0\0";
	res[4]= char8( u32('0') + map_index / 10u % 10u );
	res[5]= char8( u32('0') + map_index /  1u % 10u );
	return res;
}

fn GetZmapLemFileName( u32 map_index ) : ResourceString
{
	var ResourceString mut res= "ZMAP00.LEM\0\0\0\0\0\0";
	res[4]= char8( u32('0') + map_index / 10u % 10u );
	res[5]= char8( u32('0') + map_index /  1u % 10u );
	return res;
}

fn GetMapaWayFileName( u32 map_index ) : ResourceString
{
	var ResourceString mut res= "MAPA000.WAY\0\0\0\0\0";
	res[4]= char8( u32('0') + map_index / 100u % 10u );
	res[5]= char8( u32('0') + map_index /  10u % 10u );
	res[6]= char8( u32('0') + map_index /   1u % 10u );
	return res;
}

fn LoadMap(
	ust::filesystem_path_view zmap_file_path,
	ust::filesystem_path_view zvox_file_path,
	ust::filesystem_path_view zpoz_file_path,
	ust::filesystem_path_view zmap_lam_file_path,
	ust::filesystem_path_view zmap_lem_file_path,
	ust::filesystem_path_view mapa_way_file_path ) : ust::optional</MapData/>
{
	auto mut zmap_data= LoadZmapFile( zmap_file_path );

	auto mut zvox_data= LoadZvoxFile( zvox_file_path );
	if( zvox_data.empty() )
	{
		return ust::null_optional;
	}
	var size_type num_clusters= zvox_data.try_deref().clusters.size();

	auto mut zpoz_data= LoadZpozFile( zpoz_file_path );
	auto mut zmap_lam_data= LoadZmapLamFile( zmap_lam_file_path, num_clusters );
	auto mut zmap_lem_data= LoadZmapLemFile( zmap_lem_file_path );
	auto mut mapa_way_data= LoadMapaWayFile( mapa_way_file_path );

	if( zmap_data.empty() || zvox_data.empty() || zpoz_data.empty() )
	{
		return ust::null_optional;
	}

	var MapData mut map_data
	{
		.zmap= zmap_data.try_take(),
		.zvox= zvox_data.try_take(),
		.zpoz= zpoz_data.try_take(),
	};

	if( !zmap_lam_data.empty() )
	{
		map_data.zmap_lam= zmap_lam_data.try_take();
	}

	if( !zmap_lem_data.empty() )
	{
		map_data.zmap_lem= zmap_lem_data.try_take();
	}

	if( !mapa_way_data.empty() )
	{
		map_data.mapa_way= mapa_way_data.try_take();
	}

	return map_data;
}

fn LoadZmapFile( ust::filesystem_path_view file_path ) : ust::optional</ZmapData/>
{
	result_match( ust::file_readable::open( file_path ) )
	{
		Ok( mut f ) ->
		{
			result_match( LoadZmapFile( f ) )
			{
				Ok( mut d ) -> { return move(d); },
				Err(e) ->
				{
					ust::stderr_print( ust::concat( "Error reading map file: ", ust::enum_to_string( e ), "\n" ) );
					return ust::null_optional;
				}
			}
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error opening file: ", ust::enum_to_string( e ), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn LoadZmapFile( ust::file_readable &mut f ) : ust::io_result</ZmapData/>
{
	var ZMapFileHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( header.signature != ZMapFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::io_error::other;
	}

	{
		var ust::string8 mut m;
		m+= "ZMAP header nums: ";
		m+= ust::to_string8( header.num_quads );
		m+= ", ";
		m+= ust::to_string8( header.presumable_some_other_num );
		m+= ", ";
		m+= ust::to_string8( header.num_light_shaft_boxes );
		m+= ", ";
		m+= ust::to_string8( header.data[0] );
		m+= ", ";
		m+= ust::to_string8( header.data[1] );
		m+= ", ";
		m+= ust::to_string8( header.data[2] );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZmapData mut result;

	result.quads.resize( size_type( header.num_quads ), ust::make_zeroed</ZmapQuad/>() );
	result_check_or_return( f.read_exact( result.quads.range().to_byte8_range() ) );

	result.light_shaft_boxes.resize( size_type( header.num_light_shaft_boxes ), ust::make_zeroed</ZmapLightShaftsBox/>() );
	result_check_or_return( f.read_exact( result.light_shaft_boxes.range().to_byte8_range() ) );

	return result;
}

