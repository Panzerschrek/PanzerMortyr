fn LoadZvoxFile( ust::file_readable &mut f ) : ust::io_result</ZvoxData/>
{
	var ZVoxFileHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( header.signature != ZVoxFileHeader::c_expected_signature )
	{
		ust::stderr_print( ust::concat( "Unexpected file signature \"", header.signature, "\"!" ) );
		return ust::io_error::other;
	}

	{
		var ust::string8 mut m;
		m+= "ZVOX header nums: ";
		m+= ust::to_string8( header.num_clusters );
		m+= ", ";
		m+= ust::to_string8( header.num1 );
		m+= ", ";
		m+= ust::to_string8( header.num_light_sources );
		m+= ", ";
		m+= ust::to_string8( header.num_structs1 );
		m+= ", ";
		m+= ust::to_string8( header.num_trigger_volumes );
		m+= ", ";
		m+= ust::to_string8( header.num_fog_volumes );
		m+= "\n";
		ust::stdout_print( m );
	}

	var ZvoxData mut result;

	result.fog_volumes.resize( size_type( header.num_fog_volumes ), ust::make_zeroed</ZvoxFogVolume/>() );
	result_check_or_return( f.read_exact( result.fog_volumes.range().to_byte8_range() ) );

	result.trigger_volumes.resize( size_type( header.num_trigger_volumes ), ust::make_zeroed</ZvoxTriggerVolume/>() );
	result_check_or_return( f.read_exact( result.trigger_volumes.range().to_byte8_range() ) );

	result.structs1.resize( size_type( header.num_structs1 ), ust::make_zeroed</ZvoxStruct1/>() );
	result_check_or_return( f.read_exact( result.structs1.range().to_byte8_range() ) );

	result.clusters.resize( size_type( header.num_clusters ), ust::make_zeroed</ZvoxCluster/>() );
	result_check_or_return( f.read_exact( result.clusters.range().to_byte8_range() ) );

	result.light_sources.resize( size_type( header.num_light_sources ), ust::make_zeroed</ZvoxLightSource/>() );
	result_check_or_return( f.read_exact( result.light_sources.range().to_byte8_range() ) );

	result.per_cluster_nums.resize( size_type( header.num_clusters ), ust::make_zeroed</ u32 />() );
	result_check_or_return( f.read_exact( result.per_cluster_nums.range().to_byte8_range() ) );

	return result;
}

