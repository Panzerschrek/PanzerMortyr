import "/enum_string_conversions.u"
import "/file_helpers.u"
import "/integer_parsing.u"
import "/path_utils.u"
import "/stdout.u"
import "/common_lib/game_params_file.uh"
import "/common_lib/string_iterators.uh"

namespace PM
{

fn LoadGameParamsFile( ust::filesystem_path_view game_files_directory ) : ust::optional</GameParams/>
{
	var ust::filesystem_path file_path= ust::path::join( game_files_directory, c_game_params_file_name );

	result_match( ust::read_file_to_string( file_path ) )
	{
		Ok(contents) ->
		{
			return ParseGameParamsFile( contents );
		},
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Failed to read file \"", file_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
			return ust::null_optional;
		}
	}
}

fn ParseGameParamsFile( ust::string_view8 file_contents ) : GameParams
{
	var GameParams mut game_params;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "poziom" )
		{
			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			if_var( &num_str : words_it.next() )
			{
				if_var( num : ust::parse_integer_exact</u32/>( num_str ) )
				{
					game_params.start_map= num;
				}
			}

			if_var( &num_str : words_it.next() )
			{
				if_var( num : ust::parse_integer_exact</u32/>( num_str ) )
				{
					game_params.max_maps= num;
				}
			}
		}
		else if( first_word == "set_kolor_swiatla" )
		{
			auto index_str_opt= words_it.next();
			if( index_str_opt.empty() )
			{
				continue;
			}

			auto index_opt= ust::parse_integer_exact</u32/>( index_str_opt.try_deref() );
			if( index_opt.empty() )
			{
				continue;
			}

			var u32 index= index_opt.try_deref();
			if( size_type( index ) >= typeinfo</ typeof( game_params.light_colors ) />.element_count )
			{
				continue;
			}

			auto &mut color= game_params.light_colors[ index ];

			if( words_it.next() != ust::string_view8( "=" ) )
			{
				continue;
			}

			for( auto mut i= 0u; i < 3u; ++i )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u32/>( s ) )
					{
						if( n <= 255u )
						{
							color[i]= u8(n);
						}
					}
				}
			}
		}
	}

	return game_params;
}

} // namespace PM
