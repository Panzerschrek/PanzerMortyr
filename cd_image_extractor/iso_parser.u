import "/path_utils.iu"
import "/stdout.iu"
import "/string_conversions.iu"
import "/utf.iu"
import "/vector.iu"
import "iso_file.iu"
import "iso_parser.iu"

namespace PM
{

fn ParseIsoFile( ust::file_readable &mut f ) : ust::io_result</void/>
{
	result_check_or_return( f.seek( 32768u64 ) );

	var ust::vector</IsoVolumeDescriptor/> mut volume_descriptors;

	var IsoVolumeDescriptor mut volume_descriptor= zero_init;

	loop
	{
		result_check_or_return( f.read_exact( ust::single_element_array_view( volume_descriptor ).to_byte8_range() ) );

		if( volume_descriptor.header.type_ == 255u8 )
		{
			break; // A terminator.
		}

		if( volume_descriptor.header.identifier != "CD001" )
		{
			ust::stderr_print( "Incorrect volume descriptor identifier!\n" );
			break;
		}

		if( volume_descriptor.header.version != 1u8 )
		{
			ust::stderr_print(
				ust::concat(
					"Unsupported volume descriptor version ", ust::to_string8( volume_descriptor.header.version ), "!\n" ) );
			break;
		}

		ust::stdout_print( ust::concat( "A volume of type ", ust::to_string8( volume_descriptor.header.type_ ), "\n" ) );

		volume_descriptors.push_back( volume_descriptor );
	}

	foreach( &v : volume_descriptors )
	{
		// Process only TYPE 2 volumes, since they have non-restricted file names (with no file name limit).
		if( v.header.type_ == 2u8 )
		{
			ust::stdout_print( "\nTYPE 2 VOLUME:\n\n" );

			var IsoPrimaryVolumeDescriptor mut primary_volume_descriptor= zero_init;
			ust::single_element_array_view( primary_volume_descriptor ).to_byte8_range().copy_from(
				ust::single_element_array_view( v ).to_byte8_range() );

			var IsoDirectoryRecordHeader& root_directory=
				primary_volume_descriptor.root_directory_entry.header;

			var u32 block_size( primary_volume_descriptor.logical_block_size[0] );

			var u32 root_extent_location= ReadNumBytes( root_directory.extent_location[0] );
			var u32 root_extent_length= ReadNumBytes( root_directory.data_length[0] );

			ust::stdout_print( ust::concat( "length is ", ust::to_string8( root_extent_length ), " at ", ust::to_string8( root_extent_location ), "\n" ) );

			result_check_or_return( ReadDirectory( f, block_size, root_directory, "" ) );
		}
	}

	return void();
}

fn ReadDirectory(
	ust::file_readable &mut f,
	u32 block_size,
	IsoDirectoryRecordHeader& directory_header,
	ust::filesystem_path_view prefix ) : ust::io_result</void/>
{
	var u32 extent_location= ReadNumBytes( directory_header.extent_location[0] );
	var u32 extent_length= ReadNumBytes( directory_header.data_length[0] );

	result_check_or_return( f.seek( u64( block_size ) * u64( extent_location ) ) );

	var ust::vector</ tup[ IsoDirectoryRecordHeader, ust::string8 ] /> mut subdirectories;

	var size_type mut record_index= 0s;
	for( auto mut dir_offset= 0u; dir_offset < extent_length; )
	{
		var IsoDirectoryRecordHeader mut entry_header= zero_init;

		result_check_or_return( f.read_exact( ust::single_element_array_view( entry_header ).to_byte8_range() ) );

		if( entry_header.length <= u8( typeinfo</ IsoDirectoryRecordHeader />.size_of ) )
		{
			break;
		}
		dir_offset+= u32( entry_header.length );

		{
			var byte8 mut padding= zero_init;
			result_check_or_return( f.read_exact( ust::single_element_array_view( padding ) ) );
		}

		var ust::string16 mut name( size_type( entry_header.length_of_identifier ) / 2s , '\0'c16 );

		result_check_or_return( f.read_exact( name.range().to_byte8_range() ) );

		var ust::string8 name_prefixed= ust::path::join( prefix, ust::utf::convert_utf16_to_utf8_string( name ) );

		ust::stdout_print( ust::concat( "Entry \"", name_prefixed, "\" with length ", ust::to_string8( size_type( entry_header.length_of_identifier ) / 2s ), "\n" ) );

		if( ( u32( entry_header.file_flags ) & 2u ) != 0u )
		{
			if( record_index >= 2s ) // Ignore "." and ".."
			{
				subdirectories.push_back( ust::make_tuple( entry_header, name_prefixed ) );
			}
		}

		++record_index;
	}

	foreach( &subdirectory : subdirectories )
	{
		result_check_or_return( ReadDirectory( f, block_size, subdirectory[0], subdirectory[1] ) );
	}

	return void();
}

/*
fn ReadNumBytes( IsoNumBytes</2s/>& num_bytes ) : u16
{
	return u16( u32( num_bytes[0] ) | ( u32( num_bytes[1] ) << 8 ) );
}
*/

fn ReadNumBytes( IsoNumBytes</4s/>& num_bytes ) : u32
{
	return
		( u32( num_bytes[0] ) <<  0 ) |
		( u32( num_bytes[1] ) <<  8 ) |
		( u32( num_bytes[2] ) << 16 ) |
		( u32( num_bytes[3] ) << 24 );
}

} // namespace PM
