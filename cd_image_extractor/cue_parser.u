import "/number_parsing.iu"
import "/common_lib/string_iterators.iu"
import "cue_parser.iu"

namespace PM
{

fn ParseCueFile( Logger &mut logger, ust::string_view8 file_contents ) : ust::optional</CueFileParsed/>
{
	// A dumb size-based check for case if someone provided a binary file instead of CUE.
	if( file_contents.size() > 1024s * 16s )
	{
		logger.LogLine( "Too large CUE file to be parsed!" );
		return ust::null_optional;
	}

	var CueFileParsed mut cue_file_parsed;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_iterator= ust::wrap_raw_iterator( WordsIterator( line ) );
		var ust::string_view8 first_word= words_iterator.next().deref_or( ust::string_view8() );

		if( first_word.empty() )
		{
			continue; // Skip empty lines.
		}
		else if( first_word == "FILE" )
		{
			var ust::string_view8 mut file_line= line;

			SkipWhitespaces( file_line ); // Skip spaces before "FILE".
			file_line= file_line.subrange_start( 4s ); // Skip "FILE".
			SkipWhitespaces( file_line ); // Skip spaces after "FILE".

			auto mut file_name_opt= ParseQuotedString( file_line );
			if( file_name_opt.empty() )
			{
				logger.LogLine( "Failed to parse file name!" );
				continue;
			}

			var ust::string8 mut file_name= file_name_opt.try_take();

			SkipWhitespaces( file_line );

			if( !file_line.starts_with( "BINARY" ) )
			{
				logger.LogLine( "Unexpected file type, only BINARY is supported" );
				continue;
			}

			cue_file_parsed.files.push_back( CueFileParsed::File{ .name= move(file_name) } );
		}
		else if( first_word == "TRACK" )
		{
			if( cue_file_parsed.files.empty() )
			{
				logger.LogLine( "TRACK without a prior file!" );
				continue;
			}

			var CueFileParsed::File &mut current_file= cue_file_parsed.files.back();

			auto track_number_opt=
				ParseNumberWithLeadingZeros( words_iterator.next().deref_or( ust::string_view8() ) );

			if( track_number_opt.empty() )
			{
				logger.LogLine( "Failed to parse track number!" );
				continue;
			}

			auto track_mode_opt= ParseTrackMode( words_iterator.next().deref_or( ust::string_view8() ) );
			if( track_mode_opt.empty() )
			{
				logger.LogLine( "Unsupported track mode!" );
				continue;
			}

			current_file.tracks.push_back(
				CueFileParsed::Track
				{
					.number= track_number_opt.try_deref(),
					.mode= track_mode_opt.try_deref(),
				} );
		}
		else if( first_word == "INDEX" )
		{
			if( cue_file_parsed.files.empty() )
			{
				logger.LogLine( "INDEX without a prior file!" );
				continue;
			}

			var CueFileParsed::File &mut current_file= cue_file_parsed.files.back();

			if( current_file.tracks.empty() )
			{
				logger.LogLine( "INDEX without a prior track!" );
				continue;
			}

			var CueFileParsed::Track &mut current_track= current_file.tracks.back();

			auto mut track_index_opt= ParseTrackIndex( logger, words_iterator );
			if( !track_index_opt.empty() )
			{
				current_track.indices.push_back( track_index_opt.try_take() );
			}
		}
		else
		{
			logger.LogLine( ust::concat( "Ignoring unknown top-level CUE command: ", line ) );
		}
	}

	return cue_file_parsed;
}

fn ParseTrackIndex(
	Logger &mut logger,
	ust::iterator</ WordsIterator /> &mut words_iterator ) : ust::optional</ CueFileParsed::TrackIndex />
{
	auto number_opt= ParseNumberWithLeadingZeros( words_iterator.next().deref_or( ust::string_view8() ) );

	if( number_opt.empty() )
	{
		logger.LogLine( "Failed to parse index number!" );
		return ust::null_optional;
	}

	auto mut offset_opt= ParseOffset( words_iterator.next().deref_or( ust::string_view8() ) );

	if( offset_opt.empty() )
	{
		logger.LogLine( "Failed to parse frame offset!" );
		return ust::null_optional;
	}

	return CueFileParsed::TrackIndex
	{
		.number= number_opt.try_deref(),
		.offset_frames= offset_opt.try_deref(),
	};
}

fn ParseOffset( ust::string_view8 mut s ) : ust::optional</u32/>
{
	if( s.size() < 8s )
	{
		return ust::null_optional;
	}

	if( s[2s] != ':' || s[5s] != ':' )
	{
		return ust::null_optional;
	}

	var [ u32, 3 ] mut components[ 0u ... ];

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var char8 d0= s[0s];
		var char8 d1= s[1s];
		if( !( d0 >= '0' && d0 <= '9' ) )
		{
			return ust::null_optional;
		}
		if( !( d1 >= '0' && d1 <= '9' ) )
		{
			return ust::null_optional;
		}

		components[i]= ( u32( d0 ) - u32('0') ) * 10u + ( u32( d1 ) - u32( '0' ) );
		s.drop_front();
		s.drop_front();
		if( !s.empty() )
		{
			s.drop_front();
		}
	}

	return ( components[0] * 60u + components[1] ) * 75u + components[2];
}

fn ParseQuotedString( ust::string_view8 &mut s ) : ust::optional</ust::string8/>
{
	if( s.empty() )
	{
		return ust::null_optional;
	}

	if( s.front() != '"' )
	{
		return ust::null_optional;
	}
	s.drop_front();

	var ust::string8 mut res;
	while( !s.empty() )
	{
		var char8 c= s.drop_and_get_front();
		if( c == '"' )
		{
			break;
		}
		res.push_back(c);
	}

	return res;
}

fn SkipWhitespaces( ust::string_view8 &mut s )
{
	while( !s.empty() && s.front() == ' ' )
	{
		s.drop_front();
	}
}

fn ParseNumberWithLeadingZeros( ust::string_view8 mut s ) : ust::optional</u32/>
{
	if( s.empty() )
	{
		return ust::null_optional;
	}

	if( !s.empty() && s.front() == '0' )
	{
		while( !s.empty() && s.front() == '0' )
		{
			s.drop_front();
		}

		if( s.empty() )
		{
			return 0u;
		}
	}

	return ust::parse_number_exact</u32/>( s );
}

fn ParseTrackMode( ust::string_view8 name ) : ust::optional</CueFileParsed::TrackMode/>
{
	if( name == "AUDIO" )
	{
		return CueFileParsed::TrackMode::Audio;
	}
	if( name == "MODE1/2352" )
	{
		return CueFileParsed::TrackMode::Mode1_2352;
	}
	if( name == "MODE2/2352" )
	{
		return CueFileParsed::TrackMode::Mode2_2352;
	}
	return ust::null_optional;
}

} // namespace PM
