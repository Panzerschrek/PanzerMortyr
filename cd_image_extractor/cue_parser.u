import "/number_parsing.iu"
import "/stdout.iu"
import "/common_lib/string_iterators.iu"
import "cue_parser.iu"

namespace PM
{

fn ParseCueFile( ust::string_view8 file_contents ) : ust::optional</CueFileParsed/>
{
	var CueFileParsed mut cue_file_parsed;

	var ParsingState mut parsing_state{ .it= ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) };

	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		var ust::string_view8 current_line= parsing_state.current_line.try_deref();

		if( current_line.starts_with( "FILE" ) )
		{
			parsing_state.NextLine();

			var ust::string_view8 mut line= current_line.subrange_start( 4s );

			SkipWhitespaces( line );

			auto mut file_path_opt= ParseQuotedString( line );
			if( file_path_opt.empty() )
			{
				ust::stderr_print( "Failed to parse file name!\n" );
				continue;
			}

			var ust::filesystem_path mut file_path= file_path_opt.try_take();

			SkipWhitespaces( line );

			if( !line.starts_with( "BINARY" ) )
			{
				ust::stderr_print( "Unexpected file type, only BINARY is supported\n" );
				continue;
			}

			auto mut file_entry_opt= ParseCueFileEntry( move(file_path), parsing_state );
			if( !file_entry_opt.empty() )
			{
				cue_file_parsed.files.push_back( file_entry_opt.try_take() );
			}
		}
		else
		{
			ust::stderr_print( ust::concat( "Unknown top-level entry: ", current_line, "\n" ) );
			parsing_state.NextLine();
		}
	}

	return cue_file_parsed;
}

struct ParsingState
{
	ust::optional</ ust::string_view8 /> @( "a" ) current_line;
	ust::iterator</ LinesRawIterator /> @( "a" ) it;

	fn NextLine( mut this )
	{
		current_line= it.next();
	}
}

fn ParseCueFileEntry(
	ust::filesystem_path mut file_path, ParsingState &mut parsing_state ) : ust::optional</CueFileParsed::File/>
{
	var CueFileParsed::File mut file_entry{ .path= file_path };

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_iterator= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		var ust::string_view8 first_word= words_iterator.next().deref_or( ust::string_view8() );

		if( first_word == "TRACK" )
		{
			parsing_state.NextLine();

			auto mut track_opt= ParseCueTrack( words_iterator, parsing_state );
			if( !track_opt.empty() )
			{
				file_entry.tracks.push_back( track_opt.try_take() );
			}
		}
		else
		{
			break;
		}
	}

	return file_entry;
}

fn ParseCueTrack(
	ust::iterator</ WordsIterator /> &mut track_words_iterator,
	ParsingState &mut parsing_state ) : ust::optional</CueFileParsed::Track/>
{
	auto track_number_opt=
		ParseNumberWithLeadingZeros( track_words_iterator.next().deref_or( ust::string_view8() ) );

	if( track_number_opt.empty() )
	{
		ust::stderr_print( "Failed to parse track number!\n" );
		return ust::null_optional;
	}

	auto track_mode_opt= TraParseTrackMode( track_words_iterator.next().deref_or( ust::string_view8() ) );
	if( track_mode_opt.empty() )
	{
		ust::stderr_print( "Unsupported track mode!\n" );
		return ust::null_optional;
	}

	var CueFileParsed::Track mut track
	{
		.number= track_number_opt.try_deref(),
		.mode= track_mode_opt.try_deref(),
	};

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_iterator= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		var ust::string_view8 first_word= words_iterator.next().deref_or( ust::string_view8() );

		if( first_word == "INDEX" )
		{
			parsing_state.NextLine();

			auto mut track_index_opt= ParseTrackIndex( words_iterator );
			if( !track_index_opt.empty() )
			{
				track.indices.push_back( track_index_opt.try_take() );
			}
		}
		else
		{
			break;
		}
	}

	return track;
}

fn ParseTrackIndex(
	ust::iterator</ WordsIterator /> &mut words_iterator ) : ust::optional</ CueFileParsed::TrackIndex />
{
	auto number_opt= ParseNumberWithLeadingZeros( words_iterator.next().deref_or( ust::string_view8() ) );

	if( number_opt.empty() )
	{
		ust::stderr_print( "Failed to parse index number!\n" );
		return ust::null_optional;
	}

	auto mut offset_opt= ParseOffset( words_iterator.next().deref_or( ust::string_view8() ) );

	if( offset_opt.empty() )
	{
		ust::stderr_print( "Failed to parse frame offset!\n" );
		return ust::null_optional;
	}

	return CueFileParsed::TrackIndex
	{
		.number= number_opt.try_deref(),
		.offset_frames= offset_opt.try_deref(),
	};
}

fn ParseOffset( ust::string_view8 mut s ) : ust::optional</u32/>
{
	if( s.size() < 8s )
	{
		return ust::null_optional;
	}

	if( s[2s] != ':' || s[5s] != ':' )
	{
		return ust::null_optional;
	}

	var [ u32, 3 ] mut components[ 0u ... ];

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var char8 d0= s[0s];
		var char8 d1= s[1s];
		if( !( d0 >= '0' && d0 <= '9' ) )
		{
			return ust::null_optional;
		}
		if( !( d1 >= '0' && d1 <= '9' ) )
		{
			return ust::null_optional;
		}

		components[i]= ( u32( d0 ) - u32('0') ) * 10u + ( u32( d1 ) - u32( '0' ) );
		s.drop_front();
		s.drop_front();
		if( !s.empty() )
		{
			s.drop_front();
		}
	}

	return ( components[0] * 60u + components[1] ) * 75u + components[2];
}

fn ParseQuotedString( ust::string_view8 &mut s ) : ust::optional</ust::string8/>
{
	if( s.empty() )
	{
		return ust::null_optional;
	}

	if( s.front() != '"' )
	{
		return ust::null_optional;
	}
	s.drop_front();

	var ust::string8 mut res;
	while( !s.empty() )
	{
		var char8 c= s.drop_and_get_front();
		if( c == '"' )
		{
			break;
		}
		res.push_back(c);
	}

	return res;
}

fn SkipWhitespaces( ust::string_view8 &mut s )
{
	while( !s.empty() && s.front() == ' ' )
	{
		s.drop_front();
	}
}

fn ParseNumberWithLeadingZeros( ust::string_view8 mut s ) : ust::optional</u32/>
{
	if( s.empty() )
	{
		return ust::null_optional;
	}

	if( s == "0" )
	{
		return 0u;
	}

	while( !s.empty() && s.front() == '0' )
	{
		s.drop_front();
	}

	return ust::parse_number_exact</u32/>( s );
}

fn TraParseTrackMode( ust::string_view8 name ) : ust::optional</CueFileParsed::TrackMode/>
{
	if( name == "AUDIO" )
	{
		return CueFileParsed::TrackMode::Audio;
	}
	if( name == "MODE1/2352" )
	{
		return CueFileParsed::TrackMode::Mode1_2352;
	}
	return ust::null_optional;
}

} // namespace PM
