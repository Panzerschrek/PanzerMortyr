import "/string.iu"
import "/vector.iu"

namespace PM
{

// See https://en.wikipedia.org/wiki/Cue_sheet_(computing).

struct CueFileParsed
{
	ust::vector</File/> files;

	struct File
	{
		ust::string8 name;
		ust::vector</Track/> tracks;
	}

	struct Track
	{
		u32 number;
		TrackMode mode;
		ust::vector</TrackIndex/> indices;
	}

	enum TrackMode{ Audio, Mode1_2352 }

	struct TrackIndex
	{
		u32 number;
		u32 offset_frames;
	}
}

fn ParseCueFile( ust::string_view8 file_contents ) : ust::optional</CueFileParsed/>;

} // namespace PM
