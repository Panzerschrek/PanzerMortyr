import "/box.iu"
import "/file.iu"
import "/string.iu"
import "/variant.iu"
import "/vector.iu"

namespace PM
{

struct DirectoryInIso
{
	ust::vector</ tup[ ust::string8, EntryInIso ] /> entries;
}

struct FileInIso
{
	u64 offset;
	u64 size;
}

type EntryInIso= ust::variant</ tup[ ust::box</ DirectoryInIso />, FileInIso ] />;

fn ParseIsoFile( ust::file_readable &mut f ) : ust::io_result</DirectoryInIso/>;

} // namespace PM
