import "/binary_search.iu"
import "/enum_string_conversions.iu"
import "/file.iu"
import "/path_utils.iu"
import "/sort.iu"
import "/string_conversions.iu"
import "/common_lib/wav_header.iu"
import "cue_tracks_extractor.iu"

namespace PM
{

fn nodiscard ExtractCueTracks(
	ust::filesystem_path_view base_directory, CueFileParsed& cue_file, ust::filesystem_path_view base_file_name ) : bool
{
	foreach( &file : cue_file.files )
	{
		if( !ExtractFile( base_directory, file, base_file_name ).is_ok() )
		{
			return false;
		}
	}

	return true;
}

fn nodiscard ExtractFile(
	ust::filesystem_path_view base_directory,
	CueFileParsed::File& cue_file_parsed,
	ust::filesystem_path_view base_file_name ) : ust::io_result</void/>
{
	// Extract and sort offsets of each index of each track.
	// We need it for searching for track ends.

	var ust::vector</u32/> mut offsets;

	foreach( &track : cue_file_parsed.tracks )
	{
		foreach( &index : track.indices )
		{
			offsets.push_back( index.offset_frames );
		}
	}

	ust::sort( offsets );

	var ust::filesystem_path full_path= ust::path::join( base_directory, cue_file_parsed.name );

	auto mut file_res= ust::file_readable::open( full_path );
	if_var( e : file_res.as_error_ref() )
	{
		ust::stderr_print(
			ust::concat( "Failed to open file \"", full_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
		return e;
	}

	var ust::file_readable mut file= move( file_res ).try_take();

	foreach( &track : cue_file_parsed.tracks )
	{
		foreach( &index : track.indices )
		{
			if( index.number != 1u )
			{
				continue; // Extract only index 1.
			}

			var size_type i= ust::binary_search::first_greater_or_equal( offsets.range(), index.offset_frames );
			if( i >= offsets.size() )
			{
				continue;
			}

			var u32 mut end_offset= 0u;
			if( i + 1s < offsets.size() )
			{
				// Use next offset as end offset..
				end_offset= offsets[ i + 1s ];
			}
			else
			{
				// Use file size as end offset.
				result_unwrap_or_return( mut file_size : file.get_size() );
				end_offset= u32( file_size / c_frame_size_bytes );
			}

			var ust::filesystem_path out_file_path=
				ust::concat(
					base_file_name,
					ust::to_string8( track.number ),
					GetFileExtensionForTrackMode( track.mode ) );

			result_check_or_return( WriteTrack( file, out_file_path, index, track.mode, end_offset ) );

			break;
		}
	}

	return void();
}

fn GetFileExtensionForTrackMode( CueFileParsed::TrackMode track_mode ) : ust::string_view8
{
	switch( track_mode )
	{
		CueFileParsed::TrackMode::Audio ->
		{
			return ".wav";
		},
		CueFileParsed::TrackMode::Mode1_2352, CueFileParsed::TrackMode::Mode2_2352 ->
		{
			// Assume that we have an ISO filesystem.
			return ".iso";
		},
	}
}

fn WriteTrack(
	ust::file_readable &mut in_file,
	ust::filesystem_path_view out_file_path,
	CueFileParsed::TrackIndex& index,
	CueFileParsed::TrackMode track_mode,
	u32 end_offset ) : ust::io_result</void/>
{
	ust::stdout_print( ust::concat( "Writing file \"", out_file_path, "\".\n" ) );

	result_unwrap_or_return( mut out_file : ust::file_writeable::create( out_file_path ) );

	result_check_or_return( in_file.seek( c_frame_size_bytes * u64( index.offset_frames ) ) );

	switch( track_mode )
	{
		CueFileParsed::TrackMode::Audio ->
		{
			// Create WAV header for audio tracks.

			var u32 num_data_bytes= ( end_offset - index.offset_frames ) * u32( c_frame_size_bytes );

			var WavHeader wav_header
			{
				.file_type_block_id= WavHeader::c_expected_file_type_block_id,
				.file_size=
					u32( typeinfo</WavHeader/>.size_of ) +
					u32( typeinfo</WavDataBlockHeader/>.size_of ) -
					8u +
					num_data_bytes,
				.file_format_id= WavHeader::c_expected_file_format_id,
				.format_block_id= WavHeader::c_expected_format_block_id,
				.block_size= 0x10u,
				.audio_format(1),
				.num_channels(2),
				.frequency= 44100u,
				.bytes_per_sec= 44100u * 2u * 2u,
				.bytes_per_block( 2u * 2u ),
				.bits_per_sample(16),
			};

			result_check_or_return(
				out_file.write_all( ust::single_element_array_view( wav_header ).to_byte8_range() ) );

			var WavDataBlockHeader data_block_header
			{
				.data_block_id= WavDataBlockHeader::c_expected_data_block_id,
				.data_size= num_data_bytes,
			};

			result_check_or_return(
				out_file.write_all( ust::single_element_array_view( data_block_header ).to_byte8_range() ) );
		},
		CueFileParsed::TrackMode::Mode1_2352,
		CueFileParsed::TrackMode::Mode2_2352 -> { /* No header is needed for data tracks. */ },
	}

	var [ byte8, c_frame_size_bytes ] mut frame_bytes= zero_init;

	for( auto mut o= index.offset_frames; o < end_offset; ++o )
	{
		result_check_or_return( in_file.read_exact( frame_bytes ) );

		switch( track_mode )
		{
			CueFileParsed::TrackMode::Audio ->
			{
				// Write the whole frame for audio tracks.

				result_check_or_return( out_file.write_all( frame_bytes ) );
			},
			CueFileParsed::TrackMode::Mode1_2352 ->
			{
				// Data tracks in mode 1 contain only 2048 bytes in each frame, first 16 bytes are header, trailing bytes are used for error correction codes.

				result_check_or_return(
					out_file.write_all( ust::array_view_imut</byte8/>( frame_bytes ).subrange( 16s, 2064s ) ) );
			},
			CueFileParsed::TrackMode::Mode2_2352 ->
			{
				// MODE2/2352 tracks seems to have 24-byte header and 2048 bytes of actual payload.

				result_check_or_return(
					out_file.write_all( ust::array_view_imut</byte8/>( frame_bytes ).subrange( 24s, 2072s ) ) );
			},
		}
	}

	return move( out_file ).close();
}

var u64 constexpr c_frame_size_bytes( 2352 );

} // namespace PM
