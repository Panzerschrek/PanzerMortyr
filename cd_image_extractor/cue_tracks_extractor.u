import "/binary_search.iu"
import "/enum_string_conversions.iu"
import "/file.iu"
import "/path_utils.iu"
import "/sort.iu"
import "/string_conversions.iu"
import "cue_tracks_extractor.iu"

namespace PM
{

fn nodiscard ExtractCueTracks(
	ust::filesystem_path_view base_directory, CueFileParsed& cue_file, ust::filesystem_path_view base_file_name ) : bool
{
	if( cue_file.files.size() == 1s )
	{
		return ExtractFile( base_directory, cue_file.files.front(), base_file_name ).is_ok();
	}

	auto mut i= 0s;
	foreach( &file : cue_file.files )
	{
		if( !ExtractFile(
				base_directory, file, ust::concat( base_file_name, "_subfile_", ust::to_string8(i) ) ).is_ok() )
		{
			return false;
		}
		++i;
	}

	return true;
}

fn nodiscard ExtractFile(
	ust::filesystem_path_view base_directory,
	CueFileParsed::File& file,
	ust::filesystem_path_view base_file_name ) : ust::io_result</void/>
{
	var ust::vector</u32/> mut offsets;

	var ust::filesystem_path full_path= ust::path::join( base_directory, file.path );

	auto mut file_res= ust::file_readable::open( full_path );
	if_var( e : file_res.as_error_ref() )
	{
		ust::stderr_print(
			ust::concat( "Failed to open file \"", full_path, "\"! Error: ", ust::enum_to_string(e), "\n" ) );
		return e;
	}

	var ust::file_readable mut f= move( file_res ).try_take();

	foreach( &track : file.tracks )
	{
		foreach( &index : track.indices )
		{
			offsets.push_back( index.offset_frames );
		}
	}

	ust::sort(offsets);

	foreach( &track : file.tracks )
	{
		foreach( &index : track.indices )
		{
			if( index.number != 1u )
			{
				continue;
			}

			var size_type i= ust::binary_search::first_greater_or_equal( offsets.range(), index.offset_frames );
			if( i >= offsets.size() )
			{
				continue;
			}

			var u32 mut end_offset= 0u;
			if( i + 1s < offsets.size() )
			{
				end_offset= offsets[ i + 1s ];
			}
			else
			{
				result_unwrap_or_return( mut file_size : f.get_size() );
				end_offset= u32( file_size / c_frame_size_bytes );
			}

			// TODO - add extension for file (WAV, ISO).
			var ust::filesystem_path out_file_path= base_file_name + ust::to_string8( track.number );

			ust::stdout_print(
				ust::concat(
					"Write file \"",
					out_file_path,
					"\" with start offset ",
					ust::to_string8( index.offset_frames ),
					" and end offset ",
					ust::to_string8( end_offset ),
					"\n" ) );

			result_check_or_return( WriteTrack( f, out_file_path, index, track.mode, end_offset ) );

			break;
		}
	}

	return void();
}

fn WriteTrack(
	ust::file_readable &mut f,
	ust::filesystem_path_view out_file_path,
	CueFileParsed::TrackIndex& index,
	CueFileParsed::TrackMode track_mode,
	u32 end_offset ) : ust::io_result</void/>
{
	result_unwrap_or_return( mut out_file : ust::file_writeable::create( out_file_path ) );

	result_check_or_return( f.seek( c_frame_size_bytes * u64( index.offset_frames ) ) );

	// TODO - write WAV header for audio data.

	var [ byte8, c_frame_size_bytes ] mut frame_bytes= zero_init;

	for( auto mut o= index.offset_frames; o < end_offset; ++o )
	{
		result_check_or_return( f.read_exact( frame_bytes ) );

		switch( track_mode )
		{
			CueFileParsed::TrackMode::Audio ->
			{
				result_check_or_return( out_file.write_all( frame_bytes ) );
			},
			CueFileParsed::TrackMode::Mode1_2352 ->
			{
				result_check_or_return(
					out_file.write_all( ust::array_view_imut</byte8/>( frame_bytes ).subrange( 16s, 2064s ) ) );
			},
		}
	}

	return move( out_file ).close();
}

var u64 constexpr c_frame_size_bytes( 2352 );

} // namespace PM
