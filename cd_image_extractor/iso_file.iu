namespace PM
{

// This file describes structures of the ISO 9660 filesystem.

struct IsoVolumeDescriptorHeader ordered
{
	u8 type_;
	[ char8, 5 ] identifier;
	u8 version;
}

struct IsoVolumeDescriptor ordered
{
	IsoVolumeDescriptorHeader header;
	[ byte8, 2041 ] data;
}

static_assert( typeinfo</ IsoVolumeDescriptor />.size_of == 2048s );

struct IsoPrimaryVolumeDescriptor ordered
{
	IsoVolumeDescriptorHeader header;

	byte8 unused0;
	[ char8, 32 ] system_identifier;
	[ char8, 32 ] volume_identifier;
	[ byte8, 8 ] unused1;
	[ u32, 2 ] volume_space_size;
	[ byte8, 32 ] unused2;
	[ u16, 2 ] volume_set_size;
	[ u16, 2 ] volume_sequence_number;
	[ u16, 2 ] logical_block_size;
	[ u32, 2 ] path_table_size;
	u32 path_l_table_location;
	u32 path_l_optional_table_location;
	u32 path_m_table_location;
	u32 path_m_optional_table_location;
	IsoRootDirectory root_directory_entry;
	[ char8, 128 ] volume_set_identifier;
	[ char8, 128 ] publisher_identifier;
	[ char8, 128 ] data_preparer_identifier;
	[ char8, 128 ] application_identifier;
	[ char8, 37 ] copyright_file_identifier;
	[ char8, 37 ] abstract_file_identifier;
	[ char8, 37 ] bibliographic_file_identifier;
	IsoDateTime volume_creation_date_and_time;
	IsoDateTime volume_modification_date_and_time;
	IsoDateTime volume_expiration_date_and_time;
	IsoDateTime volume_effective_date_and_time;
	u8 file_structure_version;
	u8 unused3;
	[ byte8, 512 ] application_use;
	[ byte8, 653 ] unused4;
}

static_assert( typeinfo</ IsoPrimaryVolumeDescriptor />.size_of == 2048s );

struct IsoDateTime ordered
{
	[ byte8, 17 ] data;
}

static_assert( typeinfo</ IsoDateTime />.size_of == 17s );

struct IsoDirectoryRecordHeader ordered
{
	u8 length;
	u8 extended_attribute_record_length;
	[ IsoNumBytes</4s/>, 2 ] extent_location;
	[ IsoNumBytes</4s/>, 2 ] data_length;
	[ u8, 7 ] record_date_and_time;
	u8 file_flags;
	u8 file_unit_size;
	u8 interleave_gap_size;
	[ IsoNumBytes</2s/>, 2 ] volume_sequence_number;
	u8 length_of_identifier;
}

static_assert( typeinfo</ IsoDirectoryRecordHeader />.align_of == 1s );
static_assert( typeinfo</ IsoDirectoryRecordHeader />.size_of == 33s );

struct IsoRootDirectory ordered
{
	IsoDirectoryRecordHeader header;
	[ char8, 1 ] name_and_padding;
}

static_assert( typeinfo</ IsoRootDirectory />.size_of == 34s );

// Use arrays of bytes instead of u16/u32 values, since we need sometimes unaligned values.
template</size_type size/>
type IsoNumBytes= [ u8, size ];

} // namespace PM
