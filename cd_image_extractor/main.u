import "/enum_string_conversions.iu"
import "/main_wrapper.iu"
import "/stdout.iu"
import "/file_helpers.iu"
import "/path_utils.iu"
import "cue_parser.iu"
import "cue_tracks_extractor.iu"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	ust::stdout_print( "PanzerMortyr CD image extractor\n" );

	if( args.size() < 2s )
	{
		ust::stderr_print( "Expected at least one argument!\n" );
		return -1;
	}

	var ust::filesystem_path_view cue_file_path= args[1s];

	result_match( ust::read_file_to_string( cue_file_path ) )
	{
		Ok( file_contents ) ->
		{
			auto cue_file_parsed_opt= ParseCueFile( file_contents );
			if( cue_file_parsed_opt.empty() )
			{
				ust::stderr_print( "Failed to parse CUE file!" );
				return -1;
			}

			var bool success=
				ExtractCueTracks(
					ust::path::get_parent_path( cue_file_path ).deref_or( ust::filesystem_path_view() ),
					cue_file_parsed_opt.try_deref(),
					"track" );
			if( !success )
			{
				return -1;
			}
		},
		Err(e) ->
		{
			ust::stderr_print(
				ust::concat(
					"Failed to read file \"",
					cue_file_path,
					" \"! Error: ",
					ust::enum_to_string(e),
					"\n" ) );
			return -1;
		}
	}

	return 0;
}

} // namespace PM
