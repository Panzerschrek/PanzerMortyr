import "image_drawer.uh"
import "text_drawer.uh"

namespace PM
{

class Menu
{
public:
	fn constructor( [ u32, 2 ] viewport_size );

	fn IsActive( this ) : bool;

	fn ProcessKeyPress( mut this, SDL_Keysym& key_sym );

	fn Update( mut this, f32 time_delta_s );

	fn Draw( mut this, ImageDrawer &mut image_drawer, TextDrawer &mut text_drawer );

private:
	[ u32, 2 ] imut viewport_size_;
	bool images_preloaded_;

	bool is_active_;

	f32 time_s_;
}

} // namespace PM
