import "/minmax.iu"
import "vec.iu"

namespace PM
{

struct ClippingPolygon
{
	fn CreateFromPoint( Vec2f& p ) : ClippingPolygon
	{
		return
			ClippingPolygon
			{
				.x= ClipAxis::CreateFromPoint( p.x ),
				.y= ClipAxis::CreateFromPoint( p.y ),
				.x_plus_y= ClipAxis::CreateFromPoint( p.x + p.y ),
				.x_minus_y= ClipAxis::CreateFromPoint( p.x - p.y ),
			};
	}

	fn CreateFromBox( Vec2f& min, Vec2f& max ) : ClippingPolygon
	{
		return
			ClippingPolygon
			{
				.x{ .min= min.x, .max= max.x },
				.y{ .min= min.y, .max= max.y },
				.x_plus_y{ .min= min.x + min.y, .max= max.x + max.y },
				.x_minus_y{ .min= min.x - max.y, .max= max.x - min.y },
			};
	}

	fn IsValidAndNonEmpty( this ) : bool
	{
		var bool individual_exes_are_valid=
			x.IsValidAndNonEmpty() &&
			y.IsValidAndNonEmpty() &&
			x_plus_y.IsValidAndNonEmpty() &&
			x_minus_y.IsValidAndNonEmpty();

		if( !individual_exes_are_valid )
		{
			return false;
		}

		// Check XY box vertices against X+Y and X-Y planes.
		if( x.min + y.min >= x_plus_y.max )
		{
			return false;
		}
		if( x.max + y.max <= x_plus_y.min )
		{
			return false;
		}
		if( x.min - y.max >= x_minus_y.max )
		{
			return false;
		}
		if( x.max - y.min <= x_minus_y.min )
		{
			return false;
		}

		// Chec X+Y nad X-Y box vertices against X and Y planes.
		if( 0.5f * ( x_plus_y.max + x_minus_y.max ) <= x.min )
		{
			return false;
		}
		if( 0.5f * ( x_plus_y.min + x_minus_y.min ) >= x.max )
		{
			return false;
		}
		if( 0.5f * ( x_plus_y.max - x_minus_y.min ) <= y.min )
		{
			return false;
		}
		if( 0.5f * ( x_plus_y.min - x_minus_y.max ) >= y.max )
		{
			return false;
		}

		return true;
	}

	fn IsEmptyOrInvalid( this ) : bool
	{
		return !IsValidAndNonEmpty();
	}

	fn ExtendWithPoint( mut this, Vec2f& p )
	{
		x.ExtendWithPoint( p.x );
		y.ExtendWithPoint( p.y );
		x_plus_y.ExtendWithPoint( p.x + p.y );
		x_minus_y.ExtendWithPoint( p.x - p.y );
	}

	fn ExtendWithOther( mut this, ClippingPolygon& p )
	{
		x.ExtendWithOther( p.x );
		y.ExtendWithOther( p.y );
		x_plus_y.ExtendWithOther( p.x_plus_y );
		x_minus_y.ExtendWithOther( p.x_minus_y );
	}

	fn ExtendInAllDirections( mut this, f32 delta )
	{
		x.ExtendInAllDirections( delta );
		y.ExtendInAllDirections( delta );
		x_minus_y.ExtendInAllDirections( delta );
		x_minus_y.ExtendInAllDirections( delta );
	}

	fn CalculateIntersection( this, ClippingPolygon& other ) : ClippingPolygon
	{
		return
			ClippingPolygon
			{
				.x= this.x.CalculateIntersection( other.x ),
				.y= this.y.CalculateIntersection( other.y ),
				.x_plus_y= this.x_plus_y.CalculateIntersection( other.x_plus_y ),
				.x_minus_y= this.x_minus_y.CalculateIntersection( other.x_minus_y ),
			};
	}

	fn PointIsInsideOrOnEdge( this, Vec2f& p ) : bool
	{
		return
			x.PointIsInsideOrOnEdge( p.x ) &&
			y.PointIsInsideOrOnEdge( p.y ) &&
			x_plus_y.PointIsInsideOrOnEdge( p.x + p.y ) &&
			x_minus_y.PointIsInsideOrOnEdge( p.x - p.y );
	}

	ClipAxis x;
	ClipAxis y;
	ClipAxis x_plus_y;
	ClipAxis x_minus_y;
}

struct ClipAxis
{
	fn CreateFromPoint( f32 p ) : ClipAxis
	{
		return ClipAxis{ .min= p, .max= p };
	}

	fn IsValidAndNonEmpty( this ) : bool
	{
		return min < max;
	}

	fn IsEmptyOrInvalid( this ) : bool
	{
		return !IsValidAndNonEmpty();
	}

	fn ExtendWithPoint( mut this, f32 p )
	{
		ust::min_assign( min, p );
		ust::max_assign( max, p );
	}

	fn ExtendWithOther( mut this, ClipAxis& other )
	{
		ust::min_assign( this.min, other.min );
		ust::max_assign( this.max, other.max );
	}

	fn ExtendInAllDirections( mut this, f32 delta )
	{
		min-= delta;
		max+= delta;
	}

	fn CalculateIntersection( this, ClipAxis& other ) : ClipAxis
	{
		return
			ClipAxis
			{
				.min= ust::max( this.min, other.min ),
				.max= ust::min( this.max, other.max ),
			};
	}

	fn PointIsInsideOrOnEdge( this, f32 p ) : bool
	{
		return p >= min && p <= max;
	}

	f32 min;
	f32 max;
}

} // namespace PM
