import "/shared_ptr_final.u"
import "/common_lib/game_params_file.uh"
import "game_filesystem.uh"

namespace PM
{

// This class performs game resources loading with some caching.
class CachedGameResourcesLoader
{
public:
	fn constructor( GameFilesystemPtr game_filesystem_ptr );

	fn LoadGameParams( mut this ) : GameResourcePtr</GameParams/>;

private:
	GameFilesystemPtr imut game_filesystem_;
	GameResourceNullablePtr</GameParams/> game_params_;
}

template</type T/>
type GameResourcePtr= ust::shared_ptr_final</T/>;

template</type T/>
type GameResourceNullablePtr= ust::shared_ptr_final_nullable</T/>;

} // namespace PM
