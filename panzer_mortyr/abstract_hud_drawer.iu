import "console_out.iu"
import "game_filesystem.iu"
import "hud_drawing_info.iu"
import "image_data.iu"

namespace PM
{

class AbstractHudDrawer abstract non_sync
{
public:
	fn constructor( [ u32, 2 ] viewport_size );

	fn Draw( mut this, HudDrawingInfo& drawing_info );

protected: // Methods below should be implemented by derived class(es).

	fn virtual pure AddTileQuad( mut this, i32 x, i32 y, HudDrawingInfo::IconIndex tile_index );
	fn virtual pure AddDigitQuad( mut this, i32 x, i32 y, u32 digit_index, bool alternative_color );

	fn virtual pure FlushDrawQuads( mut this );

protected:
	fn LoadAndPrepareHudImage(
		GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out ) : ust::optional</ ImageData />;

protected:
	var u32 constexpr c_num_tiles_x= 8u, constexpr c_num_tiles_y= 8u;
	var u32 constexpr c_tile_width= 32u, constexpr c_tile_height= 32u;

	var u32 constexpr c_num_digits_x= 16u, c_num_digits_y= 8u;
	var u32 constexpr c_digit_width= 16u, constexpr c_digit_height= 32u;

private:
	fn AddDecimalNumber( mut this, i32 right_x, i32 y, u32 num, bool alternative_color );

protected:
	[ u32, 2 ] imut viewport_size_;
	u32 imut scale_;
}

} // namespace PM
