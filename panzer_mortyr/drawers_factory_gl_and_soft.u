import "drawers_factory_gl_and_soft.iu"
import "drawing_gl/drawers_factory_gl.iu"
import "drawing_soft/drawers_factory_soft.iu"

namespace PM
{

fn CreateDrawersGLAndSoft(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : AbstractDrawers
{
	auto
	{
		mut window_gl : window,
		mut image_drawer_gl : image_drawer,
		mut hud_drawer_gl : hud_drawer,
		mut text_drawer_gl : text_drawer,
		mut world_drawer_gl : world_drawer,
		mut video_player_gl :video_player
	} = CreateDrawersGL( settings, caching_game_resources_loader, console_out );

	auto
	{
		mut window_soft : window,
		mut image_drawer_soft : image_drawer,
		mut hud_drawer_soft : hud_drawer,
		mut text_drawer_soft : text_drawer,
		mut world_drawer_soft : world_drawer,
		mut video_player_soft :video_player
	} = CreateDrawersSoft( settings, caching_game_resources_loader, console_out );

	auto viewport_size= window_gl.lock_imut().deref().GetViewportSize();

	return AbstractDrawers
	{
		.window= ust::make_shared_ptr( WindowMultiplexed( ust::make_array( move( window_gl ), move( window_soft ) ) ) ),
		.image_drawer=
			ust::make_box(
				ImageDrawerMultiplexed( ust::make_array( move(image_drawer_gl), move( image_drawer_soft ) ) ) ),
		.hud_drawer=
			ust::make_box(
				HudDrawerMultiplexed( viewport_size, ust::make_array( move(hud_drawer_gl), move(hud_drawer_soft) ) ) ),
		.text_drawer=
			ust::make_box( TextDrawerMultiplexed( ust::make_array( move(text_drawer_gl), move(text_drawer_soft) ) ) ),
		.world_drawer=
			ust::make_box(
				WorldDrawerMultiplexed( ust::make_array( move( world_drawer_gl ), move( world_drawer_soft ) ) ) ),
		.video_player=
			ust::make_box(
				VideoPlayerMuplitplexed(
					console_out, ust::make_array( move(video_player_gl), move(video_player_soft) ) ) ),
	};
}

class WindowMultiplexed final : AbstractWindow non_sync
{
	fn constructor( [ ust::shared_ptr_mut</AbstractWindow/>, 2 ] mut windows )
		( windows_= move(windows) )
	{}

public: // AbstractWindow
	fn virtual override GetViewportSize( this ) : [ u32, 2 ]
	{
		return windows_[0].lock_imut().deref().GetViewportSize();
	}

	fn virtual override SwapWindow( mut this )
	{
		foreach( &mut window_ptr : windows_ )
		{
			with( mut lock : window_ptr.lock_mut() )
			{
				lock.deref().SwapWindow();
			}
		}
	}

	fn virtual override MakeScreenshot( mut this ) : ImageData
	{
		with( mut lock : windows_[0].lock_mut() )
		{
			return lock.deref().MakeScreenshot();
		}
	}

	fn virtual override Fill( mut this, RGBAColor& color )
	{
		foreach( &mut window_ptr : windows_ )
		{
			with( mut lock : window_ptr.lock_mut() )
			{
				lock.deref().Fill( color );
			}
		}
	}

private:
	[ ust::shared_ptr_mut</AbstractWindow/>, 2 ] windows_;
}

class ImageDrawerMultiplexed final  : AbstractImageDrawer
{
public:
	fn constructor( [ ust::box</AbstractImageDrawer/>, 2 ] mut image_drawers )
		( image_drawers_= move( image_drawers ) )
	{}

public: // AbstractImageDrawer
	fn virtual override PreloadImage(
		mut this, ResourceString& image_file_name, ust::optional_ref_imut</ [ u8, 3 ] /> transparent_color )
	{
		foreach( &mut image_drawer_ptr : image_drawers_ )
		{
			image_drawer_ptr.deref().PreloadImage( image_file_name, transparent_color );
		}
	}

	fn virtual override GetImageSize( this, ResourceString& image_file_name ) : ust::optional</ [ u32, 2 ] />
	{
		foreach( &image_drawer_ptr : image_drawers_ )
		{
			if_var( &size : image_drawer_ptr.deref().GetImageSize( image_file_name ) )
			{
				return size;
			}
		}
		return ust::null_optional;
	}

	fn virtual override DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale )
	{
		foreach( &mut image_drawer_ptr : image_drawers_ )
		{
			image_drawer_ptr.deref().DrawImage( image_file_name, x, y, scale );
		}
	}

	fn virtual override DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale, u8 alpha )
	{
		foreach( &mut image_drawer_ptr : image_drawers_ )
		{
			image_drawer_ptr.deref().DrawImage( image_file_name, x, y, scale, alpha );
		}
	}

	fn virtual override DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y )
	{
		foreach( &mut image_drawer_ptr : image_drawers_ )
		{
			image_drawer_ptr.deref().DrawImage(
				image_file_name, x, y, scale, tc_offset_x, tc_offset_y, tc_size_x, tc_size_y );
		}
	}

	fn virtual override DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y,
		u8 alpha )
	{
		foreach( &mut image_drawer_ptr : image_drawers_ )
		{
			image_drawer_ptr.deref().DrawImage(
				image_file_name, x, y, scale, tc_offset_x, tc_offset_y, tc_size_x, tc_size_y, alpha );
		}
	}

	fn virtual override UploadAndDrawImage( mut this, ImageData& image_data, i32 x, i32 y, f32 scale )
	{
		foreach( &mut image_drawer_ptr : image_drawers_ )
		{
			image_drawer_ptr.deref().UploadAndDrawImage( image_data, x, y, scale );
		}
	}

private:
	[ ust::box</AbstractImageDrawer/>, 2 ] image_drawers_;
}

class TextDrawerMultiplexed final : AbstractTextDrawer
{
	fn constructor( [ ust::box</AbstractTextDrawer/>, 2 ] mut text_drawers )
		( text_drawers_= move(text_drawers) )
	{}

public:
	fn virtual override AddText( mut this, i32 x, i32 y, ust::string_view8 text, Settings& settings )
	{
		foreach( &mut text_drawer_ptr : text_drawers_ )
		{
			text_drawer_ptr.deref().AddText( x, y, text, settings );
		}
	}

	fn virtual override DrawTexts( mut this )
	{
		foreach( &mut text_drawer_ptr : text_drawers_ )
		{
			text_drawer_ptr.deref().DrawTexts();
		}
	}

private:
	[ ust::box</AbstractTextDrawer/>, 2 ] text_drawers_;
}

class HudDrawerMultiplexed final : AbstractHudDrawer
{
public:
	fn constructor( [ u32, 2 ] viewport_size, [ ust::box</AbstractHudDrawer/>, 2 ] mut hud_drawers )
		( base( viewport_size ), hud_drawers_= move(hud_drawers) )
	{}

protected: // AbstractHudDrawer
	fn virtual override AddTileQuad( mut this, i32 x, i32 y, HudDrawingInfo::IconIndex tile_index )
	{
		foreach( &mut hud_drawer_ptr : hud_drawers_ )
		{
			hud_drawer_ptr.deref().AddTileQuad( x, y, tile_index );
		}
	}

	fn virtual override AddDigitQuad( mut this, i32 x, i32 y, u32 digit_index, bool alternative_color )
	{
		foreach( &mut hud_drawer_ptr : hud_drawers_ )
		{
			hud_drawer_ptr.deref().AddDigitQuad( x, y, digit_index, alternative_color );
		}
	}

	fn virtual override FlushDrawQuads( mut this )
	{
		foreach( &mut hud_drawer_ptr : hud_drawers_ )
		{
			hud_drawer_ptr.deref().FlushDrawQuads();
		}
	}

protected:
	[ ust::box</AbstractHudDrawer/>, 2 ] hud_drawers_;
}

class WorldDrawerMultiplexed final : AbstractWorldDrawer
{
	fn constructor( [ ust::box</AbstractWorldDrawer/>, 2 ] mut drawers )
		( drawers_= move(drawers) )
	{}

public: // AbstractWorldDrawer
	fn virtual override Draw( mut this, WorldDrawingInfo& drawing_info ) : WorldDrawingStats
	{
		drawers_[1].deref().Draw( drawing_info );
		return drawers_[0].deref().Draw( drawing_info );
	}

private:
	[ ust::box</AbstractWorldDrawer/>, 2 ] drawers_;
}

class VideoPlayerMuplitplexed final : AbstractVideoPlayer
{
public:
	fn constructor( ConsoleOutPtr mut console_out, [ ust::box</AbstractVideoPlayer/>, 2 ] mut video_players )
		( base( move(console_out) ), video_players_= move(video_players) )
	{}

protected:
	fn virtual override SetFrame( mut this, [ u32, 2 ] size, ust::array_view_imut</RGBAColor/> pixels )
	{
		foreach( &mut video_player_ptr : video_players_ )
		{
			video_player_ptr.deref().SetFrame( size, pixels );
		}
	}

	fn virtual override DrawAndPresentFrame( mut this )
	{
		foreach( &mut video_player_ptr : video_players_ )
		{
			video_player_ptr.deref().DrawAndPresentFrame();
		}
	}

private:
	[ ust::box</AbstractVideoPlayer/>, 2 ] video_players_;
}

} // namesapce PM
