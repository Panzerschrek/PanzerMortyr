import "/hash_map.iu"
import "/shared_ptr_final.iu"
import "/common_lib/game_params_file.uh"
import "/common_lib/map_loading.uh"
import "/common_lib/maps_description_file.uh"
import "/common_lib/materials_file.uh"
import "entities_description_file.uh"
import "game_filesystem.uh"
import "room_clusters_hierarchy.uh"
import "materials_property_file.uh"

namespace PM
{

type CachingGameResourcesLoaderPtr= ust::shared_ptr_mut</CachingGameResourcesLoader/>;

// This class performs game resources loading with some caching.
class CachingGameResourcesLoader
{
public:
	fn constructor( GameFilesystemPtr game_filesystem_ptr, ConsoleOutPtr console_out );

	fn LoadGameParams( mut this ) : GameResourcePtr</GameParams/>;
	fn LoadMapsDescription( mut this ) : GameResourcePtr</MapsDescription/>;
	fn LoadMaterialsDescription( mut this ) : GameResourcePtr</MaterialsDescription/>;
	fn LoadMaterialsProperties( mut this ) : GameResourcePtr</MaterialsProperties/>;

	// We have several entity description files, but not many of them. So, cache them.
	// Use only uppercase names here!
	fn LoadEntitiesDescription( mut this, ResourceString& file_name ) : GameResourcePtr</EntitiesDescription/>;

	// Map file loading methods.
	// Only last used map is cached.
	// Returns null pointer if failed to load.

	fn LoadZmapFile( mut this, u32 map_index ) : GameResourceNullablePtr</ZmapData/>;
	fn LoadZvoxFile( mut this, u32 map_index ) : GameResourceNullablePtr</ZvoxData/>;
	fn LoadZpozFile( mut this, u32 map_index ) : GameResourceNullablePtr</ZpozData/>;
	fn LoadZmapLamFile( mut this, u32 map_index ) : GameResourceNullablePtr</ZmapLamData/>;
	fn LoadZmapLemFile( mut this, u32 map_index ) : GameResourceNullablePtr</ZmapLemData/>;
	fn LoadMapaWayFile( mut this, u32 map_index ) : GameResourceNullablePtr</MapaWayData/>;

	// A helper structure with clusters hierarchy is used both by game and rendering code.
	// So, cache it.
	fn LoadRoomClustersHierarchy( mut this, u32 map_index ) : GameResourceNullablePtr</RoomClustersHierarchy/>;

private:
	GameFilesystemPtr imut game_filesystem_;
	ConsoleOutPtr imut console_out_;

	GameResourceNullablePtr</GameParams/> game_params_;
	GameResourceNullablePtr</MapsDescription/> maps_description_;
	GameResourceNullablePtr</MaterialsDescription/> materials_description_;
	GameResourceNullablePtr</MaterialsProperties/> materials_properties_;

	ust::hash_map</ ResourceString, GameResourcePtr</EntitiesDescription/> /> entity_descriptions_;

	// Cached map files. First tuple value is map index.
	ust::optional</ tup[ u32, GameResourcePtr</ZmapData/> ] /> zmap_data_;
	ust::optional</ tup[ u32, GameResourcePtr</ZvoxData/> ] /> zvox_data_;
	ust::optional</ tup[ u32, GameResourcePtr</ZpozData/> ] /> zpoz_data_;
	ust::optional</ tup[ u32, GameResourcePtr</ZmapLamData/> ] /> zmap_lam_data_;
	ust::optional</ tup[ u32, GameResourcePtr</ZmapLemData/> ] /> zmap_lem_data_;
	ust::optional</ tup[ u32, GameResourcePtr</MapaWayData/> ] /> mapa_way_data_;
	ust::optional</ tup[ u32, GameResourcePtr</RoomClustersHierarchy/> ] /> room_clusters_hierarchy_;
}

template</type T/>
type GameResourcePtr= ust::shared_ptr_final</T/>;

template</type T/>
type GameResourceNullablePtr= ust::shared_ptr_final_nullable</T/>;

} // namespace PM
