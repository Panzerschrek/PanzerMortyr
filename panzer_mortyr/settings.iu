import "/path.iu"
import "/shared_ptr.iu"
import "console_out.iu"
import "key_binding.iu"

namespace PM
{

type SettingsPtr= ust::shared_ptr_mut</Settings/>;
type SettingsImutPtr= ust::shared_ptr_imut</Settings/>;

// This struct represents all settings in the game.
// It should contain only simple scalars (it's flat).
// Use name prefixes to distinguish between settings used by defferent subsystems.
//
// Typeinfo-based inspection is used for serialization and deserialization.
// It's also used in console.
//
// Provide default values, so that this struct remains default-constructible.
//
struct Settings
{
	// By-default use fullscreen mode.
	bool r_fullscreen= true;

	bool r_vsync= true;
	u32 r_max_fps= 240u;

	// Zero width and height has special meaning - it forces using current display resolution in fullscreen mode.
	u32 r_screen_width= 0u;
	u32 r_screen_height= 0u;

	// Allow selecting a display on systems having more than one display.
	u32 r_display_index= 0u;

	f32 r_gamma= 1.0f;

	// This setting allows tuning global brightness of the world.
	// Use default value slightly above 1 to be slightly brighter than the original game (it's sometimes too dark).
	f32 r_brightness_scale= 1.1f;

	bool r_fullbright= false;

	bool r_show_fps= false;
	bool r_show_stats= false;
	bool r_fixed_crosshair= false;

	// Use large default value for best quality.
	u32 r_texture_anisotropy= 8u;

	// The original game has linear textures filtration. So, make nearest filtration non-default.
	bool r_texture_nearest_filter= false;

	// Use trilinear textures filter as default for best quality.
	bool r_texture_trilinear_filter= true;

	// Enable dynamic lights by default. They aren't so costly in modern days.
	bool r_dynamic_lights_enabled= true;

	// Enable fog by default. It isn't too costly.
	bool r_fog_enabled= true;

	// Enable rain and snow by default. It isn't too costly.
	bool r_rain_snow_enabled= true;

	// Enable caustics by default. They are cheap.
	bool r_caustics_enabled= true;

	// Enable decals by default. They are cheap, unless there are a lot of them.
	bool r_decals_enabled= true;

	// Enable water circle decals by default. They require some calculations, but not too much.
	bool r_water_circle_decals_enabled= true;

	// There are only a handful of mirrors in the game. Enable them - they aren't too costly.
	bool r_mirrors_enabled= true;

	// Alpha for mirrors (in range 0 to 1).
	f32 r_mirror_alpha= 0.5f;

	// By-default use linear texture filter for HUD and GUI.
	bool r_gui_texture_nearest_filter= false;
	bool r_hud_texture_nearest_filter= false;

	bool r_debug_show_room_clusters_bsp_tree= false;
	bool r_debug_show_room_clusters_bsp_tree_projected_portals= false;
	bool r_debug_show_room_clusters_bsp_tree_projected_leaf_bounds= false;

	// A setting to disable startup cinematics.
	bool r_startup_cinematics_enabled= true;

	// By-default enable audio. Use this flag to force-disable it.
	bool snd_audio_enabled= true;

	// By-default use high quality.
	bool snd_high_quality= true;

	// Volume in range 0 to 1.
	f32 snd_volume= 0.5f;

	// Volume in range 0 to 1.
	f32 snd_ambient_volume= 0.5f;

	// Volume in range 0 to 1.
	f32 snd_music_volume= 0.5f;

	// By-default play ambient sounds.
	bool snd_ambient_sound_enabled= true;

	// True if left and right channels need to be swapped.
	bool snd_flip_stereo= false;

	// Enable character voice by default, but allow turning it off.
	bool snd_character_voice_enabled= true;

	bool snd_show_stats= false;

	// Game speed with 1 meaning normal speed. Allows speeding-up or slowing-down the game code, which is useful for debugging.
	f32 g_game_speed = 1.0f;

	// Extrapolation allows smooth movement of the camera and game objects.
	// Enable it by-default, since it looks nice.
	bool g_extrapolation_enabled= true;

	// Allow disabling blood effects via settings.
	bool g_blood_enabled= true;

	// Save last played map in settings. It's sometimes needed.
	u32 g_last_played_map_index= 0u;

	bool g_debug_show_entity_bounding_boxes= false;
	bool g_debug_sync_game_logic_steps= false;
	bool g_debug_highlight_enemies_seeing_player= false;
	bool g_debug_show_entity_target_navigation_graph_nodes= false;
	bool g_debug_show_entity_attack_targets= false;
	bool g_debug_show_entity_pickup_targets= false;
	bool g_debug_show_global_navigation_graph= false;
	bool g_debug_show_global_navigation_graph_around_player= false;
	bool g_debug_show_global_navigation_graph_patrolling_points= false;

	bool g_debug_global_navigation_graph_use_fast_but_incorrect_reachability_check= false;

	bool g_debug_show_quads_hierarchy= false;
	bool g_debug_show_room_clusters_hierarchy= false;
	size_type g_debug_bounding_boxes_hierarchy_level_to_show= 0s;

	bool g_debug_show_player_position_in_quads_hierarchy= false;

	bool in_mouse_enabled= true;

	// It's in range 0 to 1.
	// It should have exponential scale and the optimal value should be around 50.
	f32 in_mouse_sensitivity= 0.5f;

	bool in_invert_mouse_y_axis= false;

	// If is true, the player always runs and may walk by pressing walk/run key.
	bool in_always_run= true;

	KeyBinding in_key_attack= KeyBinding::CreateFromMouseButton( u32( SDL_BUTTON_LEFT ) );
	KeyBinding in_key_zoom= KeyBinding::CreateFromMouseButton( u32( SDL_BUTTON_RIGHT ) );

	KeyBinding in_key_move_forward= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_W );
	KeyBinding in_key_move_backward= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_S );
	KeyBinding in_key_move_left= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_A );
	KeyBinding in_key_move_right= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_D );
	KeyBinding in_key_move_up= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_SPACE );
	KeyBinding in_key_move_down= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_C );
	KeyBinding in_key_walk_or_run= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_LSHIFT );

	KeyBinding in_key_turn_left= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_LEFT );
	KeyBinding in_key_turn_right= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_RIGHT );
	KeyBinding in_key_turn_up= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_UP );
	KeyBinding in_key_turn_down= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_DOWN );

	KeyBinding in_key_weapon_kick= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_1 );
	KeyBinding in_key_weapon_a= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_2 );
	KeyBinding in_key_weapon_b= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_3 );
	KeyBinding in_key_weapon_c= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_4 );
	KeyBinding in_key_weapon_d= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_5 );
	KeyBinding in_key_weapon_e= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_6 );
	KeyBinding in_key_weapon_f= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_7 );
	KeyBinding in_key_weapon_g= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_8 );
	KeyBinding in_key_weapon_h= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_9 );
	KeyBinding in_key_weapon_i= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_0 );
	KeyBinding in_key_weapon_j= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_MINUS );

	KeyBinding in_key_kick= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_X );

	KeyBinding in_key_inventory_use= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_RETURN );
	KeyBinding in_key_inventory_previous= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_LEFTBRACKET );
	KeyBinding in_key_inventory_next= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_RIGHTBRACKET );
	KeyBinding in_key_acid_protection_suit= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_E ); // TODO - check if it's correct key (used by the original game).
	KeyBinding in_key_night_vision_activation= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_N );
	KeyBinding in_key_infrared_vision_activation= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_I );
	KeyBinding in_key_flashlight_activation= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_L );
	KeyBinding in_key_jetpack_activation= KeyBinding::CreateFromKeyboardKeyScancode( SDL_SCANCODE_J );
}

auto& c_default_settings_file_name= "panzer_mortyr.cfg";

fn LoadSettings( ust::filesystem_path_view file_path, ConsoleOutPtr& console_out ) : SettingsPtr;

fn SaveSettings( Settings& settings, ust::filesystem_path_view file_path, ConsoleOutPtr& console_out );

} // namespace PM
