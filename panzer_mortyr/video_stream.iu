import "/box_nullable.iu"
import "audio_stream.iu"
import "console_out.iu"
import "image_loading.iu"

namespace PM
{

// Use an interface for code actually opening and reading a video file.
// We need this, since we can't import generated Ü bindings for a video library in the same file where Ü bindings for SDL are imported
// ( due to name consflicts caused by C standard library names ).
// It's also needed if we need to build the project without any video library at all and use a stub instead.
//
class IVideoStream interface non_sync
{
	type FrameData= ust::vector</ RGBAColor />;

	fn virtual pure GetSize( this ) : [ u32, 2 ];

	// Returns width/height in physical units. May be different from size[0] / size[1] for non-square pixels.
	fn virtual pure GetAspectRatio( this ) : f32;

	// Returns framerate in frames per second.
	fn virtual pure GetFramerate( this ) : f32;

	// Call it frequently to populate the audio stream.
	// Returns a frame data if it's time to show a frame.
	fn virtual pure Update( mut this ) : ust::optional</FrameData/>;

	fn virtual pure EndOfStreamReached( this ) : bool;
}

// Returns a video stream instance and a read end of an audio stream.
// The returned video stream is synchronized via this audio stream,
// so you need to extract audio samples from the read end to advance the video playback.
fn OpenVideoStream( ConsoleOutPtr& console_out, ust::filesystem_path_view file_path )
	: ust::optional</ tup[ ust::box</IVideoStream/>, AudioStream::ReadEnd ] />;

} // namespace PM
