import "/sdl/sdl_with_opengl.uh"
import "gl_capabilities.uh"

namespace PM
{

fn GLCapabilities::Create() : GLCapabilities
{
	return GLCapabilities
	{
		.texture_anisotropy_supported=
			unsafe( SDL_GL_ExtensionSupported( $<( cast_mut( "GL_EXT_texture_filter_anisotropic\0"[0] ) ) ) ) != SDL_FALSE,
	};
}

} // namespace PM
