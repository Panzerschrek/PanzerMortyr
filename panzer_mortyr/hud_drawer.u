import "/enum_string_conversions.u"
import "/scoped_array.u"
import "buffer_utils.uh"
import "gl_functions.uh"
import "gl_state.uh"
import "hud_drawer.uh"
import "image_loading.uh"

namespace PM
{

fn HudDrawer::constructor(
	[ u32, 2 ] viewport_size,
	GameFilesystemPtr& game_filesystem_ptr,
	ConsoleOutPtr& console_out )
	(
		viewport_size_= viewport_size,
		shader_( embed</char8/>( "shaders/hud.vert.glsl" ), embed</char8/>( "shaders/hud.frag.glsl" ) ),
		vertex_buffer_= CreateHudVertexBuffer( c_max_buffer_size_quads ),
		index_buffer_= CreateQuadsU16IndexBuffer( c_max_buffer_size_quads ),
		hud_texture_atlas_= LoadHudTextureAtlas( game_filesystem_ptr, console_out ),
		buffered_quads_= zero_init,
		num_buffered_quads_= 0s,
	)
{
	vertex_array_object_.Bind();

	vertex_buffer_.Bind();

	var u32 c_position_attrib= 0u;
	var u32 c_tex_coord_attrib= 1u;

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );
	unsafe( glVertexAttribPointer(
		c_position_attrib,
		2,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ HudVertex />.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ HudVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( c_tex_coord_attrib ) );
	unsafe( glVertexAttribPointer(
		c_tex_coord_attrib,
		2,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ HudVertex />.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ HudVertex, "tex_coordinates" />() ) );
}

fn HudDrawer::Draw( mut this )
{
	AddQuad( 56.0f, 33.0f );

	FlushDrawQuads();
}

fn HudDrawer::AddQuad( mut this, f32 x, f32 y )
{
	if( num_buffered_quads_ >= c_max_buffer_size_quads )
	{
		// Perform flushing in case of buffer overflow.
		Draw();
	}

	var [ HudVertex, 4 ] &mut dst_quad= buffered_quads_[ num_buffered_quads_ ];
	++num_buffered_quads_;

	var f32 quad_width= ( 32.0f * 2.0f ) / f32( viewport_size_[0] );
	var f32 quad_height= ( 32.0f * 2.0f ) / f32( viewport_size_[1] );

	var f32 current_x= x / f32( viewport_size_[0] ) * 2.0f - 1.0f;
	var f32 current_y= y / f32( viewport_size_[1] ) * 2.0f - 1.0f;

	var f32 tc_x= 1.0f / 8.0f;
	var f32 tc_y= 5.0f / 8.0f;

	var f32 quad_tc_height= 1.0f / 8.0f;
	var f32 quad_tc_width = 1.0f / 8.0f;

	dst_quad[0]=
		HudVertex
		{
			.position[ current_x, current_y ],
			.tex_coordinates[ tc_x, tc_y ],
		};

	dst_quad[1]=
		HudVertex
		{
			.position[ current_x + quad_width, current_y ],
			.tex_coordinates[ tc_x + quad_tc_width, tc_y ],
		};

	dst_quad[2]=
		HudVertex
		{
			.position[ current_x + quad_width, current_y + quad_height ],
			.tex_coordinates[ tc_x + quad_tc_width, tc_y + quad_tc_height ],
		};

	dst_quad[3]=
		HudVertex
		{
			.position[ current_x, current_y + quad_height ],
			.tex_coordinates[ tc_x, tc_y + quad_tc_height ],
		};
}

fn HudDrawer::FlushDrawQuads( mut this )
{
	var size_type num_quads_to_draw= num_buffered_quads_;

	{
		vertex_buffer_.Bind();
		auto range= ust::array_view_imut</ [ HudVertex, 4 ] />( buffered_quads_ ).subrange_end( num_buffered_quads_ ).to_byte8_range();
		unsafe( glBufferSubData( GLenum( GL_ARRAY_BUFFER ), GLintptr(0), GLsizeiptr( range.size() ), range.data() ) );
		num_buffered_quads_= 0s;
	}

	SetGLState( g_hud_drawing_gl_state );

	var u32 texture_slot= 0u;

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	hud_texture_atlas_.Bind();

	shader_.Bind();
	shader_.SetUniform( "fu_texture", texture_slot );

	vertex_array_object_.Bind();
	index_buffer_.Bind();

	unsafe( glDrawElements(
		GLenum( GL_TRIANGLES ),
		GLsizei( num_quads_to_draw * 6s ),
		GLenum( GL_UNSIGNED_SHORT ),
		ust::nullptr</byte8/>() ) );
}

fn CreateHudVertexBuffer( size_type num_quads ) : BufferObject
{
	return
		BufferObject::CreateUninitializedDynamicDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ),
			num_quads * 4s * typeinfo</HudVertex/>.size_of );
}

fn LoadHudTextureAtlas( GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out ) : Texture
{
	auto mut lock= game_filesystem_ptr.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	result_match( game_filesystem.LoadFile( "PANEL.BMP\0\0\0\0\0\0\0", LoadImageBMP ) )
	{
		Ok( mut image_data ) ->
		{
			foreach( &mut pixel : image_data.pixels )
			{
				pixel[3]= 255u8;
			}

			var Texture texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
			texture.Bind();

			unsafe( glTexImage2D(
				GLenum( GL_TEXTURE_2D ),
				0,
				GLint( GL_RGBA8 ),
				GLsizei( image_data.size[0] ),
				GLsizei( image_data.size[1] ),
				0,
				GLenum( GL_RGBA ),
				GLenum( GL_UNSIGNED_BYTE ),
				ust::ptr_cast_to_byte8( image_data.pixels.data() ) ) );

			// Use linear filtration.
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR ) ) );
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );

			return texture;
		},
		Err(e) ->
		{
			ConsoleOutAddTextLine( console_out, ust::concat( "Failed to read image file! Error: ", ust::enum_to_string(e), "!" ) );
			halt;
		}
	}
}

var GLState g_hud_drawing_gl_state
{
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= true,
	.blend_source_factor( GL_SRC_ALPHA ),
	.blend_destination_factor( GL_ONE_MINUS_SRC_ALPHA ),
};

} // namespace PM
