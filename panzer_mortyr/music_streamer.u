import "/directory_iterator.iu"
import "/enum_string_conversions.iu"
import "/path_utils.iu"
import "/scoped_array.iu"
import "/common_lib/char_case.iu"
import "/common_lib/wav_header.iu"
import "music_streamer.iu"

namespace PM
{

fn MusicStreamer::constructor( ust::filesystem_path_view data_directory, ConsoleOutPtr mut console_out )
	( track_file_names_= SearchForTracks( data_directory, console_out ), console_out_= move( console_out ) )
{
}

fn MusicStreamer::Play( mut this, u32 track_index ) : ust::optional</ AudioStream::ReadEnd />
{
	active_track_.reset();

	if( size_type( track_index ) >= typeinfo</ TrackFileNames />.element_count )
	{
		return ust::null_optional;
	}

	var ust::filesystem_path_view track_file_name= track_file_names_[ track_index ];

	if( track_file_name.empty() )
	{
		return ust::null_optional;
	}

	auto mut file_res= ust::file_readable::open( track_file_name );
	if_var( e : file_res.as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out_,
			ust::concat( "Failed to open track \"", track_file_name, "\"! Error: ", ust::enum_to_string(e) ) );
		return ust::null_optional;
	}

	var ust::file_readable mut file= move(file_res).try_take();

	var WavHeader mut wav_header= zero_init;
	if_var( e : file.read_exact( ust::single_element_array_view( wav_header ).to_byte8_range() ).as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out_, ust::concat( "Failed to read WAV header! Error: ", ust::enum_to_string(e) ) );
		return ust::null_optional;
	}

	if( wav_header.block_size != 16u )
	{
		ConsoleOutAddTextLine( console_out_, "Format block size of WAV has unexpected size!" );
		return ust::null_optional;
	}

	var WavDataBlockHeader mut wav_data_block_header= zero_init;
	if_var( e :
		file.read_exact( ust::single_element_array_view( wav_data_block_header ).to_byte8_range() ).as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out_, ust::concat( "Failed to read WAV data header! Error: ", ust::enum_to_string(e) ) );
		return ust::null_optional;
	}

	if( !(
		wav_header.file_type_block_id == WavHeader::c_expected_file_type_block_id &&
		wav_header.file_format_id == WavHeader::c_expected_file_format_id &&
		wav_header.format_block_id == WavHeader::c_expected_format_block_id &&
		wav_data_block_header.data_block_id == WavDataBlockHeader::c_expected_data_block_id ) )
	{
		ConsoleOutAddTextLine( console_out_, "Not a WAV file!" );
		return ust::null_optional;
	}

	if( wav_header.audio_format != 1u16 )
	{
		ConsoleOutAddTextLine( console_out_, "Unsupported audio format of WAV file!" );
		return ust::null_optional;
	}

	if( wav_header.num_channels != 2u16 )
	{
		ConsoleOutAddTextLine( console_out_, "Unsupported number of channels in WAV file! Expected exactly 2 channels." );
		return ust::null_optional;
	}

	if( wav_header.bits_per_sample != 16u16 )
	{
		ConsoleOutAddTextLine( console_out_, "Unsupported bitrate in WAV file! Expected 16-bit." );
		return ust::null_optional;
	}

	auto [ mut write_end, mut read_end ]= AudioStream::Create( wav_header.frequency );

	active_track_=
		ActiveTrack
		{
			.file= move(file),
			.sample_pairs_left= wav_data_block_header.data_size / u32( 2s * typeinfo</i16/>.size_of ),
			.stream_write_end= move( write_end ),
		};

	return read_end;
}

fn MusicStreamer::Update( mut this )
{
	var bool mut need_to_remove_track= false;

	if_var( &mut active_track : active_track_ )
	{
		var u32 number_of_sample_pairs_in_queue= active_track.stream_write_end.GetNumberOfSamplesInQueue();

		if( number_of_sample_pairs_in_queue == 0u && active_track.sample_pairs_left == 0u )
		{
			// No more samples are left.
			need_to_remove_track= true;
		}
		else if( number_of_sample_pairs_in_queue < AudioStream::c_queue_size / 2u )
		{
			// Read more samples if less than half of capacity is left.

			var u32 sample_pairs_to_read=
				ust::min( AudioStream::c_queue_size - number_of_sample_pairs_in_queue, active_track.sample_pairs_left );
			if( sample_pairs_to_read > 0u )
			{
				sample_read_buffer_.resize(
					size_type( sample_pairs_to_read ), ust::make_zeroed</ AudioStream::SamplePairType />() );

				auto read_res= active_track.file.read_exact( sample_read_buffer_.range().to_byte8_range() );
				if( read_res.is_error() )
				{
					// An error occured. Stop playing to avoid encounting the same error again.
					need_to_remove_track= true;
				}
				else
				{
					// Should always be able to push samples, since we check for capacity before.
					var size_type num_sample_pairs_written=
						active_track.stream_write_end.WriteSamples( sample_read_buffer_ );
					ust::ignore_unused( num_sample_pairs_written );

					active_track.sample_pairs_left-= sample_pairs_to_read;
				}
			}
		}
	}

	if( need_to_remove_track )
	{
		active_track_.reset();
	}
}

fn MusicStreamer::SearchForTracks(
	ust::filesystem_path_view data_directory, ConsoleOutPtr& console_out ) : TrackFileNames
{
	ConsoleOutAddTextLine(
		console_out, ust::concat( "Searching for audio tracks in directory \"", data_directory, "\"." ) );

	var TrackFileNames mut track_file_names;

	auto mut it_res= ust::open_directory_for_iteration( data_directory );

	if_var( e : it_res.as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out,
			ust::concat( "Failed to open data directory for iteration! Error: ", ust::enum_to_string(e), "." ) );
		return track_file_names;
	}

	foreach( &entry_res : move( it_res ).try_take() )
	{
		if_var( &entry : entry_res.as_ref() )
		{
			// Search for something like "track0.wav". Ignore case.
			if( entry.name.size() == 10s &&
				ToLower( entry.name[0s] ) == 't' &&
				ToLower( entry.name[1s] ) == 'r' &&
				ToLower( entry.name[2s] ) == 'a' &&
				ToLower( entry.name[3s] ) == 'c' &&
				ToLower( entry.name[4s] ) == 'k' &&
				entry.name[5s] >= '0' && entry.name[5s] <= '9' &&
				ToLower( entry.name[6s] ) == '.' &&
				ToLower( entry.name[7s] ) == 'w' &&
				ToLower( entry.name[8s] ) == 'a' &&
				ToLower( entry.name[9s] ) == 'v' )
			{
				ConsoleOutAddTextLine( console_out, ust::concat( "Found a track file \"", entry.name, "\"." ) );

				track_file_names[ u32( entry.name[5s] ) - u32( '0' ) ]= ust::path::join( data_directory, entry.name );
			}
		}
		else if_var( e : entry_res.as_error_ref() )
		{
			ConsoleOutAddTextLine(
				console_out,
				ust::concat( "Failed to get directory entry! Error: ", ust::enum_to_string(e), "." ) );
		}
	}

	return track_file_names;
}

} // namespace PM
