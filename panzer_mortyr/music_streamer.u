import "/directory_iterator.iu"
import "/enum_string_conversions.iu"
import "/common_lib/char_case.iu"
import "music_streamer.iu"

namespace PM
{

fn MusicStreamer::constructor( ust::filesystem_path_view data_directory, ConsoleOutPtr& console_out )
	( track_file_names_= SearchForTracks( data_directory, console_out ) )
{
}

fn MusicStreamer::SearchForTracks(
	ust::filesystem_path_view data_directory, ConsoleOutPtr& console_out ) : TrackFileNames
{
	ConsoleOutAddTextLine(
		console_out, ust::concat( "Searching for audio tracks in directory \"", data_directory, "\"." ) );

	var TrackFileNames mut track_file_names;

	auto mut it_res= ust::open_directory_for_iteration( data_directory );

	if_var( e : it_res.as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out,
			ust::concat( "Failed to open data directory for iteration! Error: ", ust::enum_to_string(e), "." ) );
		return track_file_names;
	}

	foreach( &entry_res : move( it_res ).try_take() )
	{
		if_var( &entry : entry_res.as_ref() )
		{
			// Search for something like "track0.wav". Ignore case.
			if( entry.name.size() == 10s &&
				ToLower( entry.name[0s] ) == 't' &&
				ToLower( entry.name[1s] ) == 'r' &&
				ToLower( entry.name[2s] ) == 'a' &&
				ToLower( entry.name[3s] ) == 'c' &&
				ToLower( entry.name[4s] ) == 'k' &&
				entry.name[5s] >= '0' && entry.name[5s] <= '9' &&
				ToLower( entry.name[6s] ) == '.' &&
				ToLower( entry.name[7s] ) == 'w' &&
				ToLower( entry.name[8s] ) == 'a' &&
				ToLower( entry.name[9s] ) == 'v' )
			{
				ConsoleOutAddTextLine( console_out, ust::concat( "Found a track file \"", entry.name, "\"." ) );

				track_file_names[ u32( entry.name[5s] ) - u32( '0' ) ]= entry.name;
			}
		}
		else if_var( e : entry_res.as_error_ref() )
		{
			ConsoleOutAddTextLine(
				console_out,
				ust::concat( "Failed to get directory entry! Error: ", ust::enum_to_string(e), "." ) );
		}
	}

	return track_file_names;
}

} // namespace PM
