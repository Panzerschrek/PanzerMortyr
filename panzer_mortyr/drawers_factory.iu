import "abstract_hud_drawer.iu"
import "abstract_image_drawer.iu"
import "abstract_text_drawer.iu"
import "abstract_video_player.iu"
import "abstract_window.iu"
import "abstract_world_drawer.iu"

namespace PM
{

struct AbstractDrawers
{
	ust::shared_ptr_mut</AbstractWindow/> window;
	ust::box</AbstractImageDrawer/> image_drawer;
	ust::box</AbstractHudDrawer/> hud_drawer;
	ust::box</AbstractTextDrawer/> text_drawer;
	ust::box</AbstractWorldDrawer/> world_drawer;
	ust::box</AbstractVideoPlayer/> video_player;
}

fn CreateDrawers(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : AbstractDrawers;

} // namespace PM
