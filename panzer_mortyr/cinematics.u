import "/path_utils.iu"
import "cinematics.iu"

namespace PM
{

fn PlayStartupCinematics(
	CachingGameResourcesLoaderPtr& caching_game_resoruces_loader,
	VideoPlayer &mut video_player,
	OpenGLWindow &mut window )
{
	var GameResourcePtr</GameParams/> game_params_ptr= GetGameParams( caching_game_resoruces_loader );
	auto& cinematics= game_params_ptr.deref().cinematics;

	// Assume all cinematics except the last two to be startup cinematics.

	if( cinematics.size() < 2s )
	{
		return;
	}

	var size_type num_startup_cinematics= cinematics.size() - 2s;

	var ust::filesystem_path data_directory= GetDataDirectory( caching_game_resoruces_loader );

	// TODO - check if this order is correct.
	foreach( &cinematic : cinematics.range().subrange_end( num_startup_cinematics ) )
	{
		video_player.PlayVideo( ust::path::join( data_directory, cinematic ), window );
	}
}

fn PlayIntroCinematic(
	CachingGameResourcesLoaderPtr& caching_game_resoruces_loader,
	VideoPlayer &mut video_player,
	OpenGLWindow &mut window )
{
	var GameResourcePtr</GameParams/> game_params_ptr= GetGameParams( caching_game_resoruces_loader );
	auto& cinematics= game_params_ptr.deref().cinematics;

	// Assume the intro cinematic to be the second last one.

	if( cinematics.size() < 2s )
	{
		return;
	}

	video_player.PlayVideo(
		ust::path::join( GetDataDirectory( caching_game_resoruces_loader ), cinematics[ cinematics.size() - 2s ] ),
		window );
}

fn PlayOutroCinematic(
	CachingGameResourcesLoaderPtr& caching_game_resoruces_loader,
	VideoPlayer &mut video_player,
	OpenGLWindow &mut window )
{
	var GameResourcePtr</GameParams/> game_params_ptr= GetGameParams( caching_game_resoruces_loader );
	auto& cinematics= game_params_ptr.deref().cinematics;

	// Assume the outro cinematic to be the last onee.

	if( cinematics.empty()  )
	{
		return;
	}

	video_player.PlayVideo(
		ust::path::join( GetDataDirectory( caching_game_resoruces_loader ), cinematics.back() ), window );
}

fn GetGameParams( CachingGameResourcesLoaderPtr& caching_game_resources_loader_ptr ) : GameResourcePtr</GameParams/>
{
	auto mut lock= caching_game_resources_loader_ptr.lock_mut();
	return lock.deref().LoadGameParams();
}

fn GetDataDirectory( CachingGameResourcesLoaderPtr& caching_game_resources_loader_ptr ) : ust::filesystem_path
{
	return
		caching_game_resources_loader_ptr
			.lock_imut()
			.deref()
			.GetGameFilesystem()
			.lock_imut()
			.deref()
			.GetDataDirectory();
}

} // namespace PM
