import "cinematics.iu"

namespace PM
{

fn PlayStartupCinematics(
	GameParams& game_params, GameFilesystem& game_filesystem, VideoPlayer &mut video_player, OpenGLWindow &mut window )
{
	// Assume all cinematics except the last two to be startup cinematics.

	if( game_params.cinematics.size() < 2s )
	{
		return;
	}

	var size_type num_startup_cinematics= game_params.cinematics.size() - 2s;

	var ust::filesystem_path_view data_directory= game_filesystem.GetDataDirectory();

	// TODO - check if this order is correct.
	foreach( &cinematic : game_params.cinematics.range().subrange_end( num_startup_cinematics ) )
	{
		video_player.PlayVideo( ust::path::join( data_directory, cinematic ), window );
	}
}

fn PlayIntroCinematic(
	GameParams& game_params, GameFilesystem& game_filesystem, VideoPlayer &mut video_player, OpenGLWindow &mut window )
{
	// Assume into to be the second last cinematic.

	if( game_params.cinematics.size() < 2s )
	{
		return;
	}

	video_player.PlayVideo(
		ust::path::join(
			game_filesystem.GetDataDirectory(),
			game_params.cinematics[ game_params.cinematics.size() - 2s ] ),
		window );
}

fn PlayOutroCinematic(
	GameParams& game_params, GameFilesystem& game_filesystem, VideoPlayer &mut video_player, OpenGLWindow &mut window )
{
	// Assume outro to be the last cinematic.

	if( game_params.cinematics.empty()  )
	{
		return;
	}

	video_player.PlayVideo(
		ust::path::join( game_filesystem.GetDataDirectory(), game_params.cinematics.back() ), window );
}

} // namespace PM
