import "/sdl/sdl_with_opengl.iu"

namespace PM
{

// Use array of fixed size representing all scan-codes.
type KeyboardState= [ bool, SDL_NUM_SCANCODES ];

static_assert( typeinfo</ KeyboardState />.size_of <= 1024s, "It's too big! Consider using something more compact!" );

struct InputState
{
	KeyboardState keyboard_state;
	u32 mouse_buttons_state;
	[ i32, 2 ] mouse_motion;
}

} // namespace PM
