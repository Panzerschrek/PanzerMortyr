import "/variant.iu"
import "/sdl/sdl_with_opengl.iu"
import "game_filesystem.iu"
import "console_out.iu"

namespace PM
{

// Owning container containing sound samples in given format.
template</type SampleType/>
class SoundData
{
public:
	// Given data pointer should be correct and should allow accessing "num_samples" samples.
	// It should be created via SDL_LoadWAV_RW call.
	fn constructor( u32 frequency, $(SampleType) data_ptr, u32 num_samples ) unsafe
		( frequency_= frequency, data_ptr_= data_ptr, num_samples_= num_samples )
	{}

	fn destructor()
	{
		unsafe( SDL_FreeWAV( ust::byte_ptr_cast</Uint8/>( ust::ptr_cast_to_byte8( data_ptr_ ) ) ) );
	}

	fn GetSamples( this ) : ust::array_view_imut</SampleType/>
	{
		return unsafe( ust::array_view_imut</SampleType/>( data_ptr_, size_type(num_samples_) ) );
	}

	fn GetFrequency( this ) : u32
	{
		return frequency_;
	}

private:
	u32 frequency_;
	$(SampleType) data_ptr_;
	u32 num_samples_;
}

// The original game has sound files with samples in u8 and i16 format.
type SoundDataAbstract= ust::variant</ tup[ SoundData</u8/>, SoundData</i16/> ] />;

fn LoadSoundData(
	ConsoleOutPtr& console_out,
	GameFilesystem &mut game_filesystem,
	ResourceString& file_name ) : ust::optional</SoundDataAbstract/>;

} // namespace PM
