import "breaking_glass.iu"
import "map_quad_utils.iu"
import "mat.iu"

namespace PM
{

fn CreateBreakingGlassShards(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads,
	MaterialsDescription::Block& materials_block,
	WorldDrawingInfo::BreakingGlass& breaking_glass,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	var ZvoxCluster& cluster= clusters[ size_type( breaking_glass.cluster_index ) ];
	var ZmapQuad& quad= quads[ size_type( breaking_glass.quad_index ) ];

	auto& center= cluster.c.center;
	auto& in_vertices= quad.vertices;

	auto [ u_vec, v_vec ]= CalculateMapQuadTextureBasis( quad, true );

	var Vec2f tc_offset( f32( quad.tc_offset[0] ), f32( quad.tc_offset[1] ) );

	// OpenGL uses normalized texture coordinates.
	var f32 constexpr tc_scale= 1.0f / f32( MaterialsDescription::c_texture_size );

	auto mut i= 0s;
	auto calc_vertices=
		lambda[&]() : GlassShardVertex
		{
			auto& v= in_vertices[i];
			++i;

			var Vec3f relative_shift(
				f32( i32( v[0] ) - i32( in_vertices[0][0] ) ),
				f32( i32( v[1] ) - i32( in_vertices[0][1] ) ),
				f32( i32( v[2] ) - i32( in_vertices[0][2] ) )
			);

			return GlassShardVertex
			{
				.position(
					f32( center[0] + i32( v[0] ) ),
					f32( center[1] + i32( v[1] ) ),
					f32( center[2] + i32( v[2] ) ) ),
				.texture_coordinates(
					tc_scale * ( relative_shift.Dot( u_vec ) + tc_offset.x ),
					tc_scale * ( relative_shift.Dot( v_vec ) + tc_offset.y ) )
			};
		};

	var [ GlassShardVertex, 4 ] vertices[ calc_vertices() ... ];

	var Vec3f hit_position_relative_shift=
		breaking_glass.hit_position -
		Vec3f( f32( center[0] ), f32( center[1] ), f32( center[2] ) ) -
		Vec3f( f32( in_vertices[0][0] ), f32( in_vertices[0][1] ), f32( in_vertices[0][2] ) );

	var GlassShardVertex hit_vertex
	{
		.position= breaking_glass.hit_position,
		.texture_coordinates(
			tc_scale * ( hit_position_relative_shift.Dot( u_vec ) + tc_offset.x ),
			tc_scale * ( hit_position_relative_shift.Dot( v_vec ) + tc_offset.y ) )
	};

	var u32 texture_layer=
		( u32( quad.texture_id ) == MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ]
			? materials_block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ]
			: u32( quad.texture_id ) );

	var Vec3f normal=
		( vertices[0].position - vertices[1].position ).Cross( vertices[1].position - vertices[2].position ) +
		( vertices[1].position - vertices[2].position ).Cross( vertices[2].position - vertices[3].position ) +
		( vertices[2].position - vertices[3].position ).Cross( vertices[3].position - vertices[0].position ) +
		( vertices[3].position - vertices[0].position ).Cross( vertices[0].position - vertices[1].position );

	var f32 normal_length= normal.Length();
	if( normal_length == 0.0f )
	{
		return;
	}

	var BreakingGlassContext context
	{
		.hit_position= breaking_glass.hit_position,
		.age= breaking_glass.age,
		.texture_layer( texture_layer ),
		.plane_normal_normalized= normal / normal_length,
	};

	MakeShardBaseTriangles_r( context, hit_vertex, vertices[0], vertices[1], out_vertices, out_indices );
	MakeShardBaseTriangles_r( context, hit_vertex, vertices[1], vertices[2], out_vertices, out_indices );
	MakeShardBaseTriangles_r( context, hit_vertex, vertices[2], vertices[3], out_vertices, out_indices );
	MakeShardBaseTriangles_r( context, hit_vertex, vertices[3], vertices[0], out_vertices, out_indices );
}

struct BreakingGlassContext
{
	Vec3f hit_position;
	f32 age;
	f32 texture_layer;
	Vec3f plane_normal_normalized;
}

struct GlassShardVertex
{
	Vec3f position;
	Vec2f texture_coordinates;
}

fn MakeShardBaseTriangles_r(
	BreakingGlassContext& context,
	GlassShardVertex& v0,
	GlassShardVertex& v1,
	GlassShardVertex& v2,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	// Split base triangles recursively until we don't have pretty sharp angles.

	var f32 constexpr c_min_length_to_split= 8.0f;
	var f32 constexpr c_max_angle_cos= 0.75f;

	if( ( v2.position - v1.position ).SquareLength() >= c_min_length_to_split * c_min_length_to_split )
	{
		var Vec3f edge1= v1.position - v0.position;
		var Vec3f edge2= v2 .position- v0.position;

		var f32 edges_length_product= ust::sqrt( edge1.SquareLength() * edge2.SquareLength() );

		if( edge1.Dot( edge2 ) <= c_max_angle_cos * edges_length_product )
		{
			var GlassShardVertex middle
			{
				.position= ( v1.position + v2.position ) * 0.5f,
				.texture_coordinates= ( v1.texture_coordinates + v2.texture_coordinates ) * 0.5f,
			};
			MakeShardBaseTriangles_r( context, v0, v1, middle, out_vertices, out_indices );
			MakeShardBaseTriangles_r( context, v0, middle, v2, out_vertices, out_indices );
			return;
		}
	}

	MakeShardTriangles_r( context, v0, v1, v2, out_vertices, out_indices );
}

fn MakeShardTriangles_r(
	BreakingGlassContext& context,
	GlassShardVertex& v0,
	GlassShardVertex& v1,
	GlassShardVertex& v2,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	// Split too large triangles recursively.
	{
		var f32 constexpr c_max_length= 32.0f;
		var f32 constexpr c_max_square_length= c_max_length * c_max_length;

		var f32 l0= ( v1.position - v2.position ).SquareLength();
		var f32 l1= ( v0.position - v2.position ).SquareLength();
		var f32 l2= ( v0.position - v1.position ).SquareLength();
		if( l0 >= l1 && l0 >= l2 )
		{
			if( l0 > c_max_square_length )
			{
				var GlassShardVertex middle= MixGlassShardVertices( v1, v2, 0.6f );
				MakeShardTriangles_r( context, v0, v1, middle, out_vertices, out_indices );
				MakeShardTriangles_r( context, v0, middle, v2, out_vertices, out_indices );
				return;
			}
		}
		else if( l1 >= l0 && l1 >= l2 )
		{
			if( l1 > c_max_square_length )
			{
				var GlassShardVertex middle= MixGlassShardVertices( v0, v2, 0.55f );
				MakeShardTriangles_r( context, v1, v0, middle, out_vertices, out_indices );
				MakeShardTriangles_r( context, v1, middle, v2, out_vertices, out_indices );
				return;
			}
		}
		else
		{
			if( l2 > c_max_square_length )
			{
				var GlassShardVertex middle= MixGlassShardVertices( v0, v1, 0.35f );
				MakeShardTriangles_r( context, v2, v0, middle, out_vertices, out_indices );
				MakeShardTriangles_r( context, v2, middle, v1, out_vertices, out_indices );
				return;
			}
		}
	}

	MakeShardTriangle( context, v0, v1, v2, out_vertices, out_indices );
}

fn MixGlassShardVertices( GlassShardVertex& v0, GlassShardVertex& v1, f32 factor ) : GlassShardVertex
{
	var f32 one_minus_factor= 1.0f - factor;
	return GlassShardVertex
	{
		.position= v0.position * factor + v1.position * one_minus_factor,
		.texture_coordinates= v0.texture_coordinates * factor + v1.texture_coordinates * one_minus_factor,
	};
}

fn MakeShardTriangle(
	BreakingGlassContext& context,
	GlassShardVertex& v0,
	GlassShardVertex& v1,
	GlassShardVertex& v2,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	var Vec3f center= 0.333333333f * ( v0.position + v1.position + v2.position );
	var Vec3f vec_to_center= center - context.hit_position;
	var f32 distance_to_center= vec_to_center.Length();

	var f32 constexpr c_delay_distance_scale= 1.0f / 2048.0f;

	var f32 delay= distance_to_center * c_delay_distance_scale;

	var f32 relative_age= ust::max( 0.0f, context.age - delay );

	var f32 constexpr c_vertical_acceleration= 6144.0f;
	var f32 constexpr c_horizontal_speed= 144.0f;

	var Vec3f offset=
		( relative_age * c_horizontal_speed ) * context.plane_normal_normalized +
		Vec3f( 0.0f, 0.0f, relative_age * relative_age * ( c_vertical_acceleration / 2.0f ) );

	var f32 rotation_speed= 2048.0f / ( distance_to_center + 16.0f );
	var f32 rotation_angle= relative_age * rotation_speed;

	var Vec3f rotation_axis= vec_to_center.Cross( context.plane_normal_normalized );
	var f32 rotation_axis_length= rotation_axis.Length();

	var Mat4f mut rotation_matrix=
		( rotation_axis_length == 0.0f
			? Mat4f::MakeIdentity() :
			Mat4f::MakeRotationAroundNormalizedAxis( rotation_axis / rotation_axis_length, rotation_angle ) );

	var Mat4f matrix=
		Mat4f::MakeTranslation( -center ) *
		rotation_matrix *
		Mat4f::MakeTranslation( offset + center );

	var [ Vec3f, 3 ] positions_transformed
	[
		v0.position * matrix,
		v1.position * matrix,
		v2.position * matrix,
	];

	var [ Vec2f, 3 ] tex_coords[ v0.texture_coordinates, v1.texture_coordinates, v2.texture_coordinates ];

	var size_type base_vertex= out_vertices.size();

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var Vec3f& v= positions_transformed[i];
		var Vec2f& tc= tex_coords[i];

		out_vertices.push_back(
			MapVertex
			{
				.position[ v.x, v.y, v.z ],
				.light[ 255u8 ... ],
				.padding15= zero_init,
				.tex_coordinates[ tc.x, tc.y, context.texture_layer ],
				.padding31= zero_init,
			}
		);
	}

	out_indices.push_back( u16( base_vertex + 0s ) );
	out_indices.push_back( u16( base_vertex + 1s ) );
	out_indices.push_back( u16( base_vertex + 2s ) );
}

} // namespace PM
