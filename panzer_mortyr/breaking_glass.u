import "breaking_glass.iu"

namespace PM
{

fn CreateBreakingGlassShards(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads,
	WorldDrawingInfo::BreakingGlass& breaking_glass,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	var ZvoxCluster& cluster= clusters[ size_type( breaking_glass.cluster_index ) ];
	var ZmapQuad& quad= quads[ size_type( breaking_glass.quad_index ) ];

	auto& center= cluster.c.center;
	auto& in_vertices= quad.vertices;

	var [ Vec3f, 4 ] vertices
	[
		( f32( center[0] + i32( in_vertices[0][0] ) ), f32( center[1] + i32( in_vertices[0][1] ) ), f32( center[2] + i32( in_vertices[0][2] ) ) ),
		( f32( center[0] + i32( in_vertices[1][0] ) ), f32( center[1] + i32( in_vertices[1][1] ) ), f32( center[2] + i32( in_vertices[1][2] ) ) ),
		( f32( center[0] + i32( in_vertices[2][0] ) ), f32( center[1] + i32( in_vertices[2][1] ) ), f32( center[2] + i32( in_vertices[2][2] ) ) ),
		( f32( center[0] + i32( in_vertices[3][0] ) ), f32( center[1] + i32( in_vertices[3][1] ) ), f32( center[2] + i32( in_vertices[3][2] ) ) ),
	];

	var f32 texture_layer= 57.0f;

	var BreakingGlassContext context
	{
		.hit_position= breaking_glass.hit_position,
		.age= breaking_glass.age,
		.texture_layer= texture_layer,
	};

	MakeShardBaseTriangles_r( context, breaking_glass.hit_position, vertices[0], vertices[1], out_vertices, out_indices );
	MakeShardBaseTriangles_r( context, breaking_glass.hit_position, vertices[1], vertices[2], out_vertices, out_indices );
	MakeShardBaseTriangles_r( context, breaking_glass.hit_position, vertices[2], vertices[3], out_vertices, out_indices );
	MakeShardBaseTriangles_r( context, breaking_glass.hit_position, vertices[3], vertices[0], out_vertices, out_indices );
}

struct BreakingGlassContext
{
	Vec3f hit_position;
	f32 age;
	f32 texture_layer;
}

fn MakeShardBaseTriangles_r(
	BreakingGlassContext& context,
	Vec3f& v0,
	Vec3f& v1,
	Vec3f& v2,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	// Split base triangles recursively until we don't have pretty sharp angles.

	var f32 constexpr c_min_length_to_split= 8.0f;
	var f32 constexpr c_max_angle_cos= 0.75f;

	if( ( v2 - v1 ).SquareLength() >= c_min_length_to_split * c_min_length_to_split )
	{
		var Vec3f edge1= v1 - v0;
		var Vec3f edge2= v2 - v0;

		var f32 edges_length_product= ust::sqrt( edge1.SquareLength() * edge2.SquareLength() );

		if( edge1.Dot( edge2 ) <= c_max_angle_cos * edges_length_product )
		{
			var Vec3f middle= ( v1 + v2 ) * 0.5f;
			MakeShardBaseTriangles_r( context, v0, v1, middle, out_vertices, out_indices );
			MakeShardBaseTriangles_r( context, v0, v2, middle, out_vertices, out_indices );
			return;
		}
	}

	MakeShardTriangles_r( context, v0, v1, v2, out_vertices, out_indices );
}

fn MakeShardTriangles_r(
	BreakingGlassContext& context,
	Vec3f& v0,
	Vec3f& v1,
	Vec3f& v2,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	// Split too large triangles recursively.
	{
		var f32 constexpr c_max_length= 32.0f;
		var f32 constexpr c_max_square_length= c_max_length * c_max_length;

		var f32 l0= ( v1 - v2 ).SquareLength();
		var f32 l1= ( v0 - v2 ).SquareLength();
		var f32 l2= ( v0 - v1 ).SquareLength();
		if( l0 >= l1 && l0 >= l2 )
		{
			if( l0 > c_max_square_length )
			{
				var Vec3f middle= ( v1 + v2 ) * 0.5f;
				MakeShardTriangles_r( context, v0, v1, middle, out_vertices, out_indices );
				MakeShardTriangles_r( context, v0, v2, middle, out_vertices, out_indices );
				return;
			}
		}
		else if( l1 >= l0 && l1 >= l2 )
		{
			if( l1 > c_max_square_length )
			{
				var Vec3f middle= ( v0 + v2 ) * 0.5f;
				MakeShardTriangles_r( context, v1, v0, middle, out_vertices, out_indices );
				MakeShardTriangles_r( context, v1, v2, middle, out_vertices, out_indices );
				return;
			}
		}
		else
		{
			if( l2 > c_max_square_length )
			{
				var Vec3f middle= ( v0 + v1 ) * 0.5f;
				MakeShardTriangles_r( context, v2, v0, middle, out_vertices, out_indices );
				MakeShardTriangles_r( context, v2, v1, middle, out_vertices, out_indices );
				return;
			}
		}
	}

	var Vec3f center= 0.333333333f * ( v0 + v1 + v2 );
	var Vec3f vec_to_center= center - context.hit_position;

	var Vec3f offset= vec_to_center * context.age;

	var [ Vec3f, 3 ] vertices_transformed
	[
		v0 + offset,
		v1 + offset,
		v2 + offset,
	];

	var size_type base_vertex= out_vertices.size();

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var Vec3f& v= vertices_transformed[i];
		out_vertices.push_back(
			MapVertex
			{
				.position[ v.x, v.y, v.z ],
				.light[ 255u8 ... ],
				.padding15= zero_init,
				.tex_coordinates[ 0.0f, 0.0f, context.texture_layer ],
				.padding31= zero_init,
			}
		);
	}

	out_indices.push_back( u16( base_vertex + 0s ) );
	out_indices.push_back( u16( base_vertex + 1s ) );
	out_indices.push_back( u16( base_vertex + 2s ) );
}

} // namespace PM
