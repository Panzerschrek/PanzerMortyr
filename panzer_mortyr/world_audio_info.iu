import "/vector.iu"
import "/common_lib/resource_string.iu"
import "unique_sound_source_id.iu"

namespace PM
{

struct WorldAudioInfo
{
	ust::vector</SoundSource/> sound_sources;

	// We have the fixed numbers of ambient sounds.
	// They are always playing, but only one or two of them have non-zero volume at any given moment.
	var size_type c_num_ambient_sounds= 8s;
	[ AmbientSound, c_num_ambient_sounds ] ambient_sounds;

	struct SoundSource
	{
		UniqueSoundSourceId id;

		[ f32, 2 ] volume;

		u8 sound_index; // The number from the GLOS.STD file.
	}

	struct AmbientSound
	{
		ResourceString file_name;
		[ f32, 2 ] volume;
	}
}

} // namespace PM
