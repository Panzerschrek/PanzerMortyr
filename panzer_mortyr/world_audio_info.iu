import "/vector.iu"
import "/common_lib/resource_string.iu"

namespace PM
{

struct WorldAudioInfo
{
	ust::vector</SoundSource/> sound_sources;

	// Sound sources are identified by unique numbers.
	// Having a source with an ID equal to previoisly-known one means that this is the same source.
	// 32-bit is practially enough for such identification.
	type UniqueSoundSourceId= u32;

	struct SoundSource
	{
		UniqueSoundSourceId id;

		[ f32, 2 ] volume;

		ResourceString file_name; // TODO - use the number from GLOS.STD file instead to save space?
	}
}

} // namespace PM
