import "/sdl/sdl_with_opengl.iu"

namespace PM
{

// Do not bother setting various OpenGL state variables one by one.
// Just do it in one call and represent OpenGL state (at least it's subset used) via the following structure.
//
// Keep it constexpr type to allow construction of global constants of this type.
//
struct GLState
{
	bool depth_test_enabled;
	GLenum depth_test_func;

	bool depth_write_enabled;

	bool cull_face_enabled;
	GLenum cull_face;

	bool blending_enabled;
	GLenum blend_source_factor;
	GLenum blend_destination_factor;
}

fn SetGLState( GLState& state );

} // namespace PM
