import "/box.iu"
import "/sdl/sdl_with_opengl.iu"
import "console.iu"

namespace PM
{

class AudioOut
{
public:
	fn constructor( ConsoleOutPtr& console_out );
	fn destructor();

private:
	// Use box to have stable address, since we pass a raw pointer to it into the audio thread.
	ust::box</AudioThreadData/> audio_thread_data_;

	SDL_AudioDeviceID device_id_;
}

struct AudioThreadData
{
	u32 sample_rate;
	u32 sample_counter;
}

static_assert( !non_sync</AudioThreadData/>, "Audio thrad data type should remain non-sync to prevent race conditions!" );

} // namespace PM
