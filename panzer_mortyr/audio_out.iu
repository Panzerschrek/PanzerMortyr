import "/box.iu"
import "/shared_ptr_mt.iu"
import "/sdl/sdl_with_opengl.iu"
import "console.iu"

namespace PM
{

class AudioOut
{
public:
	fn constructor( ConsoleOutPtr& console_out, AudioThreadSharedDataPtr audio_thread_shared_data_ptr );
	fn destructor();

private:
	// Use box to have stable address, since we pass a raw pointer to it into the audio thread.
	ust::box</AudioThreadData/> audio_thread_data_;

	SDL_AudioDeviceID device_id_;
}

// TODO - use some lock-free structure instead of shared_ptr_mt, which contains blocking RW-lock inside.
type AudioThreadSharedDataPtr= ust::shared_ptr_mt_mut</AudioThreadSharedData/>;

// This struct represents a communication channel with the thread performing actual audio outputting and mixing.
struct AudioThreadSharedData
{
}

struct AudioThreadData
{
	AudioThreadSharedDataPtr shared_data;

	u32 sample_rate;
	u32 sample_counter;
}

static_assert( !non_sync</AudioThreadData/>, "Audio thread data type should remain non-sync to prevent race conditions!" );

} // namespace PM
