import "/box.iu"
import "/sdl/sdl_with_opengl.iu"
import "audio_mixer.iu"
import "console.iu"
import "settings.iu"

namespace PM
{

// This class is just a tiny wrapper which opens an audio device and creates a thread where sound mixing actualy takes place.
class AudioOut
{
public:
	fn constructor(
		ConsoleOutPtr& console_out, Settings& settings, AudioMixerSharedDataPtr audio_mixer_shared_data_ptr );

	fn destructor();

	// Returns true if is successfully initialized and is not disabled.
	fn IsActive( this ) : bool;

private:
	// Use box to have stable address, since we pass a raw pointer to it into the audio thread.
	static_assert( !non_sync</AudioMixer/>, "Audio thread data type should remain non-sync to prevent race conditions!" );
	ust::box</AudioMixer/> audio_mixer_;

	SDL_AudioDeviceID device_id_;
}

} // namespace PM
