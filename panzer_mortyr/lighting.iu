import "/common_lib/game_params_file.iu"
import "/common_lib/map_loading.iu"
import "room_clusters_hierarchy.iu"
import "mat.iu"

namespace PM
{

struct PointLightSource
{
	Vec3f position;
	f32 power;
	[ u8, 3 ] color_rgb;
}

// Spherical harmonics of powers 0 and 1.
struct SphericalHarmonics
{
	Vec3f directional_components;
	f32 constant_component;
}

// Encode light as spherical harmonics for each RGB component.
// It's a rought approximation of surrounding light field.
type SphericalHarmonicsRGB= [ SphericalHarmonics, 3 ];

// Creates linear container containing all light sources in given map.
// It's easier to work with such linear container without needing calculating light positions relative to their parent clusters.
fn CreatePointLightSourcesForMapLightSources(
	ZvoxData& zvox_data, GameParams& game_params ) : ust::vector</PointLightSource/>;

// Calculate light for an object in given point with given radius.
fn GetLightForPoint(
	ust::array_view_imut</PointLightSource/> light_sources,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapLemClusterSkyLightData/> clusters_sky_light_data,
	RoomClustersHierarchy& room_clusters_hierarchy,
	Vec3f& point,
	f32 radius,
	// Rotation matrix is needed to transform light direction vectors into object space.
	Mat4f& inverse_rotation_matrix ) : SphericalHarmonicsRGB;

} // namespace PM
