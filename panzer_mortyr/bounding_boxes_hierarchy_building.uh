import "/sort.u"
import "bounding_boxes_hierarchy.uh"

namespace PM
{

template</type ElementType, type GetBBoxFuncT/>
fn BuildBoundingBoxesHierarchy(
	ust::array_view_mut</ElementType/> elements,
	size_type max_elements_in_node,
	GetBBoxFuncT& get_bbox_func ) : BoundingBoxesHierarchy</ElementType/>
{
	var BoundingBoxesHierarchy</ElementType/> mut hierarchy;

	BuildBoundingBoxesHierarchy_r( hierarchy, elements, max_elements_in_node, get_bbox_func );

	return hierarchy;
}

template</type ElementType, type GetBBoxFuncT/>
fn BuildBoundingBoxesHierarchy_r(
	BoundingBoxesHierarchy</ElementType/> &mut hierarchy,
	ust::array_view_mut</ElementType/> elements,
	size_type max_elements_in_node,
	GetBBoxFuncT& get_bbox_func ) : u32
{
	type HierarchyT= BoundingBoxesHierarchy</ElementType/>;
	type ElementsRangeImutT= ust::array_view_imut</ElementType/>;

	var BBox3f bbox= GetBBoxForElementsList( ElementsRangeImutT( elements ), get_bbox_func );

	var u32 node_index( hierarchy.nodes.size() );

	if( elements.size() <= max_elements_in_node )
	{
		// Have only a few elements left - create leaf node.

		var HierarchyT::LeafNodeContents mut leaf_node_contents
		{
			.first_element_index( hierarchy.elements.size() ),
			.num_elements( elements.size() ),
		};

		hierarchy.nodes.push_back( HierarchyT::Node{ .bbox= bbox, .contents= move(leaf_node_contents) } );

		foreach( &element : elements )
		{
			hierarchy.elements.push_back( element );
		}
	}
	else
	{
		// Create two children nodes.
		// Always split input elements list into two halves with equal (or almost equal) size in order to build balanced tree.
		//
		// We can perform 3 ways of splitting using 3 axis (X, Y, Z).
		// Sort elements by each axis (using center coordinate).
		// Select the splitting giving the smallest volume of intersection between two children of this node.

		var HierarchyT::BranchNodeContents mut branch_node_contents= zero_init; // Set later.

		hierarchy.nodes.push_back( HierarchyT::Node{ .bbox= bbox, .contents= move(branch_node_contents) } );

		auto compare_center_x= lambda[get_bbox_func]( ElementType& element ) : f32 { return get_bbox_func( element ).GetCenter().x; };
		auto compare_center_y= lambda[get_bbox_func]( ElementType& element ) : f32 { return get_bbox_func( element ).GetCenter().y; };
		auto compare_center_z= lambda[get_bbox_func]( ElementType& element ) : f32 { return get_bbox_func( element ).GetCenter().z; };

		var size_type half_clusters= elements.size() >> 1s;

		var size_type mut smallest_volume_dimension= 0s;
		var f32 mut smallest_volume= ust::plus_inf</f32/>();

		{
			ust::sort_by_key( elements, compare_center_x );
			var f32 volume=
				GetBBoxForElementsList( ElementsRangeImutT( elements ).subrange_end  ( half_clusters ), get_bbox_func ).GetIntersectionVolume(
				GetBBoxForElementsList( ElementsRangeImutT( elements ).subrange_start( half_clusters ), get_bbox_func ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 0s;
			}
		}
		{
			ust::sort_by_key( elements, compare_center_y );
			var f32 volume=
				GetBBoxForElementsList( ElementsRangeImutT( elements ).subrange_end  ( half_clusters ), get_bbox_func ).GetIntersectionVolume(
				GetBBoxForElementsList( ElementsRangeImutT( elements ).subrange_start( half_clusters ), get_bbox_func ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 1s;
			}
		}
		{
			ust::sort_by_key( elements, compare_center_z );
			var f32 volume=
				GetBBoxForElementsList( ElementsRangeImutT( elements ).subrange_end  ( half_clusters ), get_bbox_func ).GetIntersectionVolume(
				GetBBoxForElementsList( ElementsRangeImutT( elements ).subrange_start( half_clusters ), get_bbox_func ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 2s;
			}
		}

		switch( smallest_volume_dimension )
		{
			0s-> { ust::sort_by_key( elements, compare_center_x ); },
			1s-> { ust::sort_by_key( elements, compare_center_y ); },
			2s-> { ust::sort_by_key( elements, compare_center_z ); },
			default -> { halt; }
		}

		var u32 child0= BuildBoundingBoxesHierarchy_r(
			hierarchy, elements.subrange_end  ( half_clusters ), max_elements_in_node, get_bbox_func );

		var u32 child1= BuildBoundingBoxesHierarchy_r(
			hierarchy, elements.subrange_start( half_clusters ), max_elements_in_node, get_bbox_func );

		var HierarchyT::Node &mut node= hierarchy.nodes[ size_type( node_index ) ];
		node.contents.try_get</HierarchyT::BranchNodeContents/>().children_nodes= ust::make_array( child0, child1 );
	}

	return node_index;
}

template</type ElementType, type GetBBoxFuncT/>
fn GetBBoxForElementsList( ust::array_view_imut</ElementType/> elements, GetBBoxFuncT& get_bbox_func ) : BBox3f
{
	var BBox3f mut bbox
	{
		.min( ust::plus_inf </f32/>(), ust::plus_inf </f32/>(), ust::plus_inf </f32/>() ),
		.max( ust::minus_inf</f32/>(), ust::minus_inf</f32/>(), ust::minus_inf</f32/>() ),
	};

	foreach( &element : elements )
	{
		var BBox3f element_bbox= get_bbox_func( element );

		ust::min_assign( bbox.min.x, element_bbox.min.x );
		ust::max_assign( bbox.max.x, element_bbox.max.x );
		ust::min_assign( bbox.min.y, element_bbox.min.y );
		ust::max_assign( bbox.max.y, element_bbox.max.y );
		ust::min_assign( bbox.min.z, element_bbox.min.z );
		ust::max_assign( bbox.max.z, element_bbox.max.z );
	}

	return bbox;
}

} // namespace PM
