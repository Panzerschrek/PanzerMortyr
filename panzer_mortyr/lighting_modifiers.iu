import "settings.iu"
import "world_drawing_info.iu"

namespace PM
{

struct LightingModifier
{
	[ f32, 3 ] add;
	[ f32, 3 ] scale;
}

struct LightingModifiers
{
	LightingModifier map;
	LightingModifier models;
	LightingModifier first_person_weapon_models;
}

fn CalculateLightingModifiers(
	Settings& settings,
	[ f32, 3 ]& world_lighting_tint,
	WorldDrawingInfo::FullscreenEffect fullscreen_effect )  : LightingModifiers;

fn MakeLightingModifiersComponentOrderBGR( LightingModifiers& modifiers ) : LightingModifiers;

} // namespace PM
