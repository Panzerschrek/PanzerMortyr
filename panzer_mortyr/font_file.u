import "/common_lib/string_iterators.uh"
import "font_file.uh"

namespace PM
{

fn ParseFontFile( ust::string_view8 file_contents ) : FontData
{
	var FontData mut font_data
	{
		.glyphs( file_contents.size() / typeinfo</FontData::Glyph/>.size_of, ust::make_zeroed</FontData::Glyph/>() )
	};

	font_data.glyphs.range().to_byte8_range().copy_from( file_contents.to_byte8_range() );

	return font_data;
}

} // namespace PM
