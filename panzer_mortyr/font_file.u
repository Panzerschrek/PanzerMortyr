import "/common_lib/string_iterators.uh"
import "/integer_parsing.u"
import "font_file.uh"

namespace PM
{

fn ParseFontFile( ust::string_view8 file_contents ) : FontData
{
	var FontData mut font_data;

	var ust::string_view8 line_start= " DC.B ";

	foreach( mut line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) ) label lines_loop
	{
		if( !line.starts_with( line_start ) )
		{
			continue;
		}

		line= line.subrange_start( line_start.size() );

		var FontData::Glyph mut glyph= zero_init;

		for( auto mut i= 0s; i < 7s; ++i )
		{
			if_var( b : ParseHexByte( line ) )
			{
				glyph.pixels[i]= b;
			}
			else
			{
				continue label lines_loop;
			}

			if( !line.starts_with( "," ) )
			{
				continue label lines_loop;
			}
			line.drop_front();
		}

		if_var( n : ust::parse_and_extract_integer</u32/>( line ) )
		{
			glyph.width= u8(n);
		}
		else
		{
			continue;
		}

		font_data.glyphs.push_back( glyph );
	}

	return font_data;
}

fn ParseHexByte( ust::string_view8 &mut s ) : ust::optional</u8/>
{
	if( s.empty() )
	{
		return ust::null_optional;
	}

	if( s.front() != '$' )
	{
		return ust::null_optional;
	}
	s.drop_front();

	if( s.empty() )
	{
		return ust::null_optional;
	}
	auto digit0= GetHexDigit( s.front() );
	s.drop_front();

	if( digit0.empty() )
	{
		return ust::null_optional;
	}

	var u32 mut res= digit0.try_deref();

	if( !s.empty() )
	{
		if_var( digit1 : GetHexDigit( s.front() ) )
		{
			res= ( res << 4u ) | digit1;
			s.drop_front();
		}
	}

	return u8(res);
}

fn GetHexDigit( char8 c ) : ust::optional</u32/>
{
	if( c >= '0' && c <= '9' )
	{
		return u32(c) - u32('0');
	}
	if( c >= 'a' && c <= 'f' )
	{
		return u32(c) - u32('a') + 10u;
	}
	if( c >= 'A' && c <= 'F' )
	{
		return u32(c) - u32('A') + 10u;
	}
	return ust::null_optional;
}

} // namespace PM
