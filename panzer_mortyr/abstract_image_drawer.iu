import "/common_lib/resource_string.iu"
import "image_data.iu"

namespace PM
{

class AbstractImageDrawer abstract non_sync
{
	// Use separate method for image preloading
	// in order to allow preloading all images at loading stage and avoid slow-downs later due to slow disk access.
	fn virtual pure PreloadImage(
		mut this, ResourceString& image_file_name, ust::optional_ref_imut</ [ u8, 3 ] /> transparent_color );

	// Works only for preloaded images.
	fn virtual pure GetImageSize( this, ResourceString& image_file_name ) : ust::optional</ [ u32, 2 ] />;

	// Draw the whole image at given position with given size. The image should be preloaded first.
	fn virtual pure DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale );
	fn virtual pure DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale, u8 alpha );

	// Draw a part of an image at given position with given size. The image should be preloaded first.
	fn virtual pure DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y );

	fn virtual pure DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y,
		u8 alpha );

	// This function uploads given image to GPU each time it's called. Avoid using it too often for large images.
	fn virtual pure UploadAndDrawImage( mut this, ImageData& image_data, i32 x, i32 y, f32 scale );
}

} // namespace PM
