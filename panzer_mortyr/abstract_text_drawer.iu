import "/string.iu"

namespace PM
{

class AbstractTextDrawer abstract
{
public:
	// Settings describing how exactly to draw a text pience.
	struct Settings
	{
		u32 scale= 1u;
		[ u8, 4 ] foreground_color[ 255u8, 255u8, 255u8, 255u8 ];
		[ u8, 4 ] background_color[ 0u8, 0u8, 0u8, 255u8 ];
		bool monospace= false;
	}

	var u32 constexpr c_max_glyph_width= 7u, constexpr c_glyph_height= 8u;

public:
	fn virtual pure AddText( mut this, i32 x, i32 y, ust::string_view8 text );
	fn virtual pure AddText( mut this, i32 x, i32 y, ust::string_view8 text, Settings& settings );

	// Draw accumulated glyphs.
	fn virtual pure DrawTexts( mut this );
}

} // namespace PM
