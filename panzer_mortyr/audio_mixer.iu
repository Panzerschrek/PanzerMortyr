import "/shared_ptr_mt_final.iu"
import "lock_free_queue.iu"
import "sound_loading.iu"
import "unique_sound_source_id.iu"

namespace PM
{

// This class performs actual sounds mixing and outputting.
class AudioMixer
{
public:
	// Let's assume audio mixing/outputting is executed 20 times in a second (it should be actually more frequent).
	// Assume that vsync is off and FPS is around 1000 and each frame all sounds are updated.
	// Assume that we have 32 playing sounds.
	// For such extreme case we need 1000 / 20 * 32 = 1600 slots for sound update messages.
	// Round it up to the nearest power of two.
	type InMessagesQueue= LockFreeQueue</ InMessage, 2048u />;

	type InMessage=
		ust::variant</ tup[
			InMessageAddSoundSource,
			InMessageSetSoundSourceVolume,
			InMessageRemoveSoundSource,
			InMessageAddAmbientSound,
			InMessageSetAmbientSoundVolume,
			InMessageRemoveAmbientSound ] />;

	struct InMessageAddSoundSource
	{
		UniqueSoundSourceId id;
		ChannelsVolume volume;
		ust::shared_ptr_mt_final</SoundDataAbstract/> sound_data;
	}

	struct InMessageSetSoundSourceVolume
	{
		UniqueSoundSourceId id;
		ChannelsVolume volume;
	}

	struct InMessageRemoveSoundSource
	{
		UniqueSoundSourceId id;
	}

	struct InMessageAddAmbientSound
	{
		AmbientSoundSlotIndex slot_index;
		ChannelsVolume volume;
		ust::shared_ptr_mt_final</SoundDataAbstract/> sound_data;
	}

	struct InMessageSetAmbientSoundVolume
	{
		AmbientSoundSlotIndex slot_index;
		ChannelsVolume volume;
	}

	struct InMessageRemoveAmbientSound
	{
		AmbientSoundSlotIndex slot_index;
	}

	// Let's assume audio mixing/outputting is executed 256 times in a second (it should be actually less frequent).
	// Assume that frame rate is pretty low - only 20 fps.
	// Assume that we have 32 playing sounds.
	// For such extreme case we need 256 / 20 * 32 = 409.6 slots for sound update messages.
	// Round it up to the nearest power of two.
	type OutMessagesQueue= LockFreeQueue</ OutMessage, 512u />;

	type OutMessage=
		ust::variant</ tup[
			OutMessageSoundSourceProgress,
			OutMessageSoundSourceFinished,
			OutMessageAmbientSoundRemoved ] />;

	struct OutMessageSoundSourceProgress
	{
		UniqueSoundSourceId id;

		// It's a little bit imprecise to store progress in "f32", but it's fine for what is intended to be used.
		f32 time_s;
	}

	struct OutMessageSoundSourceFinished
	{
		UniqueSoundSourceId id;

		// It's needed here only to prevent freeing the shared data on the mixer thread, if it happens to be the last user.
		ust::shared_ptr_mt_final_nullable</SoundDataAbstract/> sound_data;
	}

	struct OutMessageAmbientSoundRemoved
	{
		AmbientSoundSlotIndex slot_index;

		// It's needed here only to prevent freeing the shared data on the mixer thread, if it happens to be the last user.
		ust::shared_ptr_mt_final_nullable</SoundDataAbstract/> sound_data;
	}

	type AmbientSoundSlotIndex= u8;
	var size_type constexpr c_num_ambient_sound_slots= 8s;

	type ChannelsVolume= [ f32, c_num_samples ];

	// Use f32 as output.
	// We require using a floating-type anyway for mixing and resampling.
	type SampleType= f32;

	type SamplePairType= [ SampleType, c_num_samples ];

	// Use two channels for stereo sound. #0 is left, #1 is right.
	var size_type constexpr c_num_samples= 2s;

public:
	fn constructor(
		InMessagesQueue::ReadEnd in_messages_queue_read_end, OutMessagesQueue::WriteEnd out_messages_queue_write_end );

	fn SetFrequency( mut this, u32 frequency );

	// Mix sounds and output them into given buffer.
	fn Mix( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs );

private:
	// Use fixed number of source slots.
	// 64 is enough for most extreme situations with a lot of playing sounds.
	// Increasing it furher isn't recommended, since linear search is used for this array.
	type SoundSources= [ SoundSource, 64 ];

	struct SoundSource
	{
		// Zero ID represents that this source isn't active (is empty slot).
		UniqueSoundSourceId id;

		// While updating volume of an existing sound source, only "new_volume" should be set.
		ChannelsVolume current_volume;
		ChannelsVolume new_volume;

		ust::shared_ptr_mt_final_nullable</SoundDataAbstract/> sound_data;

		// Counter of output samples, not sound data samples (using output frequency).
		u32 sample_counter;

		// Use it to mark sources to be removed.
		// Do this instead of removing them to do this in a nice way - with fading out (to avoid "steps" and "cracks").
		bool is_about_to_be_removed;
	}

	struct AmbientSound
	{
		ust::shared_ptr_mt_final_nullable</SoundDataAbstract/> sound_data;

		// While updating volume only "new_volume" should be set.
		ChannelsVolume current_volume;
		ChannelsVolume new_volume;

		// Counter of output samples, not sound data samples (using output frequency).
		// 32-bit counter is enough for many hours of playing.
		u32 sample_counter;

		// Use it to mark ambient sounds to be removed.
		// Do this instead of removing them to do this in a nice way - with fading out (to avoid "steps" and "cracks").
		bool is_about_to_be_removed;
	}

private:
	fn ProcessMessage( mut this, InMessage& message );
	fn ProcessMessageImpl( mut this, InMessageAddSoundSource& message );
	fn ProcessMessageImpl( mut this, InMessageSetSoundSourceVolume& message );
	fn ProcessMessageImpl( mut this, InMessageRemoveSoundSource& message );
	fn ProcessMessageImpl( mut this, InMessageAddAmbientSound& message );
	fn ProcessMessageImpl( mut this, InMessageSetAmbientSoundVolume& message );
	fn ProcessMessageImpl( mut this, InMessageRemoveAmbientSound& message );

private:
	InMessagesQueue::ReadEnd in_messages_queue_read_end_;
	OutMessagesQueue::WriteEnd out_messages_queue_write_end_;

	u32 frequency_;

	SoundSources sources_;

	[ AmbientSound, c_num_ambient_sound_slots ] ambient_sounds_;
}

} // namespace PM
