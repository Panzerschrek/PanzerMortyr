import "/shared_ptr_mt.iu"
import "/shared_ptr_mt_final.iu"
import "lock_free_queue.iu"
import "sound_loading.iu"
import "unique_sound_source_id.iu"

namespace PM
{

// TODO - use some lock-free structure instead of shared_ptr_mt, which contains blocking RW-lock inside.
type AudioMixerSharedDataPtr= ust::shared_ptr_mt_mut</AudioMixerSharedData/>;

// This struct represents a communication channel with the thread performing actual audio outputting and mixing.
struct AudioMixerSharedData
{
	AudioMixer::InMessagesQueue::ReadEnd in_messages_queue_read_end;
	AudioMixer::OutMessagesQueue::WriteEnd out_messages_queue_write_end;
}

// This class performs actual sounds mixing and outputting.
class AudioMixer
{
public:
	type InMessagesQueue= LockFreeQueue</ InMessage, 256u />;

	type InMessage=
		ust::variant</ tup[ InMessageAddSoundSource, InMessageSetSoundSourceVolume, InMessageRemoveSoundSource ] />;

	struct InMessageAddSoundSource
	{
		UniqueSoundSourceId id;
		[ f32, c_num_samples ] volume;
		ust::shared_ptr_mt_final</SoundDataAbstract/> sound_data;
	}

	struct InMessageSetSoundSourceVolume
	{
		UniqueSoundSourceId id;
		[ f32, c_num_samples ] volume;
	}

	struct InMessageRemoveSoundSource
	{
		UniqueSoundSourceId id;
	}

	type OutMessagesQueue= LockFreeQueue</ OutMessage, 256u />;

	type OutMessage= ust::variant</ tup[ OutMessageSoundSourceFinished ] />;

	struct OutMessageSoundSourceFinished
	{
		UniqueSoundSourceId id;
	}

	// Use f32 as output.
	// We require using a floating-type anyway for mixing and resampling.
	type SampleType= f32;

	type SamplePairType= [ SampleType, c_num_samples ];

	// Use two channels for stereo sound. #0 is left, #1 is right.
	var size_type constexpr c_num_samples= 2s;

public:
	fn constructor( AudioMixerSharedDataPtr shared_data );

	fn SetFrequency( mut this, u32 frequency );

	// Mix sounds and output them into given buffer.
	fn Mix( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs );

private:
	// Use fixed number of source slots.
	// It's expected that many of these sounds have zero volume and mixing sounds with zero volume costs nothing.

	type SoundSources= [ SoundSource, 40 ];

	struct SoundSource
	{
		// Zero ID represents that this source isn't active (is empty slot).
		UniqueSoundSourceId id;

		// While updating volume of an existing sound source, only "new_volume" should be set.
		[ f32, c_num_samples ] current_volume;
		[ f32, c_num_samples ] new_volume;

		ust::shared_ptr_mt_final_nullable</SoundDataAbstract/> sound_data;

		// Counter of output samples, not sound data samples (using output frequency).
		u32 sample_counter;

		// Use it to mark sources to be removed.
		// Do this instead of removing them to do this in a nice way - with fading out (to avoid "steps" and "cracks").
		bool is_about_to_be_removed;
	}

private:
	fn ProcessMessage( SoundSources &mut sound_sources, InMessage& message );
	fn ProcessMessageImpl( SoundSources &mut sound_sources, InMessageAddSoundSource& message );
	fn ProcessMessageImpl( SoundSources &mut sound_sources, InMessageSetSoundSourceVolume& message );
	fn ProcessMessageImpl( SoundSources &mut sound_sources, InMessageRemoveSoundSource& message );

private:
	AudioMixerSharedDataPtr imut shared_data_;

	u32 frequency_;

	SoundSources sources_
		[
			{
				.id= c_empty_sound_source_id,
				.current_volume= zero_init,
				.new_volume= zero_init,
				.sample_counter= 0u,
				.is_about_to_be_removed= false,
			} ...
		];
}

} // namespace PM
