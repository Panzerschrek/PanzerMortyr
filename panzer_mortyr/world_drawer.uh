import "/common_lib/map_loading.uh"
import "/common_lib/materials_file.uh"

import "buffer_object.uh"
import "caching_game_resources_loader.uh"
import "gpu_model.uh"
import "settings.uh"
import "sky.uh"
import "shader_program.uh"
import "texture.uh"
import "vertex_array_object.uh"
import "world_drawing_info.uh"

namespace PM
{

class WorldDrawer
{
public:
	fn constructor(
		SettingsPtr settings,
		GameFilesystemPtr game_filesystem_ptr,
		CachingGameResourcesLoaderPtr caching_game_resources_loader,
		ConsoleOutPtr console_out );

	fn Draw( mut this, WorldDrawingInfo& drawing_info, WorldDrawingViewportInfo& viewport_info );

private:
	fn SetMap( mut this, u32 map_index );

private:
	struct MapDrawData
	{
		GameResourcePtr</ZvoxData/> zvox_data;
		GameResourcePtr</ZpozData/> zpoz_data;
		GameResourcePtr</ZmapLamData/> zmap_lam_data;

		VertexArrayObject vertex_array_object;

		// Store all vertices in single buffer.
		BufferObject vertex_buffer;

		// Store all indices in single buffer.
		BufferObject index_buffer;

		// Store all map textures in single textures array - we can do this, since all map textrures have identical size.
		Texture map_textures_array;

		// Has size equal to number of map clusters.
		ust::vector</ClusterDrawData/> clusters_draw_data;

		SkyBackgroundBuffer sky_background_buffer;
	}

	struct ClusterDrawData
	{
		// offset into vertex array.
		size_type first_vertex_index;
		// Offset into index array.
		size_type first_index;
		// Number of indices is equal to number of triangles multiplied by 3.
		size_type num_indices;
	}

private:
	SettingsPtr imut settings_;
	GameFilesystemPtr imut game_filesystem_ptr_;
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;

	ShaderProgram map_shader_;
	ShaderProgram model_shader_;
	ShaderProgram sky_background_shader_;
	ShaderProgram test_primitive_shader_;

	VertexArrayObject test_primitive_vertex_array_object_;
	BufferObject test_primitive_vertex_buffer_object_;

	// Map index may be up-to-data, but map data may be empty - if failed to load map files.
	u32 map_index_;
	ust::optional</MapDrawData/> map_data_;

	// Load models on demand and store them in this container.
	// Store empty optional if failed to load (in order to avoid loading again).
	// TODO - clear it at level transition, but preserve some models which are always in use.
	ust::hash_map</ ResourceString, ust::optional</GPUModel/> /> models_;
}

} // namespace PM
