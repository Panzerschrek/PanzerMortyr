import "/common_lib/map_loading.uh"
import "/common_lib/materials_file.uh"

import "buffer_object.uh"
import "game_filesystem.uh"
import "mat.uh"
import "shader_program.uh"
import "texture.uh"
import "vertex_array_object.uh"

namespace PM
{

class WorldDrawer
{
public:
	fn constructor();

	fn SetMap(
		mut this,
		ZmapData& zmap_data,
		MaterialsDescription::Block& materials_block,
		GameFilesystem &mut game_filesystem );

	fn Draw( mut this, Mat4f& view_matrix );

private:
	struct MapDrawData
	{
		VertexArrayObject vertex_array_object;
		BufferObject vertex_buffer;
		BufferObject index_buffer;
		size_type num_indices;
		Texture map_textures_array;
	}

private:
	ShaderProgram map_shader_;
	ust::optional</MapDrawData/> map_data_;
}

} // namespace PM
