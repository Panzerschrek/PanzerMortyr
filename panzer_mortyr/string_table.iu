import "/common_lib/resource_string.iu"
import "/vector.iu"

namespace PM
{

type StringTable= ust::vector</ust::string8/>;

// This table was created based on contents of TEXT.STD file for english version of the game.
// In the polish version it has the same entries.
enum StringTableKey
{
	// Game logic messages.
	SelectedWeapon,
	NoAmmoFor,
	NotAvailable,
	Mortyr_2093_1944,
	ScreenSaved,
	PickedUp,
	WasKilledBy,
	CapturedTheFlag,
	Team,
	HaveCapturedTheFlag,
	HasKilled,
	HasDied,
	// Video mode menu.
	CurrentVideoMode,
	// Load/save menus.
	SelectSlotForLoadGame,
	SelectSlotForSaveGame,
	EnterNewName,
	EmptySlot,
	Yes,
	No,
	// Controls menu.
	InvertMouse,
	MouseLook,
	MouseMove,
	MouseAttack,
	AlwaysRun,
	ToTheNextPage,
	Ready,
	// Networking errors.
	HostNotResponding,
	PlayerNotResponding,
	ConnectionLost,
	YouAreDisconnectedFromServer,
	SessionLost,
	// Network game setup.
	MaxPlayers,
	GameType,
	Deathmatch,
	Cooperative,
	CaptureTheFlag,
	UnknownMatch1,
	UnknownMatch2,
	TeamPlay,
	Off,
	On,
	Skill0,
	Easy,
	NormalDifficulty,
	AlmostHard,
	Hard,
	FragLimit,
	None0,
	Frags10,
	Frags20,
	Frags30,
	Frags40,
	Frags50,
	Frags60,
	Frags70,
	TimeLimit,
	None1,
	min5,
	min10,
	min15,
	CorpseLimit,
	Level0,
	None2,
	StartGame,
	Password,
	// Save/load summary.
	Level1,
	Skill1,
	Killed,
	KilledSlash,
	// Network game setup.
	PlayerSetup,
	CreateGame,
	JoinGame,
	LookingForAvailableGames,
	TeamName,
	CreateTeam,
	JoinTeam,
	TeamsWouldHaveTheSameParameters,
}

var ResourceString& c_string_table_file_name= "TEXT.STD\0\0\0\0";

fn ParseStringTable( ust::string_view8 file_contents ) : StringTable;

fn FetchStringFromTable( StringTable& table, StringTableKey key )
	: ust::string_view8 @( ust::reference_notation::return_inner_references::param0 );

} // namespace PM
