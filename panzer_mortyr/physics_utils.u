import "physics_utils.iu"

namespace PM
{

fn CalculateQuadNormal( ZmapQuad& quad ) : Vec3f
{
	auto& in_vertices= quad.vertices;

	var [ Vec3f, 4 ] quad_vertices
	[
		( f32( in_vertices[0][0] ), f32( in_vertices[0][1] ), f32( in_vertices[0][2] ) ),
		( f32( in_vertices[1][0] ), f32( in_vertices[1][1] ), f32( in_vertices[1][2] ) ),
		( f32( in_vertices[2][0] ), f32( in_vertices[2][1] ), f32( in_vertices[2][2] ) ),
		( f32( in_vertices[3][0] ), f32( in_vertices[3][1] ), f32( in_vertices[3][2] ) ),
	];

	// Average normal calculated based on 4 quad vertices.
	// This is needed to handle quads with two vertices equal to each other.
	return
		( quad_vertices[0] - quad_vertices[1] ).Cross( quad_vertices[1] - quad_vertices[2] ) +
		( quad_vertices[1] - quad_vertices[2] ).Cross( quad_vertices[2] - quad_vertices[3] ) +
		( quad_vertices[2] - quad_vertices[3] ).Cross( quad_vertices[3] - quad_vertices[0] ) +
		( quad_vertices[3] - quad_vertices[0] ).Cross( quad_vertices[0] - quad_vertices[1] );
}

fn IsGroundSurface( Vec3f& normal ) : bool
{
	var f32 normal_length= normal.Length();
	if( normal_length > 0.0f )
	{
		if( (-normal.z) / normal_length >= c_ground_plane_min_normal_z )
		{
			return true;
		}
	}

	return false;
}

fn ClampVecrticalVelocity( f32 &mut vertical_velocity, Vec3f& plane_normal )
{
	var f32 dot= vertical_velocity * plane_normal.z;
	if( dot < 0.0f )
	{
		 vertical_velocity-= plane_normal.z * dot / plane_normal.SquareLength();
	}
}

// Assume ground surfaces all surfaces with normal pointing mostly up.
// This value is tuned so that it's possible to jump on some steap ramps, where it's possible to jump in the original.
var f32 c_ground_plane_min_normal_z= 0.67f;

} // namespace PM
