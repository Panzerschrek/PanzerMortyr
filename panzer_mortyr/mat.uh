import "vec.uh"

namespace PM
{

type Mat3f= Mat3</f32/>;
type Mat4f= Mat4</f32/>;

template</ type T />
struct Mat3
{
	type ThisType= Mat3</T/>;

	fn MakeZero() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(0), T(0), T(0) ],
				[ T(0), T(0), T(0) ],
				[ T(0), T(0), T(0) ],
			]
		};
	}

	fn MakeIdentity() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0) ],
				[ T(0), T(1), T(0) ],
				[ T(0), T(0), T(1) ],
			]
		};
	}

	fn MakeTranslation( Vec2</T/>& v ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0) ],
				[ T(0), T(1), T(0) ],
				[ v.x, v.y, T(1) ],
			]
		};
	}

	// Matrix multiplication.
	op*( ThisType& l, ThisType& r ) : ThisType
	{
		var ThisType mut res= MakeZero();

		for( auto mut y= 0s; y < 3s; ++y )
		{
			for( auto mut x= 0s; x < 3s; ++x )
			{
				var T mut val(0);

				for( auto mut i= 0s; i < 3s; ++i )
				{
					val+= l.values[y][i] * r.values[i][x];
				}

				res.values[y][x]= val;
			}
		}

		return res;
	}

	// Row-by-row values.
	[ [ T, 3 ], 3 ] values;
}


template</ type T />
struct Mat4
{
	type ThisType= Mat4</T/>;

	fn MakeZero() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
			]
		};
	}

	fn MakeIdentity() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0), T(0) ],
				[ T(0), T(1), T(0), T(0) ],
				[ T(0), T(0), T(1), T(0) ],
				[ T(0), T(0), T(0), T(1) ],
			]
		};
	}

	fn MakeTranslation( Vec3</T/>& v ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0), T(0) ],
				[ T(0), T(1), T(0), T(0) ],
				[ T(0), T(0), T(1), T(0) ],
				[ v.x, v.y, v.z, T(1) ],
			]
		};
	}

	fn MakePerspective( T aspect, T fov_y, T z_near, T z_far ) : ThisType
	{
		var T half_fov_inv_tan= T(1) / ust::tan( fov_y * T(0.5) );

		var T inv_diff= T(1) / ( z_far - z_near );

		return ThisType
		{
			.values
			[
				[ half_fov_inv_tan / aspect, T(0), T(0), T(0) ],
				[ T(0), half_fov_inv_tan, T(0), T(0) ],
				[ T(0), T(0), inv_diff * ( z_near + z_far ), T(1) ],
				[ T(0), T(0), -T(2) * inv_diff * z_near * z_far, T(0) ],
			]
		};
	}

	fn MakeRotationZ( T rotation_angle ) : ThisType
	{
		var f32 c= ust::cos( rotation_angle );
		var f32 s= ust::sin( rotation_angle );

		return ThisType
		{
			.values
			[
				[  c, s, T(0), T(0) ],
				[ -s, c, T(0), T(0) ],
				[ T(0), T(0), T(1), T(0) ],
				[ T(0), T(0), T(0), T(1) ],
			]
		};
	}

	// Matrix multiplication.
	op*( ThisType& l, ThisType& r ) : ThisType
	{
		var ThisType mut res= MakeZero();

		for( auto mut y= 0s; y < 4s; ++y )
		{
			for( auto mut x= 0s; x < 4s; ++x )
			{
				var T mut val(0);

				for( auto mut i= 0s; i < 4s; ++i )
				{
					val+= l.values[y][i] * r.values[i][x];
				}

				res.values[y][x]= val;
			}
		}

		return res;
	}

	// Row-by-row values.
	[ [ T, 4 ], 4 ] values;
}

} // namespace PM
