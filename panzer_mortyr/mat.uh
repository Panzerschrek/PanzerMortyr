import "vec.uh"

namespace PM
{

type Mat3f= Mat3</f32/>;
type Mat4f= Mat4</f32/>;

template</ type T />
struct Mat3
{
	type ThisType= Mat3</T/>;

	fn MakeZero() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(0), T(0), T(0) ],
				[ T(0), T(0), T(0) ],
				[ T(0), T(0), T(0) ],
			]
		};
	}

	fn MakeIdentity() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0) ],
				[ T(0), T(1), T(0) ],
				[ T(0), T(0), T(1) ],
			]
		};
	}

	// Matrix multiplication.
	op*( ThisType& l, ThisType& r ) : ThisType
	{
		var ThisType mut res= MakeZero();

		for( auto mut y= 0s; y < 3s; ++y )
		{
			for( auto mut x= 0s; x < 3s; ++x )
			{
				var T mut val(0);

				for( auto mut i= 0s; i < 3s; ++i )
				{
					val+= l.values[y][i] * r.values[i][x];
				}

				res.values[y][x]= val;
			}
		}

		return res;
	}

	// Row-by-row values.
	[ [ T, 3 ], 3 ] values;
}


template</ type T />
struct Mat4
{
	type ThisType= Mat4</T/>;

	fn MakeZero() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
			]
		};
	}

	fn MakeIdentity() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0), T(0) ],
				[ T(0), T(1), T(0), T(0) ],
				[ T(0), T(0), T(1), T(0) ],
				[ T(0), T(0), T(0), T(1) ],
			]
		};
	}

	// Matrix multiplication.
	op*( ThisType& l, ThisType& r ) : ThisType
	{
		var ThisType mut res= MakeZero();

		for( auto mut y= 0s; y < 4s; ++y )
		{
			for( auto mut x= 0s; x < 4s; ++x )
			{
				var T mut val(0);

				for( auto mut i= 0s; i < 4s; ++i )
				{
					val+= l.values[y][i] * r.values[i][x];
				}

				res.values[y][x]= val;
			}
		}

		return res;
	}

	// Row-by-row values.
	[ [ T, 4 ], 4 ] values;
}

} // namespace PM
