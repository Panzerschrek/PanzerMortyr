import "vec.iu"

namespace PM
{

type Planef= Plane</f32/>;

// Plane in form of equation.
// For a point on the plane normal.dot( point ) + distance = 0.
// For a point in front of the plane this equation is positive, for a point back from the plane it's negative.
template</type T/>
struct Plane
{
	type ThisType= Plane</T/>;

	// Vector defining plane orientation. Has generally non-unit length.
	Vec3</T/> normal;

	// Distance from the origin scaled to normal length.
	f32 distance;

	fn CreateFromNormalAndPoint( Vec3</T/>& n, Vec3</T/>& p ) : ThisType
	{
		return ThisType{ .normal= n, .distance= -n.Dot( p ) };
	}

	fn GetDistanceForPoint( this, Vec3</T/>& p ) : T
	{
		return normal.Dot( p ) + distance;
	}
}

} // namespace PM
