import "/vector.iu"
import "/common_lib/resource_string.iu"

namespace PM
{

struct MaterialProperties
{
	ust::string8 name;

	// Is positive value in range 100 to 160.
	u32 reflected_light= 0u; // swiatlo_odbite

	// Is positive value in range 20 to 80.
	u32 roughness= 0u; // chropowatosc

	// Is true only for glass.
	bool fragile= false; // kruchosc.

	// Is false only for leaves, water and bottom materials. Maybe it disables bullet holes?
	bool smooth_edge= false; // gladka_krawedz

	// Is small positive value, different for different materials.
	u32 player_step_friction= 0u; // boh_krok_tarcie

	// Is -1 except for snow materials.
	i32 footprints= -1; // slady_stop

	// Is present only for water materials.
	u32 water_mark= 0u; // slad_wodny

	// Indices of step sound effects.
	u32 left_step_sound_index= ~0u; // glos_stopa_lewa
	u32 right_step_sound_index= ~0u; // glos_stopa_prawa

	// Is missing for water and bottom material kinds.
	// If present, value[0] is always 0.
	// value[1] contains sound index in the "GLOS.STD" file played when a projectile hits this surface.
	[ i32, 2 ] wall_collision[ -1, -1 ]; // kolizja_mur
}

// Materials are numbered.
type MaterialsProperties= ust::vector</ MaterialProperties />;

var ResourceString& c_materials_properties_file_name= "TXMAT.STD\0\0\0\0\0\0\0";

fn ParseMaterialPropertiesFile( ust::string_view8 file_contents ) : MaterialsProperties;

} // namespace PM
