import "caching_game_resources_loader.uh"
import "camera_controller.uh"
import "game_structs.uh"
import "world_drawing_info.uh"

namespace PM
{

// This class contains all game logic.
// TODO - split it into server/client parts.
class Game
{
public:
	fn constructor( CachingGameResourcesLoaderPtr caching_game_resources_loader_ptr );

	fn GetCurrentMapIndex( this ) : u32;

	fn TeleportToMap( mut this, u32 map_index );

	fn Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state );

	fn GetWorldDrawingInfo( this ) : WorldDrawingInfo;

public: // command processor methods.
	fn process_reset_position( mut this );

private:
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;

	u32 current_map_index_;

	GameResourceNullablePtr</EntitiesDescription/> entities_description_;

	CameraController camera_controller_;

	ust::vector</EntityState/> entities_;
}

} // namespace PM
