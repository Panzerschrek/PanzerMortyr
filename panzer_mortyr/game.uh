import "caching_game_resources_loader.uh"
import "game_structs.uh"
import "player_controller.uh"
import "random.uh"
import "world_drawing_info.uh"

namespace PM
{

// This class contains all game logic.
// TODO - split it into server/client parts.
class Game
{
public:
	fn constructor( CachingGameResourcesLoaderPtr caching_game_resources_loader_ptr, ConsoleOutPtr console_out );

	fn GetCurrentMapIndex( this ) : u32;

	fn TeleportToMap( mut this, u32 map_index );

	fn Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state );

	fn ProcessMouseButtonPress( mut this, u32 button_index );

	fn GetWorldDrawingInfo( this ) : WorldDrawingInfo;

public: // command processor methods.
	fn process_noclip( mut this );

	fn process_reset_position( mut this );

	// Debug event when an enemy sees the player.
	fn process_trigger_player_see( mut this );

	// Debug event when an enemy is in shooting zone.
	fn process_trigger_player_in_shooting_zone( mut this );

	// Debug event when an enemy is killed.
	fn process_trigger_energy_loss( mut this );

private:
	fn MovePlayer( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state );

	fn ProcessStep( mut this );

	fn GetNearestEntity( mut this, Vec3f& pos ) : ust::optional_ref_mut</EntityState/> @( ust::reference_notation::return_inner_references::param0 );

private:
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;

	u32 current_map_index_;
	GameResourceNullablePtr</ZmapData/> zmap_data_;
	GameResourceNullablePtr</ZvoxData/> zvox_data_;
	GameResourceNullablePtr</MapaWayData/> mapa_way_data_;

	GameResourceNullablePtr</EntitiesDescription/> entities_description_;

	PlayerController player_controller_;

	bool noclip_mode_active_= false;

	PseudoRandomGenerator random_;

	// Store optionals here. It's needed if an entity should be fully killed without affecting indices stability.
	// Entities should not be removed from this cotainer, they can be only appeded or emptied.
	// All map entities are mapped to this container 1 to 1 so that original indices are matching.
	ust::vector</ ust::optional</EntityState/> /> entities_;

	f64 prev_time_steps_;

	ust::vector</Vec3f/> test_bullet_holes_;
}

} // namespace PM
