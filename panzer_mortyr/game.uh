import "bbox.uh"
import "caching_game_resources_loader.uh"
import "camera_rotation_controller.uh"
import "game_structs.uh"
import "materials_property_file.uh"
import "player_movement_controller.uh"
import "player_tool_controller.uh"
import "settings.uh"
import "world_drawing_info.uh"

namespace PM
{

// This class contains all game logic.
// TODO - split it into server/client parts.
class Game
{
public:
	fn constructor(
		SettingsPtr settings,
		CachingGameResourcesLoaderPtr caching_game_resources_loader_ptr,
		ConsoleOutPtr console_out );

	fn TeleportToMap( mut this, u32 map_index );

	fn Update(
		mut this,
		f32 time_delta_s,
		ust::array_view_imut</bool/> keyboard_state,
		u32 mouse_state,
		[ i32, 2 ] mouse_motion );

	fn ProcessMouseButtonPress( mut this, u32 button_index );

	fn GetWorldDrawingInfo( this ) : WorldDrawingInfo;

public: // command processor methods.
	fn process_noclip( mut this );

	fn process_reset_position( mut this );

	// Debug event when an enemy sees the player.
	fn process_trigger_player_see( mut this );

	// Debug event when an enemy is in shooting zone.
	fn process_trigger_player_in_shooting_zone( mut this );

	// Debug event when an enemy is killed.
	fn process_trigger_energy_loss( mut this );

	// Give all cheat.
	fn process_give_all( mut this );

private:
	SettingsPtr imut settings_;
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;

	GameGlobalData imut global_data_;

	ust::optional</GameMapData/> map_data_;

	CameraRotationController camera_rotation_controller_;
	PlayerMovementController player_movement_controller_;
	PlayerToolController player_tool_controller_;

	ust::optional</GameState/> game_state_;

	f64 prev_time_steps_;

	ust::vector</Vec3f/> test_sprites_;
	ust::vector</WorldDrawingInfo::TestTriangle/> test_triangles_;
}

} // namespace PM
