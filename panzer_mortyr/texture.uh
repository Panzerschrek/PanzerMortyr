import "/sdl/sdl_with_opengl.uh"

namespace PM
{

// Basic RAII wrapper for OpenGL texture.
class Texture
{
public:
	// Create empty texture with given target.
	fn Create( GLenum target ) : Texture;

	fn constructor( GLuint texture, GLenum target ) unsafe; // Constructor for internal usage.
	fn destructor();

	fn Bind( this );

private:
	GLuint imut texture_;
	GLenum imut target_;
}

} // namespace PM
