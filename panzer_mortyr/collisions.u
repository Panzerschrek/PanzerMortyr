import "bounding_boxes_hierarchy_visiting.uh"
import "collisions.uh"

namespace PM
{

fn LineTrace(
	GameMapData& map_data,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	Vec3f& start_point,
	Vec3f& line_vector ) : ust::optional</LineTraceResult/>
{
	auto& clusters= map_data.zvox_data.deref().clusters;
	auto& quads= map_data.zmap_data.deref().quads;

	var f32 mut closest_distance= ust::plus_inf</f32/>();

	var size_type mut hit_quad_index= ~0s, mut hit_quad_cluster_index= ~0s;

	VisitBoundingBoxesHierarchyForLineSegment(
		map_data.collider_quads_hierarchy,
		start_point,
		line_vector,
		lambda[&]( PackedQuadIndex packed_quad_index )
		{
			var size_type c= packed_quad_index.GetClusterIndex();
			var size_type q= packed_quad_index.GetQuadIndex();

			auto& center= clusters[c].c.center;
			auto& in_vertices= quads[q].vertices;

			var [ Vec3f, 4 ] vertices
			[
				( f32( center[0] + i32( in_vertices[0][0] ) ), f32( center[1] + i32( in_vertices[0][1] ) ), f32( center[2] + i32( in_vertices[0][2] ) ) ),
				( f32( center[0] + i32( in_vertices[1][0] ) ), f32( center[1] + i32( in_vertices[1][1] ) ), f32( center[2] + i32( in_vertices[1][2] ) ) ),
				( f32( center[0] + i32( in_vertices[2][0] ) ), f32( center[1] + i32( in_vertices[2][1] ) ), f32( center[2] + i32( in_vertices[2][2] ) ) ),
				( f32( center[0] + i32( in_vertices[3][0] ) ), f32( center[1] + i32( in_vertices[3][1] ) ), f32( center[2] + i32( in_vertices[3][2] ) ) ),
			];

			var f32 quad_closest_distance= CalculateIntersectionWithQuad( start_point, line_vector, vertices );

			if( quad_closest_distance < closest_distance )
			{
				closest_distance= quad_closest_distance;
				hit_quad_index= q;
				hit_quad_cluster_index= c;
			}
		} );

	// Just test all dynamic cluster colliders one by one.
	// There are not so many of them
	foreach( & dynamic_cluster_collider : dynamic_cluster_colliders )
	{
		// Perform simple and cheap box test first.
		// In the most cases we should have no intersection.
		if_var( &bbox_intersection : FindRayBBoxIntersection( start_point, line_vector, dynamic_cluster_collider.bbox ) )
		{
			if( !( bbox_intersection.near_point_distance > 1.0f | bbox_intersection.far_point_distance < 0.0f ) )
			{
				// If has intersection with bbox of this dynamic cluster - check each quad.

				var ZvoxCluster& cluster= clusters[ size_type( dynamic_cluster_collider.cluster_index ) ];

				var Vec3f center= dynamic_cluster_collider.bbox.GetCenter();

				for( var u32 mut q= cluster.c.first_quad_index, q_end= cluster.c.first_quad_index + u32( cluster.num_quads );
					q < q_end;
					++q )
				{
					var ZmapQuad& quad= quads[ size_type(q) ];
					auto& in_vertices= quad.vertices;

					var [ Vec3f, 4 ] vertices
					[
						center + Vec3f( f32( in_vertices[0][0] ), f32( in_vertices[0][1] ), f32(  in_vertices[0][2] ) ),
						center + Vec3f( f32( in_vertices[1][0] ), f32( in_vertices[1][1] ), f32(  in_vertices[1][2] ) ),
						center + Vec3f( f32( in_vertices[2][0] ), f32( in_vertices[2][1] ), f32(  in_vertices[2][2] ) ),
						center + Vec3f( f32( in_vertices[3][0] ), f32( in_vertices[3][1] ), f32(  in_vertices[3][2] ) ),
					];

					var f32 quad_closest_distance= CalculateIntersectionWithQuad( start_point, line_vector, vertices );

					if( quad_closest_distance < closest_distance )
					{
						closest_distance= quad_closest_distance;
						hit_quad_index= size_type(q);
						hit_quad_cluster_index= size_type( dynamic_cluster_collider.cluster_index );
					}
				}
			}
		}
	}

	if( hit_quad_index < quads.size() && hit_quad_cluster_index < clusters.size() && closest_distance <= 1.0f )
	{
		return LineTraceResult
		{
			.quad_index( hit_quad_index ),
			.cluster_index( hit_quad_cluster_index ),
			.distance= closest_distance,
		};
	}

	return ust::null_optional;
}


fn LineTraceSingleDynamicCluster(
	GameMapData& map_data,
	DynamicClusterCollider& dynamic_cluster_collider,
	Vec3f& start_point,
	Vec3f& line_vector ) : ust::optional</LineTraceResult/>
{
	auto& clusters= map_data.zvox_data.deref().clusters;
	auto& quads= map_data.zmap_data.deref().quads;

	var f32 mut closest_distance= ust::plus_inf</f32/>();

	var size_type mut hit_quad_index= ~0s, mut hit_quad_cluster_index= ~0s;

	// Perform simple and cheap box test first.
	// In the most cases we should have no intersection.
	if_var( &bbox_intersection : FindRayBBoxIntersection( start_point, line_vector, dynamic_cluster_collider.bbox ) )
	{
		if( !( bbox_intersection.near_point_distance > 1.0f | bbox_intersection.far_point_distance < 0.0f ) )
		{
			// If has intersection with bbox of this dynamic cluster - check each quad.

			var ZvoxCluster& cluster= clusters[ size_type( dynamic_cluster_collider.cluster_index ) ];

			var Vec3f center= dynamic_cluster_collider.bbox.GetCenter();

			for( var u32 mut q= cluster.c.first_quad_index, q_end= cluster.c.first_quad_index + u32( cluster.num_quads );
				q < q_end;
				++q )
			{
				var ZmapQuad& quad= quads[ size_type(q) ];
				auto& in_vertices= quad.vertices;

				var [ Vec3f, 4 ] vertices
				[
					center + Vec3f( f32( in_vertices[0][0] ), f32( in_vertices[0][1] ), f32(  in_vertices[0][2] ) ),
					center + Vec3f( f32( in_vertices[1][0] ), f32( in_vertices[1][1] ), f32(  in_vertices[1][2] ) ),
					center + Vec3f( f32( in_vertices[2][0] ), f32( in_vertices[2][1] ), f32(  in_vertices[2][2] ) ),
					center + Vec3f( f32( in_vertices[3][0] ), f32( in_vertices[3][1] ), f32(  in_vertices[3][2] ) ),
				];

				var f32 quad_closest_distance= CalculateIntersectionWithQuad( start_point, line_vector, vertices );

				if( quad_closest_distance < closest_distance )
				{
					closest_distance= quad_closest_distance;
					hit_quad_index= size_type(q);
					hit_quad_cluster_index= size_type( dynamic_cluster_collider.cluster_index );
				}
			}
		}
	}

	if( hit_quad_index < quads.size() && hit_quad_cluster_index < clusters.size() && closest_distance <= 1.0f )
	{
		return LineTraceResult
		{
			.quad_index( hit_quad_index ),
			.cluster_index( hit_quad_cluster_index ),
			.distance= closest_distance,
		};
	}

	return ust::null_optional;
}

fn CalculateIntersectionWithQuad(
	Vec3f& start_point,
	Vec3f& line_vector,
	[ Vec3f, 4 ]& vertices ) : f32
{
	var f32 mut closest_distance= ust::plus_inf</f32/>();

	// Process each triangle of a quad separately - in case if due to precision errors quads aren't planar.
	// TODO - simplify this code for the majority of the cases with planar quads.

	for( auto mut quad_triangle_index= 0s; quad_triangle_index < 2s; ++quad_triangle_index )
	{
		var Vec3f& v0= vertices[0];
		var Vec3f& v1= vertices[quad_triangle_index + 1s];
		var Vec3f& v2= vertices[quad_triangle_index + 2s];

		// Don't process degenerate triangles, they are sometimes possible.
		if( v0 == v1 || v0 == v2 || v1 == v2 )
		{
			continue;
		}

		var Planef plane= Planef::CreateFromNormalAndPoint( ( v1 - v0 ).Cross( v2 - v0 ), v0 );

		var f32 direction_vector_plane_normal_dot= line_vector.Dot( plane.normal );
		if( direction_vector_plane_normal_dot != 0.0f )
		{
			var f32 ray_start_distance_to_plane= plane.GetDistanceForPoint( start_point );

			// This distance is negative for intersection points behind current ray.
			var f32 signed_distance_to_intersection_point= -ray_start_distance_to_plane / direction_vector_plane_normal_dot;

			if( signed_distance_to_intersection_point > 0.0f && // Process intersections only at the front of the ray.
				signed_distance_to_intersection_point < closest_distance ) // Find the smallest positive distance.
			{
				var Vec3f intersection_point= start_point + line_vector * signed_distance_to_intersection_point;

				// Check if ray-plane intersection lies within the triangle.
				if( ( v1 - v0 ).Cross( intersection_point - v0 ).Dot( plane.normal ) >= 0.0f &&
					( v2 - v1 ).Cross( intersection_point - v1 ).Dot( plane.normal ) >= 0.0f &&
					( v0 - v2 ).Cross( intersection_point - v2 ).Dot( plane.normal ) >= 0.0f )
				{
					closest_distance= signed_distance_to_intersection_point;
				}
			}
		}
	}

	return closest_distance;
}

fn CollisionTrace(
	GameMapData& map_data,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	ust::array_view_imut</Collider/> extra_colliders,
	BBox3f& bbox,
	Vec3f& start_position,
	Vec3f& movement_vector ) : TraceCollisionResult
{
	var TraceCollisionResult mut trace_result
	{
		.clipped_move_distance= ust::plus_inf</f32/>(),
		.collision_point_normal= Vec3f::MakeZero(),
		.collision_quad_index= ~0u
	};

	if( movement_vector.SquareLength() == 0.0f )
	{
		return trace_result;
	}

	var CompactPolyhedron mut collision_polyhedron
	{
		.num_planes= 0u,
		.primary_planes_mask= 0u,
		.planes[ { .normal= Vec3f::MakeZero(), .distance= 0.0f } ... ],
	};

	var Vec3f end_position= start_position + movement_vector;

	// Box containing minimum and maximum coordinates of movement line.
	var BBox3f movement_bbox
	{
		.min=
			bbox.min +
			Vec3f(
				ust::min( start_position.x, end_position.x ),
				ust::min( start_position.y, end_position.y ),
				ust::min( start_position.z, end_position.z ) ),
		.max=
			bbox.max +
			Vec3f(
				ust::max( start_position.x, end_position.x ),
				ust::max( start_position.y, end_position.y ),
				ust::max( start_position.z, end_position.z ) ),
	};

	auto& clusters= map_data.zvox_data.deref().clusters;
	auto& quads= map_data.zmap_data.deref().quads;

	VisitBoundingBoxesHierarchyForBBox(
		map_data.collider_quads_hierarchy,
		movement_bbox,
		lambda[&]( PackedQuadIndex packed_quad_index )
		{
			var size_type c= packed_quad_index.GetClusterIndex();
			var size_type q= packed_quad_index.GetQuadIndex();

			auto& center= clusters[c].c.center;
			auto& in_vertices= quads[q].vertices;

			var [ Vec3f, 4 ] vertices
			[
				( f32( center[0] + i32( in_vertices[0][0] ) ), f32( center[1] + i32( in_vertices[0][1] ) ), f32( center[2] + i32( in_vertices[0][2] ) ) ),
				( f32( center[0] + i32( in_vertices[1][0] ) ), f32( center[1] + i32( in_vertices[1][1] ) ), f32( center[2] + i32( in_vertices[1][2] ) ) ),
				( f32( center[0] + i32( in_vertices[2][0] ) ), f32( center[1] + i32( in_vertices[2][1] ) ), f32( center[2] + i32( in_vertices[2][2] ) ) ),
				( f32( center[0] + i32( in_vertices[3][0] ) ), f32( center[1] + i32( in_vertices[3][1] ) ), f32( center[2] + i32( in_vertices[3][2] ) ) ),
			];

			PerformCollisionWithQuad( bbox, start_position, movement_vector, u32(q), vertices, collision_polyhedron, trace_result );
		} );

	// Just test all dynamic cluster colliders one by one.
	// There are not so many of them
	foreach( & dynamic_cluster_collider : dynamic_cluster_colliders )
	{
		// Perform simple and cheap box test first.
		// In the most cases we should have no intersection.
		if( !movement_bbox.InstersectsOrTouches( dynamic_cluster_collider.bbox ) )
		{
			continue;
		}

		// Perform collision with all cluster quads.

		var ZvoxCluster& cluster= clusters[ size_type( dynamic_cluster_collider.cluster_index ) ];

		var Vec3f center= dynamic_cluster_collider.bbox.GetCenter();

		for( var u32 mut q= cluster.c.first_quad_index, q_end= cluster.c.first_quad_index + u32( cluster.num_quads );
			q < q_end;
			++q )
		{
			var ZmapQuad& quad= quads[ size_type(q) ];
			auto& in_vertices= quad.vertices;

			var [ Vec3f, 4 ] vertices
			[
				center + Vec3f( f32( in_vertices[0][0] ), f32( in_vertices[0][1] ), f32(  in_vertices[0][2] ) ),
				center + Vec3f( f32( in_vertices[1][0] ), f32( in_vertices[1][1] ), f32(  in_vertices[1][2] ) ),
				center + Vec3f( f32( in_vertices[2][0] ), f32( in_vertices[2][1] ), f32(  in_vertices[2][2] ) ),
				center + Vec3f( f32( in_vertices[3][0] ), f32( in_vertices[3][1] ), f32(  in_vertices[3][2] ) ),
			];

			PerformCollisionWithQuad( bbox, start_position, movement_vector, u32(q), vertices, collision_polyhedron, trace_result );
		}
	}

	// Just test all extra colliders one by one.
	// It isn't generally fast, since this introduces quadratic time complexity,
	// because each entity with collider is checked against colliders of all other entities.
	// But it's fast enough to be fine and not to require additional speed-up.
	//
	foreach( &extra_collider : extra_colliders )
	{
		// Perform simple and cheap box test first.
		// In the most cases we should have no intersection.
		if( !movement_bbox.InstersectsOrTouches( extra_collider.bbox ) )
		{
			continue;
		}

		// If boxes are overlapping, search for proper intersection.

		var BBox3f minkowski_sum_bbox
		{
			.min= extra_collider.bbox.min - bbox.max,
			.max= extra_collider.bbox.max - bbox.min,
		};

		if_var( intersection : FindRayBBoxIntersection( start_position, movement_vector, minkowski_sum_bbox ) )
		{
			if( intersection.near_point_distance >= 0.0f )
			{
				// Is outside and moving towards the collider volume.
				// Clip movement by distance to the near intersection point.
				if( intersection.near_point_distance < trace_result.clipped_move_distance )
				{
					trace_result.clipped_move_distance= intersection.near_point_distance;
					trace_result.collision_point_normal= intersection.near_point_normal;
					trace_result.collision_quad_index= ~0u;
				}
			}
			else if( intersection.far_point_distance <= 0.0f )
			{
				// Is outside and moving from the collider volume.
				// Nothing to do here.
			}
			else
			{
				// Is inside.
				var [ Planef, 6 ] collider_planes= CreateBBoxPlanes( minkowski_sum_bbox );

				// Apply extra push towards nearest collider plane.
				// This is necessary if due to numerical errors or some other reasons we still somehow get inside a collider.
				foreach( &push_plane : collider_planes )
				{
					var f32 distance= push_plane.GetDistanceForPoint( start_position + movement_vector );
					if( distance < 0.0f )
					{
						var Vec3f this_quad_push= push_plane.normal * ( -distance / push_plane.normal.SquareLength() );
						if( trace_result.extra_push.empty() ||
							// Select smallest push of such kind.
							this_quad_push.SquareLength() < trace_result.extra_push.try_deref().SquareLength() )
						{
							trace_result.extra_push= this_quad_push;
						}
					}
				}
			}
		}
	}

	return trace_result;
}

fn CollisionTraceSingleDynamicCluster(
	GameMapData& map_data,
	DynamicClusterCollider& dynamic_cluster_collider,
	// Bounding box of the collider.
	BBox3f& bbox,
	// Where to start movement.
	Vec3f& start_position,
	// Direction + distance of the movement.
	Vec3f& movement_vector ) : TraceCollisionResult
{
	var TraceCollisionResult mut trace_result
	{
		.clipped_move_distance= ust::plus_inf</f32/>(),
		.collision_point_normal= Vec3f::MakeZero(),
		.collision_quad_index= ~0u
	};

	if( movement_vector.SquareLength() == 0.0f )
	{
		return trace_result;
	}

	var CompactPolyhedron mut collision_polyhedron
	{
		.num_planes= 0u,
		.primary_planes_mask= 0u,
		.planes[ { .normal= Vec3f::MakeZero(), .distance= 0.0f } ... ],
	};

	var Vec3f end_position= start_position + movement_vector;

	// Box containing minimum and maximum coordinates of movement line.
	var BBox3f movement_bbox
	{
		.min=
			bbox.min +
			Vec3f(
				ust::min( start_position.x, end_position.x ),
				ust::min( start_position.y, end_position.y ),
				ust::min( start_position.z, end_position.z ) ),
		.max=
			bbox.max +
			Vec3f(
				ust::max( start_position.x, end_position.x ),
				ust::max( start_position.y, end_position.y ),
				ust::max( start_position.z, end_position.z ) ),
	};

	// Perform simple and cheap box test first.
	// In the most cases we should have no intersection.
	if( movement_bbox.InstersectsOrTouches( dynamic_cluster_collider.bbox ) )
	{
		// Perform collision with all cluster quads.

		auto& clusters= map_data.zvox_data.deref().clusters;
		auto& quads= map_data.zmap_data.deref().quads;

		var ZvoxCluster& cluster= clusters[ size_type( dynamic_cluster_collider.cluster_index ) ];

		var Vec3f center= dynamic_cluster_collider.bbox.GetCenter();

		for( var u32 mut q= cluster.c.first_quad_index, q_end= cluster.c.first_quad_index + u32( cluster.num_quads );
			q < q_end;
			++q )
		{
			var ZmapQuad& quad= quads[ size_type(q) ];
			auto& in_vertices= quad.vertices;

			var [ Vec3f, 4 ] vertices
			[
				center + Vec3f( f32( in_vertices[0][0] ), f32( in_vertices[0][1] ), f32(  in_vertices[0][2] ) ),
				center + Vec3f( f32( in_vertices[1][0] ), f32( in_vertices[1][1] ), f32(  in_vertices[1][2] ) ),
				center + Vec3f( f32( in_vertices[2][0] ), f32( in_vertices[2][1] ), f32(  in_vertices[2][2] ) ),
				center + Vec3f( f32( in_vertices[3][0] ), f32( in_vertices[3][1] ), f32(  in_vertices[3][2] ) ),
			];

			PerformCollisionWithQuad( bbox, start_position, movement_vector, u32(q), vertices, collision_polyhedron, trace_result );
		}
	}

	return trace_result;
}

fn PerformCollisionWithQuad(
	BBox3f& bbox,
	Vec3f& start_position,
	Vec3f& movement_vector,
	u32 quad_index,
	[ Vec3f, 4 ]& vertices,
	CompactPolyhedron &mut collision_polyhedron, // Temporary variable. Reuse it, since creating it each time is costly.
	TraceCollisionResult &mut trace_result )
{
	CreateBBoxAndQuadMinkowskiSum( bbox, vertices, collision_polyhedron );

	if( collision_polyhedron.num_planes < 4u )
	{
		return;
	}

	auto polyhedron_planes=
		ust::array_view_imut</Planef/>( collision_polyhedron.planes ).subrange_end( size_type( collision_polyhedron.num_planes ) );

	if_var( intersection : FindRayPolyhedronIntersection( start_position, movement_vector, polyhedron_planes ) )
	{
		if( intersection.near_point_distance >= 0.0f )
		{
			// Is outside and moving towards the quad volume.
			// Clip movement by distance to the near intersection point.
			if( intersection.near_point_distance < trace_result.clipped_move_distance )
			{
				trace_result.clipped_move_distance= intersection.near_point_distance;
				trace_result.collision_point_normal= polyhedron_planes[ size_type( intersection.near_plane_index ) ].normal;
				trace_result.collision_quad_index= quad_index;
			}
		}
		else if( intersection.far_point_distance <= 0.0f )
		{
			// Is outside and moving from the quad volume.
			// Nothing to do here.
		}
		else
		{
			// Is inside.

			// Apply extra push towards quad plane.
			// This is necessary if due to numerical errors or some other reasons we still somehow get inside a collider.
			for( auto mut plane_index= 0s; plane_index < polyhedron_planes.size(); ++plane_index )
			{
				if( ( collision_polyhedron.primary_planes_mask & ( 1u << plane_index ) ) != 0u )
				{
					var Planef& push_plane= polyhedron_planes[ plane_index ];

					var f32 distance= push_plane.GetDistanceForPoint( start_position + movement_vector );
					if( distance < 0.0f )
					{
						var Vec3f this_quad_push= push_plane.normal * ( -distance / push_plane.normal.SquareLength() );
						if( trace_result.extra_push.empty() ||
							// Select smallest push of such kind.
							this_quad_push.SquareLength() < trace_result.extra_push.try_deref().SquareLength() )
						{
							trace_result.extra_push= this_quad_push;
						}
					}
				}
			}
		}
	}
}

fn CollisionTraceAndClip(
	GameMapData& map_data,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	ust::array_view_imut</Collider/> extra_colliders,
	BBox3f& bbox,
	Vec3f mut movement_start_position,
	Vec3f mut movement_end_position ) : CollisionTraceClipResult
{
	var CollisionTraceClipResult mut result
	{
		.position_clipped= movement_start_position,
		.num_collision_events= 0u,
		.collision_events[ { .plane_normal= Vec3f::MakeZero(), .collision_quad_index= ~0u } ... ]
	};

	// Perform several iterations to clip and slide against several planes.
	// It's needed to resolve collisions in corners properly.
	for( auto mut movement_iteration= 0s; movement_iteration < CollisionTraceClipResult::c_max_collision_events; ++movement_iteration )
	{
		if( movement_start_position == movement_end_position )
		{
			break;
		}

		var Vec3f movement_vector= movement_end_position - movement_start_position;

		var TraceCollisionResult trace_result=
			CollisionTrace(
				map_data,
				dynamic_cluster_colliders,
				extra_colliders,
				bbox,
				movement_start_position,
				movement_vector );

		var Vec3f mut new_movement_start_position=
			movement_start_position +
			movement_vector * ust::min( 1.0f, trace_result.clipped_move_distance );

		// Apply extra push if has one and only if has no clip by some other plane.
		if( !trace_result.extra_push.empty() && trace_result.clipped_move_distance > 1.0f )
		{
			new_movement_start_position+= trace_result.extra_push.try_deref();
		}

		var Vec3f mut new_movement_end_position= new_movement_start_position;

		if( trace_result.clipped_move_distance <= 1.0f )
		{
			// Slightly push out from the collision plane.
			// Perform this push against movement direction.
			var f32 normal_square_length= trace_result.collision_point_normal.SquareLength();
			if( normal_square_length > 0.0f )
			{
				var f32 dot= movement_vector.Dot( trace_result.collision_point_normal );
				if( dot != 0.0f )
				{
					// Do not allow pushing more than back to the original position.
					var f32 push_fraction= ust::max( -1.0f, ust::min( 0.0f, c_collider_plane_push_eps * ust::sqrt( normal_square_length  ) / dot ) );

					var Vec3f push_vec= movement_vector * push_fraction;
					new_movement_start_position+= push_vec;
					new_movement_end_position+= push_vec;
				}
			}

			if( normal_square_length > 0.0f )
			{
				var f32 remaining_movement_fration= 1.0f - trace_result.clipped_move_distance;
				var Vec3f remaining_movement_vector= movement_vector * remaining_movement_fration;

				var Vec3f mut remaining_movement_vector_clamped=
					remaining_movement_vector -
					trace_result.collision_point_normal * ( remaining_movement_vector.Dot( trace_result.collision_point_normal ) / normal_square_length );

				// Fix for movement in sharp corners.
				// If we have more than one clip plane, move only along the line of intersection of these planes.
				for( auto mut j= 0u; j < result.num_collision_events; ++j )
				{
					var Vec3f& prev_collision_normal= result.collision_events[j].plane_normal;
					if( remaining_movement_vector_clamped.Dot( prev_collision_normal ) < 0.0f )
					{
						var Vec3f cross= prev_collision_normal.Cross( trace_result.collision_point_normal );
						var f32 cross_square_length= cross.SquareLength();
						if( cross_square_length > 0.0f )
						{
							remaining_movement_vector_clamped=
								cross * ( remaining_movement_vector_clamped.Dot( cross ) / cross_square_length );
						}
					}
				}

				new_movement_end_position+= remaining_movement_vector_clamped;
			}

			result.collision_events[ result.num_collision_events ]=
				CollisionTraceClipResult::CollisionEvent
				{
					.plane_normal= trace_result.collision_point_normal,
					.collision_quad_index= trace_result.collision_quad_index,
				};

			++result.num_collision_events;
		}

		movement_start_position= new_movement_start_position;
		movement_end_position= new_movement_end_position;
	}

	result.position_clipped= movement_start_position;

	return result;
}

fn CollisionStepMove(
	GameMapData& map_data,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	ust::array_view_imut</Collider/> extra_colliders,
	BBox3f& bbox,
	Vec3f movement_start_position,
	Vec3f movement_end_position ) : CollisionStepMoveResult
{
	var CollisionTraceClipResult mut collision_trace_clip_result=
		CollisionTraceAndClip(
			map_data,
			dynamic_cluster_colliders,
			extra_colliders, bbox,
			movement_start_position,
			movement_end_position );

	var bool mut collided_with_wall= false;
	var u32 mut ground_planes_mask= 0u;

	for( auto mut i= 0u; i < collision_trace_clip_result.num_collision_events; ++i )
	{
		var Vec3f& normal= collision_trace_clip_result.collision_events[i].plane_normal;
		var f32 normal_length= normal.Length();
		if( normal_length > 0.0f )
		{
			if( (-normal.z) / normal_length >= c_ground_plane_min_normal_z )
			{
				ground_planes_mask|= 1u << i;
			}
		}

		// Assume only exactly vertical polygons to be walls.
		// We can't assume even slightly-inclining polygons for performing step movement, since such movement doesn't look great.
		collided_with_wall|= normal.z == 0.0f;
	}

	if( ground_planes_mask != 0u && collided_with_wall )
	{
		var Vec3f mut position_with_step_movement= movement_start_position;

		// Original game has steps with height 16. Add one extra unit to make sure we can climb all stairs.
		var f32 constexpr c_step_height= 17.0f;

		// Try performing movement up.
		var Vec3f up_movement_vector( 0.0f, 0.0f, -c_step_height );

		var TraceCollisionResult up_trace_result=
			CollisionTrace(
				map_data,
				dynamic_cluster_colliders,
				extra_colliders,
				bbox,
				position_with_step_movement,
				up_movement_vector );

		if( up_trace_result.clipped_move_distance > 0.0f && up_trace_result.extra_push.empty() )
		{
			// Movement up is possible - do it.

			// Do not move up the whole distance to avoid landing exactly on edge of some collider.
			position_with_step_movement.z-=
				ust::max( 0.0f, ust::min( 1.0f, up_trace_result.clipped_move_distance ) * c_step_height - c_collider_plane_push_eps );

			// Try performing sideways movement using the original movement vector but with start position moved up and Z movement zeroed.
			var Vec3f mut side_movement_vector= movement_end_position - movement_start_position;
			var f32 extra_z_movement= side_movement_vector.z;
			side_movement_vector.z= 0.0f;

			var CollisionTraceClipResult mut tweaked_collision_trace_clip_result=
				CollisionTraceAndClip(
					map_data,
					dynamic_cluster_colliders,
					extra_colliders,
					bbox,
					position_with_step_movement,
					position_with_step_movement + side_movement_vector );

			if( tweaked_collision_trace_clip_result.position_clipped != position_with_step_movement )
			{
				// We managed to perform sideways move from a lifted position.

				position_with_step_movement= tweaked_collision_trace_clip_result.position_clipped;

				// Move also down - in case if a step is small or if we just hit a solid wall (not a step).

				var Vec3f down_movement_vector( 0.0f, 0.0f, ust::max( 0.0f, c_step_height + extra_z_movement ) );

				var TraceCollisionResult down_trace_result=
					CollisionTrace(
						map_data,
						dynamic_cluster_colliders,
						extra_colliders,
						bbox,
						position_with_step_movement,
						down_movement_vector );

				if( down_trace_result.clipped_move_distance > 0.0f && down_trace_result.extra_push.empty() )
				{
					// Do not move down the whole distance to avoid landing exactly on edge of some collider.
					position_with_step_movement.z+=
						ust::max( 0.0f, ust::min( 1.0f, down_trace_result.clipped_move_distance ) * down_movement_vector.z - c_collider_plane_push_eps );

					if( size_type( tweaked_collision_trace_clip_result.num_collision_events ) < CollisionTraceClipResult::c_max_collision_events )
					{
						tweaked_collision_trace_clip_result.collision_events[ tweaked_collision_trace_clip_result.num_collision_events ]=
							 CollisionTraceClipResult::CollisionEvent
							 {
								.plane_normal= down_trace_result.collision_point_normal,
								.collision_quad_index= down_trace_result.collision_quad_index,
							 };

						++tweaked_collision_trace_clip_result.num_collision_events;
					}
				}

				var u32 mut new_ground_planes_mask= 0u;

				for( auto mut i= 0u; i < tweaked_collision_trace_clip_result.num_collision_events; ++i )
				{
					var Vec3f& normal= tweaked_collision_trace_clip_result.collision_events[i].plane_normal;
					var f32 normal_length= normal.Length();
					if( normal_length > 0.0f )
					{
						if( (-normal.z) / normal_length >= c_ground_plane_min_normal_z )
						{
							new_ground_planes_mask|= 1u << i;
						}
					}

					// Assume only exactly vertical polygons to be walls.
					// We can't assume even slightly-inclining polygons for performing step movement, since such movement doesn't look great.
					collided_with_wall|= normal.z == 0.0f;
				}

				if( new_ground_planes_mask != 0u )
				{
					// Update clip planes and result position if has ground at step destination.
					collision_trace_clip_result= tweaked_collision_trace_clip_result;
					collision_trace_clip_result.position_clipped= position_with_step_movement;
					ground_planes_mask= new_ground_planes_mask;
				}
			}
		}
	}

	return CollisionStepMoveResult
	{
		.trace_clip_result= collision_trace_clip_result,
		.ground_planes_mask= ground_planes_mask,
	};
}

// Push collision result slightly from collider planes using this amout.
// It's necessary to avoid numerical precision issues when even a clopped collision leads to result position inside a collider.
var f32 c_collider_plane_push_eps= 1.0f / 32.0f;

// Assume ground surfaces all surfaces with normal pointing mostly up.
// This value is tuned so that it's possible to jump on some steap ramps, where it's possible to jump in the original.
var f32 c_ground_plane_min_normal_z= 0.67f;

} // namespace PM
