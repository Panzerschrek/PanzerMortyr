import "mirrors.iu"

namespace PM
{

fn CalculateMirrorPlane(
	ust::array_view_imut</MapVertex/> vertices, ust::array_view_imut</u16/> indices ) : ust::optional</Planef/>
{
	var Vec3f mut normals_sum= Vec3f::MakeZero();

	for( auto mut i= 0s; i + 3s <= indices.size(); i+= 3s )
	{
		var [ size_type, 3 ] trianlge_indices
		[
			( indices[ i + 0s ] ),
			( indices[ i + 1s ] ),
			( indices[ i + 2s ] ),
		];

		var [ Vec3f, 3 ] triangle_vertices
		[
			( vertices[ trianlge_indices[0] ].position ),
			( vertices[ trianlge_indices[1] ].position ),
			( vertices[ trianlge_indices[2] ].position ),
		];

		normals_sum+=
			( triangle_vertices[0] - triangle_vertices[1] ).Cross( triangle_vertices[1] - triangle_vertices[2] );
	}

	var f32 normals_sum_length= normals_sum.Length();
	if( normals_sum_length <= 0.0f )
	{
		return ust::null_optional;
	}

	var Vec3f normal= normals_sum / normals_sum_length;

	var f32 mut min_distance= ust::plus_inf</f32/>();

	foreach( &vertex : vertices )
	{
		ust::min_assign( min_distance, normal.Dot( Vec3f( vertex.position ) ) );
	}

	return Planef{ .normal= normal, .distance= -min_distance };
}

fn CalculateMirrorBounds( ust::array_view_imut</MapVertex/> vertices ) : BBox3f
{
	var BBox3f mut bbox
	{
		.min( ust::plus_inf</f32/>() , ust::plus_inf</f32/>() , ust::plus_inf</f32/>()  ),
		.max( ust::minus_inf</f32/>(), ust::minus_inf</f32/>(), ust::minus_inf</f32/>() ),
	};

	foreach( &v : vertices )
	{
		bbox.ExtendWithPoint( Vec3f( v.position ) );
	}

	return bbox;
}

} // namespace PM
