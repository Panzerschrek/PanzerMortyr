namespace PM
{

// Each bit represents state of a button.
type MouseButtonsState= u32;

// This function does the same as SDL_BUTTON macro.
fn MouseButtonIsPressed( MouseButtonsState state, u32 button_index ) : bool
{
	return ( state & ( 1u << ( button_index - 1u ) ) ) != 0u;
}

fn SetMouseButtonPressed( MouseButtonsState &mut state, u32 button_index )
{
	state |= 1u << button_index - 1u;
}

} // namespace PM
