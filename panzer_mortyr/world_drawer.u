var GLState g_map_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= true,
	.depth_test_func( GL_LESS ),
	.depth_write_enabled= true,
	.cull_face_enabled= true,
	.cull_face( GL_FRONT ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

var GLState g_map_dynamic_lights_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= true,
	// Draw with equal depth test only - to draw dynamic lights atop of previosly drawn map polygons.
	.depth_test_func( GL_EQUAL ),
	.depth_write_enabled= true,
	.cull_face_enabled= true,
	.cull_face( GL_FRONT ),
	// Use additive blending for dynamic lights.
	.blending_enabled= true,
	.blend_source_factor( GL_ONE ),
	.blend_destination_factor( GL_ONE ),
};

var GLState g_semitransparent_geometry_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= true,
	.depth_test_func( GL_LESS ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	// Use premultiplied alpha blending.
	.blending_enabled= true,
	.blend_source_factor( GL_ONE ),
	.blend_destination_factor( GL_ONE_MINUS_SRC_ALPHA ),
};

var GLState g_first_person_weapon_models_depth_clear_gl_state
{
	// Don't bother writing color.
	.color_write_enabled= false,
	// Stupid OpenGL!
	//
	// https://wikis.khronos.org/opengl/GLAPI/glDepthMask
	//   Even if the depth buffer exists and the depth mask is non-zero,
	//   the depth buffer is not updated if the depth test is disabled.
	//   In order to unconditionally write to the depth buffer,
	//   the depth test should be enabled and set to GL_ALWAYS (see glDepthFunc).
	//
	// So, enable depth test but use ALWAYS constant.
	.depth_test_enabled= true,
	.depth_test_func( GL_ALWAYS ),
	.depth_write_enabled= true,
	.cull_face_enabled= true,
	.cull_face( GL_FRONT ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

var GLState g_models_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= true,
	.depth_test_func( GL_LEQUAL ), // <= for allowing drawing atop of the same model drawn in some previous pass.
	.depth_write_enabled= true,
	.cull_face_enabled= true,
	.cull_face( GL_FRONT ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

var GLState g_test_primitives_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= true,
	.depth_test_func( GL_LESS ),
	.depth_write_enabled= true,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

var GLState g_global_fog_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= false,
	.depth_test_func( GL_NONE ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= true,
	.blend_source_factor( GL_SRC_ALPHA ),
	.blend_destination_factor( GL_ONE_MINUS_SRC_ALPHA ),
};

var GLState g_local_fog_gl_state
{
	.color_write_enabled= true,
	// Don't perform depth test. Instead read depth in the local fog shader and use it to determine fog density.
	.depth_test_enabled= false,
	.depth_test_func( GL_NONE ),
	.depth_write_enabled= false,
	// Draw back faces of the local fog volume.
	// Doing so we ensure the volume is drawn even if camera is inside it.
	.cull_face_enabled= true,
	.cull_face( GL_BACK ),
	.blending_enabled= true,
	// Use additive blending for local fog.
	.blend_source_factor( GL_ONE ),
	.blend_destination_factor( GL_ONE ),
};

