import "/enum_string_conversions.u"
import "/scoped_array.u"
import "/sort.u"
import "/string_conversions.u"

import "/common_lib/materials_file.uh"

import "bounding_boxes_hierarchy_visiting.uh"
import "cluster_utils.uh"
import "gl_functions.uh"
import "gl_state.uh"
import "image_loading.uh"
import "math_constants.uh"
import "plane.uh"
import "world_drawer.uh"

namespace PM
{

fn WorldDrawer::constructor(
	SettingsPtr mut settings,
	GameFilesystemPtr mut game_filesystem_ptr,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader,
	ConsoleOutPtr mut console_out,
	GLCapabilities& gl_capabilities )
	(
		settings_= move( settings ),
		billboards_description_= LoadBillboardsDescription( game_filesystem_ptr, console_out ),
		game_filesystem_ptr_= move( game_filesystem_ptr ),
		game_params_=
			lambda[&]() : GameResourcePtr</GameParams/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadGameParams();
			}(),
		maps_description_=
			lambda[&]() : GameResourcePtr</MapsDescription/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadMapsDescription();
			}(),
		materials_description_=
			lambda[&]() : GameResourcePtr</MaterialsDescription/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadMaterialsDescription();
			}(),
		caching_game_resources_loader_ptr_= move( caching_game_resources_loader ),
		console_out_= move(console_out),
		gl_capabilities_= gl_capabilities,
		map_shader_(
			embed</char8/>( "shaders/map.vert.glsl" ),
			embed</char8/>( "shaders/map.frag.glsl" ) ),
		model_shader_(
			embed</char8/>( "shaders/model.vert.glsl" ),
			embed</char8/>( "shaders/model.frag.glsl" ) ),
		sky_background_shader_(
			embed</char8/>( "shaders/sky_background.vert.glsl" ),
			embed</char8/>( "shaders/sky_background.frag.glsl" ) ),
		stars_shader_(
			embed</char8/>( "shaders/stars.vert.glsl" ),
			embed</char8/>( "shaders/stars.frag.glsl" ) ),
		clouds_shader_(
			embed</char8/>( "shaders/clouds.vert.glsl" ),
			embed</char8/>( "shaders/clouds.frag.glsl" ) ),
		semitransparent_geometry_shader_(
			embed</char8/>( "shaders/semitransparent_geometry.vert.glsl" ),
			embed</char8/>( "shaders/semitransparent_geometry.frag.glsl" ) ),
		test_primitive_shader_(
			embed</char8/>( "shaders/test_primitive.vert.glsl" ),
			embed</char8/>( "shaders/test_primitive.frag.glsl" ) ),
		semitransparent_polygons_buffer_
		{
			.vertex_buffer=
				BufferObject::CreateUninitializedDynamicDrawBuffer(
					GLenum( GL_ARRAY_BUFFER ),
					c_max_semitransparent_polygon_vertices * typeinfo</MapVertex/>.size_of ),
			.max_vertices= c_max_semitransparent_polygon_vertices,
			.index_buffer=
				BufferObject::CreateUninitializedDynamicDrawBuffer(
					GLenum( GL_ELEMENT_ARRAY_BUFFER ),
					c_max_semitransparent_polygon_indices * typeinfo</u16/>.size_of ),
			.max_indices= c_max_semitransparent_polygon_indices,
		},
		test_primitive_vertex_buffer_object_=
			BufferObject::CreateUninitializedDynamicDrawBuffer(
				GLenum( GL_ARRAY_BUFFER ),
				c_max_test_primitive_vertices * typeinfo</TestPrimitiveVertex/>.size_of ),
		map_index_= 0u,
	)
{
	PrepareVertexArrayObjectWithMapVertexFormat(
		semitransparent_polygons_buffer_.vertex_array_object, semitransparent_polygons_buffer_.vertex_buffer );

	test_primitive_vertex_array_object_.Bind();
	test_primitive_vertex_buffer_object_.Bind();

	// These constants should match locations in the shader!
	var u32 c_test_primitive_position_attrib= 0u;
	var u32 c_test_primitive_color_attrib= 1u;

	unsafe( glEnableVertexAttribArray( c_test_primitive_position_attrib ) );

	unsafe( glVertexAttribPointer(
		c_test_primitive_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</TestPrimitiveVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ TestPrimitiveVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( c_test_primitive_color_attrib ) );

	unsafe( glVertexAttribPointer(
		c_test_primitive_color_attrib,
		3,
		GLenum( GL_UNSIGNED_BYTE ),
		GLboolean(1),
		GLsizei( typeinfo</TestPrimitiveVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ TestPrimitiveVertex, "color" />() ) );
}

fn WorldDrawer::Draw( mut this, WorldDrawingInfo& drawing_info, WorldDrawingViewportInfo& viewport_info ) : DrawingStats
{
	var DrawingStats mut drawing_stats= zero_init;

	// Ensure we have actual map data.
	SetMap( drawing_info.map_index );

	// Load models in use.
	// TODO - precache models to avoid doing loading outside map loading phase, since it may lead to frame lags.
	LoadModelsIfNecessary(
		drawing_info.model_objects, game_filesystem_ptr_, console_out_, settings_, gl_capabilities_, models_ );

	SetGLState( g_buffer_clear_gl_state );

	if( map_data_.empty() )
	{
		unsafe( glClearColor( GLclampf(32.0 / 255.0), GLclampf(16.0 / 255.0), GLclampf(8.0f / 255.0f), GLclampf(1.0) ) );
		unsafe( glClear( GLbitfield( GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT ) ) );

		return drawing_stats;
	}

	var MapDrawData& map_data= map_data_.try_deref();

	// Clear only depth buffer, but not color buffer.
	// Clearing color isn't necessary, since we draw sky background geometry.
	unsafe( glClear( GLbitfield( GL_DEPTH_BUFFER_BIT ) ) );

	var Mat4f rotation_matrix=
		CalculateCameraRotationMatrix( drawing_info.camera_params.azimuth, drawing_info.camera_params.elevation );

	var Mat4f camera_projection_matrix=
		Mat4f::MakePerspective( viewport_info.view_aspect, drawing_info.camera_params.fov_x, c_z_near, c_z_far );

	var Mat4f rotation_and_projection_matrix= rotation_matrix * camera_projection_matrix;

	var Mat4f translation_matrix= Mat4f::MakeTranslation( -drawing_info.camera_params.position );

	var Mat4f view_matrix= translation_matrix * rotation_and_projection_matrix;

	var Mat4f firt_person_weapon_view_matrix=
		translation_matrix *
		rotation_matrix *
		CalculateFirstPersonWeaponProjectionDistortionMatrix() *
		camera_projection_matrix;

	var CameraClipPlanes camera_clip_planes=
		CreateCameraClipPlanes( drawing_info.camera_params, viewport_info.view_aspect );

	DrawSkyBackground( map_data.sky_background_buffer, sky_background_shader_, rotation_and_projection_matrix );

	if( !map_data.sky_clouds_params.empty() && map_data.clouds_texture_layer != ~0u )
	{
		DrawClouds(
			map_data.sky_clouds_params.try_deref(),
			clouds_shader_,
			map_data.map_textures_array,
			map_data.clouds_texture_layer,
			rotation_and_projection_matrix,
			drawing_info.game_time_s );
	}

	// Draw stars/moon AFTER clouds. This isn't fully correct, but this allows to draw sun/moon with proper brightness.
	DrawStarsAndSun(
		map_data.stars_buffer, stars_shader_, map_data.map_textures_array, rotation_and_projection_matrix );

	var ust::array_view_imut</ZvoxCluster/> clusters= map_data.zvox_data.deref().clusters;

	var ust::array_view_imut</ZmapLemClusterSkyLightData/> clusters_sky_light_data=
		map_data.zmap_lem_data.deref().clusters_sky_light_data;

	var RoomClustersHierarchy& room_clusters_hierarchy= map_data.room_clusters_hierarchy.deref();

	// Perform visibility checks only for room clusters.
	// Doing it for non-room clusters is too costly, since there are too many of them.
	// TODO - allocate this  container once at map start?
	scoped_array bool mut visible_room_cluster_flags[ clusters.size() ]( false );

	MarkVisibleRoomClusters(
		room_clusters_hierarchy,
		clusters,
		map_data.zpoz_data.deref(),
		drawing_info.camera_params.position,
		visible_room_cluster_flags );

	// Perform frustum culling for potentially-visible room clusters.
	RejectVisibleRoomClustersUsingCameraPlanes( clusters, camera_clip_planes, visible_room_cluster_flags );

	// Calculate bounding box including all visible clusters.
	// It allows to perform rought rejection of things outside this box.

	var BBox3f visible_clusters_bbox=
		CalculateVisibleClustersBBox( clusters, visible_room_cluster_flags, drawing_info.camera_params.position );

	DrawMapPolygons(
		map_data,
		visible_room_cluster_flags,
		visible_clusters_bbox,
		drawing_info.dynamic_cluster_objects,
		map_shader_,
		view_matrix,
		drawing_stats );

	// Prepare list of models to draw.

	var bool fullbright= settings_.lock_imut().deref().r_fullbright;

	foreach( &model_object : drawing_info.model_objects )
	{
		var ust::optional_ref_imut</ ust::optional</GPUModel/> /> model_opt_opt= models_.find( model_object.model_file_name );

		if( model_opt_opt.empty() )
		{
			continue;
		}

		var ust::optional</GPUModel/>& model_opt= model_opt_opt.try_deref();
		if( model_opt.empty() )
		{
			continue;
		}

		var GPUModel& model= model_opt.try_deref();

		var Mat4f rotation_matrix=
			Mat4f::MakeRotationX( model_object.elevation ) *
			Mat4f::MakeRotationZ( model_object.azimuth );

		var Mat4f model_transormation_matrix= rotation_matrix * Mat4f::MakeTranslation( model_object.position );

		// It looks like frame numbers above maximum are replaced with zeros.
		// This seems to be used by weapon shot animations.
		var size_type in_frame( model_object.frame );
		var size_type frame= ( in_frame < model.num_frames ? in_frame : 0s );

		var BBox3f& frame_bbox= model.frame_bboxes[ frame ];

		if( !model_object.first_person_weapon )
		{
			// Calculate  bounding box of the model in world space (including even rotations).
			var [ Vec3f, 8 ] bbox_corners_transformed
			[
				Vec3f( frame_bbox.min.x, frame_bbox.min.y, frame_bbox.min.z ) * model_transormation_matrix,
				Vec3f( frame_bbox.max.x, frame_bbox.min.y, frame_bbox.min.z ) * model_transormation_matrix,
				Vec3f( frame_bbox.min.x, frame_bbox.max.y, frame_bbox.min.z ) * model_transormation_matrix,
				Vec3f( frame_bbox.max.x, frame_bbox.max.y, frame_bbox.min.z ) * model_transormation_matrix,
				Vec3f( frame_bbox.min.x, frame_bbox.min.y, frame_bbox.max.z ) * model_transormation_matrix,
				Vec3f( frame_bbox.max.x, frame_bbox.min.y, frame_bbox.max.z ) * model_transormation_matrix,
				Vec3f( frame_bbox.min.x, frame_bbox.max.y, frame_bbox.max.z ) * model_transormation_matrix,
				Vec3f( frame_bbox.max.x, frame_bbox.max.y, frame_bbox.max.z ) * model_transormation_matrix,
			];

			if( !model_object.disable_culling )
			{
				var BBox3f mut bbox
				{
					.min= bbox_corners_transformed[0],
					.max= bbox_corners_transformed[0],
				};

				for( auto mut i= 1s; i < 8s; ++i )
				{
					var Vec3f& v= bbox_corners_transformed[i];
					ust::min_assign( bbox.min.x, v.x );
					ust::min_assign( bbox.min.y, v.y );
					ust::min_assign( bbox.min.z, v.z );
					ust::max_assign( bbox.max.x, v.x );
					ust::max_assign( bbox.max.y, v.y );
					ust::max_assign( bbox.max.z, v.z );
				}

				// First perform fast check if this model is within the bbox containing all visible clusters.
				if( !visible_clusters_bbox.InstersectsOrTouches( bbox ) )
				{
					continue;
				}

				// Then check if this model is within at least one visible cluster.
				if( !IsBBoxWithinVisibleClusters(
						clusters, room_clusters_hierarchy, visible_room_cluster_flags, bbox ) )
				{
					continue;
				}
			}

			// Perform more costly check against camera clip planes.
			if( AreBoxVerticesClippedByAtLeastOneCameraClipPlane( camera_clip_planes, bbox_corners_transformed ) )
			{
				continue;
			}
		}

		var Mat4f model_full_matrix=
			model_transormation_matrix * ( model_object.first_person_weapon ? firt_person_weapon_view_matrix : view_matrix );

		var SphericalHarmonicsRGB mut light
		[
			{ .directional_components= Vec3f::MakeZero(), .constant_component= 1.0f } ...
		];

		if( !fullbright & !model_object.constant_lighting )
		{
			var Vec3f bbox_center= frame_bbox.GetCenter() * model_transormation_matrix;
			var f32 radius= frame_bbox.GetDimensions().Length() * 0.5f;

			// https://en.wikipedia.org/wiki/Rotation_matrix#Multiplication.
			//   The inverse of a rotation matrix is its transpose, which is also a rotation matrix:
			//
			var Mat4f inverse_model_rotation_matrix= rotation_matrix.Transpose();

			light=
				GetLightForPoint(
					map_data.light_sources,
					clusters,
					clusters_sky_light_data,
					room_clusters_hierarchy,
					bbox_center,
					radius,
					inverse_model_rotation_matrix );

			if( model_object.first_person_weapon )
			{
				foreach( &mut l : light )
				{
					// Always give some light for first-person weapon.
					ust::max_assign( l.constant_component, 1.0f / 16.0f );
				}
			}
		}

		models_to_draw_.push_back(
			ModelToDraw
			{
				.file_name= model_object.model_file_name,
				.frame( frame ),
				.matrix= model_full_matrix,
				.light= light,
			} );
	}

	// Group models by file name to avoid switching textures and vertex buffers too often.
	ust::sort(
		models_to_draw_.range(),
		lambda( ModelToDraw& l, ModelToDraw& r ) : bool
		{
			// TODO - avoid comparing strings character by character.
			for( auto mut i= 0s; i < typeinfo</ResourceString/>.element_count; ++i )
			{
				var char8 c_l= l.file_name[i];
				var char8 c_r= r.file_name[i];
				if( c_l != c_r )
				{
					return c_l < c_r;
				}
			}
			return false;
		} );

	// Perform actual models drawing.
	DrawModels( models_, models_to_draw_, model_shader_, drawing_stats );
	models_to_draw_.clear();

	DrawTestPrimitives(
		drawing_info.test_sprites,
		drawing_info.test_triangles,
		drawing_info.test_lines,
		test_primitive_vertex_array_object_,
		test_primitive_vertex_buffer_object_,
		test_primitive_shader_,
		view_matrix );

	ResetDynamicPolygonsBuffer( semitransparent_polygons_buffer_ );

	BuildBillboardPolygons(
		drawing_info.billboards,
		billboards_description_,
		drawing_info.camera_params,
		camera_clip_planes,
		visible_clusters_bbox,
		semitransparent_polygons_buffer_.vertices,
		semitransparent_polygons_buffer_.indices,
		drawing_stats );

	{
		var MapsDescription& maps_description= maps_description_.deref();
		if( size_type( map_index_ ) < maps_description.maps.size() )
		{
			var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type( map_index_ ) ];

			CreateGlassPolygons(
				map_data,
				materials_description_.deref().blocks[ map_description.materials_block ], // Halts if not found.
				visible_room_cluster_flags,
				drawing_info.dynamic_cluster_objects,
				semitransparent_polygons_buffer_.vertices,
				semitransparent_polygons_buffer_.indices );
		}
	}

	// TODO - sort semitransparent polygons by depth or camera distance here.

	UploadDynamicPolygonsBuffer( semitransparent_polygons_buffer_ );

	// Draw semitransparent geometry after all opaque geometry.

	DrawSemitransparentGeometry(
		semitransparent_polygons_buffer_,
		semitransparent_geometry_shader_,
		map_data.map_textures_array,
		view_matrix );

	drawing_stats.num_visible_semitransparent_triangles+= u32( semitransparent_polygons_buffer_.indices.size() ) / 3u;

	ResetDynamicPolygonsBuffer( semitransparent_polygons_buffer_ );

	return drawing_stats;
}

fn WorldDrawer::SetMap( mut this, u32 map_index )
{
	// Check if we need to reload map first.
	if( map_index == map_index_ )
	{
		return;

	}
	// Need to load map data.

	// Set map index in any case - it may be necessary in order to avoid reloading map data constantly if failed to load it once.
	map_index_= map_index;

	// Reset previous map data first - to free used memory before allocating new memory for new map.
	map_data_.reset();

	if( map_index == 0u )
	{
		ConsoleOutAddTextLine( console_out_, "Can't load map 0!" );
		return;
	}

	auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	var MapsDescription& maps_description= maps_description_.deref();

	if( size_type( map_index ) >= maps_description.maps.size() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Map with index ", ust::to_string8( map_index ), " not found!" ) );
		return;
	}

	var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type( map_index ) ];

	var MaterialsDescription::Block& materials_block= materials_description_.deref().blocks[ map_description.materials_block ]; // Halts if not found.

	var GameResourceNullablePtr</ZmapData/> zmap_data_nullable_ptr= caching_game_resources_loader.LoadZmapFile( map_index );
	var GameResourceNullablePtr</ZvoxData/> zvox_data_nullable_ptr= caching_game_resources_loader.LoadZvoxFile( map_index );
	var GameResourceNullablePtr</ZpozData/> zpoz_data_nullable_ptr= caching_game_resources_loader.LoadZpozFile( map_index );
	var GameResourceNullablePtr</ZmapLamData/> zmap_lam_data_nullable_ptr= caching_game_resources_loader.LoadZmapLamFile( map_index );
	var GameResourceNullablePtr</ZmapLemData/> zmap_lem_data_nullable_ptr= caching_game_resources_loader.LoadZmapLemFile( map_index );
	var GameResourceNullablePtr</RoomClustersHierarchy/> room_clusters_hierarchy_nullable_ptr= caching_game_resources_loader.LoadRoomClustersHierarchy( map_index );

	if( zmap_data_nullable_ptr.empty() ||
		zvox_data_nullable_ptr.empty() ||
		zpoz_data_nullable_ptr.empty() ||
		zmap_lam_data_nullable_ptr.empty() ||
		zmap_lam_data_nullable_ptr.empty() ||
		room_clusters_hierarchy_nullable_ptr.empty() )
	{
		return;
	}

	var GameResourcePtr</ZmapData/> zmap_data_ptr= zmap_data_nullable_ptr.try_to_non_nullable();
	var GameResourcePtr</ZvoxData/> zvox_data_ptr= zvox_data_nullable_ptr.try_to_non_nullable();
	var GameResourcePtr</ZpozData/> zpoz_data_ptr= zpoz_data_nullable_ptr.try_to_non_nullable();
	var GameResourcePtr</ZmapLamData/> zmap_lam_data_ptr= zmap_lam_data_nullable_ptr.try_to_non_nullable();
	var GameResourcePtr</ZmapLemData/> zmap_lem_data_ptr= zmap_lem_data_nullable_ptr.try_to_non_nullable();
	var GameResourcePtr</RoomClustersHierarchy/> room_clusters_hierarchy_ptr= room_clusters_hierarchy_nullable_ptr.try_to_non_nullable();

	var ZmapData& zmap_data= zmap_data_ptr.deref();
	var ZvoxData& zvox_data= zvox_data_ptr.deref();
	var ZmapLamData& zmap_lam_data= zmap_lam_data_ptr.deref();
	var ZmapLemData& zmap_lem_data= zmap_lem_data_ptr.deref();
	var RoomClustersHierarchy& room_clusters_hierarchy= room_clusters_hierarchy_ptr.deref();

	var ust::vector</PointLightSource/> mut light_sources=
		CreatePointLightSourcesForMapLightSources( zvox_data, game_params_.deref() );

	var ust::vector</ MapVertex /> mut vertices;
	var ust::vector</u16/> mut indices;

	var ust::vector</ClusterDrawData/> mut clusters_draw_data(
		zvox_data.clusters.size(),
		ClusterDrawData
		{
			.first_vertex_index= 0s, // Set later.
			.first_index= 0s, // Set later.
			.num_indices= 0s, // Set later.
			.has_glass_quads= false, // Set later.
		} );

	foreach( &pair : zvox_data.clusters.iter().zip( clusters_draw_data.iter() ) )
	{
		var ZvoxCluster& cluster= pair.first;

		var bool is_regular_cluster=
			cluster.cluster_type == ZvoxCluster::c_cluster_type_regular |
			cluster.cluster_type == ZvoxCluster::c_cluster_type_notes;

		var size_type cluser_first_vertex_index= vertices.size();
		var size_type cluster_first_index= indices.size();

		// For each cluster create a mesh with vertex indices starting from 0.
		// Doing so allows performing culling (draw only visible clusters).
		// Also it allows to avoid reaching 65536 total vertices limit (we use 16-bit indices).

		for( auto mut q= size_type( cluster.c.first_quad_index );
			q < size_type( cluster.c.first_quad_index ) + size_type( cluster.num_quads );
			++q )
		{
			var ZmapQuad& quad= zmap_data.quads[q];

			var size_type base_vertex_index= vertices.size() - cluser_first_vertex_index;

			if(
				// Don't draw sky quads at all.
				u32( quad.texture_id ) ==
					MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Sky ) ] |
				// Draw glass in a special way later.
				u32( quad.texture_id ) ==
					MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ] |
				// Draw armored glass in a special way later.
				u32( quad.texture_id ) ==
					MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::ArmoredGlass ) ] |
				// Draw water in a special way later.
				u32( quad.texture_id ) ==
					MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Water ) ] |
				// Draw acid in a special way later.
				u32( quad.texture_id ) ==
					MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Acid ) ] |
				// Draw alternative acid in a special way later.
				u32( quad.texture_id ) ==
					MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Unknown1021 ) ] |
				// Draw lava in a special way later.
				u32( quad.texture_id ) ==
					MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Lava ) ] )
			{
				continue;
			}

			var f32 mut texture_id( quad.texture_id );

			// TODO - use speacial passes for special materials.

			if( size_type( quad.texture_id ) >=
				materials_block.textures.size() * size_type( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y ) )
			{
				// TODO - optimize this lookup, use a hash-map instead.
				for( auto mut j= 0s; j < typeinfo</MaterialsDescription::SpecialMaterial/>.element_count; ++j )
				{
					if( u32( quad.texture_id ) == MaterialsDescription::c_special_material_texture_indices[j] )
					{
						texture_id= f32( materials_block.special_material_indices[j] );
						break;
					}
				}
			}

			if( q >= zmap_lam_data.tessellated_quads.size() || zmap_lam_data.tessellated_quads[q].vertex_count == 0u )
			{
				// Fallback for cases where tessellated data isn't available - like for dynamic polygons (doors, elevators, buttons).

				auto [ u_vec, v_vec ]= CalculateMapQuadTextureBasis( quad, is_regular_cluster );

				var Vec2f tc_offset( f32( quad.tc_offset[0] ), f32( quad.tc_offset[1] ) );

				// OpenGL uses normalized texture coordinates.
				var f32 constexpr tc_scale= 1.0f / f32( MaterialsDescription::c_texture_size );

				foreach( &vertex_shift : quad.vertices )
				{
					// Texture coordinates are calculated relative to vertex #0.
					var Vec3f vertex_relative_shift
					(
						f32( i32( vertex_shift[0] ) - i32( quad.vertices[0][0] ) ),
						f32( i32( vertex_shift[1] ) - i32( quad.vertices[0][1] ) ),
						f32( i32( vertex_shift[2] ) - i32( quad.vertices[0][2] ) )
					);

					var [ f32, 3 ] vertex_position
					[
						f32( cluster.c.center[0] + i32( vertex_shift[0] ) ),
						f32( cluster.c.center[1] + i32( vertex_shift[1] ) ),
						f32( cluster.c.center[2] + i32( vertex_shift[2] ) ),
					];

					// Calculate per-vertex light as for dynamic objects.
					// It's static (doesn't change when an object is moving), but it's mostly fine.
					var SphericalHarmonicsRGB light=
						GetLightForPoint(
							light_sources,
							zvox_data.clusters,
							zmap_lem_data.clusters_sky_light_data,
							room_clusters_hierarchy,
							Vec3f( vertex_position[0], vertex_position[1], vertex_position[2] ),
							1.0f, // A vertex has very small radius.
							Mat4f::MakeIdentity() );

					vertices.push_back(
						MapVertex
						{
							.position= vertex_position,
							.padding12= zero_init,
							.tex_coordinates
							[
								tc_scale * ( vertex_relative_shift.Dot( u_vec ) + tc_offset.x ),
								tc_scale * ( vertex_relative_shift.Dot( v_vec ) + tc_offset.y ),
								texture_id,
							],
							.light
							[
								// Use only constant component of light.
								// TODO - maybe perform normal-based spherical harmonics fetch?
								( ust::max( 0.0f, ust::min( light[0].constant_component * 255.0f, 255.0f ) ) ),
								( ust::max( 0.0f, ust::min( light[1].constant_component * 255.0f, 255.0f ) ) ),
								( ust::max( 0.0f, ust::min( light[2].constant_component * 255.0f, 255.0f ) ) ),
							],
							.padding31= zero_init,
						} );
				}

				PushQuadIndices( indices, base_vertex_index );
			}
			else
			{
				CreateTessellatedQuadGeometry(
					zmap_lam_data, cluster, q, texture_id, base_vertex_index, vertices, indices );
			}
		}

		// Search for special materials for quads of this cluseter.
		var bool mut has_glass_quads= false;

		for( auto mut q= size_type( cluster.c.first_quad_index );
			q < size_type( cluster.c.first_quad_index ) + size_type( cluster.num_quads );
			++q )
		{
			var u32 texture_id( zmap_data.quads[q].texture_id );

			if( texture_id == MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ] |
				texture_id == MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::ArmoredGlass ) ]  )
			{
				has_glass_quads= true;
			}
		}

		var ClusterDrawData &mut cluster_draw_data= pair.second;

		cluster_draw_data.first_vertex_index= cluser_first_vertex_index;
		cluster_draw_data.first_index= cluster_first_index;
		cluster_draw_data.num_indices= indices.size() - cluster_first_index;

		cluster_draw_data.has_glass_quads= has_glass_quads;
	}

	if( settings_.lock_imut().deref().r_fullbright )
	{
		foreach( &mut v : vertices )
		{
			v.light[0]= 255u8;
			v.light[1]= 255u8;
			v.light[2]= 255u8;
		}
	}

	var BufferObject mut vertex_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			vertices.range().to_byte8_range() );

	var BufferObject mut index_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ELEMENT_ARRAY_BUFFER ), // Needed for a triangle indices source.
			indices.range().to_byte8_range() );

	var VertexArrayObject mut vertex_array_object;

	PrepareVertexArrayObjectWithMapVertexFormat( vertex_array_object, vertex_buffer );

	map_data_.reset(
		MapDrawData
		{
			.zmap_data= zmap_data_ptr,
			.zvox_data= zvox_data_ptr,
			.zpoz_data= zpoz_data_ptr,
			.zmap_lam_data= zmap_lam_data_ptr,
			.zmap_lem_data= zmap_lem_data_ptr,
			.room_clusters_hierarchy= room_clusters_hierarchy_ptr,
			.light_sources= move(light_sources),
			.vertex_array_object= move(vertex_array_object),
			.vertex_buffer= move(vertex_buffer),
			.index_buffer= move(index_buffer),
			// Do not bother using caching for map textures, since almost all maps (with a couple of exceptions) use their own texture files.
			.map_textures_array=
				LoadMapTextures(
					materials_block,
					game_filesystem_ptr_,
					console_out_,
					settings_.lock_imut().deref(),
					gl_capabilities_ ),
			.clouds_texture_layer= materials_block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::Sky ) ],
			.clusters_draw_data= move(clusters_draw_data),
			.sky_background_buffer= CreateSkyBackgroundBuffer( map_description ),
			.stars_buffer= CreateStarsBuffer( map_description, billboards_description_ ),
			.sky_clouds_params= CreateSkyCloudsParams( map_description ),
		} );
}

fn WorldDrawer::CreateGlassPolygons(
	MapDrawData& map_data,
	MaterialsDescription::Block& materials_block,
	ust::array_view_imut</bool/> visible_room_cluster_flags,
	ust::array_view_imut</WorldDrawingInfo::DynamicClusterObject/> dynamic_cluster_objects,
	ust::vector</MapVertex/> &mut vertices,
	ust::vector</u16/> &mut indices )
{
	var ust::array_view_imut</ZmapQuad/> quads= map_data.zmap_data.deref().quads;
	var ust::array_view_imut</ZvoxCluster/> clusters= map_data.zvox_data.deref().clusters;
	var ZmapLamData& zmap_lam_data= map_data.zmap_lam_data.deref();

	for( auto mut i= 0s; i < clusters.size(); )
	{
		var ZvoxCluster& room_cluster= clusters[i];
		if( room_cluster.c.num_children_clusters < 0 )
		{
			++i;
			continue;
		}

		// This room cluster and all his children.
		var size_type num_clusters_in_group= size_type( room_cluster.c.num_children_clusters ) + 1s;

		if( visible_room_cluster_flags[i] )
		{
			for( auto mut j= 0s; j < num_clusters_in_group; ++j )
			{
				var size_type cluster_index= i + j;

				var ZvoxCluster& cluster= clusters[ cluster_index ];

				if( !(
					cluster.cluster_type == ZvoxCluster::c_cluster_type_regular |
					cluster.cluster_type == ZvoxCluster::c_cluster_type_notes ) )
				{
					// Draw dynamic clusters later.
					continue;
				}

				if( map_data.clusters_draw_data[ cluster_index ].has_glass_quads )
				{
					CreateClusterGlassPolygons( cluster, quads, zmap_lam_data, materials_block, vertices, indices );
				}
			}
		}

		i+= num_clusters_in_group;
	}

	// Add glass polygons of dynamic cluster objects with translation.
	// This seems to be needed only for the end elevator on map 29.
	foreach( &dynamic_cluster_object : dynamic_cluster_objects )
	{
		var size_type num_vertices_before= vertices.size();

		CreateClusterGlassPolygons(
			clusters[ size_type( dynamic_cluster_object.cluster_index ) ],
			quads,
			zmap_lam_data,
			materials_block,
			vertices,
			indices );

		foreach( &mut v : vertices.range().subrange_start( num_vertices_before ) )
		{
			v.position[0]+= dynamic_cluster_object.translation.x;
			v.position[1]+= dynamic_cluster_object.translation.y;
			v.position[2]+= dynamic_cluster_object.translation.z;
		}
	}
}

fn WorldDrawer::DrawMapPolygons(
	MapDrawData& map_data,
	ust::array_view_imut</bool/> visible_room_cluster_flags,
	BBox3f& visible_clusters_bbox,
	ust::array_view_imut</WorldDrawingInfo::DynamicClusterObject/> dynamic_cluster_objects,
	ShaderProgram &mut shader,
	Mat4f& view_matrix,
	DrawingStats &mut drawing_stats )
{
	var ust::array_view_imut</ZvoxCluster/> clusters= map_data.zvox_data.deref().clusters.range();

	SetGLState( g_map_drawing_gl_state );

	var u32 texture_slot= 0u;

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	map_data.map_textures_array.Bind();

	shader.Bind();
	shader.SetUniform( "vu_matrix", view_matrix );
	shader.SetUniform( "fu_texture", texture_slot );

	map_data.vertex_array_object.Bind();
	map_data.index_buffer.Bind();

	for( auto mut i= 0s; i < clusters.size(); )
	{
		var ZvoxCluster& room_cluster= clusters[i];
		if( room_cluster.c.num_children_clusters < 0 )
		{
			++i;
			continue;
		}

		// This room cluster and all his children.
		var size_type num_clusters_in_group= size_type( room_cluster.c.num_children_clusters ) + 1s;

		if( visible_room_cluster_flags[i] )
		{
			for( auto mut j= 0s; j < num_clusters_in_group; ++j )
			{
				var size_type cluster_index= i + j;

				var u8 cluster_type= clusters[ cluster_index ].cluster_type;
				if( !(
					cluster_type == ZvoxCluster::c_cluster_type_regular |
					cluster_type == ZvoxCluster::c_cluster_type_notes ) )
				{
					// Draw dynamic clusters later.
					continue;
				}

				auto& cluster_draw_data= map_data.clusters_draw_data[ cluster_index ];

				unsafe( glDrawElementsBaseVertex(
					GLenum( GL_TRIANGLES ),
					GLsizei( cluster_draw_data.num_indices ),
					GLenum( GL_UNSIGNED_SHORT ),
					ust::nullptr</byte8/>() + typeinfo</u16/>.size_of * cluster_draw_data.first_index,
					GLint( cluster_draw_data.first_vertex_index ) ) );

				drawing_stats.num_visible_map_triangles+= u32( cluster_draw_data.num_indices ) / 3u;
			}

			++drawing_stats.num_room_visible_clusters;
			drawing_stats.num_total_visible_clusters+= u32( num_clusters_in_group );
		}

		i+= num_clusters_in_group;
	}

	var RoomClustersHierarchy& room_clusters_hierarchy= map_data.room_clusters_hierarchy.deref();

	// Draw dynamic clusters with individual matrices.
	foreach( &dynamic_cluster_object : dynamic_cluster_objects )
	{
		var size_type cluster_index( dynamic_cluster_object.cluster_index );

		var ZvoxCluster& cluster= clusters[ cluster_index ];

		var BBox3f mut bbox= CreateClusterBBox( cluster );
		bbox.min+= dynamic_cluster_object.translation;
		bbox.max+= dynamic_cluster_object.translation;

		// First perform fast check if this dynamic cluster is within the bbox containing all visible clusters.
		if( !visible_clusters_bbox.InstersectsOrTouches( bbox ) )
		{
			continue;
		}

		// Then check if this dynamic cluster is within at least one visible room cluster.
		if( !IsBBoxWithinVisibleClusters( clusters, room_clusters_hierarchy, visible_room_cluster_flags, bbox ) )
		{
			continue;
		}

		shader.SetUniform( "vu_matrix", Mat4f::MakeTranslation( dynamic_cluster_object.translation ) * view_matrix );

		auto& cluster_draw_data= map_data.clusters_draw_data[ cluster_index ];

		unsafe( glDrawElementsBaseVertex(
			GLenum( GL_TRIANGLES ),
			GLsizei( cluster_draw_data.num_indices ),
			GLenum( GL_UNSIGNED_SHORT ),
			ust::nullptr</byte8/>() + typeinfo</u16/>.size_of * cluster_draw_data.first_index,
			GLint( cluster_draw_data.first_vertex_index ) ) );

		drawing_stats.num_visible_map_triangles+= u32( cluster_draw_data.num_indices ) / 3u;
	}
}

fn WorldDrawer::DrawModels(
	ModelsMap& models_map,
	ust::array_view_imut</ModelToDraw/> models_to_draw,
	ShaderProgram &mut shader,
	DrawingStats &mut drawing_stats )
{
	var ResourceString mut prev_model_file_name= zero_init;

	SetGLState( g_models_drawing_gl_state );

	var u32 texture_slot= 0u;

	shader.Bind();
	shader.SetUniform( "fu_texture", texture_slot );

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );

	foreach( &model_to_draw : models_to_draw )
	{
		var ust::optional_ref_imut</ ust::optional</GPUModel/> /> model_opt_opt=
			models_map.find( model_to_draw.file_name );

		if( model_opt_opt.empty() )
		{
			continue;
		}

		var ust::optional</GPUModel/>& model_opt= model_opt_opt.try_deref();
		if( model_opt.empty() )
		{
			continue;
		}

		var GPUModel& model= model_opt.try_deref();

		if( model_to_draw.file_name != prev_model_file_name )
		{
			// Rebind textures/vertex arrays only if we have a model different from previously drawn one.

			prev_model_file_name= model_to_draw.file_name;

			model.textures.back().Bind();

			model.vertex_array_object.Bind();

			model.index_buffer.Bind();
		}

		if( model.num_frames > 1s )
		{
			// Change vertex attrib pointer for positions to draw requirest frame.
			// TODO - move this code into a separate function?
			model.positions_buffer.Bind();

			unsafe( glVertexAttribPointer(
				GPUModel::c_position_attrib,
				3,
				GLenum( GL_FLOAT ),
				GLboolean(0),
				GLsizei( typeinfo</ObbVertexPosition/>.size_of ),
				ust::nullptr</byte8/>() + size_type( model_to_draw.frame ) * model.num_vertices * typeinfo</ObbVertexPosition/>.size_of ) );
		}

		shader.SetUniform( "vu_matrix", model_to_draw.matrix );

		shader.SetUniform(
			"fu_light_spherical_harmonics_r",
			model_to_draw.light[0].directional_components.x,
			model_to_draw.light[0].directional_components.y,
			model_to_draw.light[0].directional_components.z,
			model_to_draw.light[0].constant_component );

		shader.SetUniform(
			"fu_light_spherical_harmonics_g",
			model_to_draw.light[1].directional_components.x,
			model_to_draw.light[1].directional_components.y,
			model_to_draw.light[1].directional_components.z,
			model_to_draw.light[1].constant_component );

		shader.SetUniform(
			"fu_light_spherical_harmonics_b",
			model_to_draw.light[2].directional_components.x,
			model_to_draw.light[2].directional_components.y,
			model_to_draw.light[2].directional_components.z,
			model_to_draw.light[2].constant_component );

		unsafe( glDrawElements(
			GLenum( GL_TRIANGLES ),
			GLsizei( model.num_triangles * 3s ),
			GLenum( GL_UNSIGNED_SHORT ),
			ust::nullptr</byte8/>() ) );

		++drawing_stats.num_visible_models;
		drawing_stats.num_visivle_model_triangles+= u32( model.num_triangles );
	}
}

fn WorldDrawer::DrawSemitransparentGeometry(
	DynamicPolygonsBuffer& dynamic_polygons_buffer,
	ShaderProgram &mut shader,
	Texture& map_textures_array,
	Mat4f& view_matrix )
{
	var size_type num_indices=
		ust::min( dynamic_polygons_buffer.indices.size(), dynamic_polygons_buffer.max_indices );

	dynamic_polygons_buffer.vertex_array_object.Bind();
	dynamic_polygons_buffer.index_buffer.Bind();

	SetGLState( g_semitransparent_geometry_drawing_gl_state );

	var u32 texture_slot= 0u;

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	map_textures_array.Bind();

	shader.Bind();
	shader.SetUniform( "vu_matrix", view_matrix );
	shader.SetUniform( "fu_texture", texture_slot );

	unsafe( glDrawElements(
		GLenum( GL_TRIANGLES ), GLsizei( num_indices ), GLenum( GL_UNSIGNED_SHORT ), ust::nullptr</byte8/>() ) );
}

fn WorldDrawer::UploadDynamicPolygonsBuffer( DynamicPolygonsBuffer &mut dynamic_polygons_buffer )
{
	var size_type num_vertices=
		ust::min( dynamic_polygons_buffer.vertices.size(), dynamic_polygons_buffer.max_vertices );
	var size_type num_indices=
		ust::min( dynamic_polygons_buffer.indices.size(), dynamic_polygons_buffer.max_indices );

	auto vertices_range= dynamic_polygons_buffer.vertices.range().subrange_end( num_vertices ).to_byte8_range();
	auto indices_range= dynamic_polygons_buffer.indices.range().subrange_end( num_indices ).to_byte8_range();

	dynamic_polygons_buffer.vertex_buffer.Bind();
	unsafe( glBufferSubData( GLenum( GL_ARRAY_BUFFER ), GLintptr(0), GLsizeiptr( vertices_range.size() ), vertices_range.data() ) );

	dynamic_polygons_buffer.index_buffer.Bind();
	unsafe( glBufferSubData( GLenum( GL_ELEMENT_ARRAY_BUFFER ), GLintptr(0), GLsizeiptr( indices_range.size() ), indices_range.data() ) );
}

fn WorldDrawer::ResetDynamicPolygonsBuffer( DynamicPolygonsBuffer &mut dynamic_polygons_buffer )
{
	dynamic_polygons_buffer.vertices.clear();
	dynamic_polygons_buffer.indices.clear();
}

fn LoadBillboardsDescription(
	GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out_ptr ) : BillboardsDescription
{
	auto mut lock= game_filesystem_ptr.lock_mut();
	result_match( lock.deref().LoadFileToString( c_billboards_description_file_name ) )
	{
		Ok( file_contents ) ->
		{
			return ParseBillboardsDescriptionFile( file_contents );
		},
		Err( e ) ->
		{
			ConsoleOutAddTextLine(
				console_out_ptr,
				ust::concat( "Failed to read billboards description file! Error: ", ust::enum_to_string(e), "!" ) );
			return BillboardsDescription();
		},
	}
}

fn LoadMapTextures(
	MaterialsDescription::Block& materials_block,
	GameFilesystemPtr& game_filesystem_ptr,
	ConsoleOutPtr& console_out,
	Settings& settings,
	GLCapabilities& gl_capabilities ) : Texture
{
	auto mut lock= game_filesystem_ptr.lock_mut();
	return LoadMapTextures( materials_block, lock.deref(), console_out, settings, gl_capabilities );
}

fn LoadMapTextures(
	MaterialsDescription::Block& materials_block,
	GameFilesystem &mut game_filesystem,
	ConsoleOutPtr& console_out,
	Settings& settings,
	GLCapabilities& gl_capabilities ) : Texture
{
	var Texture texture= Texture::Create( GLenum( GL_TEXTURE_2D_ARRAY ) );
	texture.Bind();

	var size_type num_extra_textures= 2s;
	var size_type num_subtile_layers= 8s;

	var size_type num_layers=
		num_subtile_layers +
		( materials_block.textures.size() + num_extra_textures ) *
		size_type( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y );

	unsafe( glTexImage3D(
		GLenum( GL_TEXTURE_2D_ARRAY ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( MaterialsDescription::c_texture_size ),
		GLsizei( MaterialsDescription::c_texture_size ),
		GLsizei( num_layers ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::nullptr</byte8/>() ) );

	var [ RGBAColor, MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_size ] mut texture_data= zero_init;

	var ust::optional</ImageData/> mut texture_31_image_data_opt;
	var ust::optional</ImageData/> mut texture_32_image_data_opt;

	for( var size_type mut t= 0s; t < materials_block.textures.size(); ++t )
	{
		result_match( game_filesystem.LoadFile( materials_block.textures[t].mips[1], LoadImageBMP ) )
		{
			Ok( mut image_data ) ->
			{
				if( !(  image_data.size[0] == MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_x &&
						image_data.size[1] == MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_y ) )
				{
					ConsoleOutAddTextLine( console_out, "Unexpected texture size!" );
					continue;
				}

				if( t >= 30s )
				{
					// Set alpha to zero for special textures.
					foreach( &mut pixel : image_data.pixels )
					{
						pixel[3]= 0u8;
					}
				}
				else
				{
					for( auto mut tile_y= 0u; tile_y < MaterialsDescription::c_texture_file_num_tiles_y; ++tile_y )
					{
						for( auto mut tile_x= 0u; tile_x < MaterialsDescription::c_texture_file_num_tiles_x; ++tile_x )
						{
							var u32 layer_index=
								u32(t) * ( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y ) +
								tile_x +
								tile_y * MaterialsDescription::c_texture_file_num_tiles_x;

							if( layer_index == materials_block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ] |
								layer_index == materials_block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::ArmoredGlass ) ] )
							{
								// Tweak alhpa for glass texture.
								var u8 c_glass_alpha= 0u8; // TODO - tune this constant.

								var u32 offset_y= ( MaterialsDescription::c_texture_file_num_tiles_y - 1u - tile_y ) * MaterialsDescription::c_texture_size;
								var u32 offset_x= tile_x * MaterialsDescription::c_texture_size;

								for( auto mut y= 0u; y < MaterialsDescription::c_texture_size; ++y )
								{
									auto line= image_data.pixels.range().subrange_start(
										size_type( offset_x + ( offset_y + MaterialsDescription::c_texture_size - 1u - y ) * image_data.size[0] ) );

									foreach( &mut pixel : line )
									{
										pixel[3]= c_glass_alpha;
									}
								}
							}
						}
					}
				}

				UploadMapTextureLayers( image_data, u32(t), texture_data );

				if( t == 31s )
				{
					texture_31_image_data_opt= move( image_data );
				}
				else if( t == 32s )
				{
					texture_32_image_data_opt= move( image_data );
				}
				else
				{
					move( image_data );
				}

			},
			Err(e) ->
			{
				ConsoleOutAddTextLine( console_out, ust::concat( "Failed to read texture file! Error: ", ust::enum_to_string(e), "!" ) );
			}
		}
	}

	if_var( &mut texture_31_image_data : texture_31_image_data_opt )
	{
		foreach( &mut pixel : texture_31_image_data.pixels )
		{
			if( pixel[0] <= 2u8 && pixel[1] <= 2u8 && pixel[2] <= 2u8 )
			{
				pixel[3]= 0u8;
			}
			else
			{
				pixel[3]= 255u8;
			}
		}

		// Upload alpha-texted version of texture 31.
		UploadMapTextureLayers( texture_31_image_data, u32( materials_block.textures.size() ), texture_data );

		foreach( &mut pixel : texture_31_image_data.pixels )
		{
			var u8 brightness= ust::max( cast_imut(pixel)[0], ust::max( cast_imut(pixel)[1], cast_imut(pixel)[2] ) );
			pixel[0]= 0u8;
			pixel[1]= 0u8;
			pixel[2]= 0u8;
			pixel[3]= brightness;
		}

		// Upload black version of texture 31.
		UploadMapTextureLayers( texture_31_image_data, u32( materials_block.textures.size() + 1s ), texture_data );
	}

	// Handle specially tiles in texture 32.
	// Upload each tile in lower and upper rows of the 4x4 grid into a separate texture layer.
	// It's necessary to avoid leaking due to liner texture filtering.
	if_var( &mut texture_32_image_data : texture_32_image_data_opt )
	{
		var u32 subtile_size= MaterialsDescription::c_texture_size / 2u;

		for( auto mut row= 0u; row < 2u; ++row )
		{
			var u32 subtile_y= row * 3u;
			for( auto mut subtile_x= 0u; subtile_x < 4u; ++subtile_x )
			{
				for( auto mut y= 0u; y < subtile_size; ++y )
				{
					for( auto mut x= 0u; x < subtile_size; ++x )
					{
						// TODO - speed-up this, copy whole lines.

						var u32 src_x= subtile_x * subtile_size + x;
						var u32 src_y=
							MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_x
							- 1u
							- ( subtile_y * subtile_size + y );

						var [ u8, 4 ] pixel=
							texture_32_image_data.pixels[ size_type(
								src_x +
								src_y * ( MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_x ) ) ];

						texture_data[ x + y * MaterialsDescription::c_texture_size ]= pixel;
						texture_data[ ( x + subtile_size ) + y * MaterialsDescription::c_texture_size ]= pixel;
						texture_data[ x + ( y + subtile_size ) * MaterialsDescription::c_texture_size ]= pixel;
						texture_data[ ( x + subtile_size ) + ( y + subtile_size ) * MaterialsDescription::c_texture_size ]= pixel;
					}
				}

				var u32 dst_layer=
					u32( materials_block.textures.size() + 2s ) *
						( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y ) +
					row * 4u +
					subtile_x;

				unsafe( glTexSubImage3D(
					GLenum( GL_TEXTURE_2D_ARRAY ),
					0,
					0,
					0,
					GLint( dst_layer ),
					GLsizei( MaterialsDescription::c_texture_size ),
					GLsizei( MaterialsDescription::c_texture_size ),
					1,
					GLenum( GL_RGBA ),
					GLenum( GL_UNSIGNED_BYTE ),
					ust::ptr_cast_to_byte8( $<( texture_data ) ) ) );
			}
		}
	}

	unsafe( glGenerateMipmap( GLenum( GL_TEXTURE_2D_ARRAY ) ) );

	if( settings.r_texture_nearest_filter )
	{
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_NEAREST ) ) );
		if( settings.r_texture_trilinear_filter )
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST_MIPMAP_LINEAR ) ) );
		}
		else
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST_MIPMAP_NEAREST ) ) );
		}
	}
	else
	{
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );
		if( settings.r_texture_trilinear_filter )
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR_MIPMAP_LINEAR ) ) );
		}
		else
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR_MIPMAP_NEAREST ) ) );
		}
	}

	if( settings.r_texture_anisotropy > 1u && gl_capabilities.texture_anisotropy_supported )
	{
		unsafe( glTexParameterf(
			GLenum( GL_TEXTURE_2D_ARRAY ),
			GLenum( GL_TEXTURE_MAX_ANISOTROPY_EXT ),
			f32( ust::min( settings.r_texture_anisotropy, 32u ) ) ) );
	}

	return texture;
}

// Destination texture should be bound first!
fn UploadMapTextureLayers(
	ImageData& image_data,
	u32 texture_index,
	[ RGBAColor, MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_size ] &mut temp_texture_data )
{
	for( auto mut tile_y= 0u; tile_y < MaterialsDescription::c_texture_file_num_tiles_y; ++tile_y )
	{
		var u32 src_offset_y= ( MaterialsDescription::c_texture_file_num_tiles_y - 1u - tile_y ) * MaterialsDescription::c_texture_size;

		for( auto mut tile_x= 0u; tile_x < MaterialsDescription::c_texture_file_num_tiles_x; ++tile_x )
		{
			var u32 src_offset_x= tile_x * MaterialsDescription::c_texture_size;

			for( auto mut y= 0u; y < MaterialsDescription::c_texture_size; ++y )
			{
				// Perform here vertical flipping while copying data into destination tile.

				auto src_line= image_data.pixels.range().subrange_start(
					size_type( src_offset_x + ( src_offset_y + MaterialsDescription::c_texture_size - 1u - y ) * image_data.size[0] ) );

				auto dst_line= ust::array_view_mut</RGBAColor/>( temp_texture_data ).subrange(
					size_type( MaterialsDescription::c_texture_size * y ),
					size_type( MaterialsDescription::c_texture_size * ( y + 1u ) ) );

				dst_line.copy_from( src_line );
			}

			var u32 dst_layer=
				texture_index * MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y  +
				tile_y * MaterialsDescription::c_texture_file_num_tiles_x +
				tile_x;

			unsafe( glTexSubImage3D(
				GLenum( GL_TEXTURE_2D_ARRAY ),
				0,
				0,
				0,
				GLint( dst_layer ),
				GLsizei( MaterialsDescription::c_texture_size ),
				GLsizei( MaterialsDescription::c_texture_size ),
				1,
				GLenum( GL_RGBA ),
				GLenum( GL_UNSIGNED_BYTE ),
				ust::ptr_cast_to_byte8( $<( temp_texture_data ) ) ) );
		}
	}
}

fn PrepareVertexArrayObjectWithMapVertexFormat(
	VertexArrayObject &mut vertex_array_object, BufferObject &mut vertex_buffer )
{
	vertex_array_object.Bind();

	// These attribute numbers should match values in vertex shader!
	var GLuint c_position_attrib= 0u;
	var GLuint c_texture_coordinates_attrib= 1u;
	var GLuint c_light_attrib= 2u;

	vertex_buffer.Bind();

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );

	unsafe( glVertexAttribPointer(
		c_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</MapVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</MapVertex, "position"/>() ) );

	unsafe( glEnableVertexAttribArray( c_texture_coordinates_attrib ) );

	unsafe( glVertexAttribPointer(
		c_texture_coordinates_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</MapVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</MapVertex, "tex_coordinates"/>() ) );

	unsafe( glEnableVertexAttribArray( c_light_attrib ) );

	unsafe( glVertexAttribPointer(
		c_light_attrib,
		3,
		GLenum( GL_UNSIGNED_BYTE ),
		GLboolean(1),
		GLsizei( typeinfo</MapVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</MapVertex, "light"/>() ) );
}

fn BuildBillboardPolygons(
	ust::array_view_imut</WorldDrawingInfo::Billboard/> billboards,
	ust::array_view_imut</BillboardDescription/> billboards_description,
	WorldDrawingInfo::CameraParams& camera_params,
	CameraClipPlanes& camera_clip_planes,
	BBox3f& visible_clusters_bbox,
	ust::vector</MapVertex/> &mut vertices,
	ust::vector</u16/> &mut indices,
	WorldDrawer::DrawingStats &mut drawing_stats )
{
	// This scale was tuned so that fixed-size billboards look properly.
	var f32 scale_for_constant_screen_size_billboards= ust::tan( camera_params.fov_x * 0.5f ) / 512.0f;

	foreach( &billboard : billboards ) label billboards_loop
	{
		var size_type billboard_index( billboard.billboard_index );
		if( billboard_index >= billboards_description.size() )
		{
			continue;
		}

		var BillboardDescription& billboard_description= billboards_description[ billboard_index ];

		var f32 mut radius=
			billboard.scale *
				ust::sqrt(
					f32(
						billboard_description.dx * billboard_description.dx +
						billboard_description.dy * billboard_description.dy ) );

		if( billboard.alignment == WorldDrawingInfo::Billboard::Alignment::ToCameraWithConstantScreenSize )
		{
			radius*=
				( billboard.position - camera_params.position ).Length() * scale_for_constant_screen_size_billboards;
		}

		// Perform clipping by camera planes (reject billboards outside view).
		foreach( &clip_plane : camera_clip_planes )
		{
			var f32 distance= clip_plane.GetDistanceForPoint( billboard.position );
			if( distance > radius )
			{
				continue label billboards_loop;
			}
		}

		var BBox3f billboard_bbox
		{
			.min= billboard.position - Vec3f( radius, radius, radius ),
			.max= billboard.position + Vec3f( radius, radius, radius ),
		};

		// Perform check with visible clusters bbox in order to reject billboards located in another rooms.
		// Such rough check is mostly fine.
		// Performing more compicated check against all visible room clusters is too expensice for billboards.
		if( !visible_clusters_bbox.Instersects( billboard_bbox ) )
		{
			continue;
		}

		var u32 constexpr num_tiles_in_texture=
			MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y;

		var f32 mut texture_layer= 0.0f;
		var u32 mut extra_tc_scale_log2= 0u;

		if( billboard_description.tek >= BillboardConstants::c_texture2_first_tile &&
			billboard_description.tek <= BillboardConstants::c_texture2_last_tile )
		{
			var u32 base_texture_index= 37u * num_tiles_in_texture;
			if( billboard_description.tek < BillboardConstants::c_texture2_first_tile + 4u )
			{
				// Upper 4 subtiles.
				texture_layer= f32( base_texture_index + billboard_description.tek - BillboardConstants::c_texture2_first_tile );
			}
			else if( billboard_description.tek >= BillboardConstants::c_texture2_first_tile + 12u )
			{
				// Lower 4 subtiles.
				texture_layer= f32( base_texture_index + 4u + billboard_description.tek - BillboardConstants::c_texture2_first_tile - 12u );
			}

			extra_tc_scale_log2= 2u;
		}
		else
		{
			var u32 mut base_texture_index= 0u;
			switch( billboard_description.tek )
			{
				BillboardConstants::c_texture0 -> { base_texture_index= 30u; },
				BillboardConstants::c_texture1 -> { base_texture_index= 31u; },
				// Alpha-tested version of ZBRA001*.BMP - textures.
				BillboardConstants::c_texture1_alpha_test -> { base_texture_index= 35u; },
				// Black version of ZBRA001*.BMP - textures.
				BillboardConstants::c_texture1_black -> { base_texture_index= 36u; },
				BillboardConstants::c_texture4 -> { base_texture_index= 34u; },
				default -> {},
			}

			texture_layer=
				f32(
					base_texture_index * num_tiles_in_texture +
					billboard_description.xp / MaterialsDescription::c_texture_size +
					billboard_description.yp / MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_x );
		}

		var size_type base_vertex= vertices.size();

		auto [ mut u_vec, mut v_vec ]=
			GetBillboardAxes( billboard, camera_params.position, scale_for_constant_screen_size_billboards );

		u_vec*= f32( billboard_description.dx );
		v_vec*= f32( billboard_description.dy );

		var [ Vec3f, 4 ] positions
		[
			billboard.position - u_vec - v_vec,
			billboard.position + u_vec - v_vec,
			billboard.position - u_vec + v_vec,
			billboard.position + u_vec + v_vec,
		];

		var [ u32, 2 ] tc_base
		[
			billboard_description.xp % MaterialsDescription::c_texture_size,
			billboard_description.yp % MaterialsDescription::c_texture_size
		];

		var [ [ f32, 2 ], 2 ] tex_coords
		[
			[
				f32( tc_base[0] ) / f32( MaterialsDescription::c_texture_size ),
				f32( tc_base[1] ) / f32( MaterialsDescription::c_texture_size ),
			],
			[
				f32( tc_base[0] + ( ( billboard_description.xk - billboard_description.xp ) >> extra_tc_scale_log2 ) ) / f32( MaterialsDescription::c_texture_size ),
				f32( tc_base[1] + ( ( billboard_description.yk - billboard_description.yp ) >> extra_tc_scale_log2 ) ) / f32( MaterialsDescription::c_texture_size ),
			],
		];

		// Billboards are always fullbright
		var [ u8, 3 ] light[ 255u8, 255u8, 255u8 ];

		vertices.push_back(
			MapVertex
			{
				.position[ positions[0].x, positions[0].y, positions[0].z ],
				.padding12= zero_init,
				.tex_coordinates[ tex_coords[0][0], tex_coords[0][1], texture_layer ],
				.light= light,
				.padding31= zero_init,
			} );

		vertices.push_back(
			MapVertex
			{
				.position[ positions[1].x, positions[1].y, positions[1].z ],
				.padding12= zero_init,
				.tex_coordinates[ tex_coords[1][0], tex_coords[0][1], texture_layer ],
				.light= light,
				.padding31= zero_init,
			} );

		vertices.push_back(
			MapVertex
			{
				.position[ positions[2].x, positions[2].y, positions[2].z ],
				.padding12= zero_init,
				.tex_coordinates[ tex_coords[0][0], tex_coords[1][1], texture_layer ],
				.light= light,
				.padding31= zero_init,
			} );

		vertices.push_back(
			MapVertex
			{
				.position[ positions[3].x, positions[3].y, positions[3].z ],
				.padding12= zero_init,
				.tex_coordinates[ tex_coords[1][0], tex_coords[1][1], texture_layer ],
				.light= light,
				.padding31= zero_init,
			} );

		indices.push_back( u16( base_vertex + 2s ) );
		indices.push_back( u16( base_vertex + 1s ) );
		indices.push_back( u16( base_vertex + 0s ) );
		indices.push_back( u16( base_vertex + 1s ) );
		indices.push_back( u16( base_vertex + 2s ) );
		indices.push_back( u16( base_vertex + 3s ) );

		++drawing_stats.num_visible_billboards;
	}
}

fn GetBillboardAxes(
	WorldDrawingInfo::Billboard& billboard,
	Vec3f& camera_position,
	f32 scale_for_constant_screen_size_billboards ) : [ Vec3f, 2 ]
{
	var Vec3f vec_to_camera= billboard.position - camera_position;

	type Alignment= WorldDrawingInfo::Billboard::Alignment;

	switch( billboard.alignment )
	{
		Alignment::ZAxis ->
		{
			var Vec3f mut v_vec( 0.0f, 0.0f, 1.0f );
			var Vec3f mut u_vec= vec_to_camera.Cross( v_vec );

			var f32 u_vec_length= u_vec.Length();
			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			return ust::make_array( billboard.scale * u_vec, billboard.scale * v_vec );
		},
		Alignment::ToCamera ->
		{
			var Vec3f mut u_vec= vec_to_camera.Cross( Vec3f( 0.0f, 0.0f, 1.0f ) );
			var f32 u_vec_length= u_vec.Length();

			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			var Vec3f mut v_vec= u_vec.Cross( vec_to_camera );
			var f32 v_vec_length= v_vec.Length();

			if( v_vec_length == 0.0f )
			{
				v_vec= Vec3f( 1.0f, 0.0f, 0.0f );
			}
			else
			{
				v_vec /= v_vec_length;
			}

			return ust::make_array( billboard.scale * u_vec, billboard.scale * v_vec );
		},
		Alignment::ToCameraWithConstantScreenSize ->
		{
			var Vec3f mut u_vec= vec_to_camera.Cross( Vec3f( 0.0f, 0.0f, 1.0f ) );
			var f32 u_vec_length= u_vec.Length();

			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			var Vec3f mut v_vec= u_vec.Cross( vec_to_camera );
			var f32 v_vec_length= v_vec.Length();

			if( v_vec_length == 0.0f )
			{
				v_vec= Vec3f( 1.0f, 0.0f, 0.0f );
			}
			else
			{
				v_vec /= v_vec_length;
			}

			var f32 scale= billboard.scale * vec_to_camera.Length() * scale_for_constant_screen_size_billboards;

			return ust::make_array( u_vec * scale, v_vec * scale );
		},
		Alignment::ToCustomAxis ->
		{
			var Vec3f mut v_vec= billboard.custom_axis;
			var f32 v_vec_length= v_vec.Length();

			if( v_vec_length == 0.0f )
			{
				v_vec= Vec3f( 1.0f, 0.0f, 0.0f );
			}
			else
			{
				v_vec /= v_vec_length;
			}

			var Vec3f mut u_vec= vec_to_camera.Cross( v_vec );
			var f32 u_vec_length= u_vec.Length();

			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			return ust::make_array( billboard.scale * u_vec, billboard.scale * v_vec );
		},
	}
}

fn CreateClusterGlassPolygons(
	ZvoxCluster& cluster,
	ust::array_view_imut</ZmapQuad/> quads,
	ZmapLamData& zmap_lam_data,
	MaterialsDescription::Block& materials_block,
	ust::vector</MapVertex/> &mut vertices,
	ust::vector</u16/> &mut indices )
{
	var bool is_regular_cluster=
		cluster.cluster_type == ZvoxCluster::c_cluster_type_regular |
		cluster.cluster_type == ZvoxCluster::c_cluster_type_notes;

	for( auto mut q= size_type( cluster.c.first_quad_index );
		q < size_type( cluster.c.first_quad_index ) + size_type( cluster.num_quads );
		++q )
	{
		var ZmapQuad& quad= quads[q];

		var f32 mut texture_id= 0.0f;

		switch( u32( quad.texture_id ) )
		{
			MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ] ->
			{
				texture_id= f32( materials_block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ] );
			},
			MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::ArmoredGlass ) ] ->
			{
				texture_id= f32( materials_block.special_material_indices[ size_type( MaterialsDescription::SpecialMaterial::ArmoredGlass ) ] );
			},
			default -> { continue; }
		}

		var size_type base_vertex_index= vertices.size();

		if( q >= zmap_lam_data.tessellated_quads.size() || zmap_lam_data.tessellated_quads[q].vertex_count == 0u )
		{
			// Fallback for cases where tessellated data isn't available - like for dynamic polygons (doors, elevators, buttons).

			auto [ u_vec, v_vec ]= CalculateMapQuadTextureBasis( quad, is_regular_cluster );

			var Vec2f tc_offset( f32( quad.tc_offset[0] ), f32( quad.tc_offset[1] ) );

			// OpenGL uses normalized texture coordinates.
			var f32 constexpr tc_scale= 1.0f / f32( MaterialsDescription::c_texture_size );

			foreach( &vertex_shift : quad.vertices )
			{
				// Texture coordinates are calculated relative to vertex #0.
				var Vec3f vertex_relative_shift
				(
					f32( i32( vertex_shift[0] ) - i32( quad.vertices[0][0] ) ),
					f32( i32( vertex_shift[1] ) - i32( quad.vertices[0][1] ) ),
					f32( i32( vertex_shift[2] ) - i32( quad.vertices[0][2] ) )
				);

				vertices.push_back(
					MapVertex
					{
						.position
						[
							f32( cluster.c.center[0] + i32( vertex_shift[0] ) ),
							f32( cluster.c.center[1] + i32( vertex_shift[1] ) ),
							f32( cluster.c.center[2] + i32( vertex_shift[2] ) ),
						],
						.padding12= zero_init,
						.tex_coordinates
						[
							tc_scale * ( vertex_relative_shift.Dot( u_vec ) + tc_offset.x ),
							tc_scale * ( vertex_relative_shift.Dot( v_vec ) + tc_offset.y ),
							texture_id,
						],
						// Stub light for dynamic glass polygons.
						// It's fine to use it, since there are only a couple of such polygons in the whole game.
						.light[ 48u8, 48u8, 48u8 ],
						.padding31= zero_init,
					} );
			}

			PushQuadIndices( indices, base_vertex_index );
		}
		else
		{
			CreateTessellatedQuadGeometry(
				zmap_lam_data, cluster, q, texture_id, base_vertex_index, vertices, indices );
		}
	}
}

fn CalculateMapQuadTextureBasis( ZmapQuad& quad, bool is_regular_cluster ) : [ Vec3f, 2 ]
{
	var Vec3f mut u_vec( 0.0f, 1.0f, 0.0f );
	var Vec3f mut v_vec( 1.0f, 0.0f, 0.0f );

	// Avoid applying texture roll for quads of dynamic clusters.
	// This fixes incorrect texture coordinates for the floor hatch on map 11.
	// No other dynamic cluster in the whole game has non-zero texture roll.
	if( is_regular_cluster )
	{
		var f32 angle= f32( i32( quad.packed_texture_roll_scale ) & ~15 ) * ( -c_tau / 256.0f );
		var f32 c= ust::cos(angle);
		var f32 s= ust::sin(angle);

		u_vec= Vec3f( u_vec.x * c - u_vec.y * s, u_vec.x * s + u_vec.y * c, u_vec.z );
		v_vec= Vec3f( v_vec.x * c - v_vec.y * s, v_vec.x * s + v_vec.y * c, v_vec.z );
	}
	{
		var f32 angle= ( f32( quad.normal_elevation ) + 256.0f ) * ( c_tau / 1024.0f );
		var f32 c= ust::cos(angle);
		var f32 s= ust::sin(angle);

		u_vec= Vec3f( u_vec.x * c - u_vec.z * s, u_vec.y, u_vec.x * s + u_vec.z * c );
		v_vec= Vec3f( v_vec.x * c - v_vec.z * s, v_vec.y, v_vec.x * s + v_vec.z * c );
	}
	{
		var f32 angle= ( 768.0f - f32(quad.normal_azimuth) ) * ( c_tau / 1024.0f );
		var f32 c= ust::cos(angle);
		var f32 s= ust::sin(angle);

		u_vec= Vec3f( u_vec.x * c - u_vec.y * s, u_vec.x * s + u_vec.y * c, u_vec.z );
		v_vec= Vec3f( v_vec.x * c - v_vec.y * s, v_vec.x * s + v_vec.y * c, v_vec.z );
	}
	{
		var i32 scale_bits= i32( quad.packed_texture_roll_scale ) & 15;
		if( scale_bits != 0 )
		{
			var f32 vecs_scale=
				( scale_bits >= 8
					? f32( scale_bits - 3 ) * 0.25f
					: 1.0f - f32( scale_bits ) * 0.125f );
			u_vec*= vecs_scale;
			v_vec*= vecs_scale;
		}
	}

	return ust::make_array( u_vec, v_vec );
}

fn CreateTessellatedQuadGeometry(
	ZmapLamData& zmap_lam_data,
	ZvoxCluster& cluster,
	size_type quad_index,
	f32 texture_id,
	size_type base_vertex_index,
	ust::vector</MapVertex/> &mut vertices,
	ust::vector</u16/> &mut indices )
{
	var ZmapLamTesselaltedQuad& tessellated_quad= zmap_lam_data.tessellated_quads[ quad_index ];

	var size_type tessellated_vertex_count( tessellated_quad.vertex_count );

	var size_type tessellatted_quad_data_offset( tessellated_quad.data_offset );

	var ust::array_view_imut</byte32/> vertex_data=
		zmap_lam_data.tessellated_quads_data.range().subrange(
			tessellatted_quad_data_offset,
			tessellatted_quad_data_offset + tessellated_vertex_count * 6s );

	for( var size_type mut i= 0s, i_end= tessellated_vertex_count * 6s; i < i_end; i+= 6s )
	{
		var u32 c( vertex_data[ i + 5s ] );

		vertices.push_back(
			MapVertex
			{
				.position
				[
					f32( cluster.c.center[0] ) + f32( vertex_data[ i + 0s ] ),
					f32( cluster.c.center[1] ) + f32( vertex_data[ i + 1s ] ),
					f32( cluster.c.center[2] ) + f32( vertex_data[ i + 2s ] ),
				],
				.padding12= zero_init,
				.tex_coordinates
				[
					( vertex_data[ i + 3s ] ),
					( vertex_data[ i + 4s ] ),
					texture_id
				],
				.light[ ( c >> 16 ), ( c >> 8 ), ( c) ],
				.padding31= zero_init,
			} );
	}

	var size_type polygons_data_offset= tessellatted_quad_data_offset + tessellated_vertex_count * 6s;

	var size_type polygon_count( u32( cast_imut(zmap_lam_data).tessellated_quads_data[ polygons_data_offset ] ) );

	var ust::array_view_imut</byte32/> polygons_data=
		cast_imut(zmap_lam_data).tessellated_quads_data .range().subrange(
			polygons_data_offset + 2s,
			polygons_data_offset + 2s + polygon_count * 8s );

	for( auto mut i= 0s; i < polygon_count; ++i )
	{
		var ust::array_view_imut</byte32/> polygon_data= polygons_data.subrange( i * 8s, i * 8s + 8s );

		var size_type polygon_vertex_count( u32( polygon_data[0s] ) );

		var size_type polygon_triangle_count= polygon_vertex_count - 2s;

		for( auto mut j= 0s; j < polygon_triangle_count; ++j )
		{
			indices.push_back( u16( base_vertex_index + size_type( u32( polygon_data[ 2s + 0s ] ) ) ) );
			indices.push_back( u16( base_vertex_index + size_type( u32( polygon_data[ 2s + j + 1s ] ) ) ) );
			indices.push_back( u16( base_vertex_index + size_type( u32( polygon_data[ 2s + j + 2s ] ) ) ) );
		}
	}
}

fn PushQuadIndices( ust::vector</u16/> &mut indices, size_type base_vertex_index )
{
	indices.push_back( u16( base_vertex_index + 0s ) );
	indices.push_back( u16( base_vertex_index + 1s ) );
	indices.push_back( u16( base_vertex_index + 2s ) );
	indices.push_back( u16( base_vertex_index + 0s ) );
	indices.push_back( u16( base_vertex_index + 2s ) );
	indices.push_back( u16( base_vertex_index + 3s ) );
}

fn DrawSkyBackground(
	SkyBackgroundBuffer& sky_background_buffer, ShaderProgram &mut shader, Mat4f& rotation_and_projection_matrix )
{
	SetGLState( g_sky_background_gl_state );

	var Mat4f sky_background_matrix=
		Mat4f::MakeRotationX( c_tau * 0.25f ) *
		Mat4f::MakeRotationZ( -c_tau * 0.125f ) * // TODO - check this angle is correct.
		Mat4f::MakeScale( c_sky_scale ) *
		rotation_and_projection_matrix;

	shader.Bind();
	shader.SetUniform( "vu_matrix", sky_background_matrix );

	sky_background_buffer.vertex_array_object.Bind();
	sky_background_buffer.index_buffer.Bind();

	unsafe( glDrawElements(
		GLenum( GL_TRIANGLES ),
		GLint( sky_background_buffer.num_triangle_indices ),
		GLenum( GL_UNSIGNED_SHORT ),
		ust::nullptr</byte8/>() ) );
}

fn DrawClouds(
	SkyCloudsParams& clouds_params,
	ShaderProgram &mut shader,
	Texture& map_textures_array,
	u32 clouds_texture_layer,
	Mat4f& rotation_and_projection_matrix,
	f32 time_s )
{
	SetGLState(
		( clouds_params.scale_colors_by_two
			? g_clouds_double_blending_gl_state
			: g_clouds_single_blending_gl_state ) );

	var u32 texture_slot= 0u;
	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	map_textures_array.Bind();

	shader.Bind();
	shader.SetUniform( "vu_matrix", Mat4f::MakeScale( c_clouds_scale ) * rotation_and_projection_matrix );
	shader.SetUniform( "fu_texture", texture_slot );
	shader.SetUniform( "fu_texture_layer", f32( clouds_texture_layer ) );
	shader.SetUniform( "fu_texture_scale", clouds_params.scale );
	shader.SetUniform( "fu_texture_shift",  time_s * clouds_params.scroll_speed * Vec2f( 1.0f, 1.0f ) );

	unsafe( glDrawArrays( GLenum( GL_TRIANGLES ), GLint(0), GLsizei(12) ) );
}

fn DrawStarsAndSun(
	StarsBuffer& stars_buffer,
	ShaderProgram &mut shader,
	Texture& map_textures_array,
	Mat4f& rotation_and_projection_matrix )
{
	SetGLState( g_stars_gl_state );

	var u32 texture_slot= 0u;
	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	map_textures_array.Bind();

	shader.Bind();
	shader.SetUniform( "vu_matrix", Mat4f::MakeScale( c_stars_scale ) * rotation_and_projection_matrix );
	shader.SetUniform( "fu_texture", texture_slot );

	stars_buffer.vertex_array_object.Bind();
	stars_buffer.index_buffer.Bind();

	unsafe( glDrawElements(
		GLenum( GL_TRIANGLES ),
		GLint( stars_buffer.num_triangle_indices ),
		GLenum( GL_UNSIGNED_SHORT ),
		ust::nullptr</byte8/>() ) );
}

fn DrawTestPrimitives(
	ust::array_view_imut</Vec3f/> test_sprites,
	ust::array_view_imut</WorldDrawingInfo::TestTriangle/> test_triangles,
	ust::array_view_imut</WorldDrawingInfo::TestLine/> test_lines,
	VertexArrayObject& test_primitive_vertex_array_object,
	BufferObject &mut test_primitive_vertex_buffer_object,
	ShaderProgram &mut shader,
	Mat4f& view_matrix )
{
	SetGLState( g_test_primitives_drawing_gl_state );

	// Draw test sprites.
	if( !test_sprites.empty() )
	{
		unsafe( glPointSize( 8.0f ) );

		test_primitive_vertex_array_object.Bind();
		test_primitive_vertex_buffer_object.Bind();

		scoped_array TestPrimitiveVertex vertices[ test_sprites.size() ](
			test_sprites.iter().map(
				lambda( Vec3f& p ) : TestPrimitiveVertex
				{
					return TestPrimitiveVertex
					{
						.position[ p.x, p.y, p.z ],
						.color[ 0u8, 255u8, 0u8 ],
						.padding15= zero_init,
					};
				} ) );

		auto range= vertices.to_byte8_range();

		unsafe( glBufferSubData( GLenum( GL_ARRAY_BUFFER ), GLintptr(0), GLsizeiptr( range.size() ), range.data() ) );

		shader.Bind();
		shader.SetUniform( "vu_matrix", view_matrix );

		unsafe( glDrawArrays( GLenum( GL_POINTS ), GLint(0), GLint( vertices.size() ) ) );

		unsafe( glPointSize( 1.0f ) );
	}

	// Draw test triangles.
	if( !test_triangles.empty() )
	{
		test_primitive_vertex_array_object.Bind();
		test_primitive_vertex_buffer_object.Bind();

		scoped_array TestPrimitiveVertex mut vertices[ test_triangles.size() * 3s ]( ust::make_zeroed</TestPrimitiveVertex/>() );

		for( auto mut i= 0s; i < test_triangles.size(); ++i )
		{
			var WorldDrawingInfo::TestTriangle& triangle= test_triangles[i];

			for( auto mut j= 0s; j < 3s; ++j )
			{
				var TestPrimitiveVertex &mut v= vertices[ i * 3s + j ];
				var Vec3f& pos= triangle.vertices[j];
				v.position[0]= pos.x;
				v.position[1]= pos.y;
				v.position[2]= pos.z;
				v.color= triangle.color;
			}
		}

		var ust::array_view_imut</TestPrimitiveVertex/> vertices_imut= vertices.subrange_end( c_max_test_primitive_vertices );

		auto range= vertices_imut.to_byte8_range();
		unsafe( glBufferSubData( GLenum( GL_ARRAY_BUFFER ), GLintptr(0), GLsizeiptr( range.size() ), range.data() ) );

		shader.Bind();
		shader.SetUniform( "vu_matrix", view_matrix );

		unsafe( glDrawArrays( GLenum( GL_TRIANGLES ), GLint(0), GLint( vertices_imut.size() ) ) );
	}

	// Draw test lines.
	if( !test_lines.empty() )
	{
		test_primitive_vertex_array_object.Bind();
		test_primitive_vertex_buffer_object.Bind();

		scoped_array TestPrimitiveVertex mut vertices[ test_lines.size() * 2s ]( ust::make_zeroed</TestPrimitiveVertex/>() );

		for( auto mut i= 0s; i < test_lines.size(); ++i )
		{
			var WorldDrawingInfo::TestLine& line= test_lines[i];

			for( auto mut j= 0s; j < 2s; ++j )
			{
				var TestPrimitiveVertex &mut v= vertices[ i * 2s + j ];
				var Vec3f& pos= line.vertices[j];
				v.position[0]= pos.x;
				v.position[1]= pos.y;
				v.position[2]= pos.z;
				v.color= line.color;
			}
		}

		var ust::array_view_imut</TestPrimitiveVertex/> vertices_imut= vertices.subrange_end( c_max_test_primitive_vertices );

		auto range= vertices_imut.to_byte8_range();
		unsafe( glBufferSubData( GLenum( GL_ARRAY_BUFFER ), GLintptr(0), GLsizeiptr( range.size() ), range.data() ) );

		shader.Bind();
		shader.SetUniform( "vu_matrix", view_matrix );

		unsafe( glDrawArrays( GLenum( GL_LINES ), GLint(0), GLint( vertices_imut.size() ) ) );
	}
}

fn LoadModelsIfNecessary(
	ust::array_view_imut</WorldDrawingInfo::ModelObject/> model_objects,
	GameFilesystemPtr& game_filesystem_ptr,
	ConsoleOutPtr& console_out_ptr,
	SettingsPtr& settings_ptr,
	GLCapabilities& gl_capabilities,
	ust::hash_map</ ResourceString, ust::optional</GPUModel/> /> &mut models )
{
	foreach( &model_object : model_objects )
	{
		// Load it if it's not loaded yet.

		var ResourceString& file_name= model_object.model_file_name;

		models.find_or_construct_new(
			file_name,
			lambda[&] () : ust::optional</GPUModel/>
			{
				auto mut lock= game_filesystem_ptr.lock_mut();
				result_match(
					lock.deref().LoadFile(
						file_name,
						( fn( ust::file_readable &mut f ) : ust::io_result</ModelData/> )( LoadModel ) ) )
				{
					Ok(m) -> { return CreateGPUModel( m, settings_ptr.lock_imut().deref(), gl_capabilities ); },
					Err(e) ->
					{
						ConsoleOutAddTextLine(
							console_out_ptr,
							ust::concat(
								"Failed to load model file \"",
								ConvertResourceStringToStringView( file_name ),
								"\"! Error: ",
								ust::enum_to_string( e ) ) );
						return ust::null_optional;
					},
				}
			} );
	}
}

fn MarkVisibleRoomClusters(
	RoomClustersHierarchy& room_clusters_hierarchy,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ZpozData& zpoz_data,
	Vec3f& camera_position,
	ust::array_view_mut</bool/> visible_room_cluster_flags )
{
	if_var( camera_cluster_index : GetCameraRoomCluster( room_clusters_hierarchy, clusters, camera_position ) )
	{
		// Mark as visible current cluster.
		visible_room_cluster_flags[ camera_cluster_index ]= true;

		var i32 bias= i32( clusters.size() ) * 4;

		var ZpozClusterVisibilityData& visibility_data= zpoz_data.clusters_visibility_data[ camera_cluster_index ];

		// TODO - check if we should use data[2] and not data[0] or even both.
		var i32 data_start= visibility_data.data[2];

		if( data_start != -1 )
		{
			var size_type visibility_data_offset( data_start - bias );

			// We have 2 subranges for both offsets.
			// Since we don't know which is correct, use both of them.
			var size_type subrange0_size( zpoz_data.cluster_indices[ visibility_data_offset  ] );
			var size_type subrange0_start= visibility_data_offset + 8s;
			var size_type subrange1_size( zpoz_data.cluster_indices[ subrange0_start + subrange0_size ] );
			var size_type subrange1_start= subrange0_start + size_type(subrange0_size) + 8s;

			var [ ust::array_view_imut</i32/>, 2 ] ranges
			[
				zpoz_data.cluster_indices.range().subrange( subrange0_start, subrange0_start + subrange0_size ),
				zpoz_data.cluster_indices.range().subrange( subrange1_start, subrange1_start + subrange1_size )
			];

			foreach( range : ranges )
			{
				foreach( visible_cluster_index : range )
				{
					// Mark cluster listed in visibility data as visible.
					visible_room_cluster_flags[ size_type( visible_cluster_index ) ]= true;
				}
			}
		}
	}
	else
	{
		// Assume all room clusters are visible if we failed to find current cluster (like in noclip mode).
		for( auto mut i= 0s; i < clusters.size(); ++i )
		{
			if( clusters[i].c.num_children_clusters >= 0 )
			{
				visible_room_cluster_flags[i]= true;
			}
		}
	}
}

fn GetCameraRoomCluster(
	RoomClustersHierarchy& room_clusters_hierarchy,
	ust::array_view_imut</ZvoxCluster/> clusters,
	Vec3f& camera_position ) : ust::optional</size_type/>
{
	var ust::optional</size_type/> mut camera_cluster_index_opt;

	VisitBoundingBoxesHierarchyForPoint(
		room_clusters_hierarchy,
		camera_position,
		lambda[&]( ClusterIndexInHierarchy c )
		{
			var size_type cluster_index(c);
			if( CreateClusterBBox( clusters[ cluster_index ] ).PointIsInsideOrOnFace( camera_position ) )
			{
				camera_cluster_index_opt= cluster_index;
			}
		} );

	return camera_cluster_index_opt;
}

fn RejectVisibleRoomClustersUsingCameraPlanes(
	ust::array_view_imut</ZvoxCluster/> clusters,
	CameraClipPlanes& camera_clip_planes,
	ust::array_view_mut</bool/> visible_room_cluster_flags )
{
	for( auto mut i= 0s; i < clusters.size(); ++i )
	{
		if( !visible_room_cluster_flags[i] )
		{
			continue;
		}

		var ZvoxCluster& cluster= clusters[i];

		if( AreBoxVerticesClippedByAtLeastOneCameraClipPlane(
				camera_clip_planes,
				CreateClusterBBox(cluster).CreateCornerVertices() ) )
		{
			visible_room_cluster_flags[i]= false;
			continue;
		}
	}
}

fn CalculateVisibleClustersBBox(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</bool/> visible_room_cluster_flags,
	Vec3f& camera_position ) : BBox3f
{
	var BBox3f mut visible_clusters_bbox
	{
		.min= camera_position,
		.max= camera_position,
	};

	for( auto mut i= 0s; i < clusters.size(); ++i )
	{
		if( !visible_room_cluster_flags[i] )
		{
			continue;
		}

		var ZvoxCluster& cluster= clusters[i];

		var BBox3f cluster_bbox= CreateClusterBBox( cluster );

		ust::min_assign( visible_clusters_bbox.min.x, cluster_bbox.min.x );
		ust::min_assign( visible_clusters_bbox.min.y, cluster_bbox.min.y );
		ust::min_assign( visible_clusters_bbox.min.z, cluster_bbox.min.z );
		ust::max_assign( visible_clusters_bbox.max.x, cluster_bbox.max.x );
		ust::max_assign( visible_clusters_bbox.max.y, cluster_bbox.max.y );
		ust::max_assign( visible_clusters_bbox.max.z, cluster_bbox.max.z );
	}

	return visible_clusters_bbox;
}

fn IsBBoxWithinVisibleClusters(
	ust::array_view_imut</ZvoxCluster/> clusters,
	RoomClustersHierarchy& room_clusters_hierarchy,
	ust::array_view_imut</bool/> visible_room_cluster_flags,
	BBox3f& bbox ) : bool
{
	var bool mut is_within_visible_clusters= false;

	VisitBoundingBoxesHierarchyForBBox(
		room_clusters_hierarchy,
		bbox,
		lambda[&]( ClusterIndexInHierarchy c )
		{
			var size_type cluster_index(c);
			if( visible_room_cluster_flags[ cluster_index ] &&
				CreateClusterBBox( clusters[ cluster_index ] ).InstersectsOrTouches( bbox ) )
			{
				is_within_visible_clusters= true;
			}
		} );

	return is_within_visible_clusters;
}

type CameraClipPlanes= [ Planef, 5 ];

fn CreateCameraClipPlanes( WorldDrawingInfo::CameraParams& camera_params, f32 aspect ) : CameraClipPlanes
{
	var Mat4f rotation_matrix_x= Mat4f::MakeRotationX( camera_params.elevation - c_tau / 4.0f );
	var Mat4f rotation_matrix_z= Mat4f::MakeRotationZ( camera_params.azimuth );
	var Mat4f rotation_matrix= rotation_matrix_x * rotation_matrix_z;

	var Vec3f front_plane_normal= Vec3f( 0.0f, 0.0f, -1.0f );

	var f32 half_fov_x= camera_params.fov_x * 0.5f;
	var f32 half_fov_x_cos= ust::cos( half_fov_x );
	var f32 half_fov_x_sin= ust::sin( half_fov_x );

	var Vec3f left_plane_normal = Vec3f( -half_fov_x_cos, 0.0f, -half_fov_x_sin );
	var Vec3f right_plane_normal= Vec3f(  half_fov_x_cos, 0.0f, -half_fov_x_sin );

	var f32 half_fov_y= ust::atan( ust::tan( half_fov_x ) / aspect );
	var f32 half_fov_y_cos= ust::cos( half_fov_y );
	var f32 half_fov_y_sin= ust::sin( half_fov_y );

	var Vec3f upper_plane_normal= Vec3f( 0.0f, -half_fov_y_cos, -half_fov_y_sin );
	var Vec3f lower_plane_normal= Vec3f( 0.0f,  half_fov_y_cos, -half_fov_y_sin );

	return ust::make_array(
		// First plane is front plane - in order to reject stuff behind the back first.
		Planef::CreateFromNormalAndPoint( front_plane_normal * rotation_matrix, camera_params.position + Vec3f( 0.0f, 0.0f, c_z_near ) * rotation_matrix ),
		Planef::CreateFromNormalAndPoint( left_plane_normal  * rotation_matrix, camera_params.position ),
		Planef::CreateFromNormalAndPoint( right_plane_normal * rotation_matrix, camera_params.position ),
		Planef::CreateFromNormalAndPoint( upper_plane_normal * rotation_matrix, camera_params.position ),
		Planef::CreateFromNormalAndPoint( lower_plane_normal * rotation_matrix, camera_params.position ) );
}

fn AreBoxVerticesClippedByAtLeastOneCameraClipPlane( CameraClipPlanes& clip_planes, [ Vec3f, 8 ]& vertices ) : bool
{
	foreach( &clip_plane : clip_planes )
	{
		var f32 mut min_distance= ust::plus_inf</f32/>();
		foreach( &v : vertices )
		{
			ust::min_assign( min_distance, clip_plane.GetDistanceForPoint( v ) );
		}

		if( min_distance >= 0.0f )
		{
			return true;
		}
	}

	return false;
}

fn CalculateCameraRotationMatrix( f32 camera_azimuth, f32 camera_elevation ) : Mat4f
{
	var Mat4f rotation_matrix_z= Mat4f::MakeRotationZ( -camera_azimuth );
	var Mat4f rotation_matrix_x= Mat4f::MakeRotationX( -camera_elevation + c_tau / 4.0f );
	return rotation_matrix_z * rotation_matrix_x;
}

fn CalculateFirstPersonWeaponProjectionDistortionMatrix() : Mat4f
{
	// The original game distorts first-weapon model a bit.
	// These parameters are experimentally found.
	return
		Mat4f::MakeTranslation( Vec3f( 0.0f, 0.0f, 14.0f ) ) *
		Mat4f::MakeScale( Vec3f( 1.0f, 1.0f, 0.5f ) );
}

var f32 c_z_near= 4.0f;
var f32 c_z_far= 32768.0f;
var f32 c_sky_scale= c_z_far / 2.0f;
var f32 c_stars_scale= c_sky_scale;
var f32 c_clouds_scale= c_sky_scale;

var size_type c_max_test_primitive_vertices= 4096s;

// Enough vertices/indices for 4096 quads.
var size_type c_max_semitransparent_polygon_vertices= 16384s;
var size_type c_max_semitransparent_polygon_indices= c_max_semitransparent_polygon_vertices * 3s / 2s;

var GLState g_buffer_clear_gl_state
{
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= true,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

var GLState g_sky_background_gl_state
{
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

var GLState g_stars_gl_state
{
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
