import "/enum_string_conversions.u"
import "/stdout.u"

import "/common_lib/materials_file.uh"
import "/common_lib/string_utils.uh"

import "gl_functions.uh"
import "image_loading.uh"
import "math_constants.uh"
import "vertex_formats.uh"
import "world_drawer.uh"

namespace PM
{

fn WorldDrawer::constructor()
	( map_shader_(
		embed</char8/>( "shaders/map.vert.glsl" ),
		embed</char8/>( "shaders/map.frag.glsl" ) ) )
{}

fn WorldDrawer::SetMap(
	mut this,
	ZmapData& zmap_data,
	ZvoxData& zvox_data,
	MaterialsDescription::Block& materials_block,
	GameFilesystem &mut game_filesystem )
{
	var ust::vector</ MapVertex /> mut vertices;
	var ust::vector</u16/> mut indices;

	foreach( &q : zmap_data.quads )
	{
		var size_type base_index= vertices.size();

		var [ [ i32, 3 ], 4 ] shifts
		[
			[ (q.vertices[0][0]), (q.vertices[0][1]), (q.vertices[0][2]) ],
			[ (q.vertices[1][0]), (q.vertices[1][1]), (q.vertices[1][2]) ],
			[ (q.vertices[2][0]), (q.vertices[2][1]), (q.vertices[2][2]) ],
			[ (q.vertices[3][0]), (q.vertices[3][1]), (q.vertices[3][2]) ]
		];

		var [ i32, 3 ] shifts_min
		[
			ust::min( ust::min(shifts[0][0], shifts[1][0]), ust::min(shifts[2][0], shifts[3][0]) ),
			ust::min( ust::min(shifts[0][1], shifts[1][1]), ust::min(shifts[2][1], shifts[3][1]) ),
			ust::min( ust::min(shifts[0][2], shifts[1][2]), ust::min(shifts[2][2], shifts[3][2]) ),
		];
		var [ i32, 3 ] shifts_max
		[
			ust::max( ust::max(shifts[0][0], shifts[1][0]), ust::max(shifts[2][0], shifts[3][0]) ),
			ust::max( ust::max(shifts[0][1], shifts[1][1]), ust::max(shifts[2][1], shifts[3][1]) ),
			ust::max( ust::max(shifts[0][2], shifts[1][2]), ust::max(shifts[2][2], shifts[3][2]) ),
		];

		var [ i32, 3 ] center
		[
			// Using signed integer division by two is important here.
			// Using fractional numbers or bit-shift isn't correct, because this leads to gaps in map geometry.
			i32( q.center[0] ) - ( shifts_min[0] + shifts_max[0] ) / 2,
			i32( q.center[1] ) - ( shifts_min[1] + shifts_max[1] ) / 2,
			i32( q.center[2] ) - ( shifts_min[2] + shifts_max[2] ) / 2,
		];

		var Vec3f mut u_vec( 0.0f, 1.0f, 0.0f );
		var Vec3f mut v_vec( 1.0f, 0.0f, 0.0f );

		{
			// TODO - make sure it's correct to zero lower bits.
			var f32 angle= f32( i32( q.texture_roll ) & ~15 ) * ( -c_tau / 256.0f );
			var f32 c= ust::cos(angle);
			var f32 s= ust::sin(angle);

			u_vec= Vec3f( u_vec.x * c - u_vec.y * s, u_vec.x * s + u_vec.y * c, u_vec.z );
			v_vec= Vec3f( v_vec.x * c - v_vec.y * s, v_vec.x * s + v_vec.y * c, v_vec.z );
		}
		{
			var f32 angle= ( f32( q.normal_elevation ) + 256.0f ) * ( c_tau / 1024.0f );
			var f32 c= ust::cos(angle);
			var f32 s= ust::sin(angle);

			u_vec= Vec3f( u_vec.x * c - u_vec.z * s, u_vec.y, u_vec.x * s + u_vec.z * c );
			v_vec= Vec3f( v_vec.x * c - v_vec.z * s, v_vec.y, v_vec.x * s + v_vec.z * c );
		}
		{
			var f32 angle= ( 768.0f - f32(q.normal_azimuth) ) * ( c_tau / 1024.0f );
			var f32 c= ust::cos(angle);
			var f32 s= ust::sin(angle);

			u_vec= Vec3f( u_vec.x * c - u_vec.y * s, u_vec.x * s + u_vec.y * c, u_vec.z );
			v_vec= Vec3f( v_vec.x * c - v_vec.y * s, v_vec.x * s + v_vec.y * c, v_vec.z );
		}
		{
			// Use experimentally-found factor for texture basis scaling.
			// This code may be wrong.
			// It should map bits 8 to scale 1.25, bits 12 to scale 2.25.
			// Bits 9 are roughly mapped to scale 1.5.
			//var f32 vecs_scale= ( 1.0f + f32( i32(s.texture_roll) & 15 ) / 9.6f );
			var f32 vecs_scale= 1.0f / ust::cos( f32( i32(q.texture_roll) & 15 ) * 0.0925f );
			u_vec*= vecs_scale;
			v_vec*= vecs_scale;
		}

		var Vec2f tc_offset( f32( q.tc_offset[0] ), f32( q.tc_offset[1] ) );

		// OpenGL uses normalized texture coordinates.
		var f32 constexpr tc_scale= 1.0f / f32( MaterialsDescription::c_texture_size );

		var f32 mut texture_id( q.texture_id );

		// TODO - use speacial passes for special materials.

		if( size_type( q.texture_id ) >=
			materials_block.textures.size() * size_type( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y ) )
		{
			// TODO - optimize this lookup, use a hash-map instead.
			var ust::optional</size_type/> mut special_material_opt;
			for( auto mut j= 0s; j < typeinfo</MaterialsDescription::SpecialMaterial/>.element_count; ++j )
			{
				if( u32( q.texture_id ) == MaterialsDescription::c_special_material_texture_indices[j] )
				{
					texture_id= f32( materials_block.special_material_indices[j] );
					break;
				}
			}
		}

		foreach( &vertex_shift : shifts )
		{
			// Texture coordinates are calculated relative to vertex #0.
			var Vec3f vertex_relative_shift
			(
				f32( vertex_shift[0] - shifts[0][0] ),
				f32( vertex_shift[1] - shifts[0][1] ),
				f32( vertex_shift[2] - shifts[0][2] )
			);

			vertices.push_back(
				MapVertex
				{
					.position
					[
						f32( center[0] + vertex_shift[0] ),
						f32( center[1] + vertex_shift[1] ),
						f32( center[2] + vertex_shift[2] ),
						0.0f,
					],
					.tex_coordinates
					[
						tc_scale * ( vertex_relative_shift.Dot( u_vec ) + tc_offset.x ),
						tc_scale * ( vertex_relative_shift.Dot( v_vec ) + tc_offset.y ),
						texture_id,
					],
					.padding= zero_init
				} );
		}

		indices.push_back( u16( base_index + 0s ) );
		indices.push_back( u16( base_index + 1s ) );
		indices.push_back( u16( base_index + 2s ) );
		indices.push_back( u16( base_index + 0s ) );
		indices.push_back( u16( base_index + 2s ) );
		indices.push_back( u16( base_index + 3s ) );
	}

	var BufferObject mut vertex_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			vertices.range().to_byte8_range() );

	var BufferObject mut index_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ELEMENT_ARRAY_BUFFER ), // Needed for a triangle indices source.
			indices.range().to_byte8_range() );

	var VertexArrayObject mut vertex_array_object;

	vertex_array_object.Bind();

	var GLuint c_position_attrib= 0u;
	var GLuint c_texture_coordinates_attrib= 1u;

	vertex_buffer.Bind();

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );

	unsafe( glVertexAttribPointer(
		c_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</MapVertex/>.size_of ),
		ust::nullptr</byte8/>() + 0s ) );

	unsafe( glEnableVertexAttribArray( c_texture_coordinates_attrib ) );

	unsafe( glVertexAttribPointer(
		c_texture_coordinates_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</MapVertex/>.size_of ),
		ust::nullptr</byte8/>() + typeinfo</f32/>.size_of * 4s ) );

	index_buffer.Bind();

	map_data_.reset(
		MapDrawData
		{
			.vertex_array_object= move(vertex_array_object),
			.vertex_buffer= move(vertex_buffer),
			.index_buffer= move(index_buffer),
			.num_indices= indices.size(),
			.map_textures_array= LoadMapTextures( materials_block, game_filesystem ),
		} );
}

fn WorldDrawer::Draw( mut this, Mat4f& view_matrix )
{
	if( map_data_.empty() )
	{
		return;
	}

	var MapDrawData& map_data= map_data_.try_deref();

	unsafe( glClearColor( GLclampf(32.0 / 255.0), GLclampf(16.0 / 255.0), GLclampf(8.0f / 255.0f), GLclampf(1.0) ) );
	unsafe( glClear( GLbitfield( GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT ) ) );

	unsafe( glEnable( GLenum( GL_DEPTH_TEST ) ) );
	unsafe( glDepthMask( GLboolean(1) ) );
	unsafe( glDepthFunc( GLenum( GL_LEQUAL ) ) );

	unsafe( glEnable( GLenum( GL_CULL_FACE ) ) );
	unsafe( glCullFace( GLenum( GL_FRONT ) ) );

	var u32 texture_slot= 0u;

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	map_data.map_textures_array.Bind();

	map_shader_.Bind();
	map_shader_.SetUniform( "vu_matrix",view_matrix );
	map_shader_.SetUniform( "fu_texture", texture_slot );

	map_data.vertex_array_object.Bind();

	unsafe( glDrawElements( GLenum( GL_TRIANGLES ), GLsizei( map_data.num_indices ), GLenum( GL_UNSIGNED_SHORT ), ust::nullptr</byte8/>() ) );
}

fn LoadMapTextures( MaterialsDescription::Block& materials_block, GameFilesystem &mut game_filesystem ) : Texture
{
	var Texture texture= Texture::Create( GLenum( GL_TEXTURE_2D_ARRAY ) );
	texture.Bind();

	var size_type num_layers=
		materials_block.textures.size() *
		size_type( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y );

	unsafe( glTexImage3D(
		GLenum( GL_TEXTURE_2D_ARRAY ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( MaterialsDescription::c_texture_size ),
		GLsizei( MaterialsDescription::c_texture_size ),
		GLsizei( num_layers ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::nullptr</byte8/>() ) );

	var [ RGBAColor, MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_size ] mut texture_data= zero_init;

	for( var size_type mut t= 0s; t < materials_block.textures.size(); ++t )
	{
		result_match( game_filesystem.LoadFile( ConvertToUppercase( materials_block.textures[t].mips[1] ), LoadImageBMP ) )
		{
			Ok( image_data ) ->
			{
				if( !(  image_data.size[0] == MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_x &&
						image_data.size[1] == MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_y ) )
				{
					ust::stderr_print( "Unexpected texture size!\n" );
					continue;
				}

				for( auto mut tile_y= 0u; tile_y < MaterialsDescription::c_texture_file_num_tiles_y; ++tile_y )
				{
					var u32 src_offset_y= ( MaterialsDescription::c_texture_file_num_tiles_y - 1u - tile_y ) * MaterialsDescription::c_texture_size;

					for( auto mut tile_x= 0u; tile_x < MaterialsDescription::c_texture_file_num_tiles_x; ++tile_x )
					{
						var u32 src_offset_x= tile_x * MaterialsDescription::c_texture_size;

						for( auto mut y= 0u; y < MaterialsDescription::c_texture_size; ++y )
						{
							// Perform here vertical flipping while copying data into destination tile.

							auto src_line= image_data.pixels.range().subrange_start(
								size_type( src_offset_x + ( src_offset_y + MaterialsDescription::c_texture_size - 1u - y ) * image_data.size[0] ) );

							auto dst_line= ust::array_view_mut</RGBAColor/>( texture_data ).subrange(
								size_type( MaterialsDescription::c_texture_size * y ),
								size_type( MaterialsDescription::c_texture_size * ( y + 1u ) ) );

							dst_line.copy_from( src_line );
						}

						var u32 dst_layer=
							u32(t) * MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y  +
							tile_y * MaterialsDescription::c_texture_file_num_tiles_x +
							tile_x;

						unsafe( glTexSubImage3D(
							GLenum( GL_TEXTURE_2D_ARRAY ),
							0,
							0,
							0,
							GLint( dst_layer ),
							GLsizei( MaterialsDescription::c_texture_size ),
							GLsizei( MaterialsDescription::c_texture_size ),
							1,
							GLenum( GL_RGBA ),
							GLenum( GL_UNSIGNED_BYTE ),
							ust::ptr_cast_to_byte8( $<( texture_data ) ) ) );
					}
				}
			},
			Err(e) ->
			{
				ust::stderr_print( ust::concat( "Failed to read texture file! Error: ", ust::enum_to_string(e), "\n" ) );
			}
		}
	}

	unsafe( glGenerateMipmap( GLenum( GL_TEXTURE_2D_ARRAY ) ) );

	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR_MIPMAP_LINEAR ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D_ARRAY ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );

	return texture;
}

} // namespace PM
