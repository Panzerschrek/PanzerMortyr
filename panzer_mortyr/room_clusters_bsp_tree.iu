import "/common_lib/map_files.iu"
import "/vector.iu"
import "bbox.iu"
import "plane.iu"

namespace PM
{

// Leaf BSP tree for room cluster volumes.
struct RoomClustersBSPTree
{
	struct BranchNode
	{
		// Is always axis aligned (two of three normal components are zero, third is non-zero).
		Planef plane;

		// Branch node indices. If it's greater than c_first_leaf_node, it's a leaf node index.
		// children[0] - front (with positive distance to plane), children[1] - back (with negative distance to plane).
		[ NodeIndex, 2 ] children;
	}

	// Leaf for a room cluster or its subvolume.
	struct LeafNode
	{
		BBox3f bbox;
		u32 clustrer_index;
	}

	type NodeIndex= u16;

	var NodeIndex c_first_leaf_node= 32768u16;

	// Node #0 is root.
	ust::vector</BranchNode/> branch_nodes;

	ust::vector</LeafNode/> leaf_nodes;
}

fn BuildRoomClustersBSPTree( ust::array_view_imut</ZvoxCluster/> clusters ) : RoomClustersBSPTree;

} // namespace PM
