import "/common_lib/map_files.iu"
import "/vector.iu"
import "bbox.iu"
import "plane.iu"

namespace PM
{

// Leaf BSP tree for room cluster volumes.
struct RoomClustersBSPTree
{
	struct BranchNode
	{
		// Is always axis aligned (two of three normal components are zero, third is non-zero).
		Planef plane;

		// Branch node indices. If it's greater than c_first_leaf_node, it's a leaf node index.
		// children[0] - front (with positive distance to plane), children[1] - back (with negative distance to plane).
		[ NodeIndex, 2 ] children;
	}

	// Leaf for a room cluster or its subvolume.
	struct LeafNode
	{
		BBox3f bbox;
		u32 clustrer_index;

		// Offset + size to "leaf_portals" array, where indices to portals linked to this node are listed.
		u16 first_leaf_portal;
		u16 num_leaf_portals;
	}

	// Portal is a place where two nodes touch each other.
	struct Portal
	{
		// Actually a portal is flat, so that this bbox has one of dimensions equal to zero.
		// Two others should be non-zero.
		BBox3f bbox;

		// Leaf nodes coonected by this portal.
		[ NodeIndex, 2 ] leaf_nodes;
	}

	// We shouldn't have too many portals, 16-bits is enough.
	type PortalIndex= u16;

	// We shouldn't have too many nodes, 16-bits is enough.
	type NodeIndex= u16;

	var NodeIndex c_first_leaf_node= 32768u16;
	var NodeIndex c_root_node_index= 0u16;

	// Node #0 is root.
	ust::vector</BranchNode/> branch_nodes;

	ust::vector</LeafNode/> leaf_nodes;

	ust::vector</Portal/> portals;

	// Contains chunks for portal lists for each leaf.
	ust::vector</PortalIndex/> leaf_portals;
}

fn BuildRoomClustersBSPTree( ust::array_view_imut</ZvoxCluster/> clusters ) : RoomClustersBSPTree;

} // namespace PM
