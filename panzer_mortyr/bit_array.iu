import "serialization.iu"

namespace PM
{

class BitArray
{
public:
	fn constructor( size_type num_bits )
		( words_( ( num_bits + 31s ) / 32s, 0u ) )
	{}

	fn constructor( mut this, BitArray& other )= default;
	op=( mut this, BitArray& other )= default;

	// May return slightly more than size used for creation - due to rounding to word size.
	fn GetSize( this ) : size_type
	{
		return words_.size() * 32s;
	}

	fn GetBit( this, size_type index ) : bool
	{
		return ( words_[ index / 32s ] & ( 1u << ( index % 32s ) ) ) != 0u;
	}

	fn SetBitToOne( mut this, size_type index )
	{
		words_[ index / 32s ] |= 1u << ( index % 32s );
	}

	fn GetAndSetBitToOne( mut this, size_type index ) : bool
	{
		var u32 &mut word= words_[ index / 32s ];
		var u32 mask= 1u << ( index % 32s );
		var bool res= ( word & mask ) != 0u;
		word|= mask;
		return res;
	}

	fn GetWords( this ) : ust::vector</u32/> &
	{
		return words_;
	}

	fn Serialize( this, Serializer &mut serializer )
	{
		// Just serialize stored fields.
		PM::Serialize( serializer, words_ );
	}

private:
	ust::vector</u32/> words_;
}

class BitArrayView
{
public:
	fn conversion_constructor( BitArray& bit_array ) @( ust::reference_notation::pollution::param0_param_1_reference )
		( words_view_= bit_array.GetWords() )
	{}

	fn constructor( mut this, BitArrayView& other )= default;
	op=( mut this, BitArrayView& other )= default;

	// May return slightly more than size used for creation - due to rounding to word size.
	fn GetSize( this ) : size_type
	{
		return words_view_.size() * 32s;
	}

	fn GetBit( this, size_type index ) : bool
	{
		return ( words_view_[ index / 32s ] & ( 1u << ( index % 32s ) ) ) != 0u;
	}

private:
	ust::array_view_imut</u32/> words_view_;
}

} // namespace PM
