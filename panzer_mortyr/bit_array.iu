import "/vector.iu"

namespace PM
{

class BitArray
{
public:
	fn constructor( size_type num_bits )
		( words_( ( num_bits + 31s ) / 32s, 0u ) )
	{}

	fn GetBit( this, size_type index ) : bool
	{
		return ( words_[ index / 32s ] & ( 1u << ( index % 32s ) ) ) != 0u;
	}

	fn SetBitToOne( mut this, size_type index )
	{
		words_[ index / 32s ] |= 1u << ( index % 32s );
	}

	fn GetWords( this ) : ust::vector</u32/> &
	{
		return words_;
	}

private:
	ust::vector</u32/> words_;
}

class BitArrayView
{
public:
	fn conversion_constructor( BitArray& bit_array ) @( ust::reference_notation::pollution::param0_param_1_reference )
		( words_view_= bit_array.GetWords() )
	{}

	fn GetBit( this, size_type index ) : bool
	{
		return ( words_view_[ index / 32s ] & ( 1u << ( index % 32s ) ) ) != 0u;
	}

private:
	ust::array_view_imut</u32/> words_view_;
}

} // namespace PM
