template</size_type N/>
fn EmitShotSound( [ SoundSourceSlot, N ] &mut slots, u8 sound_index )
{
	var u32 volume_for_shots= 255u; // TODO - tune it?
	EmitSound( slots, sound_index, volume_for_shots );
}

template</size_type N/>
fn EmitSound( [ SoundSourceSlot, N ] &mut slots, u8 sound_index, u32 volume )
{
	if( volume <= 0u )
	{
		return;
	}

	var u8 volume_clamped( ust::min( volume, 255u ) );

	var u16 mut max_sequential_index(0);

	foreach( &slot : slots )
	{
		ust::max_assign( max_sequential_index, slot.sequential_index );
	}

	// Assume that 65535 unique sounds emitted by an entity/player during his/its lifetime is enough and no overflow happens here.
	var u16 next_sequential_index( u32( max_sequential_index ) + 1u );

	// Check if we can override existing sound source with the same index.
	// It's necessary to stop playing previous sound with the same index.
	// The original game does exactly this.
	foreach( &mut slot : slots )
	{
		if( slot.sound_index == sound_index )
		{
			slot.sequential_index= next_sequential_index;
			slot.volume= volume_clamped;
			return;
		}
	}

	// Pick the slot with the smallest sequential index.
	// Doing so we recycle the oldest sounds.

	var u16 mut min_sequential_index( ~0u );
	var size_type mut min_sequential_index_slot_index= 0s;

	for( auto mut i= 0s; i < N; ++i )
	{
		var u16 sequential_index= slots[i].sequential_index;
		if( sequential_index < min_sequential_index )
		{
			min_sequential_index= sequential_index;
			min_sequential_index_slot_index= i;
		}
	}

	var SoundSourceSlot &mut slot= slots[ min_sequential_index_slot_index ];
	slot.sequential_index= next_sequential_index;
	slot.sound_index= sound_index;
	slot.volume= volume_clamped;
}

} // namespace PM
