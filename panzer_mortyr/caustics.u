import "/math.iu"
import "caustics.iu"
import "math_constants.iu"
import "random.iu"

namespace PM
{

fn CreateCausticsTexture() : CausticsTextureData
{
	// Create a 3D texture for caustics.
	//
	// Each layer is composed from several random waves,
	// but with spatial frequency equal to an integer multiple of texture size,
	// so that this texture is seamless.
	//
	// Each layer represents some time slice.
	// Temporal frequency is also equal to an integer multiple of number of texture layers,
	// so that this texture is temporally-seamless.
	//

	var u32 constexpr c_caustics_texture_size= 64u;
	var u32 constexpr c_caustics_texture_num_layers= 32u;

	var f32 spatial_frequency_scale= c_tau / f32( c_caustics_texture_size );
	var f32 temporal_frequency_scale= c_tau / f32( c_caustics_texture_num_layers );

	auto mut create_next_wave=
		lambda[rand= PseudoRandomGenerator( 473u ) ] mut () : CausticWave
		{
			loop
			{
				var [ i32, 2 ] spatial_frequency[ i32( rand.Next() % 25u ) - 12, i32( rand.Next() % 25u ) - 12 ];
				if( spatial_frequency[0] == 0 & spatial_frequency[1] == 0 )
				{
					continue; // Avoid zero frequency.
				}
				return CausticWave
				{
					.spatial_frequency= spatial_frequency,
					.amplitude= f32( rand.Next() ),
					.phase= f32( rand.Next() ) * ( c_tau / f32( PseudoRandomGenerator::c_max_plus_one ) ),
				};
			}
		};

	var [ CausticWave, 128 ] waves[ create_next_wave() ... ];

	var [ [ [ f32, c_caustics_texture_size ], c_caustics_texture_size ], c_caustics_texture_num_layers ] mut texture_data_float= zero_init;

	for( auto mut t= 0u; t < c_caustics_texture_num_layers; ++t )
	{
		var [ [ f32, c_caustics_texture_size ], c_caustics_texture_size ] &mut dst_layer= texture_data_float[t];

		for( auto mut y= 0u; y < c_caustics_texture_size; ++y )
		{
			var [ f32, c_caustics_texture_size ] &mut dst_line= dst_layer[y];

			for( auto mut x= 0u; x < c_caustics_texture_size; ++x )
			{
				var f32 mut val= 0.0f;

				foreach( &wave : waves )
				{
					// It's non-zero, since we don't create waves with zero frequency.
					var f32 spatial_frequency=
						ust::sqrt( f32(
							wave.spatial_frequency[0] * wave.spatial_frequency[0] +
							wave.spatial_frequency[1] * wave.spatial_frequency[1] ) );

					// Make amplitude for shorter waves smaller.
					var f32 amplitude_scale= wave.amplitude / spatial_frequency;

					// Somewhat realistic assumption - temporal frequency depends on spatial frequency.
					// Round to integer to ensure seamless temporal result.
					var f32 temporal_frequency= ust::round( ust::sqrt( spatial_frequency ) );

					val+=
						amplitude_scale *
						ust::sin(
							f32( i32(x) * wave.spatial_frequency[0] ) * spatial_frequency_scale +
							f32( i32(y) * wave.spatial_frequency[1] ) * spatial_frequency_scale +
							f32(t) * temporal_frequency * temporal_frequency_scale +
							wave.phase );
				}


				dst_line[ size_type(x) ]= val;
			}
		}
	}

	var f32 mut min_val= ust::plus_inf</f32/>(), mut max_val= ust::minus_inf</f32/>();

	foreach( &layer : texture_data_float )
	{
		foreach( &row : layer )
		{
			foreach( &val : row )
			{
				ust::min_assign( min_val, val );
				ust::max_assign( max_val, val );
			}
		}
	}

	var f32 inv_range_size= 255.0f / ( max_val - min_val );

	var CausticsTextureData mut texture_data= zero_init;

	for( auto mut layer= 0u; layer < c_caustics_texture_num_layers; ++layer )
	{
		for( auto mut y= 0u; y < c_caustics_texture_size; ++y )
		{
			for( auto mut x= 0u; x < c_caustics_texture_size; ++x )
			{
				var f32 val= texture_data_float[layer][y][x];

				texture_data[layer][y][x]=
					u8( ust::max( 0.0f, ust::min( ( val - min_val ) * inv_range_size, 255.0f ) ) );
			}
		}
	}

	return texture_data;
}

struct CausticWave
{
	[ i32, 2 ] spatial_frequency;
	f32 amplitude;
	f32 phase; // 0 to tau.
}

} // namespace PM
