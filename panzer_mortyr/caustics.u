import "/scoped_array.iu"
import "caustics.iu"
import "gl_functions.iu"

namespace PM
{

fn CreateCausticsTexture() : Texture
{
	var Texture mut texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
	texture.Bind();

	var u32 size= 64u;

	scoped_array u8 mut texture_data[ size_type( size * size ) ]( 0u8 );

	for( auto mut y= 0u; y < size; ++y )
	{
		for( auto mut x= 0u; x < size; ++x )
		{
			texture_data[ size_type( x + y * size ) ]= u8( x + y * 11u );
		}
	}

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_R8 ),
		GLsizei( size ),
		GLsizei( size ),
		0,
		GLenum( GL_RED ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::ptr_cast_to_byte8( texture_data.data() ) ) );

	// TODO - create mips, use anisotropic filtration, etc.
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );

	return texture;
}

} // namespace PM
