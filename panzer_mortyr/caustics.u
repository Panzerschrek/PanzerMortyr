import "/math.iu"
import "/scoped_array.iu"
import "caustics.iu"
import "gl_functions.iu"
import "math_constants.iu"

namespace PM
{

fn CreateCausticsTexture() : Texture
{
	var Texture mut texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
	texture.Bind();

	var u32 size= 64u;

	scoped_array u8 mut texture_data[ size_type( size * size ) ]( 0u8 );

	var f32 frequency_scale= c_tau / f32( size );

	var CausticWave wave
	{
		.spatial_frequency[ 3, 5 ],
		.amplitude= 0.25f,
	};

	for( auto mut y= 0u; y < size; ++y )
	{
		for( auto mut x= 0u; x < size; ++x )
		{
			var f32 val=
				wave.amplitude *
				ust::sin(
					f32( i32(x) * wave.spatial_frequency[0] ) * frequency_scale +
					f32( i32(y) * wave.spatial_frequency[1] ) * frequency_scale );

			texture_data[ size_type( x + y * size ) ]= u8( ust::max( 0.0f, ust::min( ( val + 0.5f ) * 255.0f, 255.0f ) ) );
		}
	}

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_R8 ),
		GLsizei( size ),
		GLsizei( size ),
		0,
		GLenum( GL_RED ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::ptr_cast_to_byte8( texture_data.data() ) ) );

	// TODO - create mips, use anisotropic filtration, etc.
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );

	return texture;
}

struct CausticWave
{
	[ i32, 2 ] spatial_frequency;
	f32 amplitude;
}

} // namespace PM
