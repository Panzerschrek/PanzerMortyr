import "/hash_map.u"
import "/scoped_array.u"
import "gl_functions.uh"
import "gpu_model.uh"
import "image_loading.uh"
import "math_constants.uh"
import "vertex_formats.uh"

namespace PM
{

fn CreateGPUModel( ModelData& model_data ) : GPUModel
{
	var VertexArrayObject mut vertex_array_object;

	var BufferObject mut texture_coordinates_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			model_data.texture_coordinates.range().to_byte8_range() );

	var ust::vector</ModelFrameVertex/> frame_vertices= CreateModelFrameVertices( model_data );

	var BufferObject mut positions_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			frame_vertices.range().to_byte8_range() );

	// Create index buffer only for LOD0 triangles.
	// We don't care about geometry of other LODs, even LOD0 models are pretty low-detail.

	var size_type num_lod0_triangles( model_data.num_lod0_triangles );

	var ust::vector</u16/> mut indices( num_lod0_triangles * 3s, 0u16 );

	for( auto mut i= 0s; i < num_lod0_triangles; ++i )
	{
		var ObbTriangle& triangle= model_data.triangles[i];

		// Original indices are multiplied by 2, divide them back.
		indices[ i * 3s + 0s ]= u16( triangle[0] >> 1 );
		indices[ i * 3s + 1s ]= u16( triangle[1] >> 1 );
		indices[ i * 3s + 2s ]= u16( triangle[2] >> 1 );
	}

	var BufferObject mut index_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ELEMENT_ARRAY_BUFFER ), // Needed for a triangle indices source.
			indices.range().to_byte8_range() );

	vertex_array_object.Bind();

	texture_coordinates_buffer.Bind();

	unsafe( glEnableVertexAttribArray( GPUModel::c_texture_coordinates_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_texture_coordinates_attrib,
		2,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ObbVertexTextureCoordinates/>.size_of ),
		ust::nullptr</byte8/>() ) );

	positions_buffer.Bind();

	unsafe( glEnableVertexAttribArray( GPUModel::c_position_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ ModelFrameVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( GPUModel::c_normal_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_normal_attrib,
		3,
		GLenum( GL_BYTE ),
		GLboolean(1),
		GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ ModelFrameVertex, "normal" />() ) );

	index_buffer.Bind();

	return GPUModel
	{
		.num_vertices( model_data.num_vertices ),
		.num_triangles( model_data.num_lod0_triangles ),
		.num_frames( model_data.num_frames ),
		.vertex_array_object= move( vertex_array_object ),
		.texture_coordinates_buffer= move( texture_coordinates_buffer ),
		.positions_buffer= move( positions_buffer ),
		.index_buffer= move( index_buffer ),
		.textures=
			ust::make_vector_from_mapped_range(
				model_data.texture_collections,
				lambda[]( ModelData::TextureCollection& c ) : Texture
				{
					return CreateModelTexture( c.hd_textures[0] );
				} ),
		.frame_bboxes= CalculateModelFrameBBoxes( model_data ),
	};
}

fn CreateModelTexture( ModelData::TextureData& texture_data ) : Texture
{
	var Texture texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
	texture.Bind();

	scoped_array RGBAColor rgba_pixels[ texture_data.pixels_data.size() ] (
		texture_data.pixels_data.iter().map(
			lambda[&p= texture_data.palette]( u8 index ) : RGBAColor
			{
				var size_type i(index);
				// Fetch cikir frin palette and convert BGR to RGBA.
				return ust::make_array( p[ i * 3s + 2s ], p[ i * 3s + 1s ], p[ i * 3s + 0s ], 255u8 );
			} ) );

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( texture_data.size[0] ),
		GLsizei( texture_data.size[1] ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::ptr_cast_to_byte8( rgba_pixels.data() ) ) );

	unsafe( glGenerateMipmap( GLenum( GL_TEXTURE_2D ) ) );

	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR_MIPMAP_LINEAR ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );

	return texture;
}

fn CreateModelFrameVertices( ModelData& model_data ) : ust::vector</ModelFrameVertex/>
{
	// Recalculate per-vertex normals.
	// It's necessary, since normals stored in the original models aren't correct in many cases.

	var ust::vector</ModelFrameVertex/> mut model_vertices(
		model_data.vertex_positions_data.size(), ust::make_zeroed</ModelFrameVertex/>() );

	var ust::hash_map</Vec3f, Vec3f/> mut positions_to_normals;

	var f32 c_min_normal_length= 0.000001f;
	var f32 c_stored_normal_scale= 127.0f;

	for( auto mut frame_index= 0u; frame_index < model_data.num_frames; ++frame_index )
	{
		auto frame_src_vertices=
			model_data.vertex_positions_data.range().subrange(
				size_type( model_data.num_vertices * frame_index ),
				size_type( model_data.num_vertices * ( frame_index + 1u ) ) );

		auto frame_dst_vertices=
			model_vertices.range().subrange(
				size_type( model_data.num_vertices * frame_index ),
				size_type( model_data.num_vertices * ( frame_index + 1u ) ) );

		// Calculate per-triangle normals and accumulate these normals in each adjacent vertex.
		// We need to use position-based hash-map here,
		// since some vertices may have identical positions but be distinct due to different texture coordinates.

		positions_to_normals.clear();

		foreach( &triangle : model_data.triangles.range().subrange_end( size_type( model_data.num_lod0_triangles ) ) )
		{
			var ObbVertexPosition
				& src_v0= frame_src_vertices[ size_type( triangle[0] >> 1 ) ],
				& src_v1= frame_src_vertices[ size_type( triangle[1] >> 1 ) ],
				& src_v2= frame_src_vertices[ size_type( triangle[2] >> 1 ) ];

			var Vec3f
				v0( src_v0.coords[0], src_v0.coords[1], src_v0.coords[2] ),
				v1( src_v1.coords[0], src_v1.coords[1], src_v1.coords[2] ),
				v2( src_v2.coords[0], src_v2.coords[1], src_v2.coords[2] );

			var Vec3f normal= ( v1 - v0 ).Cross( v2 - v1 );
			var Vec3f normal_normalized= normal / ust::max( c_min_normal_length, normal.Length() );

			positions_to_normals.find_or_construct_new( v0, Vec3f::MakeZero )+= normal_normalized;
			positions_to_normals.find_or_construct_new( v1, Vec3f::MakeZero )+= normal_normalized;
			positions_to_normals.find_or_construct_new( v2, Vec3f::MakeZero )+= normal_normalized;
		}

		// Normalize collected previously normals.

		foreach( &pair : positions_to_normals )
		{
			var Vec3f &mut normal= pair.value();
			normal/= ust::max( c_min_normal_length, normal.Length() );
		}

		// Store result normals together with vertices.

		foreach( pair : frame_src_vertices.iter().zip( frame_dst_vertices.iter() ) )
		{
			var ObbVertexPosition& src_vertex= pair.first;
			var ModelFrameVertex &mut dst_vertex= pair.second;

			dst_vertex.position= src_vertex.coords;

			if_var( &n :
				positions_to_normals.find( Vec3f( src_vertex.coords[0], src_vertex.coords[1], src_vertex.coords[2] ) ) )
			{
				dst_vertex.normal[0]= i8( ust::max( -c_stored_normal_scale, ust::min( n.x * c_stored_normal_scale, c_stored_normal_scale ) ) );
				dst_vertex.normal[1]= i8( ust::max( -c_stored_normal_scale, ust::min( n.y * c_stored_normal_scale, c_stored_normal_scale ) ) );
				dst_vertex.normal[2]= i8( ust::max( -c_stored_normal_scale, ust::min( n.z * c_stored_normal_scale, c_stored_normal_scale ) ) );
			}
		}
	}

	return model_vertices;
}

fn CalculateModelFrameBBoxes( ModelData& model_data ) : ust::vector</BBox3f/>
{
	return
		ust::make_vector_from_filler_function(
			size_type( model_data.num_frames ),
			lambda[ &model_data, frame_index= 0u ] mut () : BBox3f
			{
				var BBox3f bbox= CalculateModelFrameBBox( model_data, frame_index );
				++frame_index;
				return bbox;
			} );
}

fn CalculateModelFrameBBox( ModelData& model_data, u32 frame_index ) : BBox3f
{
	auto frame_vertices=
		model_data.vertex_positions_data.range().subrange(
			size_type( model_data.num_vertices * frame_index ),
			size_type( model_data.num_vertices * ( frame_index + 1u ) ) );

	var BBox3f mut bbox
	{
		.min( ust::plus_inf </f32/>(), ust::plus_inf </f32/>(), ust::plus_inf </f32/>() ),
		.max( ust::minus_inf</f32/>(), ust::minus_inf</f32/>(), ust::minus_inf</f32/>() ),
	};

	foreach( &vetex : frame_vertices )
	{
		ust::min_assign( bbox.min.x, vetex.coords[0] );
		ust::min_assign( bbox.min.y, vetex.coords[1] );
		ust::min_assign( bbox.min.z, vetex.coords[2] );
		ust::max_assign( bbox.max.x, vetex.coords[0] );
		ust::max_assign( bbox.max.y, vetex.coords[1] );
		ust::max_assign( bbox.max.z, vetex.coords[2] );
	}

	return bbox;
}

} // namespace PM
