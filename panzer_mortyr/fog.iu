import "/random_access_range.iu"
import "vertex_formats.iu"
import "bbox.iu"

namespace PM
{

fn CalculateFogForSemitransparentGeometryVertices(
	Vec3f& camera_position,
	ust::array_view_mut</MapVertex/> vertices );

fn CalculateLocalFogForSemitransparentGeometryVertices(
	Vec3f& camera_position,
	ust::array_view_imut</BBox3f/> local_fog_volumes,
	ust::array_view_mut</MapVertex/> vertices );

// Fog formula is 1 - exp( distance * scale ).
var f32 c_global_exponential_fog_distance_scale= -1.0f / 3072.0f;

fn CalculateOneMinusFogDensity( f32 distance_to_camera ) : f32
{
	// TODO - optimize this, use faster function.
	return ust::exp( c_global_exponential_fog_distance_scale * distance_to_camera );
}

} // namespace PM
