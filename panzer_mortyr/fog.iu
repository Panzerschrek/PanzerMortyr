import "bbox.iu"
import "vertex_formats.iu"

namespace PM
{

fn CalculateFogForSemitransparentGeometryVertices( Vec3f& camera_position, ust::array_view_mut</MapVertex/> vertices );

fn CalculateLocalFogForSemitransparentGeometryVertices(
	Vec3f& camera_position,
	ust::array_view_imut</BBox3f/> local_fog_volumes,
	ust::array_view_mut</MapVertex/> vertices );

// Fog formula is 1 - exp( distance * scale ).
var f32 c_global_exponential_fog_distance_scale= -1.0f / 3072.0f;

fn CalculateOneMinusFogDensity( f32 distance_to_camera ) : f32
{
	// Don't call library "exp" function, since it can't be inlined.
	// Use an approximation for exponent instead: exp(x)= pow( ( 1 + x / 32 ), 32 ).
	// It's a good approximation for negative number exponents (which is used for fog).
	// It diverges towards minus infinity, but the tipping point is located too far away to care about it.
	var f32 x= 1.0f + distance_to_camera * ( c_global_exponential_fog_distance_scale / 32.0f );
	var f32  x2=  x  *  x ;
	var f32  x4=  x2 *  x2;
	var f32  x8=  x4 *  x4;
	var f32 x16=  x8 *  x8;
	var f32 x32= x16 * x16;
	return x32;
}

} // namespace PM
