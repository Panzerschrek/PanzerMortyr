import "/string_conversions.iu"
import "/common_lib/string_iterators.iu"
import "regional_version.iu"

namespace PM
{

fn DetectRegionalVersion( StringTable& string_table, ConsoleOutPtr& console_out ) : RegionalVersion
{
	if(
		( FetchStringFromTable( string_table, StringTableKey::Yes ) == "tak" &&
		  FetchStringFromTable( string_table, StringTableKey::No ) == "nie" ) ||
		FetchStringFromTable( string_table, StringTableKey::HasKilled ) == "zabil" ||
		FetchStringFromTable( string_table, StringTableKey::AlwaysRun ) == "zawsze bieg:" ||
		FetchStringFromTable( string_table, StringTableKey::CreateGame ) == "stworz gre" )
	{
		ConsoleOutAddTextLine( console_out, "Polish version detected." );
		return RegionalVersion::Polish;
	}

	if(
		( FetchStringFromTable( string_table, StringTableKey::Yes ) == "yes" &&
		  FetchStringFromTable( string_table, StringTableKey::No ) == "no" ) ||
		FetchStringFromTable( string_table, StringTableKey::HasKilled ) == "has killed" ||
		FetchStringFromTable( string_table, StringTableKey::AlwaysRun ) == "always run:" ||
		FetchStringFromTable( string_table, StringTableKey::CreateGame ) == "create game" )
	{
		ConsoleOutAddTextLine( console_out, "English version detected." );
		return RegionalVersion::English;
	}

	ConsoleOutAddTextLine( console_out, "Failed to detect regional version! Assume english version." );
	return RegionalVersion::English;
}

fn DetectRegionalVersion( ust::string_view8 raw_string_table, ConsoleOutPtr& console_out ) : RegionalVersion
{
	var u32 mut num_lines_polish= 0u, mut num_lines_english= 0u;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( raw_string_table ) ) )
	{
		if( line == "tak" ||
			line == "nie" ||
			line == "zabil" ||
			line == "zawsze bieg:" ||
			line == "stworz gre" )
		{
			++num_lines_polish;
		}

		if( line == "yes" ||
			line == "no" ||
			line == "has killed" ||
			line == "always run:" ||
			line == "create game" )
		{
			++num_lines_english;
		}
	}

	ConsoleOutAddTextLine(
		console_out,
		ust::concat(
			"In the string table detected ",
			ust::to_string8( num_lines_polish ),
			" polish lines, ",
			ust::to_string8( num_lines_english ),
			" english lines." ) );

	if( num_lines_polish > num_lines_english )
	{
		ConsoleOutAddTextLine( console_out, "Polish version detected." );
		return RegionalVersion::Polish;
	}

	if( num_lines_english > num_lines_polish )
	{
		ConsoleOutAddTextLine( console_out, "English version detected." );
		return RegionalVersion::English;
	}

	ConsoleOutAddTextLine( console_out, "Failed to detect regional version! Assume english version." );
	return RegionalVersion::English;
}

} // namespace PM
