import "bounding_boxes_hierarchy.iu"

namespace PM
{

// Struture representing global navigation graph - which can be used by all enemies for navigation.
struct GlobalNavigationGraph
{
	struct Node
	{
		Vec3f position;

		// Offset + size into "node_output_edges" container.
		u32 first_output_edge;
		u8 num_output_edges;

		// If true - this node can fit the large node bbox.
		bool large;
	}

	// Hierarchy for speeding-up spatial lookups of nodes.
	type NodesHierarchy= BoundingBoxesHierarchy</NodeIndex/>;

	// The largest maps have around 10000 nodes. Using 16-bit indices is enough.
	type NodeIndex= u16;

	// Edges in the global navigation graph are directional.
	// Sometimes only an edge in single direction can exist between two nodes.
	struct OutputEdge
	{
		NodeIndex dst_node_index;

		// Distance between nodes (projected to XY plane), in world units.
		// It can be larger than actual distance assuming that movement may require some bumping around corners.
		// But it shouldn't be smaller.
		u16 length;
	}

	// Entity navigation info taken from ZPOZ file and attached to the global navigation graph.
	struct EntityNavigationInfo
	{
		// Node indices for patrolling path having up to 16 points.
		// Empty values are filled with invalid node index.
		[ NodeIndex, 16 ] patrolling_nodes;
		[ NodeIndex, 16 ] large_patrolling_nodes;
	}

	// Use it to represent non-existing node index.
	var NodeIndex c_invalid_node_index(~0s);

	// Node size used for calculation of this graph.
	BBox3f node_bbox{ .min= Vec3f::MakeZero(), .max= Vec3f::MakeZero() };

	// BBox which can fit in nodes marked with "large" flag.
	BBox3f large_node_bbox{ .min= Vec3f::MakeZero(), .max= Vec3f::MakeZero() };

	// How far away from each other nodes are placed.
	// Actual spacing isn't always equal to this, sine nodes many be moved prior to be placed.
	f32 nodes_spacing= 0.0f;

	ust::vector</Node/> nodes;

	NodesHierarchy nodes_hierarchy;

	ust::vector</OutputEdge/> node_output_edges;

	// This array matches corresponding entries in ZPOZ file (ZpozEntityNavigationInfo structure).
	ust::vector</EntityNavigationInfo/> entity_navigation_infos;
}

} // namespace PM
