import "/sdl/sdl_with_opengl.uh"

namespace PM
{

// A RAII class for creating/destroying a window with OpenGL output support.
class OpenGLWindow
{
public:
	// Constructor halts if failed to initialize.
	fn constructor();

	fn destructor();

	fn GetViewportSize( this ) : [ u32, 2 ];

	// Call this to show thing drawn before via OpenGL context.
	// May wait or may not wait for vsync.
	fn SwapWindow( mut this );

private:
	[ u32, 2 ] imut viewport_size_;
	$(SDL_Window) window_;
	SDL_GLContext gl_context_;
}

static_assert( !typeinfo</OpenGLWindow/>.is_copy_constructible && !typeinfo</OpenGLWindow/>.is_copy_assignable );

} // namespace PM
