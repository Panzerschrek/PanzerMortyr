import "/scoped_array.iu"
import "/common_lib/billboards_description_file.iu"
import "bounding_boxes_hierarchy_debug_visualization.iu"
import "game_constants.iu"
import "game_logic.iu"
import "game_state_view_construction.iu"
import "mat.iu"

namespace PM
{

fn ConstructWorldDrawingInfo(
	Settings& settings,
	f32 time_steps,
	CameraController& camera_controller,
	ust::optional_ref_imut</GameMapData/> map_data_opt,
	ust::optional_ref_imut</GameState/> game_state_opt ) : WorldDrawingInfo
{
	var f32 time_steps_fraction= time_steps % 1.0f;

	var WorldDrawingInfo mut drawing_info
	{
		.game_time_s= time_steps / f32( c_steps_per_second ),
		.map_index= 0u,
		.camera_params
		{
			.position= Vec3f::MakeZero(),
			.azimuth= camera_controller.GetAzimuth(),
			.elevation= camera_controller.GetElevation(),
			.fov_x= camera_controller.GetFOV(),
		},
		.fullscreen_effect= WorldDrawingInfo::FullscreenEffect::None,
		.broken_quad_bits( 0s ), // Set later.
	};

	if( !map_data_opt.empty() && !game_state_opt.empty() )
	{
		var GameMapData& map_data= map_data_opt.try_deref();
		var GameState& game_state= game_state_opt.try_deref();

		// It's not a big deal to copy this list, in the wors case it has maximum 40-50 elements.
		drawing_info.used_models= map_data.used_models;

		drawing_info.map_index= map_data.map_index;

		// Copy bit array of broken quads.
		// It may be a little bit slow, since some maps have a lot of quads.
		drawing_info.broken_quad_bits= game_state.broken_quad_bits;

		var Vec3f camera_position_without_depth_shift= GetCameraPositionForPlayer( game_state.player );

		drawing_info.camera_params.position=
			camera_position_without_depth_shift + GetCameraDepthShift( camera_controller );

		// Count how many damaging flames are attached to each entity.
		scoped_array u8 mut num_entity_damaging_flames[ game_state.entities.size() ] ( 0u8 );
		game_state.damaging_flames.Iterate(
			lambda[&]( DamagingFlame& damaging_flame )
			{
				var size_type index( damaging_flame.entity_index );
				if( index < num_entity_damaging_flames.size() )
				{
					++num_entity_damaging_flames[index];
				}
			} );

		var EntitiesDescription& entities_description= map_data.entities_description.deref();

		foreach( pair : game_state.entities.iter().zip( num_entity_damaging_flames.iter() ) )
		{
			auto& entity_opt= pair.first;

			if( entity_opt.empty() )
			{
				continue;
			}

			var EntityState& entity= entity_opt.try_deref();

			var u8 num_damaging_flames= pair.second;

			var EntitiesDescription::EntityDescription& entity_description= entities_description.entities[ size_type( entity.kind ) ];

			if( size_type( entity.current_operation ) >= entity_description.operations.size() )
			{
				continue;
			}

			var EntitiesDescription::Operation& operation= entity_description.operations[ size_type( entity.current_operation ) ];

			if_var( &explosion_light : operation.explosion_light )
			{
				if( i32( entity.num_steps_since_operation_start ) >= explosion_light.params[0] &&
					i32( entity.num_steps_since_operation_start ) < explosion_light.params[1] )
				{
					// Investigations have shown, that light power of this effect is always the same and can't be changed.
					var f32 light_power= 75.0f;

					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position( entity.position.xy(), entity.position.z + f32( explosion_light.params[4] ) ),
							.power= light_power * c_light_power_scale,
							.color_index( explosion_light.params[3] ),
						} );
				}
			}

			if_var( &light : operation.light )
			{
				if( entity.num_steps_since_operation_start >= light.time &&
					entity.num_steps_since_operation_start < light.time + light.delta )
				{
					var f32 fade=
						( f32( light.time + light.delta - entity.num_steps_since_operation_start ) - f32( time_steps_fraction ) ) /
						f32( light.delta );

					var Vec3f offset_transformed=
						Vec3f( f32( light.offset_x ), f32( light.offset_y ), f32( light.offset_z ) ) *
						Mat4f::MakeRotationZ( entity.azimuth );

					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position= entity.position + offset_transformed,
							.power= f32(light.power) * fade * c_light_power_scale,
							.color_index( light.color ),
						} );
				}
			}

			if( num_damaging_flames > 0u8 )
			{
				// PanzerMortyr addition - add lights for burning entities.
				var f32 flame_power= 6.0f;

				drawing_info.dynamic_light_sources.push_back(
					WorldDrawingInfo::DynamicLightSource
					{
						.position=
							entity.position +
							Vec3f(
								f32( operation.animation.bounding_box_center_x ),
								f32( operation.animation.bounding_box_center_y ),
								f32( operation.animation.bounding_box_center_z ) ),
						.power= f32( num_damaging_flames ) * flame_power * c_light_power_scale,
						.color_index= c_flame_color_index,
					} );
			}

			if( operation.animation.num_steps > 0u )
			{
				var size_type a( operation.animation.animation_number );
				if( a < entities_description.animations.size() )
				{
					var EntitiesDescription::AnimationDescription& animation= entities_description.animations[a];

					var bool is_sky_decoration=
						operation.animation_kind == EntitiesDescription::Operation::AnimationKind::Landscape;

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= animation.model_file_name,
							.position= entity.position,
							.azimuth= entity.azimuth,
							.elevation= 0.0f,
							.frame= entity.animation_frame,
							// If it's a sky decoration - disable culling.
							// It should be always visible, even if such decoration is located somewhere outside map bounds.
							.disable_culling= is_sky_decoration,
							.first_person_weapon= false,
							// Use constant lighting for sky decorations.
							.constant_lighting= is_sky_decoration,
						} );
				}
			}

			if( operation.directional_animation.num_steps > 0u )
			{
				var size_type a( operation.directional_animation.animation_number );
				if( a < entities_description.animations.size() )
				{
					var EntitiesDescription::AnimationDescription& animation= entities_description.animations[a];

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= animation.model_file_name,
							.position= entity.position,
							.azimuth= Convert1024Angle( f32( operation.directional_animation.direction ) ),
							.elevation= 0.0f,
							.frame= entity.directional_animation_frame,
							.disable_culling= false,
							.first_person_weapon= false,
							.constant_lighting= false,
						} );
				}
			}

			if( operation.animation_kind == EntitiesDescription::Operation::AnimationKind::Insect )
			{
				// TODO - draw flies.
			}
		}

		game_state.projectiles.Iterate(
			lambda[&]( Projectile& projectile )
			{
				var EntitiesDescription::Tool& weapon_tool=
					entities_description.tools[ size_type( projectile.weapon_tool_index ) ];

				if( weapon_tool.projectile_model >= EntitiesDescription::Tool::c_projectile_model_first_mesh_model )
				{
					// Projectiles for this weapon are drawn via a model.
					var size_type animation_index(
						weapon_tool.projectile_model - EntitiesDescription::Tool::c_projectile_model_first_mesh_model );
					if( animation_index < entities_description.animations.size() )
					{
						var EntitiesDescription::AnimationDescription& animation= entities_description.animations[ animation_index ];

						// Calculate orientation based on velocity vector.
						// It isn't ideal, but fine enough.
						var f32 mut azimuth= 0.0f;
						var f32 mut elevation= 0.0f;
						var f32 velocity_xy_square_length= projectile.velocity.xy().SquareLength();
						if( velocity_xy_square_length > 0.0f )
						{
							 azimuth= -ust::atan2( projectile.velocity.x, projectile.velocity.y );
							 elevation= ust::atan2( projectile.velocity.z, ust::sqrt( velocity_xy_square_length ) );
						}
						else
						{
							elevation= ( projectile.velocity.z > 0.0f ? c_tau * 0.25f : -c_tau * 0.25f );
						}

						drawing_info.model_objects.push_back(
							WorldDrawingInfo::ModelObject
							{
								.model_file_name= animation.model_file_name,
								.position= projectile.position,
								.azimuth= azimuth,
								.elevation= elevation,
								.frame= 0u,
								// Disable culling for projectiles - allow drawing them in skies.
								.disable_culling= true,
								.first_person_weapon= false,
								.constant_lighting= false,
							} );
					}
				}
				else if(
					weapon_tool.projectile_model >= 0 &&
					weapon_tool.projectile_model < i32( typeinfo</ typeof( BillboardConstants::c_shot_ids ) />.element_count ) )
				{
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCustomAxis,
							.position= projectile.position,
							// Make projectiles slighly bigger than unit scale, since otherwise they are barely visible.
							.scale= 2.0f,
							.custom_axis= projectile.velocity,
							.billboard_index( BillboardConstants::c_shot_ids[ size_type( weapon_tool.projectile_model ) ] ),
						} );
				}

				if( weapon_tool.projectile_light[1] > 0u )
				{
					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position= projectile.position,
							.power= f32( weapon_tool.projectile_light[1] ) * c_light_power_scale,
							.color_index= weapon_tool.projectile_light[0],
						} );
				}
			} );

		// Temporary visualisation of damaging flames.
		// TODO - replace it with proper flame effects applied to the model of a damaged entity.
		game_state.damaging_flames.Iterate(
			lambda[&]( DamagingFlame& damaging_flame )
			{
				if( size_type( damaging_flame.entity_index ) < game_state.entities.size() )
				{
					if_var( &entity : game_state.entities[ size_type( damaging_flame.entity_index ) ] )
					{
						if( size_type( entity.collider_index ) < game_state.colliders.size() )
						{
							var BBox3f& collider_bbox= game_state.colliders[ size_type( entity.collider_index ) ].bbox;

							var u32 phase=
								damaging_flame.age_steps / c_animated_billboards_frequency_divisor % BillboardConstants::c_num_flames;

							drawing_info.billboards.push_back(
								WorldDrawingInfo::Billboard
								{
									.alignment= WorldDrawingInfo::Billboard::Alignment::ZAxis,
									.billboard_index( BillboardConstants::c_id_first_flame + phase ),
									.position(
										( collider_bbox.min.xy() + collider_bbox.max.xy() ) * 0.5f,
										collider_bbox.min.z - 24.0f ),
								} );
						}
					}
				}
			} );

		game_state.projectile_hit_smoke_particles.Iterate(
			lambda[&]( ProjectileHitSmokeParticle& smoke_particle )
			{
				var f32 relative_age=
					( f32( smoke_particle.age_steps ) + time_steps_fraction ) / f32( c_projectile_hit_smoke_particle_max_age );

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
						.billboard_index( BillboardConstants::c_id_projectile_hit_smoke ),
						.position= smoke_particle.position,
						.brightness= 0.3f * ( 1.0f - relative_age ),
						.scale= 0.5f * ust::exp( relative_age * 2.0f ),
					} );
			} );

		game_state.breaking_glass_effects.Iterate(
			lambda[&]( BreakingGlassEffect& breaking_glass_effect )
			{
				drawing_info.breaking_glass_effects.push_back(
					WorldDrawingInfo::BreakingGlass
					{
						.hit_position= breaking_glass_effect.hit_position,
						.cluster_index= breaking_glass_effect.cluster_index,
						.quad_index= breaking_glass_effect.quad_index,
						.age= ( f32( breaking_glass_effect.age_steps ) + time_steps_fraction ) / f32( c_breaking_glass_max_age ),
					} );
			} );

		game_state.muzzle_flashes.Iterate(
			lambda[&]( MuzzleFlash& muzzle_flash )
			{
				var Vec3f mut absolute_position= Vec3f::MakeZero();
				var Vec3f mut custom_axis= Vec3f::MakeZero();

				var u32 c_first_axis_aligned_shot= 19u;
				var bool is_axis_aligned_shot= muzzle_flash.model >= c_first_axis_aligned_shot;

				if( muzzle_flash.owner_entity_index == c_player_entity_index )
				{
					var Mat4f rotation_matrix=
						Mat4f::MakeRotationX( drawing_info.camera_params.elevation ) *
						Mat4f::MakeRotationZ( drawing_info.camera_params.azimuth );

					// HACK! Add extra shift to match how muzzle flashes look like in the original game.
					// TODO - try removing it by tweaking code calculating billboard position?
					var Vec3f extra_shift( 0.0f, ( is_axis_aligned_shot ? 24.0f : 0.0f ), 0.0f );

					absolute_position=
						camera_position_without_depth_shift +
						( muzzle_flash.relative_position + extra_shift ) * rotation_matrix;

					custom_axis= Vec3f( 0.0f, 1.0f, 0.0f ) * rotation_matrix;
				}
				else
				{
					if( size_type( muzzle_flash.owner_entity_index ) < game_state.entities.size() )
					{
						if_var( &entity : game_state.entities[ size_type( muzzle_flash.owner_entity_index ) ] )
						{
							var Mat4f rotation_matrix= Mat4f::MakeRotationZ( entity.azimuth );

							absolute_position= entity.position + muzzle_flash.relative_position * rotation_matrix;
							custom_axis= Vec3f( 0.0f, 1.0f, 0.0f ) * rotation_matrix;
						}
						else
						{
							return;
						}
					}
					else
					{
						return;
					}
				}

				if( size_type( muzzle_flash.model ) < typeinfo</ typeof( BillboardConstants::c_shot_ids ) />.element_count )
				{
					var u32 billboard_id= BillboardConstants::c_shot_ids[ muzzle_flash.model ];

					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment=
								( is_axis_aligned_shot
									? WorldDrawingInfo::Billboard::Alignment::ToCustomAxis
									: WorldDrawingInfo::Billboard::Alignment:: ToCamera ),
							.billboard_index( billboard_id ),
							.position= absolute_position,
							.custom_axis= custom_axis,
							// Reduce brightness with time.
							.brightness= 1.0f - ( f32( ust::max( 1u, muzzle_flash.age_steps ) - 1u ) + time_steps_fraction ) / f32( c_muzzle_flash_max_age ),
							 // Make axis-aligned muzzle flashes slightly bigger. They are way to small.
							.scale= ( is_axis_aligned_shot ? 6.0f : 1.0f ),
						} );
				}
			} );

		game_state.explosion_particles.Iterate(
			lambda[&]( ExplosionParticle& explosion_particle )
			{
				auto [ first_id, count ] =
					( explosion_particle.large
						? ust::make_array( BillboardConstants::c_id_first_explosion4, BillboardConstants::c_num_explosions4 )
						: ust::make_array( BillboardConstants::c_id_first_explosion1, BillboardConstants::c_num_explosions1 ) );

				var u32 phase= explosion_particle.age_steps / c_animated_billboards_frequency_divisor;
				if( phase < count )
				{
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
							.billboard_index( first_id + phase ),
							.position= explosion_particle.position,
						} );
				}
			} );

		game_state.flame_particles.Iterate(
			lambda[&]( FlameParticle& flame_particle )
			{
				var u32 phase=
					flame_particle.age_steps / c_animated_billboards_frequency_divisor % BillboardConstants::c_num_flames;

				// At the end of their lifetime make flames darker and smaller.
				var f32 relative_age=
					( f32( flame_particle.age_steps ) + time_steps_fraction ) / f32( c_flame_particle_max_age );
				var f32 fade_phase= ust::min( ( 1.0f - relative_age ) * 5.0f, 1.0f );

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ZAxis,
						.billboard_index( BillboardConstants::c_id_first_flame + phase ),
						// Slighly move flame billboards up, so that flame center is at billboard bottom.
						.position( flame_particle.position.xy(), flame_particle.position.z - 24.0f * fade_phase ),
						.brightness= fade_phase,
						.scale= fade_phase,
					} );

				// PanzerMortyr addition - add dynamic lights for flames.
				// TODO - maybe limit their count? There can be a lot of flames.
				var f32 constexpr flame_light_power= 1.5f;

				drawing_info.dynamic_light_sources.push_back(
					WorldDrawingInfo::DynamicLightSource
					{
						.position= flame_particle.position,
						.power= flame_light_power * c_light_power_scale * fade_phase,
						.color_index= c_flame_color_index,
					} );
			} );

		game_state.smoke_particles.Iterate(
			lambda[&]( SmokeParticle& smoke_particle )
			{
				var f32 relative_age=
					( f32( smoke_particle.age_steps ) + time_steps_fraction ) / f32( c_smoke_particle_max_age );

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
						.billboard_index(
							( smoke_particle.smoke_model == 1u
								? BillboardConstants::c_id_smoke_black
								: BillboardConstants::c_id_smoke_white ) ),
						.position= smoke_particle.position,
						.scale= ust::exp( relative_age ),
						.brightness= 1.0f - relative_age,
					} );
			} );

		game_state.smoke_trail_particles.Iterate(
			lambda[&]( SmokeTrailParticle& smoke_trail_particle )
			{
				switch( smoke_trail_particle.kind )
				{
					EntitiesDescription::Tool::c_smoke_trail_kind_rocket ->
					{
						var f32 relative_age=
							( f32( smoke_trail_particle.age_steps ) + time_steps_fraction ) /
							f32( c_smoke_trail_particle_max_age );

						var u32 billboard=
							BillboardConstants::c_id_first_rocket_smoke_trail_particle +
							smoke_trail_particle.age_steps / c_animated_billboards_frequency_divisor % BillboardConstants::c_num_rocket_smoke_trail_particles;

						drawing_info.billboards.push_back(
							WorldDrawingInfo::Billboard
							{
								.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
								.billboard_index( billboard ),
								.position= smoke_trail_particle.position,
								.scale= ust::exp( relative_age ),
								.brightness= 1.0f - relative_age,
							} );
					},
					EntitiesDescription::Tool::c_smoke_trail_kind_flamethrower ->
					{
						var u32 phase= smoke_trail_particle.age_steps / c_animated_billboards_frequency_divisor;
						if( phase < BillboardConstants::c_num_explosions5 )
						{
							drawing_info.billboards.push_back(
								WorldDrawingInfo::Billboard
								{
									.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
									.billboard_index( BillboardConstants::c_id_first_explosion5 + phase ),
									.position= smoke_trail_particle.position,
								} );
						}
					},
					EntitiesDescription::Tool::c_smoke_trail_kind_mind_control ->
					{
						var f32 relative_age=
							( f32( smoke_trail_particle.age_steps ) + time_steps_fraction ) /
							f32( c_smoke_trail_particle_max_age );

						drawing_info.billboards.push_back(
							WorldDrawingInfo::Billboard
							{
								.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
								.billboard_index( BillboardConstants::c_id_mind_control_trail ),
								.position= smoke_trail_particle.position,
								 // Mind control smoke trail particles are pretty huge.
								.scale= 2.0f * ust::exp( relative_age ),
								.brightness= 1.0f - relative_age,
							} );
					},
					default -> {},
				}
			} );

		game_state.muzzle_lights.Iterate(
			lambda[&]( MuzzleLight& muzzle_light )
			{
				var Vec3f mut absolute_position= Vec3f::MakeZero();

				if( muzzle_light.owner_entity_index == c_player_entity_index )
				{
					var Mat4f rotation_matrix=
						Mat4f::MakeRotationX( drawing_info.camera_params.elevation ) *
						Mat4f::MakeRotationZ( drawing_info.camera_params.azimuth );

					absolute_position=
						camera_position_without_depth_shift +
						muzzle_light.relative_position * rotation_matrix;
				}
				else
				{
					if( size_type( muzzle_light.owner_entity_index ) < game_state.entities.size() )
					{
						if_var( &entity : game_state.entities[ size_type( muzzle_light.owner_entity_index ) ] )
						{
							var Mat4f rotation_matrix= Mat4f::MakeRotationZ( entity.azimuth );
							absolute_position= entity.position + muzzle_light.relative_position * rotation_matrix;
						}
						else
						{
							return;
						}
					}
					else
					{
						return;
					}
				}

				var f32 fade=
					1.0f - ( f32( muzzle_light.age_steps ) + time_steps_fraction ) / f32( c_muzzle_light_max_age );

				drawing_info.dynamic_light_sources.push_back(
					WorldDrawingInfo::DynamicLightSource
					{
						.position= absolute_position,
						.power= muzzle_light.power * c_light_power_scale * fade,
						.color_index= muzzle_light.color_index,
					} );
			} );

		game_state.projectile_hit_lights.Iterate(
			lambda[&]( ProjectileHitLight& projectile_hit_light )
			{
				var f32 relative_age=
					( f32( projectile_hit_light.age_steps ) + time_steps_fraction ) /
					f32( c_projectile_hit_light_max_age );

				// Make brighter lights last longer, shorten lifetime of dim lights.
				// This behavior is different from the original game - projectile hit lights in it stay longer.
				var f32 power_log= ust::log2( projectile_hit_light.power );
				var f32 age_scaled_to_log_power= relative_age * ust::max( 1.0f, 100.0f / ( power_log * power_log ) );

				var f32 s= ( age_scaled_to_log_power - 0.5f ) * 2.0f;

				var f32 fade= ust::exp( -2.0f * age_scaled_to_log_power ) * ( 1.0f - s * s );

				if( fade > 0.0f )
				{
					var f32 extra_power_scale= 0.35f; // Projectile hit lights are too bright. Scale them a little bit down.

					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position= projectile_hit_light.position,
							.power= projectile_hit_light.power * fade * ( extra_power_scale * c_light_power_scale ),
							.color_index= projectile_hit_light.color_index,
						} );
				}
			} );

		{
			var size_type weapon_tool_index(
				entities_description.tool_type_to_index_map[ size_type( game_state.player.weapon_state.current_weapon ) ] );
			if( weapon_tool_index < entities_description.tools.size() )
			{
				var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];
				if( size_type( tool.animation ) < entities_description.animations.size() )
				{
					var EntitiesDescription::AnimationDescription& animation=
						entities_description.animations[ size_type( tool.animation ) ];

					// Lower the weapon model if performing weapon switching.
					// Also lower some weapons while shooting.
					// TODO - maybe perform lowering rotation around axis at camera position?

					var f32 total_lowering=
						( 1.0f - f32( game_state.player.weapon_state.switching_fraction ) / f32( c_weapon_switching_half_time_steps ) ) +
						game_state.player.weapon_state.extra_lowering;

					var f32 elevation_add= c_tau / 4.0f * total_lowering;

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= animation.model_file_name,
							.position= camera_position_without_depth_shift,
							.azimuth= camera_controller.GetAzimuth(),
							.elevation= camera_controller.GetElevation() + elevation_add,
							.frame= game_state.player.weapon_state.current_animation_step / c_num_steps_per_animation_frame,
							.disable_culling= true,
							.first_person_weapon= true,
							.constant_lighting= false,
						} );
				}
			}
		}

		var ZvoxData& zvox_data= map_data.zvox_data.deref();
		auto clusters= zvox_data.clusters.range();

		foreach( pair : game_state.dynamic_clusters.iter().zip( game_state.dynamic_cluster_colliders.iter() ) )
		{
			var ZvoxCluster& cluster= clusters[ size_type( pair.second.cluster_index ) ];

			var Vec3f translation=
				pair.second.bbox.GetCenter() -
				Vec3f( f32( cluster.c.center[0] ), f32( cluster.c.center[1] ), f32( cluster.c.center[2] ) );

			drawing_info.dynamic_cluster_objects.push_back(
				WorldDrawingInfo::DynamicClusterObject
				{
					.cluster_index= pair.second.cluster_index,
					.translation= translation,
				} );
		}

		// Create billboards for map light sources.
		foreach( &cluster : clusters )
		{
			if( cluster.light_sources_begin >= cluster.light_sources_end )
			{
				continue;
			}

			foreach( &light_source : zvox_data.light_sources.range().subrange(
				size_type( cluster.light_sources_begin ), size_type( cluster.light_sources_end ) ) )
			{
				var u32 billboard_kind = u32( light_source.packed_corona_color_index ) & 7u;

				if( billboard_kind == 0u )
				{
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.position(
								f32( cluster.c.center[0] + light_source.offset[0] ),
								f32( cluster.c.center[1] + light_source.offset[1] ),
								f32( cluster.c.center[2] + light_source.offset[2] ) ),
							.billboard_index( BillboardConstants::c_id_light_corona ),
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCameraWithConstantScreenSize,
						} );
				}
				else if( billboard_kind == 1u )
				{
					// Light with no coronas.
				}
				else if( billboard_kind <= 3u )
				{
					auto [ first_id, count ]=
						( billboard_kind == 2u
							? ust::make_array(
								BillboardConstants::c_id_first_blinking_light_corona,
								BillboardConstants::c_num_blinking_light_coronas )
							: ust::make_array(
								BillboardConstants::c_id_first_static_light_source_flame,
								BillboardConstants::c_num_static_light_source_flames ) );

					var Vec3f position(
						f32( cluster.c.center[0] + light_source.offset[0] ),
						f32( cluster.c.center[1] + light_source.offset[1] ),
						f32( cluster.c.center[2] + light_source.offset[2] ) - 24.0f );

					// Calculate pseudo-random phase so that each light source has its own phase (they aren't in sync).
					var ust::default_hasher mut hasher;
					ust::apply_value_to_hasher( hasher, position );

					var u32 pseudo_random_phase= u32( hasher.get() ) % count;

					var u32 billboard_index=
						first_id +
						( u32( time_steps * ( 16.0f / c_steps_per_second ) ) + pseudo_random_phase ) % count;

					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.position= position,
							.billboard_index( billboard_index ),
							.alignment= WorldDrawingInfo::Billboard::Alignment::ZAxis,
							// Draw flames slightly smaller than unit size.
							.scale= 0.75f,
						} );
				}
			}
		}

		if( settings.g_debug_show_entity_bounding_boxes )
		{
			var [ u8, 3 ] color[ (255), (0), (255) ];

			foreach( &collider : game_state.colliders )
			{
				CreateBBoxLines( collider.bbox, color, drawing_info.test_lines );
			}

			foreach( &collider : game_state.dynamic_cluster_colliders )
			{
				CreateBBoxLines( collider.bbox, color, drawing_info.test_lines );
			}
		}

		if( settings.g_debug_highlight_enemies_seeing_player )
		{
			var [ u8, 3 ] color[ (0), (0), (255) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( entity.player_is_in_sight )
					{
						if( entity.collider_index != ~0u )
						{
							CreateBBoxLines(
								game_state.colliders[ size_type( entity.collider_index ) ].bbox,
								color,
								drawing_info.test_lines );
						}
					}
				}
			}
		}

		if( settings.g_debug_show_entity_target_navigation_graph_nodes )
		{
			auto& navigation_graphs= map_data.mapa_way_data.deref().navigation_graphs;

			var [ u8, 3 ] color[ (240), (120), (255) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( size_type( entity.navigation_info_index ) < navigation_graphs.size() &&
						entity.target_navigation_graph_node != ~0u )
					{
						var MapaWayNavigationGraph& navigation_graph=
							navigation_graphs[ size_type( entity.navigation_info_index ) ];

						{
							var MapaWayNavigationGraphNode& target_node=
								navigation_graph.nodes[ entity.target_navigation_graph_node ];

							var Vec3f target_node_position(
								f32( target_node.position[0] ),
								f32( target_node.position[1] ),
								f32( target_node.position[2] ) );

							CreateBBoxLines(
								BBox3f
								{
									.min= target_node_position + Vec3f( -4.0f, -4.0f, -4.0f ),
									.max= target_node_position + Vec3f(  4.0f,  4.0f,  4.0f ),
								},
								color,
								drawing_info.test_lines );
						}

						if( entity.current_navigation_graph_node < navigation_graph.num_nodes )
						{
							var Vec3f mut previous_position( entity.position.xy(), entity.position.z - 1.0f );

							for( var u32 mut i= 0u, mut node_index= entity.current_navigation_graph_node;
								i < u32( MapaWayNavigationGraph::c_max_nodes ); // Limit this loop in case of buggy routing matrices.
								++i )
							{
								if( node_index == entity.target_navigation_graph_node )
								{
									break;
								}

								var u32 next_node_index(
									navigation_graph.routing_matrix[ node_index ][ entity.target_navigation_graph_node ] );

								if( next_node_index >= navigation_graph.num_nodes )
								{
									break;
								}

								var MapaWayNavigationGraphNode& node= navigation_graph.nodes[ next_node_index ];

								var Vec3f node_position(
									f32( node.position[0] ), f32( node.position[1] ), f32( node.position[2] ) );

								drawing_info.test_lines.push_back(
									WorldDrawingInfo::TestLine
									{
										.vertices[ previous_position, node_position ],
										.color= color,
									} );

								previous_position= node_position;
								node_index= next_node_index;
							}
						}
					}
				}
			}
		}

		if( settings.g_debug_show_quads_hierarchy )
		{
			CreateBoundingBoxesHierarchyLines(
				map_data.collider_quads_hierarchy,
				settings.g_debug_bounding_boxes_hierarchy_level_to_show,
				drawing_info.test_lines );
		}

		if( settings.g_debug_show_room_clusters_hierarchy )
		{
			CreateBoundingBoxesHierarchyLines(
				map_data.room_clusters_hierarchy.deref(),
				settings.g_debug_bounding_boxes_hierarchy_level_to_show,
				drawing_info.test_lines );
		}

		if( settings.g_debug_show_player_position_in_quads_hierarchy )
		{
			CreateLinesForPositionInBoundingBoxesHierarchy(
				map_data.collider_quads_hierarchy, game_state.player.position, drawing_info.test_lines );
		}

		if( game_state.player.tools_state.night_vision_is_active )
		{
			drawing_info.fullscreen_effect= WorldDrawingInfo::FullscreenEffect::NightVision;
		}
		if( game_state.player.tools_state.infrared_vision_is_active )
		{
			drawing_info.fullscreen_effect= WorldDrawingInfo::FullscreenEffect::InfraredVision;
		}
	}

	return drawing_info;
}

fn ConstructHudDrawingInfo( EntitiesDescription& entities_description, GameState& game_state ) : HudDrawingInfo
{
	var HudDrawingInfo mut info
	{
		.health( game_state.player.energy ),
		.armor( game_state.player.armor ),
		.ammo( -1 ), // Set later.
		.weapon_icon_index(0), // Set later.
		.character_icon_index(0), // TODO - draw character icon and score in multiplayer.
		.key_icon_indices[ (0) ... ], // Set later.
		.inventory_tool_icons[ (0) ... ],
		.num_inventory_tool_icons(0),
		.selected_inventory_tool_icon_index(0),
		.active_tools= zero_init, // Set later.
		.num_active_tools(0),
	};

	var size_type weapon_tool_index(
		entities_description.tool_type_to_index_map[ size_type( game_state.player.weapon_state.current_weapon ) ] );
	if( weapon_tool_index < entities_description.tools.size() )
	{
		var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

		info.weapon_icon_index= HudDrawingInfo::IconIndex( tool.icon );

		if( tool.ammo_item >= 0 && size_type( tool.ammo_item ) < entities_description.tools.size() )
		{
			info.ammo= i16( game_state.player.inventory[ size_type( entities_description.tools[ size_type( tool.ammo_item ) ].tool_type ) ] );
		}
	}

	var size_type selected_tool_index(
		entities_description.tool_type_to_index_map[ size_type( game_state.player.tools_state.selected_tool ) ] );

	if( selected_tool_index < entities_description.tools.size() )
	{
		var u32 constexpr num_steps_whole_inventory_is_visible( c_steps_per_second );

		if( game_state.player.tools_state.last_tool_selection_step + num_steps_whole_inventory_is_visible >= game_state.step_index )
		{
			// Show the whole inventory to simplify navigation.

			static_assert(
				typeinfo</ typeof(c_inventory_accessible_tools) />.element_count <=
				typeinfo</ typeof( info.inventory_tool_icons ) />.element_count );

			foreach( tool : c_inventory_accessible_tools )
			{
				if( game_state.player.inventory[ size_type(tool) ] > 0u )
				{
					var size_type tool_index( entities_description.tool_type_to_index_map[ size_type( tool ) ] );
					if( tool_index < entities_description.tools.size() )
					{
						if( tool_index == selected_tool_index )
						{
							info.selected_inventory_tool_icon_index= info.num_inventory_tool_icons;
						}

						info.inventory_tool_icons[ info.num_inventory_tool_icons ]= u8( entities_description.tools[ tool_index ].icon );
						++info.num_inventory_tool_icons;
					}
				}
			}
		}
		else
		{
			// Show only single selected tool.

			info.num_inventory_tool_icons= 1u8;
			info.inventory_tool_icons[0]= u8( entities_description.tools[ selected_tool_index ].icon );
			info.selected_inventory_tool_icon_index= 0u8;
		}
	}

	{
		auto add_active_tool_icon=
			lambda[&]( EntitiesDescription::ToolType tool_type )
			{
				var size_type tool_index(
					entities_description.tool_type_to_index_map[ size_type( tool_type ) ] );

				if( tool_index < entities_description.tools.size() &&
					size_type( info.num_active_tools ) < typeinfo</ typeof( info.active_tools ) />.element_count )
				{
					info.active_tools[ info.num_active_tools ]=
						HudDrawingInfo::ActiveTool
						{
							.icon_index( entities_description.tools[ tool_index ].icon ),
							.amount( game_state.player.inventory[ size_type( tool_type) ] ),
						};
					++info.num_active_tools;
				}
			};

		if( game_state.player.tools_state.acid_protection_suit_is_active )
		{
			add_active_tool_icon( EntitiesDescription::ToolType::AcidProtectionSuit );
		}

		if( game_state.player.tools_state.night_vision_is_active )
		{
			add_active_tool_icon( EntitiesDescription::ToolType::NightVision );
		}

		if( game_state.player.tools_state.infrared_vision_is_active )
		{
			add_active_tool_icon( EntitiesDescription::ToolType::InfraredVision );
		}
	}

	var [ EntitiesDescription::ToolType, 3 ] keys
	[
		EntitiesDescription::ToolType::KeyA,
		EntitiesDescription::ToolType::KeyB,
		EntitiesDescription::ToolType::KeyC,
	];

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var size_type key( keys[i] );
		if( game_state.player.inventory[ key ] > 0u )
		{
			var size_type key_tool_index( entities_description.tool_type_to_index_map[ key ] );
			if( key_tool_index < entities_description.tools.size() )
			{
				info.key_icon_indices[i]=
					HudDrawingInfo::IconIndex( entities_description.tools[ key_tool_index ].icon );
			}
		}
	}

	return info;
}

fn ConstructGameEventNotificationsDrawingInfo( GameState& game_state ) :GameEventNotificationsDrawingInfo
{
	type EN= GameEventNotificationsDrawingInfo::EventNotification;

	var GameEventNotificationsDrawingInfo mut info
	{
		.event_notification= EN::None,
	};

	var u32 c_key_requirement_notification_duration( c_steps_per_second * 2.0f );
	var u32 c_secret_area_notification_duration( c_steps_per_second * 4.0f );

	if( game_state.player.last_key_request_step + c_key_requirement_notification_duration >= game_state.step_index )
	{
		switch( game_state.player.last_requested_key_type )
		{
			EntitiesDescription::ToolType::KeyA -> { info.event_notification= EN::KeyARequired; },
			EntitiesDescription::ToolType::KeyB -> { info.event_notification= EN::KeyBRequired; },
			EntitiesDescription::ToolType::KeyC -> { info.event_notification= EN::KeyCRequired; },
			default -> {},
		}
	}

	// Keep it last - it should have priority over key required notifications, since it can't be repeated.
	if( game_state.player.opened_secrets_mask != 0u &&
		game_state.player.last_opened_secret_area_step + c_secret_area_notification_duration >= game_state.step_index )
	{
		info.event_notification= EN::SecretAreaFound;
	}

	return info;
}

fn ConstructCrosshairDrawingInfo(
	CameraController& camera_controller,
	ust::optional_ref_imut</GameMapData/> map_data_opt,
	ust::optional_ref_imut</GameState/> game_state_opt ) : CrosshairDrawingInfo
{
	var CrosshairDrawingInfo mut drawing_info
	{
		.camera_position= Vec3f::MakeZero(),
		.camera_azimuth= camera_controller.GetAzimuth(),
		.camera_elevation= camera_controller.GetElevation(),
		.camera_fov= camera_controller.GetFOV(),
		.hit_point= Vec3f::MakeZero(),
		.hit_point_kind= CrosshairDrawingInfo::HitPointKind::None,
	};

	if( !map_data_opt.empty() && !game_state_opt.empty() )
	{
		var GameMapData& map_data= map_data_opt.try_deref();
		var GameState& game_state= game_state_opt.try_deref();

		if( game_state.player.energy > 0u ) // Display crosshair only if the player is alive.
		{
			drawing_info.camera_position=
				GetCameraPositionForPlayerWithExtraDepthShift( game_state.player, camera_controller );

			auto [ position, kind ]=
				GetCrosshairPositionAndKind( map_data, game_state, drawing_info.camera_azimuth, drawing_info.camera_elevation );

			drawing_info.hit_point= position;
			drawing_info.hit_point_kind= kind;
		}
	}

	return drawing_info;
}

fn GetCameraPositionForPlayer( PlayerState& player_state ) : Vec3f
{
	var f32 crouching_z_offset= player_state.crouching_phase * c_crouching_height_delta;
	return Vec3f( player_state.position.xy(), player_state.position.z + c_camera_z_offset + crouching_z_offset );
}

fn GetCameraDepthShift( CameraController& camera_controller ) : Vec3f
{
	var Mat4f camera_rotation_matrix=
		Mat4f::MakeRotationX( camera_controller.GetElevation() ) *
		Mat4f::MakeRotationZ( camera_controller.GetAzimuth() );

	// The original game moves camera slightly backwards. Do exactly this.
	// This constant was fine-tuned to match position of the first-person weapon almost pixel to pixel compared to the original game.
	var f32 c_camera_depth_offset= -8.0f;

	return Vec3f( 0.0f, c_camera_depth_offset, 0.0f ) * camera_rotation_matrix;
}

fn GetCameraPositionForPlayerWithExtraDepthShift( PlayerState& player_state, CameraController& camera_controller ) : Vec3f
{
	return GetCameraPositionForPlayer( player_state ) + GetCameraDepthShift( camera_controller );
}

var u32 constexpr c_flame_color_index= 4u;

var f32 constexpr c_light_power_scale= 256.0f;

} // namespace PM
