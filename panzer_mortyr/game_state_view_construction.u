import "/scoped_array.iu"
import "/common_lib/billboards_description_file.iu"
import "bounding_boxes_hierarchy_debug_visualization.iu"
import "game_constants.iu"
import "game_logic.iu"
import "game_state_view_construction.iu"
import "geometry_utils.iu"
import "global_navigation_graph_debug_visualization.iu"
import "mat.iu"

namespace PM
{

fn ConstructWorldDrawingInfo(
	Settings& settings,
	f32 time_steps_fraction,
	CameraController& camera_controller,
	ust::optional_ref_imut</GameMapData/> map_data_opt,
	ust::optional_ref_imut</GameStateExtended/> game_state_opt ) : WorldDrawingInfo
{
	/*
		This function builds aworld drawing info for given extended game state.
		It also performs extrapolation/mixing for positions and angles of various game objects.

		Game logic update in the original game runs in fixed steps, 30 times in a second or so.
		PanzerMortyr does this too.
		But displays usually have refresh rate 60Hz or higher and we need to provide some state in-between for smooth look and feel.
		So, game state is predicted one step into the future in order to do this.
		Positions and angles are mixed between the current game state and a predicted next state.
		But such mixing is not enough, since prediction can be sometimes wrong and thus some error-correction is needed.
		Because of that actual mixing starts not from the current game state, but from a predicted state calculated previously for the current game logic step.

		For camera angles no predicition/mixing is needed, since camera angles are updated independently on game logic.

		For player's position nothing special is required - his predicted state and next predicted state can be used for mixing as is.

		For dynamic clusters mixing is pretty straigtforward too, since no new dynamic cluster objects can be added and old ones can't be removed.

		For entities it's more complex.
		Mixing into the predicted state is possible only if this entity still exists in the future.
		Mixing from the state predictted on previous step for the current step is done only if this entity is present in the predicted state and was present in the previous state.
		The latter is important to make sure mixing on step N+1 always starts where mixing on step N ended.

		For game objects with limited lifetime we need a way to determine their identity between different states.
		It's done by using slot index + generation index provided by the game things container.
		Objects in two states are identical if their index and generation index are identical and if this object is present in their last common state.
	*/

	var WorldDrawingInfo mut drawing_info
	{
		.game_time_s= 0.0f, // Set later.
		.map_index= 0u,
		.camera_params
		{
			.position= Vec3f::MakeZero(),
			.azimuth= camera_controller.GetAzimuth(),
			.elevation= camera_controller.GetElevation(),
			.fov_x= camera_controller.GetFOV(),
		},
		.fullscreen_effect= WorldDrawingInfo::FullscreenEffect::None,
		.broken_quad_bits( 0s ), // Set later.
		.fullscreen_blend_color= zero_init, // Set later if necessary.
	};

	if( !map_data_opt.empty() && !game_state_opt.empty() )
	{
		var GameMapData& map_data= map_data_opt.try_deref();

		var GameStateExtended& game_state_extended= game_state_opt.try_deref();

		var ust::optional_ref_imut</GameState/> previous_game_state_opt= game_state_extended.previous.as_ref();

		var GameState& game_state= game_state_extended.current;

		var ust::optional_ref_imut</GameState/> next_predicted_game_state_opt=
			game_state_extended.next_predicted.as_ref();

		var ust::optional_ref_imut</GameState/> current_predicted_game_state_opt=
			game_state_extended.current_predicted.as_ref();

		// It's not a big deal to copy this list, in the wors case it has maximum 40-50 elements.
		drawing_info.used_models= map_data.used_models;

		drawing_info.map_index= map_data.map_index;

		var f32 total_game_time_steps= f32( game_state.step_index ) + time_steps_fraction;
		drawing_info.game_time_s= total_game_time_steps / c_steps_per_second;

		// Copy bit array of broken quads.
		// It may be a little bit slow, since some maps have a lot of quads.
		drawing_info.broken_quad_bits= game_state.broken_quad_bits;

		var Vec3f mut camera_position_without_depth_shift= GetCameraPositionForPlayer( game_state.player );

		if_var( &current_predicted_game_state : current_predicted_game_state_opt )
		{
			camera_position_without_depth_shift= GetCameraPositionForPlayer( current_predicted_game_state.player );
		}

		if_var( &next_predicted_game_state : next_predicted_game_state_opt )
		{
			camera_position_without_depth_shift=
				MixPosition(
					camera_position_without_depth_shift,
					GetCameraPositionForPlayer( next_predicted_game_state.player ),
					time_steps_fraction );
		}

		drawing_info.camera_params.position=
			camera_position_without_depth_shift + GetCameraDepthShift( camera_controller );

		auto get_entity_position_and_azimuth=
			lambda[&]( size_type i ) : ust::optional</ tup[ Vec3f, f32 ] />
			{
				auto& entity_opt= game_state.entities[i];
				if( entity_opt.empty() )
				{
					return ust::null_optional;
				}

				var EntityState& entity= entity_opt.try_deref();

				var Vec3f mut position= entity.position;
				var f32 mut azimuth= entity.azimuth;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( i < previous_game_state.entities.size() && !previous_game_state.entities[i].empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if( i < current_predicted_game_state.entities.size() )
							{
								if_var( &current_predicted_entity : current_predicted_game_state.entities[i] )
								{
									position= current_predicted_entity.position;
									azimuth= current_predicted_entity.azimuth;
								}
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if( i < next_predicted_game_state.entities.size() )
					{
						if_var( &predicted_entity : next_predicted_game_state.entities[i] )
						{
							position= MixPosition( position, predicted_entity.position, time_steps_fraction );
							azimuth= MixAngle( azimuth, predicted_entity.azimuth, time_steps_fraction );
						}
					}
				}

				return ust::make_tuple( position, azimuth );
			};

		auto get_dynamic_cluster_center=
			lambda[&]( size_type i ) : Vec3f
			{
				var Vec3f mut center= game_state.dynamic_cluster_colliders[i].bbox.GetCenter();

				if_var( &current_predicted_game_state : current_predicted_game_state_opt )
				{
					center= current_predicted_game_state.dynamic_cluster_colliders[i].bbox.GetCenter();
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					center=
						MixPosition(
							center,
							next_predicted_game_state.dynamic_cluster_colliders[i].bbox.GetCenter(),
							time_steps_fraction );
				}

				return center;
			};

		// Count how many damaging flames are attached to each entity.
		scoped_array u8 mut num_entity_damaging_flames[ game_state.entities.size() ] ( 0u8 );
		var u32 mut num_player_damaging_flames= 0u;
		game_state.damaging_flames.Iterate(
			lambda[&]( DamagingFlame& damaging_flame )
			{
				var size_type index( damaging_flame.entity_index );
				if( index < num_entity_damaging_flames.size() )
				{
					++num_entity_damaging_flames[index];
				}
				else if( damaging_flame.entity_index == c_player_entity_index )
				{
					++num_player_damaging_flames;
				}
			} );

		var EntitiesDescription& entities_description= map_data.entities_description.deref();

		for( auto mut i= 0s; i < game_state.entities.size(); ++i )
		{
			auto& entity_opt= game_state.entities[i];

			if( entity_opt.empty() )
			{
				continue;
			}

			var EntityState& entity= entity_opt.try_deref();

			auto mut position_azimuth_opt= get_entity_position_and_azimuth(i);
			if( position_azimuth_opt.empty() )
			{
				continue;
			}

			auto [ entity_position, entity_azimuth ]= position_azimuth_opt.try_take();

			var EntitiesDescription::EntityDescription& entity_description= entities_description.entities[ size_type( entity.kind ) ];

			if( size_type( entity.current_operation ) >= entity_description.operations.size() )
			{
				continue;
			}

			var EntitiesDescription::Operation& operation= entity_description.operations[ size_type( entity.current_operation ) ];

			if_var( &explosion_light : operation.explosion_light )
			{
				if( i32( entity.num_steps_since_operation_start ) >= explosion_light.params[0] &&
					i32( entity.num_steps_since_operation_start ) < explosion_light.params[1] )
				{
					// Investigations have shown, that light power of this effect is always the same and can't be changed.
					var f32 light_power= 75.0f;

					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position( entity_position.xy(), entity_position.z + f32( explosion_light.params[4] ) ),
							.power= light_power * c_light_power_scale,
							.color_index( explosion_light.params[3] ),
						} );
				}
			}

			if_var( &light : operation.light )
			{
				if( entity.num_steps_since_operation_start >= light.time &&
					entity.num_steps_since_operation_start < light.time + light.delta )
				{
					var f32 fade=
						( f32( light.time + light.delta - entity.num_steps_since_operation_start ) - f32( time_steps_fraction ) ) /
						f32( light.delta );

					var Vec3f offset_transformed=
						Vec3f( f32( light.offset_x ), f32( light.offset_y ), f32( light.offset_z ) ) *
						Mat4f::MakeRotationZ( entity_azimuth );

					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position= entity_position + offset_transformed,
							.power= f32(light.power) * fade * c_light_power_scale,
							.color_index( light.color ),
						} );
				}
			}

			var f32 mut burning_strength= 0.0f;

			var u8 num_damaging_flames= num_entity_damaging_flames[i];

			if( num_damaging_flames > 0u8 )
			{
				// PanzerMortyr addition - add lights for burning entities.

				// Calculate phase based on navigation info index (which is unique for enemy entities),
				// so that different burning enemies have different phase.
				var f32 modulation_phase= total_game_time_steps + f32( entity.navigation_info_index & 0xFFu );

				var f32 light_modulation= CalculatePsedudoRandomFireLightSourceModulation( modulation_phase );

				drawing_info.dynamic_light_sources.push_back(
					WorldDrawingInfo::DynamicLightSource
					{
						.position=
							entity_position +
							Vec3f(
								f32( operation.animation.bounding_box_center_x ),
								f32( operation.animation.bounding_box_center_y ),
								f32( operation.animation.bounding_box_center_z ) ),
						.power=
							// Increase power depending on number of flames, but limit it.
							f32( ust::min( num_damaging_flames, 3u8 ) ) *
							light_modulation *
							( c_burning_entities_flame_power * c_light_power_scale ),
						.color_index= c_flame_color_index,
					} );

				// Use full burning power with 4 or more damaging flames.
				burning_strength= ust::min( light_modulation * f32( num_damaging_flames ) / 4.0f, 1.0f );
			}

			if( operation.animation.num_steps > 0u )
			{
				var size_type a( operation.animation.animation_number );
				if( a < entities_description.animations.size() )
				{
					var EntitiesDescription::AnimationDescription& animation= entities_description.animations[a];

					var bool is_sky_decoration=
						operation.animation_kind == EntitiesDescription::Operation::AnimationKind::Landscape;

					// Only entities with "podatn" flag and having "sternik" can be covered with blood.
					var u8 mut blood_coverage= 0u8;
					if( settings.g_blood_enabled && entity_description.susceptible != 0u )
					{
						var bool mut has_operation_control= false;

						foreach( &operation : entity_description.operations )
						{
							if( !operation.operation_control.empty() )
							{
								has_operation_control= true;
								break;
							}
						}

						if( has_operation_control && entity.energy < entity_description.energy )
						{
							// Entities are covered with blood if their energy is below initial value.
							// Entities with half or less energy than the initial value are covered with more blood.
							blood_coverage= ( entity.energy * 2u <= entity_description.energy ? 2u8 : 1u8 );
						}
					}

					var f32 mut elevation_angle= 0.0f;

					if( operation.animation_kind == EntitiesDescription::Operation::AnimationKind::Barrel )
					{
						// Apply here some basic rolling animation for barrels.
						// Just calculate absolute distance along facing direction
						// and calculate angle based on this direction and rolling radius.
						// This works pretty fine as long as this facing direction isn't changed,
						// which is the case for lying barrels in the original game.

						var Vec2f facing_direction( -ust::sin(entity_azimuth), ust::cos(entity_azimuth) );
						var f32 distance_along_facing_direction= facing_direction.Dot( entity_position.xy() );

						var f32 radius(
							ust::min(
								operation.animation.bounding_box_half_size_y,
								operation.animation.bounding_box_half_size_z ) );
						elevation_angle= distance_along_facing_direction / ust::max( radius, 1.0f );
					}

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= animation.model_file_name,
							.position= entity_position,
							.azimuth= entity_azimuth,
							.elevation= elevation_angle,
							// TODO - perform smooth animation.
							.frames
							{
								.frame0= entity.animation_frame,
								.frame1= entity.animation_frame,
								.frame_mix= 0.5f,
							},
							// If it's a sky decoration - disable culling.
							// It should be always visible, even if such decoration is located somewhere outside map bounds.
							.disable_culling= is_sky_decoration,
							.first_person_weapon= false,
							// Use constant lighting for sky decorations.
							.constant_lighting= is_sky_decoration,
							.burning_strength= burning_strength,
							.blood_coverage= blood_coverage,
						} );
				}
			}

			if( operation.directional_animation.num_steps > 0u )
			{
				var size_type a( operation.directional_animation.animation_number );
				if( a < entities_description.animations.size() )
				{
					var EntitiesDescription::AnimationDescription& animation= entities_description.animations[a];

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= animation.model_file_name,
							.position= entity_position,
							.azimuth= Convert1024Angle( f32( operation.directional_animation.direction ) ),
							.elevation= 0.0f,
							// TODO - perform smooth animation.
							.frames
							{
								.frame0= entity.directional_animation_frame,
								.frame1= entity.directional_animation_frame,
								.frame_mix= 0.5f,
							},
							.disable_culling= false,
							.first_person_weapon= false,
							.constant_lighting= false,
							.burning_strength= burning_strength,
						} );
				}
			}

			if( operation.animation_kind == EntitiesDescription::Operation::AnimationKind::Insect )
			{
				// TODO - draw flies.
			}
		}

		game_state.projectiles.IterateWithIndexAndGenerationIndex(
			lambda[&]( Projectile& projectile, u32 index, u32 generation_index )
			{
				var Vec3f mut projectile_position= projectile.position;
				var Vec3f mut projectile_velocity= projectile.velocity;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( !previous_game_state.projectiles.GetByIndex( index, generation_index ).empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if_var( &current_predicted_projectile :
								current_predicted_game_state.projectiles.GetByIndex( index, generation_index ) )
							{
								projectile_position= current_predicted_projectile.position;
								projectile_velocity= current_predicted_projectile.velocity;
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if_var( &predicted_projectile : next_predicted_game_state.projectiles.GetByIndex( index, generation_index ) )
					{
						projectile_position=
							MixPosition( projectile_position, predicted_projectile.position, time_steps_fraction );
						projectile_velocity=
							MixVelocity( projectile_velocity, predicted_projectile.velocity, time_steps_fraction );
					}
				}

				var EntitiesDescription::Tool& weapon_tool=
					entities_description.tools[ size_type( projectile.weapon_tool_index ) ];

				if( weapon_tool.projectile_model >= EntitiesDescription::Tool::c_projectile_model_first_mesh_model )
				{
					// Projectiles for this weapon are drawn via a model.
					var size_type animation_index(
						weapon_tool.projectile_model - EntitiesDescription::Tool::c_projectile_model_first_mesh_model );
					if( animation_index < entities_description.animations.size() )
					{
						var EntitiesDescription::AnimationDescription& animation= entities_description.animations[ animation_index ];

						// Calculate orientation based on velocity vector.
						// It isn't ideal, but fine enough.
						var f32 mut azimuth= 0.0f;
						var f32 mut elevation= 0.0f;
						var f32 velocity_xy_square_length= projectile_velocity.xy().SquareLength();
						if( velocity_xy_square_length > 0.0f )
						{
							 azimuth= -ust::atan2( projectile_velocity.x, projectile_velocity.y );
							 elevation= ust::atan2( projectile_velocity.z, ust::sqrt( velocity_xy_square_length ) );
						}
						else
						{
							elevation= ( projectile_velocity.z > 0.0f ? c_tau * 0.25f : -c_tau * 0.25f );
						}

						drawing_info.model_objects.push_back(
							WorldDrawingInfo::ModelObject
							{
								.model_file_name= animation.model_file_name,
								.position= projectile_position,
								.azimuth= azimuth,
								.elevation= elevation,
								// Projectiles have single animation frame.
								.frames{ .frame0= 0u, .frame1= 0u, .frame_mix= 0.5f },
								// Disable culling for projectiles - allow drawing them in skies.
								.disable_culling= true,
								.first_person_weapon= false,
								.constant_lighting= false,
							} );
					}
				}
				else if(
					weapon_tool.projectile_model >= 0 &&
					weapon_tool.projectile_model < i32( typeinfo</ typeof( BillboardConstants::c_shot_ids ) />.element_count ) )
				{
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCustomAxis,
							.position= projectile_position,
							// Make projectiles slighly bigger than unit scale, since otherwise they are barely visible.
							.scale= 2.0f,
							.custom_axis= projectile_velocity,
							.billboard_index( BillboardConstants::c_shot_ids[ size_type( weapon_tool.projectile_model ) ] ),
						} );
				}

				if( weapon_tool.projectile_light[1] > 0u )
				{
					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position= projectile_position,
							.power= f32( weapon_tool.projectile_light[1] ) * c_light_power_scale,
							.color_index= weapon_tool.projectile_light[0],
						} );
				}
			} );

		game_state.projectile_hit_smoke_particles.IterateWithIndexAndGenerationIndex(
			lambda[&]( ProjectileHitSmokeParticle& smoke_particle, u32 index, u32 generation_index )
			{
				var Vec3f mut smoke_particle_position= smoke_particle.position;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( !previous_game_state.projectile_hit_smoke_particles.GetByIndex( index, generation_index ).empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if_var( &current_predicted_smoke_particle :
									current_predicted_game_state.projectile_hit_smoke_particles.GetByIndex(
										index, generation_index ) )
							{
								smoke_particle_position= current_predicted_smoke_particle.position;
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if_var( &predicted_smoke_particle :
							next_predicted_game_state.projectile_hit_smoke_particles.GetByIndex( index, generation_index ) )
					{
						smoke_particle_position=
							MixPosition( smoke_particle_position, predicted_smoke_particle.position, time_steps_fraction );
					}
				}

				var f32 relative_age=
					( f32( smoke_particle.age_steps ) + time_steps_fraction ) / f32( c_projectile_hit_smoke_particle_max_age );

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
						.billboard_index( BillboardConstants::c_id_projectile_hit_smoke ),
						.position= smoke_particle_position,
						.brightness= 0.3f * ( 1.0f - relative_age ),
						.scale= 0.5f * ust::exp( relative_age * 2.0f ),
					} );
			} );

		game_state.breaking_glass_effects.Iterate(
			lambda[&]( BreakingGlassEffect& breaking_glass_effect )
			{
				drawing_info.breaking_glass_effects.push_back(
					WorldDrawingInfo::BreakingGlass
					{
						.hit_position= breaking_glass_effect.hit_position,
						.cluster_index= breaking_glass_effect.cluster_index,
						.quad_index= breaking_glass_effect.quad_index,
						.age= ( f32( breaking_glass_effect.age_steps ) + time_steps_fraction ) / f32( c_breaking_glass_max_age ),
					} );
			} );

		game_state.muzzle_flashes.Iterate(
			lambda[
				&game_state,
				&drawing_info,
				&camera_position_without_depth_shift,
				get_entity_position_and_azimuth, // Capture a copy, since it has many references inside.
				time_steps_fraction ]( MuzzleFlash& muzzle_flash )
			{
				var Vec3f mut absolute_position= Vec3f::MakeZero();
				var Vec3f mut custom_axis= Vec3f::MakeZero();

				var u32 c_first_axis_aligned_shot= 19u;
				var bool is_axis_aligned_shot= muzzle_flash.model >= c_first_axis_aligned_shot;

				if( muzzle_flash.owner_entity_index == c_player_entity_index )
				{
					var Mat4f rotation_matrix=
						Mat4f::MakeRotationX( drawing_info.camera_params.elevation ) *
						Mat4f::MakeRotationZ( drawing_info.camera_params.azimuth );

					// HACK! Add extra shift to match how muzzle flashes look like in the original game.
					// TODO - try removing it by tweaking code calculating billboard position?
					var Vec3f extra_shift( 0.0f, ( is_axis_aligned_shot ? 24.0f : 0.0f ), 0.0f );

					absolute_position=
						camera_position_without_depth_shift +
						( muzzle_flash.relative_position + extra_shift ) * rotation_matrix;

					custom_axis= Vec3f( 0.0f, 1.0f, 0.0f ) * rotation_matrix;
				}
				else
				{
					if( size_type( muzzle_flash.owner_entity_index ) < game_state.entities.size() )
					{
						if_var( position_azimuth : get_entity_position_and_azimuth( size_type( muzzle_flash.owner_entity_index ) ) )
						{
							var Mat4f rotation_matrix= Mat4f::MakeRotationZ( position_azimuth[1] );

							absolute_position= position_azimuth[0] + muzzle_flash.relative_position * rotation_matrix;
							custom_axis= Vec3f( 0.0f, 1.0f, 0.0f ) * rotation_matrix;
						}
						else
						{
							return;
						}
					}
					else
					{
						return;
					}
				}

				if( size_type( muzzle_flash.model ) < typeinfo</ typeof( BillboardConstants::c_shot_ids ) />.element_count )
				{
					var u32 billboard_id= BillboardConstants::c_shot_ids[ muzzle_flash.model ];

					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment=
								( is_axis_aligned_shot
									? WorldDrawingInfo::Billboard::Alignment::ToCustomAxis
									: WorldDrawingInfo::Billboard::Alignment:: ToCamera ),
							.billboard_index( billboard_id ),
							.position= absolute_position,
							.custom_axis= custom_axis,
							// Reduce brightness with time.
							.brightness= 1.0f - ( f32( ust::max( 1u, muzzle_flash.age_steps ) - 1u ) + time_steps_fraction ) / f32( c_muzzle_flash_max_age ),
							 // Make axis-aligned muzzle flashes slightly bigger. They are way to small.
							.scale= ( is_axis_aligned_shot ? 6.0f : 1.0f ),
						} );
				}
			} );

		game_state.spark_particles.IterateWithIndexAndGenerationIndex(
			lambda[&]( SparkParticle& spark_particle, u32 index, u32 generation_index  )
			{
				var Vec3f mut spark_particle_position= spark_particle.position;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( !previous_game_state.spark_particles.GetByIndex( index, generation_index ).empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if_var( &current_predicted_spark_particle :
									current_predicted_game_state.spark_particles.GetByIndex( index, generation_index ) )
							{
								spark_particle_position= current_predicted_spark_particle.position;
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if_var( &predicted_spark_particle :
							next_predicted_game_state.spark_particles.GetByIndex( index, generation_index ) )
					{
						spark_particle_position=
							MixPosition( spark_particle_position, predicted_spark_particle.position, time_steps_fraction );
					}
				}

				var f32 relative_age=
					( f32( spark_particle.age_steps ) + time_steps_fraction ) / f32( c_spark_particle_max_age );

				var f32 brightness_scale= 0.7f; // Since we use incorrect billboard for sparks, make it a little bit darker.
				var f32 brightness= brightness_scale * ( 1.0f - relative_age ); // make sparkles darker with time

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
						.billboard_index( BillboardConstants::c_id_spark ),
						.position= spark_particle_position,
						.brightness= brightness,
					} );
			} );

		game_state.explosion_particles.Iterate(
			lambda[&]( ExplosionParticle& explosion_particle )
			{
				// No position extrapolation is needed for explosion particles - they don't move.

				auto [ first_id, count ] =
					( explosion_particle.large
						? ust::make_array( BillboardConstants::c_id_first_explosion4, BillboardConstants::c_num_explosions4 )
						: ust::make_array( BillboardConstants::c_id_first_explosion1, BillboardConstants::c_num_explosions1 ) );

				var u32 phase= explosion_particle.age_steps / c_animated_billboards_frequency_divisor;
				if( phase < count )
				{
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
							.billboard_index( first_id + phase ),
							.position= explosion_particle.position,
						} );
				}
			} );

		game_state.flame_particles.IterateWithIndexAndGenerationIndex(
			lambda[&]( FlameParticle& flame_particle, u32 index, u32 generation_index )
			{
				var Vec3f mut flame_particle_position= flame_particle.position;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( !previous_game_state.flame_particles.GetByIndex( index, generation_index ).empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if_var( &current_predicted_flame_particle :
									current_predicted_game_state.flame_particles.GetByIndex( index, generation_index ) )
							{
								flame_particle_position= current_predicted_flame_particle.position;
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if_var( &predicted_flame_particle :
							next_predicted_game_state.flame_particles.GetByIndex( index, generation_index ) )
					{
						flame_particle_position=
							MixPosition( flame_particle_position, predicted_flame_particle.position, time_steps_fraction );
					}
				}

				var u32 phase=
					flame_particle.age_steps / c_animated_billboards_frequency_divisor % BillboardConstants::c_num_flames;

				// At the end of their lifetime make flames darker and smaller.
				var f32 relative_age=
					( f32( flame_particle.age_steps ) + time_steps_fraction ) / f32( c_flame_particle_max_age );
				var f32 fade_phase= ust::min( ( 1.0f - relative_age ) * 5.0f, 1.0f );

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ZAxis,
						.billboard_index( BillboardConstants::c_id_first_flame + phase ),
						// Slighly move flame billboards up, so that flame center is at billboard bottom.
						.position( flame_particle_position.xy(), flame_particle_position.z - 24.0f * fade_phase ),
						.brightness= fade_phase,
						.scale= fade_phase,
					} );

				// PanzerMortyr addition - add dynamic lights for flames.
				// TODO - maybe limit their count? There can be a lot of flames.
				var f32 constexpr flame_light_power= 1.5f;

				// Calculate phase based on position, so that different flames have different phase.
				var f32 modulation_phase= total_game_time_steps + flame_particle_position.Dot( Vec3f( 1.0f, 1.3f, 0.87f ) );

				var f32 light_modulation= CalculatePsedudoRandomFireLightSourceModulation( modulation_phase );

				drawing_info.dynamic_light_sources.push_back(
					WorldDrawingInfo::DynamicLightSource
					{
						.position= flame_particle_position,
						.power= flame_light_power * c_light_power_scale * fade_phase * light_modulation,
						.color_index= c_flame_color_index,
					} );
			} );

		game_state.smoke_particles.IterateWithIndexAndGenerationIndex(
			lambda[&]( SmokeParticle& smoke_particle, u32 index, u32 generation_index )
			{
				var Vec3f mut smoke_particle_position= smoke_particle.position;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( !previous_game_state.smoke_particles.GetByIndex( index, generation_index ).empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if_var( &current_predicted_smoke_particle :
									current_predicted_game_state.smoke_particles.GetByIndex( index, generation_index ) )
							{
								smoke_particle_position= current_predicted_smoke_particle.position;
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if_var( &predicted_smoke_particle :
							next_predicted_game_state.smoke_particles.GetByIndex( index, generation_index ) )
					{
						smoke_particle_position=
							MixPosition( smoke_particle_position, predicted_smoke_particle.position, time_steps_fraction );
					}
				}

				var f32 relative_age=
					( f32( smoke_particle.age_steps ) + time_steps_fraction ) / f32( c_smoke_particle_max_age );

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
						.billboard_index(
							( smoke_particle.smoke_model == 1u
								? BillboardConstants::c_id_smoke_black
								: BillboardConstants::c_id_smoke_white ) ),
						.position= smoke_particle_position,
						.scale= ust::exp( relative_age ),
						.brightness= 1.0f - relative_age,
					} );
			} );

		game_state.smoke_trail_particles.IterateWithIndexAndGenerationIndex(
			lambda[&]( SmokeTrailParticle& smoke_trail_particle, u32 index, u32 generation_index )
			{
				var Vec3f mut smoke_trail_particle_position= smoke_trail_particle.position;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( !previous_game_state.smoke_trail_particles.GetByIndex( index, generation_index ).empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if_var( &current_predicted_smoke_trail_particle :
									current_predicted_game_state.smoke_trail_particles.GetByIndex( index, generation_index ) )
							{
								smoke_trail_particle_position= current_predicted_smoke_trail_particle.position;
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if_var( &predicted_smoke_trail_particle :
							next_predicted_game_state.smoke_trail_particles.GetByIndex( index, generation_index ) )
					{
						smoke_trail_particle_position=
							MixPosition( smoke_trail_particle_position, predicted_smoke_trail_particle.position, time_steps_fraction );
					}
				}

				switch( smoke_trail_particle.kind )
				{
					EntitiesDescription::Tool::c_smoke_trail_kind_rocket ->
					{
						var f32 relative_age=
							( f32( smoke_trail_particle.age_steps ) + time_steps_fraction ) /
							f32( c_smoke_trail_particle_max_age );

						var u32 billboard=
							BillboardConstants::c_id_first_rocket_smoke_trail_particle +
							smoke_trail_particle.age_steps / c_animated_billboards_frequency_divisor % BillboardConstants::c_num_rocket_smoke_trail_particles;

						drawing_info.billboards.push_back(
							WorldDrawingInfo::Billboard
							{
								.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
								.billboard_index( billboard ),
								.position= smoke_trail_particle_position,
								.scale= ust::exp( relative_age ),
								.brightness= 1.0f - relative_age,
							} );
					},
					EntitiesDescription::Tool::c_smoke_trail_kind_flamethrower ->
					{
						var u32 phase= smoke_trail_particle.age_steps / c_animated_billboards_frequency_divisor;
						if( phase < BillboardConstants::c_num_explosions5 )
						{
							drawing_info.billboards.push_back(
								WorldDrawingInfo::Billboard
								{
									.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
									.billboard_index( BillboardConstants::c_id_first_explosion5 + phase ),
									.position= smoke_trail_particle_position,
								} );
						}
					},
					EntitiesDescription::Tool::c_smoke_trail_kind_mind_control ->
					{
						var f32 relative_age=
							( f32( smoke_trail_particle.age_steps ) + time_steps_fraction ) /
							f32( c_smoke_trail_particle_max_age );

						drawing_info.billboards.push_back(
							WorldDrawingInfo::Billboard
							{
								.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
								.billboard_index( BillboardConstants::c_id_mind_control_trail ),
								.position= smoke_trail_particle_position,
								 // Mind control smoke trail particles are pretty huge.
								.scale= 2.0f * ust::exp( relative_age ),
								.brightness= 1.0f - relative_age,
							} );
					},
					default -> {},
				}
			} );

		game_state.bubbles.IterateWithIndexAndGenerationIndex(
			lambda[&]( Bubble& bubble, u32 index, u32 generation_index )
			{
				var Vec3f mut bubble_position= bubble.position;

				if_var( &previous_game_state : previous_game_state_opt )
				{
					if( !previous_game_state.bubbles.GetByIndex( index, generation_index ).empty() )
					{
						if_var( &current_predicted_game_state : current_predicted_game_state_opt )
						{
							if_var( &current_predicted_bubble :
									current_predicted_game_state.bubbles.GetByIndex( index, generation_index ) )
							{
								bubble_position= current_predicted_bubble.position;
							}
						}
					}
				}

				if_var( &next_predicted_game_state : next_predicted_game_state_opt )
				{
					if_var( &predicted_bubble :
							next_predicted_game_state.bubbles.GetByIndex( index, generation_index ) )
					{
						bubble_position= MixPosition( bubble_position, predicted_bubble.position, time_steps_fraction );
					}
				}

				var f32 bubble_age_steps= f32( bubble.age_steps ) + time_steps_fraction;

				// Add some side movement (only visual).
				var f32 phase=
					bubble_age_steps * 0.25f +
					( ( bubble_position.x * 3.151f + bubble_position.y * 4.973f ) % c_tau + c_tau ) % c_tau;
				var Vec2f amplitude(
					( ( bubble_position.y * 5.3126463f ) % 1.0f + 1.0f ) % 1.0f * 12.0f - 6.0f,
					( ( bubble_position.x * 7.5237236f ) % 1.0f + 1.0f ) % 1.0f * 12.0f - 6.0f );
				var Vec2f offset( ust::cos( phase ) * amplitude.x, ust::sin( phase ) * amplitude.y );

				var f32 bubble_relative_age= bubble_age_steps / f32( c_bubble_max_age );

				var f32 scale= 1.0f + bubble_relative_age * 2.0f;
				var f32 brightness_scale= 1.0f / ( scale * scale );

				drawing_info.billboards.push_back(
					WorldDrawingInfo::Billboard
					{
						.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
						.billboard_index( BillboardConstants::c_id_bubble ),
						.position( bubble_position.xy() + offset, bubble_position.z ),
						.scale= scale,
						.brightness= brightness_scale,
					} );
			} );

		if( settings.g_blood_enabled )
		{
			game_state.blood_particles.IterateWithIndexAndGenerationIndex(
				lambda[&]( BloodParticle& blood_particle, u32 index, u32 generation_index )
				{
					var Vec3f mut blood_particle_position= blood_particle.position;

					if_var( &previous_game_state : previous_game_state_opt )
					{
						if( !previous_game_state.blood_particles.GetByIndex( index, generation_index ).empty() )
						{
							if_var( &current_predicted_game_state : current_predicted_game_state_opt )
							{
								if_var( &current_predicted_blood_particle :
										current_predicted_game_state.blood_particles.GetByIndex( index, generation_index ) )
								{
									blood_particle_position= current_predicted_blood_particle.position;
								}
							}
						}
					}

					if_var( &next_predicted_game_state : next_predicted_game_state_opt )
					{
						if_var( &predicted_blood_particle :
								next_predicted_game_state.blood_particles.GetByIndex( index, generation_index ) )
						{
							blood_particle_position=
								MixPosition( blood_particle_position, predicted_blood_particle.position, time_steps_fraction );
						}
					}

					var u32 phase= blood_particle.age_steps / c_animated_billboards_frequency_divisor;

					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
							.billboard_index(
								BillboardConstants::c_id_first_blood_particle +
								phase % BillboardConstants::c_num_blood_particles ),
							.position= blood_particle_position,
							.scale= 8.0f,
							// Blood particles are alpha-tested unlike many other particles which use additive blending.
							// Such particles require lighting, but for now it's not implemented.
							// So, just reduce brightness, so that they don't look too bright.
							.brightness= 0.4f,
						} );
				} );
		}

		game_state.muzzle_lights.Iterate(
			lambda[
				&game_state,
				&drawing_info,
				&camera_position_without_depth_shift,
				get_entity_position_and_azimuth, // Capture a copy, since it has many references inside.
				time_steps_fraction ]( MuzzleLight& muzzle_light )
			{
				var Vec3f mut absolute_position= Vec3f::MakeZero();

				if( muzzle_light.owner_entity_index == c_player_entity_index )
				{
					var Mat4f rotation_matrix=
						Mat4f::MakeRotationX( drawing_info.camera_params.elevation ) *
						Mat4f::MakeRotationZ( drawing_info.camera_params.azimuth );

					absolute_position=
						camera_position_without_depth_shift +
						muzzle_light.relative_position * rotation_matrix;
				}
				else
				{
					if( size_type( muzzle_light.owner_entity_index ) < game_state.entities.size() )
					{
						if_var( position_azimuth : get_entity_position_and_azimuth( size_type( muzzle_light.owner_entity_index ) ) )
						{
							var Mat4f rotation_matrix= Mat4f::MakeRotationZ( position_azimuth[1] );
							absolute_position= position_azimuth[0] + muzzle_light.relative_position * rotation_matrix;
						}
						else
						{
							return;
						}
					}
					else
					{
						return;
					}
				}

				var f32 fade=
					1.0f - ( f32( muzzle_light.age_steps ) + time_steps_fraction ) / f32( c_muzzle_light_max_age );

				drawing_info.dynamic_light_sources.push_back(
					WorldDrawingInfo::DynamicLightSource
					{
						.position= absolute_position,
						.power= muzzle_light.power * c_light_power_scale * fade,
						.color_index= muzzle_light.color_index,
					} );
			} );

		game_state.projectile_hit_lights.Iterate(
			lambda[&]( ProjectileHitLight& projectile_hit_light )
			{
				// No position extrapolation is needed for projectile hit lights - they don't move.

				var f32 relative_age=
					( f32( projectile_hit_light.age_steps ) + time_steps_fraction ) /
					f32( c_projectile_hit_light_max_age );

				// Make brighter lights last longer, shorten lifetime of dim lights.
				// This behavior is different from the original game - projectile hit lights in it stay longer.
				var f32 power_log= ust::log2( projectile_hit_light.power );
				var f32 age_scaled_to_log_power= relative_age * ust::max( 1.0f, 100.0f / ( power_log * power_log ) );

				var f32 s= ( age_scaled_to_log_power - 0.5f ) * 2.0f;

				var f32 fade= ust::exp( -2.0f * age_scaled_to_log_power ) * ( 1.0f - s * s );

				if( fade > 0.0f )
				{
					var f32 extra_power_scale= 0.35f; // Projectile hit lights are too bright. Scale them a little bit down.

					drawing_info.dynamic_light_sources.push_back(
						WorldDrawingInfo::DynamicLightSource
						{
							.position= projectile_hit_light.position,
							.power= projectile_hit_light.power * fade * ( extra_power_scale * c_light_power_scale ),
							.color_index= projectile_hit_light.color_index,
						} );
				}
			} );

		if( size_type( entities_description.bird_animation_index ) < entities_description.animations.size() )
		{
			var ResourceString& bird_model_file_name=
				entities_description.animations[ size_type( entities_description.bird_animation_index ) ].model_file_name;

			game_state.birds.IterateWithIndexAndGenerationIndex(
				lambda[&]( Bird& bird, u32 index, u32 generation_index )
				{
					var Vec3f mut bird_position= bird.position;
					var f32 mut bird_azimuth= bird.azimuth;

					if_var( &previous_game_state : previous_game_state_opt )
					{
						if( !previous_game_state.birds.GetByIndex( index, generation_index ).empty() )
						{
							if_var( &current_predicted_game_state : current_predicted_game_state_opt )
							{
								if_var( &current_predicted_bird :
										current_predicted_game_state.birds.GetByIndex( index, generation_index ) )
								{
									bird_position= current_predicted_bird.position;
									bird_azimuth= current_predicted_bird.azimuth;
								}
							}
						}
					}

					if_var( &next_predicted_game_state : next_predicted_game_state_opt )
					{
						if_var( &predicted_bird :
								next_predicted_game_state.birds.GetByIndex( index, generation_index ) )
						{
							bird_position= MixPosition( bird_position, predicted_bird.position, time_steps_fraction );
							bird_azimuth= MixAngle( bird_azimuth, predicted_bird.azimuth, time_steps_fraction );
						}
					}

					// Regular models have 1 frame for 2 game steps.
					// For birds use 1 frame for 1 steps, otherwise they move their wings way to slow compared to real birds.
					var u32 constexpr c_step_to_frame_factor= 1u;
					// For now hardcode the number of bird animation frame.
					// We can't read model files and extract actual number of frames in game code.
					var u32 constexpr c_num_flying_frames= 7u;

					var u32 mut frame= 0u; // Frame #0 is idle.
					if( bird.movement_age > 0u8 )
					{
						var u32 age_for_frame_calculation= u32( bird.movement_age ) - 1u;
						var u32 flying_frame=
							( age_for_frame_calculation / c_step_to_frame_factor + u32( bird.animation_frame_offset ) );
						frame= 1u + flying_frame % c_num_flying_frames;
					}

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= bird_model_file_name,
							.position= bird_position,
							.azimuth= bird_azimuth,
							.elevation= 0.0f,
							.frames{ .frame0= frame, .frame1= frame, .frame_mix= 0.5f }, // TODO - perform proper smooth animation.
							.disable_culling= false,
							.first_person_weapon= false,
							.constant_lighting= false,
						} );
				} );
		}

		if( size_type( entities_description.rat_animation_index ) < entities_description.animations.size() )
		{
			var ResourceString& rat_model_file_name=
				entities_description.animations[ size_type( entities_description.rat_animation_index ) ].model_file_name;

			game_state.rats.IterateWithIndexAndGenerationIndex(
				lambda[&]( Rat& rat, u32 index, u32 generation_index )
				{
					var Vec3f mut rat_position= rat.position;
					var f32 mut rat_azimuth= rat.azimuth;

					if_var( &previous_game_state : previous_game_state_opt )
					{
						if( !previous_game_state.rats.GetByIndex( index, generation_index ).empty() )
						{
							if_var( &current_predicted_game_state : current_predicted_game_state_opt )
							{
								if_var( &current_predicted_rat :
										current_predicted_game_state.rats.GetByIndex( index, generation_index ) )
								{
									rat_position= current_predicted_rat.position;
									rat_azimuth= current_predicted_rat.azimuth;
								}
							}
						}
					}

					if_var( &next_predicted_game_state : next_predicted_game_state_opt )
					{
						if_var( &predicted_rat : next_predicted_game_state.rats.GetByIndex( index, generation_index ) )
						{
							rat_position= MixPosition( rat_position, predicted_rat.position, time_steps_fraction );
							rat_azimuth= MixAngle( rat_azimuth, predicted_rat.azimuth, time_steps_fraction );
						}
					}

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= rat_model_file_name,
							.position= rat_position,
							.azimuth= rat_azimuth,
							.elevation= 0.0f,
							.frames{ .frame0= 0u, .frame1= 0u, .frame_mix= 0.5f }, // Rats aren't animated.
							.disable_culling= false,
							.first_person_weapon= false,
							.constant_lighting= false,
						} );
				} );
		}

		// Iterate over all bullet hole slots unless whe have the total number of bullet holes less than the number of slots.
		foreach( &bullet_hole :
				ust::array_view_imut</BulletHole/>( game_state.bullet_holes.slots ).subrange_end(
					size_type( game_state.bullet_holes.num_bullet_holes ) ) )
		{
			// This size is roughly the same as in the original or maybe a little bit bigger.
			var f32 constexpr bullet_hole_half_size= 3.0f;

			var u8 constexpr bullet_hole_texture_index= 0u8;

			drawing_info.decals.push_back(
				WorldDrawingInfo::Decal
				{
					.position=
						( size_type( bullet_hole.dynamic_cluster_object_index ) < game_state.dynamic_cluster_colliders.size()
							? bullet_hole.position + get_dynamic_cluster_center( size_type( bullet_hole.dynamic_cluster_object_index ) )
							: bullet_hole.position ),
					.half_size= bullet_hole_half_size,
					.azimuth= bullet_hole.azimuth,
					.elevation= bullet_hole.elevation,
					.dynamic_cluster_object_index= bullet_hole.dynamic_cluster_object_index,
					.texture_index= bullet_hole_texture_index,
					.mirrored= false,
				} );
		}

		// Iterate over all footprint slots unless whe have the total number of footprints less than the number of slots.
		foreach( &footprint :
				ust::array_view_imut</Footprint/>( game_state.footprints.slots ).subrange_end(
					size_type( game_state.footprints.num_footprints ) ) )
		{
			// This size is roughly the same as in the original.
			var f32 constexpr footprint_half_size= 10.0f;

			var u8 constexpr footprint_hole_texture_index= 2u8;

			drawing_info.decals.push_back(
				WorldDrawingInfo::Decal
				{
					.position= footprint.position,
					.half_size= footprint_half_size,
					.azimuth= footprint.azimuth,
					.elevation= c_tau * 0.5f, // Footprint decals are always parallel to the XY plane.
					.mirrored= !footprint.is_right,
					.texture_index= footprint_hole_texture_index,
					.dynamic_cluster_object_index= ~0u,
				} );
		}

		if( settings.g_blood_enabled )
		{
			// Iterate over all blood stain slots unless whe have the total number of blood stains less than the number of slots.
			foreach( &blood_stain :
					ust::array_view_imut</BloodStain/>( game_state.blood_stains.slots ).subrange_end(
						size_type( game_state.blood_stains.num_blood_stains ) ) )
			{
				// Blood stains with equal size look boring.
				// Add some size variation based on fractional values of positions (which are basically random).

				var f32 pseudo_random_scale_factor=
					ust::abs( blood_stain.position.x + blood_stain.position.y * 1.3f + blood_stain.position.z * 1.5f ) % 1.0f;

				var f32 blood_stain_half_size= 8.0f + 10.0f * pseudo_random_scale_factor;

				// Apply pseudo-random mirroring.
				var bool mirrored= pseudo_random_scale_factor % 0.125f < 0.0625f;

				var u8 constexpr blood_stain_texture_index= 1u8;

				drawing_info.decals.push_back(
					WorldDrawingInfo::Decal
					{
						.position=
							( size_type( blood_stain.dynamic_cluster_object_index ) < game_state.dynamic_cluster_colliders.size()
								? blood_stain.position + get_dynamic_cluster_center( size_type( blood_stain.dynamic_cluster_object_index ) )
								: blood_stain.position ),
						.half_size= blood_stain_half_size,
						.azimuth= blood_stain.azimuth,
						.elevation= blood_stain.elevation,
						.dynamic_cluster_object_index= blood_stain.dynamic_cluster_object_index,
						.texture_index= blood_stain_texture_index,
						.mirrored= mirrored,
					} );
			}
		}

		{
			auto add_first_person_weapon_model=
				lambda[&](
					EntitiesDescription::ToolType weapon_tool_type,
					PlayerWeaponState& weapon_state,
					f32 switching_fraction_normalized )
				{
					var size_type weapon_tool_index(
						entities_description.tool_type_to_index_map[ size_type( weapon_tool_type ) ] );

					if( weapon_tool_index >= entities_description.tools.size() )
					{
						return;
					}
					var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

					if( size_type( tool.animation ) < entities_description.animations.size() )
					{
						var EntitiesDescription::AnimationDescription& animation=
							entities_description.animations[ size_type( tool.animation ) ];

						// Add small periodical position variation.
						// It's needed in order to make steady weapon animations not so boring.
						var Vec3f position_variation(
							ust::sin( total_game_time_steps * 0.02f ) * 0.1f,
							ust::sin( total_game_time_steps * 0.03f ) * 0.1f,
							ust::sin( total_game_time_steps * 0.05f ) * 0.1f );

						// Lower the weapon model if performing weapon switching.
						// Also lower some weapons while shooting.
						// TODO - maybe perform lowering rotation around axis at camera position?

						var f32 total_lowering= ( 1.0f - switching_fraction_normalized ) + weapon_state.extra_lowering;

						var f32 elevation_add= c_tau / 4.0f * total_lowering;

						drawing_info.model_objects.push_back(
							WorldDrawingInfo::ModelObject
							{
								.model_file_name= animation.model_file_name,
								.position= camera_position_without_depth_shift + position_variation,
								.azimuth= camera_controller.GetAzimuth(),
								.elevation= camera_controller.GetElevation() + elevation_add,
								// TODO - perform smooth animation.
								.frames
								{
									.frame0= weapon_state.animation_step / c_num_steps_per_animation_frame,
									.frame1= weapon_state.animation_step / c_num_steps_per_animation_frame,
									.frame_mix= 0.5f,
								},
								.disable_culling= true,
								.first_person_weapon= true,
								.constant_lighting= false,
							} );
					}
				};

			add_first_person_weapon_model(
				game_state.player.primary_weapon_state.current_weapon,
				game_state.player.primary_weapon_state.weapon_state,
				f32( game_state.player.primary_weapon_state.weapon_switching_fraction ) / f32( c_weapon_switching_half_time_steps ) );

			add_first_person_weapon_model(
				EntitiesDescription::ToolType::Kick, game_state.player.kick_weapon_state, 1.0f );
		}

		if( num_player_damaging_flames > 0u )
		{
			// PanzerMortyr addition - add a light for burning player.

			drawing_info.dynamic_light_sources.push_back(
				WorldDrawingInfo::DynamicLightSource
				{
					.position(
					camera_position_without_depth_shift.xy(), camera_position_without_depth_shift.z + 32.0f ),
					.power=
						// Increase power depending on number of flames, but limit it.
						f32( ust::min( num_player_damaging_flames, 3u ) ) *
						CalculatePsedudoRandomFireLightSourceModulation( total_game_time_steps ) *
						( c_burning_entities_flame_power * c_light_power_scale ),
					.color_index= c_flame_color_index,
				} );
		}

		if( game_state.player.tools_state.flashlight_is_active )
		{
			// Use some hardcoded flashlight position relative to the camera position.
			var Vec3f offset= Vec3f( -10.0f, 20.0f, -13.0f ) * Mat4f::MakeRotationZ( camera_controller.GetAzimuth() );

			drawing_info.dynamic_light_sources.push_back(
				WorldDrawingInfo::DynamicLightSource
				{
					.position= camera_position_without_depth_shift + offset,
					.color_index= c_flashlight_color_index,
					.power= c_flashlight_power * c_light_power_scale,
				} );
		}

		// Process fullscreen effects.
		// Apply effect for damaging flames first and override it later with pain effect if necessary.

		if( num_player_damaging_flames > 0u )
		{
			var u8 alpha(
				ust::min(
				255.0f,
				f32( num_player_damaging_flames * 16u ) *
					CalculatePsedudoRandomFireLightSourceModulation( total_game_time_steps ) ) );
			drawing_info.fullscreen_blend_color= ust::make_array( 224u8, 180u8, 10u8, alpha );
		}

		{
			// Perform pain interpolation using current and previous state.
			// Some delay is fine, but miss-predicting pain isn't allowed, so, don't use predicted state for pain.
			var f32 mut pain= game_state.player.pain;
			if_var( &previous_game_state : previous_game_state_opt )
			{
				pain=
					previous_game_state.player.pain * ( 1.0f - time_steps_fraction ) +
					game_state.player.pain * time_steps_fraction;
			}

			// Scale pain value somewhat to achieve the result alpha, but limit it.
			var u8 alpha( ust::min( 240.0f, f32( pain ) * 8.0f ) );
			if( u32( alpha ) * 4u >= u32( drawing_info.fullscreen_blend_color[3] ) )
			{
				// Pain causes red effect (255, 0, 0). But if blood is disabled, replace it with some gray color.
				drawing_info.fullscreen_blend_color=
					( settings.g_blood_enabled
						? ust::make_array( 255u8, 0u8, 0u8, alpha )
						: ust::make_array( 80u8, 80u8, 80u8, alpha ) );
			}
		}

		var ZvoxData& zvox_data= map_data.zvox_data.deref();
		auto clusters= zvox_data.clusters.range();

		for( auto mut i= 0s; i < game_state.dynamic_clusters.size(); ++i )
		{
			var u32 cluster_index= game_state.dynamic_cluster_colliders[i].cluster_index;
			var ZvoxCluster& cluster= clusters[ size_type( cluster_index ) ];

			var Vec3f translation=
				get_dynamic_cluster_center(i) -
				Vec3f( f32( cluster.c.center[0] ), f32( cluster.c.center[1] ), f32( cluster.c.center[2] ) );

			drawing_info.dynamic_cluster_objects.push_back(
				WorldDrawingInfo::DynamicClusterObject{ .cluster_index= cluster_index, .translation= translation } );
		}

		// Create billboards for map light sources.
		foreach( &cluster : clusters )
		{
			if( cluster.light_sources_begin >= cluster.light_sources_end )
			{
				continue;
			}

			foreach( &light_source : zvox_data.light_sources.range().subrange(
				size_type( cluster.light_sources_begin ), size_type( cluster.light_sources_end ) ) )
			{
				var u32 billboard_kind = u32( light_source.packed_corona_color_index ) & 7u;

				if( billboard_kind == 0u )
				{
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.position(
								f32( cluster.c.center[0] + light_source.offset[0] ),
								f32( cluster.c.center[1] + light_source.offset[1] ),
								f32( cluster.c.center[2] + light_source.offset[2] ) ),
							.billboard_index( BillboardConstants::c_id_light_corona ),
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCameraWithConstantScreenSize,
						} );
				}
				else if( billboard_kind == 1u )
				{
					// Light with no coronas.
				}
				else if( billboard_kind <= 3u )
				{
					auto [ first_id, count ]=
						( billboard_kind == 2u
							? ust::make_array(
								BillboardConstants::c_id_first_blinking_light_corona,
								BillboardConstants::c_num_blinking_light_coronas )
							: ust::make_array(
								BillboardConstants::c_id_first_static_light_source_flame,
								BillboardConstants::c_num_static_light_source_flames ) );

					var Vec3f position(
						f32( cluster.c.center[0] + light_source.offset[0] ),
						f32( cluster.c.center[1] + light_source.offset[1] ),
						f32( cluster.c.center[2] + light_source.offset[2] ) - 24.0f );

					// Calculate pseudo-random phase so that each light source has its own phase (they aren't in sync).
					var ust::default_hasher mut hasher;
					ust::apply_value_to_hasher( hasher, position );

					var u32 pseudo_random_phase= u32( hasher.get() ) % count;

					var u32 billboard_index=
						first_id +
						( u32( total_game_time_steps * ( 16.0f / c_steps_per_second ) ) + pseudo_random_phase ) % count;

					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.position= position,
							.billboard_index( billboard_index ),
							.alignment= WorldDrawingInfo::Billboard::Alignment::ZAxis,
							// Draw flames slightly smaller than unit size.
							.scale= 0.75f,
						} );
				}
			}
		}

		foreach( &note_volume : map_data.note_volumes )
		{
			drawing_info.highligted_cluster_indices.push_back( note_volume.cluster_index );
		}

		if( settings.g_debug_show_entity_bounding_boxes )
		{
			var [ u8, 3 ] color[ (255), (0), (255) ];

			foreach( &collider : game_state.colliders )
			{
				CreateBBoxLines( collider.bbox, color, drawing_info.test_lines );
			}

			foreach( &collider : game_state.dynamic_cluster_colliders )
			{
				CreateBBoxLines( collider.bbox, color, drawing_info.test_lines );
			}
		}

		if( settings.g_debug_highlight_enemies_seeing_player )
		{
			var [ u8, 3 ] color[ (0), (0), (255) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( entity.attack_target_is_in_sight )
					{
						if( entity.collider_index != ~0u )
						{
							CreateBBoxLines(
								game_state.colliders[ size_type( entity.collider_index ) ].bbox,
								color,
								drawing_info.test_lines );
						}
					}
				}
			}
		}

		if( settings.g_debug_show_entity_target_navigation_graph_nodes )
		{
			var GlobalNavigationGraph& navigation_graph= map_data.global_navigation_graph;

			var [ u8, 3 ] color[ (240), (120), (255) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( size_type( entity.navigation_info_index ) < game_state.entity_navigation_states.size() )
					{
						var EntityNavigationState& navigation_state=
							game_state.entity_navigation_states[ size_type( entity.navigation_info_index ) ];

						if( navigation_state.current_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index )
						{
							var GlobalNavigationGraph::Node& node=
								navigation_graph.nodes[ size_type( navigation_state.current_navigation_graph_node ) ];
							CreateBBoxLines(
								BBox3f
								{
									.min= node.position + Vec3f( -4.0f, -4.0f, -20.0f ),
									.max= node.position + Vec3f(  4.0f,  4.0f,  -2.0f ),
								},
								color,
								drawing_info.test_lines );
						}

						if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index )
						{
							var GlobalNavigationGraph::Node& node=
								navigation_graph.nodes[ size_type( navigation_state.target_navigation_graph_node ) ];
							CreateBBoxLines(
								BBox3f
								{
									.min= node.position + Vec3f( -4.0f, -4.0f, -4.0f ),
									.max= node.position + Vec3f(  4.0f,  4.0f,  4.0f ),
								},
								color,
								drawing_info.test_lines );
						}

						var Vec3f mut previous_position( entity.position.xy(), entity.position.z - 1.0f );

						foreach( node_index : navigation_state.route )
						{
							if( node_index == GlobalNavigationGraph::c_invalid_node_index )
							{
								break;
							}

							var GlobalNavigationGraph::Node& node= navigation_graph.nodes[ size_type( node_index ) ];

							var Vec3f node_position( node.position.xy(), node.position.z - 1.0f );

							drawing_info.test_lines.push_back(
								WorldDrawingInfo::TestLine
								{
									.vertices[ previous_position, node_position ],
									.color= color,
								} );

							previous_position= node_position;
						}
					}
				}
			}
		}

		if( settings.g_debug_show_entity_attack_targets )
		{
			var [ u8, 3 ] color[ ( 240u ), ( 60u ), ( 20u ) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( !entity.alarmed )
					{
						continue;
					}

					if( size_type( entity.collider_index ) >= game_state.colliders.size() )
					{
						continue;
					}

					var Vec3f entity_bbox_center=
						game_state.colliders[ size_type( entity.collider_index ) ].bbox.GetCenter();

					var ust::optional</Vec3f/> mut target_position_opt;

					if( entity.attack_target_entity_index == c_player_entity_index )
					{
						target_position_opt= game_state.player.position;
					}
					else if( size_type( entity.attack_target_entity_index ) < game_state.entities.size() )
					{
						if_var( &attack_target_entity : game_state.entities[ size_type( entity.attack_target_entity_index ) ] )
						{
							target_position_opt= attack_target_entity.position;
						}
					}

					if_var( &target_position : target_position_opt )
					{
						drawing_info.test_lines.push_back(
							WorldDrawingInfo::TestLine
							{
								.vertices[ entity_bbox_center, target_position ],
								.color= color,
							} );

						var BBox3f b
						{
							.min= entity_bbox_center - Vec3f( 8.0f, 8.0f, 8.0f ),
							.max= entity_bbox_center + Vec3f( 8.0f, 8.0f, 8.0f ),
						};

						CreateBBoxLines( b, color, drawing_info.test_lines );
					}
				}
			}
		}

		if( settings.g_debug_show_entity_pickup_targets )
		{
			var [ u8, 3 ] color[ ( 80u ), ( 60u ), ( 240u ) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( !entity.alarmed )
					{
						continue;
					}

					if( size_type( entity.collider_index ) >= game_state.colliders.size() )
					{
						continue;
					}

					var Vec3f entity_bbox_center=
						game_state.colliders[ size_type( entity.collider_index ) ].bbox.GetCenter();

					if( size_type( entity.pickup_target_entity_index ) < game_state.entities.size() )
					{
						if_var( &pickup_target_entity : game_state.entities[ size_type( entity.pickup_target_entity_index ) ] )
						{
							drawing_info.test_lines.push_back(
								WorldDrawingInfo::TestLine
								{
									.vertices[ entity_bbox_center, pickup_target_entity.position ],
									.color= color,
								} );

							var BBox3f b
							{
								.min= entity_bbox_center - Vec3f( 8.0f, 8.0f, 8.0f ),
								.max= entity_bbox_center + Vec3f( 8.0f, 8.0f, 8.0f ),
							};

							CreateBBoxLines( b, color, drawing_info.test_lines );
						}
					}
				}
			}
		}

		if( settings.g_debug_show_quads_hierarchy )
		{
			CreateBoundingBoxesHierarchyLines(
				map_data.collider_quads_hierarchy.deref(),
				settings.g_debug_bounding_boxes_hierarchy_level_to_show,
				drawing_info.test_lines );
		}

		if( settings.g_debug_show_room_clusters_hierarchy )
		{
			CreateBoundingBoxesHierarchyLines(
				map_data.room_clusters_hierarchy.deref(),
				settings.g_debug_bounding_boxes_hierarchy_level_to_show,
				drawing_info.test_lines );
		}

		if( settings.g_debug_show_player_position_in_quads_hierarchy )
		{
			CreateLinesForPositionInBoundingBoxesHierarchy(
				map_data.collider_quads_hierarchy.deref(), game_state.player.position, drawing_info.test_lines );
		}

		if( settings.g_debug_show_global_navigation_graph )
		{
			VisualizeGlobalNavigationGraph( map_data.global_navigation_graph, drawing_info.test_lines );
		}
		if( settings.g_debug_show_global_navigation_graph_around_player )
		{
			VisualizeGlobalNavigationGraphNearGivenPoint(
				map_data.global_navigation_graph, game_state.player.position, drawing_info.test_lines );
		}
		if( settings.g_debug_show_global_navigation_graph_patrolling_points )
		{
			VisualizeGlobalNavigationGraphPatrollingPoints(
				map_data.global_navigation_graph, drawing_info.test_lines );
		}

		if( game_state.player.tools_state.night_vision_is_active )
		{
			drawing_info.fullscreen_effect= WorldDrawingInfo::FullscreenEffect::NightVision;
		}
		if( game_state.player.tools_state.infrared_vision_is_active )
		{
			drawing_info.fullscreen_effect= WorldDrawingInfo::FullscreenEffect::InfraredVision;
		}
	}

	return drawing_info;
}

fn ConstructHudDrawingInfo( EntitiesDescription& entities_description, GameState& game_state ) : HudDrawingInfo
{
	var HudDrawingInfo mut info
	{
		.health( game_state.player.energy ),
		.armor( game_state.player.armor ),
		.ammo( -1 ), // Set later.
		.weapon_icon_index(0), // Set later.
		.character_icon_index(0), // TODO - draw character icon and score in multiplayer.
		.key_icon_indices[ (0) ... ], // Set later.
		.inventory_tool_icons[ (0) ... ],
		.num_inventory_tool_icons(0),
		.selected_inventory_tool_icon_index(0),
		.active_tools= zero_init, // Set later.
		.num_active_tools(0),
	};

	var size_type weapon_tool_index(
		entities_description.tool_type_to_index_map[
			size_type( game_state.player.primary_weapon_state.current_weapon ) ] );

	if( weapon_tool_index < entities_description.tools.size() )
	{
		var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

		info.weapon_icon_index= HudDrawingInfo::IconIndex( tool.icon );

		if( tool.ammo_item >= 0 && size_type( tool.ammo_item ) < entities_description.tools.size() )
		{
			info.ammo= i16( game_state.player.inventory[ size_type( entities_description.tools[ size_type( tool.ammo_item ) ].tool_type ) ] );
		}
	}

	var size_type selected_tool_index(
		entities_description.tool_type_to_index_map[ size_type( game_state.player.tools_state.selected_tool ) ] );

	if( selected_tool_index < entities_description.tools.size() )
	{
		var u32 constexpr num_steps_whole_inventory_is_visible( c_steps_per_second );

		if( game_state.player.tools_state.last_tool_selection_step + num_steps_whole_inventory_is_visible >= game_state.step_index )
		{
			// Show the whole inventory to simplify navigation.

			static_assert(
				typeinfo</ typeof(c_inventory_accessible_tools) />.element_count <=
				typeinfo</ typeof( info.inventory_tool_icons ) />.element_count );

			foreach( tool : c_inventory_accessible_tools )
			{
				if( game_state.player.inventory[ size_type(tool) ] > 0u )
				{
					var size_type tool_index( entities_description.tool_type_to_index_map[ size_type( tool ) ] );
					if( tool_index < entities_description.tools.size() )
					{
						if( tool_index == selected_tool_index )
						{
							info.selected_inventory_tool_icon_index= info.num_inventory_tool_icons;
						}

						info.inventory_tool_icons[ info.num_inventory_tool_icons ]= u8( entities_description.tools[ tool_index ].icon );
						++info.num_inventory_tool_icons;
					}
				}
			}
		}
		else
		{
			// Show only single selected tool.

			info.num_inventory_tool_icons= 1u8;
			info.inventory_tool_icons[0]= u8( entities_description.tools[ selected_tool_index ].icon );
			info.selected_inventory_tool_icon_index= 0u8;
		}
	}

	{
		auto add_active_tool_icon=
			lambda[&]( EntitiesDescription::ToolType tool_type )
			{
				var size_type tool_index(
					entities_description.tool_type_to_index_map[ size_type( tool_type ) ] );

				if( tool_index < entities_description.tools.size() &&
					size_type( info.num_active_tools ) < typeinfo</ typeof( info.active_tools ) />.element_count )
				{
					info.active_tools[ info.num_active_tools ]=
						HudDrawingInfo::ActiveTool
						{
							.icon_index( entities_description.tools[ tool_index ].icon ),
							.amount( game_state.player.inventory[ size_type( tool_type) ] ),
						};
					++info.num_active_tools;
				}
			};

		if( game_state.player.tools_state.acid_protection_suit_is_active )
		{
			add_active_tool_icon( EntitiesDescription::ToolType::AcidProtectionSuit );
		}

		if( game_state.player.tools_state.night_vision_is_active )
		{
			add_active_tool_icon( EntitiesDescription::ToolType::NightVision );
		}

		if( game_state.player.tools_state.infrared_vision_is_active )
		{
			add_active_tool_icon( EntitiesDescription::ToolType::InfraredVision );
		}

		if( game_state.player.tools_state.flashlight_is_active )
		{
			add_active_tool_icon( EntitiesDescription::ToolType::Flashlight );
		}
	}

	var [ EntitiesDescription::ToolType, 3 ] keys
	[
		EntitiesDescription::ToolType::KeyA,
		EntitiesDescription::ToolType::KeyB,
		EntitiesDescription::ToolType::KeyC,
	];

	for( auto mut i= 0s; i < 3s; ++i )
	{
		var size_type key( keys[i] );
		if( game_state.player.inventory[ key ] > 0u )
		{
			var size_type key_tool_index( entities_description.tool_type_to_index_map[ key ] );
			if( key_tool_index < entities_description.tools.size() )
			{
				info.key_icon_indices[i]=
					HudDrawingInfo::IconIndex( entities_description.tools[ key_tool_index ].icon );
			}
		}
	}

	return info;
}

fn ConstructGameEventNotificationsDrawingInfo(
	CameraController& camera_controller,
	GameMapData& map_data,
	GameStateExtended& game_state_extended,
	f32 time_steps_fraction ) : GameEventNotificationsDrawingInfo
{
	var GameState& game_state= game_state_extended.current;

	type EN= GameEventNotificationsDrawingInfo::EventNotification;

	var GameEventNotificationsDrawingInfo mut info
	{
		.event_notification= EN::None,
		.note_indices_to_preload[ 0u8 ... ], // Set later.
		.message= game_state.map_leave_condition_message,
	};

	var u32 c_key_requirement_notification_duration( c_steps_per_second * 2.0f );
	var u32 c_secret_area_notification_duration( c_steps_per_second * 4.0f );

	if( game_state.player.last_key_request_step + c_key_requirement_notification_duration >= game_state.step_index )
	{
		switch( game_state.player.last_requested_key_type )
		{
			EntitiesDescription::ToolType::KeyA -> { info.event_notification= EN::KeyARequired; },
			EntitiesDescription::ToolType::KeyB -> { info.event_notification= EN::KeyBRequired; },
			EntitiesDescription::ToolType::KeyC -> { info.event_notification= EN::KeyCRequired; },
			default -> {},
		}
	}

	// Keep it last - it should have priority over key required notifications, since it can't be repeated.
	if( game_state.player.last_opened_secret_area_step + c_secret_area_notification_duration >= game_state.step_index )
	{
		info.event_notification= EN::SecretAreaFound;
	}

	// Preload note images.
	// Do this in any case, so that these images are preloaded at first frame drawn for a map.
	// Doing so we avoid a possible lag caused by image loading when a note should be actually shown.
	foreach( pair : ust::array_view_mut</u8/>( info.note_indices_to_preload ).iter().zip( map_data.note_volumes.iter() ) )
	{
		pair.first= pair.second.note_index;
	}

	// Search for a note visible nearby.
	if( !map_data.note_volumes.empty() )
	{
		var f32 c_note_visible_max_distance= 192.0f;
		var f32 c_note_full_alpha_distance= 32.0f;
		var f32 c_note_base_scale= 20.0f;

		var f32 azimuth= camera_controller.GetAzimuth();
		var f32 elevation= camera_controller.GetElevation();

		var f32 elevation_cos= ust::cos(elevation);
		var f32 elevation_sin= ust::sin(elevation);

		var Vec3f direction_vector=
			Vec3f(
				-ust::sin(azimuth) * elevation_cos,
				 ust::cos(azimuth) * elevation_cos,
				elevation_sin ) * c_note_visible_max_distance;

		// Extrapolate/mix camera position used for note volume intersection search.

		var Vec3f mut camera_position=
			GetCameraPositionForPlayerWithExtraDepthShift( game_state.player, camera_controller );

		if_var( &current_predicted_game_state : game_state_extended.current_predicted )
		{
			camera_position=
				GetCameraPositionForPlayerWithExtraDepthShift( current_predicted_game_state.player, camera_controller );
		}

		if_var( &next_predicted_game_state : game_state_extended.next_predicted )
		{
			camera_position=
				MixPosition(
					camera_position,
					GetCameraPositionForPlayerWithExtraDepthShift( next_predicted_game_state.player, camera_controller ),
					time_steps_fraction );
		}

		// Check all note volumes - there is not so many of them.
		foreach( &note_volume : map_data.note_volumes )
		{
			// Find intersection with a box. It gives good enough result.
			if_var( intersection : FindRayBBoxIntersection( camera_position, direction_vector, note_volume.bbox ) )
			{
				if( intersection.near_point_distance < 1.0f && intersection.far_point_distance > 0.0f )
				{
					var f32 distance_clamped=
						ust::max( 0.1f, intersection.near_point_distance * c_note_visible_max_distance );

					var f32 scale= c_note_base_scale / distance_clamped;

					// If multiple notes may be visible at the same time, select one with the largest scale (the closest one).
					// Such check is needed, since there are multiple note volumes nearby on some maps (but having the same note).
					if( info.note_info.empty() || info.note_info.try_deref().scale < scale )
					{
						info.note_info=
							GameEventNotificationsDrawingInfo::NoteInfo
							{
								.note_index= note_volume.note_index,
								.scale= scale,
								.alpha= ust::min( 1.0f, c_note_full_alpha_distance / distance_clamped ),
							};
					}
				}
			}
		}
	}

	return info;
}

fn ConstructCrosshairDrawingInfo(
	CameraController& camera_controller,
	ust::optional_ref_imut</GameMapData/> map_data_opt,
	ust::optional_ref_imut</GameStateExtended/> game_state_opt,
	f32 time_steps_fraction ) : CrosshairDrawingInfo
{
	var CrosshairDrawingInfo mut drawing_info
	{
		.camera_position= Vec3f::MakeZero(),
		.camera_azimuth= camera_controller.GetAzimuth(),
		.camera_elevation= camera_controller.GetElevation(),
		.camera_fov= camera_controller.GetFOV(),
		.hit_point= Vec3f::MakeZero(),
		.hit_point_kind= CrosshairDrawingInfo::HitPointKind::None,
	};

	if( !map_data_opt.empty() && !game_state_opt.empty() )
	{
		var GameMapData& map_data= map_data_opt.try_deref();

		var GameStateExtended& game_state_extended= game_state_opt.try_deref();

		var GameState& game_state= game_state_extended.current;

		if( game_state.player.energy > 0u ) // Display crosshair only if the player is alive.
		{
			var GameState& start_state=
				( game_state_extended.current_predicted.empty()
					? game_state
					: game_state_extended.current_predicted.try_deref() );

			drawing_info.camera_position=
				GetCameraPositionForPlayerWithExtraDepthShift( start_state.player, camera_controller );

			auto [ position, kind ]=
				GetCrosshairPositionAndKind(
					map_data, start_state, drawing_info.camera_azimuth, drawing_info.camera_elevation );

			drawing_info.hit_point= position;
			drawing_info.hit_point_kind= kind;

			// Perform extrapolation/mixing of camera position and hit position.

			if_var( &next_predicted_game_state : game_state_extended.next_predicted )
			{
				drawing_info.camera_position=
					MixPosition(
						drawing_info.camera_position,
						GetCameraPositionForPlayerWithExtraDepthShift(
							next_predicted_game_state.player, camera_controller ),
						time_steps_fraction );

				drawing_info.hit_point=
					MixPosition(
						drawing_info.hit_point,
						GetCrosshairPositionAndKind(
							map_data,
							next_predicted_game_state,
							drawing_info.camera_azimuth,
							drawing_info.camera_elevation )[0],
						time_steps_fraction );
			}
		}
	}

	return drawing_info;
}

fn GetCameraPositionForPlayer( PlayerState& player_state ) : Vec3f
{
	var f32 crouching_z_offset= player_state.crouching_phase * c_crouching_height_delta;
	return Vec3f( player_state.position.xy(), player_state.position.z + c_camera_z_offset + crouching_z_offset );
}

fn GetCameraDepthShift( CameraController& camera_controller ) : Vec3f
{
	var Mat4f camera_rotation_matrix=
		Mat4f::MakeRotationX( camera_controller.GetElevation() ) *
		Mat4f::MakeRotationZ( camera_controller.GetAzimuth() );

	// The original game moves camera slightly backwards. Do exactly this.
	// This constant was fine-tuned to match position of the first-person weapon almost pixel to pixel compared to the original game.
	var f32 c_camera_depth_offset= -8.0f;

	return Vec3f( 0.0f, c_camera_depth_offset, 0.0f ) * camera_rotation_matrix;
}

fn GetCameraPositionForPlayerWithExtraDepthShift( PlayerState& player_state, CameraController& camera_controller ) : Vec3f
{
	return GetCameraPositionForPlayer( player_state ) + GetCameraDepthShift( camera_controller );
}

fn MixPosition( Vec3f& a, Vec3f& b, f32 mix_factor ) : Vec3f
{
	return MixVector( a, b, mix_factor );
}

fn MixVelocity( Vec3f& a, Vec3f& b, f32 mix_factor ) : Vec3f
{
	return MixVector( a, b, mix_factor );
}

fn MixVector( Vec3f& a, Vec3f& b, f32 mix_factor ) : Vec3f
{
	return a * ( 1.0f - mix_factor ) + b * mix_factor;
}

fn MixAngle( f32 a, f32 b, f32 mix_factor ) : f32
{
	var f32 mut angle_delta= ( ( b - a ) % c_tau + c_tau ) % c_tau;

	if( angle_delta >= c_tau * 0.5f )
	{
		angle_delta-= c_tau;
	}

	return a + angle_delta * mix_factor;
}

fn CalculatePsedudoRandomFireLightSourceModulation( f32 modulation_phase ) : f32
{
	return
		1.0f +
		0.25f * ust::sin( modulation_phase * 0.5f ) +
		0.125f * ust::sin( modulation_phase * c_half_sqrt_2 ) +
		0.08f * ust::sin( modulation_phase * ( 0.5f * c_sqrt_3 ) );
}

var u32 constexpr c_flame_color_index= 4u;
var u32 constexpr c_flashlight_color_index= 11u;

var f32 constexpr c_burning_entities_flame_power= 4.0f;

var f32 constexpr c_flashlight_power= 384.0f;

var f32 constexpr c_light_power_scale= 256.0f;

} // namespace PM
