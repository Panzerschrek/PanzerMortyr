import "game_logic.iu"
import "game_state_view_construction.iu"

namespace PM
{

fn ConstructGameEventNotificationsDrawingInfo( GameState& game_state ) :GameEventNotificationsDrawingInfo
{
	type EN= GameEventNotificationsDrawingInfo::EventNotification;

	var GameEventNotificationsDrawingInfo mut info
	{
		.event_notification= EN::None,
	};

	var u32 c_key_requirement_notification_duration( c_steps_per_second * 2.0f );
	var u32 c_secret_area_notification_duration( c_steps_per_second * 4.0f );

	if( game_state.player.last_key_request_step + c_key_requirement_notification_duration >= game_state.step_index )
	{
		switch( game_state.player.last_requested_key_type )
		{
			EntitiesDescription::ToolType::KeyA -> { info.event_notification= EN::KeyARequired; },
			EntitiesDescription::ToolType::KeyB -> { info.event_notification= EN::KeyBRequired; },
			EntitiesDescription::ToolType::KeyC -> { info.event_notification= EN::KeyCRequired; },
			default -> {},
		}
	}

	// Keep it last - it should have priority over key required notifications, since it can't be repeated.
	if( game_state.player.opened_secrets_mask != 0u &&
		game_state.player.last_opened_secret_area_step + c_secret_area_notification_duration >= game_state.step_index )
	{
		info.event_notification= EN::SecretAreaFound;
	}

	return info;
}

fn ConstructCrosshairDrawingInfo(
	CameraController& camera_controller,
	ust::optional_ref_imut</GameMapData/> map_data_opt,
	ust::optional_ref_imut</GameState/> game_state_opt ) : CrosshairDrawingInfo
{
	var CrosshairDrawingInfo mut drawing_info
	{
		.camera_position= Vec3f::MakeZero(),
		.camera_azimuth= camera_controller.GetAzimuth(),
		.camera_elevation= camera_controller.GetElevation(),
		.camera_fov= camera_controller.GetFOV(),
		.hit_point= Vec3f::MakeZero(),
		.hit_point_kind= CrosshairDrawingInfo::HitPointKind::None,
	};

	if( !map_data_opt.empty() && !game_state_opt.empty() )
	{
		var GameMapData& map_data= map_data_opt.try_deref();
		var GameState& game_state= game_state_opt.try_deref();

		drawing_info.camera_position=
			GetCameraPositionForPlayerWithExtraDepthShift( game_state.player, camera_controller );

		auto [ position, kind ]=
			GetCrosshairPositionAndKind( map_data, game_state, drawing_info.camera_azimuth, drawing_info.camera_elevation );

		drawing_info.hit_point= position;
		drawing_info.hit_point_kind= kind;
	}

	return drawing_info;
}

} // namespace PM
