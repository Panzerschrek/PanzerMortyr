import "game_archive_filesystem.iu"
import "game_data_search.iu"

namespace PM
{

type GameFilesystemPtr= ust::shared_ptr_mut</GameFilesystem/>;
type GameFilesystemNullablePtr= ust::shared_ptr_nullable_mut</GameFilesystem/>;

class GameFilesystem
{
public:
	// Returns empty container if failed to create. Possible errors are logged into given console out.
	fn Create(
		ust::filesystem_path_view executable_path,
		ust::filesystem_path_view custom_game_installation_directory_path,
		ConsoleOutPtr& console_out ) : GameFilesystemNullablePtr;

	// Constructor for internal usage.
	fn constructor(
		ust::filesystem_path data_directory_path,
		ust::optional</GameArchiveFilesystem/> archive_filesystem,
		GameDataFiles extra_data_files );

	fn GetDataDirectory( this )
		: ust::filesystem_path_view @( ust::reference_notation::return_inner_references::param0 );

	// Load file into a string.
	// Returns an error if file is not found.
	fn LoadFileToString( mut this, ResourceString& file_name ) : ust::io_result</ust::string8/>;

	// Load file into a byte8 vector.
	// Returns an error if file is not found.
	fn LoadFileToByte8Vector( mut this, ResourceString& file_name ) : ust::io_result</ ust::vector</byte8/> />;

	// Load file with given name using passed loading function.
	// Passed function object should accept "file_readable &mut" instance, which may point to the archive file or a separate filesystem file.
	// This function should not perform file seeking, since it may be wrong for a file being an archive part.
	// Return type should be something like ust::io_result</T/>.
	template</type LoadingFunc/>
	fn LoadFile( mut this, ResourceString& file_name, LoadingFunc mut loading_func ) : auto
	{
		if_var( &path : extra_data_files_.find( file_name ) )
		{
			result_match( ust::file_readable::open( path ) )
			{
				Ok( mut f ) -> { return move(loading_func)( f ); },
				Err( e ) -> { ust::ignore_unused(e); }, // Try loading a file from the game archive.
			}
		}

		if_var( &mut archive_filesystem : archive_filesystem_ )
		{
			return archive_filesystem.LoadFile( file_name, move( loading_func ) );
		}

		type ResultT= typeof( archive_filesystem_.try_deref().LoadFile( file_name, move( loading_func ) ) );
		return ResultT( ust::io_error::not_found );
	}

private:
	ust::filesystem_path imut data_directory_path_;

	ust::optional</ GameArchiveFilesystem /> archive_filesystem_; // Is empty if has no archive file.

	// Files outside game archive.
	GameDataFiles imut extra_data_files_;
}

} // namespace PM
