import "lighting.uh"

namespace PM
{

fn GetLightForPoint( ZvoxData& zvox_data, Vec3f& point ) : [ f32, 3 ]
{
	var [ f32, 3 ] mut result_light[ 0.0f ... ];

	// TODO - tune this.
	var f32 c_light_power_scale= 16.0f;

	// TODO - optimize this, avoid enumerating all light sources.

	foreach( &cluster : zvox_data.clusters )
	{
		for( auto mut i= cluster.light_sources_begin; i < cluster.light_sources_end; ++i )
		{
			var ZvoxLightSource& light_source= zvox_data.light_sources[ size_type( i ) ];

			// Experimental estimation of light power.
			var i32 power= 160 -i32(light_source.power);
			if( power <= 0 )
			{
				continue;
			}

			var Vec3f light_source_position(
				f32( cluster.c.center[0] + light_source.offset[0] ),
				f32( cluster.c.center[1] + light_source.offset[1] ),
				f32( cluster.c.center[2] + light_source.offset[2] ) );

			var f32 square_distance= ( point - light_source_position ).SquareLength();

			var f32 power_at_given_distance= c_light_power_scale * f32( power ) / square_distance;

			// TODO - use colors.
			result_light[0]+= power_at_given_distance;
			result_light[1]+= power_at_given_distance;
			result_light[2]+= power_at_given_distance;

			// TODO - consider checking line of sight (don't count occludded lights).
		}
	}

	return result_light;
}

} // namespace PM
