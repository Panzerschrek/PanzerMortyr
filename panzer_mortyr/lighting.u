import "lighting.uh"

namespace PM
{

fn GetLightForPoint(
	ZvoxData& zvox_data,
	GameParams& game_params,
	Vec3f& point,
	Mat4f& inverse_rotation_matrix ) :SphericalHarmonicsRGB
{
	var SphericalHarmonicsRGB mut result_light[ { .directional_components= Vec3f::MakeZero(), .constant_component= 0.0f } ... ];

	// TODO - tune this.
	var f32 c_light_power_scale= 1.0f;

	var f32 c_min_light_sequare_distance= 1.0f * 1.0f;

	// Limit light power coming from single source.
	var f32 c_max_source_light_power= 1.0f / 48.0f;

	// TODO - optimize this, avoid enumerating all light sources.

	foreach( &cluster : zvox_data.clusters )
	{
		for( auto mut i= cluster.light_sources_begin; i < cluster.light_sources_end; ++i )
		{
			var ZvoxLightSource& light_source= zvox_data.light_sources[ size_type( i ) ];

			// Experimental estimation of light power.
			var i32 power= 160 - i32(light_source.power);
			if( power <= 0 )
			{
				continue;
			}

			var Vec3f light_source_position(
				f32( cluster.c.center[0] + light_source.offset[0] ),
				f32( cluster.c.center[1] + light_source.offset[1] ),
				f32( cluster.c.center[2] + light_source.offset[2] ) );

			var Vec3f vector_to_light= light_source_position - point;

			// TODO - consider checking line of sight (don't count occludded lights).

			var f32 square_distance= ust::max( vector_to_light.SquareLength(), c_min_light_sequare_distance );
			var f32 distance= ust::sqrt( square_distance );

			var f32 power_at_given_distance=
				ust::min( c_light_power_scale * f32( power ) / square_distance, c_max_source_light_power );

			var Vec3f normalized_light_direction= ( vector_to_light / distance ) * inverse_rotation_matrix;

			auto& src_color= game_params.light_colors[ ( u32( light_source.packed_corona_color_index ) >> 3 ) & 31u ];

			for( auto mut c= 0u; c < 3u; ++c )
			{
				// 0.5 is needed, because we have second order spherical harmonics.
				var f32 scale= 0.5f * power_at_given_distance * f32( src_color[ 2u - c ] );
				result_light[c].directional_components+= scale * normalized_light_direction;
				result_light[c].constant_component+= scale * power_at_given_distance;
			}
		}
	}

	return result_light;
}

} // namespace PM
