import "cluster_utils.uh"
import "lighting.uh"

namespace PM
{

fn GetLightForPoint(
	ZvoxData& zvox_data,
	ZmapLemData& zmap_lem_data,
	GameParams& game_params,
	Vec3f& point,
	Mat4f& inverse_rotation_matrix ) :SphericalHarmonicsRGB
{
	var SphericalHarmonicsRGB mut result_light[ { .directional_components= Vec3f::MakeZero(), .constant_component= 0.0f } ... ];

	// TODO - tune this.
	var f32 c_light_power_scale= 1.0f;

	var f32 c_min_light_sequare_distance= 1.0f * 1.0f;

	// Limit light power coming from single source.
	var f32 c_max_source_light_power= 1.0f / 32.0f;

	// Limit overall brightness.
	var f32 c_max_component_light_value= 1.5f;

	// TODO - optimize this, avoid enumerating all light sources.

	foreach( &cluster : zvox_data.clusters )
	{
		for( auto mut i= cluster.light_sources_begin; i < cluster.light_sources_end; ++i )
		{
			var ZvoxLightSource& light_source= zvox_data.light_sources[ size_type( i ) ];

			// Experimental estimation of light power.
			var i32 power= 160 - i32(light_source.power);
			if( power <= 0 )
			{
				continue;
			}

			var Vec3f light_source_position(
				f32( cluster.c.center[0] + light_source.offset[0] ),
				f32( cluster.c.center[1] + light_source.offset[1] ),
				f32( cluster.c.center[2] + light_source.offset[2] ) );

			var Vec3f vector_to_light= light_source_position - point;

			// TODO - consider checking line of sight (don't count occludded lights).

			var f32 square_distance= ust::max( vector_to_light.SquareLength(), c_min_light_sequare_distance );
			var f32 distance= ust::sqrt( square_distance );

			var f32 power_at_given_distance=
				ust::min( c_light_power_scale * f32( power ) / square_distance, c_max_source_light_power );

			var Vec3f normalized_light_direction= ( vector_to_light / distance ) * inverse_rotation_matrix;

			auto& src_color= game_params.light_colors[ ( u32( light_source.packed_corona_color_index ) >> 3 ) & 31u ];

			for( auto mut c= 0u; c < 3u; ++c )
			{
				// 0.5 is needed, because we have second order spherical harmonics.
				var f32 scale= 0.5f * power_at_given_distance * f32( src_color[ 2u - c ] );
				result_light[c].directional_components+= scale * normalized_light_direction;
				result_light[c].constant_component+= scale * power_at_given_distance;
			}
		}
	}

	// Add sky light stored in "ZMAP*.LEM" file.
	// TODO - optimize this, avoid enumerating all clusters.

	foreach( pair : zvox_data.clusters.iter().zip( zmap_lem_data.clusters_sky_visibility_data.iter() ) )
	{
		var ZvoxCluster& cluster= pair.first;

		if( cluster.c.num_children_clusters < 0 )
		{
			// Ignore non-root clusters.
			continue;
		}

		var BBox3f bbox= CreateClusterBBox( cluster );

		if( !bbox.PointIsInsideOrOnFace( point ) )
		{
			continue;
		}

		// Found cluster where point is located.

		var Vec3f bbox_dimensions= bbox.GetDimensions();

		if( bbox_dimensions.x <= 0.0f || bbox_dimensions.y <= 0.0f || bbox_dimensions.z <= 0.0f )
		{
			continue;
		}

		var Vec3f relative_position= point - bbox.min;

		var u32 constexpr size= 4u;

		var [ u32, 3 ] coords
		[
			( ust::max( 0.0f, ust::min( f32( size ) * relative_position.x / bbox_dimensions.x, 3.0f ) ) ),
			( ust::max( 0.0f, ust::min( f32( size ) * relative_position.y / bbox_dimensions.y, 3.0f ) ) ),
			( ust::max( 0.0f, ust::min( f32( size ) * relative_position.z / bbox_dimensions.z, 3.0f ) ) ),
		];

		var u32 color_brg=
			pair.second.data[ coords[0] + coords[1] * size + coords[2] * ( size * size ) ];

		if( color_brg != 0u )
		{
			result_light[0].constant_component+= f32( ( color_brg >> 16u ) & 255u ) / 255.0f;
			result_light[1].constant_component+= f32( ( color_brg >>  8u ) & 255u ) / 255.0f;
			result_light[2].constant_component+= f32( ( color_brg >>  0u ) & 255u ) / 255.0f;
		}

		// Break, sine we found the cluster where given point is located.
		break;
	}

	// Limit result light. We should avoid overbrights.
	{
		var f32 mut max_component_light_value= 0.0f;
		foreach( &c : result_light )
		{
			ust::max_assign(
				max_component_light_value,
				c.constant_component +
					ust::max(
						ust::abs( c.directional_components.x ),
						ust::max(
							ust::abs( c.directional_components.y ),
							ust::abs( c.directional_components.z ) ) ) );
		}

		if( max_component_light_value > c_max_component_light_value )
		{
			var f32 scale= c_max_component_light_value / max_component_light_value;
			foreach( &mut l : result_light )
			{
				l.directional_components*= scale;
				l.constant_component*= scale;
			}
		}
	}

	return result_light;
}

} // namespace PM
