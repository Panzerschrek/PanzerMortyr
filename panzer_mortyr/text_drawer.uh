import "/hash_map.u"
import "/string.u"
import "buffer_object.uh"
import "font_files.uh"
import "game_filesystem.uh"
import "shader_program.uh"
import "texture.uh"
import "vertex_array_object.uh"
import "vertex_formats.uh"

namespace PM
{

class TextDrawer
{
public:
	// Settings describing how exactly to draw a text pience.
	struct Settings
	{
		u32 scale= 1u;
		[ u8, 4 ] foreground_color[ 255u8, 255u8, 255u8, 255u8 ];
		[ u8, 4 ] background_color[ 0u8, 0u8, 0u8, 255u8 ];
		bool monospace= false;
	}

	var u32 constexpr c_max_glyph_width= 7u, constexpr c_glyph_height= 8u;

public:
	fn constructor( [ u32, 2 ] viewport_size, GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out );

	// Add a text at given coordinates. Coordinates are integer pixel coordinates with zero at lower left screen corner.
	fn AddText( mut this, i32 x, i32 y, ust::string_view8 text );
	fn AddText( mut this, i32 x, i32 y, ust::string_view8 text, Settings& settings );

	// Draw accumulated glyphs.
	fn DrawTexts( mut this );

private:
	var size_type c_max_buffer_size_glyphs= 1024s;

private:
	[ u32, 2 ] imut viewport_size_;
	FontData imut font_data_;
	ust::hash_map</char32, size_type/> imut code_point_to_glyph_position_map_;
	ShaderProgram shader_;
	VertexArrayObject vertex_array_object_;
	BufferObject vertex_buffer_;
	BufferObject index_buffer_;
	Texture font_texture_;

	[ [ TextVertex, 4 ], c_max_buffer_size_glyphs ] buffered_glyphs_;
	size_type num_buffered_glyphs_;
}

} // namespace PM
