import "vec.iu"

namespace PM
{

namespace PrecipitationConstants
{

// Make sure these constants are in sync with constants used in rain and snow shaders!

var f32 snow_speed= 64.0f;
var f32 rain_speed= 384.0f;

// Assume each snow/rain particle moves along a path with such length.
// It should be big enough to ensure snow/rain can fall into the deepest places and small enough to avoid reducing snow/rain density too much.
var f32 max_path_length= 2048.0f;

var [ f32, 3 ] move_vector[ 0.235f, 0.235f, 0.943f ];

var f32 water_circle_stay_distance= 256.0f; // TODO - tune this.

var f32 water_circle_max_visible_distance= 1024.0f; // TODO - tune this.

var f32 water_circle_max_radius= 32.0f;  // TODO - tune this.

} // namespace PrecipitationConstants

} // namespace PM
