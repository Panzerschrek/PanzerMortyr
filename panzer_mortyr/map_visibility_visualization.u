import "map_visibility_visualization.iu"

namespace PM
{

fn VisualizeProjectedPortals(
	ust::array_view_imut</MapVisibilityCalculator::PortalProjected/> portals_projected,
	ust::vector</WorldDrawingInfo::TestLine/> &mut test_lines )
{
	var [ u8, 3 ] color[ 0u8, 255u8, 0u8 ];

	foreach( &portal_opt : portals_projected )
	{
		if( portal_opt.empty() )
		{
			continue;
		}

		var ClippingPolygon& p= portal_opt.try_deref();

		if( p.IsEmptyOrInvalid() )
		{
			continue;
		}

		var [ Vec2f, 4 ] v
		[
			FindLinesIntersection( Vec2f( 1.0f, 0.0f ), -p.x.min, Vec2f( 0.0f, 1.0f ), -p.y.min ),
			FindLinesIntersection( Vec2f( 1.0f, 0.0f ), -p.x.min, Vec2f( 0.0f, 1.0f ), -p.y.max ),
			FindLinesIntersection( Vec2f( 1.0f, 0.0f ), -p.x.max, Vec2f( 0.0f, 1.0f ), -p.y.min ),
			FindLinesIntersection( Vec2f( 1.0f, 0.0f ), -p.x.max, Vec2f( 0.0f, 1.0f ), -p.y.max ),
		];

		test_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ ( v[0], 0.0f ), ( v[1], 0.0f ) ], .color= color } );
		test_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ ( v[1], 0.0f ), ( v[3], 0.0f ) ], .color= color } );
		test_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ ( v[3], 0.0f ), ( v[2], 0.0f ) ], .color= color } );
		test_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ ( v[2], 0.0f ), ( v[0], 0.0f ) ], .color= color } );
	}
}

// Given lines should not be parallel.
fn FindLinesIntersection( Vec2f& n0, f32 d0, Vec2f& n1, f32 d1 ) : Vec2f
{
	return Vec2f( d1 * n0.y - d0 * n1.y,  d0 * n1.x - d1 * n0.x ) / ( n0.x * n1.y - n0.y * n1.x );
}

} // namespace PM
