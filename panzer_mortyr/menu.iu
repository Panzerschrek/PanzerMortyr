import "/variant.iu"
import "abstract_image_drawer.iu"
import "abstract_text_drawer.iu"
import "audio_processor.iu"
import "display_modes.iu"
import "regional_version.iu"
import "save_load.iu"

namespace PM
{

class Menu
{
public:
	struct CommandNone{}
	struct CommandNewGame{ u32 skill; }
	struct CommandLoadGame{ SaveSlotName slot_name; }
	struct CommandSaveGame{ SaveSlotName slot_name; SaveComment save_comment; }
	struct CommandQuit{}

	type Command= ust::variant</ tup[ CommandNone, CommandNewGame, CommandLoadGame, CommandSaveGame, CommandQuit ] />;

	struct GamePossibilities
	{
		bool saving_available;
		bool has_active_game_with_valuable_progress;
	}

public:
	fn constructor(
		SettingsPtr settings,
		CachingGameResourcesLoaderPtr& caching_game_resources_loader,
		[ u32, 2 ] viewport_size,
		ConsoleOutPtr mut console_out );

	fn IsActive( this ) : bool;

	fn Activate( mut this ); // Opens the main page if wasn't active or if is showing some other page.
	fn Deactivate( mut this );

	// Returns command which should be performed.
	fn nodiscard ProcessKeyPress(
		mut this,
		SDL_Scancode scancode,
		GamePossibilities& game_possibilities,
		AudioProcessor &mut audio_processor ) : Command;

	fn nodiscard ProcessMouseButtonPress(
		mut this,
		u32 button_index,
		GamePossibilities& game_possibilities,
		AudioProcessor &mut audio_processor ) : Command;

	fn ProcessMouseWheel(
		mut this,
		i32 delta /* positive is up, negative is down */,
		GamePossibilities& game_possibilities,
		AudioProcessor &mut audio_processor );

	fn ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event );

	fn Update( mut this, f32 time_delta_s );

	fn Draw( mut this, AbstractImageDrawer &mut image_drawer, AbstractTextDrawer &mut text_drawer );

private:
	enum Page
	{
		None, // Used if menu isn't active.
		MainMenu,
		NewGame,
		LoadGame,
		SaveGame,
		Multiplayer,
		Options,
		Controls,
		KeyBindings,
		VideoSettings,
		SoundSettings,
		ExtraOptions,
		ParentalLock,
		AbortThisGame,
		Quit,
	}

	// The original game have so many slots. There is not enough space for more slots.
	var u32 c_num_load_save_slots= 12u;

	struct LoadSavePagesState
	{
		u32 current_row;
		[ ust::optional</ SaveSummary />, c_num_load_save_slots ] slots;
		[ ust::optional</ ImageData />, c_num_load_save_slots ] slot_images;

		// Is non-empty if editing is active.
		ust::optional</SaveComment/> input_slot_comment;
	}

	struct KeyBindingsPageState
	{
		u32 current_row;
		u32 rows_offset; // Used for scrolling.
		bool editing_active;
	}

	struct VideoSettingsPageState
	{
		u32 current_row;
		u32 current_video_mode_index;
	}

private:
	fn LoadSaveSummaries( mut this );

	fn ActualizeCurrentKeyBinding( mut this, KeyBinding key_binding );

	fn ActualizeVideoModeIndex( mut this );
	fn SelectNextVideoMode( mut this );
	fn SelectPreviousVideoMode( mut this );

private:
	SettingsPtr imut settings_;
	ConsoleOutPtr imut console_out_;
	GameResourcePtr</StringTable/> imut string_table_;
	RegionalVersion regional_version_;
	[ u32, 2 ] imut viewport_size_;
	PerDisplayModes imut per_display_video_modes_;
	bool images_preloaded_;

	Page current_page_;

	f32 time_s_; // Used for things like cursor animation.

	u32 main_menu_current_row_;
	u32 new_game_current_row_;

	u32 options_current_row_;

	LoadSavePagesState load_save_pages_state_;

	u32 controls_current_row_;

	KeyBindingsPageState key_bindings_page_state_;

	VideoSettingsPageState video_settings_page_state_;

	u32 sound_settings_current_row_;
	u32 extra_options_current_row_;
	u32 quit_message_index_;
}

} // namespace PM
