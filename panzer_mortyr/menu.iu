import "/variant.iu"
import "audio_processor.iu"
import "image_drawer.iu"
import "text_drawer.iu"

namespace PM
{

class Menu
{
public:
	struct CommandNone{}
	struct CommandNewGame{ u32 skill; }
	struct CommandLoadGame{}
	struct CommandSaveGame{ u32 slot_index; }
	struct CommandQuit{}

	type Command= ust::variant</ tup[ CommandNone, CommandNewGame, CommandLoadGame, CommandSaveGame, CommandQuit ] />;

public:
	fn constructor( SettingsPtr settings, [ u32, 2 ] viewport_size );

	fn IsActive( this ) : bool;

	fn Activate( mut this ); // Opens the main page if wasn't active or if is showing some other page.
	fn Deactivate( mut this );

	// Returns command which should be performed.
	fn nodiscard ProcessKeyPress( mut this, SDL_Keysym& key_sym, AudioProcessor &mut audio_processor ) : Command;

	fn ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event );

	fn Update( mut this, f32 time_delta_s );

	fn Draw( mut this, ImageDrawer &mut image_drawer, TextDrawer &mut text_drawer );

private:
	enum Page
	{
		None, // Used if menu isn't active.
		MainMenu,
		NewGame,
		LoadGame,
		SaveGame,
		Options,
		Controls,
		VideoSettings,
		SoundSettings,
		AdvancedOptions,
		Quit,
	}

	var u32 c_num_load_save_slots= 12u;

	struct LoadSaveMenuState
	{
		u32 current_row;
		[ ust::optional</ ust::string8 />, c_num_load_save_slots ] slot_names; // TODO - maybe use fixed-size container?

		// Is non-empty if editing is active is active.
		ust::optional</ust::string8/> input_slot_name;
	}

private:
	SettingsPtr imut settings_;
	[ u32, 2 ] imut viewport_size_;
	bool images_preloaded_;

	Page current_page_;

	f32 time_s_; // Used for things like cursor animation.

	u32 main_menu_current_row_;
	u32 new_game_current_row_;

	LoadSaveMenuState load_save_menu_state_;

	u32 options_current_row_;
	u32 controls_current_row_;
	u32 sound_settings_current_row_;
	u32 advanced_options_current_row_;
	u32 quit_message_index_;
}

} // namespace PM
