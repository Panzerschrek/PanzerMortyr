import "/filesystem.iu"
import "/path_utils.iu"
import "/string_conversions.iu"
import "/ffmpeg/ffmpeg.iu"
import "video_playback.iu"

namespace PM
{

fn PlayVideo( ConsoleOutPtr& console_out, ust::filesystem_path file_path )
{
	ConsoleOutAddTextLine( console_out, "Try playing a video" );

	var ust::string8 mut file_path_nt= ust::concat( file_path, "\0" );
	unsafe
	{
		av_log_set_level( AV_LOG_DEBUG );

		{
			var $(byte8) mut state= zero_init;
			loop
			{
				var $(AVCodecParser) parser= av_parser_iterate( $<(state) );
				if( ust::is_nullptr( parser ) )
				{
					break;
				}

				ConsoleOutAddTextLine( console_out, "has a parser. Supported codecs: " );
				foreach( c : $>(parser).codec_ids )
				{
					if( c != i32( AV_CODEC_ID_NONE ) )
					{
						ConsoleOutAddTextLine( console_out, ust::to_string8(c) );
					}
				}
			}
		}

		var $(AVFormatContext) mut format_context= zero_init;

		with( ret :
			avformat_open_input(
				$<(format_context),
				file_path_nt.data(),
				ust::nullptr</AVInputFormat/>(),
				ust::nullptr</ $(AVDictionary) />() ) )
		{
			if( ret != 0 )
			{
				ConsoleOutAddTextLine( console_out, ust::concat( "Failed to open a video! Error: ", GetFFmpegError( ret ) ) );
				return;
			}
		}

		ConsoleOutAddTextLine( console_out, "Opened video input" );

		with( ret : avformat_find_stream_info( format_context, ust::nullptr</ $(AVDictionary) />() ) )
		{
			if( ret != 0 )
			{
				ConsoleOutAddTextLine( console_out, ust::concat( "Failed to found stream info! Error: ", GetFFmpegError( ret ) ) );
				avformat_close_input( $<( format_context ) );
				return;
			}
		}

		ConsoleOutAddTextLine( console_out, ust::concat( "Found steam info. Has ", ust::to_string8( $>(format_context).nb_streams ), " streams" ) );

		var u32 mut video_stream_index= ~0u;
		for( auto mut stream_index= 0u; stream_index < $>(format_context).nb_streams; ++stream_index )
		{
			if( $>( $>( $>( $>(format_context).streams + stream_index ) ).codecpar ).codec_type == AVMEDIA_TYPE_VIDEO )
			{
				video_stream_index= stream_index;
				break;
			}
		}

		if( video_stream_index == ~0u )
		{
			ConsoleOutAddTextLine( console_out, "Failed to get video stream" );
			avformat_close_input( $<( format_context ) );
			return;
		}

		ConsoleOutAddTextLine( console_out, ust::concat( "Video stream index is ", ust::to_string8( video_stream_index ) ) );

		var AVStream &mut stream= $>( $>( $>(format_context).streams + video_stream_index ) );

		var $(AVCodec) decoder= avcodec_find_decoder( $>( stream.codecpar ).codec_id );
		if( ust::is_nullptr( decoder ) )
		{
			ConsoleOutAddTextLine( console_out, "Failed to find decoder!" );
			avformat_close_input( $<( format_context ) );
			return;
		}

		ConsoleOutAddTextLine( console_out, ust::concat( "Found a decoder. Codec id is ", ust::to_string8( $>(decoder).id  ) ) );

		var $(AVCodecContext) decoder_context= avcodec_alloc_context3( decoder );
		if( ust::is_nullptr( decoder_context ) )
		{
			ConsoleOutAddTextLine( console_out, "Failed to alloc decoder context!" );
			avformat_close_input( $<( format_context ) );
			return;
		}

		with( ret : avcodec_parameters_to_context( decoder_context, stream.codecpar ) )
		{
			if( ret != 0 )
			{
				ConsoleOutAddTextLine( console_out, ust::concat( "avcodec_parameters_to_context failed! Error: ", GetFFmpegError( ret ) ) );
				avformat_close_input( $<( format_context ) );
				return;
			}
		}

		with( ret : avcodec_open2( decoder_context, decoder, ust::nullptr</ $(AVDictionary) />() ) )
		{
			if( ret != 0 )
			{
				ConsoleOutAddTextLine( console_out, ust::concat( "Failed to open decoder! Error: ", GetFFmpegError( ret ) ) );
				avformat_close_input( $<( format_context ) );
				return;
			}
		}

		var $(AVPacket) mut packet= av_packet_alloc();
		if( ust::is_nullptr( packet ) )
		{
			ConsoleOutAddTextLine( console_out, "Failed to alloc packet!" );
			avformat_close_input( $<( format_context ) );
			return;
		}

		var $(AVFrame) frame= av_frame_alloc();
		if( ust::is_nullptr( frame ) )
		{
			ConsoleOutAddTextLine( console_out, "Failed to alloc frame!" );
			avformat_close_input( $<( format_context ) );
			return;
		}

		var size_type mut num_frames= 0s;
		loop label frame_reading
		{
			if( av_read_frame( format_context, packet ) != 0 )
			{
				break;
			}

			if( $>(packet).stream_index == i32( video_stream_index ) )
			{
				if( avcodec_send_packet( decoder_context, packet ) < 0 )
				{
					ConsoleOutAddTextLine( console_out, "Failed to decode packet!" );
					break;
				}

				while( avcodec_receive_frame( decoder_context, frame ) >= 0 )
				{
					++num_frames;
				}
			}
		}

		ConsoleOutAddTextLine( console_out, ust::concat( "Number of frames: ", ust::to_string8( num_frames ) ) );

		/*
		var $(AVCodecParserContext) parser_context= av_parser_init( i32( $>(decoder).id ) );

		if( ust::is_nullptr( parser_context ) )
		{
			ConsoleOutAddTextLine( console_out, "Failed to init parser!" );
			avformat_close_input( $<( format_context ) );
			return;
		}
		*/

		av_packet_free( $<( packet ) );
		avformat_close_input( $<( format_context ) );
	}
}

fn GetFFmpegError( i32 code ) : ust::string8
{
	var [ char8, 256 ] mut text= zero_init;

	unsafe
	{
		av_strerror( code, $<(text[0]), size_t( typeinfo</ typeof(text) />.size_of ) );

		var size_type mut length= 0s;
		while( length < typeinfo</ typeof(text) />.element_count && text[ length ] != '\0' )
		{
			++length;
		}

		return ust::string_view8( $<(text[0]), length );
	}
}

} // namespace PM
