import "/filesystem.iu"
import "/path_utils.iu"
import "/string_conversions.iu"
import "/ffmpeg/ffmpeg.iu"
import "video_playback.iu"

namespace PM
{

fn PlayVideo( ConsoleOutPtr& console_out, ust::filesystem_path file_path )
{
	ConsoleOutAddTextLine( console_out, "Try playing a video" );

	var ust::string8 mut file_path_nt= ust::concat( "file://", ust::path::join( ust::get_current_directory(), file_path ), "\0" );
	unsafe
	{
		var $(AVFormatContext) mut context= zero_init;

		var i32 avformat_open_input_ret=
			avformat_open_input(
				$<(context),
				file_path_nt.data(),
				ust::nullptr</AVInputFormat/>(),
				ust::nullptr</ $(AVDictionary) />() );
		if( avformat_open_input_ret != 0 )
		{
			ConsoleOutAddTextLine( console_out, ust::concat( "Failed to open a video! Error: ", GetFFmpegError( avformat_open_input_ret ) ) );
		}
	}
}

fn GetFFmpegError( i32 code ) : ust::string8
{
	var [ char8, 256 ] mut text= zero_init;

	unsafe
	{
		av_strerror( code, $<(text[0]), size_t( typeinfo</ typeof(text) />.size_of ) );

		var size_type mut length= 0s;
		while( length < typeinfo</ typeof(text) />.element_count && text[ length ] != '\0' )
		{
			++length;
		}

		return ust::string_view8( $<(text[0]), length );
	}
}

} // namespace PM
