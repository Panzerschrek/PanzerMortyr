import "/ffmpeg/ffmpeg.iu"
import "video_playback.iu"

namespace PM
{

fn PlayVideo( ConsoleOutPtr& console_out, ust::filesystem_path file_path )
{
	ConsoleOutAddTextLine( console_out, "Try playing a video" );

	var ust::string8 mut file_path_nt= ust::concat( file_path, "\0" );
	unsafe
	{
		var $(AVFormatContext) mut context= zero_init;

		var i32 avformat_open_input_ret=
			avformat_open_input(
				$<(context),
				file_path_nt.data(),
				ust::nullptr</AVInputFormat/>(),
				ust::nullptr</ $(AVDictionary) />() );
		if( avformat_open_input_ret != 0 )
		{
			ConsoleOutAddTextLine( console_out, "Failed to open a video!" );
		}
	}
}

} // namespace PM
