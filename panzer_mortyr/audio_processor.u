import "audio_processor.iu"

namespace PM
{

fn AudioProcessor::constructor( ConsoleOutPtr mut console_out_ptr, GameFilesystemPtr mut game_filesystem_ptr )
	(
		game_filesystem_= move( game_filesystem_ptr ),
		audio_mixer_shared_data_( AudioMixerSharedData() ),
		audio_out_( console_out_ptr, audio_mixer_shared_data_ ),
		console_out_= move( console_out_ptr ),
	)
{
	with( mut lock : audio_mixer_shared_data_.lock_mut() )
	{
		var AudioMixerSharedData &mut d= lock.deref();

		auto mut fs_lock= game_filesystem_.lock_mut();
		auto mut sound_data_opt= LoadSoundData( console_out_, fs_lock.deref(), "WHEREIS.WAV\0\0\0\0\0" );
		if( !sound_data_opt.empty() )
		{
			d.sources.push_back(
				AudioMixerSharedData::SoundSource
				{
					.id( 123 ), // TODO - set real id.
					.sound_data( sound_data_opt.try_take() ),
					.sample_counter= 0u,
				} );
		}
	}
}

fn AudioProcessor::Update( mut this, WorldAudioInfo& world_audio_info )
{
	// Load sound files.
	// TODO - remove unused ones upon level transition.
	foreach( &sound_source : world_audio_info.sound_sources )
	{
		if( !sound_files_data_.exists( sound_source.file_name ) )
		{
			// Load a sound file if not loaded yet.
			// TODO - perform preloading at the start of the level
			auto mut fs_lock= game_filesystem_.lock_mut();
			sound_files_data_.insert_new(
				sound_source.file_name, LoadSoundData( console_out_, fs_lock.deref(), sound_source.file_name ) );
		}
	}
}

} // namespace PM
