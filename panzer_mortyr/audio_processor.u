import "/string_conversions.iu"
import "audio_processor.iu"

namespace PM
{

fn AudioProcessor::constructor(
	ConsoleOutPtr mut console_out_ptr,
	GameFilesystemPtr mut game_filesystem_ptr,
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader )
	(
		audio_out_ext_ =
			lambda[&]() : AudioOutExt
			{
				auto [ mut in_queue_write_end, mut in_queue_read_end ]= AudioMixer::InMessagesQueue::Create();
				auto [ mut out_queue_write_end, mut out_queue_read_end ]= AudioMixer::OutMessagesQueue::Create();

				return AudioOutExt
				{
					.mixer_in_messages_queue_write_end= move(in_queue_write_end),
					.mixer_out_messages_queue_read_end= move(out_queue_read_end),
					.audio_out(
						console_out_ptr,
						settings.lock_imut().deref(),
						AudioMixer( move( in_queue_read_end ), move( out_queue_write_end ) ) ),
				};
			} (),
		console_out_ptr_= move(console_out_ptr),
		game_filesystem_ptr_= move(game_filesystem_ptr),
		settings_= move(settings),
		menu_sound_index_= -1, // Set later.
	)
{
	if( !audio_out_ext_.audio_out.IsActive() )
	{
		ConsoleOutAddTextLine( console_out_ptr_, "Audio out isn't active, skip loading sounds." );
		return;
	}

	var GameResourcePtr</SoundsDescription/> sounds_description_ptr=
		lambda[&]() : GameResourcePtr</SoundsDescription/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadSoundsDescription();
			}();

	menu_sound_index_= sounds_description_ptr.deref().menu;

	// Just preload all sound files listed in the "GLOS.STD" file.
	// There are not so many of them, only around 10Mb of data total.

	// Use a hash map for deduplication, since some entires in the sounds table use the same file name.
	var ust::hash_map</ ResourceString, SoundDataNullablePtr /> mut sound_data_hash_map;

	auto& sounds_description= sounds_description_ptr.deref().sounds;

	auto mut fs_lock= game_filesystem_ptr_.lock_mut();

	var size_type mut num_sound_files_loaded= 0s, mut total_sound_data_bytes= 0s;

	for( auto mut i= 0s; i < SoundsDescription::c_num_sounds; ++i )
	{
		var ResourceString& file_name= sounds_description[i].file_name;

		if( file_name[0] == '\0' )
		{
			// Empty sound - ignore it.
			continue;
		}

		if_var( &prev_data : sound_data_hash_map.find( file_name ) )
		{
			// Already loaded a file with this name - reuse sound data for it.
			sounds_data_[i]= prev_data;
			continue;
		}

		auto mut sound_data_opt= LoadSoundData( console_out_ptr_, fs_lock.deref(), file_name );

		if( !sound_data_opt.empty() )
		{
			++num_sound_files_loaded;

			variant_visit( &el : sound_data_opt.try_deref() )
			{
				total_sound_data_bytes+= el.GetSamples().to_byte8_range().size();
			}

			var ust::shared_ptr_mt_final</ SoundDataAbstract /> data_shared_ptr( sound_data_opt.try_take() );
			sounds_data_[i]= data_shared_ptr;
			sound_data_hash_map.insert_new( file_name, data_shared_ptr );
		}
		else
		{
			// Insert a dummy if failed to load.
			sound_data_hash_map.insert_new( file_name, SoundDataNullablePtr() );
		}
	}

	ConsoleOutAddTextLine(
		console_out_ptr_,
		ust::concat(
			"Loaded ",
			ust::to_string8( num_sound_files_loaded ),
			" sound files with total size ",
			ust::to_string8( total_sound_data_bytes ),
			" bytes." ) );
}

fn AudioProcessor::Update( mut this, bool pause_world_sounds )
{
	if( !audio_out_ext_.audio_out.IsActive() )
	{
		return;
	}

	ProcessMessages();

	var bool message_pushed=
		audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
			AudioMixer::InMessageSetPaused{ .paused= pause_world_sounds } );

	// If the queue is full, try pausing/unpausing next time.
	ust::ignore_unused( message_pushed );
}

fn AudioProcessor::UpdateWord( mut this, WorldAudioInfo& world_audio_info )
{
	if( !audio_out_ext_.audio_out.IsActive() )
	{
		return;
	}

	ProcessMessages();

	var bool ambient_sound_enabled= settings_.lock_imut().deref().snd_ambient_sound_enabled;

	if( ambient_sound_enabled )
	{
		// Load ambient sounds.
		// Normally the list of ambient sounds should be changed only upon level transition,
		// so, heavy loading work is performed exactly once per level.
		// TODO - avoid reloading sound files already loaded but assigned to different slots.
		for( auto mut i= 0s; i < WorldAudioInfo::c_num_ambient_sounds; ++i )
		{
			var WorldAudioInfo::AmbientSound& in_sound= world_audio_info.ambient_sounds[i];
			var AmbientSound &mut out_sound= ambient_sounds_[i];

			if( out_sound.file_name != in_sound.file_name )
			{
				if( out_sound.playing )
				{
					// An old one is still playing.
					// Try stopping it.
					if( !out_sound.remove_message_sent )
					{
						out_sound.remove_message_sent=
							audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
								AudioMixer::InMessageRemoveAmbientSound{ .slot_index(i) } );
					}
				}
				else
				{
					// An old one is not playing anymore.
					// Can load the new one.
					out_sound.file_name= in_sound.file_name;
					out_sound.data.reset();
					out_sound.remove_message_sent= false;
					out_sound.time_s= 0.0f;

					if( in_sound.file_name[0] != '\0' )
					{
						auto mut fs_lock= game_filesystem_ptr_.lock_mut();

						auto mut sound_data_opt= LoadSoundData( console_out_ptr_, fs_lock.deref(), in_sound.file_name );
						if( !sound_data_opt.empty() )
						{
							out_sound.data= SoundDataNullablePtr( sound_data_opt.try_take() );
						}
					}
				}
			}
		}
	}

	var VolumeCalculator volume_calculator( settings_.lock_imut().deref() );

	auto &mut messages_queue_write_end= audio_out_ext_.mixer_in_messages_queue_write_end;
	auto &mut sound_sources_to_remove= sound_sources_to_remove_;

	// Send messages for sound sources removal (if not sent such message yet).
	foreach( pair : sound_sources_to_remove )
	{
		var UniqueSoundSourceId id= pair.key();
		var SoundSourceToRemove &mut sound_source_to_remove= pair.value();
		if( !sound_source_to_remove.remove_message_sent )
		{
			sound_source_to_remove.remove_message_sent=
				messages_queue_write_end.TryPush( AudioMixer::InMessageRemoveSoundSource{ .id= id } );
		}
	}

	// Set underwater flag.
	{
		var bool pushed= messages_queue_write_end.TryPush(
			AudioMixer::InMessageSetUnderwater{ .underwater= world_audio_info.enable_underwater_effect } );
		ust::ignore_unused( pushed ); // Try enabling/disabling underwater effect next time if queue if full.
	}

	// Mark used sound sources.
	//

	foreach( v : active_sound_sources_ )
	{
		v.value().used= false;
	}

	foreach( &sound_source : world_audio_info.sound_sources )
	{
		if_var( &mut active_source : active_sound_sources_.find( sound_source.id ) )
		{
			active_source.used= true;
		}
	}

	// Remove no longer used sound sources.
	//

	active_sound_sources_.retain(
		lambda[&]( UniqueSoundSourceId id, ActiveSoundSource& active_sound_source ) : bool
		{
			if( !active_sound_source.used )
			{
				if( active_sound_source.is_playing )
				{
					sound_sources_to_remove.insert_new(
						id,
						SoundSourceToRemove
						{
							.remove_message_sent=
								messages_queue_write_end.TryPush( AudioMixer::InMessageRemoveSoundSource{ .id= id } )
						} );
				}

				return false; // Need to remove.
			}
			return true; // Need to preserve.
		} );

	// Add new sources or update old ones.
	foreach( &sound_source : world_audio_info.sound_sources )
	{
		auto mut active_sound_source_opt= active_sound_sources_.find( sound_source.id );

		if( !active_sound_source_opt.empty() )
		{
			// Update.
			{
				var ActiveSoundSource &mut active_sound_source= active_sound_source_opt.try_deref();
				if( active_sound_source.is_playing )
				{
					active_sound_source.volume= sound_source.volume;

					var bool pushed=
						messages_queue_write_end.TryPush(
							AudioMixer::InMessageSetSoundSourceVolume
							{
								.id= sound_source.id,
								.volume= volume_calculator.CalculateVolume( sound_source.volume )
							} );

					// It's not a big problem if we failed to update volume if the queue is full.
					ust::ignore_unused(pushed);
				}
			}

			move(active_sound_source_opt);
		}
		else
		{
			move(active_sound_source_opt);

			// Add new one.

			if( sound_sources_to_remove.exists( sound_source.id ) )
			{
				// Avoid adding a sound source having the same ID as some previous source, which isn't removed yet.
				// Add it next time, when the previous source is removed.
				continue;
			}

			if( size_type( sound_source.sound_index ) < SoundsDescription::c_num_sounds )
			{
				var SoundDataNullablePtr& sound_data_nullable_ptr= sounds_data_[ sound_source.sound_index ];
				if( !sound_data_nullable_ptr.empty() )
				{
					if( messages_queue_write_end.TryPush(
							AudioMixer::InMessageAddSoundSource
							{
								.id= sound_source.id,
								.volume= volume_calculator.CalculateVolume( sound_source.volume ),
								.time_s= 0.0f,
								.sound_data= sound_data_nullable_ptr.try_to_non_nullable(),
							} ) )
					{
						active_sound_sources_.insert_new(
							sound_source.id,
							ActiveSoundSource
							{
								.sound_index= sound_source.sound_index,
								.volume= sound_source.volume,
								.used= true,
								.is_playing= true,
								.time_s= 0.0f,
							} );
					}
					else
					{
						// Don't create and entry in the active sound sources map if the queue is full in order to try it again next time..
					}
				}
			}
		}
	}

	if( ambient_sound_enabled )
	{
		// Start playing ambient sounds if not done this yet or update their volume.
		for( auto mut i= 0s; i < WorldAudioInfo::c_num_ambient_sounds; ++i )
		{
			var WorldAudioInfo::AmbientSound& in_ambient_sound= world_audio_info.ambient_sounds[i];
			var AmbientSound &mut ambient_sound= ambient_sounds_[i];

			if( ambient_sound.file_name == in_ambient_sound.file_name && !ambient_sound.data.empty() )
			{
				if( !ambient_sound.playing )
				{
					static_assert( WorldAudioInfo::c_num_ambient_sounds == AudioMixer::c_num_ambient_sound_slots );

					ambient_sound.playing=
						messages_queue_write_end.TryPush(
							AudioMixer::InMessageAddAmbientSound
							{
								.slot_index(i),
								.volume= volume_calculator.CalculateAmbientVolume( in_ambient_sound.volume ),
								.time_s= ambient_sound.time_s,
								.sound_data= ambient_sound.data.try_to_non_nullable(),
							} );

					if( ambient_sound.playing )
					{
						ambient_sound.volume= in_ambient_sound.volume;
					}
				}
				else
				{
					ambient_sound.volume= in_ambient_sound.volume;

					var bool pushed=
						messages_queue_write_end.TryPush(
							AudioMixer::InMessageSetAmbientSoundVolume
							{
								.slot_index(i),
								.volume= volume_calculator.CalculateAmbientVolume( in_ambient_sound.volume ),
							} );

					// It's not a big problem if we failed to update volume if the queue is full.
					ust::ignore_unused(pushed);
				}
			}
		}
	}
	else
	{
		// If ambient sounds are disabled, remove ambient sounds which are still playing.
		for( auto mut i= 0s; i < WorldAudioInfo::c_num_ambient_sounds; ++i )
		{
			var AmbientSound &mut ambient_sound= ambient_sounds_[i];

			if( ambient_sound.playing && !ambient_sound.remove_message_sent )
			{
				ambient_sound.remove_message_sent=
					messages_queue_write_end.TryPush( AudioMixer::InMessageRemoveAmbientSound{ .slot_index(i) } );
			}
		}
	}
}

fn AudioProcessor::StopAllWorldSounds( mut this )
{
	// Remove all active sounds.

	foreach( &active_sound_source : active_sound_sources_ )
	{
		if( active_sound_source.value().is_playing )
		{
			var UniqueSoundSourceId id= active_sound_source.key();
			if( !sound_sources_to_remove_.exists( id ) )
			{
				var bool message_pushed=
					audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
						AudioMixer::InMessageRemoveSoundSource{ .id= id } );

				// If the message queue if full, memorize, that a removal message should be sent and try sending it later.

				sound_sources_to_remove_.insert_new( id, SoundSourceToRemove{ .remove_message_sent= message_pushed } );
			}
		}
		else
		{
			// If this source already finished playing, no extra steps are needed.
			// It's enough to remove it from the hash-map of active sound sources.
		}
	}

	active_sound_sources_.clear();

	// Request removal of ambient sounds.

	for( auto mut i= 0s; i < WorldAudioInfo::c_num_ambient_sounds; ++i )
	{
		var AmbientSound &mut ambient_sound= ambient_sounds_[i];
		if( ambient_sound.playing )
		{
			var bool message_pushed=
				audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
					AudioMixer::InMessageRemoveAmbientSound{ .slot_index(i) } );

			// If the message queue if full, memorize, that a removal message should be sent and try sending it later.
			ambient_sound.remove_message_sent= message_pushed;
		}
	}
}

fn AudioProcessor::PlayMenuSound( mut this )
{
	if( !audio_out_ext_.audio_out.IsActive() )
	{
		return;
	}

	if( menu_sound_index_ >= 0 && menu_sound_index_ < i32( SoundsDescription::c_num_sounds ) )
	{
		auto& sound_data= sounds_data_[ size_type( menu_sound_index_ ) ];
		if( !sound_data.empty() )
		{
			// Use full volume for menu sounds and scale it by master volume.
			auto volume=
				VolumeCalculator( settings_.lock_imut().deref() ).CalculateVolume( ust::make_array( 1.0f, 1.0f ) );

			var bool pushed=
				audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
					AudioMixer::InMessageAddSingleShotSound
					{
						.sound_data= sound_data.try_to_non_nullable(),
						.volume= volume
					} );

			ust::ignore_unused( pushed ); // Can't handle full queue here.
		}
	}
}

fn nodiscard AudioProcessor::AddAudioStream(
	mut this, AudioStream::ReadEnd mut stream ) : ust::optional</AudioStream::ReadEnd/>
{
	if( !audio_out_ext_.audio_out.IsActive() )
	{
		return stream;
	}

	// Use master volume for audio streams.
	var f32 volume= ust::max( 0.0f, ust::min( 1.0f, f32( settings_.lock_imut().deref().snd_volume ) / 100.0f ) );

	auto& mut queue= audio_out_ext_.mixer_in_messages_queue_write_end;

	if( queue.GetRemainingCapacity() == 0u )
	{
		return stream; // The output queue is full for some reason. Return the given stream back.
	}

	// Now we are sure that we can push an element to the queue.
	var bool pushed= queue.TryPush( AudioMixer::InMessageAddAudioStream{ .stream= move( stream ), .volume= volume } );
	debug_assert( pushed );

	return ust::null_optional;
}

fn AudioProcessor::GetState( this ) : AudioProcessorState
{
	var size_type mut ambient_sound_index= 0s;
	auto& ambient_sounds= ambient_sounds_;

	return AudioProcessorState
	{
		.active_sound_sources=
			active_sound_sources_.iter().map(
				lambda[&]( ActiveSoundSources::iterator_element_imut& el ) : AudioProcessorState::ActiveSoundSource
				{
					var ActiveSoundSource& active_sound_source= el.value();
					return AudioProcessorState::ActiveSoundSource
					{
						.id= el.key(),
						.sound_index= active_sound_source.sound_index,
						.volume= active_sound_source.volume,
						.is_playing= active_sound_source.is_playing,
						.time_s= active_sound_source.time_s,
					};
				} ).collect</ ust::vector />(),
		.ambient_sounds
		[
			lambda[&]() : AudioProcessorState::AmbientSound
			{
				var AmbientSound& ambient_sound= ambient_sounds[ ambient_sound_index ];
				++ambient_sound_index;
				return AudioProcessorState::AmbientSound
				{
					.file_name= ambient_sound.file_name,
					.playing= ambient_sound.playing,
					.volume= ambient_sound.volume,
					.time_s= ambient_sound.time_s,
				};
			} () ...
		],
	};
}

fn AudioProcessor::SetState( mut this, AudioProcessorState& state )
{
	if( !audio_out_ext_.audio_out.IsActive() )
	{
		return;
	}

	// Make sure all old sound sources are removed.
	StopAllWorldSounds();

	// Process messages caused by world sounds stopping.
	// This may help (sometimes) stopping old sounds before starting new ones.
	ProcessMessages();

	var VolumeCalculator volume_calculator( settings_.lock_imut().deref() );

	foreach( &active_sound_source : state.active_sound_sources )
	{
		if( size_type( active_sound_source.sound_index ) < SoundsDescription::c_num_sounds )
		{
			auto& sound_data_nullable_ptr= sounds_data_[ active_sound_source.sound_index ];
			if( !sound_data_nullable_ptr.empty() )
			{
				var bool mut is_playing= false;

				if( active_sound_source.is_playing )
				{
					if( sound_sources_to_remove_.exists( active_sound_source.id ) )
					{
						// This can happen sometimes if we restore state just after stopping previous sounds and some of them aren't stopped yet.
						// We can't start playing it, since we will recieve soon a finsish message from an old source having the same ID.
						// Consider this source to be finished to avoid starting playing it again from the beginning later.
						is_playing= false;
					}
					else
					{
						var bool pushed=
							audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
								AudioMixer::InMessageAddSoundSource
								{
									.id= active_sound_source.id,
									.volume= volume_calculator.CalculateVolume( active_sound_source.volume ),
									.time_s= active_sound_source.time_s,
									.sound_data= sound_data_nullable_ptr.try_to_non_nullable(),
								} );

						// If failed to push, consider this sound to be non-playing.
						// We can't handle this case properly.
						is_playing= pushed;
					}
				}

				active_sound_sources_.insert_new(
					active_sound_source.id,
					ActiveSoundSource
					{
						.sound_index= active_sound_source.sound_index,
						.volume= active_sound_source.volume,
						.used= true,
						.is_playing= is_playing,
						.time_s= active_sound_source.time_s,
					} );
			}
		}
	}

	for( auto mut i= 0s; i < WorldAudioInfo::c_num_ambient_sounds; ++i )
	{
		var AudioProcessorState::AmbientSound& in_sound= state.ambient_sounds[i];
		var AmbientSound &mut out_sound= ambient_sounds_[i];

		if( out_sound.file_name != in_sound.file_name )
		{
			if( out_sound.playing )
			{
				// An old one is still playing.
				// Try stopping it.
				if( !out_sound.remove_message_sent )
				{
					out_sound.remove_message_sent=
						audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
							AudioMixer::InMessageRemoveAmbientSound{ .slot_index(i) } );
				}
			}
			else
			{
				// An old one is not playing anymore.
				// Can load the new one.
				out_sound.file_name= in_sound.file_name;
				out_sound.data.reset();
				out_sound.remove_message_sent= false;
				out_sound.time_s= in_sound.time_s;

				if( in_sound.file_name[0] != '\0' )
				{
					auto mut fs_lock= game_filesystem_ptr_.lock_mut();

					auto mut sound_data_opt= LoadSoundData( console_out_ptr_, fs_lock.deref(), in_sound.file_name );
					if( !sound_data_opt.empty() )
					{
						out_sound.data= SoundDataNullablePtr( sound_data_opt.try_take() );
					}
				}
			}
		}

		if( out_sound.file_name == in_sound.file_name && !out_sound.data.empty() )
		{
			out_sound.playing=
				audio_out_ext_.mixer_in_messages_queue_write_end.TryPush(
					AudioMixer::InMessageAddAmbientSound
					{
						.slot_index(i),
						.volume= volume_calculator.CalculateAmbientVolume( in_sound.volume ),
						.time_s= in_sound.time_s,
						.sound_data= out_sound.data.try_to_non_nullable(),
					} );
		}
	}
}

fn AudioProcessor::GetStats( this ) : Stats
{
	var Stats mut stats
	{
		.num_active_sound_sources= 0u,
		.num_playing_sound_sources= 0u,
		.num_active_ambient_sounds= 0u,
		.num_ambient_sound_bytes= 0u,
	};

	foreach( &active_sound_source : active_sound_sources_ )
	{
		++stats.num_active_sound_sources;

		if( active_sound_source.value().is_playing )
		{
			++stats.num_playing_sound_sources;
		}
	}

	foreach( &ambient_sound : ambient_sounds_ )
	{
		if( !ambient_sound.data.empty() )
		{
			++stats.num_active_ambient_sounds;
			variant_visit( &el : ambient_sound.data.try_deref() )
			{
				stats.num_ambient_sound_bytes+= u32( el.GetSamples().to_byte8_range().size() );
			}
		}
	}

	return stats;
}

fn AudioProcessor::ProcessMessages( mut this )
{
	// Read messages from the mixer.
	// Assume that we can process messages faster than the other thread can emit them and thus this loop ends eventually.
	loop
	{
		if_var( &message : audio_out_ext_.mixer_out_messages_queue_read_end.TryPop() )
		{
			ProcessMessage( message );
		}
		else
		{
			break;
		}
	}
}

fn AudioProcessor::ProcessMessage( mut this, AudioMixer::OutMessage& message )
{
	variant_visit( &el : message )
	{
		ProcessMessageImpl( el );
	}
}

fn AudioProcessor::ProcessMessageImpl( mut this, AudioMixer::OutMessageSoundSourceProgress& message )
{
	if_var( &mut active_sound_source : active_sound_sources_.find( message.id ) )
	{
		active_sound_source.time_s= message.time_s;
	}
}

fn AudioProcessor::ProcessMessageImpl( mut this, AudioMixer::OutMessageSoundSourceFinished& message )
{
	if_var( &mut active_sound_source : active_sound_sources_.find( message.id ) )
	{
		active_sound_source.is_playing= false;
		active_sound_source.time_s= 0.0f;
	}

	sound_sources_to_remove_.drop_if_exists( message.id );
}

fn AudioProcessor::ProcessMessageImpl( mut this, AudioMixer::OutMessageAmbientSoundProgress& message )
{
	ambient_sounds_[ message.slot_index ].time_s= message.time_s;
}

fn AudioProcessor::ProcessMessageImpl( mut this, AudioMixer::OutMessageAmbientSoundRemoved& message )
{
	var AmbientSound &mut ambient_sound= ambient_sounds_[ message.slot_index ];
	ambient_sound.playing= false;
	ambient_sound.time_s= 0.0f;
	ambient_sound.remove_message_sent= false;
}

fn AudioProcessor::ProcessMessageImpl( mut this, AudioMixer::OutMessageSingleShotSoundFinished& message )
{
	// Don't care.
	ust::ignore_unused( message );
}

fn AudioProcessor::ProcessMessageImpl( mut this, AudioMixer::OutMessageAudioStreamFinished& message )
{
	// Don't care.
	ust::ignore_unused( message );
}

class VolumeCalculator
{
public:
	fn constructor( Settings& settings )
		(
			// Use linear volume scale, it works pretty well.
			volume_scale_= ust::max( 0.0f, ust::min( 1.0f, f32( settings.snd_volume ) / 100.0f ) ),
			// We have separate volume for ambient sounds. The original game does this too.
			ambient_volume_scale_= ust::max( 0.0f, ust::min( 1.0f, f32( settings.snd_ambient_volume ) / 100.0f ) ),
			flip_stereo_= settings.snd_flip_stereo,
		)
	{}

	fn CalculateVolume( this, [ f32, 2 ]& volume ) : [ f32, 2 ]
	{
		var [ f32, 2 ] mut volume_scaled[ volume[0] * volume_scale_, volume[1] * volume_scale_ ];
		if( flip_stereo_ )
		{
			auto tmp= volume_scaled[0];
			volume_scaled[0]= volume_scaled[1];
			volume_scaled[1]= tmp;
		}
		return volume_scaled;
	}

	fn CalculateAmbientVolume( this, [ f32, 2 ]& volume ) : [ f32, 2 ]
	{
		var [ f32, 2 ] mut volume_scaled[ volume[0] * ambient_volume_scale_, volume[1] * ambient_volume_scale_ ];
		if( flip_stereo_ )
		{
			auto tmp= volume_scaled[0];
			volume_scaled[0]= volume_scaled[1];
			volume_scaled[1]= tmp;
		}
		return volume_scaled;
	}

private:
	f32 volume_scale_;
	f32 ambient_volume_scale_;
	bool flip_stereo_;
}

} // namespace PM
