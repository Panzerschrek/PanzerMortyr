import "/string.iu"

namespace PM
{

// We use an extra string table, which is hard-coded, because not all necessary strings are stored in game resources.

enum ExtraStringTableKey
{
	// Video settings page
	Fullscreen,
	Display,
	Mode,
	AutoMode,
	VerticalSynchronization,
	ChangesWillBeAppliedAfterGameRestart,
	// Key bindings page
	WalkForward,
	Backpedal,
	StepLeft,
	StepRight,
	Jump,
	Crouch,
	WalkRun,
	TurnLeft,
	TurnRight,
	LookUp,
	LookDown,
	Kick,
	Weapon1,
	Weapon2,
	Weapon3,
	Weapon4,
	Weapon5,
	Weapon6,
	Weapon7,
	Weapon8,
	Weapon9,
	Weapon10,
	Weapon11,
	UseItem,
	NextItem,
	PrevItem,
	AcidProtectionSuit,
	NightVision,
	InfraredVision,
	Flashlight,
}

fn FetchStringFromExtraTable( ExtraStringTableKey key ) : ust::string_view8;

} // namespace PM
