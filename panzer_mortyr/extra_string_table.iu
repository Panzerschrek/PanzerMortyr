	Weapon3,
	Weapon4,
	Weapon5,
	Weapon6,
	Weapon7,
	Weapon8,
	Weapon9,
	Weapon10,
	Weapon11,
	UseItem,
	NextItem,
	PrevItem,
	AcidProtectionSuit,
	NightVision,
	InfraredVision,
	Flashlight,
	Jetpack,
	// Extra settings page
	Fog,
	Mirrors,
	MirrorAlpha,
	RainSnow,
	UnderwaterEffects,
	Decals,
	WaterCircles,
	DynamicLights,
	Blood,
	TextureTrilinearFilter,
	TextureAnisotropy,
	WorldTexturesNearestFilter,
	HudTexturesNearestFilter,
