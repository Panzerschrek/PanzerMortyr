namespace PM
{

var f32 constexpr c_caustics_speed= 1.0f / 2.0f;

var u32 constexpr c_caustics_texture_size= 64u;
var u32 constexpr c_caustics_texture_num_layers= 32u;

type CausticsTextureData= [ CausticsTextureLayer, c_caustics_texture_num_layers ];
type CausticsTextureLayer= [ [ u8, c_caustics_texture_size ], c_caustics_texture_size ];

fn CreateCausticsTexture() : CausticsTextureData;

} // namespace PM
