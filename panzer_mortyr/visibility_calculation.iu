import "/common_lib/map_loading.iu"
import "camera_utils.iu"
import "room_clusters_hierarchy.iu"

namespace PM
{

type VisibleRoomClusterFlagsMut= ust::array_view_mut</bool/>;
type VisibleRoomClusterFlagsImut= ust::array_view_imut</bool/>;

fn MarkVisibleRoomClusters(
	RoomClustersHierarchy& room_clusters_hierarchy,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ZpozData& zpoz_data,
	Vec3f& camera_position,
	VisibleRoomClusterFlagsMut visible_room_cluster_flags );

fn RejectVisibleRoomClustersUsingCameraPlanes(
	ust::array_view_imut</ZvoxCluster/> clusters,
	CameraClipPlanes& camera_clip_planes,
	VisibleRoomClusterFlagsMut visible_room_cluster_flags );

fn CalculateVisibleClustersBBox(
	ust::array_view_imut</ZvoxCluster/> clusters,
	VisibleRoomClusterFlagsImut visible_room_cluster_flags,
	Vec3f& camera_position ) : BBox3f;

fn IsBBoxWithinVisibleClusters(
	ust::array_view_imut</ZvoxCluster/> clusters,
	RoomClustersHierarchy& room_clusters_hierarchy,
	VisibleRoomClusterFlagsImut visible_room_cluster_flags,
	BBox3f& bbox ) : bool;

} // namespace PM
