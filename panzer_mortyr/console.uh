import "text_drawer.uh"

namespace PM
{

class Console
{
public:
	fn constructor( [ u32, 2 ] viewport_size );

	fn Toggle( mut this );

	fn IsActive( this ) : bool;

	fn ProcessKeyPress( mut this, SDL_Keysym& key_sym );

	fn AddTextLine( mut this, ust::string8 line );

	fn Draw( this, TextDrawer &mut text_drawer );

private:
	[ u32, 2 ] imut viewport_size_;

	bool is_active_= false;
	ust::vector</ust::string8/> lines_;
	ust::string8 input_line_;
}

} // namespace PM
