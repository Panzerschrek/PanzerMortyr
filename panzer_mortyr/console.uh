import "text_drawer.uh"
import "/common_lib/string_iterators.uh"

namespace PM
{

class Console
{
public:
	fn constructor( [ u32, 2 ] viewport_size );

	fn Toggle( mut this );

	fn IsActive( this ) : bool;

	template</type ProcessorClass/>
	fn ProcessKeyPress( mut this, SDL_Keysym& key_sym, ProcessorClass &mut processor_class )
	{
		auto& processor_functions_prefix= "process_";

		if( key_sym.scancode == SDL_SCANCODE_BACKSPACE )
		{
			if( !input_line_.empty() )
			{
				input_line_.drop_back();
			}
		}
		else if( key_sym.scancode == SDL_SCANCODE_TAB )
		{
			var ust::string8 input_line_copy= input_line_;
			auto mut input_line_words_it= ust::wrap_raw_iterator( WordsIterator( input_line_copy ) );
			var ust::string_view8 command_start= input_line_words_it.next().deref_or( ust::string_view8( "" ) );

			var size_type mut num_matches= 0s;

			foreach( &function_info : typeinfo</ProcessorClass/>.functions_list )
			{
				static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
				{
					var ust::string_view8 handler_command_name=
						ust::string_view8( function_info.name ).subrange_start( typeinfo</ typeof(processor_functions_prefix) />.element_count );

					if( handler_command_name.starts_with( command_start ) )
					{
						AddTextLine( ust::concat( " " , handler_command_name ) );
						++num_matches;
					}
				}
			}
		}
		else if( key_sym.scancode == SDL_SCANCODE_RETURN )
		{
			var ust::string8 echo_line= take(input_line_);

			auto mut input_line_words_it= ust::wrap_raw_iterator( WordsIterator( echo_line ) );
			auto command_name_opt= input_line_words_it.next();
			if( command_name_opt.empty() )
			{
				return;
			}
			var ust::string_view8 command_name= command_name_opt.try_deref();


			foreach( &function_info : typeinfo</ProcessorClass/>.functions_list )
			{
				static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
				{
					var ust::string_view8 handler_command_name=
						ust::string_view8( function_info.name ).subrange_start( typeinfo</ typeof(processor_functions_prefix) />.element_count );
					if( command_name == handler_command_name )
					{
						static_if( typeinfo</ typeof( function_info.type.params_list ) />.element_count == 1s )
						{
							mixin( "processor_class." + function_info.name + "();" );
							move( input_line_words_it );
						}
						else static_if( typeinfo</ typeof( function_info.type.params_list ) />.element_count == 2s )
						{
							mixin( "processor_class." + function_info.name + "( move( input_line_words_it ) );" );
						}
						else
						{
							static_assert( "Unexpected number of params in command processor class!" );
						}

						AddTextLine( echo_line );
						return;
					}
				}
			}

			AddTextLine( ust::concat( "Command '", command_name, "', not found" ) );
		}
	}

	fn ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event );

	fn AddTextLine( mut this, ust::string8 line );

	fn Draw( this, TextDrawer &mut text_drawer );

private:
	[ u32, 2 ] imut viewport_size_;

	bool is_active_= false;
	ust::vector</ust::string8/> lines_;
	ust::string8 input_line_;
}

} // namespace PM
