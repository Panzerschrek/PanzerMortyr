import "text_drawer.uh"

namespace PM
{

class Console
{
public:
	fn constructor( [ u32, 2 ] viewport_size );

	fn Toggle( mut this );

	fn IsActive( this ) : bool;

	template</type ProcessorClass/>
	fn ProcessKeyPress( mut this, SDL_Keysym& key_sym, ProcessorClass &mut processor_class )
	{
		if( key_sym.scancode == SDL_SCANCODE_BACKSPACE )
		{
			if( !input_line_.empty() )
			{
				input_line_.drop_back();
			}
		}
		else if( key_sym.scancode == SDL_SCANCODE_RETURN )
		{
			var ust::string8 mut echo_line= take(input_line_);

			auto& processor_functions_prefix= "process_";

			foreach( &function_info : typeinfo</ProcessorClass/>.functions_list )
			{
				static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
				{
					var ust::string_view8 handler_command_name=
						ust::string_view8( function_info.name ).subrange_start( typeinfo</ typeof(processor_functions_prefix) />.element_count );
					if( echo_line == handler_command_name )
					{
						mixin( "processor_class." + function_info.name + "();" );
					}
				}
			}

			AddTextLine( move(echo_line) );
		}
	}

	fn ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event );

	fn AddTextLine( mut this, ust::string8 line );

	fn Draw( this, TextDrawer &mut text_drawer );

private:
	[ u32, 2 ] imut viewport_size_;

	bool is_active_= false;
	ust::vector</ust::string8/> lines_;
	ust::string8 input_line_;
}

} // namespace PM
