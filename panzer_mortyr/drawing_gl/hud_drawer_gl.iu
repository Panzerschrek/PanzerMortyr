import "../abstract_hud_drawer.iu"
import "../game_filesystem.iu"
import "../settings.iu"
import "../vertex_formats.iu"
import "buffer_object.iu"
import "shader_program.iu"
import "texture.iu"
import "vertex_array_object.iu"

namespace PM
{

class HudDrawerGL final : AbstractHudDrawer
{
public:
	fn constructor(
		[ u32, 2 ] viewport_size,
		GameFilesystemPtr& game_filesystem_ptr,
		ConsoleOutPtr& console_out,
		Settings& settings );

protected: // AbstractHudDrawer
	fn virtual final AddTileQuad( mut this, i32 x, i32 y, HudDrawingInfo::IconIndex tile_index );
	fn virtual final AddDigitQuad( mut this, i32 x, i32 y, u32 digit_index, bool alternative_color );

	fn virtual final FlushDrawQuads( mut this );

private:
	fn LoadHudTextureAtlas(
		GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out, Settings& settings ) : Texture;

private:
	// Should be enough to display all stats (with 3-digit numbers) and several active items.
	var size_type c_max_buffer_size_quads= 32s;

private:
	ShaderProgram shader_;
	VertexArrayObject vertex_array_object_;
	BufferObject vertex_buffer_;
	BufferObject index_buffer_;
	Texture hud_texture_atlas_;

	size_type num_buffered_quads_;
	[ [ HudVertex, 4 ], c_max_buffer_size_quads ] buffered_quads_;
}

} // namespace PM
