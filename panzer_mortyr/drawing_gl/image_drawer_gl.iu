import "../abstract_image_drawer.iu"
import "../game_filesystem.iu"
import "../settings.iu"
import "shader_program.iu"
import "texture.iu"
import "vertex_array_object.iu"

namespace PM
{

class ImageDrawerGL final : AbstractImageDrawer
{
public:
	fn constructor( [ u32, 2 ] viewport_size, GameFilesystemPtr game_filesystem_ptr, SettingsPtr& settings );

	fn virtual final PreloadImage(
		mut this, ResourceString& image_file_name, ust::optional_ref_imut</ [ u8, 3 ] /> transparent_color );

	fn virtual final GetImageSize( this, ResourceString& image_file_name ) : ust::optional</ [ u32, 2 ] />;

	fn virtual final DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale );
	fn virtual final DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale, u8 alpha );

	fn virtual final DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y );

	fn virtual final DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y,
		u8 alpha );

	fn virtual final UploadAndDrawImage( mut this, ImageData& image_data, i32 x, i32 y, f32 scale );

private:
	struct TextureExt
	{
		Texture texture;
		[ u32, 2 ] size;
	}

private:
	GameFilesystemPtr imut game_filesystem_ptr_;
	bool imut use_nearest_texture_filter_;
	[ u32, 2 ] imut viewport_size_;

	VertexArrayObject vertex_array_object_; // Just a dummy to avoid OpenGL warnings.
	ShaderProgram shader_;

	ust::hash_map</ ResourceString, ust::optional</TextureExt/> /> textures_;

	Texture temp_texture_;
}

} // namespace PM
