import "/sdl/sdl_with_opengl.iu"

namespace PM
{

// Basic RAII wrapper for OpenGL framebuffer object.
class FramebufferObject
{
public:
	fn constructor();
	fn destructor();

	fn Bind( this );

	fn BindScreenFramebuffer();

private:
	GLuint imut framebuffer_object_;
}

static_assert( !typeinfo</FramebufferObject/>.is_copy_constructible && !typeinfo</FramebufferObject/>.is_copy_assignable );

} // namespace PM
