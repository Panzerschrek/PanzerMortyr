import "buffer_object.iu"
import "../caching_game_resources_loader.iu"
import "../lighting.iu"
import "../map_visibility_calculator.iu"
import "../vertex_formats.iu"
import "../water_circles_hierarchy.iu"
import "gpu_model.iu"
import "sky.iu"
import "texture.iu"
import "vertex_array_object.iu"

namespace PM
{

struct DynamicPolygonsBuffer
{
	ust::vector</MapVertex/> vertices;
	BufferObject vertex_buffer;
	size_type imut max_vertices;

	ust::vector</u16/> indices;
	BufferObject index_buffer;
	size_type imut max_indices;

	VertexArrayObject vertex_array_object;
}

struct MapDrawDataGL
{
	GameResourcePtr</ZmapData/> zmap_data;
	GameResourcePtr</ZvoxData/> zvox_data;
	GameResourcePtr</ZmapLamData/> zmap_lam_data;
	GameResourcePtr</ZmapLemData/> zmap_lem_data;
	GameResourcePtr</RoomClustersHierarchy/> room_clusters_hierarchy;
	GameResourcePtr</QuadsHierarchy/> quads_hierarchy;

	ust::shared_ptr_final</RoomClustersBSPTree/> room_clusters_bsp_tree;

	ust::vector</PointLightSource/> light_sources;

	VertexArrayObject vertex_array_object;

	// Store all vertices in single buffer.
	BufferObject vertex_buffer;

	// Store all indices in single buffer.
	BufferObject index_buffer;

	// Store all map textures in single textures array - we can do this, since all map textrures have identical size.
	Texture map_textures_array;
	u32 clouds_texture_layer;

	// Has size equal to number of map clusters.
	ust::vector</ClusterDrawData/> clusters_draw_data;

	[ GeometryBufferChunk, 4 ] special_material_valve_meshes;
	[ GeometryBufferChunk, 8 ] special_material_film_meshes;

	SkySphereBuffer sky_sphere_buffer;
	StarsBuffer stars_buffer;
	bool use_two_cloud_layers;

	SnowRainBuffer snow_rain_buffer;

	[ f32, 3 ] fog_color;
	bool global_fog_enabled;

	BitArray breakable_material_bits;
	BitArray wet_material_bits;

	// Is empty if no water circles are needed for this map (there is no rain).
	WaterCirclesHierarchy water_circles_heirarchy;
}

struct MapFullDrawDataGL
{
	MapDrawDataGL imut map_draw_data;

	// #0 is for main pass visibility, #1 is for mirrors.
	[ MapVisibilityCalculator, 2 ] map_visibility_calculators;
}

struct SnowRainBuffer
{
	VertexArrayObject vertex_array_object;
	BufferObject vertex_buffer;
}

// A mesh stored in some vertex/index buffer (containing also other meshes).
struct GeometryBufferChunk
{
	// Use here 32-bit numbers - it's enough.

	// Offset into vertex array.
	u32 first_vertex_index;
	// Offset into index array.
	u32 first_index;
	// Number of indices is equal to number of triangles multiplied by 3.
	u32 num_indices;
}

struct ClusterDrawData
{
	GeometryBufferChunk geometry_buffer_chunk;

	bool has_glass_quads;
	bool has_liquid_quads;
	bool has_breakable_quads;
	bool has_mirror_quads;
}

struct ModelToDraw
{
	ResourceString file_name;
	WorldDrawingInfo::ModelFrames frames;
	Mat4f matrix;
	SphericalHarmonicsRGB light;
	f32 burning_strength;
	u8 blood_coverage; // 0 - no coverage, 1 - medium coverage, 2 - full coverage.
}

struct GlobalLightParams
{
	[ f32, 3 ] light_add;
	[ f32, 3 ] light_scale;
}

type ModelsMapGL= ust::hash_map</ ResourceString, ust::optional</GPUModel/> />;

} // namespace PM
