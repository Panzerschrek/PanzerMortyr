import "world_drawer_gl_supersampled.iu"

namespace PM
{

fn WorldDrawerGLSupersampled::constructor(
	[ u32, 2 ] viewport_size,
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader,
	ConsoleOutPtr mut console_out,
	GLCapabilities& gl_capabilities )
	(
		supersampled_buffer_resolve_shader_(
			embed</ char8 />( "shaders/ssaa.vert.glsl" ), embed</ char8 />( "shaders/ssaa.frag.glsl" ) ),
		internal_drawer_(
			viewport_size,
			move(settings),
			move(caching_game_resources_loader),
			move(console_out),
			gl_capabilities )
	)
{}

fn WorldDrawerGLSupersampled::Draw( mut this, WorldDrawingInfo mut drawing_info ) : WorldDrawingStats
{
	return internal_drawer_.Draw( move( drawing_info ) );
}

} // namespace PM
