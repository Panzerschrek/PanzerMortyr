import "gl_functions.iu"
import "world_drawer_gl_supersampled.iu"

namespace PM
{

fn WorldDrawerGLSupersampled::constructor(
	[ u32, 2 ] viewport_size,
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader,
	ConsoleOutPtr mut console_out,
	GLCapabilities& gl_capabilities )
	(
		supersampled_buffer_resolve_shader_(
			embed</ char8 />( "shaders/ssaa.vert.glsl" ), embed</ char8 />( "shaders/ssaa.frag.glsl" ) ),
		internal_drawer_(
			viewport_size,
			move(settings),
			move(caching_game_resources_loader),
			move(console_out),
			gl_capabilities ),
		framebuffer_object_(0), // Set later.
		color_texture_= Texture::Create( GLenum( GL_TEXTURE_2D ) ),
		depth_texture_= Texture::Create( GLenum( GL_TEXTURE_2D ) ),
	)
{
	var u32 scale= 2u;

	color_texture_.Bind();

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( viewport_size[0] * scale ),
		GLsizei( viewport_size[1] * scale ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::nullptr</byte8/>() ) );

	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_NEAREST ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST ) ) );

	depth_texture_.Bind();

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_DEPTH24_STENCIL8 ),
		GLsizei( viewport_size[0] * scale ),
		GLsizei( viewport_size[1] * scale ),
		0,
		GLenum( GL_DEPTH_STENCIL ),
		GLenum( GL_UNSIGNED_INT_24_8 ),
		ust::nullptr</byte8/>() ) );

	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_NEAREST ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST ) ) );

	unsafe( glGenFramebuffers( 1, $<( framebuffer_object_ ) ) );
	unsafe( glBindFramebuffer( GLenum( GL_FRAMEBUFFER ), framebuffer_object_ ) );

	unsafe( glFramebufferTexture(
		GLenum( GL_FRAMEBUFFER ), GLenum( GL_COLOR_ATTACHMENT0 ), color_texture_.GetTextureObject(), 0 ) );
	unsafe( glFramebufferTexture(
		GLenum( GL_FRAMEBUFFER ), GLenum( GL_DEPTH_STENCIL_ATTACHMENT ), depth_texture_.GetTextureObject(), 0 ) );

	unsafe( glBindFramebuffer( GLenum( GL_FRAMEBUFFER ), 0u ) );
}

fn WorldDrawerGLSupersampled::destructor()
{
	unsafe( glDeleteFramebuffers( 1, $<( framebuffer_object_ ) ) );
}

fn WorldDrawerGLSupersampled::Draw( mut this, WorldDrawingInfo mut drawing_info ) : WorldDrawingStats
{
	return internal_drawer_.Draw( move( drawing_info ) );
}

} // namespace PM
