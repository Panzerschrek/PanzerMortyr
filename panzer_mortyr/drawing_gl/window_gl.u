import "/stdout.iu"
import "/stringification.iu"
import "../window_common.iu"
import "gl_functions.iu"
import "window_gl.iu"

namespace PM
{

fn WindowGL::Create( SettingsPtr mut settings, ConsoleOutPtr& console_out ) : ust::optional</WindowGL/>
{
	if( unsafe( SDL_Init( SDL_INIT_VIDEO ) ) != 0 )
	{
		ConsoleOutAddTextLine( console_out, "SDL video init failed!" );
		return ust::null_optional;
	}

	var bool use_gl_debugging= compiler::options::generate_debug_info || compiler::options::optimization_level == '0';

	unsafe
	{
		SDL_GL_SetAttribute( SDL_GL_DOUBLEBUFFER, 1 );
		SDL_GL_SetAttribute( SDL_GL_DEPTH_SIZE, 24 );

		if( use_gl_debugging )
		{
			SDL_GL_SetAttribute( SDL_GL_CONTEXT_FLAGS, i32( SDL_GL_CONTEXT_DEBUG_FLAG ) );
		}

		SDL_GL_SetAttribute( SDL_GL_CONTEXT_MAJOR_VERSION, 3 );
		SDL_GL_SetAttribute( SDL_GL_CONTEXT_MINOR_VERSION, 3 );
		SDL_GL_SetAttribute( SDL_GL_CONTEXT_PROFILE_MASK, i32( SDL_GL_CONTEXT_PROFILE_CORE ) );
	}

	var [ u32, 2 ] mut viewport_size=
		lambda[&]() : [ u32, 2 ]
		{
			auto lock= settings.lock_imut();
			var Settings& s= lock.deref();
			return ust::make_array( s.r_screen_width, s.r_screen_height );
		} ();

	var Uint32 mut window_flags( SDL_WINDOW_OPENGL );

	var u32 display_index= GetAndActualizeDisplayIndex( settings, console_out );

	if( settings.lock_imut().deref().r_fullscreen )
	{
		SelectFullscreenMode( viewport_size, display_index, console_out );
		window_flags|= Uint32( SDL_WINDOW_FULLSCREEN );
	}
	else
	{
		SelectWindowedMode( viewport_size, display_index, console_out );
	}

	ConsoleOutAddTextLine(
		console_out,
		ust::stringify8(
			"Creating a window with size ",
			cast_imut(viewport_size)[0],
			"x",
			cast_imut(viewport_size)[1],
			"." ) );

	var $(SDL_Window) window=
		unsafe( SDL_CreateWindow(
			$<( cast_mut( c_window_caption_nt[0] ) ),
			SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
			i32(viewport_size[0]), i32(viewport_size[1]),
			window_flags ) );

	if( ust::is_nullptr( window ) )
	{
		ConsoleOutAddTextLine( console_out, "Failed to create window!" );
		return ust::null_optional;
	}

	// TODO - set window icon?

	var SDL_GLContext gl_context= unsafe( SDL_GL_CreateContext( window ) );
	if( ust::is_nullptr( gl_context ) )
	{
		ConsoleOutAddTextLine( console_out, "Failed to create OpenGL context!" );
		unsafe( SDL_DestroyWindow( window ) );
		return ust::null_optional;
	}

	InitializeGLFunctionPointers();

	if( use_gl_debugging )
	{
		unsafe
		{
			auto ptr= glDebugMessageCallback;
			if( !ust::is_nullptr( ptr ) )
			{
				ptr( GLDebugCallback, ust::nullptr</byte8/>() );
			}
		}
	}

	ConsoleOutAddTextLine( console_out, "OpenGL configuration:" );
	ConsoleOutAddTextLine(
		console_out, ust::concat( " vendor: ", unsafe( GetGLStringPretty( GLenum( GL_VENDOR ) ) ) ) );
	ConsoleOutAddTextLine(
		console_out, ust::concat( " renderer: ", unsafe( GetGLStringPretty( GLenum( GL_RENDERER ) ) ) ) );
	ConsoleOutAddTextLine(
		console_out, ust::concat( " version: ", unsafe( GetGLStringPretty( GLenum( GL_VERSION ) ) ) ) );

	return unsafe( WindowGL( move(settings), window, gl_context ) );
}

fn WindowGL::constructor( SettingsPtr mut settings, $(SDL_Window) window, SDL_GLContext gl_context ) unsafe
	(
		window_= window,
		gl_context_= gl_context,
		prev_gamma_= ReadGamma( settings ),
		prev_vsync_= settings.lock_imut().deref().r_vsync,
		settings_= move(settings),
	)
{
	unsafe( SetWindowGamma( window_, prev_gamma_ ) );
	unsafe( SDL_GL_SetSwapInterval( ( prev_vsync_ ? 1 : 0 ) ) );
}

fn WindowGL::destructor()
{
	unsafe( SDL_GL_DeleteContext( gl_context_ ) );
	unsafe( SDL_DestroyWindow( window_ ) );
}

fn WindowGL::GetViewportSize( this ) : [ u32, 2 ]
{
	var i32 mut w= 0, mut h= 0;
	unsafe( SDL_GL_GetDrawableSize( window_, $<(w), $<(h) ) );
	return ust::make_array( u32(w), u32(h) );
}

fn WindowGL::SwapWindow( mut this )
{
	unsafe( SDL_GL_SwapWindow( window_ ) );

	// Update vsync each frame (if vsync setting was changed).
	UpdateVsync();

	// Update gamma each frame if necessary (if gamma settings was changed).
	UpdateGamma();
}

fn WindowGL::MakeScreenshot( mut this ) : ImageData
{
	var [ u32, 2 ] viewport_size= GetViewportSize();

	var ImageData mut image_data
	{
		.size= viewport_size,
		.pixels( size_type( viewport_size[0] * viewport_size[1] ), ust::make_zeroed</RGBAColor/>() ),
	};

	unsafe( glReadPixels(
		0, 0,
		GLsizei( image_data.size[0] ), GLsizei( image_data.size[1] ),
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		image_data.pixels.range().to_byte8_range().data() ) );

	return image_data;
}

fn WindowGL::Fill( mut this, RGBAColor& color )
{
	unsafe( glClearColor(
		f32( color[0] ) / 255.0f,
		f32( color[1] ) / 255.0f,
		f32( color[2] ) / 255.0f,
		f32( color[3] ) / 255.0f ) );

	unsafe( glClear( GLbitfield( GL_COLOR_BUFFER_BIT ) ) );
}

fn WindowGL::UpdateVsync( mut this )
{
	var bool vsync= settings_.lock_imut().deref().r_vsync;
	if( vsync != prev_vsync_ )
	{
		prev_vsync_= vsync;
		unsafe( SDL_GL_SetSwapInterval( ( vsync ? 1 : 0 ) ) );
	}
}

fn WindowGL::UpdateGamma( mut this )
{
	var f32 gamma= ReadGamma( settings_ );
	if( gamma != prev_gamma_ )
	{
		prev_gamma_= gamma;
		unsafe( SetWindowGamma( window_, gamma ) );
	}
}

fn GLDebugCallback(
	GLenum source,
	GLenum type_,
	GLuint id,
	GLenum severity,
	GLsizei length,
	$(GLchar) message,
	$(byte8) user_param ) unsafe call_conv( typeinfo</PFNGLDEBUGMESSAGECALLBACKPROC/>.params_list[0].type.call_conv )
{
	ust::ignore_unused( source );
	ust::ignore_unused( type_ );
	ust::ignore_unused( id );
	ust::ignore_unused( user_param );

	if( severity == GLenum( GL_DEBUG_SEVERITY_NOTIFICATION ) )
	{
		return; // Do not care.
	}

	ust::stderr_print(
		ust::concat(
			"OpenGL debug message:\n",
			unsafe( ust::string_view8( message, size_type( length ) ) ),
			"\n\n" ) );
}

fn GetGLStringPretty( GLenum kind ) unsafe : ust::string_view8
{
	unsafe
	{
		var $(GLubyte) mut start= glGetString( kind );
		var size_type mut size= 0s;
		while( $>( start + size ) != GLubyte(0) )
		{
			++size;
		}
		return ust::string_view8( ust::byte_ptr_cast</char8/>( ust::ptr_cast_to_byte8( start ) ), size );
	}
}

} // namespace PM
