import "framebuffer_object.iu"
import "gl_functions.iu"

namespace PM
{

fn FramebufferObject::constructor()(
	framebuffer_object_=
		unsafe( lambda[]() unsafe : GLuint
		{
			var GLuint mut framebuffer= zero_init;
			unsafe( glGenFramebuffers( 1, $<( framebuffer ) ) );
			return framebuffer;
		} () ) )
{}

fn FramebufferObject::destructor()
{
	unsafe( glDeleteFramebuffers( 1, $<( cast_mut( framebuffer_object_ ) ) ) );
}

fn FramebufferObject::Bind( this )
{
	unsafe( glBindFramebuffer( GLenum( GL_FRAMEBUFFER ), framebuffer_object_ ) );
}

fn FramebufferObject::BindScreenFramebuffer()
{
	unsafe( glBindFramebuffer( GLenum( GL_FRAMEBUFFER ), 0u ) );
}

} // namespace PM
