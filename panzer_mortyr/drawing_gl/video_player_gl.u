import "/assert.iu"
import "/string_conversions.iu"
import "../video_stream.iu"
import "gl_state.iu"
import "video_player_gl.iu"

namespace PM
{

fn VideoPlayerGL::constructor( ust::shared_ptr_mut</WindowGL/> mut window, ConsoleOutPtr mut console_out )
	(
		base( move(console_out ) ),
		window_= move(window),
		shader_( embed</char8/>( "shaders/video.vert.glsl" ), embed</char8/>( "shaders/video.frag.glsl" ) ),
		frame_size_[ 0u, 0u ],
		frame_texture_= Texture::Create( GLenum( GL_TEXTURE_2D ) ),
	)
{}

fn VideoPlayerGL::SetFrame( mut this, [ u32, 2 ] size, ust::array_view_imut</RGBAColor/> pixels )
{
	frame_size_= size;

	frame_texture_.Bind();

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( size[0] ),
		GLsizei( size[1] ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		pixels.to_byte8_range().data() ) );

	// Use linear filter.
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );

	// Clamp texture coordinates to edge.
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_WRAP_S ), GLint( GL_CLAMP_TO_EDGE ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_WRAP_T ), GLint( GL_CLAMP_TO_EDGE ) ) );
}

fn VideoPlayerGL::DrawAndPresentFrame( mut this )
{
	var f32 video_aspect_ratio= f32( frame_size_[0] ) / f32( frame_size_[1] );

	var [ u32, 2 ] viewport_size= window_.lock_imut().deref().GetViewportSize();
	var f32 viewport_aspect_ratio= f32( viewport_size[0] ) / f32( viewport_size[1] );

	var Vec2f normalized_scale=
		( video_aspect_ratio <= viewport_aspect_ratio
			? Vec2f( 2.0f * video_aspect_ratio / viewport_aspect_ratio, 2.0f )
			: Vec2f( 2.0f, 2.0f * viewport_aspect_ratio / video_aspect_ratio ) );

	// Clear color buffer around the video.
	// We need this if video's aspect ratio isn't equal to viewport's aspect ratio.
	SetGLState( g_buffer_clear_gl_state );
	unsafe( glClearColor( GLclampf(0.0), GLclampf(0.0), GLclampf(0.0f), GLclampf(1.0) ) );
	unsafe( glClear( GLbitfield( GL_COLOR_BUFFER_BIT  ) ) );

	SetGLState( g_video_drawing_gl_state );

	var u32 texture_slot= 0u;

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	frame_texture_.Bind();

	shader_.Bind();
	shader_.SetUniform( "fu_texture", texture_slot );
	shader_.SetUniform( "v_scale", normalized_scale );

	// Draw 2 triangles. Vertex coordinates and texture coordinates are generated by the shader.
	unsafe( glDrawArrays( GLenum( GL_TRIANGLES ), GLint(0), GLsizei(6) ) );

	with( mut lock : window_.lock_mut() )
	{
		lock.deref().SwapWindow();
	}
}

var GLState g_buffer_clear_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= true,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

var GLState g_video_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= true,
	.blend_source_factor( GL_SRC_ALPHA ),
	.blend_destination_factor( GL_ONE_MINUS_SRC_ALPHA ),
};

} // namespace PM
