import "../abstract_video_player.iu"
import "../performance_counter.iu"
import "shader_program.iu"
import "texture.u"
import "window_gl.iu"

namespace PM
{

class VideoPlayerGL final : AbstractVideoPlayer
{
public:
	fn constructor( ust::shared_ptr_mut</WindowGL/> window, ConsoleOutPtr console_out );

	fn virtual final PlayVideo( mut this, ust::filesystem_path_view file_path, AudioProcessor &mut audio_processor );

protected: // AbstractVideoPlayer
	fn virtual final SetFrame( mut this, [ u32, 2 ] size, ust::array_view_imut</RGBAColor/> pixels );

private:
	ust::shared_ptr_mut</WindowGL/> imut window_;
	ConsoleOutPtr imut console_out_;
	PerformanceCounter imut performance_counter_;
	Texture texture_;
	ShaderProgram shader_;
}

} // namespace PM
