import "gl_functions.iu"
import "gl_state.iu"
import "world_drawer_gl_fxaa.iu"

namespace PM
{

fn WorldDrawerGLFXAA::constructor(
	[ u32, 2 ] viewport_size,
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader,
	ConsoleOutPtr mut console_out,
	GLCapabilities& gl_capabilities )
	(
		fxaa_buffer_resolve_shader_(
			embed</ char8 />( "shaders/fxaa.vert.glsl" ), embed</ char8 />( "shaders/fxaa.frag.glsl" ) ),
		color_texture_= Texture::Create( GLenum( GL_TEXTURE_2D ) ),
		depth_texture_= Texture::Create( GLenum( GL_TEXTURE_2D ) ),
		internal_drawer_(
			viewport_size,
			move(settings),
			move(caching_game_resources_loader),
			move(console_out),
			gl_capabilities ),
	)
{
	color_texture_.Bind();

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( viewport_size[0] ),
		GLsizei( viewport_size[1] ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::nullptr</byte8/>() ) );

	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_NEAREST ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST ) ) );

	depth_texture_.Bind();

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_DEPTH24_STENCIL8 ),
		GLsizei( viewport_size[0] ),
		GLsizei( viewport_size[1] ),
		0,
		GLenum( GL_DEPTH_STENCIL ),
		GLenum( GL_UNSIGNED_INT_24_8 ),
		ust::nullptr</byte8/>() ) );

	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_NEAREST ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST ) ) );

	framebuffer_object_.Bind();

	unsafe( glFramebufferTexture(
		GLenum( GL_FRAMEBUFFER ), GLenum( GL_COLOR_ATTACHMENT0 ), color_texture_.GetTextureObject(), 0 ) );
	unsafe( glFramebufferTexture(
		GLenum( GL_FRAMEBUFFER ), GLenum( GL_DEPTH_STENCIL_ATTACHMENT ), depth_texture_.GetTextureObject(), 0 ) );

	FramebufferObject::BindScreenFramebuffer();
}

fn WorldDrawerGLFXAA::Draw( mut this, WorldDrawingInfo mut drawing_info ) : WorldDrawingStats
{
	framebuffer_object_.Bind();

	var WorldDrawingStats stats= internal_drawer_.Draw( move( drawing_info ) );

	FramebufferObject::BindScreenFramebuffer();

	SetGLState( g_framebuffer_resolve_gl_state );

	var u32 texture_slot= 0u;
	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	color_texture_.Bind();

	fxaa_buffer_resolve_shader_.Bind();
	fxaa_buffer_resolve_shader_.SetUniform( "fu_texture", texture_slot );

	// Draw single triangle covering the entire screen.
	unsafe( glDrawArrays( GLenum( GL_TRIANGLES ), GLint(0), GLsizei(3) ) );

	return stats;
}

var GLState g_framebuffer_resolve_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= false,
	.depth_test_func( GL_NONE ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= false,
	.blend_source_factor( GL_INVALID_ENUM ),
	.blend_destination_factor( GL_INVALID_ENUM ),
};

} // namespace PM
