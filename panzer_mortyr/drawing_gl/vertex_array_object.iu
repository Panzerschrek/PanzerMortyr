import "/sdl/sdl_with_opengl.iu"

namespace PM
{

// Basic RAII wrapper over OpenGL vertex array object.
class VertexArrayObject
{
public:
	fn constructor();
	fn destructor();

public:
	fn Bind( this );

private:
	GLuint imut vertex_array_object_;
}

static_assert( !typeinfo</VertexArrayObject/>.is_copy_constructible && !typeinfo</VertexArrayObject/>.is_copy_assignable );

} // namespace PM
