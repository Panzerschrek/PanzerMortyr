import "/sdl/sdl_with_opengl.iu"
import "../abstract_window.iu"
import "../console_out.iu"
import "../settings.iu"

namespace PM
{

// A RAII class for creating/destroying a window with OpenGL output support.
class WindowGL final : AbstractWindow
{
public:
	fn Create( SettingsPtr settings, ConsoleOutPtr& console_out ) : ust::optional</WindowGL/>;

	// Constructor for internal usage.
	fn constructor( SettingsPtr settings, $(SDL_Window) window, SDL_GLContext gl_context ) unsafe;

	fn destructor();

public: // AbstractWindow
	fn virtual final GetViewportSize( this ) : [ u32, 2 ];

	fn virtual final SwapWindow( mut this );

	fn virtual final MakeScreenshot( mut this ) : ImageData;

	fn virtual final Fill( mut this, RGBAColor& color );

private:
	fn UpdateVsync( mut this );
	fn UpdateGamma( mut this );

private:
	SettingsPtr imut settings_;
	$(SDL_Window) imut window_;
	SDL_GLContext imut gl_context_;

	bool prev_vsync_;
	f32 prev_gamma_;
}

static_assert( !typeinfo</WindowGL/>.is_copy_constructible && !typeinfo</WindowGL/>.is_copy_assignable );

} // namespace PM
