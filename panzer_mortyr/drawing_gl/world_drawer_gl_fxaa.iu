import "framebuffer_object.iu"
import "world_drawer_gl.iu"

namespace PM
{

class WorldDrawerGLFXAA final : AbstractWorldDrawer
{
public:
	fn constructor(
		[ u32, 2 ] viewport_size,
		SettingsImutPtr settings,
		CachingGameResourcesLoaderPtr caching_game_resources_loader,
		ConsoleOutPtr console_out,
		GLCapabilities& gl_capabilities );

	fn virtual final Draw( mut this, WorldDrawingInfo drawing_info ) : WorldDrawingStats;

private:
	ShaderProgram fxaa_buffer_resolve_shader_;

	FramebufferObject framebuffer_object_;
	Texture color_texture_;
	Texture depth_texture_;

	// Keep it last, since it's heavy.
	WorldDrawerGL internal_drawer_;
}

} // namespace PM
