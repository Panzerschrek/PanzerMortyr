import "/scoped_array.iu"
import "../image_data.iu"
import "../model_common.iu"
import "../vertex_formats.iu"
import "gl_functions.iu"
import "gpu_model.iu"

namespace PM
{

fn CreateGPUModel( ModelData& model_data, Settings& settings, GLCapabilities& gl_capabilities ) : GPUModel
{
	var VertexArrayObject mut vertex_array_object;

	var BufferObject mut texture_coordinates_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			model_data.texture_coordinates.range().to_byte8_range() );

	var ust::vector</ModelFrameVertex/> frame_vertices= CreateModelFrameVertices( model_data );

	var BufferObject mut positions_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			frame_vertices.range().to_byte8_range() );

	// Create index buffer only for LOD0 triangles.
	// We don't care about geometry of other LODs, even LOD0 models are pretty low-detail.

	var size_type num_lod0_triangles( model_data.num_lod0_triangles );

	var ust::vector</u16/> mut indices( num_lod0_triangles * 3s, 0u16 );

	for( auto mut i= 0s; i < num_lod0_triangles; ++i )
	{
		var ObbTriangle& triangle= model_data.triangles[i];

		// Original indices are multiplied by 2, divide them back.
		indices[ i * 3s + 0s ]= u16( triangle[0] >> 1 );
		indices[ i * 3s + 1s ]= u16( triangle[1] >> 1 );
		indices[ i * 3s + 2s ]= u16( triangle[2] >> 1 );
	}

	var BufferObject mut index_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ELEMENT_ARRAY_BUFFER ), // Needed for a triangle indices source.
			indices.range().to_byte8_range() );

	vertex_array_object.Bind();

	texture_coordinates_buffer.Bind();

	unsafe( glEnableVertexAttribArray( GPUModel::c_texture_coordinates_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_texture_coordinates_attrib,
		2,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ObbVertexTextureCoordinates/>.size_of ),
		ust::nullptr</byte8/>() ) );

	positions_buffer.Bind();

	unsafe( glEnableVertexAttribArray( GPUModel::c_position0_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_position0_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ ModelFrameVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( GPUModel::c_position1_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_position1_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ ModelFrameVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( GPUModel::c_normal0_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_normal0_attrib,
		3,
		GLenum( GL_BYTE ),
		GLboolean(1),
		GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ ModelFrameVertex, "normal" />() ) );

	unsafe( glEnableVertexAttribArray( GPUModel::c_normal1_attrib ) );

	unsafe( glVertexAttribPointer(
		GPUModel::c_normal1_attrib,
		3,
		GLenum( GL_BYTE ),
		GLboolean(1),
		GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ ModelFrameVertex, "normal" />() ) );

	index_buffer.Bind();

	return GPUModel
	{
		.num_vertices( model_data.num_vertices ),
		.num_triangles( model_data.num_lod0_triangles ),
		.num_frames( model_data.num_frames ),
		.vertex_array_object= move( vertex_array_object ),
		.texture_coordinates_buffer= move( texture_coordinates_buffer ),
		.positions_buffer= move( positions_buffer ),
		.index_buffer= move( index_buffer ),
		.textures=
			ust::make_vector_from_mapped_range(
				model_data.texture_collections,
				lambda[&]( ModelData::TextureCollection& c ) : Texture
				{
					return CreateModelTexture( c.hd_textures[0], settings, gl_capabilities );
				} ),
		.frame_bboxes= CalculateModelFrameBBoxes( model_data ),
	};
}

fn SetGPUModelActiveFrames( GPUModel& model, u32 frame0_index, u32 frame1_index )
{
	model.vertex_array_object.Bind();
	model.positions_buffer.Bind();

	{
		var size_type positions0_offset=
			size_type( frame0_index * model.num_vertices ) * typeinfo</ModelFrameVertex/>.size_of +
			GetStructFieldOffset</ ModelFrameVertex, "position" />();

		unsafe( glVertexAttribPointer(
			GPUModel::c_position0_attrib,
			3,
			GLenum( GL_FLOAT ),
			GLboolean(0),
			GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
			ust::nullptr</byte8/>() + positions0_offset ) );
	}
	{
		var size_type positions1_offset=
			size_type( frame1_index * model.num_vertices ) * typeinfo</ModelFrameVertex/>.size_of +
			GetStructFieldOffset</ ModelFrameVertex, "position" />();

		unsafe( glVertexAttribPointer(
			GPUModel::c_position1_attrib,
			3,
			GLenum( GL_FLOAT ),
			GLboolean(0),
			GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
			ust::nullptr</byte8/>() + positions1_offset ) );
	}

	{
		var size_type normals0_offset=
			size_type( frame0_index * model.num_vertices ) * typeinfo</ModelFrameVertex/>.size_of +
			GetStructFieldOffset</ ModelFrameVertex, "normal" />();

		unsafe( glVertexAttribPointer(
			GPUModel::c_normal0_attrib,
			3,
			GLenum( GL_BYTE ),
			GLboolean(1),
			GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
			ust::nullptr</byte8/>() + normals0_offset ) );
	}
	{
		var size_type normals1_offset=
			size_type( frame1_index * model.num_vertices ) * typeinfo</ModelFrameVertex/>.size_of +
			GetStructFieldOffset</ ModelFrameVertex, "normal" />();

		unsafe( glVertexAttribPointer(
			GPUModel::c_normal1_attrib,
			3,
			GLenum( GL_BYTE ),
			GLboolean(1),
			GLsizei( typeinfo</ModelFrameVertex/>.size_of ),
			ust::nullptr</byte8/>() + normals1_offset ) );
	}
}

fn CreateModelTexture(
	ModelData::TextureData& texture_data, Settings& settings, GLCapabilities& gl_capabilities ) : Texture
{
	var Texture texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
	texture.Bind();

	scoped_array RGBAColor rgba_pixels[ texture_data.pixels_data.size() ] (
		texture_data.pixels_data.iter().map(
			lambda[&p= texture_data.palette]( u8 index ) : RGBAColor
			{
				var size_type i(index);
				// Fetch cikir frin palette and convert BGR to RGBA.
				return ust::make_array( p[ i * 3s + 2s ], p[ i * 3s + 1s ], p[ i * 3s + 0s ], 255u8 );
			} ) );

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( texture_data.size[0] ),
		GLsizei( texture_data.size[1] ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::ptr_cast_to_byte8( rgba_pixels.data() ) ) );

	unsafe( glGenerateMipmap( GLenum( GL_TEXTURE_2D ) ) );

	if( settings.r_texture_nearest_filter )
	{
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_NEAREST ) ) );
		if( settings.r_texture_trilinear_filter )
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST_MIPMAP_LINEAR ) ) );
		}
		else
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST_MIPMAP_NEAREST ) ) );
		}
	}
	else
	{
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );
		if( settings.r_texture_trilinear_filter )
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR_MIPMAP_LINEAR ) ) );
		}
		else
		{
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR_MIPMAP_NEAREST ) ) );
		}
	}

	if( settings.r_texture_anisotropy > 1u && gl_capabilities.texture_anisotropy_supported )
	{
		unsafe( glTexParameterf(
			GLenum( GL_TEXTURE_2D ),
			GLenum( GL_TEXTURE_MAX_ANISOTROPY_EXT ),
			f32( ust::min( settings.r_texture_anisotropy, 32u ) ) ) );
	}

	return texture;
}

} // namespace PM
