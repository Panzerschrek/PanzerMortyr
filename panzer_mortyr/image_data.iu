import "/vector.iu"

namespace PM
{

type RGBAColor= [ u8, 4 ];

struct ImageData
{
	[ u32, 2 ] size;
	ust::vector</RGBAColor/> pixels;

	// Disable copying, since it's pretty costly.
	fn constructor( mut this, ImageData& other )= delete;
	op=( mut this, ImageData& other )= delete;
}

} // namespace PM
