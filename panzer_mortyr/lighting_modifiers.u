import "lighting_modifiers.iu"

namespace PM
{

fn CalculateLightingModifiers(
	Settings& settings,
	[ f32, 3 ]& world_lighting_tint,
	WorldDrawingInfo::FullscreenEffect fullscreen_effect ) : LightingModifiers
{
	var LightingModifiers mut lighting_modifiers
	{
		.map{ .add[ 0.0f ... ], .scale[ 1.0f ... ] },
		.models{ .add[ 0.0f ... ], .scale[ 1.0f ... ] },
		.first_person_weapon_models{ .add[ 0.0f ... ], .scale[ 1.0f ... ] },
	};

	switch( fullscreen_effect )
	{
		WorldDrawingInfo::FullscreenEffect::None -> {},
		WorldDrawingInfo::FullscreenEffect::NightVision ->
		{
			// For night vision set red and blue components to zero, add some light to green component and scale it up.
			lighting_modifiers.map.add= ust::make_array( 0.0f, 0.3f, 0.0f );
			lighting_modifiers.map.scale= ust::make_array( 0.0f, 1.3f, 0.0f );

			// Models have the same light params as the rest of the world in night vision mode.
			lighting_modifiers.models= lighting_modifiers.map;
			lighting_modifiers.first_person_weapon_models= lighting_modifiers.models;
		},
		WorldDrawingInfo::FullscreenEffect::InfraredVision ->
		{
			// For infrared vision make anything red.
			lighting_modifiers.map.add= ust::make_array( 0.0f, 0.0f, 0.0f );
			lighting_modifiers.map.scale= ust::make_array( 1.5f, 0.0f, 0.0f );

			// But draw models with constant orange light.
			lighting_modifiers.models.scale= ust::make_array( 0.0f, 0.0f, 0.0f );
			lighting_modifiers.models.add= ust::make_array( 1.0f, 0.4f, 0.1f );

			// Draw first person weapon as the rest of the world.
			lighting_modifiers.first_person_weapon_models= lighting_modifiers.map;
		}
	}

	if( settings.r_fullbright )
	{
		lighting_modifiers.map.add= ust::make_array( 1.0f, 1.0f, 1.0f );
		lighting_modifiers.map.scale= ust::make_array( 0.0f, 0.0f, 0.0f );
		lighting_modifiers.models= lighting_modifiers.map;
		lighting_modifiers.first_person_weapon_models= lighting_modifiers.models;
	}
	else
	{
		// Apply here lighting tint and brightness scale.
		var f32 brightness_scale= ust::max( 0.5f, ust::min( settings.r_brightness_scale, 2.5f ) );
		for( auto mut i= 0s; i < 3s; ++i )
		{
			var f32 scale= brightness_scale * world_lighting_tint[i];

			lighting_modifiers.map.add[i]*= scale;
			lighting_modifiers.map.scale[i]*= scale;

			lighting_modifiers.models.add[i]*= scale;
			lighting_modifiers.models.scale[i]*= scale;

			lighting_modifiers.first_person_weapon_models.add[i]*= scale;
			lighting_modifiers.first_person_weapon_models.scale[i]*= scale;
		}
	}

	return lighting_modifiers;
}

fn MakeLightingModifiersComponentOrderBGR( LightingModifiers& modifiers ) : LightingModifiers
{
	return LightingModifiers
	{
		.map= MakeLightingModifierComponentOrderBGR( modifiers.map ),
		.models= MakeLightingModifierComponentOrderBGR( modifiers.models ),
		.first_person_weapon_models= MakeLightingModifierComponentOrderBGR( modifiers.first_person_weapon_models ),
	};
}

fn MakeLightingModifierComponentOrderBGR( LightingModifier& modifier ) : LightingModifier
{
	return LightingModifier
	{
		.add= MakeComponentOrderBGR( modifier.add ),
		.scale= MakeComponentOrderBGR( modifier.scale ),
	};
}

fn MakeComponentOrderBGR( [ f32, 3 ]& components ) : [ f32, 3 ]
{
	return ust::make_array( components[2], components[1], components[0] );
}

} // namespace PM
