import "/enum_string_conversions.iu"
import "/scoped_array.iu"
import "buffer_utils.iu"
import "gl_functions.iu"
import "gl_state.iu"
import "hud_drawer_gl.iu"
import "image_loading.iu"

namespace PM
{

fn HudDrawerGL::constructor(
	[ u32, 2 ] viewport_size,
	GameFilesystemPtr& game_filesystem_ptr,
	ConsoleOutPtr& console_out,
	Settings& settings )
	(
		viewport_size_= viewport_size,
		// Scale propertional to screen width.
		// Scale 2 starts with screen width 1280.
		scale_= ust::max( 1u, viewport_size[0] / 640u ),
		shader_( embed</char8/>( "shaders/hud.vert.glsl" ), embed</char8/>( "shaders/hud.frag.glsl" ) ),
		vertex_buffer_= CreateHudVertexBuffer( c_max_buffer_size_quads ),
		index_buffer_= CreateQuadsU16IndexBuffer( c_max_buffer_size_quads ),
		hud_texture_atlas_= LoadHudTextureAtlas( game_filesystem_ptr, console_out, settings ),
		buffered_quads_= zero_init,
		num_buffered_quads_= 0s,
	)
{
	vertex_array_object_.Bind();

	vertex_buffer_.Bind();

	var u32 c_position_attrib= 0u;
	var u32 c_tex_coord_attrib= 1u;

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );
	unsafe( glVertexAttribPointer(
		c_position_attrib,
		2,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ HudVertex />.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ HudVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( c_tex_coord_attrib ) );
	unsafe( glVertexAttribPointer(
		c_tex_coord_attrib,
		2,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</ HudVertex />.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ HudVertex, "tex_coordinates" />() ) );
}

fn HudDrawerGL::Draw( mut this, HudDrawingInfo& drawing_info )
{
	var bool blinking_numbers_are_turned_off= drawing_info.game_time_s % 1.0f <= 0.5f;

	var i32 padding_bottom= 4 * i32(scale_);
	var i32 incon_number_half_padding= 1 * i32(scale_);

	// Health and armor icons are located in 1 / 4 width from screen edges and 1 / 4 width from weapon icon.
	var i32 symmetric_icons_offset_x( viewport_size_[0] / 4u );

	{
		var i32 offset_x= symmetric_icons_offset_x;

		AddTileQuad( offset_x + incon_number_half_padding, padding_bottom, c_health_icon_index );

		if( !drawing_info.health_is_low || !blinking_numbers_are_turned_off ) // Low health is blinking.
		{
			AddDecimalNumber(
				offset_x - incon_number_half_padding,
				padding_bottom,
				u32( drawing_info.health ),
				drawing_info.health_is_low );
		}

		if( drawing_info.character_icon_index != HudDrawingInfo::IconIndex(0) )
		{
			var i32 offset_y( scale_ * c_tile_height );

			AddTileQuad( offset_x + incon_number_half_padding, offset_y + padding_bottom, drawing_info.character_icon_index );
		}
	}
	{
		var i32 offset_x( viewport_size_[0] / 2u );

		AddTileQuad( offset_x + incon_number_half_padding, padding_bottom, drawing_info.weapon_icon_index );

		if( drawing_info.ammo >= 0i16 &&
			( !drawing_info.ammo_is_low || !blinking_numbers_are_turned_off )  /* Low ammo is blinking. */ )
		{
			AddDecimalNumber(
				offset_x - incon_number_half_padding,
				padding_bottom,
				u32( drawing_info.ammo ),
				drawing_info.ammo_is_low );
		}
	}
	{
		var i32 offset_x= i32( viewport_size_[0] ) - symmetric_icons_offset_x;

		AddTileQuad( offset_x + incon_number_half_padding, padding_bottom, c_armor_icon_index );

		// Low armor is NOT blinking.
		AddDecimalNumber(
			offset_x - incon_number_half_padding,
			padding_bottom,
			u32( drawing_info.armor ),
			drawing_info.armor_is_low );

		// PanzerMortyr change - draw active tool(s) above armor,
		// since place above selected tool is used for showing other inventory items.
		// TODO - maybe display active tools at some edge of the screen?
		for( auto mut i= 0u; i < u32( drawing_info.num_active_tools ); ++i )
		{
			var HudDrawingInfo::ActiveTool& active_tool= drawing_info.active_tools[i];

			var i32 offset_y( scale_ * c_tile_height * ( i + 1u ) );

			AddTileQuad( offset_x + incon_number_half_padding, offset_y + padding_bottom, active_tool.icon_index );

			AddDecimalNumber( offset_x - incon_number_half_padding, offset_y + padding_bottom, u32( active_tool.amount ), false );
		}
	}

	if(
		drawing_info.num_inventory_tool_icons > 0u8 &&
		drawing_info.selected_inventory_tool_icon_index < drawing_info.num_inventory_tool_icons )
	{
		// This scaling constant was experimentally-found by measuring offsets on original game screenshots with different resolution.
		var i32 offset_x( viewport_size_[0] * 17u / 20u );

		AddTileQuad(
			offset_x,
			padding_bottom,
			drawing_info.inventory_tool_icons[ drawing_info.selected_inventory_tool_icon_index ] );

		var u32 num_other_icons= u32( drawing_info.num_inventory_tool_icons ) - 1u;
		var u32 num_next_icons= num_other_icons / 2u;
		var u32 num_previous_icons= num_other_icons - num_next_icons;

		var i32 offset_x_side_delta( scale_ * ( c_tile_width / 2u + 6u ) );

		if( offset_x + offset_x_side_delta + i32( c_tile_width * scale_ * 2u ) <= i32( viewport_size_[0] ) )
		{
			// Draw the whole inventory only if has enough place.

			for( auto mut i= 0u; i < num_previous_icons; ++i )
			{
				var i32 offset_y= padding_bottom + i32( scale_ * c_tile_height * ( i + 1u ) );

				var u32 slot=
					( u32( drawing_info.num_inventory_tool_icons ) * 3u + u32( drawing_info.selected_inventory_tool_icon_index ) - i - 1u )
					% u32( drawing_info.num_inventory_tool_icons );

				AddTileQuad( offset_x - offset_x_side_delta, offset_y, drawing_info.inventory_tool_icons[ slot ] );
			}

			for( auto mut i= 0u; i < num_next_icons; ++i )
			{
				var i32 offset_y= padding_bottom + i32( scale_ * c_tile_height * ( i + 1u ) );

				var u32 slot=
					( u32( drawing_info.selected_inventory_tool_icon_index ) + i + 1u )
					% u32( drawing_info.num_inventory_tool_icons );

				AddTileQuad( offset_x + offset_x_side_delta, offset_y, drawing_info.inventory_tool_icons[ slot ] );
			}
		}
	}

	// PanzerMortyr addition - show available keys.
	{
		var i32 offset_x= i32( viewport_size_[0] - scale_ * c_tile_width );
		var i32 step_y= i32( scale_ * c_tile_width );
		var i32 offset_y= padding_bottom + step_y * 2;

		for( auto mut i= 0u; i < 3u; ++i )
		{
			var HudDrawingInfo::IconIndex icon_index= drawing_info.key_icon_indices[i];
			if( icon_index != HudDrawingInfo::IconIndex(0) )
			{
				AddTileQuad( offset_x, offset_y + step_y * i32(i), icon_index );
			}
		}
	}

	FlushDrawQuads();
}

fn HudDrawerGL::AddTileQuad( mut this, i32 x, i32 y, HudDrawingInfo::IconIndex tile_index )
{
	if( num_buffered_quads_ >= c_max_buffer_size_quads )
	{
		return;
	}

	var [ HudVertex, 4 ] &mut dst_quad= buffered_quads_[ num_buffered_quads_ ];
	++num_buffered_quads_;

	var u32 tile_x= u32( tile_index ) % c_num_tiles_x;
	var u32 tile_y= u32( tile_index ) / c_num_tiles_y;

	var f32 normalized_tile_width = f32( c_tile_width  * 2u * scale_ ) / f32( viewport_size_[0] );
	var f32 normalized_tile_height= f32( c_tile_height * 2u * scale_ ) / f32( viewport_size_[1] );

	var f32 normalized_x= f32( x * 2 ) / f32( viewport_size_[0] ) - 1.0f;
	var f32 normalized_y= f32( y * 2 ) / f32( viewport_size_[1] ) - 1.0f;

	var f32 tc_x= f32( tile_x ) / f32( c_num_tiles_x );
	var f32 tc_y= f32( c_num_tiles_y - 1u - tile_y ) / f32( c_num_tiles_y );

	dst_quad[0]=
		HudVertex
		{
			.position[ normalized_x, normalized_y ],
			.tex_coordinates[ tc_x, tc_y ],
		};

	dst_quad[1]=
		HudVertex
		{
			.position[ normalized_x + normalized_tile_width, normalized_y ],
			.tex_coordinates[ tc_x + c_tile_tc_width, tc_y ],
		};

	dst_quad[2]=
		HudVertex
		{
			.position[ normalized_x + normalized_tile_width, normalized_y + normalized_tile_height ],
			.tex_coordinates[ tc_x + c_tile_tc_width, tc_y + c_tile_tc_height ],
		};

	dst_quad[3]=
		HudVertex
		{
			.position[ normalized_x, normalized_y + normalized_tile_height ],
			.tex_coordinates[ tc_x, tc_y + c_tile_tc_height ],
		};
}

fn HudDrawerGL::AddDigitQuad( mut this, i32 x, i32 y, u32 digit_index, bool alternative_color )
{
	if( num_buffered_quads_ >= c_max_buffer_size_quads )
	{
		return;
	}

	var [ HudVertex, 4 ] &mut dst_quad= buffered_quads_[ num_buffered_quads_ ];
	++num_buffered_quads_;

	var f32 normalized_digit_width = f32( c_digit_width  * 2u * scale_ ) / f32( viewport_size_[0] );
	var f32 normalized_digit_height= f32( c_digit_height * 2u * scale_ ) / f32( viewport_size_[1] );

	var f32 normalized_x= f32( x * 2 ) / f32( viewport_size_[0] ) - 1.0f;
	var f32 normalized_y= f32( y * 2 ) / f32( viewport_size_[1] ) - 1.0f;

	var f32 tc_x= f32( digit_index ) / f32( c_num_digits_x );
	var f32 tc_y= f32( c_num_digits_y - 1u - ( alternative_color ? 7u : 0u ) ) / f32( c_num_digits_y );

	dst_quad[0]=
		HudVertex
		{
			.position[ normalized_x, normalized_y ],
			.tex_coordinates[ tc_x, tc_y ],
		};

	dst_quad[1]=
		HudVertex
		{
			.position[ normalized_x + normalized_digit_width, normalized_y ],
			.tex_coordinates[ tc_x + c_digit_tc_width, tc_y ],
		};

	dst_quad[2]=
		HudVertex
		{
			.position[ normalized_x + normalized_digit_width, normalized_y + normalized_digit_height ],
			.tex_coordinates[ tc_x + c_digit_tc_width, tc_y + c_digit_tc_height ],
		};

	dst_quad[3]=
		HudVertex
		{
			.position[ normalized_x, normalized_y + normalized_digit_height ],
			.tex_coordinates[ tc_x, tc_y + c_digit_tc_height ],
		};
}

fn HudDrawerGL::AddDecimalNumber( mut this, i32 mut right_x, i32 y, u32 mut num, bool alternative_color )
{
	loop
	{
		var u32 digit= num % 10u;
		num/= 10u;
		right_x-= i32( scale_ * c_digit_width );
		AddDigitQuad( right_x, y, digit, alternative_color );

		if( num == 0u )
		{
			break;
		}
	}
}

fn HudDrawerGL::FlushDrawQuads( mut this )
{
	var size_type num_quads_to_draw= num_buffered_quads_;

	{
		vertex_buffer_.Bind();
		auto range= ust::array_view_imut</ [ HudVertex, 4 ] />( buffered_quads_ ).subrange_end( num_buffered_quads_ ).to_byte8_range();
		unsafe( glBufferSubData( GLenum( GL_ARRAY_BUFFER ), GLintptr(0), GLsizeiptr( range.size() ), range.data() ) );
		num_buffered_quads_= 0s;
	}

	SetGLState( g_hud_drawing_gl_state );

	var u32 texture_slot= 0u;

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	hud_texture_atlas_.Bind();

	shader_.Bind();
	shader_.SetUniform( "fu_texture", texture_slot );

	vertex_array_object_.Bind();
	index_buffer_.Bind();

	unsafe( glDrawElements(
		GLenum( GL_TRIANGLES ),
		GLsizei( num_quads_to_draw * 6s ),
		GLenum( GL_UNSIGNED_SHORT ),
		ust::nullptr</byte8/>() ) );
}

fn CreateHudVertexBuffer( size_type num_quads ) : BufferObject
{
	return
		BufferObject::CreateUninitializedDynamicDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ),
			num_quads * 4s * typeinfo</HudVertex/>.size_of );
}

fn LoadHudTextureAtlas(
	GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out, Settings& settings ) : Texture
{
	var Texture texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
	texture.Bind();

	auto mut lock= game_filesystem_ptr.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	result_match( game_filesystem.LoadFile( "PANEL.BMP\0\0\0", LoadImageBMP ) )
	{
		Ok( mut image_data ) ->
		{
			// Copy number icons into the last row, where there is some free space. Make them red.
			var u32 tile_row_height= image_data.size[1] / c_num_tiles_y;
			for( auto mut dy= 0u; dy < tile_row_height; ++dy )
			{
				var u32 src_offset= image_data.size[0] * ( dy + tile_row_height * ( c_num_tiles_y - 1u ) );
				var u32 dst_offset= image_data.size[0] * dy;

				for( auto mut x= 0u; x < image_data.size[0]; ++x )
				{
					var RGBAColor mut c= image_data.pixels[ size_type( x + src_offset ) ];
					c[1]= 0u8;
					c[2]= 0u8;
					image_data.pixels[ size_type( x + dst_offset ) ]= c;
				}
			}

			// The original image has no alpha-channel.
			// Synthesize some alpha based on brightness.
			foreach( &mut pixel : image_data.pixels )
			{
				var u8 brightness= ust::max( cast_imut(pixel)[0], ust::max( cast_imut(pixel)[1], cast_imut(pixel)[2] ) );
				var u32 darkness= 255u - u32(brightness);
				var u8 alpha( 255u - darkness * darkness / 255u );
				pixel[3]= alpha;
			}

			unsafe( glTexImage2D(
				GLenum( GL_TEXTURE_2D ),
				0,
				GLint( GL_RGBA8 ),
				GLsizei( image_data.size[0] ),
				GLsizei( image_data.size[1] ),
				0,
				GLenum( GL_RGBA ),
				GLenum( GL_UNSIGNED_BYTE ),
				ust::ptr_cast_to_byte8( image_data.pixels.range().data() ) ) );
		},
		Err(e) ->
		{
			ConsoleOutAddTextLine( console_out, ust::concat( "Failed to read image file! Error: ", ust::enum_to_string(e), "!" ) );
		}
	}

	// Use simple filtrations with no mips.
	if( settings.r_hud_texture_nearest_filter )
	{
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_NEAREST ) ) );
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_NEAREST ) ) );
	}
	else
	{
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR ) ) );
		unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );
	}

	return texture;
}

var u32 constexpr c_num_tiles_x= 8u, constexpr c_num_tiles_y= 8u;
var u32 constexpr c_tile_width= 32u, constexpr c_tile_height= 32u;
var f32 constexpr c_tile_tc_width= 1.0f / f32( c_num_tiles_x ), constexpr c_tile_tc_height= 1.0f / f32( c_num_tiles_y );

var u32 constexpr c_num_digits_x= 16u, c_num_digits_y= 8u;
var u32 constexpr c_digit_width= 16u, constexpr c_digit_height= 32u;
var f32 constexpr c_digit_tc_width= 1.0f / f32( c_num_digits_x ), constexpr c_digit_tc_height= 1.0f / f32( c_num_digits_y );

var HudDrawingInfo::IconIndex constexpr c_health_icon_index(8), constexpr c_armor_icon_index(9);

var GLState g_hud_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= true,
	// Premultiplied alpha blending.
	.blend_source_factor( GL_ONE ),
	.blend_destination_factor( GL_ONE_MINUS_SRC_ALPHA ),
};

} // namespace PM
