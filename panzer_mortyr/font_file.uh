import "/vector.u"
import "/common_lib/resource_string.uh"

namespace PM
{

struct FontData
{
	ust::vector</Glyph/> glyphs;

	struct Glyph
	{
		// Each byte represents a row of pixels (1 bit per pixel).
		// Has total 7 row (glyph 8x7).
		[ u8, 7 ] pixels;
		u8 width; // Width is necessary, since we work with non-monospace font.
	}
}

var ResourceString& c_font_file_name= "FONT.DAT\0\0\0\0\0\0\0\0";

fn ParseFontFile( ust::string_view8 file_contents ) : FontData;

} // namespace PM
