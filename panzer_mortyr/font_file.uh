import "/vector.u"
import "/common_lib/resource_string.uh"

namespace PM
{

struct FontData
{
	ust::vector</Glyph/> glyphs;

	// This struct represents entry format in the font file.
	struct Glyph ordered
	{
		// Each byte represents a row of pixels (1 bit per pixel).
		// Has total 7 rows (glyphs are 8x7).
		[ u8, 7 ] pixels;
		u8 width; // Width is necessary, since we work with non-monospace font.
	}

	// The original game uses polish alphabet, numerical chars and some extra symbols.
	var [ char32, 60 ]& c_glyphs_sequence= "AĄBCĆDEĘFGHIJKLŁMNŃOÓPQRSŚTUVWXYZŹŻ !'_.,0123456789#$%-?:()/"u32;
}

var ResourceString& c_font_file_name= "ZFONT.DAT\0\0\0\0\0\0\0";

type FontTable= [ u8, 256 ];

var ResourceString& c_font_table_file_name= "ZFONT.TAB\0\0\0\0\0\0\0";

} // namespace PM
