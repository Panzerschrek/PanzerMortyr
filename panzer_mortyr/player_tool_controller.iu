import "game_structs.iu"
import "keyboard_state.iu"
import "mouse_buttons_state.iu"
import "settings.iu"

namespace PM
{

class PlayerToolController
{
public:
	fn constructor( SettingsImutPtr settings );

	fn Update( mut this, KeyboardState& keyboard_state, MouseButtonsState mouse_buttons_state );

	fn GetInventoryInput( this ) : PlayerInventoryInput;

	fn GetShotRequested( this ) : bool;
	fn GetKickRequested( this ) : bool;

	fn Reset( mut this );

private:
	SettingsImutPtr imut settings_;

	PlayerInventoryInput inventory_input_;

	bool tool_activation_pressed_= false;
	bool previous_tool_selection_pressed_= false;
	bool next_tool_selection_pressed_= false;
	bool acid_protection_suit_activation_pressed_= false;
	bool night_vision_activation_pressed_= false;
	bool infrared_vision_activation_pressed_= false;

	bool shot_requested_= false;
	bool kick_requested_= false;
}

} // namespace PM
