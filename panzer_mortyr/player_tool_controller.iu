import "game_structs.iu"
import "input_state.iu"
import "mouse_buttons_state.iu"
import "settings.iu"

namespace PM
{

class PlayerToolController
{
public:
	fn constructor( SettingsImutPtr settings );

	fn Update( mut this, InputState& input_state );

	fn GetInventoryInput( this ) : PlayerInventoryInput;

	fn GetShotRequested( this ) : bool;
	fn GetKickRequested( this ) : bool;

	fn Reset( mut this );

private:
	SettingsImutPtr imut settings_;

	PlayerInventoryInput inventory_input_;

	bool shot_requested_= false;
	bool kick_requested_= false;
}

} // namespace PM
