import "/enum_string_conversions.u"
import "/scoped_array.u"
import "/stdout.u"
import "/string_conversions.u"

import "/common_lib/archive_file.uh"

import "game_filesystem.uh"

namespace PM
{

fn GameFilesystem::Create() : GameFilesystemNullablePtr
{
	// TODO - do not hardcode path to archive file.
	// Allow tuning it and try to locate it using current directory or executable directory.
	auto mut archive_file_res= ust::file_readable::open( "Data/main.hal" );

	if_var( e : archive_file_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error opening game archive file: ", ust::enum_to_string( e ), "!\n" ) );
		return GameFilesystemNullablePtr();
	}

	var ust::file_readable mut archive_file= move(archive_file_res).try_take();

	var u64 mut archive_file_size(0);
	result_match( archive_file.get_metatada() )
	{
		Ok(m) -> { archive_file_size= m.size; },
		Err(e) ->
		{
			ust::stderr_print( ust::concat( "Error getting archive file size: ", ust::enum_to_string( e ), "!\n" ) );
			return GameFilesystemNullablePtr();
		}
	}

	ust::stdout_print( ust::concat( "Game archive file has size ", ust::to_string8(archive_file_size), " bytes.\n" ) );

	var ArchiveHeader mut archive_header= zero_init;

	if_var( e : archive_file.read_exact( ust::single_element_array_view( archive_header ).to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading archive header: ", ust::enum_to_string( e ), "!\n" ) );
		return GameFilesystemNullablePtr();
	}

	if( archive_header.id != ArchiveHeader::c_expected_id )
	{
		ust::stderr_print( ust::concat( "Unexpected archive file ID, expected ", ust::to_string8(ArchiveHeader::c_expected_id), ",got ", ust::to_string8(archive_header.id), "!\n" ) );
		return GameFilesystemNullablePtr();
	}

	ust::stdout_print( ust::concat( "Game archive has ", ust::to_string8( archive_header.num_files ), " files.\n" ) );

	if( u64( typeinfo</ArchiveHeader/>.size_of ) + u64(archive_header.num_files) * u64( typeinfo</ArchiveFileHeader/>.size_of ) > archive_file_size )
	{
		ust::stderr_print( "Entry table size is bigger than archive file size!\n" );
		return GameFilesystemNullablePtr();
	}

	scoped_array ArchiveFileHeader mut file_headers[ size_type(archive_header.num_files) ]( ust::make_zeroed</ArchiveFileHeader/>() );

	if_var( e : archive_file.read_exact( file_headers.to_byte8_range() ).as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Error reading archive file headers: ", ust::enum_to_string( e ), "\n" ) );
		return GameFilesystemNullablePtr();
	}

	var EntriesMap mut archive_entries;

	foreach( &file_header : file_headers )
	{
		var ResourceString mut name= ConvertToUppercase( file_header.name );

		if( u64( file_header.offset ) + u64( file_header.size ) > archive_file_size )
		{
			ust::stderr_print( ust::concat( "File \"", ConvertResourceStringToStringView( name ), "\" is out of bounds!\n" ) );
			continue;
		}

		archive_entries.insert_new( move(name), FileEntry{ .offset= file_header.offset, .size= file_header.size } );
	}

	return GameFilesystemPtr( unsafe( GameFilesystem( move( archive_file ), move( archive_entries) ) ) );
}

fn GameFilesystem::constructor( ust::file_readable mut archive_file, EntriesMap mut archive_entries ) unsafe
	( archive_file_= move(archive_file), archive_entries_= move(archive_entries) )
{}

fn GameFilesystem::LoadFileToString( mut this, ResourceString& file_name ) : ust::io_result</ust::string8/>
{
	auto entry_opt= archive_entries_.find( file_name );
	if( entry_opt.empty() )
	{
		return ust::io_error::not_found;
	}

	var FileEntry& entry= entry_opt.try_deref();

	if_var( e : archive_file_.seek( u64( entry.offset ) ).as_error_ref() )
	{
		return e;
	}

	var ust::string8 mut result( size_type( entry.size ), '\0' );

	if_var( e : archive_file_.read( result.range().to_byte8_range() ).as_error_ref() )
	{
		return e;
	}

	return result;
}

} // namespace PM
