import "/file_helpers.iu"
import "game_filesystem.iu"

namespace PM
{

fn GameFilesystem::Create(
	ust::filesystem_path_view executable_path,
	ust::filesystem_path_view custom_game_installation_directory_path,
	ConsoleOutPtr& console_out ) : GameFilesystemNullablePtr
{
	var ust::optional</GameDataSearchResult/> game_archive_search_result_opt=
		SearchForGameData( executable_path, custom_game_installation_directory_path, console_out );

	if( game_archive_search_result_opt.empty() )
	{
		ConsoleOutAddTextLine( console_out, "Can't find game data!" );
		return GameFilesystemNullablePtr();
	}

	var GameDataSearchResult& game_data_search_result= game_archive_search_result_opt.try_deref();

	return
		GameFilesystemPtr(
			GameFilesystem(
				game_data_search_result.data_directory,
				GameArchiveFilesystem::Create( game_data_search_result.archive_file, console_out ),
				CollectGameDataFiles( console_out, game_data_search_result.data_directory ) ) );
}

fn GameFilesystem::constructor(
	ust::filesystem_path mut data_directory_path,
	ust::optional</GameArchiveFilesystem/> mut archive_filesystem,
	GameDataFiles mut extra_data_files )
	(
		data_directory_path_= move(data_directory_path),
		archive_filesystem_= move(archive_filesystem),
		extra_data_files_= move( extra_data_files )
	)
{}

fn GameFilesystem::GetDataDirectory( this )
	: ust::filesystem_path_view @( ust::reference_notation::return_inner_references::param0 )
{
	return data_directory_path_;
}

fn GameFilesystem::LoadFileToString( mut this, ResourceString& file_name ) : ust::io_result</ust::string8/>
{
	if_var( &path : extra_data_files_.find( file_name ) )
	{
		result_match( ust::read_file_to_string( path ) )
		{
			Ok( contents ) -> { return contents; },
			Err( e ) -> { ust::ignore_unused(e); }, // Try loading a file from the game archive.
		}
	}

	if_var( &mut archive_filesystem : archive_filesystem_ )
	{
		return archive_filesystem.LoadFileToString( file_name );
	}

	return ust::io_error::not_found;
}

fn GameFilesystem::LoadFileToByte8Vector( mut this, ResourceString& file_name ) : ust::io_result</ ust::vector</byte8/> />
{
	if_var( &path : extra_data_files_.find( file_name ) )
	{
		result_match( ust::read_file_to_byte8_vector( path ) )
		{
			Ok( contents ) -> { return contents; },
			Err( e ) -> { ust::ignore_unused(e); }, // Try loading a file from the game archive.
		}
	}

	if_var( &mut archive_filesystem : archive_filesystem_ )
	{
		return archive_filesystem.LoadFileToByte8Vector( file_name );
	}

	return ust::io_error::not_found;
}

} // namespace PM
