import "/directory_iterator.iu"
import "/enum_string_conversions.iu"
import "/path_utils.iu"
import "/scoped_array.iu"
import "/string_conversions.iu"

import "/common_lib/archive_file.iu"

import "game_filesystem.iu"

namespace PM
{

fn GameFilesystem::Create( ConsoleOutPtr& console_out ) : GameFilesystemNullablePtr
{
	var ust::optional</GameArchiveSearchResult/> game_archive_search_result_opt=
		SearchForGameArchiveFile( console_out, "Data" );

	if( game_archive_search_result_opt.empty() )
	{
		ConsoleOutAddTextLine( console_out, "Didn't find game data!" );
		return GameFilesystemNullablePtr();
	}

	var GameArchiveSearchResult& game_archive_search_result= game_archive_search_result_opt.try_deref();

	// TODO - do not hardcode path to archive file.
	// Allow tuning it and try to locate it using current directory or executable directory.
	auto mut archive_file_res= ust::file_readable::open( game_archive_search_result.archive_file );

	if_var( e : archive_file_res.as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out, ust::concat( "Error opening game archive file: ", ust::enum_to_string( e ), "!" ) );
		return GameFilesystemNullablePtr();
	}

	var ust::file_readable mut archive_file= move(archive_file_res).try_take();

	var u64 mut archive_file_size(0);
	result_match( archive_file.get_metatada() )
	{
		Ok(m) -> { archive_file_size= m.size; },
		Err(e) ->
		{
			ConsoleOutAddTextLine( console_out, ust::concat( "Error getting archive file size: ", ust::enum_to_string( e ), "!" ) );
			return GameFilesystemNullablePtr();
		}
	}

	ConsoleOutAddTextLine( console_out, ust::concat( "Game archive file has size ", ust::to_string8(archive_file_size), " bytes." ) );

	var ArchiveHeader mut archive_header= zero_init;

	if_var( e : archive_file.read_exact( ust::single_element_array_view( archive_header ).to_byte8_range() ).as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out, ust::concat( "Error reading archive header: ", ust::enum_to_string( e ), "!" ) );
		return GameFilesystemNullablePtr();
	}

	if( archive_header.id != ArchiveHeader::c_expected_id )
	{
		ConsoleOutAddTextLine( console_out, ust::concat( "Unexpected archive file ID, expected ", ust::to_string8(ArchiveHeader::c_expected_id), ",got ", ust::to_string8(archive_header.id), "!" ) );
		return GameFilesystemNullablePtr();
	}

	ConsoleOutAddTextLine( console_out, ust::concat( "Game archive has ", ust::to_string8( archive_header.num_files ), " files." ) );

	if( u64( typeinfo</ArchiveHeader/>.size_of ) + u64(archive_header.num_files) * u64( typeinfo</ArchiveFileHeader/>.size_of ) > archive_file_size )
	{
		ConsoleOutAddTextLine( console_out, "Entry table size is bigger than archive file size!" );
		return GameFilesystemNullablePtr();
	}

	scoped_array ArchiveFileHeader mut file_headers[ size_type(archive_header.num_files) ]( ust::make_zeroed</ArchiveFileHeader/>() );

	if_var( e : archive_file.read_exact( file_headers.to_byte8_range() ).as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out, ust::concat( "Error reading archive file headers: ", ust::enum_to_string( e ) ) );
		return GameFilesystemNullablePtr();
	}

	var EntriesMap mut archive_entries;

	foreach( &file_header : file_headers )
	{
		var ResourceString mut name= ConvertToUppercase( file_header.name );

		if( u64( file_header.offset ) + u64( file_header.size ) > archive_file_size )
		{
			ConsoleOutAddTextLine( console_out, ust::concat( "File \"", ConvertResourceStringToStringView( name ), "\" is out of bounds!" ) );
			continue;
		}

		archive_entries.insert_new( move(name), FileEntry{ .offset= file_header.offset, .size= file_header.size } );
	}

	return GameFilesystemPtr( GameFilesystem( PrivateConstructorTag(), move( archive_file ), move( archive_entries) ) );
}

fn GameFilesystem::constructor(
	PrivateConstructorTag t,
	ust::file_readable mut archive_file,
	EntriesMap mut archive_entries )
	( archive_file_= move(archive_file), archive_entries_= move(archive_entries) )
{
	ust::ignore_unused(t);
}

fn GameFilesystem::LoadFileToString( mut this, ResourceString& file_name ) : ust::io_result</ust::string8/>
{
	auto entry_opt= archive_entries_.find( file_name );
	if( entry_opt.empty() )
	{
		return ust::io_error::not_found;
	}

	var FileEntry& entry= entry_opt.try_deref();

	if_var( e : archive_file_.seek( u64( entry.offset ) ).as_error_ref() )
	{
		return e;
	}

	var ust::string8 mut result( size_type( entry.size ), '\0' );

	if_var( e : archive_file_.read( result.range().to_byte8_range() ).as_error_ref() )
	{
		return e;
	}

	return result;
}

struct GameArchiveSearchResult
{
	ust::filesystem_path archive_file_directory;
	ust::filesystem_path archive_file;
}

fn SearchForGameArchiveFile(
	ConsoleOutPtr& console_out, ust::filesystem_path_view d ) : ust::optional</GameArchiveSearchResult/>
{
	result_match( ust::open_directory_for_iteration( d ) )
	{
		Ok( mut it ) ->
		{
			if_var( &res : SearchForGameArchiveFile( console_out, move( it ) ) )
			{
				return GameArchiveSearchResult
				{
					.archive_file_directory= ust::path::join( d, res.archive_file_directory ),
					.archive_file= ust::path::join( d, res.archive_file ),
				};
			}
		},
		Err( e ) ->
		{
			ConsoleOutAddTextLine(
				console_out, ust::concat( "Failed to open directory \"", d, "\" for iteration: ", ust::enum_to_string(e) ) );
		},
	}
	return ust::null_optional;
}

fn SearchForGameArchiveFile(
	ConsoleOutPtr& console_out,
	ust::iterator</ust::directory_raw_iterator/> mut directory_iterator ) : ust::optional</GameArchiveSearchResult/>
{
	foreach( entry_res : move(directory_iterator) )
	{
		if_var( e : entry_res.as_error_ref() )
		{
			ConsoleOutAddTextLine(
				console_out, ust::concat( "Failed to get directory entry: ", ust::enum_to_string(e) ) );
			break;
		}

		if_var( &entry : entry_res.as_ref() )
		{
			ConsoleOutAddTextLine(
				console_out, ust::concat( "Gas entry: ", entry.name ) );

			if( entry.name == "main.hal" )
			{
				return GameArchiveSearchResult
				{
					.archive_file_directory= ".",
					.archive_file= entry.name,
				};
			}
		}
	}

	return ust::null_optional;
}


} // namespace PM
