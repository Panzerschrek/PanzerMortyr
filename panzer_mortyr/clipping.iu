import "plane.iu"

namespace PM
{

// Input polygon is expected to be convex.
template</
	// Should have "position" member of "Vec3f" type.
	// Should  have overloaded *( VertexType, f32 ) and -( VertexType, VertexType ) operators.
	type VertexType,
	size_type out_vertices_scapacity />
fn ClipPolygon(
	Planef& plane,
	ust::array_view_imut</VertexType/> in_vertices,
	[ VertexType, out_vertices_scapacity ] &mut out_vertices ) : size_type
{
	var VertexType mut prev_v= in_vertices.back();
	var f32 mut prev_dist= plane.GetDistanceForPoint( prev_v.position );
	var size_type mut out_vertex_count= 0s;

	foreach( &v : in_vertices )
	{
		var f32 dist= plane.GetDistanceForPoint( v.position );

		if( dist > 0.0f )
		{
			if( prev_dist < 0.0f )
			{
				var f32 dist_sum= dist - prev_dist;
				var f32 k0= prev_dist / dist_sum;
				var f32 k1= dist / dist_sum;

				out_vertices[ out_vertex_count ]= prev_v * k1 - v * k0;
				++out_vertex_count;

				if( out_vertex_count == out_vertices_scapacity )
				{
					break;
				}
			}

			out_vertices[ out_vertex_count ]= v;
			++out_vertex_count;

			if( out_vertex_count == out_vertices_scapacity )
			{
				break;
			}
		}
		else if( dist == 0.0f )
		{
			out_vertices[ out_vertex_count ]= v;
			++out_vertex_count;

			if( out_vertex_count == out_vertices_scapacity )
			{
				break;
			}
		}
		else if( prev_dist > 0.0f )
		{
			var f32 dist_sum= dist - prev_dist;
			var f32 k0= prev_dist / dist_sum;
			var f32 k1= dist / dist_sum;

			out_vertices[ out_vertex_count ]= prev_v * k1 - v * k0;
			++out_vertex_count;

			if( out_vertex_count == out_vertices_scapacity )
			{
				break;
			}
		}

		prev_v= v;
		prev_dist= dist;
	}

	return out_vertex_count;
}

// Input polygon is expected to be convex.
template</
	// Should have "position" member of "Vec3f" type.
	// Should  have overloaded *( VertexType, f32 ) and -( VertexType, VertexType ) operators.
	type VertexType,
	size_type out_vertices_scapacity />
fn ClipPolygonByZNearPlane(
	f32 z_near,
	ust::array_view_imut</VertexType/> in_vertices,
	[ VertexType, out_vertices_scapacity ] &mut out_vertices ) : size_type
{
	var VertexType mut prev_v= in_vertices.back();
	var f32 mut prev_dist= prev_v.position.z - z_near;
	var size_type mut out_vertex_count= 0s;

	foreach( &v : in_vertices )
	{
		var f32 dist= v.position.z - z_near;

		if( dist > 0.0f )
		{
			if( prev_dist < 0.0f )
			{
				var f32 dist_sum= dist - prev_dist;
				var f32 k0= prev_dist / dist_sum;
				var f32 k1= dist / dist_sum;

				out_vertices[ out_vertex_count ]= prev_v * k1 - v * k0;
				++out_vertex_count;

				if( out_vertex_count == out_vertices_scapacity )
				{
					break;
				}
			}

			out_vertices[ out_vertex_count ]= v;
			++out_vertex_count;

			if( out_vertex_count == out_vertices_scapacity )
			{
				break;
			}
		}
		else if( dist == 0.0f )
		{
			out_vertices[ out_vertex_count ]= v;
			++out_vertex_count;

			if( out_vertex_count == out_vertices_scapacity )
			{
				break;
			}
		}
		else if( prev_dist > 0.0f )
		{
			var f32 dist_sum= dist - prev_dist;
			var f32 k0= prev_dist / dist_sum;
			var f32 k1= dist / dist_sum;

			out_vertices[ out_vertex_count ]= prev_v * k1 - v * k0;
			++out_vertex_count;

			if( out_vertex_count == out_vertices_scapacity )
			{
				break;
			}
		}

		prev_v= v;
		prev_dist= dist;
	}

	return out_vertex_count;
}

fn ClipLineSegment( Planef& plane, [ Vec3f, 2 ]& segment ) : ust::optional</ [ Vec3f, 2 ] />
{
	var f32 dist0= plane.GetDistanceForPoint( segment[0] );
	var f32 dist1= plane.GetDistanceForPoint( segment[1] );

	if( dist0 < 0.0f && dist1 < 0.0f )
	{
		return ust::null_optional;
	}

	if( dist0 >= 0.0f && dist1 >= 0.0f )
	{
		return segment;
	}

	var f32 dist_sum= dist1 - dist0;
	var f32 k0= dist0 / dist_sum;
	var f32 k1= dist1 / dist_sum;
	var Vec3f intersection_point= segment[0] * k1 - segment[1] * k0;

	return ust::make_array( intersection_point, ( dist0 < 0.0f ? segment[1] : segment[0] ) );
}

} // namespace PM
