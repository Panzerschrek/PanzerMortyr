import "game_structs.uh"

namespace PM
{

class CameraRotationController
{
public:
	fn constructor( f32 azimuth );

	fn Update(
		mut this,
		f32 time_delta_s,
		ust::array_view_imut</bool/> keyboard_state,
		u32 mouse_state,
		[ i32, 2 ] mouse_motion );

	fn GetAzimuth( this ) : f32;
	fn GetElevation( this ) : f32;

	fn GetShotRequest( this ) : ust::optional</PlayerShotRequest/>;

	fn Reset( mut this );

private:
	f32 azimuth_;
	f32 elevation_;
	f32 azimuth_velocity_;
	f32 elevation_velocity_;

	ust::optional</PlayerShotRequest/> shot_request_;
}

} // namespace PM
