import "game_event_notification_drawer.iu"

namespace PM
{

fn GameEventNotificationDrawer::constructor( [ u32, 2 ] viewport_size )
	( viewport_size_= viewport_size, images_preloaded_= false )
{}

fn GameEventNotificationDrawer::Draw(
	mut this, ImageDrawer &mut image_drawer, GameEventNotificationsDrawingInfo& drawing_info )
{
	if( !images_preloaded_ )
	{
		PreloadGameEventNotificationImages( image_drawer );
		images_preloaded_= true;
	}

	var ResourceString mut image_file_name= zero_init;
	switch( drawing_info.event_notification )
	{
		GameEventNotificationsDrawingInfo::EventNotification::None -> { return; },
		GameEventNotificationsDrawingInfo::EventNotification::KeyARequired ->
		{
			image_file_name= GameEventNotificationImages::key_a_required;
		},
		GameEventNotificationsDrawingInfo::EventNotification::KeyBRequired ->
		{
			image_file_name= GameEventNotificationImages::key_b_required;
		},
		GameEventNotificationsDrawingInfo::EventNotification::KeyCRequired ->
		{
			image_file_name= GameEventNotificationImages::key_c_required;
		},
		GameEventNotificationsDrawingInfo::EventNotification::SecretAreaFound ->
		{
			image_file_name= GameEventNotificationImages::secret_area_found;
		},
	}

	var u32 scale= ust::max( 1u, ust::min( viewport_size_[0] / 400u, viewport_size_[1] / 300u ) );

	var [ u32, 2 ] image_size= image_drawer.GetImageSize( image_file_name ).deref_or( ust::make_array( 160u, 100u ) );

	// (Almost) center the image.
	var i32 offset_x= i32( ( viewport_size_[0] - image_size[0] * scale ) / 2u );
	var i32 offset_y= i32( ( viewport_size_[1] - image_size[1] * scale ) * 3u / 4u );

	image_drawer.DrawImage( image_file_name, offset_x, offset_y, f32( scale ) );
}

fn PreloadGameEventNotificationImages( ImageDrawer &mut image_drawer )
{
	image_drawer.PreloadImage( GameEventNotificationImages::key_a_required );
	image_drawer.PreloadImage( GameEventNotificationImages::key_b_required );
	image_drawer.PreloadImage( GameEventNotificationImages::key_c_required );
	image_drawer.PreloadImage( GameEventNotificationImages::secret_area_found );
}

namespace GameEventNotificationImages
{

var ResourceString
	& key_a_required= "MENU_KA.BMP\0\0\0\0\0",
	& key_b_required= "MENU_KB.BMP\0\0\0\0\0",
	& key_c_required= "MENU_KC.BMP\0\0\0\0\0",
	& secret_area_found= "MENU_S.BMP\0\0\0\0\0\0";

} // namespace GameEventNotificationImages

} // namespace PM
