import "game_event_notification_drawer.iu"

namespace PM
{

fn GameEventNotificationDrawer::constructor( [ u32, 2 ] viewport_size )
	( viewport_size_= viewport_size, images_preloaded_= false )
{}

fn GameEventNotificationDrawer::Draw(
	mut this, ImageDrawer &mut image_drawer, GameEventNotificationsDrawingInfo& drawing_info )
{
	if( !images_preloaded_ )
	{
		PreloadGameEventNotificationImages( image_drawer );
		images_preloaded_= true;
	}

	DrawEventNotification( viewport_size_, image_drawer, drawing_info.event_notification );

	if_var( &note_info : drawing_info.note_info )
	{
		DrawNote( viewport_size_, image_drawer, note_info );
	}
}

fn DrawEventNotification(
	[ u32, 2 ] viewport_size,
	ImageDrawer &mut image_drawer,
	GameEventNotificationsDrawingInfo::EventNotification event_notification )
{
	var ResourceString mut image_file_name= zero_init;

	type EN= GameEventNotificationsDrawingInfo::EventNotification;
	switch( event_notification )
	{
		EN::None -> { return; },
		EN::KeyARequired -> { image_file_name= GameEventNotificationImages::key_a_required; },
		EN::KeyBRequired -> { image_file_name= GameEventNotificationImages::key_b_required; },
		EN::KeyCRequired -> { image_file_name= GameEventNotificationImages::key_c_required; },
		EN::SecretAreaFound -> { image_file_name= GameEventNotificationImages::secret_area_found; },
	}

	var u32 scale= ust::max( 1u, ust::min( viewport_size[0] / 400u, viewport_size[1] / 300u ) );

	var [ u32, 2 ] image_size= image_drawer.GetImageSize( image_file_name ).deref_or( ust::make_array( 160u, 100u ) );

	// (Almost) center the image.
	var i32 offset_x= i32( ( viewport_size[0] - image_size[0] * scale ) / 2u );
	var i32 offset_y= i32( ( viewport_size[1] - image_size[1] * scale ) * 3u / 4u );

	image_drawer.DrawImage( image_file_name, offset_x, offset_y, f32( scale ) );
}

fn DrawNote(
	[ u32, 2 ] viewport_size,
	ImageDrawer &mut image_drawer,
	GameEventNotificationsDrawingInfo::NoteInfo& note_info )
{
	var ResourceString note_image_file_name= GetNoteImageFileName( note_info.note_index );

	var [ u32, 2 ] image_size=
		image_drawer.GetImageSize( note_image_file_name ).deref_or( ust::make_array( 320u, 200u ) );

	var f32 scale=
		ust::min( note_info.scale, 0.9f ) *
		ust::min( f32( viewport_size[0] ) / f32( image_size[0] ), f32( viewport_size[1] ) / f32( image_size[1] ) );

	image_drawer.PreloadImage( note_image_file_name, ust::null_optional_ref );

	image_drawer.DrawImage(
		note_image_file_name,
		i32( viewport_size[0] / 2u ) - i32( f32( image_size[0] ) * ( scale / 2.0f ) ),
		i32( viewport_size[1] / 2u ) - i32( f32( image_size[1] ) * ( scale / 2.0f ) ),
		scale );
}

fn GetNoteImageFileName( u32 note_index ) : ResourceString
{
	var ResourceString mut name= "NOTE000.BMP\0\0\0\0\0";
	name[4]= char8( u32('0') + note_index / 100u % 10u );
	name[5]= char8( u32('0') + note_index /  10u % 10u );
	name[6]= char8( u32('0') + note_index /   1u % 10u );
	return name;
}

fn PreloadGameEventNotificationImages( ImageDrawer &mut image_drawer )
{
	var [ u8, 3 ] transparent_color= zero_init;
	image_drawer.PreloadImage( GameEventNotificationImages::key_a_required, transparent_color );
	image_drawer.PreloadImage( GameEventNotificationImages::key_b_required, transparent_color );
	image_drawer.PreloadImage( GameEventNotificationImages::key_c_required, transparent_color );
	image_drawer.PreloadImage( GameEventNotificationImages::secret_area_found, transparent_color );
}

namespace GameEventNotificationImages
{

var ResourceString
	& key_a_required= "MENU_KA.BMP\0\0\0\0\0",
	& key_b_required= "MENU_KB.BMP\0\0\0\0\0",
	& key_c_required= "MENU_KC.BMP\0\0\0\0\0",
	& secret_area_found= "MENU_S.BMP\0\0\0\0\0\0";

} // namespace GameEventNotificationImages

} // namespace PM
