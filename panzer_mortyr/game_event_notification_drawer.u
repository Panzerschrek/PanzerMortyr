import "game_event_notification_drawer.iu"

namespace PM
{

fn GameEventNotificationDrawer::constructor( [ u32, 2 ] viewport_size )
	( viewport_size_= viewport_size, images_preloaded_= false )
{}

fn GameEventNotificationDrawer::Draw( mut this, ImageDrawer &mut image_drawer )
{
	if( !images_preloaded_ )
	{
		PreloadGameEventNotificationImages( image_drawer );
		images_preloaded_= true;
	}

	image_drawer.DrawImage( GameEventNotificationImages::secret_found, 0, 0, 1.0f );
}

fn PreloadGameEventNotificationImages( ImageDrawer &mut image_drawer )
{
	image_drawer.PreloadImage( GameEventNotificationImages::secret_found );
}

namespace GameEventNotificationImages
{

var ResourceString
	& secret_found= "MENU_S.BMP\0\0\0\0\0\0";

}

} // namespace PM
