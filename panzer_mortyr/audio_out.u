import "math_constants.iu"
import "audio_out.iu"

namespace PM
{

fn AudioOut::constructor( ConsoleOutPtr& console_out )
	(
		device_id_= zero_init /* set later */,
		audio_thread_data_( ust::make_zeroed</AudioThreadData/>() )
	)
{
	unsafe
	{
		SDL_InitSubSystem( SDL_INIT_AUDIO );

		var SDL_AudioSpec desired_spec
		{
			.freq= 44100,
			.format( AUDIO_F32LSB ),
			.channels( 2 ),
			.silence(0), // This will be filled by SDL_OpenAudioDevice call.
			.samples( 512 ), // TODO - tune this to reduce sound latency.
			.padding= zero_init,
			.size= 0u, // This will be filled by SDL_OpenAudioDevice call.
			.callback( AudioCallback ),
			.userdata= ust::ptr_cast_to_byte8( audio_thread_data_.get_ptr() ),
		};

		var SDL_AudioSpec mut obtained_spec= zero_init;

		device_id_=
			SDL_OpenAudioDevice(
				ust::nullptr</char8/>(), // Use default device name.
				0, // Perform oudio playing, not recording.
				$<( cast_mut( desired_spec ) ), // What spec we want.
				$<( obtained_spec ), // What spec we get.
				// Allow changing frequency and samples. But we can't deal with format and channels changes.
				SDL_AUDIO_ALLOW_FREQUENCY_CHANGE | SDL_AUDIO_ALLOW_SAMPLES_CHANGE );

		if( device_id_ == 0u )
		{
			ConsoleOutAddTextLine( console_out, "Failed to open audio device!" );
			// TODO - avoid crashing.
			halt;
		}

		// Initialize audio thread data before unpausing audio thread and this launching audio thread.
		audio_thread_data_.deref().sample_rate= u32( obtained_spec.freq );

		// Run the device, which is created in paused state.
		SDL_PauseAudioDevice( device_id_ , 0 );
	}
}

fn AudioOut::destructor()
{
	// Pause before closing to stop the audion callback which can be executed right now on a separate thread.
	unsafe( SDL_PauseAudioDevice( device_id_ , 1 ) );

	unsafe( SDL_CloseAudioDevice( device_id_ ) );

	unsafe( SDL_QuitSubSystem( SDL_INIT_AUDIO ) );
}

fn AudioCallback( $(byte8) userdata, $(Uint8) stream, i32 len ) unsafe call_conv( "C" )
{
	AudioThreadRun(
		unsafe( $>( ust::byte_ptr_cast</AudioThreadData/>( userdata ) ) ),
		unsafe(
			ust::array_view_mut</SamplePairType/>(
				ust::byte_ptr_cast</SamplePairType/>( ust::ptr_cast_to_byte8( stream ) ),
				size_type(len) / typeinfo</SamplePairType/>.size_of ) ) );
}

fn AudioThreadRun( AudioThreadData &mut data, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	var f32 base_freq= 400.0f;
	var f32 freq_scale= base_freq * c_tau / f32( data.sample_rate );

	foreach( &mut out_sample_pair : out_sample_pairs )
	{
		var f32 val= ust::sin( f32( data.sample_counter ) * freq_scale );

		out_sample_pair[0]= val;
		out_sample_pair[1]= val;

		++data.sample_counter;
	}
}

// Use f32 as output.
// We require it anyway for mixing and resampling.
type SampleType= f32;

// Use two channels for stereo sound.
type SamplePairType= [ SampleType, 2 ];

} // namespace PM
