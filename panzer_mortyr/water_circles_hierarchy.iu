import "/common_lib/map_files.iu"
import "bit_array.iu"
import "bounding_boxes_hierarchy.iu"

namespace PM
{

struct WaterCircleInHierarchy
{
	Vec3f position;
	f32 rain_droplet_travel_distance;// See ZmapLamRainDroplet::travel_distance
	f32 movement_distance_phase_normalized; // Movement phase didived by travel distance.
}

type WaterCirclesHierarchy= BoundingBoxesHierarchy</WaterCircleInHierarchy/>;

fn BuildWaterCirclesHierarchy(
	ust::array_view_imut</ZmapLamRainDroplet/> rain_droplets,
	ust::array_view_imut</ZmapQuad/> quads,
	BitArrayView wet_material_bits ) : WaterCirclesHierarchy;

} // namespace PM
