import "/hash_map.u"
import "/string.u"
import "/sdl/sdl_with_opengl.uh"
import "mat.uh"

namespace PM
{

// Basic RAII wrapper over OpenGL shaders/program objects.
class ShaderProgram
{
public:
	// Input shader texts should be correct.
	// If something isn't correct, result shader will be broken.

	fn constructor( ust::string_view8 vertex_text, ust::string_view8 fragment_text );
	fn destructor();

public:
	fn Bind( this );

	// TODO - fix this API. Setting uniform requires binding.

	fn SetUniform( mut this, ust::string_view8 name, u32 i );

	fn SetUniform( mut this, ust::string_view8 name, f32 f );

	// TODO - use vec4 type.
	fn SetUniform( mut this, ust::string_view8 name, f32 x, f32 y, f32 z, f32 w );

	fn SetUniform( mut this, ust::string_view8 name, Vec3f& v );

	fn SetUniform( mut this, ust::string_view8 name, Mat4f& m );

private:
	GLuint imut program_;
	GLuint imut vertex_shader_;
	GLuint imut fragment_shader_;

	ust::hash_map</ust::string8, GLint/> uniform_locations_;
}

static_assert( !typeinfo</ShaderProgram/>.is_copy_constructible && !typeinfo</ShaderProgram/>.is_copy_assignable );

} // namespace PM
