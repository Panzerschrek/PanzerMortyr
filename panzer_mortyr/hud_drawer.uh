import "buffer_object.uh"
import "game_filesystem.uh"
import "hud_drawing_info.uh"
import "shader_program.uh"
import "texture.uh"
import "vertex_array_object.uh"
import "vertex_formats.uh"

namespace PM
{

class HudDrawer
{
public:
	fn constructor( [ u32, 2 ] viewport_size, GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out );

	fn Draw( mut this, HudDrawingInfo& drawing_info );

private:
	fn AddTileQuad( mut this, f32 x, f32 y, u32 tile_index );
	fn AddDigitQuad( mut this, f32 x, f32 y, u32 digit_index );
	fn AddDecimalNumber( mut this, f32 right_x, f32 y, u32 num );

	fn FlushDrawQuads( mut this );

private:
	// Should be enough to display all stats (with 3-digit numbers) and several active items.
	var size_type c_max_buffer_size_quads= 32s;

private:
	[ u32, 2 ] imut viewport_size_;
	f32 imut scale_;
	ShaderProgram shader_;
	VertexArrayObject vertex_array_object_;
	BufferObject vertex_buffer_;
	BufferObject index_buffer_;
	Texture hud_texture_atlas_;

	size_type num_buffered_quads_;
	[ [ HudVertex, 4 ], c_max_buffer_size_quads ] buffered_quads_;
}

} // namespace PM
