import "audio_processor_state.iu"
import "camera_controller.iu"
import "game_structs.iu"

namespace PM
{

// Returns true if managed to save.
fn nodiscard SaveStoredGameState(
	ConsoleOutPtr& console_out,
	ust::string_view8 save_name,
	SaveComment& save_comment,
	u32 map_index,
	GameState& game_state,
	CameraController::State& camera_controller_state,
	AudioProcessorState& audio_processor_state,
	GlobalNavigationGraph& global_navigation_graph ) : bool;

fn LoadStoredGameState(
	ConsoleOutPtr& console_out, ust::string_view8 save_name ) : ust::optional</StoredGameState/>;

fn LoadSaveSummary( ust::string_view8 save_name ) : ust::optional</SaveSummary/>;

// Game state + extra data, which is stored in save files.
struct StoredGameState
{
	SaveSummary save_summary;
	u32 map_index;
	GameState game_state;
	CameraController::State camera_controller_state;
	AudioProcessorState audio_processor_state;
	GlobalNavigationGraph global_navigation_graph;
}

// What user inputs as save name.
// Unused chars are filled with zeros.
type SaveComment= [ char8, 16 ];

struct SaveSummary
{
	SaveComment comment;
}

type SaveSlotName= [ char8, 6 ];

fn GetSaveNameForSlot( u32 slot_index ) : SaveSlotName;

} // namespace PM
