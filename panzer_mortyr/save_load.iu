import "camera_controller.iu"
import "game_structs.iu"

namespace PM
{

// Returns true if managed to save.
fn nodiscard SaveGameExtendedState(
	ConsoleOutPtr& console_out,
	ust::string_view8 save_name,
	u32 map_index,
	GameState& game_state,
	CameraController::State& camera_controller_state,
	GlobalNavigationGraph& global_navigation_graph ) : bool;

fn LoadGameExtendedState(
	ConsoleOutPtr& console_out, ust::string_view8 save_name ) : ust::optional</GameExtendedState/>;

struct GameExtendedState
{
	u32 map_index;
	GameState game_state;
	CameraController::State camera_controller_state;
	GlobalNavigationGraph global_navigation_graph;
}

} // namespace PM
