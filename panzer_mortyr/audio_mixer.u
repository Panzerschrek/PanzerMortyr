import "/math.iu"
import "audio_mixer.iu"

namespace PM
{

fn AudioMixer::constructor(
	InMessagesQueue::ReadEnd mut in_messages_queue_read_end,
	OutMessagesQueue::WriteEnd mut out_messages_queue_write_end )
	(
		in_messages_queue_read_end_= move( in_messages_queue_read_end ),
		out_messages_queue_write_end_= move( out_messages_queue_write_end ),
		// Fill source slots with dummy data to indicated that they all are free.
		sources_
		[
			{
				.id= c_empty_sound_source_id,
				.current_volume= zero_init,
				.new_volume= zero_init,
				.sample_counter= 0u,
				.is_about_to_be_removed= false,
			} ...
		],
		// Fill ambient sound slots with dummy data to indicated that they all are free.
		ambient_sounds_
		[
			{
				.current_volume= zero_init,
				.new_volume= zero_init,
				.sample_counter= 0u,
				.is_about_to_be_removed= false,
			} ...
		],
		// Fill single-shot sound slots with dummy data to indicated that they all are free.
		single_shot_sounds_
		[
			{
				.volume= zero_init,
				.sample_counter= 0u,
			} ...
		],
		frequency_= 1u, // Set exact value later.
		audio_stream_read_buffer_= zero_init,
		underwater_effect_active_= false,
		new_underwater_effect_active_= false,
		underwater_effect_accumulator_[ 0.0f ... ],
		paused_= false,
		new_paused_= false,
	)
{}

fn AudioMixer::SetFrequency( mut this, u32 frequency )
{
	frequency_= frequency;
}

fn AudioMixer::Mix( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	// Warning!
	// This code should finish executing in a predictable and pretty short amount of time,
	// since it's being executed by a background thread performing actual sound outputting and an unpredictable delay may lead to sound artifacts.
	// It should contain no blocking operations (like mutex blocking), system calls and even memory allocations/deallocations.

	// Zero the mix buffer before adding something to it.
	foreach( &mut out_sample_pair : out_sample_pairs )
	{
		foreach( &mut sample : out_sample_pair )
		{
			sample= 0.0f;
		}
	}

	// Process input messages.
	// Assume that we can process messages faster than the other thread can emit them and thus this loop ends eventually.
	loop
	{
		auto mut message_opt= in_messages_queue_read_end_.TryPop();
		if( !message_opt.empty() )
		{
			ProcessMessage( message_opt.try_take() );
		}
		else
		{
			break;
		}
	}

	// Mix regular sounds and ambient sounds. They can be paused.

	if( paused_ )
	{
		if( new_paused_ )
		{
			// While paused still try removing sound sources if their removal was requested.

			foreach( &mut sound_source : sources_ )
			{
				if( sound_source.id != c_empty_sound_source_id &&
					!sound_source.sound_data.empty() &&
					sound_source.is_about_to_be_removed )
				{
					TryRemovingSoundSource( sound_source, out_messages_queue_write_end_ );
				}
			}

			for( auto mut i= 0s; i < c_num_ambient_sound_slots; ++i )
			{
				var AmbientSound &mut ambient_sound= ambient_sounds_[i];
				if( !ambient_sound.sound_data.empty() && ambient_sound.is_about_to_be_removed )
				{
					TryRemovingAmbientSound( ambient_sound, i, out_messages_queue_write_end_ );
				}
			}
		}
		else
		{
			// If leaving paused state, mix sounds and gradually increase result volume.
			MixAndUpdateSoundSources( out_sample_pairs );
			MixAndUpdateAmbientSounds( out_sample_pairs );

			ApplyUnderwaterEffect( out_sample_pairs );

			var f32 mut volume= 0.0f, volume_step= 1.0f / f32( out_sample_pairs.size() );
			foreach( &mut out_sample_pair : out_sample_pairs )
			{
				foreach( &mut channel_value : out_sample_pair )
				{
					channel_value*= volume;
				}
				volume+= volume_step;
			}
		}
	}
	else
	{
		MixAndUpdateSoundSources( out_sample_pairs );
		MixAndUpdateAmbientSounds( out_sample_pairs );

		ApplyUnderwaterEffect( out_sample_pairs );

		if( new_paused_ )
		{
			// If entering paused state, mix sounds and gradually decrease result volume.

			var f32 mut volume= 1.0f, volume_step= -1.0f / f32( out_sample_pairs.size() );
			foreach( &mut out_sample_pair : out_sample_pairs )
			{
				foreach( &mut channel_value : out_sample_pair )
				{
					channel_value*= volume;
				}
				volume+= volume_step;
			}
		}
	}

	paused_= new_paused_;

	// Output single-shot sounds and audio streams even if paused and after applying underwater effect (so that they aren't affected by it).

	MixAndUpdateSingleShotSounds( out_sample_pairs );

	MixAndUpdateAudioStreams( out_sample_pairs );
}

fn AudioMixer::MixAndUpdateSoundSources( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	foreach( &mut sound_source : sources_ )
	{
		if( sound_source.id != c_empty_sound_source_id && !sound_source.sound_data.empty() )
		{
			var bool mut reached_sound_data_end= false;

			variant_visit( &sound_data : sound_source.sound_data.try_deref() )
			{
				var f32 resampling_factor= f32( sound_data.GetFrequency() ) / f32( frequency_ );

				auto sound_data_samples= sound_data.GetSamples();

				type InSampleType= typeof( sound_data_samples[0s] );

				var f32 constexpr sample_scale= GetScaleForSampleType</InSampleType/>();
				var f32 constexpr sample_offset= GetOffsetForSampleType</InSampleType/>();

				var ChannelsVolume start_volume
				[
					sound_source.current_volume[0] * sample_scale,
					sound_source.current_volume[1] * sample_scale,
				];

				var ChannelsVolume end_volume=
					( sound_source.is_about_to_be_removed
						// If is about to remove this sound source - fade its volume towards zero.
						? ust::make_array( 0.0f, 0.0f )
						: ust::make_array(
							sound_source.new_volume[0] * sample_scale,
							sound_source.new_volume[1] * sample_scale ) );

				if( start_volume[0] > 0.0f | start_volume[1] > 0.0f | end_volume[0] > 0.0f | end_volume[1] > 0.0f )
				{
					// Perform smooth volume change to avoid "cracks" and "steps".
					var ChannelsVolume mut current_volume= start_volume;
					var [ f32, c_num_samples ] volume_step_delta
					[
						f32( end_volume[0] - start_volume[0] ) / f32( out_sample_pairs.size() ),
						f32( end_volume[1] - start_volume[1] ) / f32( out_sample_pairs.size() ),
					];

					foreach( &mut out_sample_pair : out_sample_pairs )
					{
						// Perform here resampling with linear interpolation.
						// This works well, since output frequency is almost always higher than frequency of sound files of the original game.

						// We have enough f32 precision here, since regular sounds are pretty short.
						var f32 src_sample_index_fractional= f32( sound_source.sample_counter ) * resampling_factor;
						var u32 src_sample_index( src_sample_index_fractional );

						if( size_type( src_sample_index ) + 1s >= sound_data_samples.size() )
						{
							reached_sound_data_end= true;
							break;
						}

						var f32 mix_fraction= src_sample_index_fractional - f32( src_sample_index );
						var InSampleType sample_value0= sound_data_samples[ size_type( src_sample_index ) ];
						var InSampleType sample_value1= sound_data_samples[ size_type( src_sample_index ) + 1s ];

						var f32 mut sample_value=
							f32( sample_value0 ) * ( 1.0f - mix_fraction ) + f32( sample_value1 ) * mix_fraction;

						static_if( sample_offset != 0.0f )
						{
							sample_value+= sample_offset;
						}

						for( auto mut i= 0s; i < c_num_samples; ++i )
						{
							out_sample_pair[i]+= sample_value * current_volume[i];
						}

						++sound_source.sample_counter;

						for( auto mut i= 0s; i < c_num_samples; ++i )
						{
							current_volume[i]+= volume_step_delta[i];
						}
					}

					// Update current volume after interpolating it smoothly from old to new value.
					sound_source.current_volume= sound_source.new_volume;
				}
				else
				{
					// An optimization - don't mix sounds with zero volume.
					// But we still need to advance them in case if volume changes later.

					sound_source.sample_counter+= u32( out_sample_pairs.size() );

					var u32 src_sample_index( f32( sound_source.sample_counter ) * resampling_factor );

					if( size_type( src_sample_index ) + 1s >= sound_data_samples.size() )
					{
						reached_sound_data_end= true;
					}
				}
			}

			if( reached_sound_data_end | sound_source.is_about_to_be_removed )
			{
				// Perform removal AFTER performing mixing - to allow fading a sound to be removed.

				TryRemovingSoundSource( sound_source, out_messages_queue_write_end_ );
			}
			else
			{
				var bool pushed=
					out_messages_queue_write_end_.TryPush(
						OutMessageSoundSourceProgress
						{
							.id= sound_source.id,
							// We lost here some precision, but it's acceptable.
							.time_s= f32( sound_source.sample_counter ) / f32( frequency_ )
						} );

				// It's not a problem if we failed to send progress message. Send it again next time.
				ust::ignore_unused(pushed);
			}
		}
	}
}

fn AudioMixer::MixAndUpdateAmbientSounds( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	for( auto mut i= 0s; i < c_num_ambient_sound_slots; ++i )
	{
		var AmbientSound &mut ambient_sound= ambient_sounds_[i];

		if( ambient_sound.sound_data.empty() )
		{
			continue;
		}

		variant_visit( &sound_data : ambient_sound.sound_data.try_deref() )
		{
			// Store resampling factor in 16.16 fixed point format.
			// We can't use f32 for calculating sample indices for resampling,
			// since f32 gives not enough precision for long-playing ambient sounds.
			var u32 resampling_factor= ( sound_data.GetFrequency() << 16 ) / frequency_;

			auto sound_data_samples= sound_data.GetSamples();

			type InSampleType= typeof( sound_data_samples[0s] );

			var f32 constexpr sample_scale= GetScaleForSampleType</InSampleType/>();
			var f32 constexpr sample_offset= GetOffsetForSampleType</InSampleType/>();

			var ChannelsVolume start_volume
			[
				ambient_sound.current_volume[0] * sample_scale,
				ambient_sound.current_volume[1] * sample_scale,
			];

			var ChannelsVolume end_volume=
				( ambient_sound.is_about_to_be_removed
					// If is about to remove this ambient sound - fade its volume towards zero.
					? ust::make_array( 0.0f, 0.0f )
					: ust::make_array(
						ambient_sound.new_volume[0] * sample_scale,
						ambient_sound.new_volume[1] * sample_scale ) );

			if( start_volume[0] > 0.0f | start_volume[1] > 0.0f | end_volume[0] > 0.0f | end_volume[1] > 0.0f )
			{
				// Perform smooth volume change to avoid "cracks" and "steps".
				var ChannelsVolume mut current_volume= start_volume;
				var [ f32, c_num_samples ] volume_step_delta
				[
					f32( end_volume[0] - start_volume[0] ) / f32( out_sample_pairs.size() ),
					f32( end_volume[1] - start_volume[1] ) / f32( out_sample_pairs.size() ),
				];

				foreach( &mut out_sample_pair : out_sample_pairs )
				{
					// Perform here resampling with linear interpolation.
					// This works well, since output frequency is almost always higher than frequency of sound files of the original game.

					// Calculate fractional sample index in 48.16 fixed format.
					// This requires only 32-bit by 32-bit multiplication, which is fast even on 32-bit targets.
					var u64 src_sample_index_fractional( u64( ambient_sound.sample_counter ) * u64( resampling_factor ) );

					// Here 64-bit shift is required, which is also pretty fast on 32-bit targets (via "shrdl" instruction).
					var u32 src_sample_index( src_sample_index_fractional >> 16 );

					var f32 mix_fraction= f32( u32( src_sample_index_fractional ) & 65535u ) * ( 1.0f / 65536.0f );

					// Perform fetching with wrapping, since ambient sounds are looping.
					// Use 32-bit modulo operation, since it's faster than 64-bit (for size_type on 64-bit targets).
					var u32 num_source_samples( sound_data_samples.size() );
					var InSampleType sample_value0=
						sound_data_samples[ size_type( ( src_sample_index + 0u ) % num_source_samples ) ];
					var InSampleType sample_value1=
						sound_data_samples[ size_type( ( src_sample_index + 1u ) % num_source_samples ) ];

					var f32 mut sample_value=
						f32( sample_value0 ) * ( 1.0f - mix_fraction ) + f32( sample_value1 ) * mix_fraction;

					static_if( sample_offset != 0.0f )
					{
						sample_value+= sample_offset;
					}

					for( auto mut i= 0s; i < c_num_samples; ++i )
					{
						out_sample_pair[i]+= sample_value * current_volume[i];
					}

					++ambient_sound.sample_counter;

					for( auto mut i= 0s; i < c_num_samples; ++i )
					{
						current_volume[i]+= volume_step_delta[i];
					}
				}

				// Update current volume after interpolating it smoothly from old to new value.
				ambient_sound.current_volume= ambient_sound.new_volume;
			}
			else
			{
				// An optimization - don't mix sounds with zero volume.
				// But we still need to advance them in case if volume changes later.

				ambient_sound.sample_counter+= u32( out_sample_pairs.size() );
			}
		}

		if( ambient_sound.is_about_to_be_removed )
		{
			// Perform removal AFTER performing mixing - to allow fading an ambient sound to be removed.

			TryRemovingAmbientSound( ambient_sound, i, out_messages_queue_write_end_ );
		}
		else
		{
			var bool pushed=
				out_messages_queue_write_end_.TryPush(
					OutMessageAmbientSoundProgress
					{
						.slot_index(i),
						// We lost here some precision, but it's acceptable.
						.time_s= f32( ambient_sound.sample_counter ) / f32( frequency_ )
					} );

			// It's not a problem if we failed to send progress message. Send it again next time.
			ust::ignore_unused(pushed);
		}
	}
}

fn AudioMixer::MixAndUpdateSingleShotSounds( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	foreach( &mut single_shot_sound : single_shot_sounds_ )
	{
		if( single_shot_sound.sound_data.empty() )
		{
			continue;
		}

		var bool mut reached_sound_data_end= false;

		variant_visit( &sound_data : single_shot_sound.sound_data.try_deref() )
		{
			var f32 resampling_factor= f32( sound_data.GetFrequency() ) / f32( frequency_ );

			auto sound_data_samples= sound_data.GetSamples();

			type InSampleType= typeof( sound_data_samples[0s] );

			var f32 constexpr sample_scale= GetScaleForSampleType</InSampleType/>();
			var f32 constexpr sample_offset= GetOffsetForSampleType</InSampleType/>();

			var ChannelsVolume volume
			[
				single_shot_sound.volume[0] * sample_scale,
				single_shot_sound.volume[1] * sample_scale,
			];

			foreach( &mut out_sample_pair : out_sample_pairs )
			{
				// Perform here resampling with linear interpolation.
				// This works well, since output frequency is almost always higher than frequency of sound files of the original game.

				// We have enough f32 precision here, since single-shot sounds are pretty short.
				var f32 src_sample_index_fractional= f32( single_shot_sound.sample_counter ) * resampling_factor;
				var u32 src_sample_index( src_sample_index_fractional );

				if( size_type( src_sample_index ) + 1s >= sound_data_samples.size() )
				{
					reached_sound_data_end= true;
					break;
				}

				var f32 mix_fraction= src_sample_index_fractional - f32( src_sample_index );
				var InSampleType sample_value0= sound_data_samples[ size_type( src_sample_index ) ];
				var InSampleType sample_value1= sound_data_samples[ size_type( src_sample_index ) + 1s ];

				var f32 mut sample_value=
					f32( sample_value0 ) * ( 1.0f - mix_fraction ) + f32( sample_value1 ) * mix_fraction;

				static_if( sample_offset != 0.0f )
				{
					sample_value+= sample_offset;
				}

				for( auto mut i= 0s; i < c_num_samples; ++i )
				{
					out_sample_pair[i]+= sample_value * volume[i];
				}

				++single_shot_sound.sample_counter;
			}
		}

		if( reached_sound_data_end )
		{
			// Pass a copy of the shared pointer containing sound data back.
			// Doing so we ensure that this thread is not the last one owning it
			// and thus prevent freeing memory of this data on this thread while resetting this shared pointer instance.
			// We need to prevent freeing memory here, since it may require some mutex locks (inside an allocator) or even system calls.
			if( out_messages_queue_write_end_.TryPush(
					OutMessageSingleShotSoundFinished{ .sound_data= single_shot_sound.sound_data } ) )
			{
				// It's fine to reset it now,
				// since a copy of this shared pointer is now in the queue and no actual memory freeing should take place.
				single_shot_sound.sound_data.reset();
			}
			else
			{
				// If the output queue is full, still assume this single-shot sound to be playing, even if its end was reached.
				// Assume that we can push a finish message next time.
				single_shot_sound.volume= ust::make_array( 0.0f, 0.0f );
			}
		}
	}
}

fn AudioMixer::MixAndUpdateAudioStreams( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	foreach( &mut audio_stream_opt : audio_streams_ )
	{
		if( !audio_stream_opt.empty() && audio_stream_opt.try_deref().stream.OtherEndIsClosed() )
		{
			// If the other end of the stream is already closed, stop playing it without extracting remaining samples.
			// If one wishes to not discard remaining samples, he should close the stream only when it's emptied.

			auto { mut stream }= audio_stream_opt.try_take();

			var bool pushed=
				out_messages_queue_write_end_.TryPush(
					OutMessageAudioStreamFinished{ .stream= move( stream ) } );

			ust::ignore_unused( pushed ); // Can't handle the case if the queue is full.
		}

		if_var( &mut audio_stream_state : audio_stream_opt )
		{
			// Perform here resampling with linear interpolation.
			// This works well, since output frequency is almost always higher than input stream frequency.

			// TODO - use fixed-point resampling factor, using "f32" isn't enough for long streams.
			var f32 resampling_factor= f32( audio_stream_state.stream.GetFrequency() ) / f32( frequency_ );

			var f32 stream_volume= 0.3f; // TODO - allow setting it.

			var f32 constexpr sample_scale= GetScaleForSampleType</ AudioStream::SampleType />() * stream_volume;
			var f32 constexpr sample_offset= GetOffsetForSampleType</ AudioStream::SampleType />();

			var u32 mut buffer_size= 0u;

			for( auto mut dst_position= 0s; dst_position < out_sample_pairs.size(); ++dst_position )
			{
				// We have enough f32 precision here, since single-shot sounds are pretty short.
				var f32 src_sample_index_fractional= f32( audio_stream_state.sample_counter ) * resampling_factor;
				var u32 src_sample_index( src_sample_index_fractional );

				if( src_sample_index + 1u >= audio_stream_state.extracted_input_sample_counter )
				{
					var u32 last_dst_sample_index=
						audio_stream_state.sample_counter + u32( out_sample_pairs.size() - 1s - dst_position );

					var u32 last_src_sample_index( f32( last_dst_sample_index ) * resampling_factor );

					var u32 read_size= ( 1u + last_src_sample_index ) - audio_stream_state.extracted_input_sample_counter;

					buffer_size=
						u32( audio_stream_state.stream.ReadSamples(
							ust::array_view_mut</ AudioStream::SamplePairType />( audio_stream_read_buffer_ ).subrange_end( size_type( read_size ) ) ) );

					audio_stream_state.extracted_input_sample_counter+= buffer_size;
				}

				if( src_sample_index + 1u >= buffer_size )
				{
					// There is no samples left in the stream.
					// It's possible if the stream's end is reached
					// or if someone isn't fast enough writing samples to the write end of the stream.
					break;
				}

				var f32 mix_fraction= src_sample_index_fractional - f32( src_sample_index );

				var AudioStream::SamplePairType mut sample_pair0= zero_init, mut sample_pair1= zero_init;

				if( src_sample_index + 2u + buffer_size == audio_stream_state.extracted_input_sample_counter )
				{
					sample_pair0= audio_stream_state.last_two_samples[0];
				}
				else if( src_sample_index + 1u + buffer_size == audio_stream_state.extracted_input_sample_counter )
				{
					sample_pair0= audio_stream_state.last_two_samples[1];
				}
				else if( src_sample_index + buffer_size >= audio_stream_state.extracted_input_sample_counter &&
					src_sample_index + buffer_size < audio_stream_state.extracted_input_sample_counter + buffer_size )
				{
					sample_pair0= audio_stream_read_buffer_[ src_sample_index + buffer_size - audio_stream_state.extracted_input_sample_counter ];
				}
				else
				{
					halt;
				}

				if( ( src_sample_index + 1u ) + 2u + buffer_size == audio_stream_state.extracted_input_sample_counter )
				{
					sample_pair1= audio_stream_state.last_two_samples[0];
				}
				else if( ( src_sample_index + 1u ) + 1u + buffer_size == audio_stream_state.extracted_input_sample_counter )
				{
					sample_pair1= audio_stream_state.last_two_samples[1];
				}
				else if( ( src_sample_index + 1u ) + buffer_size >= audio_stream_state.extracted_input_sample_counter &&
					( src_sample_index + 1u ) + buffer_size < audio_stream_state.extracted_input_sample_counter + buffer_size )
				{
					sample_pair1= audio_stream_read_buffer_[ ( src_sample_index + 1u ) + buffer_size - audio_stream_state.extracted_input_sample_counter ];
				}
				else
				{
					halt;
				}
				static_assert( typeinfo</ typeof( sample_pair0 ) />.element_count == c_num_samples );

				var SamplePairType &mut dst_sample= out_sample_pairs[ dst_position ];
				for( auto mut i= 0s; i < c_num_samples; ++i )
				{
					var f32 sample_mixed=
						f32( sample_pair0[i] ) * ( 1.0f - mix_fraction ) + f32( sample_pair1[i] ) * mix_fraction;

					dst_sample[i]+= ( sample_mixed + sample_offset ) * sample_scale;
				}

				++audio_stream_state.sample_counter;
			}

			if( buffer_size >= 2u )
			{
				audio_stream_state.last_two_samples[0]= audio_stream_read_buffer_[ buffer_size - 2u ];
				audio_stream_state.last_two_samples[1]= audio_stream_read_buffer_[ buffer_size - 1u ];
			}
			else if( buffer_size >= 1u )
			{
				auto last= audio_stream_state.last_two_samples[1];
				audio_stream_state.last_two_samples[0]= last;
				audio_stream_state.last_two_samples[1]= audio_stream_read_buffer_[ buffer_size - 1u ];
			}
		}
	}
}

fn AudioMixer::ApplyUnderwaterEffect( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	// This formula is tuned to produce a nice effect with high frequencies mostly filtered-out.
	var f32 mix_ratio= ust::exp( -f32( frequency_ ) / 18000.0f );
	var f32 one_minus_mix_ratio= 1.0f - mix_ratio;

	if( underwater_effect_active_ )
	{
		if( new_underwater_effect_active_ )
		{
			// Apply underwater effect with full power.

			foreach( &mut out_sample_pair : out_sample_pairs )
			{
				for( auto mut i= 0s; i < c_num_samples; ++i )
				{
					underwater_effect_accumulator_[i]=
						underwater_effect_accumulator_[i] * one_minus_mix_ratio + out_sample_pair[i] * mix_ratio;

					out_sample_pair[i]= underwater_effect_accumulator_[i];
				}
			}
		}
		else
		{
			// Gradually reduce underwater effect.
			var f32 mut transition_mix_factor= 1.0f;
			var f32 transition_mix_factor_step= -1.0f / f32( out_sample_pairs.size() );

			foreach( &mut out_sample_pair : out_sample_pairs )
			{
				for( auto mut i= 0s; i < c_num_samples; ++i )
				{
					underwater_effect_accumulator_[i]=
						underwater_effect_accumulator_[i] * one_minus_mix_ratio + out_sample_pair[i] * mix_ratio;

					out_sample_pair[i]=
						underwater_effect_accumulator_[i] * transition_mix_factor +
						out_sample_pair[i] * ( 1.0f - transition_mix_factor );
				}

				transition_mix_factor+= transition_mix_factor_step;
			}
		}
	}
	else
	{
		if( new_underwater_effect_active_ )
		{
			// Gradually increase underwater effect.
			var f32 mut transition_mix_factor= 0.0f;
			var f32 transition_mix_factor_step= 1.0f / f32( out_sample_pairs.size() );

			foreach( &mut out_sample_pair : out_sample_pairs )
			{
				for( auto mut i= 0s; i < c_num_samples; ++i )
				{
					underwater_effect_accumulator_[i]=
						underwater_effect_accumulator_[i] * one_minus_mix_ratio + out_sample_pair[i] * mix_ratio;

					out_sample_pair[i]=
						underwater_effect_accumulator_[i] * transition_mix_factor +
						out_sample_pair[i] * ( 1.0f - transition_mix_factor );
				}

				transition_mix_factor+= transition_mix_factor_step;
			}
		}
		else
		{
			// No underwater effect is required. Reset the accumulator.
			for( auto mut i= 0s; i < c_num_samples; ++i )
			{
				underwater_effect_accumulator_[i] = 0.0f;
			}
		}
	}

	underwater_effect_active_= new_underwater_effect_active_;
}

fn AudioMixer::ProcessMessage( mut this, InMessage mut message )
{
	// HACK! We can't move a value in "variant_visit", so, process special cases manually.
	if( message.has</ InMessageAddAudioStream />() )
	{
		return AddAudioStream( move( message ).try_move</ InMessageAddAudioStream />() );
	}

	variant_visit( &el : message )
	{
		return ProcessMessageImpl( el );
	}
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageSetPaused& message )
{
	// Store pause request in a separate variable - in order to enable sounds fading in pause transitions.
	new_paused_= message.paused;
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageSetUnderwater& message )
{
	// Store underwater effect request in a separate variable - in order to perform smooth transition.
	new_underwater_effect_active_= message.underwater;
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageAddSoundSource& message )
{
	// If a slot already uses the same ID, reuse it.
	// Normally it shouldn't be the case, but may happen in some tricky cases like level transition.
	// Prefer doing hard reset (without fading) for the old source rather than having two sources with the same ID.
	foreach( &mut source : sources_ )
	{
		if( source.id == message.id )
		{
			AssignNewSoundSourceToSlot( source, frequency_, message );
			return;
		}
	}

	// Search for a free slot.
	// It's fine to use linear search here, since we have only a small fixed number of slots.
	foreach( &mut source : sources_ )
	{
		if( source.id == c_empty_sound_source_id )
		{
			// Found a free slot. Assign it to the new source.
			AssignNewSoundSourceToSlot( source, frequency_, message );
			return;
		}
	}

	// Run out of free slots.
	// Just assume we finished playing this soruce instantly
	// and inform the other thread, that this sound source finished playing.

	var bool pushed= out_messages_queue_write_end_.TryPush(
		OutMessageSoundSourceFinished{ .id= message.id, .sound_data= message.sound_data } );

	// If the output queue is full, try removing this source next time an update for it is requested.
	ust::ignore_unused(pushed);
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageSetSoundSourceVolume& message )
{
	// It's fine to use linear search here, since we have only a small fixed number of slots.
	foreach( &mut source : sources_ )
	{
		if( source.id == message.id )
		{
			// Set new volume in order to gradually change current volume to it and avoid ugly "steps" and "cracks".
			source.new_volume= message.volume;
			return;
		}
	}

	// If we reached this place, it means, that the other thread doesn't know,
	// that this sound source is already removed or wasn't added at all.
	// It may happen, for example, if we run out of free slots.
	// Inform the other thread, that this sound source finished playing.

	var bool pushed= out_messages_queue_write_end_.TryPush( OutMessageSoundSourceFinished{ .id= message.id } );

	// If the output queue is full, try removing this source next time an update for it is requested.
	ust::ignore_unused(pushed);
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageRemoveSoundSource& message )
{
	// It's fine to use linear search here, since we have only a small fixed number of slots.
	foreach( &mut source : sources_ )
	{
		if( source.id == message.id )
		{
			// Mark a running source for removal, but not remove it immediately - to fade it nicely to zero.
			source.is_about_to_be_removed= true;
			break;
		}
	}
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageAddAmbientSound& message )
{
	// Assume here that the other thread stopped previous ambient sound assigned to this slot.
	// If it's not the case, we perform hard reset (without nice volume fading).

	var AmbientSound &mut ambient_sound= ambient_sounds_[ message.slot_index ];

	ambient_sound.sound_data= message.sound_data;
	// If an ambient sound starts playing from zero position, we can start with full volume,
	// since we assume, that the given sound data starts with silence.
	// Otherwise start with zero volume to avoid "cracks" and "steps".
	ambient_sound.current_volume= ( message.time_s == 0.0f ? message.volume : ust::make_array( 0.0f, 0.0f ) );
	ambient_sound.new_volume= message.volume;
	ambient_sound.sample_counter= u32( message.time_s * f32( frequency_ ) );
	ambient_sound.is_about_to_be_removed= false;
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageSetAmbientSoundVolume& message )
{
	ambient_sounds_[ message.slot_index ].new_volume= message.volume;
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageRemoveAmbientSound& message )
{
	ambient_sounds_[ message.slot_index ].is_about_to_be_removed= true;
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageAddSingleShotSound& message )
{
	foreach( &mut slot : single_shot_sounds_ )
	{
		if( slot.sound_data.empty() )
		{
			slot.sound_data= message.sound_data;
			slot.volume= message.volume;
			slot.sample_counter= 0u;
			return;
		}
	}

	// Has no free slots left.
	// Return sound data back immediately.

	var bool pushed=
		out_messages_queue_write_end_.TryPush( OutMessageSingleShotSoundFinished{ .sound_data= message.sound_data } );

	ust::ignore_unused( pushed ); // Can't handle here full queue.
}

fn AudioMixer::AddAudioStream( mut this, InMessageAddAudioStream mut message )
{
	auto { mut stream } = move(message);

	foreach( &mut slot : audio_streams_ )
	{
		if( slot.empty() )
		{
			slot=
				AudioStreamState
				{
					.stream= move(stream),
					.sample_counter= 0u,
					.last_two_samples= zero_init,
					.extracted_input_sample_counter= 0u,
				};

			return;
		}
	}

	// If we have no free slots left for a stream - return it back.
	// This should actually not happen.
	var bool pushed= out_messages_queue_write_end_.TryPush( OutMessageAudioStreamFinished{ .stream= move(stream) } );
	ust::ignore_unused( pushed ); // Can't handle this case.
}

fn AudioMixer::AssignNewSoundSourceToSlot( SoundSource &mut source, u32 frequency, InMessageAddSoundSource& message )
{
	source=
		SoundSource
		{
			.id= message.id,
			// If a sound starts playing from zero position, we can start with full volume,
			// since we assume, that the given sound data starts with silence.
			// Otherwise start with zero volume to avoid "cracks" and "steps".
			.current_volume= ( message.time_s == 0.0f ? message.volume : ust::make_array( 0.0f, 0.0f ) ),
			.new_volume= message.volume,
			.sound_data= message.sound_data,
			.sample_counter( message.time_s * f32( frequency ) ),
			.is_about_to_be_removed= false,
		};
}

fn AudioMixer::TryRemovingSoundSource(
	SoundSource &mut source, OutMessagesQueue::WriteEnd &mut out_messages_queue_write_end )
{
	// Pass a copy of the shared pointer containing sound data back.
	// Doing so we ensure that this thread is not the last one owning it
	// and thus prevent freeing memory of this data on this thread while resetting this shared pointer instance.
	// We need to prevent freeing memory here, since it may require some mutex locks (inside an allocator) or even system calls.
	if( out_messages_queue_write_end.TryPush(
			OutMessageSoundSourceFinished{ .id= source.id, .sound_data= source.sound_data } ) )
	{
		source.id= c_empty_sound_source_id;
		source.sample_counter= 0u;

		// It's fine to reset it now,
		// since a copy of this shared pointer is now in the queue and no actual memory freeing should take place.
		source.sound_data.reset();
	}
	else
	{
		// If the output queue is full, still assume this sound source to be playing, even if its end was reached.
		// Assume that we can push a finish message next time.
		source.current_volume= ust::make_array( 0.0f, 0.0f );
	}
}

fn AudioMixer::TryRemovingAmbientSound(
	AmbientSound &mut ambient_sound, size_type index, OutMessagesQueue::WriteEnd &mut out_messages_queue_write_end )
{
	// Pass a copy of the shared pointer containing sound data back.
	// Doing so we ensure that this thread is not the last one owning it
	// and thus prevent freeing memory of this data on this thread while resetting this shared pointer instance.
	// We need to prevent freeing memory here, since it may require some mutex locks (inside an allocator) or even system calls.
	if( out_messages_queue_write_end.TryPush(
		OutMessageAmbientSoundRemoved{ .slot_index(index), .sound_data= ambient_sound.sound_data } ) )
	{
		ambient_sound.sample_counter= 0u;
		ambient_sound.is_about_to_be_removed= false;

		// It's fine to reset it now,
		// since a copy of this shared pointer is now in the queue and no actual memory freeing should take place.
		ambient_sound.sound_data.reset();
	}
	else
	{
		// If the output queue is full, still assume this ambient sound to be playing, even if its end was reached.
		// Assume that we can push a finish message next time.
		ambient_sound.current_volume= ust::make_array( 0.0f, 0.0f );
	}
}

template</type T/>
fn constexpr GetScaleForSampleType() : f32
{
	static_assert( typeinfo</T/>.is_fundamental );
	static_assert( typeinfo</T/>.is_integer );

	var size_type num_bits= 8s * typeinfo</T/>.size_of;
	var u64 max_absolute_signed_value= 1u64 << ( num_bits - 1s );

	return 1.0f / f32( max_absolute_signed_value );
}

template</type T/>
fn constexpr GetOffsetForSampleType() : f32
{
	static_assert( typeinfo</T/>.is_fundamental );
	static_assert( typeinfo</T/>.is_integer );

	static_if( typeinfo</T/>.is_signed_integer )
	{
		return 0.0f;
	}
	else
	{
		var size_type num_bits= 8s * typeinfo</T/>.size_of;
		var u64 middle_value= 1u64 << ( num_bits - 1s );

		return -f32( middle_value );
	}
}

} // namespace PM
