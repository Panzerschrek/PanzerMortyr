import "audio_mixer.iu"
import "math_constants.iu"

namespace PM
{

fn AudioMixer::constructor(
	InMessagesQueue::ReadEnd mut in_messages_queue_read_end,
	OutMessagesQueue::WriteEnd mut out_messages_queue_write_end )
	(
		in_messages_queue_read_end_= move( in_messages_queue_read_end ),
		out_messages_queue_write_end_= move( out_messages_queue_write_end ),
		// Fill source slots with dummy data to indicated that they all are free.
		sources_
		[
			{
				.id= c_empty_sound_source_id,
				.current_volume= zero_init,
				.new_volume= zero_init,
				.sample_counter= 0u,
				.is_about_to_be_removed= false,
			} ...
		],
		ambient_sounds_
		[
			{
				.current_volume= zero_init,
				.new_volume= zero_init,
				.sample_counter= 0u,
				.is_about_to_be_removed= false,
			} ...
		],
		frequency_= 1u, // Set exact value later.
	)
{}

fn AudioMixer::SetFrequency( mut this, u32 frequency )
{
	frequency_= frequency;
}

fn AudioMixer::Mix( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	// Warning!
	// This code should finish executing in a predictable and pretty short amount of time,
	// since it's being executed by a background thread performing actual sound outputting and an unpredictable delay may lead to sound artifacts.
	// It should contain no blocking operations (like mutex blocking), system calls and even memory allocations/deallocations.

	// Zero the mix buffer before adding something to it.
	foreach( &mut out_sample_pair : out_sample_pairs )
	{
		foreach( &mut sample : out_sample_pair )
		{
			sample= 0.0f;
		}
	}

	// Process input messages.
	// Assume that we can process messages faster than the other thread can emit them and thus this loop ends eventually.
	loop
	{
		if_var( &message : in_messages_queue_read_end_.TryPop() )
		{
			ProcessMessage( message );
		}
		else
		{
			break;
		}
	}

	foreach( &mut sound_source : sources_ )
	{
		if( sound_source.id != c_empty_sound_source_id && !sound_source.sound_data.empty() )
		{
			var bool mut reached_sound_data_end= false;

			variant_visit( &sound_data : sound_source.sound_data.try_deref() )
			{
				var f32 resampling_factor= f32( sound_data.GetFrequency() ) / f32( frequency_ );

				auto sound_data_samples= sound_data.GetSamples();

				type InSampleType= typeof( sound_data_samples[0s] );

				var f32 constexpr sample_scale= GetScaleForSampleType</InSampleType/>();
				var f32 constexpr sample_offset= GetOffsetForSampleType</InSampleType/>();

				var ChannelsVolume start_volume
				[
					sound_source.current_volume[0] * sample_scale,
					sound_source.current_volume[1] * sample_scale,
				];

				var ChannelsVolume end_volume=
					( sound_source.is_about_to_be_removed
						// If is about to remove this sound source - fade its volume towards zero.
						? ust::make_array( 0.0f, 0.0f )
						: ust::make_array(
							sound_source.new_volume[0] * sample_scale,
							sound_source.new_volume[1] * sample_scale ) );

				if( start_volume[0] > 0.0f | start_volume[1] > 0.0f | end_volume[0] > 0.0f | end_volume[1] > 0.0f )
				{
					// Perform smooth volume change to avoid "cracks" and "steps".
					var ChannelsVolume mut current_volume= start_volume;
					var [ f32, c_num_samples ] volume_step_delta
					[
						f32( end_volume[0] - start_volume[0] ) / f32( out_sample_pairs.size() ),
						f32( end_volume[1] - start_volume[1] ) / f32( out_sample_pairs.size() ),
					];

					foreach( &mut out_sample_pair : out_sample_pairs )
					{
						// Perform here resampling with linear interpolation.
						// This works well, since output frequency is almost always higher than frequency of sound files of the original game.

						// We have enough f32 precision here, since regular sounds are pretty short.
						var f32 src_sample_index_fractional= f32( sound_source.sample_counter ) * resampling_factor;
						var u32 src_sample_index( src_sample_index_fractional );

						if( size_type( src_sample_index ) + 1s >= sound_data_samples.size() )
						{
							reached_sound_data_end= true;
							break;
						}

						var f32 mix_fraction= src_sample_index_fractional - f32( src_sample_index );
						var InSampleType sample_value0= sound_data_samples[ size_type( src_sample_index ) ];
						var InSampleType sample_value1= sound_data_samples[ size_type( src_sample_index ) + 1s ];

						var f32 mut sample_value=
							f32( sample_value0 ) * ( 1.0f - mix_fraction ) + f32( sample_value1 ) * mix_fraction;

						static_if( sample_offset != 0.0f )
						{
							sample_value+= sample_offset;
						}

						for( auto mut i= 0s; i < c_num_samples; ++i )
						{
							out_sample_pair[i]+= sample_value * current_volume[i];
						}

						++sound_source.sample_counter;

						for( auto mut i= 0s; i < c_num_samples; ++i )
						{
							current_volume[i]+= volume_step_delta[i];
						}
					}

					// Update current volume after interpolating it smoothly from old to new value.
					sound_source.current_volume= sound_source.new_volume;
				}
				else
				{
					// An optimization - don't mix sounds with zero volume.
					// But we still need to advance them in case if volume changes later.

					sound_source.sample_counter+= u32( out_sample_pairs.size() );

					var u32 src_sample_index( f32( sound_source.sample_counter ) * resampling_factor );

					if( size_type( src_sample_index ) + 1s >= sound_data_samples.size() )
					{
						reached_sound_data_end= true;
					}
				}
			}

			if( reached_sound_data_end | sound_source.is_about_to_be_removed )
			{
				// Perform removal AFTER performing mixing - to allow fading a sound to be removed.

				// Pass a copy of the shared pointer containing sound data back.
				// Doing so we ensure that this thread is not the last one owning it
				// and thus prevent freeing memory of this data on this thread while resetting this shared pointer instance.
				// We need to prevent freeing memory here, since it may require some mutex locks (inside an allocator) or even system calls.
				if( out_messages_queue_write_end_.TryPush(
						OutMessageSoundSourceFinished{ .id= sound_source.id, .sound_data= sound_source.sound_data } ) )
				{
					sound_source.id= c_empty_sound_source_id;
					sound_source.sample_counter= 0u;

					 // It's fine to reset it now,
					 // since a copy of this shared pointer is now in the queue and no actual memory freeing should take place.
					sound_source.sound_data.reset();
				}
				else
				{
					// If the output queue is full, still assume this sound source to be playing, even if its end was reached.
					// Assume that we can push a finish message next time.
				}
			}
		}
	}

	for( auto mut i= 0s; i < c_num_ambient_sound_slots; ++i )
	{
		var AmbientSound &mut ambient_sound= ambient_sounds_[i];

		if( ambient_sound.sound_data.empty() )
		{
			continue;
		}

		variant_visit( &sound_data : ambient_sound.sound_data.try_deref() )
		{
			// Store resampling factor in 16.16 fixed point format.
			// We can't use f32 for calculating sample indices for resampling,
			// since f32 gives not enough precision for long-playing ambient sounds.
			var u32 resampling_factor= ( sound_data.GetFrequency() << 16 ) / frequency_;

			auto sound_data_samples= sound_data.GetSamples();

			type InSampleType= typeof( sound_data_samples[0s] );

			var f32 constexpr sample_scale= GetScaleForSampleType</InSampleType/>();
			var f32 constexpr sample_offset= GetOffsetForSampleType</InSampleType/>();

			var ChannelsVolume start_volume
			[
				ambient_sound.current_volume[0] * sample_scale,
				ambient_sound.current_volume[1] * sample_scale,
			];

			var ChannelsVolume end_volume=
				( ambient_sound.is_about_to_be_removed
					// If is about to remove this ambient sound - fade its volume towards zero.
					? ust::make_array( 0.0f, 0.0f )
					: ust::make_array(
						ambient_sound.new_volume[0] * sample_scale,
						ambient_sound.new_volume[1] * sample_scale ) );

			if( start_volume[0] > 0.0f | start_volume[1] > 0.0f | end_volume[0] > 0.0f | end_volume[1] > 0.0f )
			{
				// Perform smooth volume change to avoid "cracks" and "steps".
				var ChannelsVolume mut current_volume= start_volume;
				var [ f32, c_num_samples ] volume_step_delta
				[
					f32( end_volume[0] - start_volume[0] ) / f32( out_sample_pairs.size() ),
					f32( end_volume[1] - start_volume[1] ) / f32( out_sample_pairs.size() ),
				];

				foreach( &mut out_sample_pair : out_sample_pairs )
				{
					// Perform here resampling with linear interpolation.
					// This works well, since output frequency is almost always higher than frequency of sound files of the original game.

					// Calculate fractional sample index in 48.16 fixed format.
					// This requires only 32-bit by 32-bit multiplication, which is fast even on 32-bit targets.
					var u64 src_sample_index_fractional( u64( ambient_sound.sample_counter ) * u64( resampling_factor ) );

					// Here 64-bit shift is required, which is also pretty fast on 32-bit targets (via "shrdl" instruction).
					var u32 src_sample_index( src_sample_index_fractional >> 16 );

					var f32 mix_fraction= f32( u32( src_sample_index_fractional ) & 65535u ) * ( 1.0f / 65536.0f );

					// Perform fetching with wrapping, since ambient sounds are looping.
					// Use 32-bit modulo operation, since it's faster than 64-bit (for size_type on 64-bit targets).
					var u32 num_source_samples( sound_data_samples.size() );
					var InSampleType sample_value0=
						sound_data_samples[ size_type( ( src_sample_index + 0u ) % num_source_samples ) ];
					var InSampleType sample_value1=
						sound_data_samples[ size_type( ( src_sample_index + 1u ) % num_source_samples ) ];

					var f32 mut sample_value=
						f32( sample_value0 ) * ( 1.0f - mix_fraction ) + f32( sample_value1 ) * mix_fraction;

					static_if( sample_offset != 0.0f )
					{
						sample_value+= sample_offset;
					}

					for( auto mut i= 0s; i < c_num_samples; ++i )
					{
						out_sample_pair[i]+= sample_value * current_volume[i];
					}

					++ambient_sound.sample_counter;

					for( auto mut i= 0s; i < c_num_samples; ++i )
					{
						current_volume[i]+= volume_step_delta[i];
					}
				}

				// Update current volume after interpolating it smoothly from old to new value.
				ambient_sound.current_volume= ambient_sound.new_volume;
			}
			else
			{
				// An optimization - don't mix sounds with zero volume.
				// But we still need to advance them in case if volume changes later.

				ambient_sound.sample_counter+= u32( out_sample_pairs.size() );
			}
		}

		if( ambient_sound.is_about_to_be_removed )
		{
			// Perform removal AFTER performing mixing - to allow fading an ambient sound to be removed.

			// Pass a copy of the shared pointer containing sound data back.
			// Doing so we ensure that this thread is not the last one owning it
			// and thus prevent freeing memory of this data on this thread while resetting this shared pointer instance.
			// We need to prevent freeing memory here, since it may require some mutex locks (inside an allocator) or even system calls.
			if( out_messages_queue_write_end_.TryPush(
				OutMessageAmbientSoundRemoved{ .slot_index(i), .sound_data= ambient_sound.sound_data } ) )
			{
				ambient_sound.sample_counter= 0u;
				ambient_sound.is_about_to_be_removed= false;

				 // It's fine to reset it now,
				 // since a copy of this shared pointer is now in the queue and no actual memory freeing should take place.
				ambient_sound.sound_data.reset();
			}
			else
			{
				// If the output queue is full, still assume this ambient sound to be playing, even if its end was reached.
				// Assume that we can push a finish message next time.
			}
		}
	}
}

fn AudioMixer::ProcessMessage( mut this, InMessage& message )
{
	variant_visit( &el : message )
	{
		ProcessMessageImpl( el );
	}
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageAddSoundSource& message )
{
	foreach( &mut source : sources_ )
	{
		// Search for a free slot.
		// It's fine to use linear search here, since we have only a small fixed number of slots.
		if( source.id == c_empty_sound_source_id )
		{
			// Found a free slot. Assign it to the new source.

			source=
				SoundSource
				{
					.id= message.id,
					.current_volume= message.volume,
					.new_volume= message.volume,
					.sound_data= message.sound_data,
					.sample_counter= 0u,
					.is_about_to_be_removed= false,
				};

			return;
		}
	}

	// Run out of free slots.
	// Just assume we finished playing this soruce instantly
	// and inform the other thread, that this sound source finished playing.

	var bool pushed= out_messages_queue_write_end_.TryPush(
		OutMessageSoundSourceFinished{ .id= message.id, .sound_data= message.sound_data } );

	// If the output queue is full, try removing this source next time an update for it is requested.
	ust::ignore_unused(pushed);
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageSetSoundSourceVolume& message )
{
	// It's fine to use linear search here, since we have only a small fixed number of slots.
	foreach( &mut source : sources_ )
	{
		if( source.id == message.id )
		{
			// Set new volume in order to gradually change current volume to it and avoid ugly "steps" and "cracks".
			source.new_volume= message.volume;
			return;
		}
	}

	// If we reached this place, it means, that the other thread doesn't know,
	// that this sound source is already removed or wasn't added at all.
	// It may happen, for example, if we run out of free slots.
	// Inform the other thread, that this sound source finished playing.

	var bool pushed= out_messages_queue_write_end_.TryPush( OutMessageSoundSourceFinished{ .id= message.id } );

	// If the output queue is full, try removing this source next time an update for it is requested.
	ust::ignore_unused(pushed);
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageRemoveSoundSource& message )
{
	// It's fine to use linear search here, since we have only a small fixed number of slots.
	foreach( &mut source : sources_ )
	{
		if( source.id == message.id )
		{
			// Mark a running source for removal, but not remove it immediately - to fade it nicely to zero.
			source.is_about_to_be_removed= true;
			break;
		}
	}
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageAddAmbientSound& message )
{
	// Assume here that the other thread stopped previous ambient sound assigned to this slot.
	// If it's not the case, we perform hard reset (without nice volume fading).

	var AmbientSound &mut ambient_sound= ambient_sounds_[ message.slot_index ];

	ambient_sound.sound_data= message.sound_data;
	ambient_sound.new_volume= message.volume;
	ambient_sound.current_volume= message.volume;
	ambient_sound.sample_counter= 0u;
	ambient_sound.is_about_to_be_removed= false;
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageSetAmbientSoundVolume& message )
{
	ambient_sounds_[ message.slot_index ].new_volume= message.volume;
}

fn AudioMixer::ProcessMessageImpl( mut this, InMessageRemoveAmbientSound& message )
{
	ambient_sounds_[ message.slot_index ].is_about_to_be_removed= true;
}

template</type T/>
fn constexpr GetScaleForSampleType() : f32
{
	static_assert( typeinfo</T/>.is_fundamental );
	static_assert( typeinfo</T/>.is_integer );

	var size_type num_bits= 8s * typeinfo</T/>.size_of;
	var u64 max_absolute_signed_value= 1u64 << ( num_bits - 1s );

	return 1.0f / f32( max_absolute_signed_value );
}

template</type T/>
fn constexpr GetOffsetForSampleType() : f32
{
	static_assert( typeinfo</T/>.is_fundamental );
	static_assert( typeinfo</T/>.is_integer );

	static_if( typeinfo</T/>.is_signed_integer )
	{
		return 0.0f;
	}
	else
	{
		var size_type num_bits= 8s * typeinfo</T/>.size_of;
		var u64 middle_value= 1u64 << ( num_bits - 1s );

		return -f32( middle_value );
	}
}

} // namespace PM
