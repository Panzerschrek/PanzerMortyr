import "/math.iu"
import "audio_mixer.iu"
import "math_constants.iu"

namespace PM
{

fn AudioMixer::constructor( AudioMixerSharedDataPtr mut shared_data )
	(
		shared_data_= move(shared_data),
		frequency_= 1u, // Set exact value later.
		sample_counter_= 0u,
	)
{}

fn AudioMixer::SetFrequency( mut this, u32 frequency )
{
	frequency_= frequency;
}

fn AudioMixer::Mix( mut this, ust::array_view_mut</SamplePairType/> out_sample_pairs )
{
	// Zero mix buffer before adding something to it.
	foreach( &mut out_sample_pair : out_sample_pairs )
	{
		foreach( &mut sample : out_sample_pair )
		{
			sample= 0.0f;
		}
	}

	if( false )
	{
		var [ f32, 2 ] freq_scales
		[
			400.0f * c_tau / f32( frequency_ ),
			200.0f * c_tau / f32( frequency_ ),
		];

		foreach( &mut out_sample_pair : out_sample_pairs )
		{
			out_sample_pair[0]+= ust::sin( f32( sample_counter_ ) * freq_scales[0] );
			out_sample_pair[1]+= ust::sin( f32( sample_counter_ ) * freq_scales[1] );

			++sample_counter_;
		}
	}

	auto mut lock= shared_data_.lock_mut();
	var AudioMixerSharedData &mut shared_data= lock.deref();

	for( auto mut i= 0s; i < shared_data.channels.size(); )
	{
		var bool mut need_to_remove= false;

		{
			var AudioMixerSharedData::Channel &mut channel= shared_data.channels[i];

			if_var( &sound_data : channel.sound_data.deref().get</ SoundData</i16/> />() )
			{
				var f32 max_sample_abs_value= 32768.0f;

				// TODO - use proper input per-channel volume.
				var [ f32, 2 ] scaled_volume
				[
					1.0f / max_sample_abs_value,
					1.0f / max_sample_abs_value,
				];

				var f32 resampling_factor= f32( sound_data.GetFrequency() ) / f32( frequency_ );

				var ust::array_view_imut</i16/> sound_data_samples= sound_data.GetSamples();

				foreach( &mut out_sample_pair : out_sample_pairs )
				{
					// TODO - use linear interploation for resampling.
					var u32 src_sample_index( f32( channel.sample_counter ) * resampling_factor );

					if( size_type( src_sample_index ) >= sound_data_samples.size() )
					{
						need_to_remove= true;
						break;
					}

					var f32 sample_value= f32( sound_data_samples[ size_type( src_sample_index ) ] );

					out_sample_pair[0]+= sample_value * scaled_volume[0];
					out_sample_pair[1]+= sample_value * scaled_volume[1];

					++channel.sample_counter;
				}
			}
			else
			{
				// TODO - handle other formats.
			}
		}

		if( need_to_remove )
		{
			var size_type last= shared_data.channels.size() - 1s;
			shared_data.channels.swap( i, last );
			shared_data.channels.drop_back();
		}
		else
		{
			++i;
		}
	}
}

} // namespace PM
