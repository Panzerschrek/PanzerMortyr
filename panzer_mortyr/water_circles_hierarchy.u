import "water_circles_hierarchy.iu"
import "bounding_boxes_hierarchy_building.iu"

namespace PM
{

fn BuildWaterCirclesHierarchy(
	ust::array_view_imut</ZmapLamRainDroplet/> rain_droplets,
	ust::array_view_imut</ZmapQuad/> quads,
	BitArrayView wet_material_bits ) : WaterCirclesHierarchy
{
	// TODO - move constants into common place.
	var Vec3f move_vector( 0.235f, 0.235f, 0.943f );

	var ust::vector</WaterCircleInHierarchy/> mut water_circles;

	foreach( &rain_droplet : rain_droplets )
	{
		if( size_type( rain_droplet.quad_index ) >= quads.size() )
		{
			continue;
		}

		var size_type quad_textre_id( quads[ size_type( rain_droplet.quad_index ) ].texture_id );
		if( quad_textre_id >= wet_material_bits.GetSize() || !wet_material_bits.GetBit( quad_textre_id ) )
		{
			continue;
		}

		water_circles.push_back(
			WaterCircleInHierarchy
			{
				.position=
					Vec3f(
						f32( rain_droplet.position[0] ),
						f32( rain_droplet.position[1] ),
						f32( rain_droplet.position[2] ) ) +
					move_vector * rain_droplet.travel_distance,
				.rain_droplet_travel_distance= rain_droplet.travel_distance,
				.rain_droplet_movement_phase= rain_droplet.movement_phase
			} );
	}

	var size_type max_elements_in_node= 8s;

	return
		BuildBoundingBoxesHierarchy(
			water_circles.range(),
			max_elements_in_node,
			lambda( WaterCircleInHierarchy& c ) : BBox3f{ return BBox3f{ .min= c.position, .max= c.position }; } );
}

} // namespace PM
