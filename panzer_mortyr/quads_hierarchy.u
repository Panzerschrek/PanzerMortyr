import "/common_lib/materials_file.iu"
import "bounding_boxes_hierarchy_building.iu"
import "cluster_utils.iu"
import "quads_hierarchy.iu"

namespace PM
{

fn BuildColliderQuadsHierarchy(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads ) : QuadsHierarchy
{
	var ust::vector</PackedQuadIndex/> mut quad_indices;

	for( auto mut c= 0s; c < clusters.size(); ++c )
	{
		var ZvoxCluster& cluster= clusters[c];

		if( !(
			cluster.cluster_type == ZvoxCluster::c_cluster_type_regular |
			cluster.cluster_type == ZvoxCluster::c_cluster_type_notes ) )
		{
			// Do not include dynamic clusters into quads hierarchy.
			// But include note clusters.
			continue;
		}

		for( var size_type mut q( cluster.c.first_quad_index ), q_end= size_type( cluster.c.first_quad_index ) + size_type( cluster.num_quads );
			q < q_end;
			++q )
		{
			var ZmapQuad& quad= quads[q];
			var u32 texture_id( quad.texture_id );

			if(
				// There is no collisions with water quads.
				texture_id == MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Water ) ] ||
				// There is no collisions with acid quads.
				texture_id == MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Acid ) ] ||
				// There is no collisions with sky quads.
				texture_id == MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Sky ) ] ||
				// Collisions with glass are possible, but they should be handled dynamically, since glass is breakable.
				texture_id == MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ] )
			{
				continue;
			}

			quad_indices.push_back( PackedQuadIndex( c, q ) );
		}
	}

	auto get_bbox_func=
		lambda[&]( PackedQuadIndex& packed_quad_index ) : BBox3f
		{
			var BBox3f mut bbox
			{
				.min( ust::plus_inf </f32/>(), ust::plus_inf </f32/>(), ust::plus_inf </f32/>() ),
				.max( ust::minus_inf</f32/>(), ust::minus_inf</f32/>(), ust::minus_inf</f32/>() ),
			};

			var ZvoxCluster& cluster= clusters[ packed_quad_index.GetClusterIndex() ];
			var ZmapQuad& quad= quads[ packed_quad_index.GetQuadIndex() ];

			foreach( &v : quad.vertices )
			{
				var Vec3f pos(
					f32( cluster.c.center[0] + i32( v[0] ) ),
					f32( cluster.c.center[1] + i32( v[1] ) ),
					f32( cluster.c.center[2] + i32( v[2] ) ) );
				ust::min_assign( bbox.min.x, pos.x );
				ust::max_assign( bbox.max.x, pos.x );
				ust::min_assign( bbox.min.y, pos.y );
				ust::max_assign( bbox.max.y, pos.y );
				ust::min_assign( bbox.min.z, pos.z );
				ust::max_assign( bbox.max.z, pos.z );
			}

			return bbox;
		};

	// This value was tuned to achieve maximum performance.
	var size_type c_max_quads_in_node= 6s;

	return BuildBoundingBoxesHierarchy( quad_indices.range(), c_max_quads_in_node, get_bbox_func );
}

} // namespace PM

