import "/variant.u"
import "/vector.u"
import "/common_lib/map_files.uh"
import "bbox.uh"

namespace PM
{

struct ClusterHierarchy
{
	ust::vector</Node/> nodes;
	ust::vector</u32/> cluster_indices;

	struct Node
	{
		BBox3f bbox;
		ust::variant</ tup[ BranchNodeContents, LeafNodeContents ] /> contents;
	}

	struct BranchNodeContents
	{
		[ u32, 2 ] children_nodes;

	}

	struct LeafNodeContents
	{
		u32 first_cluster_index;
		u32 num_cluster_indices;
	}
}

fn BuildClusterHierarchy( ust::array_view_imut</ZvoxCluster/> clusters ) : ClusterHierarchy;

} // namespace PM
