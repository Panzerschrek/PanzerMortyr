import "/variant.u"
import "/vector.u"
import "/common_lib/map_files.uh"
import "bbox.uh"

namespace PM
{

struct ClusterHierarchy
{
	ust::vector</Node/> nodes;
	ust::vector</u16/> cluster_indices;

	struct Node
	{
		BBox3f bbox;
		ust::variant</ tup[ BranchNodeContents, LeafNodeContents ] /> contents;
	}

	struct BranchNodeContents
	{
		[ u16, 2 ] children_nodes;
	}

	struct LeafNodeContents
	{
		u16 first_cluster_index;
		u16 num_cluster_indices;
	}
}

fn BuildClusterHierarchy( ust::array_view_imut</ZvoxCluster/> clusters ) : ClusterHierarchy;

template</type Func/>
fn VisitClusterHierarchy( ClusterHierarchy& hierarchy, BBox3f& bbox, Func& func )
{
	VisitClusterHierarchy_r( hierarchy, 0u16, bbox, func );
}

template</type Func/>
fn VisitClusterHierarchy_r( ClusterHierarchy& hierarchy, u16 node_index, BBox3f& bbox, Func& func )
{
	var ClusterHierarchy::Node& node= hierarchy.nodes[ size_type( node_index ) ];

	if( !bbox.InstersectsOrTouches( node.bbox ) )
	{
		return;
	}

	if_var( &branch_node_contents : node.contents.get</ClusterHierarchy::BranchNodeContents/>() )
	{
		foreach( child_node_index : branch_node_contents.children_nodes )
		{
			VisitClusterHierarchy_r( hierarchy, child_node_index, bbox, func );
		}
	}
	else if_var( &leaf_node_contents : node.contents.get</ClusterHierarchy::LeafNodeContents/>() )
	{
		foreach( cluster_index : hierarchy.cluster_indices.range().subrange(
			size_type( leaf_node_contents.first_cluster_index ),
			size_type( leaf_node_contents.first_cluster_index ) + size_type( leaf_node_contents.num_cluster_indices ) ) )
		{
			func( size_type( cluster_index ) );
		}
	}
	else{ halt; }
}

} // namespace PM
