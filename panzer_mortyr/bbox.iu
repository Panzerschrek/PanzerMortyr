import "/minmax.iu"
import "vec.iu"

namespace PM
{

type BBox3f= BBox3</f32/>;

// Axis-aligned bounding box defined by min and max coordinates of its corners.
template</type T/>
struct BBox3
{
	type ThisType= BBox3</T/>;

	Vec3</T/> min;
	Vec3</T/> max;

	fn PointIsInside( this, Vec3</T/>& p ) : bool
	{
		return
			p.x > min.x && p.x < max.x &&
			p.y > min.y && p.y < max.y &&
			p.z > min.z && p.z < max.z;
	}

	fn PointIsInsideOrOnFace( this, Vec3</T/>& p ) : bool
	{
		return
			p.x >= min.x && p.x <= max.x &&
			p.y >= min.y && p.y <= max.y &&
			p.z >= min.z && p.z <= max.z;
	}

	fn Instersects( this, ThisType& other ) : bool
	{
		return !(
			this.max.x <= other.min.x | this.min.x >= other.max.x |
			this.max.y <= other.min.y | this.min.y >= other.max.y |
			this.max.z <= other.min.z | this.min.z >= other.max.z );
	}

	fn InstersectsOrTouches( this, ThisType& other ) : bool
	{
		return !(
			this.max.x < other.min.x | this.min.x > other.max.x |
			this.max.y < other.min.y | this.min.y > other.max.y |
			this.max.z < other.min.z | this.min.z > other.max.z );
	}

	fn Contains( this, ThisType& other ) : bool
	{
		return
			this.min.x <= other.min.x & this.max.x >= other.max.x &
			this.min.y <= other.min.y & this.max.y >= other.max.y &
			this.min.z <= other.min.z & this.max.z >= other.max.z;
	}

	fn CreateCornerVertices( this ) : [ Vec3</T/>, 8 ]
	{
		var [ Vec3</T/>, 8 ] corner_vertices
		[
			( min.x, min.y, min.z ),
			( max.x, min.y, min.z ),
			( min.x, max.y, min.z ),
			( max.x, max.y, min.z ),
			( min.x, min.y, max.z ),
			( max.x, min.y, max.z ),
			( min.x, max.y, max.z ),
			( max.x, max.y, max.z ),
		];

		return corner_vertices;
	}

	fn GetCenter( this ) : Vec3</T/>
	{
		return ( min + max ) * T( 0.5 );
	}

	fn GetDimensions( this ) : Vec3</T/>
	{
		return max - min;
	}

	fn GetIntersectionVolume( this, ThisType& other ) : T
	{
		var ThisType intersection
		{
			.min(
				ust::max( this.min.x, other.min.x ),
				ust::max( this.min.y, other.min.y ),
				ust::max( this.min.z, other.min.z ) ),
			.max(
				ust::min( this.max.x, other.max.x ),
				ust::min( this.max.y, other.max.y ),
				ust::min( this.max.z, other.max.z ) ),
		};

		return
			ust::max( T(0), intersection.max.x - intersection.min.x ) *
			ust::max( T(0), intersection.max.y - intersection.min.y ) *
			ust::max( T(0), intersection.max.z - intersection.min.z );
	}

	fn ExtendWithPoint( mut this, Vec3</T/>& p )
	{
		ust::min_assign( min.x, p.x );
		ust::min_assign( min.y, p.y );
		ust::min_assign( min.z, p.z );
		ust::max_assign( max.x, p.x );
		ust::max_assign( max.y, p.y );
		ust::max_assign( max.z, p.z );
	}

	fn ExtendWithOther( mut this, ThisType& other )
	{
		ust::min_assign( min.x, other.min.x );
		ust::min_assign( min.y, other.min.y );
		ust::min_assign( min.z, other.min.z );
		ust::max_assign( max.x, other.max.x );
		ust::max_assign( max.y, other.max.y );
		ust::max_assign( max.z, other.max.z );
	}
}

} // namespace PM
