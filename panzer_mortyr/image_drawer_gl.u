import "gl_functions.iu"
import "gl_state.iu"
import "image_drawer_gl.iu"
import "image_loading.iu"

namespace PM
{

fn ImageDrawerGL::constructor(
	[ u32, 2 ] viewport_size, GameFilesystemPtr mut game_filesystem_ptr, SettingsPtr&  settings )
	(
		game_filesystem_ptr_= move(game_filesystem_ptr),
		use_nearest_texture_filter_= settings.lock_imut().deref().r_gui_texture_nearest_filter,
		viewport_size_= viewport_size,
		shader_( embed</char8/>( "shaders/image.vert.glsl" ), embed</char8/>( "shaders/image.frag.glsl" ) ),
		temp_texture_= Texture::Create( GLenum( GL_TEXTURE_2D ) )
	)
{}

fn ImageDrawerGL::PreloadImage(
	mut this, ResourceString& image_file_name, ust::optional_ref_imut</ [ u8, 3 ] /> transparent_color )
{
	if( textures_.exists( image_file_name ) )
	{
		return;
	}

	auto mut lock= game_filesystem_ptr_.lock_mut();

	result_match( lock.deref().LoadFile( image_file_name, LoadImageBMP ) )
	{
		Ok( mut image_data ) ->
		{
			if_var( &c : transparent_color )
			{
				// Make transparent color black and for other colors set alpha to 255.
				foreach( &mut pixel : image_data.pixels )
				{
					if( pixel[0] == c[0] & pixel[1] == c[1] & pixel[2] == c[2] )
					{
						pixel= ust::make_array( 0u8, 0u8, 0u8, 0u8 );
					}
					else
					{
						pixel[3]= 255u8;
					}
				}
			}
			else
			{
				// Always set alpha to 255.
				foreach( &mut pixel : image_data.pixels )
				{
					pixel[3]= 255u8;
				}
			}

			var Texture mut texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
			texture.Bind();

			unsafe( glTexImage2D(
				GLenum( GL_TEXTURE_2D ),
				0,
				GLint( GL_RGBA8 ),
				GLsizei( image_data.size[0] ),
				GLsizei( image_data.size[1] ),
				0,
				GLenum( GL_RGBA ),
				GLenum( GL_UNSIGNED_BYTE ),
				ust::ptr_cast_to_byte8( image_data.pixels.range().data() ) ) );

			// Use simple filtrations with no mips.
			auto filtration= ( use_nearest_texture_filter_ ? GL_NEAREST : GL_LINEAR );
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), filtration ) );
			unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), filtration ) );

			textures_.insert_new( image_file_name, TextureExt{ .texture= move(texture), .size= image_data.size } );
		},
		Err(e) ->
		{
			// TODO - print error message.
			ust::ignore_unused(e);

			// Save a stub to avoid loading it again.
			textures_.insert_new( image_file_name, ust::optional</TextureExt/>() );
		}
	}
}

fn ImageDrawerGL::GetImageSize( this, ResourceString& image_file_name ) : ust::optional</ [ u32, 2 ] />
{
	if_var( & texture_opt : textures_.find( image_file_name ) )
	{
		if_var( & texture : texture_opt )
		{
			return texture.size;
		}
	}

	return ust::null_optional;
}

fn ImageDrawerGL::DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale )
{
	DrawImage( image_file_name, x, y, scale, 255u8 );
}

fn ImageDrawerGL::DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale, u8 alpha )
{
	if_var( size : GetImageSize( image_file_name ) )
	{
		DrawImage( image_file_name, x, y, scale, 0u, 0u, size[0], size[1], alpha );
	}
}

fn ImageDrawerGL::DrawImage(
	mut this,
	ResourceString& image_file_name,
	i32 x, i32 y,
	f32 scale,
	u32 tc_offset_x, u32 tc_offset_y,
	u32 tc_size_x, u32 tc_size_y )
{
	DrawImage( image_file_name, x, y, scale, tc_offset_x, tc_offset_y, tc_size_x, tc_size_y, 255u8 );
}

fn ImageDrawerGL::DrawImage(
	mut this,
	ResourceString& image_file_name,
	i32 x, i32 y,
	f32 scale,
	u32 tc_offset_x, u32 tc_offset_y,
	u32 tc_size_x, u32 tc_size_y,
	u8 alpha )
{
	auto texture_opt_opt= textures_.find( image_file_name );
	if( texture_opt_opt.empty() || texture_opt_opt.try_deref().empty() )
	{
		return;
	}

	var TextureExt& texture_ext= texture_opt_opt.try_deref().try_deref();

	SetGLState( g_image_drawing_gl_state );

	var u32 texture_slot= 0u;

	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
	texture_ext.texture.Bind();

	shader_.Bind();

	shader_.SetUniform(
		"vu_scale",
		Vec2f(
			2.0f * scale * f32( tc_size_x ) / f32( viewport_size_[0] ),
			2.0f * scale * f32( tc_size_y ) / f32( viewport_size_[1] ) ) );

	shader_.SetUniform(
		"vu_offset",
		Vec2f(
			2.0f * f32(x) / f32( viewport_size_[0] ) - 1.0f,
			2.0f * f32(y) / f32( viewport_size_[1] ) - 1.0f ) );

	shader_.SetUniform(
		"vu_tc_scale",
		Vec2f(
			f32( tc_size_x ) / f32( texture_ext.size[0] ),
			f32( tc_size_y ) / f32( texture_ext.size[1] ) ) );

	shader_.SetUniform(
		"vu_tc_offset",
		Vec2f(
			f32( tc_offset_x ) / f32( texture_ext.size[0] ),
			f32( tc_offset_y ) / f32( texture_ext.size[1] ) ) );

	shader_.SetUniform( "fu_texture", texture_slot );

	shader_.SetUniform( "fu_alpha", f32( alpha ) / 255.0f );

	vertex_array_object_.Bind();

	unsafe( glDrawArrays( GLenum( GL_TRIANGLES ), GLint(0), GLsizei(6) ) );
}

fn ImageDrawerGL::UploadAndDrawImage( mut this, ImageData& image_data, i32 x, i32 y, f32 scale )
{
	var u32 texture_slot= 0u;
	unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );

	temp_texture_.Bind();

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( image_data.size[0] ),
		GLsizei( image_data.size[1] ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::ptr_cast_to_byte8( image_data.pixels.range().data() ) ) );

	// Use simple filtrations with no mips.
	auto filtration= ( use_nearest_texture_filter_ ? GL_NEAREST : GL_LINEAR );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), filtration ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), filtration ) );

	SetGLState( g_image_drawing_gl_state );

	shader_.Bind();

	shader_.SetUniform(
		"vu_scale",
		Vec2f(
			2.0f * scale * f32( image_data.size[0] ) / f32( viewport_size_[0] ),
			2.0f * scale * f32( image_data.size[1] ) / f32( viewport_size_[1] ) ) );
	shader_.SetUniform(
		"vu_offset",
		Vec2f(
			2.0f * f32(x) / f32( viewport_size_[0] ) - 1.0f,
			2.0f * f32(y) / f32( viewport_size_[1] ) - 1.0f ) );
	shader_.SetUniform( "vu_tc_scale", Vec2f( 1.0f, 1.0f ) );
	shader_.SetUniform( "vu_tc_offset", Vec2f::MakeZero() );
	shader_.SetUniform( "fu_texture", texture_slot );
	shader_.SetUniform( "fu_alpha", 1.0f );

	vertex_array_object_.Bind();

	unsafe( glDrawArrays( GLenum( GL_TRIANGLES ), GLint(0), GLsizei(6) ) );
}

var GLState g_image_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= true,
	.blend_source_factor( GL_SRC_ALPHA ),
	.blend_destination_factor( GL_ONE_MINUS_SRC_ALPHA ),
};

} // namespace PM
