import "/random_access_range.u"
import "vec.uh"

namespace PM
{

// This class calculates average movement vector across multiple frames (if necessary).
class PlayerMovementController
{
public:
	fn Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state );

	// Returns vector representing average move wish direction.
	// Its XY projection shouldn't be longer than 1.
	fn GetAccumulatedMoveWishVector( this ) : Vec3f;

	fn GetJumpRequested( this ) : bool;
	fn GetCrouchingRequiested( this ) : bool;

	// Reset state - after this call averaging will start from zero.
	fn Reset( mut this );

private:
	Vec3f accumulated_move_wish_vector_= Vec3f::MakeZero();
	f32 accumulated_time_s_= 0.0f;
	bool jump_requested_= false;
	bool crouching_requiested_= false;
}

} // namespace PM
