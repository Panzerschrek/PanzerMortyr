import "game_filesystem.uh"
import "shader_program.uh"
import "texture.uh"

namespace PM
{

class ImageDrawer
{
public:
	fn constructor( GameFilesystemPtr game_filesystem_ptr );

	// use separate method for image preloading
	// in order to allow preloading all images at loading stage and avoid slow-downs later due to slow disk access.
	fn PreloadImage( mut this, ResourceString& image_file_name );

	// Image should be preloaded first.
	fn DrawImage( mut this, ResourceString& image_file_name );

private:
	GameFilesystemPtr imut game_filesystem_ptr_;

	ShaderProgram shader_;

	ust::hash_map</ ResourceString, ust::optional</Texture/> /> textures_;
}

} // namespace PM
