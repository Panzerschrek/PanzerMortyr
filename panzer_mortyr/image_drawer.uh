import "game_filesystem.uh"
import "shader_program.uh"
import "texture.uh"

namespace PM
{

class ImageDrawer
{
public:
	fn constructor( [ u32, 2 ] viewport_size, GameFilesystemPtr game_filesystem_ptr );

	// use separate method for image preloading
	// in order to allow preloading all images at loading stage and avoid slow-downs later due to slow disk access.
	fn PreloadImage( mut this, ResourceString& image_file_name );

	// Image should be preloaded first.
	fn DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, u32 scale );

private:
	struct TextureExt
	{
		Texture texture;
		[ u32, 2 ] size;
	}

private:
	GameFilesystemPtr imut game_filesystem_ptr_;
	[ u32, 2 ] imut viewport_size_;

	ShaderProgram shader_;

	ust::hash_map</ ResourceString, ust::optional</TextureExt/> /> textures_;
}

} // namespace PM
