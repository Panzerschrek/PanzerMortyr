import "decals.iu"
import "mat.iu"
import "physics_utils.iu"

namespace PM
{

fn CreateDecalPolygons(
	ust::array_view_imut</WorldDrawingInfo::Decal/> decals,
	ust::array_view_imut</ZmapQuad/> quads,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	foreach( &decal : decals )
	{
		if( size_type( decal.quad_index ) >= quads.size() )
		{
			continue;
		}

		// Rotate the decal so it lies in the plane of its parent quad.

		var Vec3f quad_normal= CalculateQuadNormal( quads[ size_type( decal.quad_index ) ] );

		// TODO - avoid calculating angles here, calculate matrices directly.
		var f32 azimuth= ust::atan2( quad_normal.x, -quad_normal.y );
		var f32 elevation= ust::atan2( quad_normal.xy().Length(), quad_normal.z );

		var Mat4f rotation_matrix= Mat4f::MakeRotationX( elevation ) * Mat4f::MakeRotationZ( azimuth );

		var f32 half_size= 8.0f;

		var [ Vec3f, 2 ] basis_vecs
		[
			Vec3f( half_size, 0.0f, 0.0f ) * rotation_matrix,
			Vec3f( 0.0f, half_size, 0.0f ) * rotation_matrix,
		];

		var [ Vec3f, 4 ] vertex_positions
		[
			decal.position - basis_vecs[0] - basis_vecs[1],
			decal.position + basis_vecs[0] - basis_vecs[1],
			decal.position - basis_vecs[0] + basis_vecs[1],
			decal.position + basis_vecs[0] + basis_vecs[1],
		];

		var size_type base_vertex= out_vertices.size();

		var f32 texture_layer= 153.0f;


		out_vertices.push_back(
			MapVertex
			{
				.position[ vertex_positions[0].x, vertex_positions[0].y, vertex_positions[0].z ],
				.tex_coordinates[ 0.0f, 0.0f, texture_layer ],
				.light[ 255u8 ... ],
				.fog_params= zero_init,
			} );

		out_vertices.push_back(
			MapVertex
			{
				.position[ vertex_positions[1].x, vertex_positions[1].y, vertex_positions[1].z ],
				.tex_coordinates[ 0.5f, 0.0f, texture_layer ],
				.light[ 255u8 ... ],
				.fog_params= zero_init,
			} );

		out_vertices.push_back(
			MapVertex
			{
				.position[ vertex_positions[2].x, vertex_positions[2].y, vertex_positions[2].z ],
				.tex_coordinates[ 0.0f, 0.5f, texture_layer ],
				.light[ 255u8 ... ],
				.fog_params= zero_init,
			} );

		out_vertices.push_back(
			MapVertex
			{
				.position[ vertex_positions[3].x, vertex_positions[3].y, vertex_positions[3].z ],
				.tex_coordinates[ 0.5f, 0.5f, texture_layer ],
				.light[ 255u8 ... ],
				.fog_params= zero_init,
			} );

		out_indices.push_back( u16( base_vertex + 0s ) );
		out_indices.push_back( u16( base_vertex + 1s ) );
		out_indices.push_back( u16( base_vertex + 2s ) );
		out_indices.push_back( u16( base_vertex + 3s ) );
		out_indices.push_back( u16( base_vertex + 2s ) );
		out_indices.push_back( u16( base_vertex + 1s ) );
	}
}

} // namespace PM
