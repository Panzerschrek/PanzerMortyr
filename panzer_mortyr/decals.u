import "bounding_boxes_hierarchy_visiting.iu"
import "decals.iu"
import "mat.iu"
import "plane.iu"
import "physics_utils.iu"

namespace PM
{

fn CreateDecalPolygons(
	ust::array_view_imut</WorldDrawingInfo::Decal/> decals,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads,
	ZmapLamData& zmap_lam_data,
	QuadsHierarchy& quads_hierarchy,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	var f32 c_min_decal_surface_angle_cos= 0.5f;
	var f32 c_max_distance_to_quad_plane= 4.0f;

	var f32 decal_half_size= 8.0f;

	var f32 decal_radius= ust::sqrt( 3.0f ) * decal_half_size;

	var [ DecalPolygonVertex, c_max_decal_polygon_vertices ]
		mut decal_vertices[ Vec3f::MakeZero() ... ],
		mut decal_vertices_clipped[ Vec3f::MakeZero() ... ];

	foreach( &decal : decals )
	{
		if( size_type( decal.quad_index ) >= quads.size() )
		{
			continue;
		}

		// Rotate the decal so it lies in the plane of its parent quad.

		var Vec3f source_quad_normal= CalculateQuadNormal( quads[ size_type( decal.quad_index ) ] );
		var f32 source_quad_normal_length= source_quad_normal.Length();

		// TODO - avoid calculating angles here, calculate matrices directly.
		var f32 azimuth= ust::atan2( source_quad_normal.x, -source_quad_normal.y );
		var f32 elevation= ust::atan2( source_quad_normal.xy().Length(), source_quad_normal.z );

		var Mat4f rotation_matrix= Mat4f::MakeRotationX( elevation ) * Mat4f::MakeRotationZ( azimuth );


		var [ Vec3f, 2 ] basis_vecs
		[
			Vec3f( 1.0f, 0.0f, 0.0f ) * rotation_matrix,
			Vec3f( 0.0f, 1.0f, 0.0f ) * rotation_matrix,
		];

		var Vec3f corner_vector= ( basis_vecs[0] + basis_vecs[1] ) * decal_half_size;
		var [ Vec3f, 2 ] decal_corners[ decal.position - corner_vector, decal.position + corner_vector ];

		var [ Planef, 4 ] clip_planes
		[
			// Decal side clip planes.
			Planef::CreateFromNormalAndPoint(  basis_vecs[0], decal_corners[0] ),
			Planef::CreateFromNormalAndPoint(  basis_vecs[1], decal_corners[0] ),
			Planef::CreateFromNormalAndPoint( -basis_vecs[0], decal_corners[1] ),
			Planef::CreateFromNormalAndPoint( -basis_vecs[1], decal_corners[1] ),
		];

		var f32 texture_layer= 153.0f; // TODO - select texture layer based on decal type.

		var [ Planef, 2 ] tc_planes
		[
			Planef::CreateFromNormalAndPoint( basis_vecs[0] / ( decal_half_size * 4.0f ), decal_corners[0] ),
			Planef::CreateFromNormalAndPoint( basis_vecs[1] / ( decal_half_size * 4.0f ), decal_corners[0] ),
		];

		// Visit all quads nearby and create decal polygons for them.
		VisitBoundingBoxesHierarchyForBBox(
			quads_hierarchy,
			BBox3f
			{
				.min= decal.position - Vec3f( decal_radius, decal_radius, decal_radius ),
				.max= decal.position + Vec3f( decal_radius, decal_radius, decal_radius ),
			},
			lambda[&]( PackedQuadIndex packed_quad_index )
			{
				var size_type quad_index= packed_quad_index.GetQuadIndex();

				var ZvoxCluster& cluster= clusters[ packed_quad_index.GetClusterIndex() ];
				var ZmapQuad& quad= quads[ quad_index ];

				var Vec3f quad_normal= CalculateQuadNormal( quad );
				var f32 quad_normal_length= quad_normal.Length();

				// Ensure this quad is facing roughly the same direction as the source quad.
				if( source_quad_normal.Dot( quad_normal ) <
					c_min_decal_surface_angle_cos * source_quad_normal_length * quad_normal_length )
				{
					return;
				}

				var Vec3f v0(
					f32( i32( quad.vertices[0][0] ) + i32( cluster.c.center[0] ) ),
					f32( i32( quad.vertices[0][1] ) + i32( cluster.c.center[1] ) ),
					f32( i32( quad.vertices[0][2] ) + i32( cluster.c.center[2] ) ) );

				// Avoid creating decal polygons for quads located too far from the decal.
				if( ust::abs( quad_normal.Dot( v0 - decal.position ) ) >
					c_max_distance_to_quad_plane * quad_normal_length )
				{
					return;
				}

				if( quad_index >= zmap_lam_data.tessellated_quads.size() )
				{
					return;
				}

				var ZmapLamTesselaltedQuad& tessellated_quad= zmap_lam_data.tessellated_quads[ quad_index ];
				if( tessellated_quad.vertex_count == 0u )
				{
					return;
				}

				var size_type tessellated_vertex_count( tessellated_quad.vertex_count );
				var size_type tessellatted_quad_data_offset( tessellated_quad.data_offset );

				var ust::array_view_imut</byte32/> vertex_data=
					zmap_lam_data.tessellated_quads_data.range().subrange(
						tessellatted_quad_data_offset,
						tessellatted_quad_data_offset + tessellated_vertex_count * 6s );

				var size_type polygons_data_offset= tessellatted_quad_data_offset + tessellated_vertex_count * 6s;

				var size_type polygon_count( u32( zmap_lam_data.tessellated_quads_data[ polygons_data_offset ] ) );

				var ust::array_view_imut</byte32/> polygons_data=
					zmap_lam_data.tessellated_quads_data.range().subrange(
						polygons_data_offset + 2s,
						polygons_data_offset + 2s + polygon_count * 8s );

				for( auto mut polygon_index= 0s; polygon_index < polygon_count; ++polygon_index ) label quad_polygons
				{
					var ust::array_view_imut</byte32/> polygon_data=
						polygons_data.subrange( polygon_index * 8s, polygon_index * 8s + 8s );

					var size_type polygon_vertex_count( u32( polygon_data[0s] ) );

					// Take geometry of a quad's subpolygon as a base for the decal polygon.
					for( auto mut polygon_vertex_index= 0s; polygon_vertex_index < polygon_vertex_count; ++polygon_vertex_index )
					{
						var size_type quad_vertex_index( u32( polygon_data[ 2s + polygon_vertex_index ] ) );

						decal_vertices[polygon_vertex_index]=
							Vec3f(
								f32( cluster.c.center[0] ) + f32( vertex_data[ quad_vertex_index * 6s + 0s ] ),
								f32( cluster.c.center[1] ) + f32( vertex_data[ quad_vertex_index * 6s + 1s ] ),
								f32( cluster.c.center[2] ) + f32( vertex_data[ quad_vertex_index * 6s + 2s ] ) );
					}

					var size_type mut num_decal_vertices= polygon_vertex_count;

					// Clip the decal's polygon using decal planes. Perform clipping in pairs.
					for( auto mut plane_index= 0s; plane_index < 4s; plane_index+= 2s )
					{
						num_decal_vertices=
							ClipPolygon(
								clip_planes[ plane_index + 0s ],
								ust::array_view_imut</ DecalPolygonVertex />( decal_vertices ).subrange_end( num_decal_vertices ),
								decal_vertices_clipped );

						if( num_decal_vertices < 3s )
						{
							continue label quad_polygons;
						}

						num_decal_vertices=
							ClipPolygon(
								clip_planes[ plane_index + 1s ],
								ust::array_view_imut</ DecalPolygonVertex />( decal_vertices_clipped ).subrange_end( num_decal_vertices ),
								decal_vertices );

						if( num_decal_vertices < 3s )
						{
							continue label quad_polygons;
						}
					}

					var size_type base_vertex= out_vertices.size();

					for( auto mut vertex_index= 0s; vertex_index < num_decal_vertices; ++vertex_index )
					{
						var DecalPolygonVertex& decal_vertex= decal_vertices[ vertex_index ];

						out_vertices.push_back(
							MapVertex
							{
								.position[ decal_vertex.x, decal_vertex.y, decal_vertex.z ],
								.tex_coordinates
								[
									tc_planes[0].GetDistanceForPoint( decal_vertex ),
									tc_planes[1].GetDistanceForPoint( decal_vertex ),
									texture_layer
								],
								.light[ 255u8 ... ], // TODO - set proper light.
								.fog_params= zero_init,
							} );
					}

					for( auto mut triangle_index= 2s; triangle_index < num_decal_vertices; ++triangle_index )
					{
						out_indices.push_back( u16( base_vertex ) );
						out_indices.push_back( u16( base_vertex + triangle_index - 1s ) );
						out_indices.push_back( u16( base_vertex + triangle_index - 0s ) );
					}
				}
			} );
	}
}

type DecalPolygonVertex= Vec3f;

var size_type c_max_decal_polygon_vertices= 12s;

fn ClipPolygon(
	Planef& plane,
	ust::array_view_imut</DecalPolygonVertex/> in_vertices,
	[ DecalPolygonVertex, c_max_decal_polygon_vertices ] &mut out_vertices ) : size_type
{
	var DecalPolygonVertex mut prev_v= in_vertices.back();
	var f32 mut prev_dist= plane.GetDistanceForPoint( prev_v );
	var size_type mut out_vertex_count= 0s;

	foreach( &v : in_vertices )
	{
		var f32 dist= plane.GetDistanceForPoint( v );

		if( dist > 0.0f )
		{
			if( prev_dist < 0.0f )
			{
				out_vertices[ out_vertex_count ]= GetLinePlaneIntersection( prev_v, v, plane );
				++out_vertex_count;
				if( out_vertex_count == c_max_decal_polygon_vertices )
				{
					break;
				}
			}
			out_vertices[ out_vertex_count ]= v;
			++out_vertex_count;
			if( out_vertex_count == c_max_decal_polygon_vertices )
			{
				break;
			}
		}
		else if( dist == 0.0f )
		{
			out_vertices[ out_vertex_count ]= v;
			++out_vertex_count;
			if( out_vertex_count == c_max_decal_polygon_vertices )
			{
				break;
			}
		}
		else if( prev_dist > 0.0f )
		{
			out_vertices[ out_vertex_count ]= GetLinePlaneIntersection( prev_v, v, plane );
			++out_vertex_count;
			if( out_vertex_count == c_max_decal_polygon_vertices )
			{
				break;
			}
		}

		prev_v= v;
		prev_dist= dist;
	}

	return out_vertex_count;
}

fn GetLinePlaneIntersection( Vec3f& v0, Vec3f& v1, Planef& plane ) : Vec3f
{
	var f32 dist0= plane.GetDistanceForPoint( v0 );
	var f32 dist1= plane.GetDistanceForPoint( v1 );
	var f32 dist_sum= dist1 - dist0;
	var f32 k0= dist0 / dist_sum;
	var f32 k1= dist1 / dist_sum;
	return v0 * k1 - v1 * k0;
}

} // namespace PM
