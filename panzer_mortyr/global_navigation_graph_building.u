import "global_navigation_graph_building.iu"
import "physics_utils.iu"

namespace PM
{

fn BuildGlobalNavigationGraph( GameMapData& map_data ) : GlobalNavigationGraph
{
	var GlobalNavigationGraph mut result;

	var ust::array_view_imut</ZmapQuad/> quads= map_data.zmap_data.deref().quads;

	var i32 nodes_spacing= 64; // TODO - tune it

	foreach( &cluster :map_data.zvox_data.deref().clusters )
	{
		for( var size_type mut q( cluster.c.first_quad_index ), q_end= size_type( cluster.c.first_quad_index ) + size_type( cluster.num_quads );
			q < q_end;
			++q )
		{
			var ZmapQuad& quad= quads[q];

			var Vec3f quad_normal= CalculateQuadNormal( quad );

			if( !IsGroundSurface( quad_normal ) )
			{
				continue;
			}

			auto& center= cluster.c.center;
			auto& in_vertices= quad.vertices;

			var [ Vec3f, 4 ] vertices
			[
				( f32( center[0] + i32( in_vertices[0][0] ) ), f32( center[1] + i32( in_vertices[0][1] ) ), f32( center[2] + i32( in_vertices[0][2] ) ) ),
				( f32( center[0] + i32( in_vertices[1][0] ) ), f32( center[1] + i32( in_vertices[1][1] ) ), f32( center[2] + i32( in_vertices[1][2] ) ) ),
				( f32( center[0] + i32( in_vertices[2][0] ) ), f32( center[1] + i32( in_vertices[2][1] ) ), f32( center[2] + i32( in_vertices[2][2] ) ) ),
				( f32( center[0] + i32( in_vertices[3][0] ) ), f32( center[1] + i32( in_vertices[3][1] ) ), f32( center[2] + i32( in_vertices[3][2] ) ) ),
			];

			var [ f32, 2 ] mins
			[
				ust::min( ust::min( vertices[0].x, vertices[1].x ), ust::min( vertices[2].x, vertices[3].x ) ),
				ust::min( ust::min( vertices[0].y, vertices[1].y ), ust::min( vertices[2].y, vertices[3].y ) ),
			];

			var [ f32, 2 ] maxs
			[
				ust::max( ust::max( vertices[0].x, vertices[1].x ), ust::max( vertices[2].x, vertices[3].x ) ),
				ust::max( ust::max( vertices[0].y, vertices[1].y ), ust::max( vertices[2].y, vertices[3].y ) ),
			];

			var [ i32, 2 ] mins_int
			[
				nodes_spacing * i32( ust::floor( mins[0] / f32( nodes_spacing ) ) ),
				nodes_spacing * i32( ust::floor( mins[1] / f32( nodes_spacing ) ) ),
			];

			var [ i32, 2 ] maxs_int
			[
				nodes_spacing * i32( ust::floor( maxs[0] / f32( nodes_spacing ) ) ),
				nodes_spacing * i32( ust::floor( maxs[1] / f32( nodes_spacing ) ) ),
			];

			for( var i32 mut y= mins_int[1]; y <= maxs_int[1]; y+= nodes_spacing )
			{
				for( var i32 mut x= mins_int[0]; x <= maxs_int[0]; x+= nodes_spacing )
				{
					var Vec3f node_position( f32(x), f32(y), vertices[0].z );
					result.nodes.push_back( GlobalNavigationGraph::Node{ .position= node_position } );
				}
			}
		}
	}

	return result;
}

} // namespace PM
