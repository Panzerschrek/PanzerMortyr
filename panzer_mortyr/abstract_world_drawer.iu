import "world_drawing_info.iu"

namespace PM
{

class AbstractWorldDrawer abstract non_sync
{
	fn virtual pure Draw( mut this, WorldDrawingInfo& drawing_info ) : WorldDrawingStats;
}

struct WorldDrawingStats
{
	u32 num_room_visible_clusters;
	u32 num_total_visible_clusters;
	u32 num_visible_map_triangles;
	u32 num_visible_models;
	u32 num_visivle_model_triangles;
	u32 num_visible_billboards;
	u32 num_visible_breakable_triangles;
	u32 num_visible_semitransparent_triangles;
	u32 num_visible_dynamic_lights;
	u32 num_visible_local_fog_volumes;
	u32 num_visible_snow_rain_particles;
	u32 num_visible_mirror_triangles;
	u32 num_decals;
}

} // namespace PM
