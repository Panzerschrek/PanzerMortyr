import "/enum_string_conversions.iu"
import "/string_conversions.iu"
import "caching_game_resources_loader.iu"

namespace PM
{

fn CachingGameResourcesLoader::constructor( GameFilesystemPtr mut game_filesystem_ptr, ConsoleOutPtr mut console_out )
	( game_filesystem_= move(game_filesystem_ptr), console_out_= move(console_out) )
{
}

fn CachingGameResourcesLoader::LoadGameParams( mut this ) : GameResourcePtr</GameParams/>
{
	if( !game_params_.empty() )
	{
		return game_params_.try_to_non_nullable();
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto res= game_filesystem.LoadFileToString( c_game_params_file_name );
	if_var( e : res.as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Failed to read game params file! Error: ", ust::enum_to_string(e) ) );

		// Create a dummy.
		var GameResourcePtr</GameParams/> game_params( GameParams() );
		game_params_= game_params;
		return game_params;
	}
	else
	{
		var GameResourcePtr</GameParams/> game_params( ParseGameParamsFile( res.try_deref() ) );
		game_params_= game_params;
		return game_params;
	}
}

fn CachingGameResourcesLoader::LoadMapsDescription( mut this ) : GameResourcePtr</MapsDescription/>
{
	if( !maps_description_.empty() )
	{
		return maps_description_.try_to_non_nullable();
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto res= game_filesystem.LoadFileToString( c_maps_description_file_name );

	if_var( e : res.as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Failed to read maps description file! Error: ", ust::enum_to_string(e) ) );

		// Create a dummy.
		var GameResourcePtr</MapsDescription/> maps_description( MapsDescription() );
		maps_description_= maps_description;
		return maps_description;
	}

	auto mut maps_description_opt= ParseMapsDescriptionFile( res.try_deref() );
	if( maps_description_opt.empty() )
	{
		ConsoleOutAddTextLine( console_out_, "Failed to parse maps description!" );

		// Create a dummy.
		var GameResourcePtr</MapsDescription/> maps_description( MapsDescription() );
		maps_description_= maps_description;
		return maps_description;
	}
	else
	{
		var GameResourcePtr</MapsDescription/> maps_description( maps_description_opt.try_take() );
		maps_description_= maps_description;
		return maps_description;
	}
}

