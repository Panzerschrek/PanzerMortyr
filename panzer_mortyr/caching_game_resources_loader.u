fn CachingGameResourcesLoader::LoadEntitiesDescription( mut this, ResourceString& file_name ) : GameResourcePtr</EntitiesDescription/>
{
	if_var( &v : entity_descriptions_.find( file_name ) )
	{
		return v;
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto res= game_filesystem.LoadFileToString( file_name );
	if_var( e : res.as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Failed to read entities description file! Error: ", ust::enum_to_string(e) ) );

		// Create a dummy, but don't cache it.
		return ust::make_shared_ptr_mt_final( EntitiesDescription() );
	}
	else
	{
		var GameResourcePtr</EntitiesDescription/> entities_description( ParseEntitiesDescriptionFile( res.try_deref() ) );
		entity_descriptions_.insert_new( file_name, entities_description );
		return entities_description;
	}
}

fn CachingGameResourcesLoader::LoadZmapFile( mut this, u32 map_index ) : GameResourceNullablePtr</ZmapData/>
{
	if_var( &d : zmap_data_ )
	{
		if( d[0] == map_index )
		{
			return d[1];
		}
	}

	var GameResourcePtr</MapsDescription/> maps_description_ptr= LoadMapsDescription();
	var MapsDescription& maps_description= maps_description_ptr.deref();

	if( size_type(map_index) >= maps_description.maps.size() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Map with index ", ust::to_string8( map_index ), " not found!" ) );
		return GameResourceNullablePtr</ZmapData/>();
	}

	var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type(map_index) ];

	// Reset previous cached value to free memory before allocating memory for new value.
	zmap_data_.reset();

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto mut res= game_filesystem.LoadFile( map_description.wall_files[0], PM::LoadZmapFile );
	if_var( e : res.as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Failed to read ZMAP.ANT map file! Error: ", ust::enum_to_string(e) ) );
		return GameResourceNullablePtr</ZmapData/>();
	}

	var GameResourcePtr</ZmapData/> zmap_data( move(res).try_take() );
	zmap_data_= ust::make_tuple( map_index, zmap_data );
	return zmap_data;
}

