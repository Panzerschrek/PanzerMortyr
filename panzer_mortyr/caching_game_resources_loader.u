fn CachingGameResourcesLoader::LoadZmapLamFile( mut this, u32 map_index ) : GameResourceNullablePtr</ZmapLamData/>
{
	if_var( &d : zmap_lam_data_ )
	{
		if( d[0] == map_index )
		{
			return d[1];
		}
	}

	// Reset previous cached value to free memory before allocating memory for new value.
	zmap_lam_data_.reset();

	// Require "zvox" file to load number of clusters.
	// it's fine to read it here, since these files are used together.
	var GameResourceNullablePtr</ZvoxData/> zvox_data_ptr= LoadZvoxFile( map_index );

	if( zvox_data_ptr.empty() )
	{
		return GameResourceNullablePtr</ZmapLamData/>();
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto mut res=
		game_filesystem.LoadFile(
			GetZmapLamFileName( map_index ),
			lambda[num_clusters= zvox_data_ptr.try_deref().clusters.size()] ( ust::file_readable &mut f ) : ust::io_result</ZmapLamData/>
			{
				return PM::LoadZmapLamFile( f, num_clusters );
			} );

	if_var( e : res.as_error_ref() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Failed to read ZMAP.LAM map file! Error: ", ust::enum_to_string(e) ) );
		return GameResourceNullablePtr</ZmapLamData/>();
	}

	var GameResourcePtr</ZmapLamData/> zmap_lam_data( move(res).try_take() );
	zmap_lam_data_= ust::make_tuple( map_index, zmap_lam_data );
	return zmap_lam_data;
}

