fn CachingGameResourcesLoader::LoadRoomClustersHierarchy( mut this, u32 map_index ) : GameResourceNullablePtr</RoomClustersHierarchy/>
{
	if_var( &d : room_clusters_hierarchy_ )
	{
		if( d[0] == map_index )
		{
			return d[1];
		}
	}

	// Reset previous cached value to free memory before allocating memory for new value.
	room_clusters_hierarchy_.reset();

	var GameResourceNullablePtr</ZvoxData/> zvox_data_nullable_ptr= LoadZvoxFile( map_index );
	if( zvox_data_nullable_ptr.empty() )
	{
		return GameResourceNullablePtr</RoomClustersHierarchy/>();
	}

	var GameResourcePtr</RoomClustersHierarchy/> room_clusters_hierarchy(
		BuildRoomClustersHierarchy( zvox_data_nullable_ptr.try_deref().clusters ) );

	room_clusters_hierarchy_= ust::make_tuple( map_index, room_clusters_hierarchy );
	return room_clusters_hierarchy;
}

