import "/math.iu"
import "/minmax.iu"
import "camera_controller.iu"
import "math_constants.iu"

namespace PM
{

fn CameraController::constructor( SettingsImutPtr mut settings, State& state )
	( settings_= move(settings), state_= state, )
{
}

fn CameraController::Update( mut this, f32 time_delta_s, InputState& input_state )
{
	auto lock= settings_.lock_imut();
	var Settings& settings= lock.deref();

	// Scale angular movement proportional to fov.
	var f32 fov= GetFOV();

	// Perform angular movement via keyboard keys with acceleration. It looks a little bit better.

	var f32 angle_acceleration= 15.0f * fov;
	var f32 angle_deceleration= 10.0f * fov;

	var f32 max_angle_speed= 2.5f * fov;

	// Don't allow looking too much down, as the original game does.
	var f32 constexpr max_elevation=  c_tau *  3.0f / 16.0f;
	// Allow looking almost straigth up.
	var f32 constexpr min_elevation= -c_tau * 15.0f / 64.0f;

	// Use exponential scale for mouse sensitivity.
	var f32 mouse_sensitivity_base= 64.0f;
	var f32 mouse_sensitivity_scale= 1.0f / 3072.0f;
	var f32 mouse_sensitivity_x=
		mouse_sensitivity_scale *
		ust::pow( mouse_sensitivity_base, ust::max( 0.0f, ust::min( settings.in_mouse_sensitivity, 1.0f ) ) ) *
		fov;

	var f32 mouse_sensitivity_y= ( settings.in_invert_mouse_y_axis ? -mouse_sensitivity_x : mouse_sensitivity_x );

	var f32 constexpr c_zoom_speed= 4.0f;

	if( input_state.KeyIsPressed( settings.in_key_turn_left ) )
	{
		state_.azimuth_velocity += angle_acceleration * time_delta_s;
	}
	if( input_state.KeyIsPressed( settings.in_key_turn_right ) )
	{
		state_.azimuth_velocity -= angle_acceleration * time_delta_s;
	}
	if( input_state.KeyIsPressed( settings.in_key_turn_up ) )
	{
		state_.elevation_velocity -= angle_acceleration * time_delta_s;
	}
	if( input_state.KeyIsPressed( settings.in_key_turn_down ) )
	{
		state_.elevation_velocity += angle_acceleration * time_delta_s;
	}

	{
		var f32 speed= ust::abs( state_.azimuth_velocity );
		if( speed > 0.0f )
		{
			var f32 speed_decelerated= speed - angle_deceleration * time_delta_s;
			var f32 speed_decelerated_clamped= ust::max( 0.0f, ust::min( speed_decelerated, max_angle_speed ) );
			state_.azimuth_velocity*= speed_decelerated_clamped / speed;
		}
	}
	{
		var f32 speed= ust::abs( state_.elevation_velocity );
		if( speed > 0.0f )
		{
			var f32 speed_decelerated= speed - angle_deceleration * time_delta_s;
			var f32 speed_decelerated_clamped= ust::max( 0.0f, ust::min( speed_decelerated, max_angle_speed ) );
			state_.elevation_velocity*= speed_decelerated_clamped / speed;
		}
	}

	state_.azimuth+= state_.azimuth_velocity * time_delta_s;
	state_.elevation+= state_.elevation_velocity * time_delta_s;

	var [ i32, 2 ] mouse_motion= input_state.GetMouseMotion();
	state_.azimuth-= f32( mouse_motion[0] ) * mouse_sensitivity_x;
	state_.elevation+= f32( mouse_motion[1] ) * mouse_sensitivity_y;

	while( state_.azimuth >  c_half_tau )
	{
		state_.azimuth-= c_tau;
	}
	while( state_.azimuth < -c_half_tau )
	{
		state_.azimuth+= c_tau;
	}

	ust::min_assign( state_.elevation, max_elevation );
	ust::max_assign( state_.elevation, min_elevation );

	if( input_state.KeyIsPressed( settings.in_key_zoom ) )
	{
		state_.zoom_fraction+= time_delta_s * c_zoom_speed;
		ust::min_assign( state_.zoom_fraction, 1.0f );
	}
	else
	{
		state_.zoom_fraction-= time_delta_s * c_zoom_speed;
		ust::max_assign( state_.zoom_fraction, 0.0f );
	}
}

fn CameraController::GetAzimuth( this ) : f32
{
	return state_.azimuth;
}

fn CameraController::GetElevation( this ) : f32
{
	return state_.elevation;
}

fn CameraController::GetFOV( this ) : f32
{
	// This value was carefully tuned to match the original game.
	// TODO - perform last bits of fine-tuning.
	var f32 constexpr base_fov_x= 102.4311f * ( c_tau / 360.0f );

	return base_fov_x * ( 1.0f - 0.7f * state_.zoom_fraction );
}

fn CameraController::GetState( this ) : State&
{
	return state_;
}

fn CameraController::SetState( mut this, State& state )
{
	state_= state;
}

} // namespace PM
