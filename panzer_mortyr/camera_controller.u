import "/math.iu"
import "/minmax.iu"
import "camera_controller.iu"
import "math_constants.iu"

namespace PM
{

fn CameraController::constructor( SettingsImutPtr mut settings, f32 azimuth )
	(
		settings_= move(settings),
		azimuth_= azimuth,
		elevation_= 0.0f,
		azimuth_velocity_( 0.0f ),
		elevation_velocity_( 0.0f ),
		zoom_fraction_= 0.0f
	)
{
}

fn CameraController::Update(
	mut this, f32 time_delta_s, KeyboardState& keyboard_state, u32 mouse_state, [ i32, 2 ] mouse_motion )
{
	auto lock= settings_.lock_imut();
	var Settings& settings= lock.deref();

	// TODO - allow configuring it.
	var u32 c_zoom_button= 3u;

	// Scale angular movement proportional to fov.
	var f32 fov= GetFOV();

	// Perform angular movement via keyboard keys with acceleration. It looks a little bit better.

	var f32 angle_acceleration= 15.0f * fov;
	var f32 angle_deceleration= 10.0f * fov;

	var f32 max_angle_speed= 2.5f * fov;

	// Don't allow looking too much down, as the original game does.
	var f32 constexpr max_elevation=  c_tau *  3.0f / 16.0f;
	// Allow looking almost straigth up.
	var f32 constexpr min_elevation= -c_tau * 15.0f / 64.0f;

	// TODO - read it from settings.
	// TODO - allow Y axis inversion.
	var f32 mouse_sensitivity_x= 0.002f * fov;
	var f32 mouse_sensitivity_y= 0.002f * fov;

	var f32 constexpr c_zoom_speed= 4.0f;

	if( keyboard_state[ settings.in_key_turn_left.scancode ] )
	{
		azimuth_velocity_ += angle_acceleration * time_delta_s;
	}
	if( keyboard_state[ settings.in_key_turn_right.scancode ] )
	{
		azimuth_velocity_ -= angle_acceleration * time_delta_s;
	}
	if( keyboard_state[ settings.in_key_turn_up.scancode ] )
	{
		elevation_velocity_ -= angle_acceleration * time_delta_s;
	}
	if( keyboard_state[ settings.in_key_turn_down.scancode ] )
	{
		elevation_velocity_ += angle_acceleration * time_delta_s;
	}

	{
		var f32 speed= ust::abs( azimuth_velocity_ );
		if( speed > 0.0f )
		{
			var f32 speed_decelerated= speed - angle_deceleration * time_delta_s;
			var f32 speed_decelerated_clamped= ust::max( 0.0f, ust::min( speed_decelerated, max_angle_speed ) );
			azimuth_velocity_*= speed_decelerated_clamped / speed;
		}
	}
	{
		var f32 speed= ust::abs( elevation_velocity_ );
		if( speed > 0.0f )
		{
			var f32 speed_decelerated= speed - angle_deceleration * time_delta_s;
			var f32 speed_decelerated_clamped= ust::max( 0.0f, ust::min( speed_decelerated, max_angle_speed ) );
			elevation_velocity_*= speed_decelerated_clamped / speed;
		}
	}

	azimuth_+= azimuth_velocity_ * time_delta_s;
	elevation_+= elevation_velocity_ * time_delta_s;

	azimuth_-= f32( mouse_motion[0] ) * mouse_sensitivity_x;
	elevation_+= f32( mouse_motion[1] ) * mouse_sensitivity_y;

	while( azimuth_ >  c_half_tau )
	{
		azimuth_-= c_tau;
	}
	while( azimuth_ < -c_half_tau )
	{
		azimuth_+= c_tau;
	}

	ust::min_assign( elevation_, max_elevation );
	ust::max_assign( elevation_, min_elevation );

	if( ( mouse_state & ( 1u << ( c_zoom_button - 1u ) ) ) != 0u )
	{
		zoom_fraction_+= time_delta_s * c_zoom_speed;
		ust::min_assign( zoom_fraction_, 1.0f );
	}
	else
	{
		zoom_fraction_-= time_delta_s * c_zoom_speed;
		ust::max_assign( zoom_fraction_, 0.0f );
	}
}

fn CameraController::GetAzimuth( this ) : f32
{
	return azimuth_;
}

fn CameraController::GetElevation( this ) : f32
{
	return elevation_;
}

fn CameraController::GetFOV( this ) : f32
{
	// This value was carefully tuned to match the original game.
	// TODO - perform last bits of fine-tuning.
	var f32 constexpr base_fov_x= 102.4311f * ( c_tau / 360.0f );

	return base_fov_x * ( 1.0f - 0.7f * zoom_fraction_ );
}

} // namespace PM
