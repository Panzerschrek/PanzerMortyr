import "game_structs.uh"

namespace PM
{

class PlayerToolController
{
public:
	fn Update( mut this, ust::array_view_imut</bool/> keyboard_state, u32 mouse_state );

	fn GetInventoryInput( this ) : PlayerInventoryInput;

	fn GetShotRequested( this ) : bool;

	fn Reset( mut this );

private:
	PlayerInventoryInput inventory_input_;

	bool tool_activation_pressed_= false;
	bool previous_tool_selection_pressed_= false;
	bool next_tool_selection_pressed_= false;

	bool shot_requested_= false;
}

} // namespace PM
