import "/optional.iu"

namespace PM
{

template</type T, u32 N/>
class GameThingsContainer
{
	static_assert( N <= 1024u, "Too big size for such container! Use something more performant!" );
	static_assert( N % 32u == 0u, "The number of elements should be divisible by 32!" );

public:
	// Returns true if managed to insert and false if has no space left.
	fn Insert( mut this, T mut val ) : bool
	{
		for( auto mut word= 0u; word < c_num_words; ++word )
		{
			var u32 &mut word_bits= occopied_slot_bits_[word];
			if( word_bits == 0xFFFFFFFFu )
			{
				continue; // The whole block is occupied.
			}

			for( auto mut bit= 0u; bit < 32u; ++bit )
			{
				var u32 mask= 1u << bit;

				if( ( word_bits & mask ) == 0u )
				{
					// Found an empty slot.
					// Mark it as non-empty.
					word_bits |= mask;

					var Entry &mut entry= entries_[ word * 32u + bit ];
					entry.value_opt.reset( move(val) );
					++entry.generational_index;

					return true;
				}
			}
		}

		return false;
	}

	// Iterate over all elements without changing them.
	template</type Func/>
	fn Iterate( this, Func& func )
	{
		for( auto mut word= 0u; word < c_num_words; ++word )
		{
			var u32 word_bits= occopied_slot_bits_[word];
			if( word_bits == 0u )
			{
				continue; // The whole block is empty.
			}

			for( auto mut bit= 0u; bit < 32u; ++bit )
			{
				var u32 mask= 1u << bit;

				if( ( word_bits & mask ) != 0u )
				{
					// Found non-empty slot.

					var Entry& entry= entries_[ word * 32u + bit ];
					if( !entry.value_opt.empty() )
					{
						func( entry.value_opt.try_deref() );
					}
				}
			}
		}
	}

	// Iterate over all elements without changing them. Given function should accept index as second argument.
	template</type Func/>
	fn IterateWithIndex( this, Func& func )
	{
		for( auto mut word= 0u; word < c_num_words; ++word )
		{
			var u32 word_bits= occopied_slot_bits_[word];
			if( word_bits == 0u )
			{
				continue; // The whole block is empty.
			}

			for( auto mut bit= 0u; bit < 32u; ++bit )
			{
				var u32 mask= 1u << bit;

				if( ( word_bits & mask ) != 0u )
				{
					// Found non-empty slot.

					var u32 index= word * 32u + bit;
					var Entry& entry= entries_[ index ];
					if( !entry.value_opt.empty() )
					{
						func( entry.value_opt.try_deref(), index );
					}
				}
			}
		}
	}

	fn GetByIndex( this, u32 index )
		: ust::optional_ref_imut</T/> @ ( ust::reference_notation::return_inner_references::param0 )
	{
		if( index >= N )
		{
			return ust::null_optional_ref;
		}
		var Entry& entry= entries_[index];
		return entry.value_opt.as_ref();
	}

	// Run given function for all present elements.
	// Given function should have single arguments - mutable reference to value.
	// Elements for which given function returned "false" are removed.
	template</type Func/>
	fn Retain( mut this, Func& func )
	{
		for( auto mut word= 0u; word < c_num_words; ++word )
		{
			var u32 &mut word_bits= occopied_slot_bits_[word];
			if( word_bits == 0u )
			{
				continue; // The whole block is empty.
			}

			for( auto mut bit= 0u; bit < 32u; ++bit )
			{
				var u32 mask= 1u << bit;

				if( ( word_bits & mask ) != 0u )
				{
					// Found non-empty slot.

					var Entry &mut entry= entries_[ word * 32u + bit ];
					if( !entry.value_opt.empty() )
					{
						if( !func( entry.value_opt.try_deref() ) )
						{
							entry.value_opt.reset();
							word_bits &= ~mask; // Mark the slot as empty.
						}
					}
				}
			}
		}
	}

private:
	struct Entry
	{
		ust::optional</T/> value_opt;
		u32 generational_index= 0u; // Increment it each time new entry is constructed.
	}

	var u32 constexpr c_num_words= N / 32u;

private:
	// Store occopied flag for slots in a bit array.
	// Using it allows speeding-up insertion and iteration by skipping whole chunks of 32 occupied or empty elements.
	[ u32, c_num_words ] occopied_slot_bits_= zero_init;

	[ Entry, N ] entries_;
}

type TestIntsContainer= GameThingsContainer</i32, 128u/>;

fn TestIterate( TestIntsContainer& c )
{
	var i32 mut sum= 0;
	c.Iterate(
		lambda[&]( i32& x )
		{
			sum+= x;
		} );
}

fn TestIterateWithIndex( TestIntsContainer& c )
{
	var i32 mut sum= 0;
	var u32 mut index_sum= 0u;
	c.IterateWithIndex(
		lambda[&]( i32& x, u32 index )
		{
			sum+= x;
			index_sum+= index;
		} );
}

fn TestRetain( TestIntsContainer &mut c )
{
	c.Retain(
		lambda[]( i32 &mut x ) : bool
		{
			return x % 7 != 0;
		} );

}

} // namespace PM
