import "/optional.iu"

namespace PM
{

template</type T, u32 N/>
class GameThingsContainer
{
	static_assert( N <= 1024u, "Too big size for such container! Use something more performant!" );
	static_assert( N % 32u == 0u, "The number of elements should be divisible by 32!" );

public:
	// Returns true if managed to insert and false if has no space left.
	fn nodiscard Insert( mut this, T mut val ) : bool
	{
		// TODO - speed-up this search of an empty slot.
		for( auto mut i= 0u; i < N; ++i )
		{
			var Entry &mut entry= entries_[i];
			if( entry.value_opt.empty() )
			{
				entry.value_opt.reset( move(val) );
				return true;
			}
		}

		return false;
	}

private:
	struct Entry
	{
		ust::optional</T/> value_opt;
		u32 generational_index= 0u; // Increment it each time new entry is constructed.
	}

private:
	[ Entry, N ] entries_;
}

type TestIntsContainer= GameThingsContainer</i32, 128u/>;

} // namespace PM
