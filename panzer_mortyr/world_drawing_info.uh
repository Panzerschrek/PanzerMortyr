import "vec.uh"

namespace PM
{

// This structure describes how world should be drawn.
// This is the main interface structure prepared by game logic code for map drawer.
struct WorldDrawingInfo
{
	Vec3f camera_position;
	f32 camera_azimuth;
	f32 camera_elevation;

	// TODO - place here dynamic objects and state of some map quads (breakable and movable ones).
}

// This struct represents parameters for viewport using for world drawing.
struct WorldDrawingViewportInfo
{
	f32 view_aspect;
}

} // namespace PM
