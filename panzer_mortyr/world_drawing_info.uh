import "/vector.u"
import "/common_lib/resource_string.uh"
import "vec.uh"

namespace PM
{

// This structure describes how world should be drawn.
// This is the main interface structure prepared by game logic code for map drawer.
struct WorldDrawingInfo
{
	// Absolute time from map start.
	// Used for time-dependent animations rendering.
	f32 game_time_s;

	u32 map_index;

	CameraParams camera_params;

	ust::vector</ModelObject/> model_objects;

	ust::vector</DynamicClusterObject/> dynamic_cluster_objects;

	ust::vector</Billboard/> billboards;

	// Test point objects rendered as sprites.
	ust::vector</Vec3f/> test_sprites;

	ust::vector</TestTriangle/> test_triangles;
	ust::vector</TestLine/> test_lines;

	// TODO - place here dynamic objects and state of some map quads (breakable and movable ones).

	struct CameraParams
	{
		Vec3f position;
		f32 azimuth;
		f32 elevation;
		f32 fov_x;
	}

	// An object drawn as model.
	struct ModelObject
	{
		ResourceString model_file_name;
		Vec3f position;
		f32 azimuth;
		f32 elevation;
		u32 frame; // TODO - provide more than one frame for smooth animation.
		bool disable_culling; // True for models which should be drawn even if they are outside visible bounds.
		bool first_person_weapon;
		bool constant_lighting; // True for things which should remain bright (non-lit).
	}

	struct DynamicClusterObject
	{
		u32 cluster_index;
		Vec3f translation;
	}

	struct Billboard
	{
		enum Alignment
		{
			ZAxis,
			ToCamera,
			ToCameraWithConstantScreenSize,
			ToCustomAxis,
		}

		Alignment alignment;
		u8 billboard_index; // Index in the billboard description table.
		Vec3f position;
		Vec3f custom_axis; // Used only for some alignments. May be non-normalized.
		f32 scale; // For most cases should be 1.
		f32 brightness; // For most cases should be 1. Values above 1 are clamped.
	}

	struct TestTriangle
	{
		[ Vec3f, 3 ] vertices;
		[ u8, 3 ] color;
	}

	struct TestLine
	{
		[ Vec3f, 2 ] vertices;
		[ u8, 3 ] color;
	}
}

// This struct represents parameters for viewport using for world drawing.
struct WorldDrawingViewportInfo
{
	f32 view_aspect;
}

} // namespace PM
