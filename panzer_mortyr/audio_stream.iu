import "lock_free_queue.iu"

namespace PM
{

// Lock-free audio stream having some internal buffer.
class AudioStream
{
public:
	type SampleType= i16; // Use hardcoded 16-bit signed sound samples.

	type SamplePairType= [ SampleType, 2 ]; // Stereo sound.

	// Have enough buffering for a little bit than 3 seconds for 44100 Hz frequency.
	// We need so much buffering for music tracks, since accessing disk to read a new portion of sound data isn't fast.
	var u32 c_queue_size= 1u << 17;

	fn Create( u32 frequency ) : tup[ WriteEnd, ReadEnd ];

	class WriteEnd
	{
	public:
		fn constructor( Queue::WriteEnd queue_write_end, u32 frequency );

		fn GetFrequency( this ) : u32;

		// Returns the number of samples actually written.
		// May write less than asked if the internal buffer is full.
		fn nodiscard WriteSamples( mut this, ust::array_view_imut</SamplePairType/> samples ) : size_type;

		fn GetTotalNumberOfSamplesWritten( this ) : u32;
		fn GetTotalNumberOfSamplesRead( this ) : u32;

		fn OtherEndIsClosed( this ) : bool;

		fn GetNumberOfSamplesInQueue( this ) : u32;

	private:
		Queue::WriteEnd queue_write_end_;
		u32 imut frequency_;
	}

	class ReadEnd
	{
	public:
		fn constructor( Queue::ReadEnd queue_read_end, u32 frequency );

		fn GetFrequency( this ) : u32;

		// Returns the number of samples actually read.
		// May read less than asked if the internal buffer is empty.
		fn nodiscard ReadSamples( mut this, ust::array_view_mut</SamplePairType/> samples ) : size_type;

		fn GetTotalNumberOfSamplesWritten( this ) : u32;
		fn GetTotalNumberOfSamplesRead( this ) : u32;

		fn OtherEndIsClosed( this ) : bool;

	private:
		Queue::ReadEnd queue_read_end_;
		u32 imut frequency_;
	}

private:
	type Queue= LockFreeQueue</ SamplePairType, c_queue_size />;
}

} // namespace PM
