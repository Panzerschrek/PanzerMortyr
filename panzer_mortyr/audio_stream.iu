import "lock_free_queue.iu"

namespace PM
{

// Lock-free audio stream having some intrnal buffer.
class AudioStream
{
public:
	type SampleType= i16;

	fn Create( u32 frequency ) : tup[ WriteEnd, ReadEnd ];

	class WriteEnd
	{
	public:
		fn constructor( Queue::WriteEnd queue_write_end, u32 frequency );

		fn GetFrequency( this ) : u32;

		// Returns the number of samples actually written.
		fn nodiscard WriteSamples( mut this, ust::array_view_imut</SampleType/> samples ) : size_type;

		fn GetTotalNumberOfSamplesWritten( this ) : u32;
		fn GetTotalNumberOfSamplesRead( this ) : u32;

		fn OtherEndIsClosed( this ) : bool;

	private:
		Queue::WriteEnd queue_write_end_;
		u32 imut frequency_;
	}

	class ReadEnd
	{
	public:
		fn constructor( Queue::ReadEnd queue_read_end, u32 frequency );

		fn GetFrequency( this ) : u32;

		// Returns the number of samples actually read.
		fn nodiscard ReadSamples( mut this, ust::array_view_mut</SampleType/> samples ) : size_type;

		fn GetTotalNumberOfSamplesWritten( this ) : u32;
		fn GetTotalNumberOfSamplesRead( this ) : u32;

		fn OtherEndIsClosed( this ) : bool;

	private:
		Queue::ReadEnd queue_read_end_;
		u32 imut frequency_;
	}

private:
	// Assume it's enough buffering. It's more than one second for 44100 Hz frequency.
	var u32 c_queue_size= 65536u;

	type Queue= LockFreeQueue</ SampleType, c_queue_size />;
}

} // namespace PM
