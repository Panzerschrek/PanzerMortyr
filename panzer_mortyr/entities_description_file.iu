import "/vector.iu"
import "/common_lib/resource_string.iu"

namespace PM
{

struct EntitiesDescription
{
	u32 bird_animation_index= ~0u;
	u32 rat_animation_index= ~0u;
	u32 player_animation_index= ~0u;

	ust::vector</ AnimationDescription /> animations;

	ust::vector</ EntityDescription /> entities;

	ust::vector</ Tool /> tools;

	// Tools may be listed unsequentially.
	// For this reason create a mapping from tool type to index in the tools array.
	[ u32, typeinfo</ToolType/>.element_count ] tool_type_to_index_map= zero_init;

	struct AnimationDescription
	{
		ResourceString model_file_name;

		// May be -1 or 0 for special cases.
		// It shouldn't be that relevant, since multiple entities can reuse the same animation (like officers with different keys).
		i32 entity_index;
	}

	// TODO - rename remaining structs and fields to english.

	// TODO - identify default values for all these parameters.

	struct EntityDescription
	{
		var u32 constexpr
			c_mode_player= 1u,
			c_mode_enemy= 2u,
			c_mode_pickup= 4u, // Pick-ups have no collisions with player.
			c_mode_projectile= 8u, // For flames and panzerfaust projectiles.
			c_mode_decoration= 16u;

		// Actually it's what in other games named "health".
		u32 energy= 0u; // energia

		// It's 1 for enemies and some decorations.
		// It's a value greater than 1 (up to 100) for some pick-ups.
		// It's 0 for some decorations and pick-ups.
		u32 aggression= 0u; // agres.

		// Looks like "podatny" - susceptible.
		// It seems to be boolean.
		// It's 1 for enemies and movable decorations (airship, plane, antennas, corvette).
		u32 podatn= 0u; // ???

		// It's 1 for some enemies and decorations.
		// It's mostly 2 for pick-ups.
		// For other entities it's zero.
		u32 osona= 0u;

		// See mode constants.
		u32 mode= 0u; // "tryb"

		ust::string8 name; // nazwa

		//  Seems to be boolean. Used only for the dog and for the gestapo enemies.
		u32 good_sight= 0u; // dobry_wzrok

		// It's rarely present and is 0 or 1. Used only for the dog and for the gestapo enemies.
		u32 automatic_alarm= 0xFFFFFFFFu; // automatyczny_alarm

		// Is present only for the dog enemy.
		// It looks like melee attack distance.
		u32 direct_contact= 0u; // kontakt_bezposredni

		// Used for non-enemy destructible objects.
		// value 0 is in range 30 to 160.
		// value 1 is always 1.
		// value 2 is 40 or 60.
		// value 3 is 0 for non-pushable objects and 4 or 8 for movable ones.
		ust::optional</ [ u32, 4 ] /> param_akt; // param_akt

		// Is in range 0 to 15. Is 0 for stationary enemies (turrets).
		// Investigations have shown, that enemies with current health level roughly below this value have different from normal behavior.
		// They try to run away from the player instead of trying reaching him.
		u32 panic= 0u; // panika

		// Is 0 for stationary enemies (turrets). usually it's 10 or 15, maximum is 40.
		u32 search_for_health_kits= 0u; // szukaj_apteczek

		// Seems to be boolean. Is 0 for stationary enemies (turrets).
		u32 search_for_ammunition= 0u; // szukaj_amunicji.

		u32 ammunition= 0u; // ilosc_amunicji

		// Seems to be in percents.
		u32 damage_randomness= 0u; // losowosc_zranienia

		// Seems to be boolean. Seems to enable repeated attack (shooting direct after previous shot).
		// is 0 only for sniper and turret enemies. For regular enemies and even dogs it's 1.
		u32 another_attack= 0u; // ponowny_atak

		// Looks like optimal distance (in some scaled units) for attacking the player.
		u32 hold_on_distance= 0u; // trzymaj_dystans

		// Seems to be boolean. Seems to be used for enemies dropping keys, bosses, some decorations.
		u32 disable_reduction= 0u; // zabron_redukcji.

		// Seems to be boolean.
		u32 standard_sounds= 1u; // standardowe_odglosy.

		ust::vector</ Operation /> operations;
	}

	struct Operation
	{
		enum AnimationKind
		{
			// The majority of entities use this animation.
			Forward, // animacja_naprzod
			// Used only for the tank body.
			// This animation has specified global rotation.
			Rotation, // animacja_kierunkowa
			// Used only for rolling barrel.
			Barrel, // animacja_beczki
			// Used only for panzerfaust projectile.
			Slide, // animacja_szkielka
			// Used only for multiplayer male/female models.
			Icon, // animacja_ikony
			// Used for decorations visible on sky (like aircrafts).
			Landscape, // krajobraz
			// Used only for character.
			Character, // animacja_bohatera
			// Used only for dog enemy on futuristic maps. It seems to include flies (drawn as sprites) flying around the dead body.
			Insect, // animacja_owad.
		}

		[ OperationAnimationDescription, typeinfo</AnimationKind/>.element_count ] animations;

		// Like timeout, but it seems to be used for non-enemy entities.
		ust::optional</Stopper/> stopper; // stoper

		// Simple rotation animation.
		// Also it includes timer-based state transition.
		ust::optional</ObjectRotation/> object_rotation; // obrot_obiektu

		// Contains many rules for operation transition (but not only).
		ust::optional</OperationControl/> operation_control; // sternik

		// Light effect.
		ust::optional</ Light /> light; // swiatlo

		// Some smoke effect. Is used only for the enemy with grenades.
		ust::optional</ Smoke /> smoke; // dymek

		ust::optional</SupplyDrop/> supply_drop; // emisja_zapasow

		// Used only for player entity.
		ust::optional</CharacterMovement/> charachter_movement; // ruch_bohatera

		// It's a linear movement towards specified direction with specified speed.
		// Used only for the tank (on map 24).
		ust::optional</ ObjectMovement /> object_movement; // ruch_obiektu

		// It describes entity rotation toward some specifc angle.
		// Used only once for the tank (on map 24).
		ust::optional</ TargetRotation /> target_rotation; // obrot_docelowy

		// It describes rotation towards player and state transition based on it.
		// Used only twice for the tank (on map 24).
		ust::optional</ RotationForShot /> rotation_for_shot; // obrot_do_strzalu

		// It describes shooting towards own direction, not towards some target.
		// Used only once for the tank (on map 24).
		ust::optional</ DirectionalShot /> directional_shot; // strzal_kierunkowy

		// Activated when another entity (but not player) touches it.
		// Used only once for the wall infront of the tank (on map 24).
		ust::optional</ CollisionWithEnemy /> collision_with_enemy; // kolizja_z_wrogiem

		// Used only for flag entities (in multiplayer CTF mode).
		ust::optional</ TakeSensor /> take_sensor; // czujnik_podniesienia

		// Used only for flag entities (in multiplayer CTF mode).
		ust::optional</ RelativePosition /> relative_position; // pozycja_wzgledna

		// Used only for flag entities (in multiplayer CTF mode).
		bool prohibit_lifting = false; // zabron_podnoszenia

		// It's used for non-enemy destructive entities.
		// It's conditional state transition depending on alive/dead state.
		ust::optional</IfAlive/> if_alive; // jesli_zyje

		// Is present for pickups.
		ust::optional</BoxContents/> box_contents; // zawartosc_skrzynki

		// Used for pickups, sometimes is commented (//).
		ust::optional</ItemRegeneration/> item_regeneration; // regeneracja_przedmiotu

		// Some visual effect used for some destructible objects.
		ust::optional</GasolineExplosion/> gasoline_explosion; // wybuch_benzyny

		// Used for a couple of entities with MG-42 model.
		ust::optional</ Bulb /> bulb; // zarowka

		// Some light or explosive effect, used for explosive objects.
		ust::optional</DecayingBulb/> decaying_bulb; // zarowka_gasnaca

		// Used for sounds on some entities, presumably without standard sounds.
		ust::optional</ Sound /> sound; // odglos

		// Smoke effects.
		// Used for a couple of dedicated smoke entities and for the tank (on map 24).
		ust::optional</ SmokeEmission /> smoke_emission; // emisja_dymu

		// Used only one for the Panzerfaust projectile entity.
		ust::optional</ StoneMovement /> stone_movement; // ruch_kamienia

		// Used only once for the enemy with grenades.
		ust::optional</ SmokeExplosion /> smoke_explosion; // eksplozja_dymowa

		// Used only for a couple of entities representing flames.
		ust::optional</ Combustion /> combustion; // spalanie

		// Used only for single flame entity.
		ust::optional</ Combustion /> afterburning; // dopalanie

		// Used only by the dog and by the gestapo entities.
		ust::optional</ AlarmArea /> alarm_area; // alarmuj_okolice
	}

	struct OperationAnimationDescription
	{
		u32 animation_number= 0u;

		// These values are in frames or half-frames.
		u32 start_step= 0u;
		u32 num_steps= 0u; // liczba_obr. Zero for no animation.

		i32 bounding_box_center_x= 0; // add_x
		i32 bounding_box_center_y= 0; // add_y
		i32 bounding_box_center_z= 0; // add_z

		// For enemies setting at least one of these dimensions into zero disables collisions with player.
		// Collisions with the wolrd is still present.
		i32 bounding_box_half_size_x= 0; // szer_x
		i32 bounding_box_half_size_y= 0; // szer_y
		i32 bounding_box_half_size_z= 0; // szer_z

		// Is 1 (usually for enemies) or 0.
		u32 activity= 0u; // aktywnosc

		// It's mostly 5.
		// For panzerfaust projectile it's 10.
		// For the tank enemy it's 13.
		u32 mask= 0u; // maska

		// Specifies angle in range 0 to 1024 mapped to range 0 to tau.
		// It's absolute orientation of the shown model.
		u32 direction= 0u; // kierunek
	}

	struct Stopper
	{
		u32 time= 0u; // czas
		u32 new_operation= ~0u; // nowa_op
	}

	struct ObjectRotation
	{
		// It looks like rotation speed in 1024 units per full circle per logic step.
		u32 rotation= 0u; // rotacja

		u32 time= 0u; // czas
		u32 new_operation= 0u; // nowa_op
	}

	struct OperationControl
	{
		var u32
			c_functioning_mode_move_towards_waypoint= 1u,
			c_functioning_mode_move_towards_player= 2u,
			// 11 for moving (or staying) sky decorations like planes or airships.
			c_functioning_mode_11= 11u;

		// See functioning mode constants.
		u32 functioning_mode= 0u; // tryb_pracy.

		// Movement speed. Is somewhat scaled.
		u32 speed= 0u; // szybkosc

		// It's usually 0 or 1, sometimes 2. It's 2 only for Focke-Wulf plane, tank enemy.
		// It's 0 for some operations of the Volkssturm enemy, the bipedial robot enemy, some decorations.
		u32 rotation= 0u; // obrot

		// value[0] is for now unknown.
		// value[1] is some time value.
		// Sometimes looks like period of current animation.
		// Experiments have shown that it's some sort of inverse delay.
		// Setting it to 1 adds significant delay for state transition. Setting it to 0 breaks state transition at all.
		// value[2] is next operation.
		ust::optional</ [ i32, 3 ] /> player_visible; // gracz_widoczny

		// State transition if player is very close (to perform melee atack).
		// value[0] is some time value. It looks like period of current animation and transition is possible only at steps divisible by this period.
		// value[1] is for now unknown. It also looks like operation index.
		// value[2] is next operation.
		ust::optional</ [ u32, 3 ] /> inside_shooting_zone_a; // w_zasiegu_strzalu_a

		// value[0] is some time value. It looks like period of current animation and transition is possible only at steps divisible by this period.
		// value[1] is for now unknown. It also looks like operation index.
		// value[2] is next operation.
		ust::optional</ [ u32, 3 ] /> inside_shooting_zone_b; // w_zasiegu_strzalu_b

		// Triggered if entity is damaged.
		// value[0] and value[1] look like operation number in case of injury.
		// If it's not -1, one of the two operations is selected randomly.
		// value[2] is next operation if killed.
		ust::optional</ [ i32, 3 ] /> energy_loss; // utrata_energi

		// value[0] is timeout value.
		// value[1] is next operation.
		ust::optional</ [ u32, 2 ] /> timeout; // timeout

		// Transition in case if is in good position for attack.
		// It's somewhat random compared to "w_zasiegu_strzalu_b".
		// value[0] is some time value. It looks like period of current animation and transition is possible only at steps divisible by this period.
		// value[1] is next operation.
		// value[2] seems to be randomness factor. Bigger value means more consequent attacks. Its maximum value is 6. Presumably it's in range up to 10.
		ust::optional</ [ u32, 3 ] /> convenient_position; // dogodna_pozycja

		// value[0] is some time value. It looks like period of current animation and transition is possible only at steps divisible by this period.
		// value[1] and value[3] look like percent values for random state transition.
		// value[2] and value[4] look like next operation indices (-1 if none).
		ust::optional</ [ i32, 5 ] /> randomness; // losowosc

		// Used in shot operations.
		// value[0] is weapon  tool index.
		// value[1], value[2], value[3] offset of shot start position.
		// value[4] is delay from operation start (in steps).
		ust::optional</ [ i32, 5 ] /> item; // przedmiot

		// Used only by the enemy with panzerfaust and the enemy with grenades.
		// value[0] is always 1.
		// value[1] is some time value. It looks like period of current animation and transition is possible only at steps divisible by this period.
		// value[2] is next operation if has ammo.
		// value[3] is next operation if has no ammo left.
		ust::optional</ [ u32, 4 ] /> transformation; // przemiana

		// It's used only for the enemy throwing grenades.
		// It's conditional operation transition - it's triggered if player can see this entity.
		// value[0] is some time value. It looks like period of current animation and transition is possible only at steps divisible by this period.
		// value[1] is next operation.
		ust::optional</ [ u32, 2 ] /> within_sight; // w_zasiegu_widocznosci
	}

	struct Light
	{
		i32 wspx= 0;
		i32 wspy= 0;
		i32 wspz= 0;
		u32 czas= 0u;
		u32 kolor= 0u;
		u32 moc= 0u;
		u32 delta= 0u;
	}

	struct Smoke
	{
		i32 position_x= 0; // wspx
		i32 position_y= 0; // wspy
		i32 position_z= 0; // wspz

		u32 time= 0u; // czas
		u32 amount= 0u; // ilosc
		u32 delta= 0u;
	}

	struct SupplyDrop
	{
		u32 time= 0u; // czas
		u32 los_energia= 0u;
		u32 los_oslona= 0u;
		u32 los_bron= 0u;
		u32 los_ammo= 0u;
		u32 special_object= ~0u; // ob_specjalny
	}

	struct CharacterMovement
	{
		u32 amount= 0u; // zapas
	}

	struct ObjectMovement
	{
		// Movement speed. May be negative.
		i32 speed= 0; // szybkosc

		// Angle of movement vector relative to current angle. Is in range 0 to 1024 mapped to range 0 to tau.
		u32 relative_angle= 0u; // add_kier
	}

	struct TargetRotation
	{
		// Rotation speed (in 1024 for the whole circle units).
		u32 step= 0u; // krok

		// Target angle in range 0 to 1024 mapped to range 0 to tau.
		u32 target_angle= 0u; // cel_kier
	}

	struct RotationForShot
	{
		// Speed with values in range 0 to 1024 mapped to range 0 to tau.
		u32 rotation_speed= 0u; // obrot

		// Its meaning is unknown.
		u32 zegar= 0u; // zegar

		// New operation if achieved target angle.
		i32 new_operation_if_target_in_view= -1; // nowa_opl

		// New operation if not achieved target angle.
		i32 new_operation_if_target_not_in_view= -1; // nowa_opp

		// How precise target angle should be achieved (in 1024 units for tau).
		u32 deviation_angle= 0u; // minkat
	}

	struct DirectionalShot
	{
		// Delay from operation start.
		u32 time= 0u; // czas

		 // What weapon to use.
		u32 item= 0u; // przedmiot

		// Offsets of shot start position.
		i32 offset_x= 0; // wspx
		i32 offset_y= 0; // wspy
		i32 offset_z= 0; // wspz

		// Seems to be some kind of spread, but it looks like it's actually unused.
		u32 cone= 0u; // stozek
	}

	struct CollisionWithEnemy
	{
		u32 new_operation= 0u; // nowa_op
		u32 rotation= 0u; // obrot
	}

	struct TakeSensor
	{
		ust::string8 flaga;
	}

	struct RelativePosition
	{
		i32 add_x= 0;
		i32 add_y= 0;
		i32 add_z= 0;
		u32 obrot= 0u;
	}

	struct IfAlive
	{
		u32 time= 0u; // czas
		[ u32, 2 ] new_operation[ ~0u, ~0u ]; // nowa_op
	}

	struct BoxContents
	{
		ToolType tool_type= ToolType::None; // przedmiot

		u32 amount= 0u; // ilosc

		u32 activation= 0u; // aktywizacja

		// Is always -1.
		i32 ammo_type= 0; // ammotyp

		// Is non-zero for weapon pick-ups giving some ammo for this weapon.
		u32 ammo= 0u; // ammo

		// Is always 0.
		u32 effect= 0u; // efekt

		// Is always 0.
		u32 key= 0u; // klucz

		// Is always 0.
		u32 stock= 0u; // zapas
	}

	struct GasolineExplosion
	{
		[ i32, 3 ] wybuch_a[ 0, 0, 0 ];
		[ i32, 3 ] wybuch_b[ 0, 0, 0 ];
		[ i32, 3 ] wybuch_c[ 0, 0, 0 ];
		[ i32, 3 ] wybuch_d[ 0, 0, 0 ];
		[ i32, 4 ] plomienie[ 0, 0, 0, 0 ];
		[ u32, 2 ] pole_razenia[ 0u, 0u ];
	}

	struct Bulb
	{
		u32 moc= 0u;
	}

	struct DecayingBulb
	{
		[ i32, 5 ] parametry[ 0, 0, 0, 0, 0 ];
	}

	struct Sound
	{
		u32 rodzaj= 0u;
		u32 moc= 0u;
	}

	struct SmokeEmission
	{
		i32 pos_x= 0; // poz_x
		i32 pos_y= 0; // poz_y
		i32 pos_z= 0; // poz_z

		i32 velocity_x= 0; // predkosc_x
		i32 velocity_y= 0; // predkosc_y
		i32 velocity_z= 0; // predkosc_z

		// How often a smoke particle is emitted (in steps).
		u32 emission_period= 0u; // and_czas

		// 0 for white smoke billboard, 1 for black smoke billboard.
		u32 smoke_model= 0u; // model_dymu
	}

	struct ItemRegeneration
	{
		u32 param= 0u;
	}

	struct StoneMovement
	{
		u32 gdy_kolizja= 0u;
		u32 nic= 0u;
	}

	struct SmokeExplosion
	{
		u32 aktor_nr= 0u;
		u32 czas= 0u;
	}

	struct Combustion
	{
		u32 rozmiar_pocz= 0u;
		i32 krok= 0;
		i32 add_x= 0;
		i32 add_y= 0;
		i32 add_z= 0;
		i32 szer_x= 0;
		i32 szer_y= 0;
		i32 szer_z= 0;
		u32 aktywnosc= 0u;
		u32 maska= 0u;
	}

	struct AlarmArea
	{
		u32 czas= 0u;
		i32 odglos= 0;
	}

	struct Tool // narzedzie
	{
		var u32
			c_projectile_kind_bullet= 1u, // Regular bullet travelling in a straigth line. Is named POCISK_A.
			c_projectile_kind_ricocheting_bullet= 2u, // The same as regular bullet, but ricocheting from walls.
			c_projectile_kind_grenade= 3u, // Bouncing projectile affected by gravity and with timer-based self-destruction.
			c_projectile_kind_melee= 4u, // Short-range projectile used for kick und knife.
			c_projectile_kind_rocket= 8u; // Projectile slightly affecting by gravity (panzerfaust, flamethrower).

		var i32 c_projectile_model_first_mesh_model= 2000;

		var u32
			c_smoke_trail_kind_none= 0u,
			c_smoke_trail_kind_rocket= 1u,
			c_smoke_trail_kind_flamethrower= 2u,
			c_smoke_trail_kind_mind_control= 3u;

		var i32
			c_projectile_collision_effect_none= -1,
			c_projectile_collision_effect_flame= 2,
			c_projectile_collision_effect_small_explosion= 10,
			c_projectile_collision_effect_large_explosion= 14,
			c_projectile_collision_effect_smoke_source= 1012,
			c_projectile_collision_effect_blood_source= 2000;

		ToolType tool_type= ToolType::None; // typ_przedmiotu

		// The index of an icon in the PANEL.BMP file.
		u32 icon= 0u; // ikona

		// How many tools of this type player initially has.
		// It's 1 for weapons given at game start.
		// It's a positive value for some ammo kinds - maybe this is how many ammo pieces the player receives while taking the corresponding weapon?
		u32 player_start_count= 0u; // bohater_ma

		// How many tools of this type player can have.
		// For weapons and items like keys it's 1.
		// For ammo it's maximum ammo.
		// For power-ups it's maximum time this power-up can be used (in seconds?).
		u32 player_max_count= 0u; // bohater_ma_max

		// The index of a tool used by this tool as ammo. -1 if none.
		i32 ammo_item= 0; // ammo_przedm

		// What animation is used for this tool (first-person model).
		// For non-weapon tools it's seemst to be always 18.
		u32 animation= 0u; // animacja

		// Damage (for weapons). For other tools it's zero.
		u32 damage= 0u; // sila_razenia

		// Index of a sound in GLOS.STD file. -1 if none.
		i32 sound= 0; // odglos

		// Looks like sound index when hittina a wall. -1 if none.
		i32 hit_wall= 0; // hitwall

		// Looks like sound index when hittina an object. -1 if none.
		i32 hit_object= 0; // hitobkt

		// Is -1 for all weapons except MG-42.
		// It looks like value 1092 represents sparkles effect at hit point.
		i32 stars= 0; // stars

		// 1 for mind control projectiles.
		// 25 is for simple bullets.
		// 27 is for lasergun shots.
		// 28 for plasma launcher shot.
		// Values starting with 2000 represent triangle models.
		// A value like 20XY means using animation XY.
		i32 projectile_model= 0; // obraz

		// Actual projectile movement speed (per game logic step).
		// Even bullets travel with non-instant speed.
		u32 speed= 0u; // predkosc

		// It seems to be the delay between shots.
		// Also it may be duration of shooting animation (but it's not clear).
		u32 shooting= 0u; // strzelnosc

		// Displayed tool name.
		ust::string8 name; // nazwa

		// See projectile kind constants.
		u32 projectile_kind= 0u; // model_pocisku

		// Is present for weapon tools.
		// Some weapons have more than one shot.
		// shot_data[0] seems to be sequential index.
		// shot_data[1] seems to be time delay (in steps).
		// shot_data[2], shot_data[3], shot_data[4] represent offset of shooting point (where a projectile starts its movement) relative to player position and rotation.
		// shot_data[5] is elevation offset (angle) of shooting direction relative to player rotation. Value -4096 is roughly 45 degree up.
		ust::vector</ [ i32, 7 ] /> shot_data; // dane_strzalu

		// Is present for weapon tools.
		// TODO - make it optional?
		// weapon_data[1] seems to be the number of steps in idle animation #0 and weapon_data[0] seems to be the first step of this animation.
		// weapon_data[3] seems to be the number of steps in idle animation #1 and weapon_data[2] seems to be the first step of this animation.
		// weapon_data[5] seems to be the number of steps in idle animation #2 and weapon_data[4] seems to be the first step of this animation.
		// weapon_data[6] seems to be the first step of shooting animation.
		[ i32, 8 ] weapon_data= zero_init; // dane_broni

		// Is present for weapon tools.
		// TODO - make it optional?
		// See collision effect constants.
		// value[0] is an effect for collisions with map polygons.
		// value[1] is an effect for collisions with non-enemy entities and player.
		// value[2] is an effect for collisions with enemies.
		[ i32, 3 ] collision_handling[ c_projectile_collision_effect_none ... ]; // obsluga_kolizji

		// Is -1 if leaves no wall marks.
		i32 wall_mark= 0; // slad_na_scianie

		// Seems to be boolean.
		// Is true for the mind control gun.
		u32 weapon_mind_control= 0u; // bron_mind_control

		// Seems to be 0 if has world collision and -1 otherwise.
		i32 world_collision= -1; // kolizja_mur

		// Is present for weapon tools.
		// Value 0 is index of light color in IC.STD file.
		// Value 1 looks like light radius.
		[ u32, 2 ] projectile_light= zero_init; // swiatlo_w_locie

		// Is present for weapon tools.
		// It describes muzzle flash light source params.
		// Value 0 is index of light color in IC.STD file.
		// Value 1 looks like light radius.
		[ u32, 2 ] light_at_shot= zero_init; // blysk_startowy

		// Is present for weapon tools.
		// It describes light flash at hit point.
		// Value 0 is index of light color in IC.STD file.
		// Value 1 looks like light radius.
		[ u32, 2 ] light_at_hit_point= zero_init; // blysk_koncowy

		// If present - is -1 or 1 or 24. Is present only for weapon tools.
		// It looks like sprite/billboard model of the muzzle flash.
		i32 muzzle_flash_model= -1; // pierwszy_blik

		// Has values in range 40 to 200 for weapon tools. Less value - more precise.
		// For some weapons it's for some reason not specified, in such case it should be zero.
		u32 enemy_weapon_accuracy= 0u; // celnosc_broni_wrogow

		// Has values in range 0 to 400 for weapon tools. Less value - more precise.
		// For some weapons it's for some reason not specified, in such case it should be zero.
		u32 player_weapon_accuracy= 0u; // celnosc_broni_gracza

		// Is non-zero for weapons with splash damage - grenades, panzerfaust.
		u32 splash_damage_area_size= 0u; // pole_razenia_pocisku

		// Seems to be boolean.
		// Is 0 for panzerfaust, is 1 for grenades, for other tools isn't specified at all.
		// it seems to be flag enabling weapon lowering animation after a shot.
		u32 overload= 0u; // przeladowanie

		// See smoke trail constants.
		u32 smoke_trail_kind= c_smoke_trail_kind_none; // dymienie

		// Is 0 for grenades, is non-zero for panzerfaust, for other tools isn't specified at all.
		// It contains amout of back speed added after a short.
		u32 recoil= 0u; // odrzut

		// Seems to be boolean.
		// Is specified only for flamethrower and for it it's 1.
		// It seems to activate sticky flames on enemies (which damage them further).
		u32 napalm= 0u; // napalm
	}

	enum ToolType
	{
		None,
		Kick,
		WeaponA,
		WeaponB,
		WeaponC,
		WeaponD,
		WeaponE,
		WeaponF,
		WeaponG,
		WeaponH,
		WeaponI,
		WeaponJ,
		KeyA,
		KeyB,
		KeyC,
		ProjectileA,
		ProjectileB,
		ProjectileC,
		ProjectileD,
		ProjectileE,
		ProjectileF,
		ProjectileG,
		ProjectileH,
		Armor,
		ArmorSuper,
		HealthPack,
		Jetpack,
		NightVision,
		InfraredVision,
		Flashlight,
		OxygenBalloon,
		Invisibility,
		AcidProtectionSuit,
		WeaponAmplifier,
		Silencer,
	}
}

// It seems like this is default value for maps where entities description file isn't specified.
var ResourceString c_default_entities_description_file_name= "ZINF.STD\0\0\0\0\0\0\0\0";

fn ParseEntitiesDescriptionFile( ust::string_view8 file_contents ) : EntitiesDescription;

} // namespace PM
