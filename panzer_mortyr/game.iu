import "caching_game_resources_loader.iu"
import "camera_controller.iu"
import "crosshair_drawing_info.iu"
import "game_event_notifications_drawing_info.iu"
import "game_structs.iu"
import "global_navigation_graph_observer.iu"
import "global_navigation_graph_route_searcher.iu"
import "hud_drawing_info.iu"
import "performance_counter.iu"
import "player_movement_controller.iu"
import "player_tool_controller.iu"
import "settings.iu"
import "world_drawing_info.iu"

namespace PM
{

// This class contains all game logic.
// TODO - split it into server/client parts.
class Game
{
public:
	fn constructor(
		SettingsImutPtr settings,
		CachingGameResourcesLoaderPtr caching_game_resources_loader_ptr,
		ConsoleOutPtr console_out );

	fn StartNewGame( mut this, u32 skill );

	fn TeleportToMap( mut this, u32 map_index, u32 skill );

	fn Update(
		mut this,
		f32 time_delta_s,
		KeyboardState& keyboard_state,
		MouseButtonsState mouse_buttons_state,
		[ i32, 2 ] mouse_motion );

	fn GetWorldDrawingInfo( this ) : WorldDrawingInfo;

	fn GetHudDrawingInfo( this ) : ust::optional</HudDrawingInfo/>;

	fn GetGameEventNotificationsDrawingInfo( this ) : ust::optional</GameEventNotificationsDrawingInfo/>;

	fn GetCrosshairDrawingInfo( this ) : CrosshairDrawingInfo;

public: // command processor methods.
	fn process_noclip( mut this );

	fn process_reset_position( mut this );

	// Give all cheat.
	fn process_give_all( mut this );

	// Invisibility cheat.
	fn process_invisibility( mut this );

	// Invulnerability cheat.
	fn process_invulnerability( mut this );

	fn process_debug_show_nearby_navigation_graph_nodes( mut this );
	fn process_debug_reset_nearby_navigation_graph_nodes_visualization( mut this );

	fn process_debug_set_navigation_target( mut this );
	fn process_debug_search_route( mut this );

private:
	fn PerformMapTransition(
		mut this, u32 map_index, u32 skill, ust::optional_ref_imut</PlayerState/> prev_player_state );

private:
	SettingsImutPtr imut settings_;
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;

	GameGlobalData imut global_data_;

	ust::optional</GameMapData/> map_data_;

	CameraController camera_controller_;
	PlayerMovementController player_movement_controller_;
	PlayerToolController player_tool_controller_;

	ust::optional</GameState/> game_state_;

	// 32-bit float has enough precision to store enough sub-step bits even for more than one hour of single map time.
	f32 prev_time_steps_;

	PerformanceCounter performance_counter_;

	GlobalNavigationGraphObserver global_navigation_graph_observer_;
	GlobalNavigationGraphRouteSearcher global_navigation_graph_route_searcher_;

	// Debug visualization of navigation graph nodes.
	ust::vector</ tup[ BBox3f, [ u8, 3 ] ] /> debug_navigation_graph_nodes_to_show_;

	ust::optional</ Vec3f /> debug_navigation_target_;
}

} // namespace PM
