import "/common_lib/map_loading.uh"
import "bbox.uh"

namespace PM
{

struct RayTraceResult
{
	u32 quad_index;
	u32 cluster_index;
	f32 distance; // In direction vector units.
}

// Finds nearest intersection point of the given ray with map polygons.
fn RayTrace(
	ZmapData& zmap_data,
	ZvoxData& zvox_data,
	Vec3f& ray_start,
	Vec3f& direction_vector ) : ust::optional</RayTraceResult/>;

struct TraceCollisionResult
{
	// Distance in move vector units.
	// Is 1 or more if has no collision.
	f32 clipped_move_distance;

	// Normal of collision point.
	// Isn't generally normalized.
	// Is zero if has no collision.
	Vec3f collision_point_normal;

	// Is valid index in the map quads array if has a collision with a map quad.
	u32 collision_quad_index;

	// Extra push if need one.
	// Apply it only if has no collision.
	ust::optional</Vec3f/> extra_push;
}

// Finds how far away it's possible to move directly.
fn CollisionTrace(
	ZmapData& zmap_data,
	ZvoxData& zvox_data,
	ust::array_view_imut</BBox3f/> extra_colliders,
	// Bounding box of the collider.
	BBox3f& bbox,
	// Where to start movement.
	Vec3f& start_position,
	// Direction + distance of the movement.
	Vec3f& movement_vector ) : TraceCollisionResult;

struct CollisionTraceClipResult
{
	var size_type c_max_collision_events= 4s;

	Vec3f position_clipped;
	u32 num_collision_events;

	// Actually contains only "num_collision_events" elements.
	// They are listed in order of collision.
	[ CollisionEvent, c_max_collision_events ] collision_events;

	struct CollisionEvent
	{
		// Normal of the collision plane.
		Vec3f plane_normal;

		// Is index in the map quads array if collided with a quad.
		u32 collision_quad_index;
	}
}

// Performs movement with possible clipping by many planes and sliding parallel to them.
fn CollisionTraceAndClip(
	ZmapData& zmap_data,
	ZvoxData& zvox_data,
	ust::array_view_imut</BBox3f/> extra_colliders,
	// Bounding box of the collider.
	BBox3f& bbox,
	// Where to start movement.
	Vec3f movement_start_position,
	// Where movement ends.
	Vec3f movement_end_position ) : CollisionTraceClipResult;

struct CollisionStepMoveResult
{
	CollisionTraceClipResult trace_clip_result;

	// Non-zero bit N means that plane N is ground plane.
	// Is all bits zero if not touching ground.
	u32 ground_planes_mask;
}

// Performs movement with possibility of steps climbing.
fn CollisionStepMove(
	ZmapData& zmap_data,
	ZvoxData& zvox_data,
	ust::array_view_imut</BBox3f/> extra_colliders,
	// Bounding box of the collider.
	BBox3f& bbox,
	// Where to start movement.
	Vec3f movement_start_position,
	// Where movement ends.
	Vec3f movement_end_position ) : CollisionStepMoveResult;

} // namespace PM
