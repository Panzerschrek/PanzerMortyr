import "/string.iu"
import "/sdl/sdl_with_opengl.iu"

namespace PM
{

// This class describes some key binding - a keyboard key or mouse button.
class KeyBinding
{
	var u32 c_num_mouse_buttons= 32u;

public:
	fn CreateFromName( ust::string_view8 name ) : ust::optional</KeyBinding/>;

	fn CreateFromKeyboardKeyScancode( SDL_Scancode s ) : KeyBinding;

	fn CreateFromMouseButton( u32 button_index ) : KeyBinding;

	// Constructor for internal usage.
	fn constructor( u32 code, PrivateTag t );

	fn constructor( mut this, KeyBinding& other )= default;
	op=( mut this, KeyBinding& other )= default;
	op==( KeyBinding& l, KeyBinding& r ) : bool = default;

	// Returns non-empty optional if it's keyboard key binding.
	fn GetAsKeyboardKeyScancode( this ) : ust::optional</SDL_Scancode/>;

	// Returns non-empty optional if it's a mouse button binding.
	fn GetAsMouseButton( this ) : ust::optional</u32/>;

	// Returns static string.
	// Returns empty string if this binding has no name.
	fn GetName( this ) : ust::string_view8;

private:
	struct PrivateTag{}

	var u32 c_first_mouse_code= 0x80000000u;

private:
	u32 code_; // SDL_Scancode or special mouse codes.
}

} // namespace PM
