import "/string.iu"
import "/sdl/sdl_with_opengl.iu"

namespace PM
{

class KeyBinding
{
public:
	fn CreateFromName( ust::string_view8 name ) : ust::optional</KeyBinding/>;

	fn CreateFromKeyScancode( SDL_Scancode s ) : KeyBinding;

	// Constructor for internal usage.
	fn constructor( SDL_Scancode key_scancode, PrivateTag t );

	fn constructor( mut this, KeyBinding& other )= default;
	op=( mut this, KeyBinding& other )= default;
	op==( KeyBinding& l, KeyBinding& r ) : bool = default;

	// Returns non-empty optional if it's key scancode.
	fn GetAsKeyScancode( this ) : ust::optional</SDL_Scancode/>;

	// Returns static string.
	// Returns empty string if this scancode has no name.
	fn GetName( this ) : ust::string_view8;

private:
	struct PrivateTag{}

private:
	// Use this field to index the keyboard state array.
	SDL_Scancode scancode_;
}

} // namespace PM
