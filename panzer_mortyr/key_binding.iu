import "/string.iu"
import "/sdl/sdl_with_opengl.iu"

namespace PM
{

struct KeyBinding
{
	fn CreateFromName( ust::string_view8 name ) : ust::optional</KeyBinding/>;

	fn constructor( SDL_Scancode s ) ( scancode= s ) {}

	// Returns static string.
	// Returns empty string if this scancode has no name.
	fn GetName( this ) : ust::string_view8;

	// Use this field to index the keyboard state array.
	SDL_Scancode scancode;
}

} // namespace PM
