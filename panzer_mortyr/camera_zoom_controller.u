import "camera_zoom_controller.uh"

namespace PM
{

fn CameraZoomController::Update( mut this, f32 time_delta_s, u32 mouse_state )
{
	// TODO - allow configuring it.
	var u32 c_zoom_button= 3u;

	var f32 c_zoom_speed= 4.0f;

	if( ( mouse_state & ( 1u << ( c_zoom_button - 1u ) ) ) != 0u )
	{
		zoom_fraction_+= time_delta_s * c_zoom_speed;
		ust::min_assign( zoom_fraction_, 1.0f );
	}
	else
	{
		zoom_fraction_-= time_delta_s * c_zoom_speed;
		ust::max_assign( zoom_fraction_, 0.0f );
	}
}

fn CameraZoomController::GetFOVScale( this ) : f32
{
	return 1.0f - 0.7f * zoom_fraction_;
}

} // namespace PM
