import "/scoped_array.u"
import "/stdout.u"
import "shader_program.uh"

namespace PM
{

fn ShaderProgram::constructor( ust::string_view8 vertex_text, ust::string_view8 fragment_text )
	(
		program_= unsafe( glCreateProgram() ),
		vertex_shader_= unsafe( glCreateShader( GLenum( GL_VERTEX_SHADER ) ) ),
		fragment_shader_= unsafe( glCreateShader( GLenum( GL_FRAGMENT_SHADER ) ) )
	)
{
	unsafe
	{
		CompileShader( vertex_shader_, vertex_text );
		glAttachShader( program_, vertex_shader_ );
	}

	unsafe
	{
		CompileShader( fragment_shader_, fragment_text );
		glAttachShader( program_, fragment_shader_ );
	}

	unsafe
	{
		glLinkProgram( program_ );

		var GLint mut log_length= zero_init;
		glGetProgramiv( program_, GLenum( GL_INFO_LOG_LENGTH ), $<( log_length ) );
		if( log_length > 0 )
		{
			scoped_array char8 mut log[ size_type(log_length) ]( '\0' );
			glGetProgramInfoLog( program_, log_length, $<(log_length), log.data() );

			ust::stderr_print( ust::concat( "Shader program linking note:\n", log, "\n\n" ) );
		}
	}
}

fn ShaderProgram::destructor()
{
	unsafe( glDeleteProgram( program_ ) );
	unsafe( glDeleteShader( vertex_shader_ ) );
	unsafe( glDeleteShader( fragment_shader_ ) );
}

fn ShaderProgram::Bind( this )
{
	unsafe( glUseProgram( program_ ) );
}

// Passed shader handle should be correct.
// Passed text may be incorrect, in such case compilation will fail.
fn CompileShader( GLuint shader, ust::string_view8 text ) unsafe
{
	unsafe
	{
		var [ $(char8), 1 ] mut lines[ text.data() ];
		var [ GLint, 1 ] mut line_lengths[ ( text.size() ) ];
		glShaderSource( shader, 1, $<( lines[0] ), $<( line_lengths[0] ) );

		glCompileShader( shader );

		var GLint mut log_length= zero_init;
		glGetShaderiv( shader, GLenum( GL_INFO_LOG_LENGTH ), $<( log_length ) );
		if( log_length > 0 )
		{
			scoped_array char8 mut log[ size_type(log_length) ]( '\0' );
			glGetShaderInfoLog( shader, log_length, $<(log_length), log.data() );

			ust::stderr_print( ust::concat( "Shader compilation note:\n", log, "\n\n" ) );
		}
	}
}

} // namespace PM
