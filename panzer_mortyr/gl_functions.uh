DEFINE_GL_FUNCTION_POUNTER( "glDebugMessageCallback" )
DEFINE_GL_FUNCTION_POUNTER( "glDeleteBuffers" )
DEFINE_GL_FUNCTION_POUNTER( "glDeleteVertexArrays" )
DEFINE_GL_FUNCTION_POUNTER( "glDeleteProgram" )
DEFINE_GL_FUNCTION_POUNTER( "glDeleteShader" )
DEFINE_GL_FUNCTION_POUNTER( "glDeleteTextures" )
