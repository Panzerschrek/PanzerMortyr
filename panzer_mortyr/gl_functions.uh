//
// This header file defines global mutable function pointers for all used OpenGL functions.
// It implements some sort of OpenGL loader.
// It's necessary, since system OpenGL libraries expose only functions from some old OpenGL version (like 1.1).
// But since we need to load at least some functions dynamically, we load all of them - for simplicity and to avoid linking against system OpenGL library directly.
//

import "/memory.iu"

import "/sdl/sdl_with_opengl.uh"

?macro <? DEFINE_GL_FUNCTION_TYPE:namespace ( ?name:expr ) ?>
->
<?
	mixin( "type " +  ::PM::MakeTypeNameForGLFunction</ ?name />() + " = typeof( " + ?name + " );" );
?>

?macro <? DEFINE_GL_FUNCTION_POINTER:namespace ( ?name:expr ) ?>
->
<?
	mixin( "var " + ::PM::MakeTypeNameForGLFunction</ ?name />() + " mut " + ?name + "= zero_init;" );
?>

// Create type aliases for OpenGL1 function types, since they are missing in OpenGL C headers.
// This is necessary, since we avoid to use even OpenGL1 functions directly.
// Do this in global namespace in order to avoid creating cyclic dependency with our function pointer definitions (defined further).
DEFINE_GL_FUNCTION_TYPE( "glBindTexture" )
DEFINE_GL_FUNCTION_TYPE( "glBlendFunc" )
DEFINE_GL_FUNCTION_TYPE( "glClear" )
DEFINE_GL_FUNCTION_TYPE( "glClearColor" )
DEFINE_GL_FUNCTION_TYPE( "glCullFace" )
DEFINE_GL_FUNCTION_TYPE( "glDeleteTextures" )
DEFINE_GL_FUNCTION_TYPE( "glDepthFunc" )
DEFINE_GL_FUNCTION_TYPE( "glDepthMask" )
DEFINE_GL_FUNCTION_TYPE( "glDisable" )
DEFINE_GL_FUNCTION_TYPE( "glDrawArrays" )
DEFINE_GL_FUNCTION_TYPE( "glDrawElements" )
DEFINE_GL_FUNCTION_TYPE( "glEnable" )
DEFINE_GL_FUNCTION_TYPE( "glGenTextures" )
DEFINE_GL_FUNCTION_TYPE( "glGetString" )
DEFINE_GL_FUNCTION_TYPE( "glPointSize" )
DEFINE_GL_FUNCTION_TYPE( "glPolygonMode" )
DEFINE_GL_FUNCTION_TYPE( "glTexImage2D" )
DEFINE_GL_FUNCTION_TYPE( "glTexParameterf" )
DEFINE_GL_FUNCTION_TYPE( "glTexParameteri" )

namespace PM
{

// Define OpenGL function pointers within out namespace to avoid name collision if system OpenGL header defines prototypes for some of these functions.
// TODO - maybe create a tuple of arrays for these names?
DEFINE_GL_FUNCTION_POINTER( "glActiveTexture" )
DEFINE_GL_FUNCTION_POINTER( "glAttachShader" )
DEFINE_GL_FUNCTION_POINTER( "glBindBuffer" )
DEFINE_GL_FUNCTION_POINTER( "glBindTexture" )
DEFINE_GL_FUNCTION_POINTER( "glBindVertexArray" )
DEFINE_GL_FUNCTION_POINTER( "glBlendFunc" )
DEFINE_GL_FUNCTION_POINTER( "glBufferData" )
DEFINE_GL_FUNCTION_POINTER( "glBufferSubData" )
DEFINE_GL_FUNCTION_POINTER( "glClear" )
DEFINE_GL_FUNCTION_POINTER( "glClearColor" )
DEFINE_GL_FUNCTION_POINTER( "glCullFace" )
DEFINE_GL_FUNCTION_POINTER( "glCompileShader" )
DEFINE_GL_FUNCTION_POINTER( "glCreateProgram" )
DEFINE_GL_FUNCTION_POINTER( "glCreateShader" )
DEFINE_GL_FUNCTION_POINTER( "glDebugMessageCallback" )
DEFINE_GL_FUNCTION_POINTER( "glDeleteBuffers" )
DEFINE_GL_FUNCTION_POINTER( "glDeleteVertexArrays" )
DEFINE_GL_FUNCTION_POINTER( "glDeleteProgram" )
DEFINE_GL_FUNCTION_POINTER( "glDeleteShader" )
DEFINE_GL_FUNCTION_POINTER( "glDeleteTextures" )
DEFINE_GL_FUNCTION_POINTER( "glDepthFunc" )
DEFINE_GL_FUNCTION_POINTER( "glDepthMask" )
DEFINE_GL_FUNCTION_POINTER( "glDisable" )
DEFINE_GL_FUNCTION_POINTER( "glDrawArrays" )
DEFINE_GL_FUNCTION_POINTER( "glDrawElements" )
DEFINE_GL_FUNCTION_POINTER( "glDrawElementsBaseVertex" )
DEFINE_GL_FUNCTION_POINTER( "glEnable" )
DEFINE_GL_FUNCTION_POINTER( "glEnableVertexAttribArray" )
DEFINE_GL_FUNCTION_POINTER( "glGetString" )
DEFINE_GL_FUNCTION_POINTER( "glGenBuffers" )
DEFINE_GL_FUNCTION_POINTER( "glGenTextures" )
DEFINE_GL_FUNCTION_POINTER( "glGenerateMipmap" )
DEFINE_GL_FUNCTION_POINTER( "glGenVertexArrays" )
DEFINE_GL_FUNCTION_POINTER( "glGetActiveUniform" )
DEFINE_GL_FUNCTION_POINTER( "glGetProgramiv" )
DEFINE_GL_FUNCTION_POINTER( "glGetProgramInfoLog" )
DEFINE_GL_FUNCTION_POINTER( "glGetShaderiv" )
DEFINE_GL_FUNCTION_POINTER( "glGetShaderInfoLog" )
DEFINE_GL_FUNCTION_POINTER( "glGetUniformLocation" )
DEFINE_GL_FUNCTION_POINTER( "glLinkProgram" )
DEFINE_GL_FUNCTION_POINTER( "glPointSize" )
DEFINE_GL_FUNCTION_POINTER( "glPolygonMode" )
DEFINE_GL_FUNCTION_POINTER( "glShaderSource" )
DEFINE_GL_FUNCTION_POINTER( "glTexImage2D" )
DEFINE_GL_FUNCTION_POINTER( "glTexImage3D" )
DEFINE_GL_FUNCTION_POINTER( "glTexSubImage3D" )
DEFINE_GL_FUNCTION_POINTER( "glTexParameterf" )
DEFINE_GL_FUNCTION_POINTER( "glTexParameteri" )
DEFINE_GL_FUNCTION_POINTER( "glUniformMatrix4fv" )
DEFINE_GL_FUNCTION_POINTER( "glUniform1i" )
DEFINE_GL_FUNCTION_POINTER( "glUniform1f" )
DEFINE_GL_FUNCTION_POINTER( "glUniform2f" )
DEFINE_GL_FUNCTION_POINTER( "glUniform3f" )
DEFINE_GL_FUNCTION_POINTER( "glUniform4f" )
DEFINE_GL_FUNCTION_POINTER( "glUseProgram" )
DEFINE_GL_FUNCTION_POINTER( "glVertexAttribPointer" )

template</ [ char8, S ] name, size_type S />
fn constexpr MakeTypeNameForGLFunction() : [ char8, S + 7s ]
{
	var [ char8, S + 7s ] mut res= zero_init;

	res[0]= 'P';
	res[1]= 'F';
	res[2]= 'N';

	for( var size_type mut i= 0s; i < S; ++i )
	{
		var char8 mut c= name[i];
		if( c >= 'a' && c <= 'z' )
		{
			c= char8( u32(c) - u32('a') + u32('A') );
		}
		res[ 3s + i ]= c;
	}

	res[ S + 3s ]= 'P';
	res[ S + 4s ]= 'R';
	res[ S + 5s ]= 'O';
	res[ S + 6s ]= 'C';

	return res;
}

// Call this once after OpenGL initialization.
fn InitializeGLFunctionPointers()
{
	InitializeGLFunctionPointer</ "glActiveTexture" />();
	InitializeGLFunctionPointer</ "glAttachShader" />();
	InitializeGLFunctionPointer</ "glBindBuffer" />();
	InitializeGLFunctionPointer</ "glBindTexture" />();
	InitializeGLFunctionPointer</ "glBindVertexArray" />();
	InitializeGLFunctionPointer</ "glBlendFunc" />();
	InitializeGLFunctionPointer</ "glBufferData" />();
	InitializeGLFunctionPointer</ "glBufferSubData" />();
	InitializeGLFunctionPointer</ "glClear" />();
	InitializeGLFunctionPointer</ "glClearColor" />();
	InitializeGLFunctionPointer</ "glCullFace" />();
	InitializeGLFunctionPointer</ "glCompileShader" />();
	InitializeGLFunctionPointer</ "glCreateProgram" />();
	InitializeGLFunctionPointer</ "glCreateShader" />();
	InitializeGLFunctionPointer</ "glDebugMessageCallback" />();
	InitializeGLFunctionPointer</ "glDeleteBuffers" />();
	InitializeGLFunctionPointer</ "glDeleteVertexArrays" />();
	InitializeGLFunctionPointer</ "glDeleteProgram" />();
	InitializeGLFunctionPointer</ "glDeleteShader" />();
	InitializeGLFunctionPointer</ "glDeleteTextures" />();
	InitializeGLFunctionPointer</ "glDepthFunc" />();
	InitializeGLFunctionPointer</ "glDepthMask" />();
	InitializeGLFunctionPointer</ "glDisable" />();
	InitializeGLFunctionPointer</ "glDrawArrays" />();
	InitializeGLFunctionPointer</ "glDrawElements" />();
	InitializeGLFunctionPointer</ "glDrawElementsBaseVertex" />();
	InitializeGLFunctionPointer</ "glEnable" />();
	InitializeGLFunctionPointer</ "glEnableVertexAttribArray" />();
	InitializeGLFunctionPointer</ "glGetString" />();
	InitializeGLFunctionPointer</ "glGenBuffers" />();
	InitializeGLFunctionPointer</ "glGenTextures" />();
	InitializeGLFunctionPointer</ "glGenerateMipmap" />();
	InitializeGLFunctionPointer</ "glGenVertexArrays" />();
	InitializeGLFunctionPointer</ "glGetActiveUniform" />();
	InitializeGLFunctionPointer</ "glGetProgramiv" />();
	InitializeGLFunctionPointer</ "glGetProgramInfoLog" />();
	InitializeGLFunctionPointer</ "glGetShaderiv" />();
	InitializeGLFunctionPointer</ "glGetShaderInfoLog" />();
	InitializeGLFunctionPointer</ "glGetUniformLocation" />();
	InitializeGLFunctionPointer</ "glLinkProgram" />();
	InitializeGLFunctionPointer</ "glPointSize" />();
	InitializeGLFunctionPointer</ "glPolygonMode" />();
	InitializeGLFunctionPointer</ "glShaderSource" />();
	InitializeGLFunctionPointer</ "glTexImage2D" />();
	InitializeGLFunctionPointer</ "glTexImage3D" />();
	InitializeGLFunctionPointer</ "glTexSubImage3D" />();
	InitializeGLFunctionPointer</ "glTexSubImage3D" />();
	InitializeGLFunctionPointer</ "glTexParameterf" />();
	InitializeGLFunctionPointer</ "glTexParameteri" />();
	InitializeGLFunctionPointer</ "glUniformMatrix4fv" />();
	InitializeGLFunctionPointer</ "glUniform1i" />();
	InitializeGLFunctionPointer</ "glUniform1f" />();
	InitializeGLFunctionPointer</ "glUniform2f" />();
	InitializeGLFunctionPointer</ "glUniform3f" />();
	InitializeGLFunctionPointer</ "glUniform4f" />();
	InitializeGLFunctionPointer</ "glUseProgram" />();
	InitializeGLFunctionPointer</ "glVertexAttribPointer" />();
}

template</ [ char8, S ] name, size_type S />
fn InitializeGLFunctionPointer()
{
	auto constexpr name_nt= name + "\0";

	unsafe
	{
		var $(byte8) mut ptr= SDL_GL_GetProcAddress( $<( cast_mut( name_nt[0] ) ) );

		// It's not undefined behavior to use "memory_copy" to write raw pointer value into a variable of function pointer type.
		ust::memory_copy(
			ust::ptr_cast_to_byte8( $<( mixin( name ) ) ),
			ust::ptr_cast_to_byte8( $<( ptr ) ),
			typeinfo</ $(byte8) />.size_of );
	}
}

} // namespace PM
