import "/memory.u"

import "/sdl/sdl_with_opengl.uh"

?macro <? DEFINE_GL_FUNCTION_POUNTER:namespace ( ?name:expr ) ?>
->
<?
	mixin( "var " + ::PM::MakeTypeNameForGLFunction</ ?name />() + " mut " + ?name + "= zero_init;" );
?>

namespace PM
{

DEFINE_GL_FUNCTION_POUNTER( "glCreateProgram" )
DEFINE_GL_FUNCTION_POUNTER( "glCreateShader" )

template</ [ char8, S ] name, size_type S />
fn constexpr MakeTypeNameForGLFunction() : [ char8, S + 7s ]
{
	var [ char8, S + 7s ] mut res= zero_init;

	res[0]= 'P';
	res[1]= 'F';
	res[2]= 'N';

	for( var size_type mut i= 0s; i < S; ++i )
	{
		var char8 mut c= name[i];
		if( c >= 'a' && c <= 'z' )
		{
			c= char8( u32(c) - u32('a') + u32('A') );
		}
		res[ 3s + i ]= c;
	}

	res[ S + 3s ]= 'P';
	res[ S + 4s ]= 'R';
	res[ S + 5s ]= 'O';
	res[ S + 6s ]= 'C';

	return res;
}

fn InitializeGLFunctionPointers()
{
	InitializeGLFunctionPointer</ "glCreateProgram" />();
}

template</ [ char8, S ] name, size_type S />
fn InitializeGLFunctionPointer()
{
	unsafe
	{
		var $(byte8) mut ptr= SDL_GL_GetProcAddress( $<( cast_mut( ( name + "\0" ) [0] ) ) );

		ust::memory_copy(
			ust::ptr_cast_to_byte8( $<( mixin( name ) ) ),
			ust::ptr_cast_to_byte8( $<( ptr ) ),
			typeinfo</ $(byte8) />.size_of );
	}
}

} // namespace PM
