import "/memory.u"

import "/sdl/sdl_with_opengl.uh"

?macro <? DEFINE_GL_FUNCTION_POUNTER:namespace ( ?name:expr ) ?>
->
<?
	mixin( "var " + ::PM::MakeTypeNameForGLFunction</ ?name />() + " mut " + ?name + "= zero_init;" );
?>

?macro <? DEFINE_GL_FUNCTION_TYPE:namespace ( ?name:expr ) ?>
->
<?
	mixin( "type " +  ::PM::MakeTypeNameForGLFunction</ ?name />() + " = typeof( " + ?name + " );" );
?>

// Creae type aliases for OpenGL1 function types, since they are missing in OpenGL C headers.
// This is necessary, since we avoid to use even OpenGL1 functions directly.
DEFINE_GL_FUNCTION_TYPE( "glBindTexture" )
DEFINE_GL_FUNCTION_TYPE( "glClear" )
DEFINE_GL_FUNCTION_TYPE( "glClearColor" )
DEFINE_GL_FUNCTION_TYPE( "glCullFace" )
DEFINE_GL_FUNCTION_TYPE( "glDeleteTextures" )
DEFINE_GL_FUNCTION_TYPE( "glDepthFunc" )
DEFINE_GL_FUNCTION_TYPE( "glDepthMask" )
DEFINE_GL_FUNCTION_TYPE( "glDrawElements" )
DEFINE_GL_FUNCTION_TYPE( "glEnable" )
DEFINE_GL_FUNCTION_TYPE( "glGenTextures" )
DEFINE_GL_FUNCTION_TYPE( "glTexParameteri" )

namespace PM
{

