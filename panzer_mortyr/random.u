import "random.iu"

namespace PM
{

fn PseudoRandomGenerator::constructor( u32 seed )
	( state_= seed )
{}

fn PseudoRandomGenerator::Next( mut this ) : u32
{
	state_= ( 22695477u * state_ + 1u ) & 0x7FFFFFFFu;
	return state_ >> 16;
}

fn PseudoRandomGenerator::Serialize( this, Serializer &mut serializer )
{
	PM::Serialize( serializer, state_ );
}

fn PseudoRandomGenerator::Deserialize( Deserializer &mut deserializer ) : ust::optional</PseudoRandomGenerator/>
{
	if_var( state : PM::Deserialize</u32/>( deserializer ) )
	{
		return PseudoRandomGenerator( state );
	}
	return ust::null_optional;
}

} // namespace PM
