import "/optional.iu"
import "vec.iu"

namespace PM
{

type Mat3f= Mat3</f32/>;
type Mat4f= Mat4</f32/>;

template</ type T />
struct Mat3
{
	type ThisType= Mat3</T/>;

	fn MakeZero() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(0), T(0), T(0) ],
				[ T(0), T(0), T(0) ],
				[ T(0), T(0), T(0) ],
			]
		};
	}

	fn MakeIdentity() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0) ],
				[ T(0), T(1), T(0) ],
				[ T(0), T(0), T(1) ],
			]
		};
	}

	fn MakeTranslation( Vec2</T/>& v ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0) ],
				[ T(0), T(1), T(0) ],
				[ v.x, v.y, T(1) ],
			]
		};
	}

	fn MakeScale( T scale ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ scale,  T(0), T(0) ],
				[  T(0), scale, T(0) ],
				[  T(0),  T(0), T(1) ],
			]
		};
	}

	fn MakeScale( Vec2</T/>& scale ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ scale.x,    T(0), T(0) ],
				[    T(0), scale.y, T(0) ],
				[    T(0),    T(0), T(1) ],
			]
		};
	}

	// Matrix multiplication.
	op*( ThisType& l, ThisType& r ) : ThisType
	{
		var ThisType mut res= MakeZero();

		for( auto mut y= 0s; y < 3s; ++y )
		{
			for( auto mut x= 0s; x < 3s; ++x )
			{
				var T mut val(0);

				for( auto mut i= 0s; i < 3s; ++i )
				{
					val+= l.values[y][i] * r.values[i][x];
				}

				res.values[y][x]= val;
			}
		}

		return res;
	}

	// Vector by matrix multiplication.
	op*( Vec3</T/>& l, ThisType& r ) : Vec3</T/>
	{
		return
		Vec3</T/>
		(
			l.x * r.values[0][0] + l.y * r.values[1][0] + l.z * r.values[2][0],
			l.x * r.values[0][1] + l.y * r.values[1][1] + l.z * r.values[2][1],
			l.x * r.values[0][2] + l.y * r.values[1][2] + l.z * r.values[2][2]
		);
	}

	fn Determinant( this ) : T
	{
		return
			values[0][0] * ( values[1][1] * values[2][2] - values[2][1] * values[1][2] ) -
			values[0][1] * ( values[1][0] * values[2][2] - values[2][0] * values[1][2] ) +
			values[0][2] * ( values[1][0] * values[2][1] - values[2][0] * values[1][1] );
	}

	fn nodiscard Inverse( this ) : ust::optional</ThisType/>
	{
		var T det= Determinant();
		if( det == T(0) )
		{
			return ust::null_optional;
		}

		var T inv_det= T(1) / det;

		return ThisType
		{
			.values
			[
				[
					inv_det * ( values[1][1] * values[2][2] - values[2][1] * values[1][2] ),
					inv_det * ( values[0][2] * values[2][1] - values[0][1] * values[2][2] ),
					inv_det * ( values[0][1] * values[1][2] - values[0][2] * values[1][1] )
				],
				[
					inv_det * ( values[1][2] * values[2][0] - values[1][0] * values[2][2] ),
					inv_det * ( values[0][0] * values[2][2] - values[0][2] * values[2][0] ),
					inv_det * ( values[0][2] * values[1][0] - values[0][0] * values[1][2] ),
				],
				[
					inv_det * ( values[1][0] * values[2][1] - values[1][1] * values[2][0] ),
					inv_det * ( values[0][1] * values[2][0] - values[0][0] * values[2][1] ),
					inv_det * ( values[0][0] * values[1][1] - values[0][1] * values[1][0] ),
				],
			],
		};
	}

	fn Transpose( this ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ values[0][0], values[1][0], values[2][0] ],
				[ values[0][1], values[1][1], values[2][1] ],
				[ values[0][2], values[1][2], values[2][2] ],
			],
		};
	}

	// Row-by-row values.
	[ [ T, 3 ], 3 ] values;
}


template</ type T />
struct Mat4
{
	type ThisType= Mat4</T/>;

	fn MakeZero() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
				[ T(0), T(0), T(0), T(0) ],
			]
		};
	}

	fn MakeIdentity() : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0), T(0) ],
				[ T(0), T(1), T(0), T(0) ],
				[ T(0), T(0), T(1), T(0) ],
				[ T(0), T(0), T(0), T(1) ],
			]
		};
	}

	fn MakeTranslation( Vec3</T/>& v ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0), T(0) ],
				[ T(0), T(1), T(0), T(0) ],
				[ T(0), T(0), T(1), T(0) ],
				[ v.x, v.y, v.z, T(1) ],
			]
		};
	}

	fn MakeScale( T scale ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ scale,  T(0),  T(0), T(0) ],
				[  T(0), scale,  T(0), T(0) ],
				[  T(0),  T(0), scale, T(0) ],
				[  T(0),  T(0),  T(1), T(1) ],
			]
		};
	}

	fn MakeScale( Vec3</T/>& scale ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ scale.x,    T(0),    T(0), T(0) ],
				[    T(0), scale.y,    T(0), T(0) ],
				[    T(0),    T(0), scale.z, T(0) ],
				[    T(0),    T(0),    T(1), T(1) ],
			]
		};
	}

	fn MakePerspective( T aspect, T fov_x, T z_near, T z_far ) : ThisType
	{
		var T half_fov_inv_tan= T(1) / ust::tan( fov_x * T(0.5) );

		var T inv_diff= T(1) / ( z_far - z_near );

		return ThisType
		{
			.values
			[
				[ half_fov_inv_tan, T(0), T(0), T(0) ],
				[ T(0), half_fov_inv_tan * aspect, T(0), T(0) ],
				[ T(0), T(0), inv_diff * ( z_near + z_far ), T(1) ],
				[ T(0), T(0), -T(2) * inv_diff * z_near * z_far, T(0) ],
			]
		};
	}

	fn MakeRotationX( T rotation_angle ) : ThisType
	{
		var T c= ust::cos( rotation_angle );
		var T s= ust::sin( rotation_angle );

		return ThisType
		{
			.values
			[
				[ T(1), T(0), T(0), T(0) ],
				[ T(0),    c,    s, T(0) ],
				[ T(0),   -s,    c, T(0) ],
				[ T(0), T(0), T(0), T(1) ],
			]
		};
	}

	fn MakeRotationY( T rotation_angle ) : ThisType
	{
		var T c= ust::cos( rotation_angle );
		var T s= ust::sin( rotation_angle );

		return ThisType
		{
			.values
			[
				[    c, T(0),    s, T(0) ],
				[ T(0), T(1), T(0), T(0) ],
				[   -s, T(0),    c, T(0) ],
				[ T(0), T(0), T(0), T(1) ],
			]
		};
	}

	fn MakeRotationZ( T rotation_angle ) : ThisType
	{
		var T c= ust::cos( rotation_angle );
		var T s= ust::sin( rotation_angle );

		return ThisType
		{
			.values
			[
				[    c,    s, T(0), T(0) ],
				[   -s,    c, T(0), T(0) ],
				[ T(0), T(0), T(1), T(0) ],
				[ T(0), T(0), T(0), T(1) ],
			]
		};
	}

	fn MakeRotationAroundNormalizedAxis( Vec3</T/>& normalized_axis, f32 rotation_angle ) : ThisType
	{
		var T c= ust::cos( rotation_angle );
		var T s= ust::sin( rotation_angle );

		var Vec3f normalized_axis_scaled_c1= normalized_axis * ( T(1) - c );
		var Vec3f normalized_axis_scaled_s= normalized_axis * s;

		return ThisType
		{
			.values
			[
				[
					normalized_axis_scaled_c1.x * normalized_axis.x + c,
					normalized_axis_scaled_c1.x * normalized_axis.y + normalized_axis_scaled_s.z,
					normalized_axis_scaled_c1.x * normalized_axis.z - normalized_axis_scaled_s.y,
					T(0)
				],
				[
					normalized_axis_scaled_c1.y * normalized_axis.x - normalized_axis_scaled_s.z,
					normalized_axis_scaled_c1.y * normalized_axis.y + c,
					normalized_axis_scaled_c1.y * normalized_axis.z + normalized_axis_scaled_s.x,
					T(0)
				],
				[
					normalized_axis_scaled_c1.z * normalized_axis.x + normalized_axis_scaled_s.y,
					normalized_axis_scaled_c1.z * normalized_axis.y - normalized_axis_scaled_s.x,
					normalized_axis_scaled_c1.z * normalized_axis.z + c,
					T(0)
				],
				[
					T(0),
					T(0),
					T(0),
					T(1)
				],
			]
		};
	}

	// Matrix multiplication.
	op*( ThisType& l, ThisType& r ) : ThisType
	{
		var ThisType mut res= MakeZero();

		for( auto mut y= 0s; y < 4s; ++y )
		{
			for( auto mut x= 0s; x < 4s; ++x )
			{
				var T mut val(0);

				for( auto mut i= 0s; i < 4s; ++i )
				{
					val+= l.values[y][i] * r.values[i][x];
				}

				res.values[y][x]= val;
			}
		}

		return res;
	}

	fn Transpose( this ) : ThisType
	{
		return ThisType
		{
			.values
			[
				[ values[0][0], values[1][0], values[2][0], values[3][0] ],
				[ values[0][1], values[1][1], values[2][1], values[3][1] ],
				[ values[0][2], values[1][2], values[2][2], values[3][2] ],
				[ values[0][3], values[1][3], values[2][3], values[3][3] ],
			],
		};
	}

	// Vector by matrix multiplication.
	op*( Vec3</T/>& l, ThisType& r ) : Vec3</T/>
	{
		return
		Vec3</T/>
		(
			l.x * r.values[0][0] + l.y * r.values[1][0] + l.z * r.values[2][0] + r.values[3][0],
			l.x * r.values[0][1] + l.y * r.values[1][1] + l.z * r.values[2][1] + r.values[3][1],
			l.x * r.values[0][2] + l.y * r.values[1][2] + l.z * r.values[2][2] + r.values[3][2]
		);
	}

	// Row-by-row values.
	[ [ T, 4 ], 4 ] values;
}

} // namespace PM
