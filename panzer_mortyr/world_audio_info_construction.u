import "bounding_boxes_hierarchy_visiting.iu"
import "cluster_utils.iu"
import "game_state_view_construction.iu"
import "mat.iu"
import "math_constants.iu"
import "world_audio_info_construction.iu"

namespace PM
{

fn ConstructWorldAudioInfo(
	GameGlobalData& global_data,
	GameMapData& map_data,
	GameState& game_state,
	CameraController& camera_controller ) : WorldAudioInfo
{
	var WorldAudioInfo mut info{ .ambient_sounds[ zero_init ... ] /* set ambient sounds later */ };

	// To generate proper unique sound IDs, set some unique bits of such IDs depending on kind of sound source (player, entity, environment, etc).
	var u32 player_sounds_id_mask=          0x10000000u;
	var u32 entity_sounds_id_mask=          0x20000000u;
	var u32 static_sounds_id_mask=          0x30000000u;
	var u32 dynamic_cluster_sounds_id_mask= 0x40000000u;
	var u32 entity_index_shift_for_sound_id= 16u;
	var u32 static_sound_index_shift_for_sound_id= 16u;
	var u32 dynamic_cluster_index_shift_for_sound_id= 16u;

	// Process player sounds.
	// They require no distance-based attenuation and are always played at full volume in both channels.
	foreach( &slot : game_state.player.sound_source_slots )
	{
		if( slot.sequential_index != 0u16 )
		{
			info.sound_sources.push_back(
				WorldAudioInfo::SoundSource
				{
					.id= player_sounds_id_mask | u32( slot.sequential_index ),
					.sound_index= slot.sound_index,
					.volume[ f32( slot.volume ) / f32( 255.0f ) ... ],
				} );
		}
	}

	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	var SpatialVolumeCalculator volume_calculator( map_data, game_state.player, camera_controller );

	for( auto mut i= 0s; i < game_state.entities.size(); ++i )
	{
		if_var( &entity : game_state.entities[i] )
		{
			foreach( &slot : entity.sound_source_slots )
			{
				if( slot.sequential_index != 0u16 )
				{
					var Vec3f mut sound_position= entity.position;

					var EntitiesDescription::EntityDescription& entity_description=
						entities_description.entities[ size_type( entity.kind ) ];

					if( size_type( entity.current_operation ) < entity_description.operations.size() )
					{
						var EntitiesDescription::Operation& operation=
							entity_description.operations[ size_type( entity.current_operation ) ];

						if( operation.animation_kind != EntitiesDescription::Operation::AnimationKind::None )
						{
							// Use BBox center as position of sound source.
							sound_position+=
								Vec3f(
									f32( operation.animation.bounding_box_center_x ),
									f32( operation.animation.bounding_box_center_y ),
									f32( operation.animation.bounding_box_center_z ) );
						}
					}

					info.sound_sources.push_back(
						WorldAudioInfo::SoundSource
						{
							// Generate ID based on entity ID and sequential index of the sound source slot of this entity.
							.id=
								entity_sounds_id_mask |
								u32( i << entity_index_shift_for_sound_id ) |
								u32( slot.sequential_index ),
							.sound_index= slot.sound_index,
							.volume= volume_calculator.CalculatePointSoundSourceRelativeVolume( sound_position, slot.volume ),
						} );
				}
			}
		}
	}


	for( auto mut i= 0s; i < typeinfo</ typeof( game_state.static_sound_sources.slots ) />.element_count; ++i )
	{
		var StaticSoundSources::Slot& slot= game_state.static_sound_sources.slots[i];
		if( slot.sequential_index != 0u16 )
		{
			info.sound_sources.push_back(
				WorldAudioInfo::SoundSource
				{
					// Generate ID based on slot index and sequential index of the sound source slot.
					.id=
						static_sounds_id_mask |
						u32( i << static_sound_index_shift_for_sound_id ) |
						u32( slot.sequential_index ),
					.sound_index= slot.sound_index,
					.volume= volume_calculator.CalculatePointSoundSourceRelativeVolume( slot.positon, slot.volume ),
				} );
		}
	}

	for( auto mut i= 0s; i < game_state.dynamic_clusters.size(); ++i )
	{
		var SoundSourceSlot& slot= game_state.dynamic_clusters[i].sound_source_slot;
		if( slot.sequential_index != 0u16 )
		{
			// Since dynamic clusters are large objects, calculating volume only for their centers isn't enough.
			// So, calculate volume for the center and for corner vertices of its bbox and average it.

			var BBox3f& bbox= game_state.dynamic_cluster_colliders[i].bbox;

			var [ f32, 2 ] mut volume_sum=
				volume_calculator.CalculatePointSoundSourceRelativeVolume( bbox.GetCenter(), slot.volume );

			foreach( &corner_vertex : bbox.CreateCornerVertices() )
			{
				var [ f32, 2 ] corner_volume=
					volume_calculator.CalculatePointSoundSourceRelativeVolume( corner_vertex, slot.volume );

				for( auto mut i= 0u; i < 2u; ++i )
				{
					volume_sum[i]+= corner_volume[i];
				}
			}

			var f32 num_elements_in_volume_sum= 9.0f; // 1 for center and 8 for corner vertices.

			info.sound_sources.push_back(
				WorldAudioInfo::SoundSource
				{
					// Generate ID based on dynamic cluster index and sequential index of the sound source slot.
					.id=
						dynamic_cluster_sounds_id_mask |
						u32( i << dynamic_cluster_index_shift_for_sound_id ) |
						u32( slot.sequential_index ),
					.sound_index= slot.sound_index,
					.volume[ volume_sum[0] / num_elements_in_volume_sum, volume_sum[1] / num_elements_in_volume_sum ],
				} );
		}
	}

	// Process ambient sounds.
	{
		var MapsDescription& maps_description= global_data.maps_description.deref();

		if( size_type( map_data.map_index ) < maps_description.maps.size() )
		{
			var [ [ f32, 2 ], WorldAudioInfo::c_num_ambient_sounds ] volumes=
				volume_calculator.CalculateAmbientSoundVolumes();

			var MapsDescription::MapDescription& map_description=
				maps_description.maps[ size_type( map_data.map_index ) ];

			static_assert(
				typeinfo</ typeof( map_description.ambient_sound_files ) />.element_count ==
				WorldAudioInfo::c_num_ambient_sounds );

			for( auto mut i= 0s; i < WorldAudioInfo::c_num_ambient_sounds; ++i )
			{
				info.ambient_sounds[i]=
					WorldAudioInfo::AmbientSound
					{
						.file_name= map_description.ambient_sound_files[i],
						.volume= volumes[i]
					};
			}
		}
	}

	return info;
}

class SpatialVolumeCalculator
{
public:
	fn constructor( GameMapData& map_data, PlayerState& player_state, CameraController& camera_controller )
		@( ust::reference_notation::pollution::param0_param_1_reference )
		(
			map_data_= map_data,
			camera_position_= GetCameraPositionForPlayerWithExtraDepthShift( player_state, camera_controller ),
			channel_vectors_[ Vec3f::MakeZero() ... ] // Set later.
		)
	{
		var Mat4f head_rotation_matrix=
			Mat4f::MakeRotationX( camera_controller.GetElevation() ) *
			Mat4f::MakeRotationZ( camera_controller.GetAzimuth() );

		// Use channel vectors slightly inclined to each other, not with exact 180 degree angle.
		// Doing so we ensure that sounds behind the player are somewhat quieter than sounds at front of him.
		var f32 channel_vectors_angle= c_tau * 0.42f;

		channel_vectors_=
			ust::make_array(
				Vec3f(
					ust::sin( -0.5f * channel_vectors_angle ),
					ust::cos( -0.5f * channel_vectors_angle ),
					0.0f ) * head_rotation_matrix,
				Vec3f(
					ust::sin(  0.5f * channel_vectors_angle ),
					ust::cos(  0.5f * channel_vectors_angle ),
					0.0f ) * head_rotation_matrix );
	}


	fn CalculateAmbientSoundVolumes( this ) : [ [ f32, 2 ], WorldAudioInfo::c_num_ambient_sounds ]
	{
		// Use a tricky approach here to calculate volumes if ambient sounds.
		// For each cluster having an ambient sound find an intersection box with a box around the camera.
		// For each channel vector and each its component find an approximate distance in this box
		// and multiply it by area of cross-section perpendicular to this component.
		//
		// Doing so allows achieving multiple goals:
		// * Staying deep inside within a cluster with ambient sound produces volume 1 for both channels.
		// * Staying on a border of a cluster with ambient sound produces volume less than 1 for a channel facing out of the cluster.
		// * Staying outside a cluster with ambient sound produces more volume for a channel pointing towards this cluster.
		// * Position to volume function is smooth.
		// * Camera orientation to volume function is smooth.
		// * Volume from multiple clusters is added together.
		// * Volume far away from a cluster with ambient sound is 0, which improves result mixing performance.

		var [ [ f32, 2 ], WorldAudioInfo::c_num_ambient_sounds ] mut volumes= zero_init;

		var f32 constexpr c_fetch_cube_half_size= 384.0f;

		var f32 constexpr c_min_meaningful_sounding_box_dimensions= 192.0f;
		var f32 constexpr c_min_meaningful_sounding_box_volume=
			c_min_meaningful_sounding_box_dimensions *
			c_min_meaningful_sounding_box_dimensions *
			c_min_meaningful_sounding_box_dimensions;

		var BBox3f fetch_bbox
		{
			.min= camera_position_ - Vec3f( c_fetch_cube_half_size, c_fetch_cube_half_size, c_fetch_cube_half_size ),
			.max= camera_position_ + Vec3f( c_fetch_cube_half_size, c_fetch_cube_half_size, c_fetch_cube_half_size ),
		};

		var ust::array_view_imut</ZvoxCluster/> clusters= map_data_.zvox_data.deref().clusters;
		var Vec3f& camera_position= camera_position_;
		var [ Vec3f, 2 ]& channel_vectors= channel_vectors_;

		VisitBoundingBoxesHierarchyForBBox(
			map_data_.room_clusters_hierarchy.deref(),
			fetch_bbox,
			lambda[&]( ClusterIndexInHierarchy cluster_index )
			{
				var ZvoxCluster& cluster= clusters[ size_type( cluster_index ) ];

				var i32 ambient_sound_index= cluster.ambient_sound_index + 256;
				if( ambient_sound_index < 0 | size_type( ambient_sound_index ) >= WorldAudioInfo::c_num_ambient_sounds )
				{
					return;
				}

				var [ f32, 2 ] &mut volume= volumes[ size_type( ambient_sound_index ) ];

				var BBox3f cluster_bbox= CreateClusterBBox( cluster );

				var BBox3f intersection_bbox
				{
					.min(
						ust::max( fetch_bbox.min.x, cluster_bbox.min.x ),
						ust::max( fetch_bbox.min.y, cluster_bbox.min.y ),
						ust::max( fetch_bbox.min.z, cluster_bbox.min.z ) ),
					.max(
						ust::min( fetch_bbox.max.x, cluster_bbox.max.x ),
						ust::min( fetch_bbox.max.y, cluster_bbox.max.y ),
						ust::min( fetch_bbox.max.z, cluster_bbox.max.z ) ),
				};

				var Vec3f intersection_bbox_dimensions= intersection_bbox.GetDimensions();

				if( intersection_bbox_dimensions.x <= 0.0f |
					intersection_bbox_dimensions.y <= 0.0f |
					intersection_bbox_dimensions.z <= 0.0f )
				{
					return;
				}

				var f32 intersection_box_volume=
					intersection_bbox_dimensions.x * intersection_bbox_dimensions.y * intersection_bbox_dimensions.z;

				// Apply extra scale for small clusters (with small volume), so that they are not too quiet.
				var f32 extra_scale= ust::max( 1.0f, c_min_meaningful_sounding_box_volume / intersection_box_volume );

				var Vec3f axis_areas_scaled(
					extra_scale * intersection_bbox_dimensions.y * intersection_bbox_dimensions.z,
					extra_scale * intersection_bbox_dimensions.x * intersection_bbox_dimensions.z,
					extra_scale * intersection_bbox_dimensions.x * intersection_bbox_dimensions.y );

				var f32 x_plus_distance=
					ust::max(
						0.0f,
						intersection_bbox.max.x - ust::max( intersection_bbox.min.x, camera_position.x ) );
				var f32 x_minus_distance=
					ust::max(
						0.0f,
						ust::min( intersection_bbox.max.x, camera_position.x ) - intersection_bbox.min.x );

				var f32 y_plus_distance=
					ust::max(
						0.0f,
						intersection_bbox.max.y - ust::max( intersection_bbox.min.y, camera_position.y ) );
				var f32 y_minus_distance=
					ust::max(
						0.0f,
						ust::min( intersection_bbox.max.y, camera_position.y ) - intersection_bbox.min.y );

				var f32 z_plus_distance=
					ust::max(
						0.0f,
						intersection_bbox.max.z - ust::max( intersection_bbox.min.z, camera_position.z ) );
				var f32 z_minus_distance=
					ust::max(
						0.0f,
						ust::min( intersection_bbox.max.z, camera_position.z ) - intersection_bbox.min.z );

				for( auto mut i= 0s; i < 2s; ++i )
				{
					var Vec3f& channel_vector= channel_vectors[i];

					// Square channel vector components to get 1 in sum.
					// Multiply them by the area of the box cross-section perpendicular to the each basis axis.
					var Vec3f weights(
						channel_vector.x * channel_vector.x * axis_areas_scaled.x,
						channel_vector.y * channel_vector.y * axis_areas_scaled.y,
						channel_vector.z * channel_vector.z * axis_areas_scaled.z );

					if( channel_vector.x >= 0.0f )
					{
						volume[i]+= weights.x * x_plus_distance;
					}
					else
					{
						volume[i]+= weights.x * x_minus_distance;
					}

					if( channel_vector.y >= 0.0f )
					{
						volume[i]+= weights.y * y_plus_distance;
					}
					else
					{
						volume[i]+= weights.y * y_minus_distance;
					}

					if( channel_vector.z >= 0.0f )
					{
						volume[i]+= weights.z * z_plus_distance;
					}
					else
					{
						volume[i]+= weights.z * z_minus_distance;
					}
				}
			} );

		{
			// Normalize result volume via dividing it by half volume (spatial) of a cube and scaling by some extra factor.
			var f32 volume_scale_extra= 8.0f;
			var f32 constexpr volume_scale=
				volume_scale_extra / ( c_fetch_cube_half_size * c_fetch_cube_half_size * c_fetch_cube_half_size * 4.0f );

			foreach( &mut volume_pair : volumes )
			{
				foreach( &mut value : volume_pair )
				{
					value*= volume_scale;
					ust::min_assign( value, 1.0f ); // Ensure maximum volume is one.
				}
			}
		}

		// Ensure that sum volume of all ambient sounds is not greater than one.
		for( auto mut i= 0s; i < 2s; ++i )
		{
			var f32 mut volume_sum= 0.0f;

			foreach( &volume_pair : volumes )
			{
				volume_sum+= volume_pair[i];
			}

			if( volume_sum > 1.0f )
			{
				var f32 normalization_scale= 1.0f / volume_sum;

				foreach( &mut volume_pair : volumes )
				{
					volume_pair[i]*= normalization_scale;
				}
			}
		}

		return volumes;
	}

	// Calculate volume at camera position for both channels.
	fn CalculatePointSoundSourceRelativeVolume( this, Vec3f& position, u8 absolute_volume ) : [ f32, 2 ]
	{
		var f32 c_min_distance= 0.1f;
		var f32 c_one_volume_distance= 256.0f;
		var f32 c_max_sound_distance= 3072.0f;
		var f32 c_small_volume_cut= c_one_volume_distance / c_max_sound_distance;
		var f32 c_max_volume= 1.0f;

		var Vec3f vector_to_sound_source= position - camera_position_;

		// Calculate clamped distance to avoid division by zero.
		var f32 distance= vector_to_sound_source.Length();
		var f32 distance_clamped= ust::max( distance, c_min_distance );

		// Use attenuation proportional to distance, not square distance.
		// Using inverse sqare law produces too quiet sounds.
		var f32 volume_distance_scaled=
			f32( absolute_volume ) / f32( 255.0f ) * c_one_volume_distance / distance_clamped;

		// Subtract some small value from result volume to force zero volume for distant sounds.
		// We need this to prevent playing sounds from the other end of the map (to save some CPU time).
		var f32 volume_with_distance_cut= ust::max( volume_distance_scaled - c_small_volume_cut, 0.0f );

		var [ f32, 2 ] channel_angle_cos
		[
			channel_vectors_[0].Dot( vector_to_sound_source ) / distance_clamped,
			channel_vectors_[1].Dot( vector_to_sound_source ) / distance_clamped,
		];

		// Calculate per-channel volume based on angle cosine between the direction to the source and the channel's vector.
		// If this angle is 180 degree, volume should be around zero (but not strictly zero).
		var [ f32, 2 ] channel_volumes
		[
			volume_with_distance_cut * ( channel_angle_cos[0] * 0.46f + 0.54f ),
			volume_with_distance_cut * ( channel_angle_cos[1] * 0.46f + 0.54f ),
		];

		// Make sure result volume isn't above maximum value.
		var [ f32, 2 ] channel_volumes_clamped
		[
			ust::min( channel_volumes[0], c_max_volume ),
			ust::min( channel_volumes[1], c_max_volume ),
		];

		return channel_volumes_clamped;
	}

private:
	GameMapData& map_data_;
	Vec3f camera_position_;
	[ Vec3f, 2 ] channel_vectors_;
}

} // namespace PM
