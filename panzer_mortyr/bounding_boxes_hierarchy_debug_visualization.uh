import "bounding_boxes_hierarchy.uh"
import "debug_visualization.uh"

namespace PM
{

template</type ElementType/>
fn CreateBoundingBoxesHierarchyLines(
	BoundingBoxesHierarchy</ElementType/>& hierarchy,
	size_type depth_to_show,
	ust::vector</ WorldDrawingInfo::TestLine /> &mut out_lines )
{
	CreateBoundingBoxesHierarchyLines_r( hierarchy, depth_to_show, 0s, 0u, out_lines );
}

template</type ElementType/>
fn CreateBoundingBoxesHierarchyLines_r(
	BoundingBoxesHierarchy</ElementType/>& hierarchy,
	size_type depth_to_show,
	size_type depth,
	u32 node_index,
	ust::vector</ WorldDrawingInfo::TestLine /> &mut out_lines )
{
	type HierarchyT= BoundingBoxesHierarchy</ElementType/>;

	var HierarchyT::Node& node= hierarchy.nodes[ size_type( node_index ) ];

	auto& color= c_bounding_box_hierarchy_colors[ depth % typeinfo</ typeof(c_bounding_box_hierarchy_colors ) />.element_count ];

	if( depth == depth_to_show | depth == depth_to_show + 1s )
	{
		CreateBBoxLines( node.bbox, color, out_lines );
	}

	if_var( &branch_node_contents : node.contents.get</HierarchyT::BranchNodeContents/>() )
	{
		if( depth == depth_to_show )
		{
			foreach( child_node_index : branch_node_contents.children_nodes )
			{
				var HierarchyT::Node& child_node= hierarchy.nodes[ size_type( child_node_index ) ];

				out_lines.push_back(
					WorldDrawingInfo::TestLine
					{
						.vertices
						[
							0.5f * ( node.bbox.min + node.bbox.max ),
							0.5f * ( child_node.bbox.min + child_node.bbox.max ),
						],
						.color= color,
					} );
			}
		}

		foreach( child_node_index : branch_node_contents.children_nodes )
		{
			CreateBoundingBoxesHierarchyLines_r( hierarchy, depth_to_show, depth + 1s, child_node_index, out_lines );
		}
	}
	else if_var( &leaf_node_contents : node.contents.get</HierarchyT::LeafNodeContents/>() )
	{
		ust::ignore_unused( leaf_node_contents );
	}
	else{ halt; }
}

template</type ElementType/>
fn CreateLinesForPositionInBoundingBoxesHierarchy(
	BoundingBoxesHierarchy</ElementType/>& hierarchy,
	Vec3f& pos,
	ust::vector</ WorldDrawingInfo::TestLine /> &mut out_lines )
{
	CreateLinesForPositionInBoundingBoxesHierarchy_r( hierarchy, pos, 0u, 0s, out_lines );
}

template</type ElementType/>
fn CreateLinesForPositionInBoundingBoxesHierarchy_r(
	BoundingBoxesHierarchy</ElementType/>& hierarchy,
	Vec3f& pos,
	u32 node_index,
	size_type depth,
	ust::vector</ WorldDrawingInfo::TestLine /> &mut out_lines )
{
	type HierarchyT= BoundingBoxesHierarchy</ElementType/>;

	var HierarchyT::Node& node= hierarchy.nodes[ size_type( node_index ) ];

	if( !node.bbox.PointIsInsideOrOnFace( pos ) )
	{
		return;
	}

	auto& color= c_bounding_box_hierarchy_colors[ depth % typeinfo</ typeof( c_bounding_box_hierarchy_colors ) />.element_count ];
	CreateBBoxLines( node.bbox, color, out_lines );

	if_var( &branch_node_contents : node.contents.get</HierarchyT::BranchNodeContents/>() )
	{
		foreach( child_node_index : branch_node_contents.children_nodes )
		{
			CreateLinesForPositionInBoundingBoxesHierarchy_r( hierarchy, pos, child_node_index, depth + 1s, out_lines );
		}
	}
	else if_var( &leaf_node_contents : node.contents.get</HierarchyT::LeafNodeContents/>() )
	{
		ust::ignore_unused(leaf_node_contents);
	}
	else{ halt; }
}

var [ [ u8, 3 ], 9 ] c_bounding_box_hierarchy_colors
[
	[ (255), (  0), (  0) ],
	[ (170), ( 85), (  0) ],
	[ ( 85), (170), (  0) ],
	[ (  0), (255), (  0) ],
	[ (  0), (170), ( 85) ],
	[ (  0), ( 85), (170) ],
	[ (  0), (  0), (255) ],
	[ ( 85), (  0), (170) ],
	[ (170), (  0), ( 85) ],
];

} // namespace PM
