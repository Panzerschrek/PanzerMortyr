import "gl_functions.iu"

namespace PM
{

fn InitializeGLFunctionPointers()
{
	InitializeGLFunctionPointer</ "glActiveTexture" />();
	InitializeGLFunctionPointer</ "glAttachShader" />();
	InitializeGLFunctionPointer</ "glBindBuffer" />();
	InitializeGLFunctionPointer</ "glBindTexture" />();
	InitializeGLFunctionPointer</ "glBindVertexArray" />();
	InitializeGLFunctionPointer</ "glBlendFunc" />();
	InitializeGLFunctionPointer</ "glBufferData" />();
	InitializeGLFunctionPointer</ "glBufferSubData" />();
	InitializeGLFunctionPointer</ "glClear" />();
	InitializeGLFunctionPointer</ "glClearColor" />();
	InitializeGLFunctionPointer</ "glColorMask" />();
	InitializeGLFunctionPointer</ "glCopyTexImage2D" />();
	InitializeGLFunctionPointer</ "glCompileShader" />();
	InitializeGLFunctionPointer</ "glCreateProgram" />();
	InitializeGLFunctionPointer</ "glCreateShader" />();
	InitializeGLFunctionPointer</ "glCullFace" />();
	InitializeGLFunctionPointer</ "glDebugMessageCallback" />();
	InitializeGLFunctionPointer</ "glDeleteBuffers" />();
	InitializeGLFunctionPointer</ "glDeleteVertexArrays" />();
	InitializeGLFunctionPointer</ "glDeleteProgram" />();
	InitializeGLFunctionPointer</ "glDeleteShader" />();
	InitializeGLFunctionPointer</ "glDeleteTextures" />();
	InitializeGLFunctionPointer</ "glDepthFunc" />();
	InitializeGLFunctionPointer</ "glDepthMask" />();
	InitializeGLFunctionPointer</ "glDisable" />();
	InitializeGLFunctionPointer</ "glDrawArrays" />();
	InitializeGLFunctionPointer</ "glDrawElements" />();
	InitializeGLFunctionPointer</ "glDrawElementsBaseVertex" />();
	InitializeGLFunctionPointer</ "glEnable" />();
	InitializeGLFunctionPointer</ "glEnableVertexAttribArray" />();
	InitializeGLFunctionPointer</ "glGetString" />();
	InitializeGLFunctionPointer</ "glGenBuffers" />();
	InitializeGLFunctionPointer</ "glGenTextures" />();
	InitializeGLFunctionPointer</ "glGenerateMipmap" />();
	InitializeGLFunctionPointer</ "glGenVertexArrays" />();
	InitializeGLFunctionPointer</ "glGetActiveUniform" />();
	InitializeGLFunctionPointer</ "glGetProgramiv" />();
	InitializeGLFunctionPointer</ "glGetProgramInfoLog" />();
	InitializeGLFunctionPointer</ "glGetShaderiv" />();
	InitializeGLFunctionPointer</ "glGetShaderInfoLog" />();
	InitializeGLFunctionPointer</ "glGetUniformLocation" />();
	InitializeGLFunctionPointer</ "glLinkProgram" />();
	InitializeGLFunctionPointer</ "glPointSize" />();
	InitializeGLFunctionPointer</ "glPolygonMode" />();
	InitializeGLFunctionPointer</ "glScissor" />();
	InitializeGLFunctionPointer</ "glShaderSource" />();
	InitializeGLFunctionPointer</ "glTexImage2D" />();
	InitializeGLFunctionPointer</ "glTexImage3D" />();
	InitializeGLFunctionPointer</ "glTexSubImage3D" />();
	InitializeGLFunctionPointer</ "glTexSubImage3D" />();
	InitializeGLFunctionPointer</ "glTexParameterf" />();
	InitializeGLFunctionPointer</ "glTexParameteri" />();
	InitializeGLFunctionPointer</ "glUniformMatrix4fv" />();
	InitializeGLFunctionPointer</ "glUniform1i" />();
	InitializeGLFunctionPointer</ "glUniform1f" />();
	InitializeGLFunctionPointer</ "glUniform2f" />();
	InitializeGLFunctionPointer</ "glUniform3f" />();
	InitializeGLFunctionPointer</ "glUniform4f" />();
	InitializeGLFunctionPointer</ "glUseProgram" />();
	InitializeGLFunctionPointer</ "glVertexAttribPointer" />();
}

template</ [ char8, S ] name, size_type S />
fn InitializeGLFunctionPointer()
{
	unsafe
	{
		// Use a helper function and pass to it a null-terminated static string.
		// Doing so we enable compiler optimization for null-terminated string literal usage.
		var $(byte8) mut ptr= GetGLFunctionPointer</ name + "\0" />();

		// It's not undefined behavior to use "memory_copy" to write raw pointer value into a variable of function pointer type.
		ust::memory_copy(
			ust::ptr_cast_to_byte8( $<( mixin( name ) ) ),
			ust::ptr_cast_to_byte8( $<( ptr ) ),
			typeinfo</ $(byte8) />.size_of );
	}
}

template</ [ char8, S ] name_null_terminated, size_type S />
fn GetGLFunctionPointer() unsafe : $(byte8)
{
	static_assert( name_null_terminated[ typeinfo</ typeof(name_null_terminated) />.element_count - 1s ] == '\0' );
	return unsafe( SDL_GL_GetProcAddress( $<( cast_mut( name_null_terminated[0] ) ) ) );
}

} // namespace PM
