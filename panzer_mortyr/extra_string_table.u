import "extra_string_table.iu"

namespace PM
{

fn FetchStringFromExtraTable( RegionalVersion regional_version, ExtraStringTableKey key ) : ust::string_view8
{
	switch( regional_version )
	{
	RegionalVersion::English -> { return FetchStringFromExtraTableEnglish( key ); },
	RegionalVersion::Polish -> { return FetchStringFromExtraTablePolish( key ); },
	}
}

fn FetchStringFromExtraTableEnglish( ExtraStringTableKey key ) : ust::string_view8
{
	switch( key )
	{
	ExtraStringTableKey::Fullscreen -> { return "fullscreen"; },
	ExtraStringTableKey::Display -> { return "display"; },
