import "extra_string_table.iu"

namespace PM
{

fn FetchStringFromExtraTable( ExtraStringTableKey key ) : ust::string_view8
{
	// TODO - provide also polish versions of these strings, or maybe even more (german, russian).

	switch( key )
	{
	ExtraStringTableKey::Fullscreen -> { return "fullscreen: "; },
	ExtraStringTableKey::Display -> { return "display: "; },
	ExtraStringTableKey::Mode -> { return "mode: "; },
	ExtraStringTableKey::AutoMode -> { return "auto"; },
	ExtraStringTableKey::VerticalSynchronization -> { return "vertical synchronization: "; },
	ExtraStringTableKey::ChangesWillBeAppliedAfterGameRestart -> { return "changes will be applied after game restart"; },
	ExtraStringTableKey::WalkForward -> { return "walk forward"; },
	ExtraStringTableKey::Backpedal -> { return "walk forward"; },
	ExtraStringTableKey::StepLeft -> { return "step left"; },
	ExtraStringTableKey::StepRight -> { return "step right"; },
	}
}

} // namespace PM
