import "extra_string_table.iu"

namespace PM
{

fn FetchStringFromExtraTable( ExtraStringTableKey key ) : ust::string_view8
{
	// TODO - provide also polish versions of these strings, or maybe even more (german, russian).

	switch( key )
	{
	ExtraStringTableKey::Fullscreen -> { return "fullscreen: "; },
	ExtraStringTableKey::Display -> { return "display: "; },
	ExtraStringTableKey::Mode -> { return "mode: "; },
	ExtraStringTableKey::AutoMode -> { return "auto"; },
	ExtraStringTableKey::VerticalSynchronization -> { return "vertical synchronization: "; },
	ExtraStringTableKey::ChangesWillBeAppliedAfterGameRestart -> { return "changes will be applied after game restart"; },
	ExtraStringTableKey::WalkForward -> { return "walk forward"; },
	ExtraStringTableKey::Backpedal -> { return "backpedal"; },
	ExtraStringTableKey::StepLeft -> { return "step left"; },
	ExtraStringTableKey::StepRight -> { return "step right"; },
	ExtraStringTableKey::Jump -> { return "jump"; },
	ExtraStringTableKey::Crouch -> { return "crouch"; },
	ExtraStringTableKey::TurnLeft -> { return "turn left"; },
	ExtraStringTableKey::TurnRight -> { return "turn right"; },
	ExtraStringTableKey::LookUp -> { return "look up"; },
	ExtraStringTableKey::LookDown -> { return "look down"; },
	ExtraStringTableKey::Kick -> { return "kick"; },
	ExtraStringTableKey::Weapon1 -> { return "weapon 1"; },
	ExtraStringTableKey::Weapon2 -> { return "weapon 2"; },
	ExtraStringTableKey::Weapon3 -> { return "weapon 3"; },
	ExtraStringTableKey::Weapon4 -> { return "weapon 4"; },
	ExtraStringTableKey::Weapon5 -> { return "weapon 5"; },
	ExtraStringTableKey::Weapon6 -> { return "weapon 6"; },
	ExtraStringTableKey::Weapon7 -> { return "weapon 7"; },
	ExtraStringTableKey::Weapon8 -> { return "weapon 8"; },
	ExtraStringTableKey::Weapon9 -> { return "weapon 9"; },
	ExtraStringTableKey::Weapon10 -> { return "weapon 10"; },
	ExtraStringTableKey::Weapon11 -> { return "weapon 11"; },
	ExtraStringTableKey::UseItem -> { return "use item"; },
	ExtraStringTableKey::NextItem -> { return "next item"; },
	ExtraStringTableKey::PrevItem -> { return "prev item"; },
	ExtraStringTableKey::AcidProtectionSuit -> { return "acid protection suit"; },
	ExtraStringTableKey::NightVision -> { return "night vision"; },
	ExtraStringTableKey::InfraredVision -> { return "infrared vision"; },
	ExtraStringTableKey::Flashlight -> { return "flashlight"; },
	}
}

} // namespace PM
