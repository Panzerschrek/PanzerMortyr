import "/file.iu"
import "/shared_atomic_variable.iu"
import "/thread.iu"
import "audio_stream.iu"
import "console_out.iu"

namespace PM
{

class MusicStreamer
{
public:
	fn constructor( ust::filesystem_path_view data_directory, ConsoleOutPtr mut console_out );

	fn Play( mut this, u32 track_index ) : ust::optional</ AudioStream::ReadEnd />;

private:
	type TrackFileNames= [ ust::filesystem_path, 10 ];

	struct ActiveTrack
	{
		ust::file_readable file;
		u32 sample_pairs_left;
		AudioStream::WriteEnd stream_write_end;
	}

	struct MusicReaderThreadFunction
	{
		ActiveTrack active_track;
		ust::shared_atomic_variable</bool/> stop_flag;

		op()( byval this );
	}

	class MusicReaderThread
	{
	public:
		fn constructor( ActiveTrack active_track );
		fn destructor();

	private:
		ust::thread</ MusicReaderThreadFunction, void /> thread_;
		ust::shared_atomic_variable</bool/> stop_flag_;
	}

private:
	fn SearchForTracks( ust::filesystem_path_view data_directory, ConsoleOutPtr& console_out ) : TrackFileNames;

private:
	TrackFileNames imut track_file_names_;
	ConsoleOutPtr imut console_out_;

	ust::optional</ MusicReaderThread /> music_reader_thread_;
}

} // namespace PM
