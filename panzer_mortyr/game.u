import "/string_conversions.u"
import "collisions.uh"
import "bounding_boxes_hierarchy_debug_visualization.uh"
import "game.uh"
import "game_constants.uh"
import "game_logic.uh"
import "geometry_utils.uh"

namespace PM
{

fn Game::constructor(
	SettingsPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader_ptr,
	ConsoleOutPtr mut console_out )
	(
		settings_= move(settings),
		console_out_= move(console_out),
		global_data_= LoadGlobalData( caching_game_resources_loader_ptr ),
		caching_game_resources_loader_ptr_= move( caching_game_resources_loader_ptr ),
		camera_controller_( 0.0f ),
		prev_time_steps_= 0.0f,
	)
{
}

fn Game::StartNewGame( mut this, u32 skill )
{
	var u32 start_map= global_data_.game_params.deref().start_map;
	TeleportToMap( start_map, skill );
}

fn Game::TeleportToMap( mut this, u32 map_index, u32 skill )
{
	if( map_index == 0u )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Can't go to map 0!" ) );
		return;
	}

	if( map_data_.empty() || map_index != map_data_.try_deref().map_index )
	{
		// Load map data if teleporting to a map different from current one.

		map_data_.reset();

		var MapsDescription& maps_description= global_data_.maps_description.deref();

		if( size_type(map_index) >= maps_description.maps.size() )
		{
			ConsoleOutAddTextLine( console_out_, ust::concat( "Map with index ", ust::to_string8( map_index ), " not found!" ) );
			return;
		}

		var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type( map_index ) ];

		auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
		var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

		// Some maps don't specify entities description file name.
		// In such case use some default value.
		var ResourceString& entities_info_file=
			( map_description.entities_info_file[0] == '\0'
				? c_default_entities_description_file_name
				: map_description.entities_info_file );

		var GameResourcePtr</EntitiesDescription/> entities_description_ptr=
			caching_game_resources_loader.LoadEntitiesDescription( entities_info_file );

		var GameResourceNullablePtr</ZmapData/> zmap_data_nullable= caching_game_resources_loader.LoadZmapFile( map_index );
		var GameResourceNullablePtr</ZvoxData/> zvox_data_nullable= caching_game_resources_loader.LoadZvoxFile( map_index );
		var GameResourceNullablePtr</ZpozData/> zpoz_data_nullable= caching_game_resources_loader.LoadZpozFile( map_index );
		var GameResourceNullablePtr</MapaWayData/> mapa_way_data_nullable= caching_game_resources_loader.LoadMapaWayFile( map_index );
		var GameResourceNullablePtr</RoomClustersHierarchy/> room_clusters_hierarchy_nullable= caching_game_resources_loader.LoadRoomClustersHierarchy( map_index );

		if( zmap_data_nullable.empty() ||
			zvox_data_nullable.empty() ||
			zpoz_data_nullable.empty() ||
			mapa_way_data_nullable.empty() ||
			room_clusters_hierarchy_nullable.empty() )
		{
			return;
		}

		var GameResourcePtr</ZvoxData/> mut zvox_data= zvox_data_nullable.try_to_non_nullable();
		var GameResourcePtr</ZmapData/> mut zmap_data= zmap_data_nullable.try_to_non_nullable();

		map_data_=
			GameMapData
			{
				.map_index= map_index,
				.entities_description= entities_description_ptr,
				.collider_quads_hierarchy= BuildColliderQuadsHierarchy( zvox_data.deref().clusters, zmap_data.deref().quads ),
				.room_clusters_hierarchy= room_clusters_hierarchy_nullable.try_to_non_nullable(),
				.zmap_data= move(zmap_data),
				.zvox_data= move(zvox_data),
				.zpoz_data= zpoz_data_nullable.try_to_non_nullable(),
				.mapa_way_data= mapa_way_data_nullable.try_to_non_nullable(),
			};
	}

	// Reset game state.

	prev_time_steps_= 0.0f;

	game_state_= CreateNewMapGameState( map_data_.try_deref(), skill );

	// Reset possible rotation and movement state.
	camera_controller_= CameraController( game_state_.try_deref().player.azimuth );
	player_movement_controller_.Reset();
	player_tool_controller_.Reset();
}

fn Game::Update(
	mut this,
	f32 time_delta_s,
	ust::array_view_imut</bool/> keyboard_state,
	u32 mouse_state,
	[ i32, 2 ] mouse_motion )
{
	// Rotate camera each frame.
	camera_controller_.Update( time_delta_s, keyboard_state, mouse_state, mouse_motion );

	// Accumulate movement input each frame.
	player_movement_controller_.Update(  time_delta_s, keyboard_state );

	// Process tool requests each frame.
	player_tool_controller_.Update( keyboard_state, mouse_state );

	// Process game logic in fixed time steps.

	var f32 cur_time_steps= prev_time_steps_ + time_delta_s * c_steps_per_second;

	var u32 prev_step= u32( prev_time_steps_ );
	var u32 cur_step= u32( cur_time_steps );

	var u32 num_steps_to_process=
		( settings_.lock_imut().deref().g_debug_sync_game_logic_steps
			? 1u
			// Avoid processing too much steps at once (in case of process topeed via debugger).
			: ust::min( 5u, cur_step - prev_step ) );

	if( num_steps_to_process > 0u )
	{
		if( !map_data_.empty() && !game_state_.empty() )
		{
			var GameMapData& map_data= map_data_.try_deref();
			var GameState &mut game_state= game_state_.try_deref();

			var PlayerInput player_input
			{
				.azimuth= camera_controller_.GetAzimuth(),
				.elevation= camera_controller_.GetElevation(),
				.move_wish_vector= player_movement_controller_.GetAccumulatedMoveWishVector(),
				.jump_requested= player_movement_controller_.GetJumpRequested(),
				.requested_weapon= player_tool_controller_.GetRequestedWeapon(),
				.shot_requested= player_tool_controller_.GetShotRequested(),
			};

			player_movement_controller_.Reset();
			player_tool_controller_.Reset();

			for( auto mut i= 0u; i < num_steps_to_process; ++i )
			{
				ProcessGameLogicStep( global_data_, map_data, player_input, game_state );
			}
		}
	}

	prev_time_steps_= cur_time_steps;
}

fn Game::ProcessMouseButtonPress( mut this, u32 button_index )
{
	if( button_index == 2u )
	{
		// Debug ray intersection code.
		// TODO - move it somewhere else.
		if( map_data_.empty() || game_state_.empty() )
		{
			return;
		}

		var GameMapData& map_data= map_data_.try_deref();
		var GameState& game_state= game_state_.try_deref();

		var f32 azimuth= camera_controller_.GetAzimuth();
		var f32 elevation= camera_controller_.GetElevation();

		var f32 elevation_cos= ust::cos(elevation);
		var f32 elevation_sin= ust::sin(elevation);

		var Vec3f direction_vector= 16384.0f * Vec3f( -ust::sin(azimuth) * elevation_cos, ust::cos(azimuth) * elevation_cos, elevation_sin );

		var Vec3f ray_start= GetCameraPositionForPlayer( game_state.player );

		var ZmapData& zmap_data= map_data.zmap_data.deref();
		var ZvoxData& zvox_data= map_data.zvox_data.deref();

		test_sprites_.clear();

		if_var( line_trace_result : LineTrace( map_data, game_state.dynamic_cluster_colliders, ray_start, direction_vector ) )
		{
			var Vec3f closest_intersection_point= ray_start + direction_vector * line_trace_result.distance;

			test_sprites_.push_back( closest_intersection_point );

			auto& center= zvox_data.clusters[ size_type( line_trace_result.cluster_index ) ].c.center;
			auto& in_vertices= zmap_data.quads[ size_type( line_trace_result.quad_index ) ].vertices;

			var [ Vec3f, 4 ] vertices
			[
				Vec3f( f32( center[0] + i32( in_vertices[0][0] ) ), f32( center[1] + i32( in_vertices[0][1] ) ), f32( center[2] + i32( in_vertices[0][2] ) ) ),
				Vec3f( f32( center[0] + i32( in_vertices[1][0] ) ), f32( center[1] + i32( in_vertices[1][1] ) ), f32( center[2] + i32( in_vertices[1][2] ) ) ),
				Vec3f( f32( center[0] + i32( in_vertices[2][0] ) ), f32( center[1] + i32( in_vertices[2][1] ) ), f32( center[2] + i32( in_vertices[2][2] ) ) ),
				Vec3f( f32( center[0] + i32( in_vertices[3][0] ) ), f32( center[1] + i32( in_vertices[3][1] ) ), f32( center[2] + i32( in_vertices[3][2] ) ) ),
			];

			var CompactPolyhedron mut polyhedron
			{
				.num_planes= 0u,
				.primary_planes_mask= 0u,
				.planes[ { .normal= Vec3f::MakeZero(), .distance= 0.0f } ... ],
			};

			CreateBBoxAndQuadMinkowskiSum( GetPlayerColliderBBox( map_data.entities_description.deref() ), vertices, polyhedron );
			if( polyhedron.num_planes >= 4u )
			{
				test_triangles_.clear();
				PolygonizePolyhedron( ust::array_view_imut</Planef/>( polyhedron.planes ).subrange_end( size_type( polyhedron.num_planes ) ), test_triangles_ );
			}
		}
	}
}

fn Game::GetWorldDrawingInfo( this ) : WorldDrawingInfo
{
	var WorldDrawingInfo mut drawing_info
	{
		.game_time_s= prev_time_steps_ / f32( c_steps_per_second ),
		.map_index= 0u,
		.camera_params
		{
			.position= Vec3f::MakeZero(),
			.azimuth= camera_controller_.GetAzimuth(),
			.elevation= camera_controller_.GetElevation(),
			.fov_x= camera_controller_.GetFOV(),
		},
		.test_sprites= test_sprites_,
		.test_triangles= test_triangles_,
	};

	if( !map_data_.empty() && !game_state_.empty() )
	{
		var GameMapData& map_data= map_data_.try_deref();
		var GameState& game_state= game_state_.try_deref();

		drawing_info.map_index= map_data.map_index;
		drawing_info.camera_params.position= GetCameraPositionForPlayer( game_state.player );

		var EntitiesDescription& entities_description= map_data.entities_description.deref();

		foreach( &entity_opt : game_state.entities )
		{
			if( entity_opt.empty() )
			{
				continue;
			}

			var EntityState& entity= entity_opt.try_deref();

			var EntitiesDescription::EntityDescription& entity_description= entities_description.entities[ size_type( entity.kind ) ];

			if( size_type( entity.current_operation ) >= entity_description.operations.size() )
			{
				continue;
			}

			var EntitiesDescription::Operation& operation= entity_description.operations[ size_type( entity.current_operation ) ];

			foreach( pair :
				ust::array_view_imut</EntitiesDescription::OperationAnimationDescription/>( operation.animations ).iter().zip(
					ust::array_view_imut</u32/>( entity.animation_frames ).iter() ) )
			{
				var EntitiesDescription::OperationAnimationDescription& operation_animation_description= pair.first;

				if( operation_animation_description.num_steps == 0u )
				{
					continue;
				}

				var size_type a( operation_animation_description.animation_number );
				if( a >= entities_description.animations.size() )
				{
					continue;
				}
				var EntitiesDescription::AnimationDescription& animation= entities_description.animations[a];

				var bool is_sky_decoration=
					operation.animations[ size_type( EntitiesDescription::Operation::AnimationKind::Landscape ) ].num_steps != 0u;

				drawing_info.model_objects.push_back(
					WorldDrawingInfo::ModelObject
					{
						.model_file_name= animation.model_file_name,
						.position= entity.position,
						.azimuth= entity.azimuth,
						.elevation= 0.0f,
						.frame= pair.second,
						// If it's a sky decoration - disable culling.
						// It should be always visible, even if such decoration is located somewhere outside map bounds.
						.disable_culling= is_sky_decoration,
						.first_person_weapon= false,
						// Use constant lighting for sky decorations.
						.constant_lighting= is_sky_decoration,
					} );
				}
		}

		foreach( &projectile : game_state.projectiles )
		{
			var size_type weapon_tool_index(
				entities_description.tool_type_to_index_map[ size_type( projectile.weapon ) ] );
			if( weapon_tool_index < entities_description.tools.size() )
			{
				var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

				if( tool.projectile_model >= 2000 )
				{
					// Projectiles for this weapon are drawn via a model.
					var size_type animation_index( tool.projectile_model - 2000 );
					if( animation_index < entities_description.animations.size() )
					{
						var EntitiesDescription::AnimationDescription& animation= entities_description.animations[ animation_index ];

						// Calculate orientation based on velocity vector.
						// It isn't ideal, but fine enough.
						var f32 mut azimuth= 0.0f;
						var f32 mut elevation= 0.0f;
						var f32 velocity_xy_square_length= projectile.velocity.xy().SquareLength();
						if( velocity_xy_square_length > 0.0f )
						{
							 azimuth= -ust::atan2( projectile.velocity.x, projectile.velocity.y );
							 elevation= ust::atan2( projectile.velocity.z, ust::sqrt( velocity_xy_square_length ) );
						}
						else
						{
							elevation= ( projectile.velocity.z > 0.0f ? c_tau * 0.25f : -c_tau * 0.25f );
						}

						drawing_info.model_objects.push_back(
							WorldDrawingInfo::ModelObject
							{
								.model_file_name= animation.model_file_name,
								.position= projectile.position,
								.azimuth= azimuth,
								.elevation= elevation,
								.frame= 0u,
								// Disable culling for projectiles - allow drawing them in skies.
								.disable_culling= true,
								.first_person_weapon= false,
								.constant_lighting= false,
							} );
					}
				}
				else
				{
					// TODO - remove this hardcode.
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCustomAxis,
							.position= projectile.position,
							.custom_axis= projectile.velocity,
							.billboard_index= 163u,
						} );
				}
			}
		}

		foreach( &bullet_hole : game_state.bullet_holes )
		{
			// TODO - draw bullet holes properly.
			drawing_info.test_sprites.push_back( bullet_hole );
		}

		{
			var size_type weapon_tool_index(
				entities_description.tool_type_to_index_map[ size_type( game_state.player.weapon_state.current_weapon ) ] );
			if( weapon_tool_index < entities_description.tools.size() )
			{
				var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];
				if( size_type( tool.animation ) < entities_description.animations.size() )
				{
					var EntitiesDescription::AnimationDescription& animation=
						entities_description.animations[ size_type( tool.animation ) ];

					// Lower the weapon model if performing weapon switching.
					// TODO - tune this angle.
					var f32 elevation_add=
						c_tau / 6.0f *
						( 1.0f - f32( game_state.player.weapon_state.switching_fraction ) / f32( c_weapon_switching_half_time_steps ) );

					drawing_info.model_objects.push_back(
						WorldDrawingInfo::ModelObject
						{
							.model_file_name= animation.model_file_name,
							.position= drawing_info.camera_params.position,
							.azimuth= camera_controller_.GetAzimuth(),
							.elevation= camera_controller_.GetElevation() + elevation_add,
							.frame= game_state.player.weapon_state.current_animation_step / c_num_steps_per_animation_frame,
							.disable_culling= true,
							.first_person_weapon= true,
							.constant_lighting= false,
						} );
				}
			}
		}

		var ZvoxData& zvox_data= map_data.zvox_data.deref();
		auto clusters= zvox_data.clusters.range();

		foreach( pair : game_state.dynamic_clusters.iter().zip( game_state.dynamic_cluster_colliders.iter() ) )
		{
			var ZvoxCluster& cluster= clusters[ size_type( pair.second.cluster_index ) ];

			var Vec3f translation=
				pair.second.bbox.GetCenter() -
				Vec3f( f32( cluster.c.center[0] ), f32( cluster.c.center[1] ), f32( cluster.c.center[2] ) );

			drawing_info.dynamic_cluster_objects.push_back(
				WorldDrawingInfo::DynamicClusterObject
				{
					.cluster_index= pair.second.cluster_index,
					.translation= translation,
				} );
		}

		// Create billboards for map light sources.
		foreach( &cluster : clusters )
		{
			if( cluster.light_sources_begin >= cluster.light_sources_end )
			{
				continue;
			}

			foreach( &light_source : zvox_data.light_sources.range().subrange(
				size_type( cluster.light_sources_begin ), size_type( cluster.light_sources_end ) ) )
			{
				var u32 billboard_kind = u32( light_source.packed_corona_color_index ) & 7u;

				if( billboard_kind == 0u )
				{
					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.position(
								f32( cluster.c.center[0] + light_source.offset[0] ),
								f32( cluster.c.center[1] + light_source.offset[1] ),
								f32( cluster.c.center[2] + light_source.offset[2] ) ),
							.billboard_index= 95u,
							.alignment= WorldDrawingInfo::Billboard::Alignment::ToCamera,
							.custom_axis= Vec3f::MakeZero(),
						} );
				}
				else if( billboard_kind == 3u )
				{
					var u32 billboard_flame0= 113u;
					// TODO - tune animation speed.
					var u32 phase= u32( prev_time_steps_ * ( 16.0f / c_steps_per_second ) ) % 24u;

					drawing_info.billboards.push_back(
						WorldDrawingInfo::Billboard
						{
							.position(
								f32( cluster.c.center[0] + light_source.offset[0] ),
								f32( cluster.c.center[1] + light_source.offset[1] ),
								f32( cluster.c.center[2] + light_source.offset[2] ) ),
							.billboard_index= billboard_flame0 + phase,
							.alignment= WorldDrawingInfo::Billboard::Alignment::ZAxis,
							.custom_axis= Vec3f::MakeZero(),
						} );
				}
			}
		}

		if( settings_.lock_imut().deref().g_debug_show_entity_bounding_boxes )
		{
			var [ u8, 3 ] color[ (255), (0), (255) ];

			foreach( &collider : game_state.colliders )
			{
				CreateBBoxLines( collider.bbox, color, drawing_info.test_lines );
			}
		}

		if( settings_.lock_imut().deref().g_debug_highlight_enemies_seeing_player )
		{
			var [ u8, 3 ] color[ (0), (0), (255) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( entity.player_is_in_sight )
					{
						if( entity.collider_index != ~0u )
						{
							CreateBBoxLines(
								game_state.colliders[ size_type( entity.collider_index ) ].bbox,
								color,
								drawing_info.test_lines );
						}
					}
				}
			}
		}

		if( settings_.lock_imut().deref().g_debug_show_entity_target_navigation_graph_nodes )
		{
			auto& navigation_graphs= map_data.mapa_way_data.deref().navigation_graphs;

			var [ u8, 3 ] color[ (240), (120), (255) ];

			foreach( &entity_opt : game_state.entities )
			{
				if_var( &entity : entity_opt )
				{
					if( size_type( entity.navigation_info_index ) < navigation_graphs.size() &&
						entity.target_navigation_graph_node != ~0u )
					{
						var MapaWayNavigationGraph& navigation_graph=
							navigation_graphs[ size_type( entity.navigation_info_index ) ];

						{
							var MapaWayNavigationGraphNode& target_node=
								navigation_graph.nodes[ entity.target_navigation_graph_node ];

							var Vec3f target_node_position(
								f32( target_node.position[0] ),
								f32( target_node.position[1] ),
								f32( target_node.position[2] ) );

							CreateBBoxLines(
								BBox3f
								{
									.min= target_node_position + Vec3f( -4.0f, -4.0f, -4.0f ),
									.max= target_node_position + Vec3f(  4.0f,  4.0f,  4.0f ),
								},
								color,
								drawing_info.test_lines );
						}

						if( entity.current_navigation_graph_node < navigation_graph.num_nodes )
						{
							var Vec3f mut previous_position( entity.position.xy(), entity.position.z - 1.0f );

							for( var u32 mut i= 0u, mut node_index= entity.current_navigation_graph_node;
								i < u32( MapaWayNavigationGraph::c_max_nodes ); // Limit this loop in case of buggy routing matrices.
								++i )
							{
								if( node_index == entity.target_navigation_graph_node )
								{
									break;
								}

								var u32 next_node_index(
									navigation_graph.routing_matrix[ node_index ][ entity.target_navigation_graph_node ] );

								if( next_node_index >= navigation_graph.num_nodes )
								{
									break;
								}

								var MapaWayNavigationGraphNode& node= navigation_graph.nodes[ next_node_index ];

								var Vec3f node_position(
									f32( node.position[0] ), f32( node.position[1] ), f32( node.position[2] ) );

								drawing_info.test_lines.push_back(
									WorldDrawingInfo::TestLine
									{
										.vertices[ previous_position, node_position ],
										.color= color,
									} );

								previous_position= node_position;
								node_index= next_node_index;
							}
						}
					}
				}
			}
		}

		if( settings_.lock_imut().deref().g_debug_show_quads_hierarchy )
		{
			CreateBoundingBoxesHierarchyLines(
				map_data.collider_quads_hierarchy,
				settings_.lock_imut().deref().g_debug_bounding_boxes_hierarchy_level_to_show,
				drawing_info.test_lines );
		}

		if( settings_.lock_imut().deref().g_debug_show_room_clusters_hierarchy )
		{
			CreateBoundingBoxesHierarchyLines(
				map_data.room_clusters_hierarchy.deref(),
				settings_.lock_imut().deref().g_debug_bounding_boxes_hierarchy_level_to_show,
				drawing_info.test_lines );
		}

		if( settings_.lock_imut().deref().g_debug_show_player_position_in_quads_hierarchy )
		{
			CreateLinesForPositionInBoundingBoxesHierarchy(
				map_data.collider_quads_hierarchy, game_state.player.position, drawing_info.test_lines );
		}
	}

	return drawing_info;
}

fn Game::GetHudDrawingInfo( this ) : ust::optional</HudDrawingInfo/>
{
	if( map_data_.empty() || game_state_.empty() )
	{
		return ust::null_optional;
	}

	var GameState& game_state= game_state_.try_deref();
	var EntitiesDescription& entities_description= map_data_.try_deref().entities_description.deref();

	var HudDrawingInfo mut info
	{
		.health= game_state.player.energy,
		.armor= 25u, // TODO - store armor in player state.
		.ammo= -1, // Set later.
		// TODO - store active tool in player state.
		.active_tool_amount= 0u,
		.active_tool_icon_index= 0u,
		.weapon_icon_index= 0u, // Set later.
		.selected_tool_icon_index= 0u, // Set later.
		.character_icon_index= 0u, // TODO - draw character icon and score in multiplayer.
	};

	var size_type weapon_tool_index(
		entities_description.tool_type_to_index_map[ size_type( game_state.player.weapon_state.current_weapon ) ] );
	if( weapon_tool_index < entities_description.tools.size() )
	{
		var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

		info.weapon_icon_index= tool.icon;

		// TODO - store selected tool in player state.
		info.selected_tool_icon_index= tool.icon;

		if( tool.ammo_item >= 0 && size_type( tool.ammo_item ) < entities_description.tools.size() )
		{
			info.ammo= i32( game_state.player.inventory[ size_type( entities_description.tools[ size_type( tool.ammo_item ) ].tool_type ) ] );
		}
	}

	return info;
}

fn Game::GetCrosshairDrawingInfo( this ) : CrosshairDrawingInfo
{
	var CrosshairDrawingInfo mut drawing_info
	{
		.camera_position= Vec3f::MakeZero(),
		.camera_azimuth= camera_controller_.GetAzimuth(),
		.camera_elevation= camera_controller_.GetElevation(),
		.camera_fov= camera_controller_.GetFOV(),
		.hit_point= Vec3f::MakeZero(),
		.hit_point_kind= CrosshairDrawingInfo::HitPointKind::None,
	};

	if( !map_data_.empty() && !game_state_.empty() )
	{
		var GameMapData& map_data= map_data_.try_deref();
		var GameState& game_state= game_state_.try_deref();

		drawing_info.camera_position= GetCameraPositionForPlayer( game_state.player );

		auto [ position, kind ]=
			GetCrosshairPositionAndKind( map_data, game_state, drawing_info.camera_azimuth, drawing_info.camera_elevation );

		drawing_info.hit_point= position;
		drawing_info.hit_point_kind= kind;
	}

	return drawing_info;
}

fn Game::process_noclip( mut this )
{
	if_var( &mut game_state : game_state_ )
	{
		game_state.player.noclip = !game_state.player.noclip;

		ConsoleOutAddTextLine( console_out_, ( game_state.player.noclip ? ust::string_view8( "noclip on" ) : ust::string_view8( "noclip off" ) ) );

		// Player colliders will be added/removed if necessary later - when processing player movement logic.
	}
}

fn Game::process_reset_position( mut this )
{
	if_var( &mut game_state : game_state_ )
	{
		game_state.player.position= Vec3f::MakeZero();
		game_state.player.velocity= Vec3f::MakeZero();
	}
	camera_controller_= CameraController( 0.0f );
	player_movement_controller_.Reset();
}

fn Game::process_give_all( mut this )
{
	if( !game_state_.empty() && !map_data_.empty() )
	{
		var GameState &mut game_state= game_state_.try_deref();
		var EntitiesDescription& entities_description= map_data_.try_deref().entities_description.deref();

		for( auto mut t= 0s; t < typeinfo</ EntitiesDescription::ToolType />.element_count; ++t )
		{
			var size_type tool_index( entities_description.tool_type_to_index_map[t] );
			if( tool_index < entities_description.tools.size() )
			{
				game_state.player.inventory[t]= entities_description.tools[ tool_index ].player_max_count;
			}
		}

		ConsoleOutAddTextLine( console_out_, "Giving maximum amount of all items" );
	}
}

fn Game::process_invisibility( mut this )
{
	if_var ( &mut game_state : game_state_ )
	{
		var bool &mut i= game_state.player.invisibility;
		i= !i;

		ConsoleOutAddTextLine( console_out_, ( i ? ust::string_view8( "invisibility on" ) : ust::string_view8( "invisibility off" ) ) );
	}
}

fn GetCameraPositionForPlayer( PlayerState& player_state ) : Vec3f
{
	// The original game moves camera slightly backwards. Do exactly this.
	// TODO - fine-tune this constant.
	var Vec2f xy_offset= (-9.0f) * Vec2f( -ust::sin( player_state.azimuth ), ust::cos( player_state.azimuth ) );
	return player_state.position + Vec3f( xy_offset, c_camera_z_offset );
}

fn LoadGlobalData( CachingGameResourcesLoaderPtr& caching_game_resources_loader_ptr ) : GameGlobalData
{
	auto mut lock= caching_game_resources_loader_ptr.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	return GameGlobalData
	{
		.game_params= caching_game_resources_loader.LoadGameParams(),
		.maps_description= caching_game_resources_loader.LoadMapsDescription(),
		.materials_description= caching_game_resources_loader.LoadMaterialsDescription(),
		.materials_properties= caching_game_resources_loader.LoadMaterialsProperties(),
	};
}

} // namespace PM
