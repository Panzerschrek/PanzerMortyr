namespace PM
{

fn Game::constructor(
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader_ptr,
	ConsoleOutPtr mut console_out )
	(
		settings_= move(settings),
		console_out_= move(console_out),
		global_data_= LoadGlobalData( caching_game_resources_loader_ptr ),
		caching_game_resources_loader_ptr_= move( caching_game_resources_loader_ptr ),
		camera_controller_( settings_, CameraController::State{ .azimuth= 0.0f } ),
		player_movement_controller_( settings_ ),
		player_tool_controller_( settings_ ),
		prev_time_steps_= 0.0f,
	)
{
}

fn Game::StartNewGame( mut this, u32 skill, AudioProcessor &mut audio_processor )
{
	var u32 start_map= global_data_.game_params.deref().start_map;
	TeleportToMap( start_map, skill, audio_processor );
}

fn Game::TeleportToMap( mut this, u32 map_index, u32 skill, AudioProcessor &mut audio_processor )
{
	PerformMapTransition( map_index, skill, ust::null_optional_ref, audio_processor );
}

fn Game::Save( this, SaveComment& save_comment, ust::string_view8 save_name, AudioProcessor& audio_processor ) : bool
{
	if( map_data_.empty() || game_state_.empty() )
	{
		ConsoleOutAddTextLine( console_out_, "Can't save - no game is active" );
		return false;
	}

	var GameMapData& map_data= map_data_.try_deref();
	var GameStateExtended& game_state= game_state_.try_deref();

	if( game_state.current.player.energy <= 0u )
	{
		ConsoleOutAddTextLine( console_out_, "Can't save - the player is dead" );
		return false;
	}

	return
		SaveStoredGameState(
			console_out_,
			save_name,
			CreateSaveSummary( global_data_, map_data, game_state.current, save_comment ),
			map_data.map_index,
			game_state.current,
			camera_controller_.GetState(),
			audio_processor.GetState(),
			map_data.global_navigation_graph );
}

fn Game::Load( mut this, ust::string_view8 save_name, AudioProcessor &mut audio_processor )
{
	// Stop playing sounds from the old map before loading new one.
	// Doing so we ensure that sounds aren't playing while loading takes place.
	audio_processor.StopAllWorldSounds();
	audio_processor.StopMusic();

	// Reset game state and map data prior to loading new ones.
	// Avoid maintaining two copies of these structures in memory.
	map_data_.reset();
	game_state_.reset();

	auto mut stored_game_state_opt= LoadStoredGameState( console_out_, save_name );
	if( stored_game_state_opt.empty() )
	{
		return;
	}

	auto { map_index, mut game_state, mut camera_controller_state, audio_processor_state, mut global_navigation_graph }=
		stored_game_state_opt.try_take();

	LoadBasicMapData( map_index );

	if( map_data_.empty() )
	{
		return;
	}

	map_data_.try_deref().global_navigation_graph= move(global_navigation_graph);

	game_state_= GameStateExtended{ .current= move(game_state) };

	camera_controller_= CameraController( settings_, move(camera_controller_state) );

	audio_processor.SetState( audio_processor_state );

	prev_time_steps_= 0.0f;

	// Reset movement and tool controllers.
	player_movement_controller_.Reset();
	player_tool_controller_.Reset();

	var MapsDescription& maps_description= global_data_.maps_description.deref();
	if( size_type( map_index ) < maps_description.maps.size() )
	{
		audio_processor.StartPlayingMusic( maps_description.maps[ size_type( map_index ) ].cd_tracks_range );
	}
}

fn Game::Update(
	mut this, f32 time_delta_s, InputState& input_state, AudioProcessor &mut audio_processor ) : UpdateOutcome
{
	// Rotate camera each frame (unless the player is dead).
	if( game_state_.empty() || game_state_.try_deref().current.player.energy > 0u )
	{
		camera_controller_.Update( time_delta_s, input_state );
	}

	// Accumulate movement input each frame.
	player_movement_controller_.Update( time_delta_s, input_state );

	// Process tool requests each frame.
	player_tool_controller_.Update( input_state );

	// Process game logic in fixed time steps.

	var f32 game_speed= ust::max( 0.1f, ust::min( settings_.lock_imut().deref().g_game_speed, 10.0f ) );
	var bool extrapolation_enabled= settings_.lock_imut().deref().g_extrapolation_enabled;

	var f32 cur_time_steps= prev_time_steps_ + time_delta_s * c_steps_per_second * game_speed;

	var u32 prev_step= u32( prev_time_steps_ );
	var u32 cur_step= u32( cur_time_steps );

	var u32 num_steps_to_process=
		( settings_.lock_imut().deref().g_debug_sync_game_logic_steps
			? 1u
			// Avoid processing too much steps at once (in case of process topeed via debugger).
			: ust::min( 5u, cur_step - prev_step ) );

	prev_time_steps_= cur_time_steps;

	if( num_steps_to_process > 0u )
	{
		var u32 mut next_map_index= 0u;
		var u32 mut skill= 0u;
		var bool mut game_end_triggered= false;
		var ust::optional</PlayerState/> mut player_state;

		if( !map_data_.empty() && !game_state_.empty() )
		{
			var GameMapData& map_data= map_data_.try_deref();
			var GameStateExtended &mut game_state= game_state_.try_deref();

			skill= game_state.current.skill;

			var PlayerInput mut player_input
			{
				.azimuth= camera_controller_.GetAzimuth(),
				.elevation= camera_controller_.GetElevation(),
				.move_wish_vector= player_movement_controller_.GetAccumulatedMoveWishVector(),
				.jump_requested= player_movement_controller_.GetJumpRequested(),
				.crouching_requested= player_movement_controller_.GetCrouchingRequested(),
				.running_requested= player_movement_controller_.GetRunningRequested(),
				.shot_requested= player_tool_controller_.GetShotRequested(),
				.kick_requested= player_tool_controller_.GetKickRequested(),
				.inventory_input= player_tool_controller_.GetInventoryInput(),
			};

			player_movement_controller_.Reset();
			player_tool_controller_.Reset();

			for( auto mut i= 0u; i < num_steps_to_process; ++i )
			{
				if( extrapolation_enabled )
				{
					CopyAssignOrCopyConstructOptional( game_state.previous, game_state.current );
				}
				else
				{
					game_state.previous.reset();
				}

				ProcessGameLogicStep(
					global_data_,
					map_data,
					player_input,
					game_state.current,
					global_navigation_graph_route_searcher_ );

				next_map_index= game_state.current.next_map_index;
				game_end_triggered= game_state.current.game_end_triggered;

				if( next_map_index != 0u )
				{
					player_state= game_state.current.player;
					break;
				}

				if( game_end_triggered )
				{
					break;
				}

				// Apply inventory input only for single step.
				player_input.inventory_input= PlayerInventoryInput();

				if( extrapolation_enabled )
				{
					// Preserve game state predicted previously for current step.
					if_var( &next_predicted : game_state.next_predicted )
					{
						CopyAssignOrCopyConstructOptional( game_state.current_predicted, next_predicted );
					}
					else
					{
						game_state.current_predicted.reset();
					}

					CopyAssignOrCopyConstructOptional( game_state.next_predicted, game_state.current );

					// Predict next game state using the same input as on current step,
					// but without player movement and without jumping.
					// This adds a little bit lag (but only a little bit, since player's movement uses acceleration),
					// but allows minimizing overextrapolation for camera movement.
					var PlayerInput mut player_input_for_next_step_prediction= player_input;
					player_input_for_next_step_prediction.jump_requested= false;
					player_input_for_next_step_prediction.move_wish_vector= Vec3f::MakeZero();

					ProcessGameLogicStep(
						global_data_,
						map_data,
						player_input_for_next_step_prediction,
						game_state.next_predicted.try_deref(),
						global_navigation_graph_route_searcher_ );
				}
				else
				{
					// Reset additional game state instances if no extrapolation is performed.
					game_state.next_predicted.reset();
					game_state.current_predicted.reset();
				}
			}
		}

		if( next_map_index != 0u )
		{
			PerformMapTransition( next_map_index, skill, player_state.as_ref(), audio_processor );
		}

		if( game_end_triggered )
		{
			// Game end is reached - reset game state, stop world sounds and tell the caller that game end is reached.
			map_data_.reset();
			game_state_.reset();
			audio_processor.StopAllWorldSounds();
			audio_processor.StopMusic();
			return UpdateOutcome::GameEnd;
		}
	}

	if( !map_data_.empty() && !game_state_.empty() )
	{
		// Update audio even if no single game logic step was done.
		// We need this, since camera rotates every frame independent on game logic steps and sound volume depends on camera orientation.
		audio_processor.UpdateWord(
			ConstructWorldAudioInfo(
				global_data_,
				map_data_.try_deref(),
				game_state_.try_deref().current,
				camera_controller_,
				settings_.lock_imut().deref() ) );
	}

	return UpdateOutcome::Continue;
}

fn Game::GetWorldDrawingInfo( this ) : WorldDrawingInfo
{
	var WorldDrawingInfo mut world_drawing_info=
		ConstructWorldDrawingInfo(
			settings_.lock_imut().deref(),
			prev_time_steps_ % 1.0f,
			camera_controller_,
			map_data_.as_ref(),
			game_state_.as_ref() );

	foreach( &node_to_show : debug_navigation_graph_nodes_to_show_ )
	{
		CreateBBoxLines( node_to_show[0], node_to_show[1], world_drawing_info.test_lines );
	}

	return world_drawing_info;
}

fn Game::GetHudDrawingInfo( this ) : ust::optional</HudDrawingInfo/>
{
	if( map_data_.empty() || game_state_.empty() )
	{
		return ust::null_optional;
	}

	return
		ConstructHudDrawingInfo( map_data_.try_deref().entities_description.deref(), game_state_.try_deref().current );
}

fn Game::GetGameEventNotificationsDrawingInfo( this ) : ust::optional</GameEventNotificationsDrawingInfo/>
{
	if( map_data_.empty() || game_state_.empty() )
	{
		return ust::null_optional;
	}

	return
		ConstructGameEventNotificationsDrawingInfo(
			camera_controller_,
			map_data_.try_deref(),
			game_state_.try_deref(),
			prev_time_steps_ % 1.0f );
}

fn Game::GetCrosshairDrawingInfo( this ) : CrosshairDrawingInfo
{
	return
		ConstructCrosshairDrawingInfo(
			camera_controller_, map_data_.as_ref(), game_state_.as_ref(), prev_time_steps_ % 1.0f );
}

fn Game::process_noclip( mut this )
{
	if_var( &mut game_state : game_state_ )
	{
		var bool &mut noclip= game_state.current.player.noclip;

		noclip = !noclip;

		ConsoleOutAddTextLine( console_out_, ( noclip ? ust::string_view8( "noclip on" ) : ust::string_view8( "noclip off" ) ) );

		// Player colliders will be added/removed if necessary later - when processing player movement logic.
	}
}

fn Game::process_activate_spectator_camera( mut this )
{
	if( map_data_.empty() | game_state_.empty() )
	{
		return;
	}

	var GameState &mut game_state= game_state_.try_deref().current;

	var GameMapData& map_data= map_data_.try_deref();

	auto clusters= map_data.zvox_data.deref().clusters.range();
	auto quads= map_data.zmap_data.deref().quads.range();

	var ust::vector</size_type/> mut candidate_cluster_indices;

	for( auto mut i= 0s; i < clusters.size(); ++i )
	{
		var ZvoxCluster& room_cluster= clusters[i];
		if( room_cluster.c.num_children_clusters < 0 )
		{
			++i;
			continue;
		}

		// Select only clusters having at lest one entity inside.
		// It's needed to filter-out clusters behind playable area and
		// to prefer clusters where something happens and not just boring corners.

		var bool mut has_entities_inside= false;

		var BBox3f cluster_bbox= CreateClusterBBox( room_cluster );

		foreach( &entity : map_data.zpoz_data.deref().entities )
		{
			if( entity.alive_flag != 0u16 &&
				cluster_bbox.PointIsInsideOrOnFace(
					Vec3f( f32( entity.position[0] ), f32( entity.position[1] ), f32( entity.position[2] ) ) ) )
			{
				has_entities_inside= true;
				break;
			}
		}

		if( has_entities_inside )
		{
			candidate_cluster_indices.push_back(i);
		}

		i+= size_type( room_cluster.c.num_children_clusters ) + 1s;
	}

	var ust::vector</ CameraPositionWithTarget /> mut candidate_positons;

	foreach( cluster_index : candidate_cluster_indices )
	{
		var ZvoxCluster& cluster= clusters[ cluster_index ];

		candidate_positons.push_back(
			CameraPositionWithTarget
			{
				.position(
					f32( cluster.c.center[0] - cluster.c.bounding_box_half_size[0] * 3 / 4 ),
					f32( cluster.c.center[1] - cluster.c.bounding_box_half_size[1] * 3 / 4 ),
					f32( cluster.c.center[2] - cluster.c.bounding_box_half_size[2] * 2 / 3 ) ),
				.target(
					f32( cluster.c.center[0] + cluster.c.bounding_box_half_size[0] ),
					f32( cluster.c.center[1] + cluster.c.bounding_box_half_size[1] ),
					f32( cluster.c.center[2] + cluster.c.bounding_box_half_size[2] ) ),
			} );

		candidate_positons.push_back(
			CameraPositionWithTarget
			{
				.position(
					f32( cluster.c.center[0] + cluster.c.bounding_box_half_size[0] * 3 / 4 ),
					f32( cluster.c.center[1] - cluster.c.bounding_box_half_size[1] * 3 / 4 ),
					f32( cluster.c.center[2] - cluster.c.bounding_box_half_size[2] * 2 / 3 ) ),
				.target(
					f32( cluster.c.center[0] - cluster.c.bounding_box_half_size[0] ),
					f32( cluster.c.center[1] + cluster.c.bounding_box_half_size[1] ),
					f32( cluster.c.center[2] + cluster.c.bounding_box_half_size[2] ) ),
			} );

		candidate_positons.push_back(
			CameraPositionWithTarget
			{
				.position(
					f32( cluster.c.center[0] - cluster.c.bounding_box_half_size[0] * 3 / 4 ),
					f32( cluster.c.center[1] + cluster.c.bounding_box_half_size[1] * 3 / 4 ),
					f32( cluster.c.center[2] - cluster.c.bounding_box_half_size[2] * 2 / 3 ) ),
				.target(
					f32( cluster.c.center[0] + cluster.c.bounding_box_half_size[0] ),
					f32( cluster.c.center[1] - cluster.c.bounding_box_half_size[1] ),
					f32( cluster.c.center[2] + cluster.c.bounding_box_half_size[2] ) ),
			} );

		candidate_positons.push_back(
			CameraPositionWithTarget
			{
				.position(
					f32( cluster.c.center[0] + cluster.c.bounding_box_half_size[0] * 3 / 4 ),
					f32( cluster.c.center[1] + cluster.c.bounding_box_half_size[1] * 3 / 4 ),
					f32( cluster.c.center[2] - cluster.c.bounding_box_half_size[2] * 2 / 3 ) ),
				.target(
					f32( cluster.c.center[0] - cluster.c.bounding_box_half_size[0] ),
					f32( cluster.c.center[1] - cluster.c.bounding_box_half_size[1] ),
					f32( cluster.c.center[2] + cluster.c.bounding_box_half_size[2] ) ),
			} );
	}

	var ust::optional</CameraPositionWithTarget/> mut best_camera_position;
	var f32 mut best_camera_position_score= 0.0f;

	foreach( &camera_positon : candidate_positons )
	{
		// Require some free space around camera positon.
		if( TestBBoxMapIntersection(
				map_data,
				camera_positon.position,
				BBox3f{ .min( -8.0f, -8.0f, -8.0f ), .max( 8.0f, 8.0f, 8.0f ) } ) )
		{
			continue;
		}

		var Vec3f vec_to_target= camera_positon.target - camera_positon.position;

		var f32 vec_to_target_length= vec_to_target.Length();
		if( vec_to_target_length == 0.0f )
		{
			continue;
		}

		var f32 azimuth= ust::atan2( -vec_to_target.x, vec_to_target.y );
		var f32 elevation= ust::atan2( vec_to_target.z, vec_to_target.xy().Length() );

		var Mat4f rotation_matrix= Mat4f::MakeRotationX( elevation ) * Mat4f::MakeRotationZ( azimuth );

		var f32 mut all_rays_sum_score= 0.0f;

		// Cast rays in frustrum slightly less than 90 degrees wide.
		// Sum distances of all rays.
		// Assume distance for rays hitting nothing or back-faces to be zero.
		// Doing so we prefer positions with the most overall view distance.
		for( var i32 mut dx= -7; dx <= 7; ++dx )
		{
			for( var i32 mut dz= -7; dz <= 7; ++dz )
			{
				var Vec3f trace_vec= Vec3f( f32(dx) / 8.0f, 1.0f, f32(dz) / 8.0f ) * rotation_matrix;

				var f32 trace_length= 8192.0f;

				var f32 mut ray_score= 0.0f;

				if_var( trace_result :
						LineTrace(
							map_data,
							game_state.broken_quad_bits,
							game_state.dynamic_cluster_colliders,
							camera_positon.position,
							trace_vec * trace_length ) )
				{
					if( trace_result.distance > 0.0f && trace_result.distance < 1.0f )
					{
						ray_score= trace_length * trace_result.distance;
					}

					// Don't allow looking to back-faces.
					if( CalculateQuadNormal( quads[ size_type( trace_result.quad_index ) ] ).Dot( trace_vec ) >= 0.0f )
					{
						ray_score= 0.0f;
					}
				}

				all_rays_sum_score+= ray_score;
			}
		}

		if( all_rays_sum_score > best_camera_position_score )
		{
			best_camera_position_score= all_rays_sum_score;
			best_camera_position= camera_positon;
		}
	}

	if( best_camera_position.empty() )
	{
		return;
	}

	var CameraPositionWithTarget& p= best_camera_position.try_deref();

	var Vec3f vec_to_target= p.target - p.position;

	camera_controller_=
		CameraController(
			settings_,
			CameraController::State
			{
				.azimuth= ust::atan2( -vec_to_target.x, vec_to_target.y ),
				.elevation= ust::atan2( vec_to_target.z, vec_to_target.xy().Length() ),
			} );

	var PlayerState &mut player_state= game_state.player;

	player_state.position= Vec3f( p.position.xy(), p.position.z - c_camera_z_offset );
	player_state.crouching_phase= 0.0f;
	player_state.noclip= true;
	player_state.invisibility= true;
}

fn Game::process_reset_position( mut this )
{
	if_var( &mut game_state : game_state_ )
	{
		game_state.current.player.position= Vec3f::MakeZero();
		game_state.current.player.velocity= Vec3f::MakeZero();
	}
	camera_controller_= CameraController( settings_, CameraController::State{ .azimuth= 0.0f } );
	player_movement_controller_.Reset();
}

fn Game::process_give_all( mut this )
{
	if( !game_state_.empty() && !map_data_.empty() )
	{
		var GameState &mut game_state= game_state_.try_deref().current;
		var EntitiesDescription& entities_description= map_data_.try_deref().entities_description.deref();

		for( auto mut t= 0s; t < typeinfo</ EntitiesDescription::ToolType />.element_count; ++t )
		{
			var size_type tool_index( entities_description.tool_type_to_index_map[t] );
			if( tool_index < entities_description.tools.size() )
			{
				game_state.player.inventory[t]= entities_description.tools[ tool_index ].player_max_count;
			}
		}

		ConsoleOutAddTextLine( console_out_, "Giving maximum amount of all items" );
	}
}

fn Game::process_invisibility( mut this )
{
	if_var ( &mut game_state : game_state_ )
	{
		var bool &mut i= game_state.current.player.invisibility;
		i= !i;

		ConsoleOutAddTextLine( console_out_, ( i ? ust::string_view8( "invisibility on" ) : ust::string_view8( "invisibility off" ) ) );
	}
}

fn Game::process_invulnerability( mut this )
{
	if_var ( &mut game_state : game_state_ )
	{
		var bool &mut i= game_state.current.player.invulnerability;
		i= !i;

		ConsoleOutAddTextLine( console_out_, ( i ? ust::string_view8( "invulnerability on" ) : ust::string_view8( "invulnerability off" ) ) );
	}
}

fn Game::process_debug_show_nearby_navigation_graph_nodes( mut this )
{
	debug_navigation_graph_nodes_to_show_.clear();

	if( map_data_.empty() || game_state_.empty() )
	{
		return;
	}

	var GameMapData& map_data= map_data_.try_deref();
	var GameState& game_state= game_state_.try_deref().current;

	var bool large_entity= false;

	if_var( start_node_index :
		FindNearestNavigationGraphNode( map_data, game_state.broken_quad_bits, game_state.player.position, large_entity ) )
	{
		var PerformanceCounter::TimePoint start_time= performance_counter_.GetCurrentTime();

		auto &mut out_nodes= debug_navigation_graph_nodes_to_show_;

		var size_type mut num_nodes_visited= 0s;

		var GlobalNavigationGraph::NodeIndex mut last_visited_node_index=
			GlobalNavigationGraph::c_invalid_node_index;

		global_navigation_graph_route_searcher_.EnumerateOutputNodes(
			map_data.global_navigation_graph,
			start_node_index,
			large_entity,
			lambda[&]( GlobalNavigationGraph::NodeIndex node_index, u32 distance ) : bool
			{
				++num_nodes_visited;

				var u32 max_distance= 1024u;

				if( distance > max_distance )
				{
					return false;
				}

				last_visited_node_index= node_index;

				var GlobalNavigationGraph::Node& node=
					map_data.global_navigation_graph.nodes[ size_type( node_index ) ];

				out_nodes.push_back(
					ust::make_tuple(
						BBox3f
						{
							.min= node.position + map_data.global_navigation_graph.node_bbox.min,
							.max= node.position + map_data.global_navigation_graph.node_bbox.max,
						},
						ust::make_array( 255u8, u8( ( 255u - distance * 255u / max_distance ) ), 255u8 ) ) );

				return true;
			} );

		if( last_visited_node_index != GlobalNavigationGraph::c_invalid_node_index )
		{
			var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
				global_navigation_graph_route_searcher_.ReconstructRouteAfterNodesEnumeration( last_visited_node_index );

			if( !route.empty() )
			{
				var Vec3f bbox_half_size= map_data.global_navigation_graph.node_bbox.GetDimensions() / 4.0f;
				var Vec3f bbox_center= map_data.global_navigation_graph.node_bbox.GetCenter();

				var BBox3f bbox{ .min= bbox_center - bbox_half_size, .max= bbox_center + bbox_half_size };

				for( auto mut i= 0s; i < route.size(); ++i )
				{
					var GlobalNavigationGraph::Node& node=
						map_data.global_navigation_graph.nodes[ size_type( route[i] ) ];

					out_nodes.push_back(
						ust::make_tuple(
							BBox3f{ .min= node.position + bbox.min, .max= node.position + bbox.max, },
							ust::make_array( 64u8, u8( 255s * i / route.size() ), 64u8 ) ) );
				}
			}
		}

		var PerformanceCounter::TimePoint end_time= performance_counter_.GetCurrentTime();

		var f32 duration_s= performance_counter_.CalculateDurationS( start_time, end_time );

		ConsoleOutAddTextLine(
			console_out_, ust::concat( "Visited ", ust::to_string8( num_nodes_visited ), " nodes" ) );

		ConsoleOutAddTextLine(
			console_out_,
			ust::concat( "Search duration is ", ust::to_string8( u32( duration_s * 1000000.0f ) ), " microseconds" ) );
	}
}

fn Game::process_debug_reset_nearby_navigation_graph_nodes_visualization( mut this )
{
	debug_navigation_graph_nodes_to_show_.clear();
}

fn Game::process_debug_set_navigation_target( mut this )
{
	if_var( &game_state : game_state_ )
	{
		debug_navigation_target_= game_state.current.player.position;
	}
}

fn Game::process_debug_search_route( mut this )
{
	debug_navigation_graph_nodes_to_show_.clear();

	if( map_data_.empty() || game_state_.empty() )
	{
		return;
	}

	var GameMapData& map_data= map_data_.try_deref();
	var GameState& game_state= game_state_.try_deref().current;

	if( debug_navigation_target_.empty() )
	{
		return;
	}

	var bool large_entity= false;

	auto target_node_index_opt=
		FindNearestNavigationGraphNode( map_data, game_state.broken_quad_bits, debug_navigation_target_.try_deref(), large_entity );
	auto start_node_index_opt=
		FindNearestNavigationGraphNode( map_data, game_state.broken_quad_bits, game_state.player.position, large_entity );

	if( target_node_index_opt.empty() || start_node_index_opt.empty() )
	{
		return;
	}

	var GlobalNavigationGraph::NodeIndex start_node_index= start_node_index_opt.try_deref();
	var GlobalNavigationGraph::NodeIndex target_node_index= target_node_index_opt.try_deref();

	if( start_node_index == target_node_index )
	{
		return;
	}

	auto &mut out_nodes= debug_navigation_graph_nodes_to_show_;

	var PerformanceCounter::TimePoint start_time= performance_counter_.GetCurrentTime();

	var size_type mut num_nodes_visited= 0s;

	var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route_nodes=
		global_navigation_graph_route_searcher_.PerformDirectedSearch(
			map_data.global_navigation_graph,
			start_node_index,
			target_node_index,
			large_entity,
			lambda[&]( GlobalNavigationGraph::NodeIndex node_index ) : bool
			{
				++num_nodes_visited;

				var GlobalNavigationGraph::Node& node=
					map_data.global_navigation_graph.nodes[ size_type( node_index ) ];

				out_nodes.push_back(
					ust::make_tuple(
						BBox3f
						{
							.min= node.position - Vec3f( 8.0f, 8.0f, 60.0f ),
							.max= node.position + Vec3f( 8.0f, 8.0f, -4.0f ),
						},
						ust::make_array( 128u8, 128u8, 128u8 ) ) );

				return true;
			} );

	var PerformanceCounter::TimePoint end_time= performance_counter_.GetCurrentTime();

	var f32 duration_s= performance_counter_.CalculateDurationS( start_time, end_time );

	ConsoleOutAddTextLine(
		console_out_, ust::concat( "Visited ", ust::to_string8( num_nodes_visited ), " nodes" ) );

	ConsoleOutAddTextLine(
		console_out_,
		ust::concat( "Search duration is ", ust::to_string8( u32( duration_s * 1000000.0f ) ), " microseconds" ) );

	if( route_nodes.empty() )
	{
		ConsoleOutAddTextLine( console_out_, "No route was found" );
		return;
	}

	for( auto mut i= 0s; i < route_nodes.size(); ++i )
	{
		var GlobalNavigationGraph::NodeIndex node_index= route_nodes[i];
		var GlobalNavigationGraph::Node& node= map_data.global_navigation_graph.nodes[ size_type( node_index ) ];

		out_nodes.push_back(
			ust::make_tuple(
				BBox3f
				{
					.min= node.position + map_data.global_navigation_graph.node_bbox.min,
					.max= node.position + map_data.global_navigation_graph.node_bbox.max,
				},
				ust::make_array( 255u8, u8( 255s * i / route_nodes.size() ), 0u8 ) ) );
	}

	var GlobalNavigationGraph::Node& start_node=
		map_data.global_navigation_graph.nodes[ size_type( start_node_index ) ];

	out_nodes.push_back(
		ust::make_tuple(
			BBox3f
			{
				.min= start_node.position + map_data.global_navigation_graph.node_bbox.min,
				.max= start_node.position + map_data.global_navigation_graph.node_bbox.max,
			},
			ust::make_array( 0u8, 0u8, 255u8 ) ) );
}

fn Game::PerformMapTransition(
	mut this,
	u32 map_index,
	u32 skill,
	ust::optional_ref_imut</PlayerState/> prev_player_state,
	AudioProcessor &mut audio_processor )
{
	if( map_index == 0u )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Can't go to map 0!" ) );
		return;
	}

	// Stop playing sounds from the old map before loading new one.
	// Doing so we ensure that sounds aren't playing while loading takes place.
	audio_processor.StopAllWorldSounds();
	audio_processor.StopMusic();

	if( map_data_.empty() || map_index != map_data_.try_deref().map_index )
	{
		// Load map data if transitioning to a map different from current one.

		LoadBasicMapData( map_index );

		if( map_data_.empty() )
		{
			return;
		}

		// Build global navigation graph after preparing other map data.
		var GlobalNavigationGraph mut global_navigation_graph=
			BuildGlobalNavigationGraph(
				map_data_.try_deref(),
				console_out_,
				performance_counter_,
				settings_.lock_imut().deref().g_debug_global_navigation_graph_use_fast_but_incorrect_reachability_check );

		map_data_.try_deref().global_navigation_graph= move(global_navigation_graph);
	}

	// Reset game state.

	prev_time_steps_= 0.0f;

	game_state_=
		GameStateExtended
		{
			.current=
				CreateNewMapGameState( console_out_, global_data_, map_data_.try_deref(), skill, prev_player_state )
		};

	// Reset camera controller state and set its azimuth to player's azimuth (so that he faces the direction of the spawn point).
	camera_controller_=
		CameraController(
			settings_, CameraController::State{ .azimuth= game_state_.try_deref().current.player.azimuth } );

	// Reset movement state.
	player_movement_controller_.Reset();
	player_tool_controller_.Reset();

	var MapsDescription& maps_description= global_data_.maps_description.deref();
	if( size_type( map_index ) < maps_description.maps.size() )
	{
		audio_processor.StartPlayingMusic( maps_description.maps[ size_type( map_index ) ].cd_tracks_range );
	}
}

fn Game::LoadBasicMapData( mut this, u32 map_index )
{
	// Avoid mainaining two copies of map data in memory while performing map loading.
	map_data_.reset();

	var MapsDescription& maps_description= global_data_.maps_description.deref();

	if( size_type(map_index) >= maps_description.maps.size() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Map with index ", ust::to_string8( map_index ), " not found!" ) );
		return;
	}

	var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type( map_index ) ];

	auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	// Some maps don't specify entities description file name.
	// In such case use some default value.
	var ResourceString& entities_info_file=
		( map_description.entities_info_file[0] == '\0'
			? c_default_entities_description_file_name
			: map_description.entities_info_file );

	var GameResourcePtr</EntitiesDescription/> entities_description_ptr=
		caching_game_resources_loader.LoadEntitiesDescription( entities_info_file );

	var GameResourceNullablePtr</ZmapData/> zmap_data_nullable= caching_game_resources_loader.LoadZmapFile( map_index );
	var GameResourceNullablePtr</ZvoxData/> zvox_data_nullable= caching_game_resources_loader.LoadZvoxFile( map_index );
	var GameResourceNullablePtr</ZpozData/> zpoz_data_nullable= caching_game_resources_loader.LoadZpozFile( map_index );
	var GameResourceNullablePtr</RoomClustersHierarchy/> room_clusters_hierarchy_nullable= caching_game_resources_loader.LoadRoomClustersHierarchy( map_index );
	var GameResourceNullablePtr</QuadsHierarchy/> quads_hierarchy_nullable= caching_game_resources_loader.LoadQuadsHierarchy( map_index );

	if( zmap_data_nullable.empty() ||
		zvox_data_nullable.empty() ||
		zpoz_data_nullable.empty() ||
		room_clusters_hierarchy_nullable.empty() ||
		quads_hierarchy_nullable.empty() )
	{
		return;
	}

	var GameResourcePtr</ZvoxData/> mut zvox_data= zvox_data_nullable.try_to_non_nullable();
	var GameResourcePtr</ZpozData/> mut zpoz_data= zpoz_data_nullable.try_to_non_nullable();

	map_data_=
		GameMapData
		{
			.map_index= map_index,
			.entities_description= entities_description_ptr,
			.collider_quads_hierarchy= quads_hierarchy_nullable.try_to_non_nullable(),
			.room_clusters_hierarchy= room_clusters_hierarchy_nullable.try_to_non_nullable(),
			.note_volumes= CreateNoteVolumesList( zvox_data.deref().clusters ),
			.used_models= CreateMapUsedModelsList( zpoz_data.deref().entities, entities_description_ptr.deref() ),
			.zmap_data= zmap_data_nullable.try_to_non_nullable(),
			.zvox_data= move(zvox_data),
			.zpoz_data= move(zpoz_data),
		};
}

fn LoadGlobalData( CachingGameResourcesLoaderPtr& caching_game_resources_loader_ptr ) : GameGlobalData
{
	auto mut lock= caching_game_resources_loader_ptr.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	return GameGlobalData
	{
		.game_params= caching_game_resources_loader.LoadGameParams(),
		.maps_description= caching_game_resources_loader.LoadMapsDescription(),
		.materials_description= caching_game_resources_loader.LoadMaterialsDescription(),
		.materials_properties= caching_game_resources_loader.LoadMaterialsProperties(),
		.sounds_description= caching_game_resources_loader.LoadSoundsDescription(),
		.string_table= caching_game_resources_loader.LoadStringTable(),
	};
}

fn CreateNoteVolumesList( ust::array_view_imut</ZvoxCluster/> clusters ) : ust::vector</NoteVolume/>
{
	var  ust::vector</NoteVolume/> mut result;

	for( auto mut cluster_index= 0s; cluster_index < clusters.size(); ++cluster_index )
	{
		var ZvoxCluster& cluster= clusters[ cluster_index ];
		if( cluster.cluster_type == ZvoxCluster::c_cluster_type_notes && cluster.light_sources_begin >= 0 )
		{
			var Vec3f center( f32( cluster.c.center[0] ), f32( cluster.c.center[1] ), f32( cluster.c.center[2] ) );

			// Make too small note clusters a little bit larger.
			var i32 c_min_half_size= 16;
			var Vec3f half_size(
				f32( ust::max( cluster.c.bounding_box_half_size[0], c_min_half_size ) ),
				f32( ust::max( cluster.c.bounding_box_half_size[1], c_min_half_size ) ),
				f32( ust::max( cluster.c.bounding_box_half_size[2], c_min_half_size ) ) );

			result.push_back(
				NoteVolume
				{
					.bbox{ .min= center - half_size, .max= center + half_size },
					.cluster_index( cluster_index ),
					.note_index( cluster.light_sources_begin ),
				} );
		}
	}

	return result;
}

fn CreateMapUsedModelsList(
	ust::array_view_imut</ZpozEntity/> zpoz_entities,
	EntitiesDescription& entities_description ) : ust::vector</ResourceString/>
{
	scoped_array bool mut used_entity_kinds[ entities_description.entities.size() ]( false );

	// Mark used entities.
	foreach( &entity : zpoz_entities )
	{
		if( entity.alive_flag != 0u16 )
		{
			var size_type index( entity.kind );
			if( index < used_entity_kinds.size() )
			{
				used_entity_kinds[index]= true;
			}
		}
	}

	// Mark entities spawned by other used entities.
	for( auto mut i= 0s; i < entities_description.entities.size(); ++i )
	{
		if( !used_entity_kinds[i] )
		{
			continue;
		}

		foreach( &operation : entities_description.entities[i].operations )
		{
			if_var( &supply_drop : operation.supply_drop )
			{
				var size_type special_object_index( supply_drop.special_object );
				if( special_object_index < used_entity_kinds.size() )
				{
					used_entity_kinds[special_object_index]= true;
				}
			}
		}
	}

	scoped_array bool mut used_animations[ entities_description.animations.size() ]( false );

	// Mark animations used by entities.
	foreach( pair : entities_description.entities.iter().zip( used_entity_kinds.iter() ) )
	{
		if( !pair.second )
		{
			continue;
		}

		foreach( &operation : pair.first.operations )
		{
			if( operation.animation.num_steps != 0u )
			{
				var size_type index( operation.animation.animation_number );
				if( index < used_animations.size() )
				{
					used_animations[index]= true;
				}
			}

			if( operation.directional_animation.num_steps != 0u )
			{
				var size_type index( operation.directional_animation.animation_number );
				if( index < used_animations.size() )
				{
					used_animations[index]= true;
				}
			}
		}
	}

	// Mark animations used by weapon tools.
	foreach( &tool : entities_description.tools )
	{
		if(	tool.tool_type == EntitiesDescription::ToolType::Kick ||
			( tool.tool_type >= EntitiesDescription::ToolType::WeaponA &&
			  tool.tool_type <= EntitiesDescription::ToolType::WeaponJ ) )
		{
			var size_type animation_index( tool.animation );
			if( animation_index < used_animations.size() )
			{
				used_animations[ animation_index ]= true;
			}

			if( tool.projectile_model >= EntitiesDescription::Tool::c_projectile_model_first_mesh_model )
			{
				// Projectiles for this weapon are drawn via a mesh model.
				var size_type projectile_animation_index(
					tool.projectile_model - EntitiesDescription::Tool::c_projectile_model_first_mesh_model );
				if( projectile_animation_index < used_animations.size() )
				{
					used_animations[ projectile_animation_index ]= true;
				}
			}
		}
	}

	// Mark special animations as used.
	if( size_type( entities_description.bird_animation_index ) < used_animations.size() )
	{
		used_animations[ size_type( entities_description.bird_animation_index ) ]= true;
	}
	if( size_type( entities_description.rat_animation_index ) < used_animations.size() )
	{
		used_animations[ size_type( entities_description.rat_animation_index ) ]= true;
	}

	var ust::vector</ResourceString/> mut used_models;

	// Collect all used model file names.
	foreach( pair : entities_description.animations.iter().zip( used_animations.iter() ) )
	{
		if( !pair.second )
		{
			continue;
		}

		used_models.push_back( pair.first.model_file_name );
	}

	// Make sure we have no duplicated models.
	ust::sort( used_models.range(), ResourceStringCompare() );
	used_models.remove_adjacent_duplicates();

	return used_models;
}

fn CreateSaveSummary(
	GameGlobalData& global_data,
	GameMapData& map_data,
	GameState& game_state,
	SaveComment& save_comment ) : SaveSummary
{
	var [ char8, 64 ] mut level_name= zero_init;

	var MapsDescription& maps_description= global_data.maps_description.deref();
	if( size_type( map_data.map_index ) < maps_description.maps.size() )
	{
		ust::array_view_mut</char8/>( level_name ).copy_from(
			maps_description.maps[ size_type( map_data.map_index ) ].caption.range() );
	}

	return SaveSummary
	{
		.comment= save_comment,
		.skill= game_state.skill,
		.level_name= move( level_name ),
		.kills= CountKills( global_data, map_data, game_state ),
	};
}

// TODO - add such method into the "optional" container instead.
template</type T/>
fn CopyAssignOrCopyConstructOptional( ust::optional</T/> &mut dst, T& src )
{
	if( !dst.empty() )
	{
		dst.try_deref()= src;
	}
	else
	{
		dst.reset( src /* copy-constructor is called here */ );
	}
}

struct CameraPositionWithTarget
{
	Vec3f position;
	Vec3f target;
}

} // namespace PM
