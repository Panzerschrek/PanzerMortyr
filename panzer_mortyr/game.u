import "/string_conversions.u"
import "collisions.uh"
import "debug_visualization.uh"
import "game.uh"
import "geometry_utils.uh"
import "math_constants.uh"

namespace PM
{

fn Game::constructor(
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader_ptr,
	ConsoleOutPtr mut console_out )
	(
		console_out_= move(console_out),
		game_params_=
			lambda[&caching_game_resources_loader_ptr]() : GameResourcePtr</GameParams/>
			{
				with( mut lock : caching_game_resources_loader_ptr.lock_mut() )
				{
					return lock.deref().LoadGameParams();
				}
			} (),
		materials_properties_=
			lambda[&caching_game_resources_loader_ptr]() : GameResourcePtr</MaterialsProperties/>
			{
				with( mut lock : caching_game_resources_loader_ptr.lock_mut() )
				{
					return lock.deref().LoadMaterialsProperties();
				}
			} (),
		caching_game_resources_loader_ptr_= move( caching_game_resources_loader_ptr ),
		current_map_index_= 0u, // Set later.
		player_state_{ .position( 0.0f, 0.0f, 0.0f ), .velocity( 0.0f, 0.0f, 0.0f ) },
		camera_rotation_controller_( 0.0f ),
		prev_time_steps_= 0.0,
	)
{
	var u32 start_map= game_params_.deref().start_map;
	TeleportToMap( start_map );
}

fn Game::GetCurrentMapIndex( this ) : u32
{
	return current_map_index_;
}

fn Game::TeleportToMap( mut this, u32 map_index )
{
	if( map_index == 0u )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Can't go to map 0!" ) );
		return;
	}

	if( map_index == current_map_index_ )
	{
		return;
	}

	entities_description_.reset();

	auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	var GameResourcePtr</MapsDescription/> maps_description_ptr= caching_game_resources_loader.LoadMapsDescription();

	var ust::optional_ref_imut</MapsDescription::MapDescription/> map_description_opt=
		maps_description_ptr.deref().maps.find( map_index );

	if( map_description_opt.empty() )
	{
		ConsoleOutAddTextLine( console_out_, ust::concat( "Map with index ", ust::to_string8( map_index ), " not found!" ) );
		return;
	}

	var MapsDescription::MapDescription& map_description= map_description_opt.try_deref();

	// Some maps don't specify entities description file name.
	// In such case use some default value.
	// TODO - check if it's correct to use this name.
	var ResourceString& entities_info_file=
		( map_description.entities_info_file[0] == '\0'
			? "ZINF.STD\0\0\0\0\0\0\0\0"
			: map_description.entities_info_file );

	entities_description_= caching_game_resources_loader.LoadEntitiesDescription( entities_info_file );

	zmap_data_= caching_game_resources_loader.LoadZmapFile( map_index );
	zvox_data_= caching_game_resources_loader.LoadZvoxFile( map_index );

	var GameResourceNullablePtr</ZpozData/> zpoz_data_nullable= caching_game_resources_loader.LoadZpozFile( map_index );

	mapa_way_data_= caching_game_resources_loader.LoadMapaWayFile( map_index );

	prev_time_steps_= 0.0;

	random_= PseudoRandomGenerator( 0u ); // TODO - tweak seed?

	entities_.clear();

	if( !zpoz_data_nullable.empty() && !entities_description_.empty() )
	{
		auto& zpoz_entities= zpoz_data_nullable.try_deref().entities;

		auto& entities_description= entities_description_.try_deref();

		// Map source entities 1 to 1 to runtime entities. It's needed for index stability.

		entities_.resize( zpoz_entities.size() );

		foreach( pair : zpoz_entities.iter().zip( entities_.iter() ) )
		{
			var ZpozEntity& in_entity= pair.first;

			if( in_entity.alive_flag == 0u16 )
			{
				continue;
			}

			if( u32( in_entity.kind ) == c_player_entity_index )
			{
				// Do not place player spawn entities.
				continue;
			}

			if_var( &entity_description : entities_description.entities.find( u32( in_entity.kind ) ) )
			{
				if( !entity_description.operations.exists( c_start_operation ) )
				{
					continue;
				}
			}
			else
			{
				continue;
			}

			pair.second=
				EntityState
				{
					.kind( in_entity.kind ),
					.position( f32( in_entity.position[0] ), f32( in_entity.position[1] ), f32( in_entity.position[2] ) ),
					.azimuth( Convert1024Angle( f32( in_entity.data[4] ) ) ),
					.current_operation= c_start_operation,
					.next_operation= ~0u,
					.num_steps_since_operation_start= 0u,
					.num_steps_left_to_next_operation= ~0u,
					.navigation_info_index( in_entity.data[16] ),
					.target_navigation_graph_node= ~0u,
					.current_navigation_graph_node= ~0u,
					.has_seen_player_in_current_operation= false,
					.player_is_inside_shooting_zone= false,
					.lost_energy_in_current_operation= false,
					.animation_frames= zero_init, // Set exact frames later.
				};
		}

		// Find player spawn.
		foreach( &entity : zpoz_entities )
		{
			if( entity.alive_flag == 0u16 )
			{
				continue;
			}

			if( u32( entity.kind ) == c_player_entity_index )
			{
				player_state_=
					PlayerState
					{
						.position( f32( entity.position[0] ), f32( entity.position[1] ), f32( entity.position[2] ) ),
						.velocity( 0.0f, 0.0f, 0.0f )
					};

				// Reset possible rotation and movement state.
				camera_rotation_controller_= CameraRotationController( Convert1024Angle( f32( entity.data[4] ) ) );
				player_movement_controller_.Reset();

				break;
			}
		}
	}

	current_map_index_= map_index;
}

fn Game::Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state )
{
	// Rotate camera each frame.
	camera_rotation_controller_.Update( time_delta_s, keyboard_state );

	// Accumulate movement input each frame.
	player_movement_controller_.Update(  time_delta_s, keyboard_state );

	// TODO - accumulate shot commands each frame in order to shoot exactly in the direction where camera sees.

	// Process game logic in fixed time steps.

	var f64 cur_time_steps= prev_time_steps_ + f64( time_delta_s * c_steps_per_second );

	var u32 prev_step= u32( prev_time_steps_ );
	var u32 cur_step= u32( cur_time_steps );
	// Avoid processing too much steps at once (in case of process topeed via debugger).
	var u32 num_steps_to_process= ust::min( 5u, cur_step - prev_step );

	if( num_steps_to_process > 0u )
	{
		for( auto mut i= 0u; i < num_steps_to_process; ++i )
		{
			ProcessStep();
		}

		player_movement_controller_.Reset();
	}

	prev_time_steps_= cur_time_steps;
}

fn Game::ProcessMouseButtonPress( mut this, u32 button_index )
{
	if( button_index == 1u )
	{
		var f32 azimuth= camera_rotation_controller_.GetAzimuth();
		var f32 elevation= camera_rotation_controller_.GetElevation();

		var f32 elevation_cos= ust::cos(elevation);
		var f32 elevation_sin= ust::sin(elevation);

		var Vec3f direction_vector( -ust::sin(azimuth) * elevation_cos, ust::cos(azimuth) * elevation_cos, elevation_sin );

		var Vec3f ray_start= GetCameraPositionForPlayer( player_state_ );

		if( zmap_data_.empty() || zvox_data_.empty() )
		{
			return;
		}

		var ZmapData& zmap_data= zmap_data_.try_deref();
		var ZvoxData& zvox_data= zvox_data_.try_deref();

		test_bullet_holes_.clear();

		if_var( ray_trace_result : RayTrace( zmap_data, zvox_data, ray_start, direction_vector ) )
		{
			var Vec3f closest_intersection_point= ray_start + direction_vector * ray_trace_result.distance;

			test_bullet_holes_.push_back( closest_intersection_point );

			auto& center= zvox_data.clusters[ size_type( ray_trace_result.cluster_index ) ].c.center;
			auto& in_vertices= zmap_data.quads[ size_type( ray_trace_result.quad_index ) ].vertices;

			var [ Vec3f, 4 ] vertices
			[
				Vec3f( f32( center[0] + i32( in_vertices[0][0] ) ), f32( center[1] + i32( in_vertices[0][1] ) ), f32( center[2] + i32( in_vertices[0][2] ) ) ),
				Vec3f( f32( center[0] + i32( in_vertices[1][0] ) ), f32( center[1] + i32( in_vertices[1][1] ) ), f32( center[2] + i32( in_vertices[1][2] ) ) ),
				Vec3f( f32( center[0] + i32( in_vertices[2][0] ) ), f32( center[1] + i32( in_vertices[2][1] ) ), f32( center[2] + i32( in_vertices[2][2] ) ) ),
				Vec3f( f32( center[0] + i32( in_vertices[3][0] ) ), f32( center[1] + i32( in_vertices[3][1] ) ), f32( center[2] + i32( in_vertices[3][2] ) ) ),
			];

			var CompactPolyhedron mut polyhedron
			{
				.num_planes= 0u,
				.primary_planes_mask= 0u,
				.planes
				[
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
					Planef{ .normal= Vec3f::MakeZero(), .distance= 0.0f },
				],
			};

			CreateBBoxAndQuadMinkowskiSum( GetPlayerColliderBBox(), vertices, polyhedron );
			if( polyhedron.num_planes >= 4u )
			{
				test_triangles_.clear();
				PolygonizePolyhedron( ust::array_view_imut</Planef/>( polyhedron.planes ).subrange_end( size_type( polyhedron.num_planes ) ), test_triangles_ );
			}
		}
	}
}

fn Game::GetWorldDrawingInfo( this ) : WorldDrawingInfo
{
	var ust::vector</WorldDrawingInfo::ModelObject/> mut model_objects;

	if( !entities_description_.empty() )
	{
		var EntitiesDescription& entities_description= entities_description_.try_deref();

		foreach( &entity_opt : entities_ )
		{
			if( entity_opt.empty() )
			{
				continue;
			}

			var EntityState& entity= entity_opt.try_deref();

			var EntitiesDescription::EntityDescription& entity_description= entities_description.entities[ entity.kind ];

			auto operation_opt= entity_description.operations.find( entity.current_operation );
			if( operation_opt.empty() )
			{
				continue;
			}

			var EntitiesDescription::Operation& operation= entity_description.operations[ entity.current_operation ];

			foreach( pair :
				ust::array_view_imut</EntitiesDescription::OperationAnimationDescription/>( operation.animations ).iter().zip(
					ust::array_view_imut</u32/>( entity.animation_frames ).iter() ) )
			{
				var EntitiesDescription::OperationAnimationDescription& operation_animation_description= pair.first;

				if( operation_animation_description.num_steps == 0u )
				{
					continue;
				}

				auto animation_opt= entities_description.animations.find( operation_animation_description.animation_number );
				if( animation_opt.empty() )
				{
					continue;
				}
				var EntitiesDescription::AnimationDescription& animation= animation_opt.try_deref();

				model_objects.push_back(
					WorldDrawingInfo::ModelObject
					{
						.model_file_name= animation.model_file_name,
						.position= entity.position,
						.azimuth= entity.azimuth,
						.frame= pair.second,
					} );
				}
		}
	}

	return WorldDrawingInfo
	{
		.map_index= current_map_index_,
		.camera_position= GetCameraPositionForPlayer( player_state_ ),
		.camera_azimuth= camera_rotation_controller_.GetAzimuth(),
		.camera_elevation= camera_rotation_controller_.GetElevation(),
		.model_objects= move(model_objects),
		.test_sprites= test_bullet_holes_,
		.test_triangles= test_triangles_,
	};
}

fn Game::process_noclip( mut this )
{
	noclip_mode_active_ = !noclip_mode_active_;

	ConsoleOutAddTextLine( console_out_, ( noclip_mode_active_ ? ust::string_view8( "noclip on" ) : ust::string_view8( "noclip off" ) ) );
}

fn Game::process_reset_position( mut this )
{
	player_state_.position= Vec3f( 0.0f, 0.0f, 0.0f );
	player_state_.velocity= Vec3f( 0.0f, 0.0f, 0.0f );
	camera_rotation_controller_= CameraRotationController( 0.0f );
	player_movement_controller_.Reset();
}

fn Game::process_trigger_player_see( mut this )
{
	var Vec3f pos= player_state_.position;
	if_var( &mut entity : GetNearestEntity( pos ) )
	{
		entity.has_seen_player_in_current_operation= true;
	}
}

fn Game::process_trigger_player_in_shooting_zone( mut this )
{
	var Vec3f pos= player_state_.position;
	if_var( &mut entity : GetNearestEntity( pos ) )
	{
		entity.player_is_inside_shooting_zone= true;
	}
}

fn Game::process_trigger_energy_loss( mut this )
{
	var Vec3f pos= player_state_.position;
	if_var( &mut entity : GetNearestEntity( pos ) )
	{
		entity.lost_energy_in_current_operation= true;
	}
}

fn Game::PerformPlayerStepMovement( mut this )
{
	var Vec3f movement_start_position= player_state_.position;

	ApplyPlayerMovement(
		player_state_,
		camera_rotation_controller_.GetAzimuth(),
		player_movement_controller_.GetAccumulatedMoveWishVector() );

	if( noclip_mode_active_ )
	{
		return;
	}

	if( zmap_data_.empty() || zvox_data_.empty() )
	{
		return;
	}

	var ZmapData& zmap_data= zmap_data_.try_deref();
	var ZvoxData& zvox_data= zvox_data_.try_deref();

	var BBox3f player_bbox= GetPlayerColliderBBox();

	var Vec3f movement_end_position= player_state_.position;

	var CollisionTraceClipResult collision_trace_clip_result=
		CollisionTraceAndClip(
			zmap_data,
			zvox_data,
			player_bbox,
			movement_start_position,
			movement_end_position );

	for( auto mut i= 0u; i < collision_trace_clip_result.num_clip_planes; ++i )
	{
		ClampPlayerVelocity( player_state_, collision_trace_clip_result.clip_plane_normals[i] );
	}

	player_state_.position= collision_trace_clip_result.position_clipped;

	var bool mut on_floor= false, mut collided_with_wall= false;

	for( auto mut i= 0u; i < collision_trace_clip_result.num_clip_planes; ++i )
	{
		var Vec3f& normal= collision_trace_clip_result.clip_plane_normals[i];
		var f32 normal_length= normal.Length();
		if( normal_length > 0.0f )
		{
			on_floor|= (-normal.z) / normal_length >= 0.7f;
		}

		collided_with_wall|= normal.z == 0.0f;
	}

	if( on_floor && collided_with_wall )
	{
		var Vec3f mut position_with_step_movement= movement_start_position;

		// Original game has steps with height 17.0f;
		var f32 constexpr c_step_height= 17.0f;

		// Try performing movement up.
		var Vec3f up_movement_vector( 0.0f, 0.0f, -c_step_height );

		var TraceCollisionResult up_trace_result=
			CollisionTrace( zmap_data, zvox_data, player_bbox, player_state_.position, up_movement_vector );

		if( up_trace_result.clipped_move_distance > 0.0f )
		{
			position_with_step_movement+= up_movement_vector * ust::min( up_trace_result.clipped_move_distance, 1.0f );

			var Vec3f side_movement_vector= movement_end_position - movement_start_position;

			var TraceCollisionResult
				forward_trace_result=
					CollisionTrace( zmap_data, zvox_data, player_bbox, player_state_.position, side_movement_vector );

			if( forward_trace_result.clipped_move_distance > 0.0f )
			{
				position_with_step_movement+= side_movement_vector * ust::min( forward_trace_result.clipped_move_distance, 1.0f );

				player_state_.position= position_with_step_movement;
			}
		}
	}
}

fn Game::ProcessStep( mut this )
{
	PerformPlayerStepMovement();

	if( entities_description_.empty() || mapa_way_data_.empty() )
	{
		return;
	}

	var EntitiesDescription& entities_description= entities_description_.try_deref();

	var MapaWayData& mapa_way_data= mapa_way_data_.try_deref();

	// Use index-based loop to be able to insert entities.
	for( auto mut entity_index= 0s; entity_index < entities_.size(); ++entity_index )
	{
		if( entities_[entity_index].empty() )
		{
			continue;
		}

		var bool mut need_to_remove_entity= false;
		var ust::optional</EntityState/> mut new_spawned_entity;

		{
			var EntityState &mut entity= entities_[entity_index].try_deref();

			var EntitiesDescription::EntityDescription& entity_description= entities_description.entities[ entity.kind ];

			// Perform operation transition (if necessary).

			{
				var EntitiesDescription::Operation& operation= entity_description.operations[ entity.current_operation ];

				// TODO - determine exact priorities of different operation transition conditions.

				if_var( &operation_control : operation.operation_control )
				{
					MoveEntity( entity, operation_control, mapa_way_data );

					// Always check if killed.
					if_var( &energy_loss : operation_control.energy_loss )
					{
						// Killed. Keep it first here (killed enemies should die).
						if( entity.lost_energy_in_current_operation )
						{
							entity.next_operation= u32( energy_loss[2] );
							entity.num_steps_left_to_next_operation= 0u;
						}
					}

					if( entity.next_operation == ~0u )
					{
						if_var( &player_visible : operation_control.player_visible )
						{
							if( entity.has_seen_player_in_current_operation )
							{
								entity.next_operation= u32( player_visible[2] );
								if( player_visible[1] < 0 )
								{
									entity.num_steps_left_to_next_operation= 0u;
								}
								else
								{
									var u32 period( player_visible[1] );
									entity.num_steps_left_to_next_operation= ( period - entity.num_steps_since_operation_start % period ) % period;
								}
							}
						}
					}
					if( entity.next_operation == ~0u )
					{
						if_var( &inside_shooting_zone_b : operation_control.inside_shooting_zone_b )
						{
							if( entity.player_is_inside_shooting_zone )
							{
								entity.next_operation= u32( inside_shooting_zone_b[2] );

								var u32 period( inside_shooting_zone_b[0] );
								entity.num_steps_left_to_next_operation= ( period - entity.num_steps_since_operation_start % period ) % period;
							}
						}
					}
					if( entity.next_operation == ~0u )
					{
						if_var( &convenient_position : operation_control.convenient_position )
						{
							if( entity.player_is_inside_shooting_zone )
							{
								entity.next_operation= u32( convenient_position[1] );

								var u32 period( convenient_position[0] );
								entity.num_steps_left_to_next_operation= ( period - entity.num_steps_since_operation_start % period ) % period;
							}
						}
					}
					if( entity.next_operation == ~0u )
					{
						if_var( &randomness : operation_control.randomness )
						{
							// Random state transition.
							var u32 period( randomness[0] );
							if( entity.num_steps_since_operation_start == period )
							{
								if( randomness[2] >= 0 && random_.Next() % 100u <= u32(randomness[1]) )
								{
									entity.next_operation= u32( randomness[2] );
									entity.num_steps_left_to_next_operation= 0u;
								}
								else if( randomness[4] >= 0 && random_.Next() % 100u <= u32(randomness[3]) )
								{
									entity.next_operation= u32( randomness[4] );
									entity.num_steps_left_to_next_operation= 0u;
								}
							}
						}
					}
					if( entity.next_operation == ~0u )
					{
						if_var( & timeout : operation_control.timeout )
						{
							// Timeout should be (generally) the last checked option.
							if( entity.num_steps_since_operation_start >= timeout[0] )
							{
								entity.next_operation= u32( timeout[1] );
								entity.num_steps_left_to_next_operation= 0u;
							}
						}
					}
				}

				if_var( &if_alive : operation.if_alive )
				{
					if( if_alive.time != 0u &&
						entity.num_steps_since_operation_start % if_alive.time == 0u )
					{
						entity.next_operation= ( entity.lost_energy_in_current_operation ? if_alive.new_operation[1] : if_alive.new_operation[0] );
						entity.num_steps_left_to_next_operation= 0u;
					}
				}

				if_var( &stopper : operation.stopper )
				{
					if( stopper.time != 0u &&
						entity.num_steps_since_operation_start % stopper.time == 0u )
					{
						entity.next_operation= stopper.new_operation;
						entity.num_steps_left_to_next_operation= 0u;
					}
				}

				if_var( &object_rotation : operation.object_rotation )
				{
					// Perform rotation.
					entity.azimuth= Convert1024Angle( f32( object_rotation.rotation ) ) * f32( entity.num_steps_since_operation_start );

					// It looks like object rotation also includes tomeout-based state transition.
					if( entity.next_operation == ~0u )
					{
						if( entity.num_steps_since_operation_start == object_rotation.time )
						{
							entity.next_operation= object_rotation.new_operation;
							entity.num_steps_left_to_next_operation= 0u;
						}
					}
				}

				if_var( &supply_drop : operation.supply_drop )
				{
					// Emit new entity if it's dropped.
					// This will increase the total amout of entities, but it's not a big deal,
					// since (generally) items are dropped only once and dropped items can't drop other items.

					if( entity.num_steps_since_operation_start == supply_drop.time )
					{
						if_var( &new_entity_description : entities_description.entities.find( supply_drop.special_object ) )
						{
							if( new_entity_description.operations.exists( c_start_operation ) )
							{
								new_spawned_entity.reset(
									EntityState
									{
										.kind= supply_drop.special_object,
										.position= entity.position,
										.azimuth= entity.azimuth,
										.current_operation= c_start_operation,
										.next_operation= ~0u,
										.num_steps_since_operation_start= 0u,
										.num_steps_left_to_next_operation= ~0u,
										.navigation_info_index= ~0u,
										.target_navigation_graph_node= ~0u,
										.current_navigation_graph_node= ~0u,
										.has_seen_player_in_current_operation= false,
										.player_is_inside_shooting_zone= false,
										.lost_energy_in_current_operation= false,
										.animation_frames= zero_init, // Set exact frames later.
									} );
							}
						}
					}
				}

				if( !operation.box_contents.empty() )
				{
					// This entity can be picked-up.
					// TODO - identify exact radius and center.
					var f32 c_pickup_distance= 48.0f;
					var f32 square_distance= ( player_state_.position - entity.position ).SquareLength();
					if( square_distance < c_pickup_distance * c_pickup_distance )
					{
						// Despawn this entity, since it was picked-up.
						// TODO - give the picked-up item to the player.
						// TODO - avoid picking-up if player has maximum number of items provided by this entity.
						// TODO - handle regenerating entities in multiplayer.
						need_to_remove_entity= true;
					}
				}

				if( entity.next_operation != ~0u && entity.num_steps_left_to_next_operation == 0u )
				{
					if( entity_description.operations.exists( entity.next_operation ) )
					{
						entity.current_operation= entity.next_operation;
						entity.next_operation= ~0u;
						entity.num_steps_since_operation_start= 0u;
						entity.num_steps_left_to_next_operation= ~0u;
						entity.has_seen_player_in_current_operation= false;
						entity.player_is_inside_shooting_zone= false;
						entity.lost_energy_in_current_operation= false;
					}
					else
					{
						// Remove this entity if non-existing operation is specified.
						// This is used by some entities which should be completely destroyed.
						need_to_remove_entity= true;
					}
				}
			}

			// Calculate current frame based on animation params.
			// TODO - perform different animation logic for different animation kinds.

			var EntitiesDescription::Operation& operation= entity_description.operations[ entity.current_operation ];

			foreach( pair :
				ust::array_view_imut</EntitiesDescription::OperationAnimationDescription/>( operation.animations ).iter().zip(
					ust::array_view_mut</u32/>( entity.animation_frames ).iter() ) )
			{
				var EntitiesDescription::OperationAnimationDescription& operation_animation_description= pair.first;

				var u32 animation_step=
					operation_animation_description.start_step +
					entity.num_steps_since_operation_start % ust::max( 1u, operation_animation_description.num_steps );

				pair.second= animation_step / c_num_steps_per_animation_frame;
			}

			// Increase/decrease step counters after doing any other logic.
			// It's needed in order to make results (like animation frame) of step #0 observable.

			++entity.num_steps_since_operation_start;
			if( entity.num_steps_left_to_next_operation > 0u )
			{
				--entity.num_steps_left_to_next_operation;
			}
		}

		if( need_to_remove_entity )
		{
			entities_[ entity_index ].reset();
		}

		// Push new entity into the container.
		// It's necessary to process it later (within current update step).
		if( !new_spawned_entity.empty() )
		{
			entities_.push_back( new_spawned_entity.try_take() );
		}
	}
}

fn Game::GetNearestEntity( mut this, Vec3f& pos ) : ust::optional_ref_mut</EntityState/> @( ust::reference_notation::return_inner_references::param0 )
{
	var size_type mut nearest_index= entities_.size();
	var f32 mut min_square_distance= 1.0e64f;

	for( auto mut i= 0s; i < entities_.size(); ++i )
	{
		if_var( &entity : entities_[i] )
		{
			var f32 square_distace= ( pos - entity.position ).SquareLength();
			if( square_distace < min_square_distance )
			{
				min_square_distance= square_distace;
				nearest_index= i;
			}
		}
	}

	if( nearest_index >= entities_.size() )
	{
		return ust::null_optional_ref;
	}

	return entities_[ nearest_index ].as_ref();
}

fn MoveEntity(
	EntityState &mut entity,
	EntitiesDescription::OperationControl& operation_control,
	MapaWayData& mapa_way_data )
{
	if( operation_control.speed == 0u )
	{
		// Do not move if has zero speed. TODO - maybe still allow rotation?
		return;
	}

	if( size_type( entity.navigation_info_index ) >= mapa_way_data.navigation_graphs.size() )
	{
		return;
	}

	var MapaWayNavigationGraph& navigation_graph= mapa_way_data.navigation_graphs[ size_type( entity.navigation_info_index ) ];

	if( navigation_graph.num_nodes == 0u )
	{
		return;
	}

	if( entity.target_navigation_graph_node == ~0u )
	{
		// Select a target if has no one.
		// TODO - perform target selection depending on movement mode.
		for( auto mut i= 0u; i < navigation_graph.num_nodes; ++i )
		{
			if( navigation_graph.nodes[i].unknown3 == -1 )
			{
				entity.target_navigation_graph_node= i;
				break;
			}
		}
	}

	if( entity.target_navigation_graph_node == ~0u )
	{
		return;
	}

	if( entity.current_navigation_graph_node == ~0u )
	{
		// Attach to the navigation graph if has no current node.
		// TODO - maybe do this in cases where current position is way too far away from the current node?
		var u32 mut nearest_node_index= ~0u;
		var f32 mut nearest_node_square_distance= 1.0e64f;
		for( auto mut i= 0u; i < navigation_graph.num_nodes; ++i )
		{
			var MapaWayNavigationGraphNode& node= navigation_graph.nodes[i];
			var Vec3f vec_to_node= entity.position - Vec3f( f32( node.position[0] ), f32( node.position[1] ), f32( node.position[2] ) );
			var f32 square_distance_to_node= vec_to_node.SquareLength();
			if( square_distance_to_node < nearest_node_square_distance )
			{
				nearest_node_square_distance= square_distance_to_node;
				nearest_node_index= i;
			}
		}
		entity.current_navigation_graph_node= nearest_node_index;
	}

	// Perform lookup from routing matrix to find next waypoint node which will eventually lead to the target node.
	var u32 waypoint_node_index=
		( entity.current_navigation_graph_node == entity.target_navigation_graph_node
			? entity.target_navigation_graph_node
			: u32 ( navigation_graph.routing_matrix[ entity.current_navigation_graph_node ][ entity.target_navigation_graph_node ] ) );

	var MapaWayNavigationGraphNode& waypoint_node= navigation_graph.nodes[ waypoint_node_index ];

	var f32 mut move_fraction= 1.0f;

	// Use 2d calculation for vector to waypoint - ignore some Z difference.
	var Vec2f vec_to_waypoint= entity.position.xy() - Vec2f( f32( waypoint_node.position[0] ), f32( waypoint_node.position[1] ) );
	var f32 square_distance_to_waypoint= vec_to_waypoint.SquareLength();

	if( square_distance_to_waypoint != 0.0f )
	{
		// Perform smooth turn towards the waypoint node.

		var f32 target_azimuth= ust::atan2( vec_to_waypoint.x, -vec_to_waypoint.y );

		var f32 mut angle_delta= ( ( entity.azimuth - target_azimuth ) % c_tau + c_tau ) % c_tau;

		// Prefer shortest turn, but slightly biased, in order to avoid some nasty behavior with constantly changing turning direction.
		if( angle_delta > c_tau * 0.55f )
		{
			angle_delta -= c_tau;
		}

		if( angle_delta < -c_entity_turn_speed )
		{
			move_fraction= 0.0f; // Don't move if turn.
			entity.azimuth+= c_entity_turn_speed;
		}
		else if( angle_delta > c_entity_turn_speed )
		{
			move_fraction= 0.0f; // Don't move if turn.
			entity.azimuth-= c_entity_turn_speed;
		}
		else
		{
			move_fraction= 1.0f - ust::abs( angle_delta ) / c_entity_turn_speed;
			entity.azimuth= target_azimuth;
		}
	}

	var f32 base_move_distance= f32( operation_control.speed ) * c_entity_speed_scale;

	// If we perform a turn don't move.
	// We should move only directly towards the target, otherwise we can encount various problems with target reaching.
	var f32 move_distance= base_move_distance * move_fraction;

	// Perform movement towards current direction.
	var Vec3f direction_vector( -ust::sin(entity.azimuth), ust::cos(entity.azimuth), 0.0f );
	entity.position+= direction_vector * move_distance;

	if( square_distance_to_waypoint <= base_move_distance * base_move_distance )
	{
		// Reached the waypoint.
		// Mark it as current node.
		entity.current_navigation_graph_node= waypoint_node_index;

		if( waypoint_node_index == entity.target_navigation_graph_node )
		{
			// Reached the target node - select new one.
			// TODO - perform target selection depending on movement mode.

			var u32 mut next_node_index= ~0u;
			for( auto mut i= entity.target_navigation_graph_node + 1u; i < navigation_graph.num_nodes; ++i )
			{
				if( navigation_graph.nodes[i].unknown3 == -1 )
				{
					next_node_index= i;
					break;
				}
			}

			if( next_node_index == ~0u )
			{
				for( auto mut i= 0u; i < navigation_graph.num_nodes; ++i )
				{
					if( navigation_graph.nodes[i].unknown3 == -1 )
					{
						next_node_index= i;
						break;
					}
				}
			}

			entity.target_navigation_graph_node= next_node_index;
		}
	}
}

fn ApplyPlayerMovement(
	PlayerState &mut player_state,
	f32 azimuth,
	Vec3f& move_wish_direction )
{
	// TODO - tune max speed or even read it from entities description config.
	var f32 constexpr max_horizontal_speed_per_step= 320.0f / c_steps_per_second;
	var f32 constexpr max_vertical_speed_per_step= 1024.0f / c_steps_per_second;

	var f32 constexpr num_steps_to_max_speed= 0.3f * c_steps_per_second;

	// Acceleration is twice as big as deceleration, it's needed because deceleration is always applied.
	var f32 constexpr horizontal_acceleration_per_step= max_horizontal_speed_per_step / num_steps_to_max_speed * 2.0f;
	var f32 constexpr horizontal_deceleation_per_step= max_horizontal_speed_per_step / num_steps_to_max_speed;

	var f32 constexpr vertical_deceleration_per_step= horizontal_deceleation_per_step;

	var Vec3f forward_vector( -ust::sin(azimuth), ust::cos(azimuth), 0.0f );
	var Vec3f right_vector( ust::cos(azimuth), ust::sin(azimuth), 0.0f );
	var Vec3f down_vector( 0.0f, 0.0f, 1.0f );

	var Vec3f move_vector_transformed=
		move_wish_direction.x * forward_vector +
		move_wish_direction.y * right_vector +
		move_wish_direction.z * down_vector;

	player_state.velocity+= move_vector_transformed * horizontal_acceleration_per_step;

	{
		// Apply horizontal deceleration and limit horizontal speed if necessary.
		// TODO - apply friction depending on current state (on ground/in air).
		var Vec2f mut horizontal_velocity= player_state.velocity.xy();
		var f32 speed= horizontal_velocity.Length();
		if( speed > 0.0f )
		{
			var f32 new_speed= speed - horizontal_deceleation_per_step;
			var f32 new_speed_clamped= ust::max( 0.0f, ust::min( new_speed, max_horizontal_speed_per_step ) );
			horizontal_velocity= horizontal_velocity * ( new_speed_clamped / speed );
			player_state.velocity.x= horizontal_velocity.x;
			player_state.velocity.y= horizontal_velocity.y;
		}
	}

	{
		// Apply vertical deceleration and limit vertical speed if necessary.
		// TODO - use vertical deceleration only in noclip mode, in normal case use only gravity.
		var f32 speed= ust::abs( player_state.velocity.z );
		if( speed > 0.0f )
		{
			var f32 new_speed= speed - vertical_deceleration_per_step;
			var f32 new_speed_clamped= ust::max( 0.0f, ust::min( new_speed, max_vertical_speed_per_step ) );
			player_state.velocity.z= player_state.velocity.z * (new_speed_clamped / speed);
		}
	}

	player_state.position+= player_state.velocity;
}

fn ClampPlayerVelocity( PlayerState &mut player_state, Vec3f& prohibited_movement_direction )
{
	var f32 dot= player_state.velocity.Dot( prohibited_movement_direction );
	if( dot < 0.0f )
	{
		player_state.velocity-= prohibited_movement_direction * ( dot / prohibited_movement_direction.SquareLength() );
	}
}

// The original game uses angles in range 0 to 1024 mapped to 0 to tau and with negative sign.
fn Convert1024Angle( f32 a ) : f32
{
	return a * ( c_tau / -1024.0f );
}

fn GetCameraPositionForPlayer( PlayerState& player_state ) : Vec3f
{
	// Offset camera slightly relative to the player's position.
	// TODO - use also slight horisontal shift as the original game does.
	return player_state.position + Vec3f( 0.0f, 0.0f, c_camera_z_offset );
}

fn GetPlayerColliderBBox() : BBox3f
{
	// TODO - read these dimensions from the current entities description file.
	return BBox3f
	{
		.min( -14.0f, -14.0f,  0.0f ),
		.max(  14.0f,  14.0f, 64.0f ),
	};
}

// TODO - investigate exact step rate in the original game.
var f32 c_steps_per_second= 30.0f;

// Model animation frames are sparce - for each 2 logic steps there is only one frame.
var u32 c_num_steps_per_animation_frame= 2u;

var u32 c_player_entity_index= 0u;

var u32 c_start_operation= 0u; // Start with operation 0.

// Speed values for entities are somewhat scaled. Scale them down.
// This value is experementally-found.
// TODO - check if it's really correct.
var f32 c_entity_speed_scale= 1.0f / 4.0f;

// Experimental value.
// TODO - fiund how it's exactly specified. Maybe it depends on current speed?
var f32 c_entity_turn_speed= c_tau / 30.0f;

var f32 c_camera_z_offset= -48.0f;

} // namespace PM
