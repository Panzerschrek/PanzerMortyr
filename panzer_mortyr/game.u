import "/common_lib/string_utils.uh"
import "game.uh"

namespace PM
{

fn Game::constructor( CachingGameResourcesLoaderPtr mut caching_game_resources_loader_ptr )
	(
		caching_game_resources_loader_ptr_= move( caching_game_resources_loader_ptr ),
		current_map_index_= 0u, // Set later.
		camera_controller_( Vec3f( 0.0f, 0.0f, 0.0f )  ) )
{
	auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	var GameResourcePtr</GameParams/> game_params_ptr= caching_game_resources_loader.LoadGameParams();

	current_map_index_= game_params_ptr.deref().start_map;

	var GameResourcePtr</MapsDescription/> maps_description_ptr= caching_game_resources_loader.LoadMapsDescription();
	var MapsDescription::MapDescription& map_description= maps_description_ptr.deref().maps[ current_map_index_ ]; // Halts if no map found.

	var GameResourcePtr</EntitiesDescription/> entities_description_ptr=
		caching_game_resources_loader.LoadEntitiesDescription( ConvertToUppercase( map_description.entities_info_file ) );

	zpoz_data_= caching_game_resources_loader.LoadZpozFile( current_map_index_ );
}

fn Game::GetCurrentMapIndex( this ) : u32
{
	return current_map_index_;
}

fn Game::Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state )
{
	camera_controller_.Update( time_delta_s, keyboard_state );
}

fn Game::GetWorldDrawingInfo( this ) : WorldDrawingInfo
{
	var ust::vector</WorldDrawingInfo::ModelObject/> mut model_objects;

	if( !zpoz_data_.empty() )
	{
		foreach( &entity : zpoz_data_.try_deref().entities )
		{
			if( entity.alive_flag == 0u16 )
			{
				continue;
			}

			model_objects.push_back(
				WorldDrawingInfo::ModelObject
				{
					.position( f32( entity.position[0] ), f32( entity.position[1] ), f32( entity.position[2] ) ),
				} );
		}
	}

	return WorldDrawingInfo
	{
		.map_index= current_map_index_,
		.camera_position= camera_controller_.GetPos(),
		.camera_azimuth= camera_controller_.GetAzimuth(),
		.camera_elevation= camera_controller_.GetElevation(),
		.model_objects= move(model_objects)
	};
}

} // namespace PM
