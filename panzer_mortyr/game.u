import "game.uh"

namespace PM
{

fn Game::constructor()
	( camera_controller_( Vec3f( 0.0f, 0.0f, 0.0f )  ) )
{
}

fn Game::Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state )
{
	camera_controller_.Update( time_delta_s, keyboard_state );
}

fn Game::GetWorldDrawingInfo( this ) : WorldDrawingInfo
{
	return WorldDrawingInfo
	{
		.camera_position= camera_controller_.GetPos(),
		.camera_azimuth= camera_controller_.GetAzimuth(),
		.camera_elevation= camera_controller_.GetElevation()
	};
}

} // namespace PM
