import "/hash_map.u"
import "/string.u"

namespace PM
{

struct EntitiesDescription
{
	// TODO - consider using vector instead of hash-map, since all or almost all keys are sequential.

	ust::hash_map</u32, AnimationDescription/> animations;

	// Contains mapping of entity to animation.
	// Entities with numbers -1 and 0 aren't listed, since more than one animation are assigned to them.
	ust::hash_map</u32, u32/> entity_index_to_animation_index;

	ust::hash_map</u32, EntityDescription/> entities;

	struct AnimationDescription
	{
		ust::string8 model_file_name;
		i32 entity_index;
	}

	// TODO - identify and rename remaining structs and fields to english.

	// TODO - identify default values for all these parameters.

	struct EntityDescription
	{

		u32 energy= 0u; // Looks like health
		u32 aggression= 0u;
		u32 podatn= 0u; // ???
		u32 osona= 0u;
		u32 mode= 0u; // "tryb"
		ust::string8 name;

		[ u32, 4 ] param_akt[ 0u, 0u, 0u, 0u ];
		u32 panic= 0u;
		u32 search_for_health_kits= 0u;
		u32 search_for_ammunition= 0u; // Seems to be boolean.
		u32 ammunition= 0u;
		u32 damage_randomness= 0u; // Seems to be in percents.
		u32 another_attack= 0u; // Seems to be boolean.
		u32 hold_on_distance= 0u;
		u32 disable_reduction= 0u; // Seems to be boolean.
		u32 standard_sounds= 1u; // Seems to be boolean.

		ust::hash_map</u32, Operation/> operations;
	}

	struct Operation
	{
		ForwardAnimation forward_animation;
		ForwardAnimation rotation_animation;
		ForwardAnimation icon_animation;
		ForwardAnimation krajobraz;
		Stoper stoper;
		ObrotObiektu obrot_obiektu;
		Sternik sternik;
		Swiatlo swiatlo;
		Dymek dymek;
		EmisjaZapasow emisja_zapasow;
		RuchObiektu ruch_obiektu;
		ObrotDocelowy obrot_docelowy;
		JesliZyje jesli_zyje;
		ZawartoscSkrzynki zawartosc_skrzynki;
		WybuchBenzyny wybuch_benzyny;
		Zarowka zarowka;
		ZarowkaGasnaca zarowka_gasnaca;
		Odglos odglos;
		EmisjaDymu emisja_dymu;
	}

	struct ForwardAnimation
	{
		u32 animation_number= 0u;

		// These values are in frames or half-frames.
		u32 start_step= 0u;
		u32 num_steps= 0u;

		i32 add_x= 0;
		i32 add_y= 0;
		i32 add_z= 0;

		i32 center_x= 0;
		i32 center_y= 0;
		i32 center_z= 0;

		u32 activity= 0u;
		u32 mask= 0u;
	}

	struct Stoper
	{
		u32 czas= 0u;
		u32 nowa_op= 0u;
	}

	struct ObrotObiektu
	{
		u32 rotacja= 0u;
		u32 czas= 0u;
		u32 nowa_op= 0u;
	}

	struct Sternik
	{
		u32 tryb_pracy= 0u;
		u32 szybkosc= 0u;
		u32  obrot= 0u;
		[ u32, 3 ] w_zasiegu_strzalu_b[ 0u, 0u, 0u ];
		[ u32, 3 ] utrata_energi[ 0u, 0u, 0u ];
		[ u32, 2 ] timeout[ 0u, 0u ];
		[ i32, 5 ] przedmiot[ 0, 0, 0, 0, 0 ];
	}

	struct Swiatlo
	{
		i32 wspx= 0;
		i32 wspy= 0;
		i32 wspz= 0;
		u32 czas= 0u;
		u32 kolor= 0u;
		u32 moc= 0u;
		u32 delta= 0u;
	}

	struct Dymek
	{
		i32 wspx= 0;
		i32 wspy= 0;
		i32 wspz= 0;
		u32 czas= 0u;
		u32 ilosc= 0u;
		u32 delta= 0u;
	}

	struct EmisjaZapasow
	{
		u32 czas= 0u;
		u32 los_energia= 0u;
		u32 los_oslona= 0u;
		u32 los_bron= 0u;
		u32 los_ammo= 0u;
		u32 ob_specjalny= 0u;
	}

	struct RuchObiektu
	{
		i32 szybkosc= -1;
		u32 add_kier= 0u;
	}

	struct ObrotDocelowy
	{
		u32 krok= 0u;
		u32 cel_kier= 0u;
	}

	struct JesliZyje
	{
		u32 czas= 0u;
		[ u32, 2 ] nowa_op[ 0u, 0u ];
	}

	struct ZawartoscSkrzynki
	{
		ust::string8 przedmiot;
		u32 ilosc= 0u;
		u32 aktywizacja= 0u;
		i32 ammotyp= 0;
		u32 ammo= 0u;
		u32 efekt= 0u;
		u32 klucz= 0u;
		u32 zapas= 0u;
	}

	struct WybuchBenzyny
	{
		[ i32, 3 ] wybuch_a[ 0, 0, 0 ];
		[ i32, 3 ] wybuch_b[ 0, 0, 0 ];
		[ i32, 3 ] wybuch_c[ 0, 0, 0 ];
		[ i32, 4 ] plomienie[ 0, 0, 0, 0 ];
		[ u32, 2 ] pole_razenia[ 0u, 0u ];
	}

	struct Zarowka
	{
		u32 moc= 0u;
	}

	struct ZarowkaGasnaca
	{
		[ i32, 5 ] parametry[ 0, 0, 0, 0, 0 ];
	}

	struct Odglos
	{
		u32 rodzaj= 0u;
		u32 moc= 0u;
	}

	struct EmisjaDymu
	{
		i32 pos_x= 0;
		i32 pos_y= 0;
		i32 pos_z= 0;
		i32 velocity_x= 0;
		i32 velocity_y= 0;
		i32 velocity_z= 0;
		u32 and_czas= 0u;
		u32 model_dymu= 0u;
	}
}

fn ParseEntitiesDescriptionFile( ust::string_view8 file_contents ) : EntitiesDescription;

} // namespace PM
