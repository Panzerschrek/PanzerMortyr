import "/hash_map.u"
import "/string.u"

namespace PM
{

struct EntitiesDescription
{
	ust::hash_map</u32, AnimationDescription/> animations;

	ust::hash_map</u32, EntityDescription/> entities;

	struct AnimationDescription
	{
		ust::string8 model_file_name;
		u32 entity_index;
	}

	struct EntityDescription
	{
		// TODO - identify and rename remaining fields to english.
		// TODO - identify default values of some of these parameters.

		u32 energy= 0u; // Looks like health
		u32 aggression= 0u;
		u32 podatn= 0u; // ???
		u32 osona= 0u;
		u32 mode= 0u; // "tryb"
		ust::string8 name;

		u32 panic= 0u;
		u32 search_for_health_kits= 0u;
		u32 search_for_ammunition= 0u; // Seems to be boolean.
		u32 ammunition= 0u;
		u32 damage_randomness= 0u; // Seems to be in percents.
		u32 another_attack= 0u; // Seems to be boolean.
		u32 hold_on_distance= 0u;
		u32 disable_reduction= 0u; // Seems to be boolean.
		u32 standard_sounds= 1u; // Seems to be boolean.

		ust::hash_map</u32, Operation/> operations;
	}

	struct Operation
	{
		ForwardAnimation forward_animation;
	}

	struct ForwardAnimation
	{
		u32 animation_number= 0u;

		// These values are in frames or half-frames.
		u32 start_step= 0u;
		u32 num_steps= 0u;

		i32 add_x= 0;
		i32 add_y= 0;
		i32 add_z= 0;

		i32 center_x= 0;
		i32 center_y= 0;
		i32 center_z= 0;

		u32 activity= 0u;
		u32 mask= 0u;
	}
}

fn ParseEntitiesDescriptionFile( ust::string_view8 file_contents ) : EntitiesDescription;

} // namespace PM
