import "/hash_map.u"
import "/string.u"

namespace PM
{

struct EntitiesDescription
{
	ust::hash_map</u32, AnimationDescription/> animations;

	ust::hash_map</u32, EntityDescription/> entities;

	struct AnimationDescription
	{
		ust::string8 model_file_name;
		u32 entity_index;
	}

	struct EntityDescription
	{
		// TODO - identify and rename remaining fields to english.
		// TODO - identify default values of some of these parameters.

		u32 energy= 0u; // Looks like health
		u32 aggression= 0u;
		u32 podatn= 0u; // ???
		u32 osona= 0u;
		u32 mode= 0u; // "tryb"
		ust::string8 name;

		u32 panika= 0u;
		u32 szukaj_apteczek= 0u;
		u32 szukaj_amunicji= 0u;
		u32 ilosc_amunicji= 0u;
		u32 losowosc_zranienia= 0u;
		u32 ponowny_atak= 0u;
		u32 trzymaj_dystans= 0u;
		u32 zabron_redukcji= 0u;
		u32 standardowe_odglosy= 1u;
	}
}

fn ParseEntitiesDescriptionFile( ust::string_view8 file_contents ) : EntitiesDescription;

} // namespace PM
