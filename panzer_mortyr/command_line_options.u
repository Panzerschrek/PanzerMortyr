import "/number_parsing.iu"
import "/stdout.iu"
import "/common_lib/game_params_file.iu"
import "command_line_options.iu"

namespace PM
{

fn ParseCommandLineOptions( ust::array_view_imut</ust::string_view8/> args ) : CommandLineOptions
{
	var CommandLineOptions mut command_line_options;

	for( auto mut i= 1s; i < args.size(); ++i )
	{
		var ust::string_view8 arg= args[i];

		// If this code is changed, don't forget to update the help message!

		if( arg == "-h" || arg == "--help" )
		{
			ust::stdout_print( c_help_message );
			command_line_options.need_quit= true;
		}
		else if( arg == "--new-game" )
		{
			command_line_options.new_game= true;
		}
		else if( arg == "--config" )
		{
			if( i + 1s < args.size() )
			{
				command_line_options.settings_file_path= args[ i + 1s ];
				++i;
			}
			else
			{
				ust::stderr_print( "Expected an argument after \"--config\"!\n" );
				command_line_options.need_quit= true;
			}
		}
		else if( arg == "--game-directory" )
		{
			if( i + 1s < args.size() )
			{
				command_line_options.custom_game_installation_directory_path= args[ i + 1s ];
				++i;
			}
			else
			{
				ust::stderr_print( "Expected an argument after \"--game-directory\"!\n" );
				command_line_options.need_quit= true;
			}
		}
		else if( arg== "--map" )
		{
			if( i + 1s < args.size() )
			{
				if_var( n : ust::parse_number_exact</u32/>( args[ i + 1s ] ) )
				{
					command_line_options.start_map= n;
				}
				else
				{
					ust::stderr_print( "Failed to parse map index!\n" );
					command_line_options.need_quit= true;
				}
				++i;
			}
			else
			{
				ust::stderr_print( "Expected an argument after \"--map\"!\n" );
				command_line_options.need_quit= true;
			}
		}
		else if( arg == "--skill" )
		{
			if( i + 1s < args.size() )
			{
				if_var( n : ust::parse_number_exact</u32/>( args[ i + 1s ] ) )
				{
					if( n < c_num_skill_levels )
					{
						command_line_options.skill= n;
					}
					else
					{
						ust::stdout_print( "Invalid skill number!\n" );
						command_line_options.need_quit= true;
					}
				}
				else
				{
					ust::stderr_print( "Failed to parse skill index!\n" );
					command_line_options.need_quit= true;
				}
				++i;
			}
			else
			{
				ust::stderr_print( "Expected an argument after \"--skill\"!\n" );
				command_line_options.need_quit= true;
			}
		}
		else
		{
			ust::stderr_print( ust::concat(" Unrecognized command-line option \"", arg, "\"!\n" ) );
			command_line_options.need_quit= true;
		}
	}

	return command_line_options;
}

auto c_help_message=
"PanzerMortyr - a recreation of \"Mortyr 2093 - 1944\" engine.\n" +
"\n" +
"OPTIONS:\n" +
"\n" +
"  -h, --help         - show this message\n" +
"  --new-game         - start a new game\n" +
"  --map <number>     - start playing a map with given number\n" +
"  --skill <number>   - set skill level used for \"--new-game\" and \"--map\" commands\n" +
"  --config           - set path of the config file\n" +
"  --game-directory   - set path to the game directory\n"
;

} // namespace PM
