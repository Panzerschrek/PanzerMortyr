import "/integer_parsing.u"
import "/stdout.u"
import "command_line_options.uh"

namespace PM
{

fn ParseCommandLineOptions( ust::array_view_imut</ust::string_view8/> args ) : CommandLineOptions
{
	var CommandLineOptions mut command_line_options;

	for( auto mut i= 1s; i < args.size(); ++i )
	{
		if( args[i] == "--new-game" )
		{
			command_line_options.new_game= true;
		}
		if( args[i] == "--config" && i + 1s < args.size() )
		{
			command_line_options.settings_file_path= args[ i + 1s ];
			++i;
		}
		if( args[i] == "--map" && i + 1s < args.size() )
		{
			if_var( n : ust::parse_integer_exact</u32/>( args[ i + 1s ] ) )
			{
				command_line_options.start_map= n;
			}
			else
			{
				ust::stderr_print( "Failed to parse map index!\n" );
			}
			++i;
		}
	}

	return command_line_options;
}

} // namespace PM
