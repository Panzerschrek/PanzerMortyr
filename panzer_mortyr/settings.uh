import "/path.u"
import "/shared_ptr.u"
import "console_out.uh"

namespace PM
{

type SettingsPtr= ust::shared_ptr_mut</Settings/>;

struct Settings
{
	u32 r_screen_width= 1024u;
	u32 r_screen_height= 768u;

	bool r_fullbright= false;
}

auto& c_default_settings_file_name= "panzer_mortyr.cfg";

fn LoadSettings( ust::filesystem_path_view file_path, ConsoleOutPtr& console_out ) : SettingsPtr;

fn SaveSettings( Settings& settings, ust::filesystem_path_view file_path, ConsoleOutPtr& console_out );

} // namespace PM
