	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		var ust::string_view8 current_line= parsing_state.current_line.try_deref();

		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( current_line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "czas" )
		{
			ExtractValue( alarm_area.czas, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "odglos" )
		{
			ExtractValue( alarm_area.odglos, words_it );
			parsing_state.NextLine();
		}
		else
		{
			break;
		}

		// HACK! Leave this function if we have "odglos" with ";" at end - in order to be able to parse "odglos" on operation level.
		if( !current_line.empty() && current_line.back() == ';' )
		{
			break;
		}
	}

	return alarm_area;
}

