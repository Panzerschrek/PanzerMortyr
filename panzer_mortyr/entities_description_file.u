		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "anim_nr" )
		{
			ExtractValue( operation_animation.animation_number, words_it );

			if( words_it.next() == ust::string_view8( "start" ) )
			{
				ExtractValue( operation_animation.start_step, words_it );
			}

			if( words_it.next() == ust::string_view8( "liczba_obr" ) )
			{
				ExtractValue( operation_animation.num_steps, words_it );
			}

			parsing_state.NextLine();
		}
		else if( first_word == "add_x" )
		{
			ExtractValue( operation_animation.bounding_box_center_x, words_it );

			if( words_it.next() == ust::string_view8( "add_y" ) )
			{
				ExtractValue( operation_animation.bounding_box_center_y, words_it );
			}

			if( words_it.next() == ust::string_view8( "add_z" ) )
			{
				ExtractValue( operation_animation.bounding_box_center_z, words_it );
			}

			parsing_state.NextLine();
		}
		else if( first_word == "szer_x" )
		{
			ExtractValue( operation_animation.bounding_box_half_size_x, words_it );

			if( words_it.next() == ust::string_view8( "szer_y" ) )
			{
				ExtractValue( operation_animation.bounding_box_half_size_y, words_it );
