		if( first_word_opt.empty() )
		{
			parsing_state.current_line= parsing_state.it.next();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "czas" )
		{
			if_var( s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( s ) )
				{
					alarm_area.czas= n;
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "odglos" )
		{
			if_var( s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</i32/>( s ) )
				{
					alarm_area.odglos= n;
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else
		{
			break;
		}

		// HACK! Leave this function if we have "odglos" with ";" at end - in order to be able to parse "odglos" on operation level.
		if( !current_line.empty() && current_line.back() == ';' )
		{
			break;
		}
	}

	return alarm_area;
}

} // namespace PM
