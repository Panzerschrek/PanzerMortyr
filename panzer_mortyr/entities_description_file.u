import "/number_parsing.iu"
import "/stdout.iu"
import "/common_lib/string_iterators.iu"
import "entities_description_file.iu"

namespace PM
{

fn ParseEntitiesDescriptionFile( ust::string_view8 file_contents ) : EntitiesDescription
{
	var EntitiesDescription mut entities_description;

	var ParsingState mut parsing_state{ .it= ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) };

	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" || first_word == "//" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "end" || first_word == "eof" )
		{
			break;
		}
		else if( first_word == "numer_animacji_ptak" )
		{
			if( words_it.next() == ust::string_view8( "=" ) )
			{
				ExtractValue( entities_description.bird_animation_index, words_it );
			}
			parsing_state.NextLine();
		}
		else if( first_word == "numer_animacji_szczur" )
		{
			if( words_it.next() == ust::string_view8( "=" ) )
			{
				ExtractValue( entities_description.rat_animation_index, words_it );
			}
			parsing_state.NextLine();
		}
		else if( first_word == "numer_animacji_gracz" )
		{
			if( words_it.next() == ust::string_view8( "=" ) )
			{
				ExtractValue( entities_description.player_animation_index, words_it );
			}
			parsing_state.NextLine();
		}
		else if( first_word == "postac_sieciowa_k" )
		{
			// TODO
			parsing_state.NextLine();
		}
		else if( first_word == "postac_sieciowa_m" )
		{
			// TODO
			parsing_state.NextLine();
		}
		else if( first_word == "skin" )
		{
			// TODO
			parsing_state.NextLine();
		}
		else if( first_word == "plik_anim" )
		{
			auto [ animation_index, mut animation ]= ParseAnimation( parsing_state );
			var size_type animation_index_s( animation_index );

			if( animation_index_s >= 256s )
			{
				ust::stderr_print( "Too high animation number!\n" );
				move(animation);
			}
			else if( animation_index_s == entities_description.animations.size() )
			{
				entities_description.animations.push_back( move(animation) );
			}
			else
			{
				if( animation_index_s > entities_description.animations.size() )
				{
					entities_description.animations.resize(
						animation_index_s + 1s,
						EntitiesDescription::AnimationDescription{ .model_file_name= zero_init, .entity_index= -1 } );
				}
				entities_description.animations[ animation_index_s ]= move(animation);
			}

		}
		else if( first_word == "aktor" )
		{
			auto [ entity_index, mut entity_description ]= ParseEntity( parsing_state );
			var size_type entity_index_s( entity_index );

			if( entity_index_s >= 256s )
			{
				ust::stderr_print( "Too high entity number!\n" );
				move(entity_description);
			}
			else if( entity_index_s == entities_description.entities.size() )
			{
				entities_description.entities.push_back( move(entity_description) );
			}
			else
			{
				if( entity_index_s > entities_description.entities.size() )
				{
					entities_description.entities.resize( entity_index_s + 1s );
				}
				entities_description.entities[ entity_index_s ]= move(entity_description);
			}
		}
		else if( first_word == "narzedzie" )
		{
			auto [ tool_index, mut tool ]= ParseTool( parsing_state );
			var size_type tool_index_s( tool_index );

			if( tool_index_s > 64s )
			{
				ust::stderr_print( "Too high tool number!\n" );
				move(tool);
			}
			else if( tool_index_s == entities_description.tools.size() )
			{
				entities_description.tools.push_back( move(tool) );
			}
			else
			{
				if( tool_index_s > entities_description.tools.size() )
				{
					entities_description.tools.resize( tool_index_s + 1s );
				}
				entities_description.tools[ tool_index_s ]= move(tool);
			}
		}
		else
		{
			ust::stdout_print( ust::concat( "Unknown top-level token \"", first_word, "\"!\n" ) );
			parsing_state.NextLine();
		}
	}

	foreach( &mut i : entities_description.tool_type_to_index_map )
	{
		i= ~0u;
	}

	for( auto mut i= 0s; i < entities_description.tools.size(); ++i )
	{
		var EntitiesDescription::ToolType tool_type= entities_description.tools[i].tool_type;

		// In some configs more than one tool description may be specified for a single tool.
		// In such cases use only the first one.

		var u32 &mut index= entities_description.tool_type_to_index_map[ size_type( tool_type ) ];
		if( index == ~0u )
		{
			index= u32(i);
		}
	}

	return entities_description;
}

struct ParsingState
{
	ust::optional</ ust::string_view8 /> @( "a" ) current_line;
	ust::iterator</ LinesRawIterator /> @( "a" ) it;

	fn NextLine( mut this )
	{
		current_line= it.next();
	}
}

fn ParseAnimation( ParsingState &mut parsing_state ) : tup[ u32, EntitiesDescription::AnimationDescription ]
{
	var EntitiesDescription::AnimationDescription mut animation{ .model_file_name= zero_init, .entity_index= -1 };

	var u32 mut animation_index= 0u;

	auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.deref_or( ust::string_view8() ) ) );

	if( words_it.next() == ust::string_view8( "plik_anim" ) && words_it.next() == ust::string_view8( "=" ) )
	{
		ExtractValue( animation.model_file_name, words_it );
		ExtractValue( animation_index, words_it );
		ExtractValue( animation.entity_index, words_it );
	}

	parsing_state.NextLine();

	return ust::make_tuple( animation_index, move(animation) );
}

fn ParseEntity( ParsingState &mut parsing_state ) : tup[ u32, EntitiesDescription::EntityDescription ]
{
	var EntitiesDescription::EntityDescription mut entity_description;

	var u32 mut entity_index= 0u;

	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.deref_or( ust::string_view8() ) ) );

		if( words_it.next() == ust::string_view8( "aktor" ) )
		{
			ExtractValue( entity_index, words_it );
			ExtractValue( entity_description.energy, words_it );
			ExtractValue( entity_description.aggression, words_it );
			ExtractValue( entity_description.susceptible, words_it );
			ExtractValue( entity_description.osona, words_it );
			ExtractValue( entity_description.mode, words_it );
			// Don't care extracting name. It's internal name, not shown somewhere in the actual game.
		}
	}

	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "panika" )
		{
			ExtractValue( entity_description.panic, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "szukaj_apteczek" )
		{
			ExtractValue( entity_description.search_for_health_kits, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "szukaj_amunicji" )
		{
			ExtractValue( entity_description.search_for_ammunition, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "ilosc_amunicji" )
		{
			ExtractValue( entity_description.ammunition, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "losowosc_zranienia" )
		{
			ExtractValue( entity_description.injury_randomness, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "ponowny_atak" )
		{
			ExtractValue( entity_description.another_attack, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "trzymaj_dystans" )
		{
			ExtractValue( entity_description.hold_on_distance, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "zabron_redukcji" )
		{
			ExtractValue( entity_description.disable_reduction, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "standardowe_odglosy" )
		{
			ExtractValue( entity_description.standard_sounds, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "param_akt" )
		{
			var [ u32, 4 ] mut param_akt= zero_init;
			ExtractValue( param_akt, words_it );
			entity_description.param_akt= param_akt;
			parsing_state.NextLine();
		}
		else if( first_word == "celnosc" )
		{
			// TODO - parse floating-point accurasy value.
			parsing_state.NextLine();
		}
		else if( first_word == "dobry_wzrok" )
		{
			ExtractValue( entity_description.good_sight, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "automatyczny_alarm" )
		{
			ExtractValue( entity_description.automatic_alarm, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "kontakt_bezposredni" )
		{
			ExtractValue( entity_description.direct_contact, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "operacja" )
		{
			auto [ operation_index, mut operation ]= ParseOperation( parsing_state );
			var size_type operation_index_s( operation_index );

			if( operation_index_s >= 32s )
			{
				ust::stdout_print( "Too high operation number!\n" );
				move(operation);
			}
			else if( operation_index_s == entity_description.operations.size() )
			{
				entity_description.operations.push_back( move(operation) );
			}
			else
			{
				if( operation_index_s > entity_description.operations.size() )
				{
					entity_description.operations.resize( operation_index_s + 1s );
				}
				entity_description.operations[operation_index_s]= move(operation);
			}
		}
		else
		{
			break;
		}
	}

	return ust::make_tuple( entity_index, move(entity_description) );
}

fn ParseTool( ParsingState &mut parsing_state ) : tup[ u32, EntitiesDescription::Tool ]
{
	var EntitiesDescription::Tool mut tool;

	var u32 mut tool_index= 0u;

	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.deref_or( ust::string_view8() ) ) );

		if( words_it.next() == ust::string_view8( "narzedzie" ) )
		{
			ExtractValue( tool_index, words_it );
		}
	}

	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "typ_przedmiotu" )
		{
			var ust::string8 mut s;
			ExtractValue( s, words_it );
			tool.tool_type= StringToToolType( s );
			parsing_state.NextLine();
		}
		else if( first_word == "ikona" )
		{
			ExtractValue( tool.icon, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "bohater_ma" )
		{
			ExtractValue( tool.player_start_count, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "bohater_ma_max" )
		{
			ExtractValue( tool.player_max_count, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "ammo_przedm" )
		{
			ExtractValue( tool.ammo_item, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "animacja" )
		{
			ExtractValue( tool.animation, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "sila_razenia" )
		{
			ExtractValue( tool.damage, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "odglos" )
		{
			ExtractValue( tool.sound, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "hitwall" )
		{
			ExtractValue( tool.hit_wall, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "hitobkt" )
		{
			ExtractValue( tool.hit_object, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "stars" )
		{
			ExtractValue( tool.stars, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "obraz" )
		{
			ExtractValue( tool.projectile_model, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "predkosc" )
		{
			ExtractValue( tool.speed, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "strzelnosc" )
		{
			ExtractValue( tool.shooting, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "nazwa" )
		{
			tool.name= ExtractSpaceSeparatedWords( words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "model_pocisku" )
		{
			if_var( s : words_it.next() )
			{
				if( s == "POCISK_A" )
				{
					tool.projectile_kind= 1u;
				}
				else if_var( n : ust::parse_number_exact</u32/>( s ) )
				{
					tool.projectile_kind= n;
				}
			}
			parsing_state.NextLine();
		}
		else if( first_word == "dane_strzalu" )
		{
			var [ i32, 7 ] mut shot_data= zero_init;
			ExtractValue( shot_data, words_it );
			tool.shot_data.push_back( shot_data );
			parsing_state.NextLine();
		}
		else if( first_word == "dane_broni" )
		{
			ExtractValue( tool.weapon_data, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "obsluga_kolizji" )
		{
			ExtractValue( tool.collision_handling, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "slad_na_scianie" )
		{
			ExtractValue( tool.wall_mark, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "bron_mind_control" )
		{
			ExtractValue( tool.weapon_mind_control, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "kolizja_mur" )
		{
			ExtractValue( tool.wall_collision, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "swiatlo_w_locie" )
		{
			ExtractValue( tool.projectile_light, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "blysk_startowy" )
		{
			ExtractValue( tool.light_at_shot, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "blysk_koncowy" )
		{
			ExtractValue( tool.light_at_hit_point, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "pierwszy_blik" )
		{
			ExtractValue( tool.muzzle_flash_model, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "celnosc_broni_wrogow" )
		{
			ExtractValue( tool.enemy_weapon_accuracy, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "celnosc_broni_gracza" )
		{
			ExtractValue( tool.player_weapon_accuracy, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "pole_razenia_pocisku" )
		{
			ExtractValue( tool.splash_damage_area_size, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "przeladowanie" )
		{
			ExtractValue( tool.overload, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "dymienie" )
		{
			ExtractValue( tool.smoke_trail_kind, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "odrzut" )
		{
			ExtractValue( tool.recoil, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "napalm" )
		{
			ExtractValue( tool.napalm, words_it );
			parsing_state.NextLine();
		}
		else
		{
			break;
		}
	}

	return ust::make_tuple( tool_index, move(tool) );
}

fn ParseOperation( ParsingState &mut parsing_state ) : tup[ u32, EntitiesDescription::Operation ]
{
	var EntitiesDescription::Operation mut operation;

	var u32 mut operation_index= 0u;

	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.deref_or( ust::string_view8() ) ) );

		if( words_it.next() == ust::string_view8( "operacja" ) )
		{
			ExtractValue( operation_index, words_it );
		}
	}

	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" || first_word == "//" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "animacja_naprzod" )
		{
			operation.animation= ParseOperationAnimation( parsing_state );
			operation.animation_kind= EntitiesDescription::Operation::AnimationKind::Forward;
		}
		else if( first_word == "animacja_kierunkowa" )
		{
			operation.directional_animation= ParseOperationAnimation( parsing_state );
		}
		else if( first_word == "animacja_beczki" )
		{
			operation.animation= ParseOperationAnimation( parsing_state );
			operation.animation_kind= EntitiesDescription::Operation::AnimationKind::Barrel;
		}
		else if( first_word == "animacja_szkielka" )
		{
			operation.animation= ParseOperationAnimation( parsing_state );
			operation.animation_kind= EntitiesDescription::Operation::AnimationKind::Slide;
		}
		else if( first_word == "animacja_ikony" )
		{
			operation.animation= ParseOperationAnimation( parsing_state );
			operation.animation_kind= EntitiesDescription::Operation::AnimationKind::Icon;
		}
		else if( first_word == "krajobraz" )
		{
			operation.animation= ParseOperationAnimation( parsing_state );
			operation.animation_kind= EntitiesDescription::Operation::AnimationKind::Landscape;
		}
		else if( first_word == "animacja_bohatera" )
		{
			operation.animation= ParseOperationAnimation( parsing_state );
			operation.animation_kind= EntitiesDescription::Operation::AnimationKind::Character;
		}
		else if( first_word == "animacja_owad" )
		{
			operation.animation= ParseOperationAnimation( parsing_state );
			operation.animation_kind= EntitiesDescription::Operation::AnimationKind::Insect;
		}
		else if( first_word == "stoper" )
		{
			operation.stopper= ParseStopper( parsing_state );
		}
		else if( first_word == "obrot_obiektu" )
		{
			operation.object_rotation= ParseObjectRotation( parsing_state );
		}
		else if( first_word == "sternik" )
		{
			operation.operation_control= ParseOperationControl( parsing_state );
		}
		else if( first_word == "emisja_zapasow" )
		{
			operation.supply_drop= ParseSupplyDrop( parsing_state );
		}
		else if( first_word == "jesli_zyje" )
		{
			operation.if_alive= ParseIfAlive( parsing_state );
		}
		else if( first_word == "zawartosc_skrzynki" )
		{
			operation.box_contents= ParseBoxContents( parsing_state );
		}
		else if( first_word == "ruch_bohatera" )
		{
			operation.charachter_movement= ParseCharacterMovement( parsing_state );
		}
		else if( first_word == "regeneracja_przedmiotu" )
		{
			operation.item_regeneration= ParseItemRegeneration( parsing_state );
		}
		else if( first_word == "zarowka" )
		{
			operation.bulb= ParseBulb( parsing_state );
		}
		else if( first_word == "wybuch_benzyny" )
		{
			operation.gasoline_explosion= ParseGasolineExplosion( parsing_state );
		}
		else if( first_word == "zarowka_gasnaca" )
		{
			operation.explosion_light= ParseExplosionLight( parsing_state );
		}
		else if( first_word == "odglos" )
		{
			operation.sound= ParseSound( parsing_state );
		}
		else if( first_word == "emisja_dymu" )
		{
			operation.smoke_emission= ParseSmokeEmission( parsing_state );
		}
		else if( first_word == "swiatlo" )
		{
			operation.light= ParseLight( parsing_state );
		}
		else if( first_word == "dymek" )
		{
			operation.smoke= ParseSmoke( parsing_state );
		}
		else if( first_word == "ruch_kamienia" )
		{
			operation.stone_movement= ParseStoneMovement( parsing_state );
		}
		else if( first_word == "eksplozja_dymowa" )
		{
			operation.smoke_explosion= ParseSmokeExplosion( parsing_state );
		}
		else if( first_word == "spalanie" )
		{
			operation.combustion= ParseCombustion( parsing_state );
		}
		else if( first_word == "dopalanie" )
		{
			operation.afterburning= ParseCombustion( parsing_state );
		}
		else if( first_word == "alarmuj_okolice" )
		{
			operation.alarm_area= ParseAlarmArea( parsing_state );
		}
		else if( first_word == "obrot_docelowy" )
		{
			operation.target_rotation= ParseTargetRotation( parsing_state );
		}
		else if( first_word == "ruch_obiektu" )
		{
			operation.object_movement= ParseObjectMovement( parsing_state );
		}
		else if( first_word == "obrot_do_strzalu" )
		{
			operation.rotation_for_shot= ParseRotationForShot( parsing_state );
		}
		else if( first_word == "strzal_kierunkowy" )
		{
			operation.directional_shot= ParseDirectionalShot( parsing_state );
		}
		else if( first_word == "kolizja_z_wrogiem" )
		{
			operation.collision_with_enemy= ParseCollisionWithEnemy( parsing_state );
		}
		else if( first_word == "czujnik_podniesienia" )
		{
			operation.take_sensor= ParseTakeSensor( parsing_state );
		}
		else if( first_word == "pozycja_wzgledna" )
		{
			operation.relative_position= ParseRelativePosition( parsing_state );
		}
		else if( first_word == "zabron_podnoszenia" )
		{
			operation.prohibit_lifting= true;

			parsing_state.NextLine();
		}
		else
		{
			break;
		}
	}

	return ust::make_tuple( operation_index, move(operation) );
}

fn ParseOperationAnimation( ParsingState &mut parsing_state ) : EntitiesDescription::OperationAnimationDescription
{
	var EntitiesDescription::OperationAnimationDescription mut operation_animation;

	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
