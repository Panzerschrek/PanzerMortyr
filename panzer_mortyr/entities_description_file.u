	while( !parsing_state.current_line.empty() )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "czas" )
		{
			ExtractValue( if_alive.time, words_it );

			foreach( &mut new_operation : if_alive.new_operation )
			{
				if( words_it.next() == ust::string_view8( "nowa_op" ) )
				{
					ExtractValue( new_operation, words_it );
				}
			}

			parsing_state.NextLine();
		}
		else
		{
			break;
		}
	}

	return if_alive;
}

fn ParseBoxContents( ParsingState &mut parsing_state ) : EntitiesDescription::BoxContents
{
	var EntitiesDescription::BoxContents mut box_contents;

	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "przedmiot" )
		{
			var ust::string8 mut s;
			ExtractValue( s, words_it );
			box_contents.tool_type= StringToToolType( s );
			parsing_state.NextLine();
		}
		else if( first_word == "ilosc" )
		{
			ExtractValue( box_contents.amount, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "aktywizacja" )
		{
			ExtractValue( box_contents.activation, words_it );

			if( words_it.next() == ust::string_view8( "ammotyp" ) )
			{
				ExtractValue( box_contents.ammo_type, words_it );
			}

			parsing_state.NextLine();
		}
		else if( first_word == "ammo" )
		{
			ExtractValue( box_contents.ammo, words_it );

			if( words_it.next() == ust::string_view8( "efekt" ) )
			{
				ExtractValue( box_contents.effect, words_it );
			}

			if( words_it.next() == ust::string_view8( "klucz" ) )
			{
				ExtractValue( box_contents.key, words_it );
			}

			if( words_it.next() == ust::string_view8( "zapas" ) )
			{
				ExtractValue( box_contents.stock, words_it );
			}

			parsing_state.NextLine();
		}
		else
		{
			break;
		}
	}

	return box_contents;
}

