	parsing_state.NextLine();

	while( !parsing_state.current_line.empty() )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.NextLine();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.NextLine();
		}
		else if( first_word == "poz_x" )
		{
			ExtractValue( smoke_emission.pos_x, words_it );

			if( words_it.next() == ust::string_view8( "poz_y" ) )
			{
				ExtractValue( smoke_emission.pos_y, words_it );
			}

			if( words_it.next() == ust::string_view8( "poz_z" ) )
			{
				ExtractValue( smoke_emission.pos_z, words_it );
			}

			parsing_state.NextLine();
		}
		else if( first_word == "predkosc_x" )
		{
			ExtractValue( smoke_emission.velocity_x, words_it );

			if( words_it.next() == ust::string_view8( "predkosc_y" ) )
			{
				ExtractValue( smoke_emission.velocity_y, words_it );
			}

			if( words_it.next() == ust::string_view8( "predkosc_z" ) )
			{
				ExtractValue( smoke_emission.velocity_z, words_it );
			}

			parsing_state.NextLine();
		}
		else if( first_word == "and_czas" )
		{
			ExtractValue( smoke_emission.emission_period, words_it );
			parsing_state.NextLine();
		}
		else if( first_word == "model_dymu" )
		{
			ExtractValue( smoke_emission.smoke_model, words_it );
			parsing_state.NextLine();
		}
		else
		{
			break;
		}
	}

	return smoke_emission;
}

