fn ExtractValue( ust::string8 &mut v, ust::iterator</ WordsIterator /> &mut it )
{
	if_var( s : it.next() )
	{
		v= s;
	}
}

fn ExtractValue( ResourceString &mut v, ust::iterator</ WordsIterator /> &mut it )
{
	if_var( s : it.next() )
	{
		v= ConvertStringToResourceString( s );
	}
}

template</type T/>
fn ExtractValue( T &mut v, ust::iterator</ WordsIterator /> &mut it )
{
	if_var( s : it.next() )
	{
		if_var( n : ust::parse_number_exact</T/>( s ) )
		{
			v= n;
		}
	}
}

template</type T, size_type S/>
fn ExtractValue( [ T, S ] &mut v, ust::iterator</ WordsIterator /> &mut it )
{
	foreach( &mut sub_val : v )
	{
		ExtractValue( sub_val, it );
	}
}

fn StringToToolType( ust::string_view8 s ) : EntitiesDescription::ToolType
{
	type TT= EntitiesDescription::ToolType;

	if( s == "-1" ){ return TT::Kick; }

	if( s == "BRON_A" ){ return TT::WeaponA; }
	if( s == "BRON_B" ){ return TT::WeaponB; }
	if( s == "BRON_C" ){ return TT::WeaponC; }
	if( s == "BRON_D" ){ return TT::WeaponD; }
	if( s == "BRON_E" ){ return TT::WeaponE; }
	if( s == "BRON_F" ){ return TT::WeaponF; }
	if( s == "BRON_G" ){ return TT::WeaponG; }
	if( s == "BRON_H" ){ return TT::WeaponH; }
	if( s == "BRON_I" ){ return TT::WeaponI; }
	if( s == "BRON_J" ){ return TT::WeaponJ; }

	if( s == "KARTA_A" ){ return TT::KeyA; }
	if( s == "KARTA_B" ){ return TT::KeyB; }
	if( s == "KARTA_C" ){ return TT::KeyC; }

	if( s == "POCISK_A" ){ return TT::ProjectileA; }
	if( s == "POCISK_B" ){ return TT::ProjectileB; }
	if( s == "POCISK_C" ){ return TT::ProjectileC; }
	if( s == "POCISK_D" ){ return TT::ProjectileD; }
	if( s == "POCISK_E" ){ return TT::ProjectileE; }
	if( s == "POCISK_F" ){ return TT::ProjectileF; }
	if( s == "POCISK_G" ){ return TT::ProjectileG; }
	if( s == "POCISK_H" ){ return TT::ProjectileH; }

	if( s == "OSLONA" ){ return TT::Armor; }
	if( s == "SUPER_OSLONA" ){ return TT::ArmorSuper; }

	if( s == "APTECZKA" ){ return TT::HealthPack; }
	if( s == "PLECAK_LOT" ){ return TT::Jetpack; }
	if( s == "NOKTOWIZOR" ){ return TT::NightVision; }
	if( s == "PODCZERWIEN" ){ return TT::InfraredVision; }
	if( s == "LATARKA" ){ return TT::Flashlight; }
	if( s == "BUTLA_TLENU" ){ return TT::OxygenBalloon; }
	if( s == "NIEWIDZIALNOSC" ){ return TT::Invisibility; }
	if( s == "KWAS_SKAF" ){ return TT::AcidProtectionSuit; }
	if( s == "WZMACNIACZ_BRONI" ){ return TT::WeaponAmplifier; }
	if( s == "TLUMIK" ){ return TT::Silencer; }

	ust::stdout_print( ust::concat( "Unknown tool type ", s, "!\n" ) );

	return TT::None;
}

} // namespace PM
