fn ParseIfAlive( ParsingState &mut parsing_state ) : EntitiesDescription::IfAlive
{
	var EntitiesDescription::IfAlive mut if_alive;

	ust::ignore_unused( parsing_state.it.next() );

	// Hack for reference pollution in loop.
	if( false )
	{
		if_var( &line : parsing_state.it.next() )
		{
			parsing_state.current_line= line;
		}
	}

	loop
	{
		auto line_opt= parsing_state.it.next();
		if( line_opt.empty() )
		{
			break;
		}

		var ust::string_view8 line= line_opt.try_deref();
		parsing_state.current_line= line;

		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "czas" )
		{
			if_var( s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( s ) )
				{
					if_alive.time= n;
				}
			}

			foreach( &mut new_operation : if_alive.new_operation )
			{
				if( words_it.next() == ust::string_view8( "nowa_op" ) )
				{
					if_var( s : words_it.next() )
					{
						if_var( n : ust::parse_integer_exact</u32/>( s ) )
						{
							new_operation= n;
						}
					}
				}
			}
		}
		else
		{
			break;
		}
	}

	return if_alive;
}

} // namespace PM
