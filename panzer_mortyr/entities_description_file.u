	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( parsing_state.current_line.try_deref() ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			parsing_state.current_line= parsing_state.it.next();
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "rem" )
		{
			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "tryb_pracy" )
		{
			if_var( &s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( s ) )
				{
					operation_control.functioning_mode= n;
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "szybkosc" )
		{
			if_var( &s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</i32/>( s ) )
				{
					operation_control.speed= n;
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "obrot" )
		{
			if_var( &s : words_it.next() )
			{
				if_var( n : ust::parse_integer_exact</u32/>( s ) )
				{
					operation_control.rotation= n;
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "w_zasiegu_strzalu_a" )
		{
			var [ u32, 3 ] mut inside_shooting_zone_a= zero_init;
			for( auto mut i= 0s; i < 3s; ++i )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u32/>( s ) )
					{
						inside_shooting_zone_a[i]= n;
					}
				}
			}
			operation_control.inside_shooting_zone_a= inside_shooting_zone_a;

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "w_zasiegu_strzalu_b" )
		{
			var [ u32, 3 ] mut inside_shooting_zone_b= zero_init;
			for( auto mut i= 0s; i < 3s; ++i )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u32/>( s ) )
					{
						inside_shooting_zone_b[i]= n;
					}
				}
			}
			operation_control.inside_shooting_zone_b= inside_shooting_zone_b;

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "utrata_energi" )
		{
			var [ i32, 3 ] mut energy_loss= zero_init;
			for( auto mut i= 0s; i < 3s; ++i )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</i32/>( s ) )
					{
						energy_loss[i]= n;
					}
				}
			}
			operation_control.energy_loss= energy_loss;

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "timeout" )
		{
			var [ u32, 2 ] mut timeout= zero_init;
			for( auto mut i= 0s; i < 2s; ++i )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u32/>( s ) )
					{
						timeout[i]= n;
					}
				}
			}
			operation_control.timeout= timeout;

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "przedmiot" )
		{
			foreach( &mut item_num : operation_control.item )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</i32/>( s ) )
					{
						item_num= n;
					}
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "przemiana" )
		{
			foreach( &mut num : operation_control.transformation )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u32/>( s ) )
					{
						num= n;
					}
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "w_zasiegu_widocznosci" )
		{
			foreach( &mut num : operation_control.within_sight )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u32/>( s ) )
					{
						num= n;
					}
				}
			}

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "gracz_widoczny" )
		{
			var [ i32, 3 ] mut player_visible= zero_init;
			foreach( &mut out_num : player_visible )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</i32/>( s ) )
					{
						out_num= n;
					}
				}
			}
			operation_control.player_visible= player_visible;

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "dogodna_pozycja" )
		{
			var [ u32, 3 ] mut convenient_position= zero_init;
			foreach( &mut out_num : convenient_position )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</u32/>( s ) )
					{
						out_num= n;
					}
				}
			}
			operation_control.convenient_position= convenient_position;

			parsing_state.current_line= parsing_state.it.next();
		}
		else if( first_word == "losowosc" )
		{
			var [ i32, 5 ] mut randomness= zero_init;
			foreach( &mut out_num : randomness )
			{
				if_var( &s : words_it.next() )
				{
					if_var( n : ust::parse_integer_exact</i32/>( s ) )
					{
						out_num= n;
					}
				}
			}
			operation_control.randomness= randomness;

			parsing_state.current_line= parsing_state.it.next();
		}
		else
		{
			break;
		}
	}

	return operation_control;
}

