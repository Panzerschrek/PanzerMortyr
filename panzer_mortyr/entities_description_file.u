			if( words_it.next() == ust::string_view8( "szer_z" ) )
			{
				ExtractValue( operation_animation.bounding_box_half_size_z, words_it );
			}

			parsing_state.NextLine();
		}
		else if( first_word == "aktywnosc" )
		{
			ExtractValue( operation_animation.activity, words_it );

			if( words_it.next() == ust::string_view8( "maska" ) )
			{
				ExtractValue( operation_animation.mask, words_it );
			}

			parsing_state.NextLine();
		}
		else if( first_word == "kierunek" )
		{
			ExtractValue( operation_animation.direction, words_it );
			parsing_state.NextLine();
		}
		else
		{
			break;
