import "/directory_iterator.iu"
import "/enum_string_conversions.iu"
import "/path_utils.iu"
import "/string.iu"
import "game_data_search.iu"

namespace PM
{

fn SearchForGameArchiveFile(
	ust::filesystem_path_view executable_path,
	ust::filesystem_path_view custom_game_installation_directory_path,
	ConsoleOutPtr& console_out ) : ust::optional</GameArchiveSearchResult/>
{
	var [ ust::filesystem_path_view, 3 ] start_directories
	[
		// Explicit game installation directory has highest priority.
		custom_game_installation_directory_path,
		// Then follows current directory.
		".",
		// The directory where PanzerMortyr executable is located goes last.
		ust::path::get_parent_path( executable_path ).deref_or( ust::filesystem_path_view( "" ) ),
	];

	foreach( &start_directory : start_directories )
	{
		if( start_directory.empty() )
		{
			continue;
		}

		ConsoleOutAddTextLine(
			console_out, ust::concat( "Searching for game data in \"", start_directory, "\"." ) );

		// Search for "Data" directory and "main.hal" file in it.
		if_var( &data_directory : SearchForDataDirectory( console_out, start_directory ) )
		{
			var ust::optional</GameArchiveSearchResult/> game_archive_search_result_opt=
				SearchForGameArchiveFileInDirectory( console_out, data_directory );

			if( !game_archive_search_result_opt.empty() )
			{
				return game_archive_search_result_opt;
			}
		}

		// Search for "main.hal" file in current start directory, assuming start directory is called "Data".

		var ust::optional</GameArchiveSearchResult/> game_archive_search_result_opt=
			SearchForGameArchiveFileInDirectory( console_out, start_directory );

		if( !game_archive_search_result_opt.empty() )
		{
			return game_archive_search_result_opt;
		}
	}

	return ust::null_optional;
}

fn SearchForGameArchiveFileInDirectory(
	ConsoleOutPtr& console_out, ust::filesystem_path_view d ) : ust::optional</GameArchiveSearchResult/>
{
	result_match( ust::open_directory_for_iteration( d ) )
	{
		Ok( mut it ) ->
		{
			if_var( &res : SearchForGameArchiveFileInDirectory( console_out, move( it ) ) )
			{
				return GameArchiveSearchResult
				{
					.archive_file_directory= d,
					.archive_file= ust::path::join( d, res ),
				};
			}
		},
		Err( e ) ->
		{
			ConsoleOutAddTextLine(
				console_out, ust::concat( "Failed to open directory \"", d, "\" for iteration: ", ust::enum_to_string(e) ) );
		},
	}
	return ust::null_optional;
}

fn SearchForGameArchiveFileInDirectory(
	ConsoleOutPtr& console_out,
	ust::iterator</ust::directory_raw_iterator/> mut directory_iterator ) : ust::optional</ust::filesystem_path/>
{
	foreach( entry_res : move(directory_iterator) )
	{
		if_var( e : entry_res.as_error_ref() )
		{
			ConsoleOutAddTextLine(
				console_out, ust::concat( "Failed to get directory entry: ", ust::enum_to_string(e) ) );
			break;
		}

		if_var( &entry : entry_res.as_ref() )
		{
			if( PathAreCaseInsensitiveEqual( entry.name, "main.hal" ) )
			{
				return entry.name;
			}
		}
	}

	return ust::null_optional;
}

fn SearchForDataDirectory(
	ConsoleOutPtr& console_out, ust::filesystem_path_view d ) : ust::optional</ust::filesystem_path/>
{
	result_match( ust::open_directory_for_iteration( d ) )
	{
		Ok( mut it ) ->
		{
			if_var( &res : SearchForDataDirectory( console_out, move( it ) ) )
			{
				return ust::path::join( d, res );
			}
		},
		Err( e ) ->
		{
			ConsoleOutAddTextLine(
				console_out, ust::concat( "Failed to open directory \"", d, "\" for iteration: ", ust::enum_to_string(e) ) );
		},
	}
	return ust::null_optional;
}

fn SearchForDataDirectory(
	ConsoleOutPtr& console_out,
	ust::iterator</ust::directory_raw_iterator/> mut directory_iterator ) : ust::optional</ust::filesystem_path/>
{
	foreach( entry_res : move(directory_iterator) )
	{
		if_var( e : entry_res.as_error_ref() )
		{
			ConsoleOutAddTextLine(
				console_out, ust::concat( "Failed to get directory entry: ", ust::enum_to_string(e) ) );
			break;
		}

		if_var( &entry : entry_res.as_ref() )
		{
			if( PathAreCaseInsensitiveEqual( entry.name, "Data" ) )
			{
				return entry.name;
			}
		}
	}

	return ust::null_optional;
}

fn PathAreCaseInsensitiveEqual( ust::filesystem_path_view l, ust::filesystem_path_view r ) : bool
{
	if( l.size() != r.size() )
	{
		return false;
	}

	foreach( pair : l.iter().zip( r.iter() ) )
	{
		if( AsciiToLower( pair.first ) != AsciiToLower( pair.second ) )
		{
			return false;
		}
	}

	return true;
}

fn AsciiToLower( char8 c ) : char8
{
	if( c >= 'A' && c <= 'Z' )
	{
		return char8( u32(c) - u32('A') + u32('a') );
	}
	return c;
}

} // namespace PM
