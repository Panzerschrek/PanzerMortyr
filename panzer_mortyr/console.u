import "/scoped_array.u"
import "/stdout.u"
import "console.uh"

namespace PM
{

fn Console::constructor( SettingsPtr mut settings, ConsoleOutPtr mut console_out, [ u32, 2 ] viewport_size )
	( settings_= move(settings), console_out_= move(console_out), viewport_size_(viewport_size) )
{}

fn Console::Toggle( mut this )
{
	is_active_= !is_active_;
}

fn Console::IsActive( this ) : bool
{
	return is_active_;
}

fn Console::ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event )
{
	var size_type mut length= 0s;
	while( length < typeinfo</ typeof(text_input_event.text) />.element_count )
	{
		if( text_input_event.text[ length ] == '\0' )
		{
			break;
		}
		++length;
	}

	input_line_+= ust::string_view8( text_input_event.text ).subrange_end( length );
}

fn Console::Update( mut this, f32 time_delta_s )
{
	var f32 move_speed= 4.0f;
	var f32 delta= time_delta_s * move_speed;

	if( is_active_ )
	{
		screen_position_+= delta;
		ust::min_assign( screen_position_, 1.0f );
	}
	else
	{
		screen_position_-= delta;
		ust::max_assign( screen_position_, 0.0f );
	}
}

fn Console::Draw( this, TextDrawer &mut text_drawer )
{
	if( screen_position_ <= 0.0f )
	{
		return;
	}

	var f32 line_height= 8.0f * c_console_text_settings.scale;

	var f32 mut y= f32(viewport_size_[1]) * ( 1.0f - screen_position_ * 0.5f );

	{
		// Draw input line with forward ':' and cursor. TODO - make cursor blinking.
		scoped_array char8 input_line_with_cursor[ input_line_.size() + 2s ]( ust::string_view8( ":" ).iter().chain( input_line_.iter() ).chain( ust::string_view8( "_" ).iter() ) );
		text_drawer.AddText( 0.0f, y, input_line_with_cursor, c_console_input_line_text_settings );
		y+= line_height;
	}

	with( & console_out : console_out_.lock_imut().deref() )
	{
		var size_type num_lines= console_out.GetNumLines();
		for( auto mut i= 0s; i < num_lines; ++i )
		{
			text_drawer.AddText( 0.0f, y, console_out.GetLine( i ), c_console_text_settings );
			y+= line_height;
		}
	}
}

var TextDrawer::Settings c_console_text_settings
{
	.scale= 2.0f,
	.foreground_color[ 200u8, 200u8, 200u8, 255u8 ],
	.background_color[ 0u8, 0u8, 0u8, 128u8 ],
	.monospace= true,
};

var TextDrawer::Settings c_console_input_line_text_settings
{
	.scale= c_console_text_settings.scale,
	.foreground_color[ 230u8, 230u8, 140u8, 255u8 ],
	.background_color= c_console_text_settings.background_color,
	.monospace= c_console_text_settings.monospace,
};

} // namespace PM
