import "/scoped_array.iu"
import "/stdout.iu"
import "console.iu"

namespace PM
{

fn Console::constructor( SettingsPtr mut settings, ConsoleOutPtr mut console_out, [ u32, 2 ] viewport_size )
	( settings_= move(settings), console_out_= move(console_out), viewport_size_(viewport_size) )
{}

fn Console::Toggle( mut this )
{
	is_active_= !is_active_;
}

fn Console::IsActive( this ) : bool
{
	return is_active_;
}

fn Console::IsVisible( this ) : bool
{
	return screen_position_ > 0.0f;
}

fn Console::ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event )
{
	var size_type mut length= 0s;
	while( length < typeinfo</ typeof(text_input_event.text) />.element_count )
	{
		if( text_input_event.text[ length ] == '\0' )
		{
			break;
		}
		++length;
	}

	input_line_+= ust::string_view8( text_input_event.text ).subrange_end( length );
}

fn Console::Update( mut this, f32 time_delta_s )
{
	time_s_+= time_delta_s;

	var f32 move_speed= 4.0f;
	var f32 delta= time_delta_s * move_speed;

	if( is_active_ )
	{
		screen_position_+= delta;
		ust::min_assign( screen_position_, 1.0f );
	}
	else
	{
		screen_position_-= delta;
		ust::max_assign( screen_position_, 0.0f );
	}
}

fn Console::Draw( this, ImageDrawer &mut image_drawer, AbstractTextDrawer &mut text_drawer )
{
	var ResourceString& background_image_file_name= "SHELL.BMP\0\0\0";

	if( !background_image_preloaded_ )
	{
		image_drawer.PreloadImage( background_image_file_name, ust::null_optional_ref );
	}

	if( !IsVisible() )
	{
		return;
	}

	var i32 mut y( f32( viewport_size_[1] ) * ( 1.0f - screen_position_ * 0.7f ) );

	{
		// Draw background image.

		var [ u32, 2 ] background_image_size=
			image_drawer.GetImageSize( background_image_file_name ).deref_or( ust::make_array( 320u, 200u ) );

		image_drawer.DrawImage(
			background_image_file_name,
			0,
			y,
			f32( viewport_size_[0] ) / f32( background_image_size[0] ),
			0u,
			0u,
			background_image_size[0],
			background_image_size[1] * 2u );
	}

	var i32 line_height( AbstractTextDrawer::c_glyph_height * c_console_text_settings.scale );

	var i32 x_offset( 2u * c_console_text_settings.scale );

	{
		// Draw input line with forward ':' and cursor.
		var ust::string_view8 prefix= ":";
		var ust::string_view8 cursor= ( ( u32( time_s_ * 4.0f ) & 1u ) == 0u ? " " : "_" );

		scoped_array char8 input_line_with_cursor[ input_line_.size() + 2s ]( prefix.iter().chain( input_line_.iter() ).chain( cursor.iter() ) );

		text_drawer.AddText( x_offset, y, input_line_with_cursor, c_console_input_line_text_settings );
		y+= line_height;
	}

	with( & console_out : console_out_.lock_imut().deref() )
	{
		var size_type num_lines= console_out.GetNumLines();
		for( auto mut i= 0s; i < num_lines; ++i )
		{
			text_drawer.AddText( x_offset, y, console_out.GetLine( i ), c_console_text_settings );
			y+= line_height;
		}
	}
}

var AbstractTextDrawer::Settings c_console_text_settings
{
	.scale= 2u,
	.foreground_color[ 150u8, 200u8, 150u8, 255u8 ],
	.background_color[ 100u8,  50u8,   0u8,   0u8 ],
	.monospace= true,
};

var AbstractTextDrawer::Settings c_console_input_line_text_settings
{
	.scale= c_console_text_settings.scale,
	.foreground_color[ 230u8, 230u8, 140u8, 255u8 ],
	.background_color= c_console_text_settings.background_color,
	.monospace= c_console_text_settings.monospace,
};

} // namespace PM
