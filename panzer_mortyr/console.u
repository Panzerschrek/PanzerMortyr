import "/stdout.u"
import "/utf.u"
import "console.uh"

namespace PM
{

fn Console::constructor( [ u32, 2 ] viewport_size )
	( viewport_size_(viewport_size) )
{
}

fn Console::Toggle( mut this )
{
	is_active_= !is_active_;
}

fn Console::IsActive( this ) : bool
{
	return is_active_;
}

fn Console::ProcessKeyPress( mut this, SDL_Keysym& key_sym )
{
	if( key_sym.scancode == SDL_SCANCODE_BACKSPACE )
	{
		if( !input_line_.empty() )
		{
			input_line_.drop_back();
		}
	}
	else if( key_sym.scancode == SDL_SCANCODE_RETURN )
	{
		var ust::string8 mut echo_line= take(input_line_);
		AddTextLine( move(echo_line) );
	}
	else
	{
		ust::utf::push_code_point_to_string( input_line_, char32( key_sym.sym ) );
	}
}

fn Console::AddTextLine( mut this, ust::string8 mut line )
{
	ust::stdout_print( line );
	ust::stdout_print( "\n" );
	lines_.push_back( move( line ) );
}

fn Console::Draw( this, TextDrawer &mut text_drawer )
{
	if( !is_active_ )
	{
		return;
	}

	var TextDrawer::Settings text_settings
	{
		.scale= 2.0f,
		.foreground_color[ 200u8, 200u8, 200u8, 255u8 ],
		.background_color[ 0u8, 0u8, 0u8, 128u8 ],
		.monospace= true,
	};

	var f32 line_height= 8.0f * text_settings.scale;
	var f32 glyph_width= 8.0f * text_settings.scale;

	var f32 mut y= f32(viewport_size_[1]) - line_height;

	foreach( &line : lines_ )
	{
		text_drawer.AddText( 0.0f, y, line, text_settings );
		y-= line_height;
	}

	text_drawer.AddText( 0.0f, y, input_line_, text_settings );

	// Draw cursor. TODO - make it blinking.
	text_drawer.AddText( glyph_width * f32( input_line_.size() ), y, "_", text_settings );
}

} // namespace PM
