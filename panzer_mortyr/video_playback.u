import "/string_conversions.iu"
import "gl_state.iu"
import "shader_program.iu"
import "texture.u"
import "video_playback.iu"
import "video_stream.iu"

namespace PM
{

fn PlayVideo( ConsoleOutPtr& console_out, ust::filesystem_path file_path, OpenGLWindow &mut window )
{
	var ust::box_nullable</IVideoStream/> mut stream_ptr= OpenVideoStream( console_out, file_path );

	if( stream_ptr.empty() )
	{
		return;
	}

	var IVideoStream &mut stream= stream_ptr.try_deref();

	var [ u32, 2 ] video_size= stream.GetSize();

	var Texture mut texture= Texture::Create( GLenum( GL_TEXTURE_2D ) );
	texture.Bind();

	unsafe( glTexImage2D(
		GLenum( GL_TEXTURE_2D ),
		0,
		GLint( GL_RGBA8 ),
		GLsizei( video_size[0] ),
		GLsizei( video_size[1] ),
		0,
		GLenum( GL_RGBA ),
		GLenum( GL_UNSIGNED_BYTE ),
		ust::nullptr</byte8/>() ) );

	// Use linear filter.
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MIN_FILTER ), GLint( GL_LINEAR ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_MAG_FILTER ), GLint( GL_LINEAR ) ) );

	// Clamp texture coordinates to edge.
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_WRAP_S ), GLint( GL_CLAMP_TO_EDGE ) ) );
	unsafe( glTexParameteri( GLenum( GL_TEXTURE_2D ), GLenum( GL_TEXTURE_WRAP_T ), GLint( GL_CLAMP_TO_EDGE ) ) );

	var ShaderProgram mut shader(
		embed</char8/>( "shaders/video.vert.glsl" ), embed</char8/>( "shaders/video.frag.glsl" ) );

	var size_type mut num_frames= 0s;

	loop
	{
		auto frame_opt= stream.GetNextFrame();
		if( frame_opt.empty() )
		{
			break;
		}

		var IVideoStream::FrameData& frame_data= frame_opt.try_deref();

		texture.Bind();

		unsafe( glTexSubImage2D(
			GLenum( GL_TEXTURE_2D ),
			0,
			0, 0,
			GLsizei( video_size[0] ), GLsizei( video_size[1] ),
			GLenum( GL_RGBA ),
			GLenum( GL_UNSIGNED_BYTE ),
			ust::ptr_cast_to_byte8( frame_data.range().data() ) ) );

		SetGLState( g_video_drawing_gl_state );

		var u32 texture_slot= 0u;

		unsafe( glActiveTexture( GLenum( GL_TEXTURE0 ) + GLenum(texture_slot) ) );
		texture.Bind();

		shader.Bind();
		shader.SetUniform( "fu_texture", texture_slot );

		unsafe( glDrawArrays( GLenum( GL_TRIANGLES ), GLint(0), GLsizei(6) ) );

		window.SwapWindow();

		++num_frames;
	}

	ConsoleOutAddTextLine( console_out, ust::concat( "Number of frames: ", ust::to_string8( num_frames ) ) );
}

var GLState g_video_drawing_gl_state
{
	.color_write_enabled= true,
	.depth_test_enabled= false,
	.depth_test_func( GL_INVALID_ENUM ),
	.depth_write_enabled= false,
	.cull_face_enabled= false,
	.cull_face( GL_INVALID_ENUM ),
	.blending_enabled= true,
	.blend_source_factor( GL_SRC_ALPHA ),
	.blend_destination_factor( GL_ONE_MINUS_SRC_ALPHA ),
};

} // namespace PM
