namespace PM
{

// Sound sources are identified by unique numbers.
// Having a source with an ID equal toa  previoisly-known one means that this is the same source.
// 32-bit is practially enough for such identification.
type UniqueSoundSourceId= u32;

// Reserve ID 0 to indicate unused sound source.
var UniqueSoundSourceId c_empty_sound_source_id(0);

} // namespace PM
