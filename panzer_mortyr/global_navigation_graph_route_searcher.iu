import "/assert.iu"
import "/binary_heap.iu"
import "global_navigation_graph.iu"

namespace PM
{

// This class performs route search based on global navigation graph.
class GlobalNavigationGraphRouteSearcher
{

public:
	// Result route contains the start node, but not the end node!
	// Returns empty container if failed to find a route.
	// Given function should have single parameter - node index.
	// It should return a boolean value.
	// True means the search should be continued and false means the search should be stopped.
	template</type Func/>
	fn PerformSearch(
		mut this,
		GlobalNavigationGraph& graph,
		GlobalNavigationGraph::NodeIndex start_node,
		GlobalNavigationGraph::NodeIndex target_node,
		Func& node_processing_func ) : ust::vector</GlobalNavigationGraph::NodeIndex/>
	{
		debug_assert( start_node != target_node );

		// An implementation of A* algorithm.
		// It's better for almost all cases, since it visits way less nodes compared to Dijkstra's algorithm.
		// In case if a direct way exists between two points almost no unnecessary nodes are visited at all.

		// Perform search from the target node.
		// Stop if the start node is reached.
		// Then reconstruct the route using start to target order.

		var u32 search_sequentional_index= search_sequentional_index_;
		++search_sequentional_index_;

		// For slight speed-up read ranges of nodes and edges and save them in local variables.
		var ust::array_view_imut</GlobalNavigationGraph::Node/> graph_nodes= graph.nodes;
		var ust::array_view_imut</GlobalNavigationGraph::InputEdge/> graph_node_input_edges= graph.node_input_edges;

		var Vec2f start_position= graph_nodes[ size_type( start_node ) ].position.xy();
		var Vec2f target_position= graph_nodes[ size_type( target_node ) ].position.xy();

		var GlobalNavigationGraph::NodeIndex invalid_node_index(~0s);

		node_table_.resize(
			graph_nodes.size(),
			NodeTableEntry{ .search_sequentional_index= 0u, .prev_node= invalid_node_index } );
		var ust::array_view_mut</NodeTableEntry/> node_table= node_table_;

		var ust::vector</SearchElement/> &mut search_queue= search_queue_;
		search_queue.clear();
		search_queue.push_back(
			SearchElement
			{
				.node_index= target_node,
				.prev_node_index= invalid_node_index,
				.distance= 0.0f,
				// Use euclidian distance in XY plane as estimated remaining distance.
				.estimated_total_distance= ( target_position - start_position ).Length(),
			} );

		var SearchElementCompare compare;

		// TODO - ad some limit to number of iterations to avoid too costly searches.
		// This is especially important if no route can be found (to avoid visiting almost the whole graph).

		while( !search_queue.empty() )
		{
			ust::binary_heap::pop_heap( search_queue.range(), compare );
			auto { node_index, prev_node_index, distance } = search_queue.pop_back();

			{
				var NodeTableEntry &mut node_table_entry= node_table[ size_type( node_index ) ];

				if( node_table_entry.search_sequentional_index == search_sequentional_index )
				{
					continue; // Already visited this node.
				}

				node_table_entry.search_sequentional_index= search_sequentional_index;
				node_table_entry.prev_node= prev_node_index;
			}

			if( !node_processing_func( node_index ) )
			{
				break; // Processing function wants to end the search.
			}

			if( node_index == start_node )
			{
				// Reconstruct route using start to target order.
				var ust::vector</GlobalNavigationGraph::NodeIndex/> mut route;

				// Don't include target.

				for( auto mut n= node_index; n != target_node; n= node_table[ size_type(n) ].prev_node )
				{
					route.push_back(n);
				}

				return route;
			}

			var GlobalNavigationGraph::Node& node= graph_nodes[ size_type( node_index ) ];

			// Since we perform the search from target to start, process input nodes (not output nodes).

			foreach( &edge :
				graph_node_input_edges.subrange(
					size_type( node.first_input_edge ), size_type( node.first_input_edge + node.num_input_edges ) ) )
			{
				// Avoid adding a node into the search queue if it was already visited.
				// This allows saving some time by not doing not-so-trivial binary heap operations.
				if( node_table[ size_type( edge.src_node_index ) ].search_sequentional_index != search_sequentional_index )
				{
					var f32 next_distance= distance + f32( edge.length );

					// Use euclidian distance in XY plane as estimated remaining distance.
					var f32 estimated_remaining_distance=
						( graph_nodes[ size_type( edge.src_node_index ) ].position.xy() - start_position ).Length();

					search_queue.push_back(
						SearchElement
						{
							.node_index= edge.src_node_index,
							.prev_node_index= node_index,
							.distance= next_distance,
							.estimated_total_distance= next_distance + estimated_remaining_distance,
						} );

					ust::binary_heap::push_heap( search_queue.range(), compare );
				}
			}
		}

		// Route not found.
		return ust::vector</GlobalNavigationGraph::NodeIndex/>();
	}

private:
	struct SearchElement
	{
		GlobalNavigationGraph::NodeIndex node_index;
		GlobalNavigationGraph::NodeIndex prev_node_index; // Store prev node index to reconstruct the route.

		// Actual graph distance.
		f32 distance;

		// Distance combined from actual graph distance for given node and estimated distance to search target.
		f32 estimated_total_distance;
	}

	// Comparator for reverse order.
	struct SearchElementCompare
	{
		op()( this, SearchElement& l, SearchElement& r ) : bool
		{
			// Use reverse order.
			return l.estimated_total_distance > r.estimated_total_distance;
		}
	}

	struct NodeTableEntry
	{
		// Index of last search this node was visited.
		u32 search_sequentional_index;
		GlobalNavigationGraph::NodeIndex prev_node; // May be invalid index for the target node.
	}

private:
	// Reuse container with search elements across searches.
	// It's necessary to avoid reallocating it on each search.
	ust::vector</SearchElement/> search_queue_;

	// Reuse node table container across searches.
	// It's necessary to avoid reallocating it on each search.
	ust::vector</NodeTableEntry/> node_table_;

	// Increment this counter each time search is performed.
	// We use it to detect nodes already visited in current search invocation.
	// Such approach is faster than marking all nodes as unvisited at the start of each search,
	// considering only small fraction of nodes is visited on each search.
	u32 search_sequentional_index_= 1u;
}

} // namespace PM
