import "/hash_map.iu"
import "audio_out.iu"
import "game_filesystem.iu"
import "sound_loading.iu"
import "world_audio_info.iu"

namespace PM
{

// This class prepares sounds for output.
// TODO - rename it?
class AudioProcessor
{
public:
	fn constructor( ConsoleOutPtr mut console_out_ptr, GameFilesystemPtr mut game_filesystem_ptr );

	fn Update( mut this, WorldAudioInfo& world_audio_info );

private:
	struct ActiveSoundSource
	{
		// This flag is needed to detect and remove no longer active sound sources.
		bool used;
	}

private:
	ConsoleOutPtr imut console_out_;
	GameFilesystemPtr imut game_filesystem_;
	AudioOut audio_out_;
	AudioMixerSharedDataPtr audio_mixer_shared_data_;

	// Store null pointer if failed to load a file - to avoid reloading it again and again.
	ust::hash_map</ ResourceString, ust::shared_ptr_mt_final_nullable</ SoundDataAbstract /> /> sound_files_data_;

	// Store which sources are active.
	// This hash-map should be kept synchronized with sounds sources stored in the audio mixer data!
	ust::hash_map</ UniqueSoundSourceId, ActiveSoundSource /> active_sound_sources_;
}

} // namespace PM
