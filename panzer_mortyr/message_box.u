import "/scoped_array.iu"
import "/sdl/sdl_with_opengl.iu"
import "message_box.iu"

namespace PM
{

fn ShowFatalErrorMessageBox( ust::string_view8 text )
{
	scoped_array char8 text_nt[ text.size() + 1s ]( text.iter().chain( ust::string_view8( "\0" ).iter() ) );

	unsafe( SDL_ShowSimpleMessageBox(
		Uint32( SDL_MESSAGEBOX_ERROR ),
		$<( cast_mut( "Fatal error\0"[0] ) ),
		text_nt.data(),
		ust::nullptr</SDL_Window/>() ) );
}

} // namespace PM
