import "/common_lib/string_iterators.iu"
import "string_table.iu"

namespace PM
{

fn ParseStringTable( ust::string_view8 file_contents ) : StringTable
{
	return ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ).collect</ StringTable />();
}

fn FetchStringFromTable( StringTable& table, StringTableKey key )
	: ust::string_view8 @( ust::reference_notation::return_inner_references::param0 )
{
	var size_type index(key);
	if( index < table.size() )
	{
		return table[ index ];
	}

	return ust::string_view8();
}

} // namespace PM
