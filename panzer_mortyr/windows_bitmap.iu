namespace PM
{

// Identical to BITMAPFILEHEADER from WinAPI.
struct BitmapFileHeader ordered
{
	var u16 c_expected_type= 0x4d42u16;

	u16 type_;
	[ u8, 4 ] size;
	u16 reserved1;
	u16 reserved2;
	[ u8, 4 ] offbits;
}

static_assert( typeinfo</BitmapFileHeader/>.size_of == 14s );

// Identical to BITMAPINFOHEADER from WinAPI.
struct BitmapInfoHeader ordered
{
	u32 size;
	u32 width;
	u32 height;
	u16 planes;
	u16 bitcount;
	u32 compression;
	u32 sizeimage;
	u32 xpelspermeter;
	u32 ypelspermeter;
	u32 clrused;
	u32 clrimportant;
}

static_assert( typeinfo</BitmapInfoHeader/>.size_of == 40s );

} // namespace PM
