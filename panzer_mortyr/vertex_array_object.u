import "vertex_array_object.uh"

namespace PM
{

fn VertexArrayObject::constructor()
	( vertex_array_object_=
		unsafe( lambda[]() unsafe : GLuint
		{
			var GLuint mut vao= zero_init;
			unsafe( glGenVertexArrays( 1, $<( vao ) ) );
			return vao;
		} () ) )
{
}

fn VertexArrayObject::destructor()
{
	unsafe( glDeleteVertexArrays( 1, $<( cast_mut( vertex_array_object_ ) ) ) );
}

fn VertexArrayObject::Bind( this )
{
	unsafe( glBindVertexArray( vertex_array_object_ ) );
}

} // namespace PM
