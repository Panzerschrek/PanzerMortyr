import "world_audio_info.iu"

namespace PM
{

struct AudioProcessorState
{
	ust::vector</ActiveSoundSource/> active_sound_sources;

	[ AmbientSound, WorldAudioInfo::c_num_ambient_sounds ] ambient_sounds;

	struct ActiveSoundSource
	{
		UniqueSoundSourceId id;
		u8 sound_index;
		[ f32, 2 ] volume;
		bool is_playing;
		f32 time_s;
	}

	struct AmbientSound
	{
		ResourceString file_name;
		bool playing;
		[ f32, 2 ] volume;
		f32 time_s;
	}
}

} // namespace PM
