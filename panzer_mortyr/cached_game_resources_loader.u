import "/enum_string_conversions.u"
import "/stdout.u"
import "/common_lib/string_utils.uh"
import "cached_game_resources_loader.uh"

namespace PM
{

fn CachedGameResourcesLoader::constructor( GameFilesystemPtr mut game_filesystem_ptr )
	( game_filesystem_= move(game_filesystem_ptr) )
{
}

fn CachedGameResourcesLoader::LoadGameParams( mut this ) : GameResourcePtr</GameParams/>
{
	if( !game_params_.empty() )
	{
		return game_params_.try_to_non_nullable();
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto game_params_file_res= game_filesystem.LoadFileToString( c_game_params_file_name );
	if_var( e : game_params_file_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read game params file! Error: ", ust::enum_to_string(e), "\n" ) );
		halt;
	}

	var GameResourcePtr</GameParams/> game_params( ParseGameParamsFile( game_params_file_res.try_deref() ) );
	game_params_= game_params;
	return game_params;
}

fn CachedGameResourcesLoader::LoadMapsDescription( mut this ) : GameResourcePtr</MapsDescription/>
{
	if( !maps_description_.empty() )
	{
		return maps_description_.try_to_non_nullable();
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto maps_description_file_contents_res= game_filesystem.LoadFileToString( c_maps_description_file_name );

	if_var( e : maps_description_file_contents_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read maps description file! Error: ", ust::enum_to_string(e), "\n" ) );
		halt;
	}

	auto mut maps_description_opt= ParseMapsDescriptionFile( maps_description_file_contents_res.try_deref() );
	if( maps_description_opt.empty() )
	{
		ust::stderr_print( "Failed to parse maps description!\n" );
		halt;
	}

	var GameResourcePtr</MapsDescription/> maps_description( maps_description_opt.try_take() );
	maps_description_= maps_description;
	return maps_description;
}

fn CachedGameResourcesLoader::LoadMaterialsDescription( mut this ) : GameResourcePtr</MaterialsDescription/>
{
	if( !materials_description_.empty() )
	{
		return materials_description_.try_to_non_nullable();
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto materials_file_contents_res= game_filesystem.LoadFileToString( c_materials_file_name );
	if_var( e : materials_file_contents_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read materials file! Error: ", ust::enum_to_string(e), "\n" ) );
		halt;
	}

	var GameResourcePtr</MaterialsDescription/> materials_description( ParseMaterialsFile( materials_file_contents_res.try_deref() ) );
	materials_description_= materials_description;
	return materials_description;
}

fn CachedGameResourcesLoader::LoadEntitiesDescription( mut this, ust::filesystem_path_view file_name ) : GameResourcePtr</EntitiesDescription/>
{
	if_var( &v : entity_descriptions_.find( file_name ) )
	{
		return v;
	}

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto entities_description_file_contents_res= game_filesystem.LoadFileToString( file_name );

	if_var( e : entities_description_file_contents_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read entities description file! Error: ", ust::enum_to_string(e), "\n" ) );
		halt;
	}

	var GameResourcePtr</EntitiesDescription/> entities_description( ParseEntitiesDescriptionFile( entities_description_file_contents_res.try_deref() ) );
	entity_descriptions_.insert_new( file_name, entities_description );
	return entities_description;
}

fn CachedGameResourcesLoader::LoadZmapFile( mut this, u32 map_index ) : GameResourcePtr</ZmapData/>
{
	if_var( &d : zmap_data_ )
	{
		if( d[0] == map_index )
		{
			return d[1];
		}
	}

	var GameResourcePtr</MapsDescription/> maps_description_ptr= LoadMapsDescription();
	var MapsDescription::MapDescription& map_description= maps_description_ptr.deref().maps[ map_index ]; // Halts if no map found.

	auto mut lock= game_filesystem_.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto mut zmap_data_res= game_filesystem.LoadFile( ConvertToUppercase( map_description.wall_files[0] ), PM::LoadZmapFile );

	if_var( e : zmap_data_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read map file! Error: ", ust::enum_to_string(e), "\n" ) );
		halt;
	}

	var GameResourcePtr</ZmapData/> zmap_data( move(zmap_data_res).try_take() );
	zmap_data_= ust::make_tuple( map_index, zmap_data );
	return zmap_data;
}

} // namespace PM
