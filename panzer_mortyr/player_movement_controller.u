import "/sdl/sdl_with_opengl.iu"
import "math_constants.iu"
import "player_movement_controller.iu"

namespace PM
{

fn PlayerMovementController::constructor( SettingsImutPtr mut settings )
	( settings_= move(settings) )
{}

fn PlayerMovementController::Update( mut this, f32 time_delta_s, KeyboardState& keyboard_state )
{
	auto lock= settings_.lock_imut();
	var Settings& settings= lock.deref();

	var Vec3f mut current_frame_move_wish_vector= Vec3f::MakeZero();

	if( keyboard_state[ size_type( settings.in_key_move_forward.scancode ) ] )
	{
		current_frame_move_wish_vector.x+= 1.0f;
	}
	if( keyboard_state[ size_type( settings.in_key_move_backward.scancode ) ] )
	{
		current_frame_move_wish_vector.x-= 1.0f;
	}
	if( keyboard_state[ size_type( settings.in_key_move_left.scancode ) ] )
	{
		current_frame_move_wish_vector.y-= 1.0f;
	}
	if( keyboard_state[ size_type( settings.in_key_move_right.scancode ) ] )
	{
		current_frame_move_wish_vector.y+= 1.0f;
	}
	if( keyboard_state[ size_type( settings.in_key_move_up.scancode ) ] )
	{
		jump_requested_= true;
		current_frame_move_wish_vector.z-= 1.0f;
	}
	if( keyboard_state[ size_type( settings.in_key_move_down.scancode ) ] )
	{
		crouching_requested_= true;
		current_frame_move_wish_vector.z+= 1.0f;
	}

	running_requested_= keyboard_state[ size_type( settings.in_key_walk_or_run.scancode ) ] ^ settings.in_always_run;

	// Ensure result is normalized in XY plane.
	var f32 current_frame_move_wish_vector_xy_length= current_frame_move_wish_vector.xy().Length();
	if( current_frame_move_wish_vector_xy_length > 0.0f )
	{
		var f32 scale= time_delta_s / current_frame_move_wish_vector_xy_length;
		current_frame_move_wish_vector.x*= scale;
		current_frame_move_wish_vector.y*= scale;
	}

	current_frame_move_wish_vector.z*= time_delta_s;

	accumulated_move_wish_vector_+= current_frame_move_wish_vector;
	accumulated_time_s_+= time_delta_s;
}

fn PlayerMovementController::GetAccumulatedMoveWishVector( this ) : Vec3f
{
	if( accumulated_time_s_ == 0.0f )
	{
		return Vec3f::MakeZero();
	}

	return accumulated_move_wish_vector_ / accumulated_time_s_;
}

fn PlayerMovementController::GetJumpRequested( this ) : bool
{
	return jump_requested_;
}

fn PlayerMovementController::GetCrouchingRequested( this ) : bool
{
	return crouching_requested_;
}

fn PlayerMovementController::GetRunningRequested( this ) : bool
{
	return running_requested_;
}

fn PlayerMovementController::Reset( mut this )
{
	accumulated_move_wish_vector_= Vec3f::MakeZero();
	accumulated_time_s_= 0.0f;
	jump_requested_= false;
	crouching_requested_= false;
	running_requested_= false;
}

} // namespace PM
