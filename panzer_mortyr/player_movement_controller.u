import "/sdl/sdl_with_opengl.uh"
import "math_constants.uh"
import "player_movement_controller.uh"

namespace PM
{

fn PlayerMovementController::Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state )
{
	var size_type
		key_move_forward(SDL_SCANCODE_W),
		key_move_backward(SDL_SCANCODE_S),
		key_move_left(SDL_SCANCODE_A),
		key_move_right(SDL_SCANCODE_D),
		key_move_up(SDL_SCANCODE_SPACE),
		key_move_down(SDL_SCANCODE_C);

	var Vec3f mut current_frame_move_wish_vector= Vec3f::MakeZero();

	if( key_move_forward < keyboard_state.size() && keyboard_state[ key_move_forward ] )
	{
		current_frame_move_wish_vector.x+= 1.0f;
	}
	if( key_move_backward < keyboard_state.size() && keyboard_state[ key_move_backward ] )
	{
		current_frame_move_wish_vector.x-= 1.0f;
	}
	if( key_move_left < keyboard_state.size() && keyboard_state[ key_move_left ] )
	{
		current_frame_move_wish_vector.y-= 1.0f;
	}
	if( key_move_right < keyboard_state.size() && keyboard_state[ key_move_right ] )
	{
		current_frame_move_wish_vector.y+= 1.0f;
	}
	if( key_move_up < keyboard_state.size() && keyboard_state[ key_move_up ] )
	{
		jump_requested_= true;
		current_frame_move_wish_vector.z-= 1.0f;
	}
	if( key_move_down < keyboard_state.size() && keyboard_state[ key_move_down ] )
	{
		current_frame_move_wish_vector.z+= 1.0f;
	}

	// Ensure result is normalized in XY plane.
	var f32 current_frame_move_wish_vector_xy_length= current_frame_move_wish_vector.xy().Length();
	if( current_frame_move_wish_vector_xy_length > 0.0f )
	{
		var f32 scale= time_delta_s / current_frame_move_wish_vector_xy_length;
		current_frame_move_wish_vector.x*= scale;
		current_frame_move_wish_vector.y*= scale;
	}

	current_frame_move_wish_vector.z*= time_delta_s;

	accumulated_move_wish_vector_+= current_frame_move_wish_vector;
	accumulated_time_s_+= time_delta_s;
}

fn PlayerMovementController::GetAccumulatedMoveWishVector( this ) : Vec3f
{
	if( accumulated_time_s_ == 0.0f )
	{
		return Vec3f::MakeZero();
	}

	return accumulated_move_wish_vector_ / accumulated_time_s_;
}

fn PlayerMovementController::GetJumpRequested( this ) : bool
{
	return jump_requested_;
}

fn PlayerMovementController::Reset( mut this )
{
	accumulated_move_wish_vector_= Vec3f::MakeZero();
	accumulated_time_s_= 0.0f;
	jump_requested_= false;
}

} // namespace PM
