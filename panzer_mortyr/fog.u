import "/math.iu"
import "fog.iu"

namespace PM
{

fn CalculateFogForSemitransparentGeometryVertices(
	Vec3f& camera_position,
	[ f32, 3 ]& fog_color,
	ust::array_view_mut</MapVertex/> vertices )
{
	// Calculate per-vertex fog.
	// It's strictly-speaking just an approximation for per-pixel fog, since fog formula isn't linear.
	// Bit it's good enough approximation as long as triangles aren't huge.

	var [ u8, 3 ] fog_color_integer
	[
		( ust::max( 0.0f, ust::min( fog_color[0] * 255.0f, 255.0f ) ) ),
		( ust::max( 0.0f, ust::min( fog_color[1] * 255.0f, 255.0f ) ) ),
		( ust::max( 0.0f, ust::min( fog_color[2] * 255.0f, 255.0f ) ) ),
	];

	foreach( &mut v : vertices )
	{
		var f32 distance_to_camera= ( camera_position - Vec3f( v.position ) ).Length();

		// This code (including the scale constant) should match identical code in the global fog shader!
		var f32 distance_scale= 1.0f / 3072.0f;
		var f32 fog_density= 1.0f - ust::exp( -distance_to_camera * distance_scale );

		v.fog_color[0]= fog_color_integer[0];
		v.fog_color[1]= fog_color_integer[1];
		v.fog_color[2]= fog_color_integer[2];
		v.fog_color[3]= u8( ust::max( 0.0f, ust::min( fog_density * 255.0f, 255.0f ) ) );
	}
}

} // namespace PM
