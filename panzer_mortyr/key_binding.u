import "/scoped_array.iu"
import "key_binding.iu"

namespace PM
{

fn KeyBinding::CreateFromName( ust::string_view8 name ) : ust::optional</KeyBinding/>
{
	scoped_array char8 name_nt[ name.size() + 1s ]( name.iter().chain( ust::string_view8( "\0" ).iter() ) );

	unsafe
	{
		// According to SDL2 documentation not all scancodes have names.
		// But all important ones have one.
		// Don't care about others.

		var SDL_Scancode scancode= SDL_GetScancodeFromName( name_nt.data() );
		if( scancode != SDL_Scancode(0) )
		{
			return KeyBinding( scancode, PrivateTag() );
		}
	}

	return ust::null_optional;
}

fn KeyBinding::CreateFromKeyScancode( SDL_Scancode s ) : KeyBinding
{
	return KeyBinding( s, PrivateTag() );
}

fn KeyBinding::constructor( SDL_Scancode key_scancode, PrivateTag t )
	( scancode_= key_scancode )
{
	ust::ignore_unused(t);
}

fn KeyBinding::GetAsKeyScancode( this ) : ust::optional</SDL_Scancode/>
{
	if( scancode_ > SDL_Scancode(0) && scancode_ < SDL_NUM_SCANCODES )
	{
		return scancode_;
	}

	return ust::null_optional;
}

fn KeyBinding::GetName( this ) : ust::string_view8
{
	unsafe
	{
		// This function returns static string, so, it's safe to use it as long as it can be done.
		var $(char8) mut name_nt= SDL_GetScancodeName( scancode_ );
		if( ust::is_nullptr( name_nt ) )
		{
			return "";
		}

		var size_type mut size= 0s;
		while( $>( name_nt + size ) != '\0' )
		{
			++size;
		}

		return ust::string_view8( name_nt, size );
	}
}

} // namespace PM
