import "/assert.iu"
import "/scoped_array.iu"
import "/common_lib/char_case.iu"
import "key_binding.iu"

namespace PM
{

fn KeyBinding::CreateFromName( ust::string_view8 name ) : ust::optional</KeyBinding/>
{
	// Check first if it's a mouse binding name.
	{
		var u32 mut b= 0u;
		for( &n : c_mouse_button_names )
		{
			if( StringsAreCaseInsensetiveEqual( n, name ) )
			{
				return KeyBinding::CreateFromMouseButton( b );
			}
			++b;
		}
	}

	scoped_array char8 name_nt[ name.size() + 1s ]( name.iter().chain( ust::string_view8( "\0" ).iter() ) );

	unsafe
	{
		// According to SDL2 documentation not all scancodes have names.
		// But all important ones have one.
		// Don't care about others.

		var SDL_Scancode scancode= SDL_GetScancodeFromName( name_nt.data() );
		if( scancode != SDL_Scancode(0) )
		{
			return KeyBinding( u32( scancode ), PrivateTag() );
		}
	}

	return ust::null_optional;
}

fn KeyBinding::CreateFromKeyboardKeyScancode( SDL_Scancode s ) : KeyBinding
{
	return KeyBinding( u32(s), PrivateTag() );
}

fn KeyBinding::CreateFromMouseButton( u32 button_index ) : KeyBinding
{
	debug_assert( button_index < c_num_mouse_buttons );
	return KeyBinding( c_first_mouse_button_code + button_index, PrivateTag() );
}

fn KeyBinding::constructor( u32 code, PrivateTag t )
	( code_= code )
{
	ust::ignore_unused(t);
}

fn KeyBinding::GetAsKeyboardKeyScancode( this ) : ust::optional</SDL_Scancode/>
{
	if( code_ > 0u && code_ < u32( SDL_NUM_SCANCODES ) )
	{
		return SDL_Scancode(code_);
	}

	return ust::null_optional;
}

fn KeyBinding::GetAsMouseButton( this ) : ust::optional</u32/>
{
	if( code_ >= c_first_mouse_button_code && code_ < c_first_mouse_button_code + c_num_mouse_buttons )
	{
		return code_ - c_first_mouse_button_code;
	}

	return ust::null_optional;
}

fn KeyBinding::GetName( this ) : ust::string_view8
{
	if( code_ >= c_first_mouse_button_code && code_ < c_first_mouse_button_code + c_num_mouse_buttons )
	{
		auto mut c= c_first_mouse_button_code;
		for( &n : c_mouse_button_names )
		{
			if( c == code_ )
			{
				return n;
			}
			++c;
		}
	}

	unsafe
	{
		// This function returns static string, so, it's safe to use it as long as it can be done.
		var $(char8) mut name_nt= SDL_GetScancodeName( SDL_Scancode( code_ ) );
		if( ust::is_nullptr( name_nt ) )
		{
			return "";
		}

		var size_type mut size= 0s;
		while( $>( name_nt + size ) != '\0' )
		{
			++size;
		}

		return ust::string_view8( name_nt, size );
	}
}

