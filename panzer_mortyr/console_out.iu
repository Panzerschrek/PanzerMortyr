import "/shared_ptr.iu"
import "/string.iu"

namespace PM
{

type ConsoleOutPtr= ust::shared_ptr_mut</ConsoleOut/>;

// Buffer for console messages. It has limited history length.
// It's basically a logger class.
class ConsoleOut
{
public:
	fn AddTextLine( mut this, ust::string8 line );

	fn GetNumLines( this ) : size_type;

	// Return line indexed from the end.
	// Input index should be less than current number of lines.
	fn GetLine( this, size_type index ) : ust::string_view8 @( ust::reference_notation::return_inner_references::param0 );

private:
	var size_type c_max_lines_stored= 64s;

private:
	// Use circular buffer for lines. We shouldn't have infinite history.
	// Start/end pointers aren't wrapped-around, use % c_max_lines_stored to access values using these pointers.
	size_type lines_start_= 0s;
	size_type lines_end_= 0s;
	[ ust::string8, c_max_lines_stored ] lines_;
}

// Helper function for line adding.
fn ConsoleOutAddTextLine( ConsoleOutPtr& console_out_ptr, ust::string8 line );

} // namespace PM
