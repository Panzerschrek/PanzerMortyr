import "/sdl/sdl_with_opengl.iu"
import "abstract_window.iu"
import "console_out.iu"
import "settings.iu"

namespace PM
{

// A RAII class for creating/destroying a window with OpenGL output support.
class WindowGL final : AbstractWindow
{
public:
	// Constructor halts if failed to initialize.
	fn constructor( SettingsPtr settings, ConsoleOutPtr& console_out );

	fn destructor();

	fn virtual override GetViewportSize( this ) : [ u32, 2 ];

	fn virtual override SwapWindow( mut this );

	fn virtual override MakeScreenshot( mut this ) : ImageData;

private:
	fn UpdateVsync( mut this );
	fn UpdateGamma( mut this );

private:
	SettingsPtr imut settings_;
	[ u32, 2 ] viewport_size_;
	$(SDL_Window) window_;
	SDL_GLContext gl_context_;

	bool prev_vsync_;
	f32 prev_gamma_;
}

static_assert( !typeinfo</WindowGL/>.is_copy_constructible && !typeinfo</WindowGL/>.is_copy_assignable );

} // namespace PM
