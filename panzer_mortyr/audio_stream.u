import "audio_stream.iu"

namespace PM
{

fn AudioStream::Create( u32 frequency ) : tup[ WriteEnd, ReadEnd ]
{
	auto [ mut write_end, mut read_end ]= Queue::Create();

	var tup[ WriteEnd, ReadEnd ] ends[ ( move( write_end ), frequency ), ( move( read_end ), frequency ) ];
	return ends;
}

fn AudioStream::WriteEnd::constructor( Queue::WriteEnd mut queue_write_end, u32 frequency )
	( queue_write_end_= move( queue_write_end ), frequency_= frequency )
{}

fn AudioStream::WriteEnd::GetFrequency( this ) : u32
{
	return frequency_;
}

fn AudioStream::WriteEnd::WriteSamples( mut this, ust::array_view_imut</SampleType/> samples ) : size_type
{
	// TODO - optimize this, push the whole range.

	var size_type mut samples_written= 0s;
	foreach( sample : samples )
	{
		if( queue_write_end_.TryPush( sample ) )
		{
			++samples_written;
		}
	}

	return samples_written;
}

fn AudioStream::ReadEnd::constructor( Queue::ReadEnd mut queue_read_end, u32 frequency )
	( queue_read_end_= move( queue_read_end ), frequency_= frequency )
{}

fn AudioStream::ReadEnd::GetFrequency( this ) : u32
{
	return frequency_;
}

fn AudioStream::ReadEnd::ReadSamples( mut this, ust::array_view_mut</SampleType/> samples ) : size_type
{
	// TODO - optimize this, pop the whole range.

	var size_type mut samples_read= 0s;
	foreach( &mut dst_sample : samples )
	{
		if_var( sample : queue_read_end_.TryPop() )
		{
			dst_sample= sample;
		}
		else
		{
			break;
		}
	}
	return samples_read;
}

} // namespace PM
