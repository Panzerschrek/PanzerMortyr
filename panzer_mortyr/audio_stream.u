import "audio_stream.iu"

namespace PM
{

fn AudioStream::Create( u32 frequency ) : tup[ WriteEnd, ReadEnd ]
{
	auto [ mut write_end, mut read_end ]= Queue::Create();

	var tup[ WriteEnd, ReadEnd ] ends[ ( move( write_end ), frequency ), ( move( read_end ), frequency ) ];
	return ends;
}

fn AudioStream::WriteEnd::constructor( Queue::WriteEnd mut queue_write_end, u32 frequency )
	( queue_write_end_= move( queue_write_end ), frequency_= frequency )
{}

fn AudioStream::WriteEnd::GetFrequency( this ) : u32
{
	return frequency_;
}

fn nodiscard AudioStream::WriteEnd::WriteSamples( mut this, ust::array_view_imut</SampleType/> samples ) : size_type
{
	return queue_write_end_.PushCopyMany( samples );
}

fn AudioStream::WriteEnd::GetTotalNumberOfSamplesWritten( this ) : u32
{
	return queue_write_end_.GetTotalNumberOfElementsPushed();
}

fn AudioStream::WriteEnd::GetTotalNumberOfSamplesRead( this ) : u32
{
	return queue_write_end_.GetTotalNumberOfElementsPopped();
}

fn AudioStream::WriteEnd::OtherEndIsClosed( this ) : bool
{
	return queue_write_end_.OtherEndIsClosed();
}

fn AudioStream::ReadEnd::constructor( Queue::ReadEnd mut queue_read_end, u32 frequency )
	( queue_read_end_= move( queue_read_end ), frequency_= frequency )
{}

fn AudioStream::ReadEnd::GetFrequency( this ) : u32
{
	return frequency_;
}

fn nodiscard AudioStream::ReadEnd::ReadSamples( mut this, ust::array_view_mut</SampleType/> samples ) : size_type
{
	return queue_read_end_.PopMany( samples );
}

fn AudioStream::ReadEnd::GetTotalNumberOfSamplesWritten( this ) : u32
{
	return queue_read_end_.GetTotalNumberOfElementsPushed();
}

fn AudioStream::ReadEnd::GetTotalNumberOfSamplesRead( this ) : u32
{
	return queue_read_end_.GetTotalNumberOfElementsPopped();
}

fn AudioStream::ReadEnd::OtherEndIsClosed( this ) : bool
{
	return queue_read_end_.OtherEndIsClosed();
}

} // namespace PM
