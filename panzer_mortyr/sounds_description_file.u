import "/integer_parsing.iu"
import "/common_lib/string_iterators.iu"
import "sounds_description_file.iu"

namespace PM
{

fn ParseSoundsDescriptionFile( ust::string_view8 file_contents ) : SoundsDescription
{
	var SoundsDescription mut sounds_description;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "odglos" )
		{
			if_var( index_str : words_it.next() )
			{
				if_var( index : ust::parse_integer</u32/>( index_str ) )
				{
					if( size_type(index) < typeinfo</ typeof( sounds_description.sounds ) />.element_count )
					{
						var SoundsDescription::SoundDescription &mut sound_description=
							sounds_description.sounds[ index ];

						if_var( file_name : words_it.next() )
						{
							sound_description.file_name= ConvertStringToResourceString( file_name );
						}

						if_var( num_str : words_it.next() )
						{
							if_var( num : ust::parse_integer_exact</u32/>( num_str ) )
							{
								sound_description.some_param= num;
							}
						}
					}
				}
			}
		}
		else
		{
			// TODO - parse other data.
		}
	}

	return sounds_description;
}

} // namespace PM
