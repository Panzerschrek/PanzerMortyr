import "/integer_parsing.iu"
import "/common_lib/string_iterators.iu"
import "sounds_description_file.iu"

namespace PM
{

fn ParseSoundsDescriptionFile( ust::string_view8 file_contents ) : SoundsDescription
{
	var SoundsDescription mut sounds_description;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "odglos" )
		{
			if_var( index_str : words_it.next() )
			{
				if_var( index : ust::parse_integer</u32/>( index_str ) )
				{
					if( size_type(index) < typeinfo</ typeof( sounds_description.sounds ) />.element_count )
					{
						var SoundsDescription::SoundDescription &mut sound_description=
							sounds_description.sounds[ index ];

						if_var( file_name : words_it.next() )
						{
							sound_description.file_name= ConvertStringToResourceString( file_name );
						}

						if_var( num_str : words_it.next() )
						{
							if_var( num : ust::parse_integer_exact</u32/>( num_str ) )
							{
								sound_description.some_param= num;
							}
						}
					}
				}
			}
		}
		else
		{
			// TODO - optimize/simplify this.

			auto try_read_sound_index_param=
				lambda[&]( i32 &mut param, ust::string_view8 param_name )
				{
					if( first_word == param_name && words_it.next() == ust::string_view8( "=" ) )
					{
						if_var( mut num_str : words_it.next() )
						{
							// Use this call to ignore trailing ";" for some numbers.
							if_var( num : ust::parse_and_extract_integer</i32/>( num_str ) )
							{
								param= num;
							}
						}
					}
				};

			try_read_sound_index_param( sounds_description.character_entering_water, "boh_do_wody" );
			try_read_sound_index_param( sounds_description.character_entering_lava, "boh_do_lawy" );
			try_read_sound_index_param( sounds_description.character_entering_acid, "boh_do_kwasu" );
			try_read_sound_index_param( sounds_description.character_leaving_water, "boh_z_wody" );
			try_read_sound_index_param( sounds_description.character_damage, "boh_rana" );
			try_read_sound_index_param( sounds_description.character_death, "boh_umiera" );
			try_read_sound_index_param( sounds_description.character_step_left, "boh_krok_lewy" );
			try_read_sound_index_param( sounds_description.character_step_right, "boh_krok_prawy" );
			try_read_sound_index_param( sounds_description.character_fall, "boh_upadek" );
			try_read_sound_index_param( sounds_description.character_jump, "boh_podskok" );
			try_read_sound_index_param( sounds_description.character_sinking, "boh_tonacy" );

			try_read_sound_index_param( sounds_description.elevator, "winda_standard" );
			try_read_sound_index_param( sounds_description.menu, "menu_standard" );
			try_read_sound_index_param( sounds_description.push_button, "przelacznik_standard" );
			try_read_sound_index_param( sounds_description.glass, "szklo_standard" );
			try_read_sound_index_param( sounds_description.secret_found, "sekret_standard" );
			try_read_sound_index_param( sounds_description.explosion, "silna_eksplozja_standard" );

			try_read_sound_index_param( sounds_description.weapon_pickup[ 0], "podnies_bron_a" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 1], "podnies_bron_b" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 2], "podnies_bron_c" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 3], "podnies_bron_d" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 4], "podnies_bron_e" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 5], "podnies_bron_f" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 6], "podnies_bron_g" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 7], "podnies_bron_h" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 8], "podnies_bron_i" );
			try_read_sound_index_param( sounds_description.weapon_pickup[ 9], "podnies_bron_j" );
			try_read_sound_index_param( sounds_description.weapon_pickup[10], "podnies_bron_k" );

			try_read_sound_index_param( sounds_description.key_pickup[0], "podnies_kata_a" );
			try_read_sound_index_param( sounds_description.key_pickup[1], "podnies_kata_b" );
			try_read_sound_index_param( sounds_description.key_pickup[2], "podnies_kata_c" );

			try_read_sound_index_param( sounds_description.health_pickup, "podnies_apteczka" );
			try_read_sound_index_param( sounds_description.armor_pickup, "podnies_oslona" );
			try_read_sound_index_param( sounds_description.other_pickup, "podnies_inne" );

			try_read_sound_index_param( sounds_description.enemy_damage[0], "przeciwnik_rana_1" );
			try_read_sound_index_param( sounds_description.enemy_damage[1], "przeciwnik_rana_2" );
			try_read_sound_index_param( sounds_description.enemy_damage[2], "przeciwnik_rana_3" );
			try_read_sound_index_param( sounds_description.enemy_damage[3], "przeciwnik_rana_4" );

			try_read_sound_index_param( sounds_description.enemy_alarm[0], "przeciwnik_wolanie_1" );
			try_read_sound_index_param( sounds_description.enemy_alarm[1], "przeciwnik_wolanie_2" );
			try_read_sound_index_param( sounds_description.enemy_alarm[2], "przeciwnik_wolanie_3" );
			try_read_sound_index_param( sounds_description.enemy_alarm[3], "przeciwnik_wolanie_4" );

			// TODO - parse other params.
		}
	}

	return sounds_description;
}

} // namespace PM
