import "vec.uh"
import "entities_description_file.uh"

namespace PM
{

struct EntityState
{
	u32 kind; // Should be valid index within entities description.

	Vec3f position;
	f32 azimuth;

	u32 current_operation; // Should be valid operation index.
	u32 next_operation; // Is ~0u if not selected yet.

	u32 num_steps_since_operation_start;
	u32 num_steps_left_to_next_operation;

	// If not ~0u renresents navigation info index (and also navigation graph index).
	u32 navigation_info_index;

	// If not ~0u represents navigation graph node used for moving.
	u32 target_navigation_graph_node;

	// If not ~0u represents navigation graph node to which this entity is attached.
	// This node should be changed only while navigating the graph.
	// Re-calculated the nearest one can't work, because original navigation graphs are somewhat buggy.
	u32 current_navigation_graph_node;

	bool has_seen_player_in_current_operation;
	bool player_is_inside_shooting_zone;
	bool lost_energy_in_current_operation;

	// There are several animation kinds and each may use different source model.
	// Calculate and store frame for each of them.
	[ u32, typeinfo</EntitiesDescription::Operation::AnimationKind/>.element_count ] animation_frames;
}

struct PlayerState
{
	Vec3f position;

	// Velocity in units per game logic step.
	Vec3f velocity;
}

} // namespace PM
