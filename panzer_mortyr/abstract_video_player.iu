import "audio_processor.iu"
import "console_out.iu"
import "image_data.iu"
import "performance_counter.iu"

namespace PM
{

class AbstractVideoPlayer abstract non_sync
{
public:
	fn constructor( ConsoleOutPtr mut console_out );

	fn PlayVideo( mut this, ust::filesystem_path_view file_path, AudioProcessor &mut audio_processor );

protected:
	fn virtual pure SetFrame( mut this, [ u32, 2 ] size, ust::array_view_imut</RGBAColor/> pixels );

	fn virtual pure DrawAndPresentFrame( mut this );

private:
	ConsoleOutPtr imut console_out_;
	PerformanceCounter imut performance_counter_;
}

} // namespace PM
