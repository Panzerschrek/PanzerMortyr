import "crosshair_drawing_info.iu"
import "game_structs.iu"
import "global_navigation_graph_route_searcher.iu"

namespace PM
{

fn CreateNewMapGameState(
	ConsoleOutPtr& console_out,
	GameGlobalData& global_data,
	GameMapData& map_data,
	u32 skill,
	ust::optional_ref_imut</PlayerState/> prev_player_state ) : GameState;

fn ProcessGameLogicStep(
	GameGlobalData& global_data,
	GameMapData& map_data,
	PlayerInput& player_input,
	GameState &mut game_state,
	GlobalNavigationGraphRouteSearcher &mut route_searcher );

fn CountKills( GameGlobalData& global_data, GameMapData& map_data, GameState& game_state ) : [ u32, 2 ];

// The original game uses angles in range 0 to 1024 mapped to 0 to tau and with negative sign.
fn Convert1024Angle( f32 a ) : f32;

fn IsPointInLiquid( GameMapData& map_data, Vec3f& point ) : bool;

fn GetCrosshairPositionAndKind(
	GameMapData& map_data,
	GameState& game_state,
	f32 camera_azimuth,
	f32 camera_elevation ) : tup[ Vec3f, CrosshairDrawingInfo::HitPointKind ];

// Tools which are shown in the inventory and may be activated.
// No keys and ammo are listed here.
// Some items aren't listed too, since they are unused. TODO - add possible multiplayer powerups.
var [ EntitiesDescription::ToolType, 18 ] c_inventory_accessible_tools
[
	EntitiesDescription::ToolType::WeaponA,
	EntitiesDescription::ToolType::WeaponB,
	EntitiesDescription::ToolType::WeaponC,
	EntitiesDescription::ToolType::WeaponD,
	EntitiesDescription::ToolType::WeaponE,
	EntitiesDescription::ToolType::WeaponF,
	EntitiesDescription::ToolType::WeaponG,
	EntitiesDescription::ToolType::WeaponH,
	EntitiesDescription::ToolType::WeaponI,
	EntitiesDescription::ToolType::WeaponJ,
	EntitiesDescription::ToolType::Armor,
	EntitiesDescription::ToolType::HealthPack,
	EntitiesDescription::ToolType::Jetpack,
	EntitiesDescription::ToolType::NightVision,
	EntitiesDescription::ToolType::InfraredVision,
	EntitiesDescription::ToolType::Flashlight,
	EntitiesDescription::ToolType::Invisibility,
	EntitiesDescription::ToolType::AcidProtectionSuit,
];

} // namespace PM
