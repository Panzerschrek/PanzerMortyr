import "/common_lib/map_loading.iu"
import "quads_hierarchy.iu"
import "vertex_formats.iu"
import "world_drawing_info.iu"

namespace PM
{

// Create polygons for given decals.
// It's costly to do so, thus avoid having too many decals.
// Decal polygons created are view-deependent (have an offset towards camera to avoid Z-fighting).
fn CreateDecalPolygons(
	ust::array_view_imut</WorldDrawingInfo::Decal/> decals,
	ust::array_view_imut</WorldDrawingInfo::DynamicClusterObject/> dynamic_cluster_objects,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads,
	BitArrayView broken_quad_bits,
	ZmapLamData& zmap_lam_data,
	QuadsHierarchy& quads_hierarchy,
	Vec3f& camera_position,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices );

fn CreateWaterCircleDecalPolygons(
	f32 game_time_s,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads,
	ZmapLamData& zmap_lam_data,
	QuadsHierarchy& quads_hierarchy,
	BitArrayView wet_material_bits,
	Vec3f& camera_position,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices );

} // namespace PM
