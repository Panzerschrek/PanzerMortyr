import "geometry_utils.uh"

namespace PM
{

fn FindRayPolyhedronIntersection(
	Vec3f& ray_start,
	Vec3f& ray_direction,
	ust::array_view_imut</Planef/> polyhedron_planes ) : ust::optional</RayPolyhedronIntersectionResult/>
{
	// Use here ray-convex polyhedron intersection algorithm invented by Eric Haines.

	var f32 constexpr max_float= 1.0e38f;

	var f32 mut near_distance= -max_float, mut far_distance= max_float;
	var size_type mut near_index= ~0s, mut far_index= ~0s;

	for( auto mut i= 0s; i < polyhedron_planes.size(); ++i )
	{
		var Planef& plane= polyhedron_planes[i];

		var f32 direction_vector_plane_normal_dot= ray_direction.Dot( plane.normal );
		var f32 ray_start_distance_to_plane= plane.GetDistanceForPoint( ray_start );

		if( direction_vector_plane_normal_dot > 0.0f )
		{
			var f32 signed_distance_to_intersection_point= -ray_start_distance_to_plane / direction_vector_plane_normal_dot;
			if( signed_distance_to_intersection_point < far_distance )
			{
				far_distance= signed_distance_to_intersection_point;
				far_index= i;
			}
		}
		else if( direction_vector_plane_normal_dot < 0.0f )
		{
			var f32 signed_distance_to_intersection_point= -ray_start_distance_to_plane / direction_vector_plane_normal_dot;
			if( signed_distance_to_intersection_point > near_distance )
			{
				near_distance= signed_distance_to_intersection_point;
				near_index= i;
			}
		}
		else
		{
			// Ray parallel to the plane. Check if ray start is outside this plane and if so - return empty result since no intersection is possible.
			if( ray_start_distance_to_plane > 0.0f )
			{
				return ust::null_optional;
			}
		}
	}

	if( near_distance > far_distance )
	{
		// No intersection.
		return ust::null_optional;
	}
	if( near_index >= polyhedron_planes.size() || far_index >= polyhedron_planes.size() )
	{
		// Something went wrong.
		return ust::null_optional;
	}

	return RayPolyhedronIntersectionResult
	{
		.near_point_distance= near_distance,
		.near_plane_index( near_index ),
		.far_point_distance= far_distance,
		.far_point_index( far_index ),
	};
}

fn CreateBBoxPlanes( BBox3f& bbox ) : [ Planef, 6 ]
{
	var [ Planef, 6 ] planes
	[
		{ .normal( -1.0f,  0.0f,  0.0f ), .distance=  bbox.min.x },
		{ .normal(  1.0f,  0.0f,  0.0f ), .distance= -bbox.max.x },
		{ .normal(  0.0f, -1.0f,  0.0f ), .distance=  bbox.min.y },
		{ .normal(  0.0f,  1.0f,  0.0f ), .distance= -bbox.max.y },
		{ .normal(  0.0f,  0.0f, -1.0f ), .distance=  bbox.min.z },
		{ .normal(  0.0f,  0.0f,  1.0f ), .distance= -bbox.max.z },
	];

	return planes;
}

fn CreateBBoxAndQuadMinkowskiSum( BBox3f& bbox, [ Vec3f, 4 ]& quad_vertices ) : ust::vector</Planef/>
{
	var ust::vector</Planef/> mut result_planes;

	// Calculate quad normal. All these checks are necessary to skip degenerate triagles with zero-length normal.
	var Vec3f mut quad_normal( 0.0f, 0.0f, 0.0f );
	if( quad_vertices[1] != quad_vertices[2] && quad_vertices[2] != quad_vertices[3] )
	{
		quad_normal= ( quad_vertices[2] - quad_vertices[1] ).Cross( quad_vertices[3] - quad_vertices[2] );
	}
	else if( quad_vertices[0] != quad_vertices[2] && quad_vertices[2] != quad_vertices[3] )
	{
		quad_normal= ( quad_vertices[2] - quad_vertices[0] ).Cross( quad_vertices[3] - quad_vertices[2] );
	}
	else if( quad_vertices[0] != quad_vertices[1] && quad_vertices[1] != quad_vertices[3] )
	{
		quad_normal= ( quad_vertices[1] - quad_vertices[0] ).Cross( quad_vertices[3] - quad_vertices[1] );
	}
	else if( quad_vertices[0] != quad_vertices[1] && quad_vertices[1] != quad_vertices[2] )
	{
		quad_normal= ( quad_vertices[1] - quad_vertices[0] ).Cross( quad_vertices[2] - quad_vertices[1] );
	}
	else
	{
		return result_planes;
	}

	if( quad_normal.SquareLength() == 0.0f )
	{
		return result_planes;
	}

	var BBox3f quad_extended_bbox
	{
		.min= bbox.min +
			Vec3f(
				ust::min( ust::min( quad_vertices[0].x, quad_vertices[1].x ), ust::min( quad_vertices[2].x, quad_vertices[3].x ) ),
				ust::min( ust::min( quad_vertices[0].y, quad_vertices[1].y ), ust::min( quad_vertices[2].y, quad_vertices[3].y ) ),
				ust::min( ust::min( quad_vertices[0].z, quad_vertices[1].z ), ust::min( quad_vertices[2].z, quad_vertices[3].z ) ) ),
		.max= bbox.max +
			Vec3f(
				ust::max( ust::max( quad_vertices[0].x, quad_vertices[1].x ), ust::max( quad_vertices[2].x, quad_vertices[3].x ) ),
				ust::max( ust::max( quad_vertices[0].y, quad_vertices[1].y ), ust::max( quad_vertices[2].y, quad_vertices[3].y ) ),
				ust::max( ust::max( quad_vertices[0].z, quad_vertices[1].z ), ust::max( quad_vertices[2].z, quad_vertices[3].z ) ) ),
	};

	// Add all bounding box planes to the volume.
	foreach( &plane : CreateBBoxPlanes( quad_extended_bbox ) )
	{
		result_planes.push_back( plane );
	}

	var bool quad_plane_is_axis_aligned=
		( quad_normal.x == 0.0f && quad_normal.y == 0.0f ) ||
		( quad_normal.x == 0.0f && quad_normal.z == 0.0f ) ||
		( quad_normal.y == 0.0f && quad_normal.z == 0.0f );

	// Add front and back planes of the quad, but only if a plane is't one of axis planes.
	if( !quad_plane_is_axis_aligned )
	{
		var [ Vec3f, 8 ] bbox_vertices
		[
			( bbox.min.x, bbox.min.y, bbox.min.z ),
			( bbox.max.x, bbox.min.y, bbox.min.z ),
			( bbox.min.x, bbox.max.y, bbox.min.z ),
			( bbox.max.x, bbox.max.y, bbox.min.z ),
			( bbox.min.x, bbox.min.y, bbox.max.z ),
			( bbox.max.x, bbox.min.y, bbox.max.z ),
			( bbox.min.x, bbox.max.y, bbox.max.z ),
			( bbox.max.x, bbox.max.y, bbox.max.z ),
		];

		{
			var f32 mut max_dist= -1.0e38f;
			foreach( &v : bbox_vertices )
			{
				var f32 dist= quad_normal.Dot( v );
				if( dist > max_dist )
				{
					max_dist= dist;
				}
			}

			result_planes.push_back(
				Planef
				{
					.normal= quad_normal,
					.distance= -max_dist - quad_normal.Dot( quad_vertices[0] )
				} );
		}
		{
			var Vec3f inverted_quad_normal= -quad_normal;

			var f32 mut max_dist= -1.0e38f;
			foreach( &v : bbox_vertices )
			{
				var f32 dist= inverted_quad_normal.Dot( v );
				if( dist > max_dist )
				{
					max_dist= dist;
				}
			}

			result_planes.push_back(
				Planef
				{
					.normal= inverted_quad_normal,
					.distance= -max_dist - inverted_quad_normal.Dot( quad_vertices[0] )
				} );
		}
	}

	// TODO - create here edge product planes.

	return result_planes;
}

} // namespace PM
