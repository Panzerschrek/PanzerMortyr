import "/common_lib/resource_string.iu"

namespace PM
{

struct SoundsDescription
{
	var size_type c_num_sounds= 128s;

	// Use fixed-sized array with some upper limit for simplicity.
	[ SoundDescription, c_num_sounds ] sounds;

	i32 character_entering_water= -1; // boh_do_wody
	i32 character_entering_lava= -1; // boh_do_lawy
	i32 character_entering_acid= -1; // boh_do_kwasu
	i32 character_leaving_water= -1; // boh_z_wody
	i32 character_damage= -1; // boh_rana
	i32 character_death= -1; // boh_umiera
	i32 character_step_left= -1; // boh_krok_lewy
	i32 character_step_right= -1; // boh_krok_prawy
	i32 character_fall= -1; // boh_upadek
	i32 character_jump= -1; // boh_podskok
	i32 character_sinking= -1; // boh_tonacy

	struct SoundDescription
	{
		ResourceString file_name= zero_init;

		// For now some unclear param.
		// It's usually 100, sometimes 150 or 200, in rare cases 256.
		// Maybe it's priority?
		u32 some_param= 0u;
	}
}

var ResourceString& c_sounds_description_file_name= "GLOS.STD\0\0\0\0\0\0\0\0";

fn ParseSoundsDescriptionFile( ust::string_view8 file_contents ) : SoundsDescription;

} // namespace PM
