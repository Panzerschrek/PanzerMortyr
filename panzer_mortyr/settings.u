import "/file_helpers.u"
import "/string.u"
import "/string_conversions.u"
import "settings.uh"

namespace PM
{

fn LoadSettings() : SettingsPtr
{
	// TODO - do actual loading.
	return SettingsPtr( Settings() );
}

fn SaveSettings( Settings& settings )
{
	var ust::string8 mut contents;


	foreach( &field : typeinfo</Settings/>.fields_list )
	{
		contents+= field.name;

		contents.push_back( ' ' );

		SerializeValue( contents, mixin( "settings." + field.name ) );

		contents.push_back( '\n' );
	}

	if_var( e : ust::write_string_view_to_file( c_default_settings_file_name, contents ).as_error_ref() )
	{
		// TODO - write an error into the log.
		ust::ignore_unused(e);
	}
}

template</type T/>
fn SerializeValue( ust::string8 &mut s, T& value )
{
	s+= ust::to_string8( value );
}

auto& c_default_settings_file_name= "panzer_mortyr.cfg";

} // namespace PM
