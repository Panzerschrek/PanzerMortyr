import "/enum_string_conversions.iu"
import "/file_helpers.iu"
import "/math.iu"
import "/number_parsing.iu"
import "/string.iu"
import "/stringifier.iu"
import "/stringifier_apply.iu"
import "/common_lib/char_case.iu"
import "/common_lib/string_iterators.iu"
import "settings.iu"

namespace PM
{

fn LoadSettings( ust::filesystem_path_view file_path, ConsoleOutPtr& console_out ) : SettingsPtr
{
	ConsoleOutAddTextLine( console_out, ust::concat( "Loading settings from file \"", file_path, "\"" ) );

	var Settings mut settings;

	auto load_res= ust::read_file_to_string( file_path );
	if_var( e : load_res.as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out,
			ust::concat( "Failed to read settings file \"", file_path, "\"! Error: ", ust::enum_to_string( e ) ) );

		return SettingsPtr( move( settings ) );
	}

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( load_res.try_deref() ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();

		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		foreach( &field_description : typeinfo</Settings/>.fields_list )
		{
			if( first_word == field_description.name )
			{
				TryDeserializeValue( words_it, mixin( "settings." + field_description.name ) );
				break;
			}
		}
	}

	return SettingsPtr( move( settings ) );
}

fn SaveSettings( Settings& settings,  ust::filesystem_path_view file_path, ConsoleOutPtr& console_out )
{
	var ust::default_stringifier8 mut stringifier;

	foreach( &field_description : typeinfo</Settings/>.fields_list )
	{
		ust::apply_value_to_stringifier( stringifier, field_description.name );
		ust::apply_value_to_stringifier( stringifier, ' ' );

		SerializeValue( stringifier, mixin( "settings." + field_description.name ) );

		ust::apply_value_to_stringifier( stringifier, '\n' );
	}

	ConsoleOutAddTextLine( console_out, ust::concat( "Save settings into file \"", file_path, "\"" ) );

	if_var( e : ust::write_string_view_to_file( file_path, move(stringifier).get() ).as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out,
			ust::concat( "Failed to write settings file \"",  file_path,  "\"! Error: ",  ust::enum_to_string( e ) ) );
	}
}

fn TryDeserializeValue( ust::iterator</ WordsIterator /> &mut it, bool &mut value )
{
	if_var( s : it.next() )
	{
		if_var( i : ust::parse_number_exact</u32/>(s) )
		{
			value = i != 0u;
		}
	}
}

fn TryDeserializeValue( ust::iterator</ WordsIterator /> &mut it, KeyBinding &mut value )
{
	auto mut binding= KeyBinding::CreateFromName( ExtractSpaceSeparatedWords( it ) );
	if( !binding.empty() )
	{
		value= binding.try_take();
	}
}

template</type T/>
fn TryDeserializeValue( ust::iterator</ WordsIterator /> &mut it, T &mut value )
{
	if_var( s : it.next() )
	{
		static_if( typeinfo</T/>.is_enum )
		{
			foreach( &el : typeinfo</T/>.elements_list )
			{
				if( StringsAreCaseInsensetiveEqual( el.name, s ) )
				{
					value= mixin( "T::" + el.name );
				}
			}
		}
		else if_var( v : ust::parse_number_exact</T/>(s) )
		{
			// Don't allow reading "nan" and "inf" values.
			static_if( typeinfo</T/>.is_float )
			{
				if( ust::is_nan( v ) || v == ust::plus_inf</T/>() || v == ust::minus_inf</T/>() )
				{
					return;
				}
			}

			value= v;
		}
	}
}

fn SerializeValue( ust::default_stringifier8 &mut s, bool& value )
{
	ust::apply_value_to_stringifier( s, ( value ? '1' : '0' ) );
}

fn SerializeValue( ust::default_stringifier8 &mut s, KeyBinding& value )
{
	ust::apply_value_to_stringifier( s, value.GetName() );
}

template</type T/>
fn SerializeValue( ust::default_stringifier8 &mut s, T& value )
{
	ust::apply_value_to_stringifier( s, value );
}

} // namespace PM
