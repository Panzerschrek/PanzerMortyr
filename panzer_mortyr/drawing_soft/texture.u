import "texture.iu"

namespace PM
{

fn BuildTextureMip( Color32SquareTexture</ 0s />& mut dst, Color32SquareTexture</ 1s />& src )
{
	BuildTextureMipImpl( dst, src );
}

fn BuildTextureMip( Color32SquareTexture</ 1s />& mut dst, Color32SquareTexture</ 2s />& src )
{
	BuildTextureMipImpl( dst, src );
}

fn BuildTextureMip( Color32SquareTexture</ 2s />& mut dst, Color32SquareTexture</ 3s />& src )
{
	BuildTextureMipImpl( dst, src );
}

fn BuildTextureMip( Color32SquareTexture</ 3s />& mut dst, Color32SquareTexture</ 4s />& src )
{
	BuildTextureMipImpl( dst, src );
}

fn BuildTextureMip( Color32SquareTexture</ 4s />& mut dst, Color32SquareTexture</ 5s />& src )
{
	BuildTextureMipImpl( dst, src );
}

fn BuildTextureMip( Color32SquareTexture</ 5s />& mut dst, Color32SquareTexture</ 6s />& src )
{
	BuildTextureMipImpl( dst, src );
}

fn BuildTextureMip( Color32SquareTexture</ 6s />& mut dst, Color32SquareTexture</ 7s />& src )
{
	BuildTextureMipImpl( dst, src );
}

fn BuildTextureMip( Color32SquareTexture</ 7s />& mut dst, Color32SquareTexture</ 8s />& src )
{
	BuildTextureMipImpl( dst, src );
}

template</ size_type dst_size, size_type src_size />
fn enable_if( dst_size * 2s == src_size )
BuildTextureMipImpl( [ [ Color32, dst_size ], dst_size ] &mut dst, [ [ Color32, src_size ], src_size ]& src )
{
	for( auto mut dst_y= 0s; dst_y < dst_size; ++dst_y )
	{
		var [ Color32, dst_size ] &mut dst_line= dst[ dst_y ];
		var [ Color32, src_size ]& src_line0= src[ dst_y * 2s + 0s ];
		var [ Color32, src_size ]& src_line1= src[ dst_y * 2s + 1s ];

		for( auto mut dst_x= 0s; dst_x < dst_size; ++dst_x )
		{
			var [ RGBAColor, 4 ] c
			[
				Color32ToComponents( src_line0[ dst_x * 2s + 0s ] ),
				Color32ToComponents( src_line0[ dst_x * 2s + 1s ] ),
				Color32ToComponents( src_line1[ dst_x * 2s + 0s ] ),
				Color32ToComponents( src_line1[ dst_x * 2s + 1s ] ),
			];

			var RGBAColor c_averaged
			[
				( ( u32( c[0][0] ) + u32( c[1][0] ) + u32( c[2][0] ) + u32( c[3][0] ) ) >> 2 ),
				( ( u32( c[0][1] ) + u32( c[1][1] ) + u32( c[2][1] ) + u32( c[3][1] ) ) >> 2 ),
				( ( u32( c[0][2] ) + u32( c[1][2] ) + u32( c[2][2] ) + u32( c[3][2] ) ) >> 2 ),
				( ( u32( c[0][3] ) + u32( c[1][3] ) + u32( c[2][3] ) + u32( c[3][3] ) ) >> 2 ),
			];

			dst_line[ dst_x ]= Color32FromComponents( c_averaged );
		}
	}
}


} // namespace PM
