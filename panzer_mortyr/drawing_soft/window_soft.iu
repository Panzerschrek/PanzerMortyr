import "/sdl/sdl_with_opengl.iu"
import "../abstract_window.iu"
import "../console_out.iu"
import "../settings.iu"

namespace PM
{

// A RAII class for creating/destroying a window with software rendering support.
class WindowSoft final : AbstractWindow
{
public:
	// Constructor halts if failed to initialize.
	fn constructor( SettingsPtr settings, ConsoleOutPtr& console_out );

	fn destructor();

	fn virtual override GetViewportSize( this ) : [ u32, 2 ];

	fn virtual override SwapWindow( mut this );

	fn virtual override MakeScreenshot( mut this ) : ImageData;

	fn virtual override Fill( mut this, RGBAColor& color );

private:
	SettingsPtr imut settings_;
	[ u32, 2 ] viewport_size_;
	$(SDL_Window) window_;
	$(SDL_Surface) surface_;
}

} // namespace PM
