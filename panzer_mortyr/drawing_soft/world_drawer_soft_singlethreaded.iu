import "../caching_game_resources_loader.iu"
import "../settings.iu"
import "window_soft.iu"
import "world_drawer_soft_internal.iu"

namespace PM
{

class WorldDrawerSoftSinglethreaded final : AbstractWorldDrawer
{
public:
	fn constructor(
		ust::shared_ptr_mut</WindowSoft/> window,
		SettingsImutPtr settings,
		CachingGameResourcesLoaderPtr caching_game_resources_loader,
		ConsoleOutPtr console_out );

public: // AbstractWorldDrawer
	fn virtual final Draw( mut this, WorldDrawingInfo& drawing_info ) : WorldDrawingStats;

private:
	fn SetMap( mut this, u32 map_index );

private:
	SettingsImutPtr imut settings_;
	ust::shared_ptr_mut</WindowSoft/> imut window_;
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;
	GameResourcePtr</GameParams/> imut game_params_;
	GameResourcePtr</MapsDescription/> imut maps_description_;
	GameResourcePtr</MaterialsDescription/> imut materials_description_;
	BillboardsDescription imut billboards_description_;

	WorldDrawerSoftInternal drawer_internal_;

	// Map index may be up-to-date, but map data may be empty - if failed to load map files.
	u32 map_index_;
	ust::optional</ tup[ MapFullDrawDataSoft, MapVisibilityCalculatorsPair ] /> map_data_;

	// Load models on demand and store them in this container.
	// Store empty optional if failed to load (in order to avoid loading again).
	ModelsMapSoft models_;

	// Put all heavyweight fields at the end.

	CausticsTextureData imut caustics_texture_;

	// Temporary storage, where interpolated caustics layer for each frame is calculated and stored.
	CausticsTextureLayer interpolated_caustics_layer_;
}

} // namespace PM
