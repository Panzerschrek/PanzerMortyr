import "world_drawer_soft.iu"

namespace PM
{

fn WorldDrawerSoft::constructor( ust::shared_ptr_mut</WindowSoft/> mut window )
	( window_= move(window) )
{
}

fn WorldDrawerSoft::Draw(
	mut this, WorldDrawingInfo& drawing_info, WorldDrawingViewportInfo& viewport_info ) : WorldDrawingStats
{
	// For now just fill the screen with some color.
	with( mut lock : window_.lock_mut() )
	{
		foreach( &mut pixel : lock.deref().GetSurface().pixels )
		{
			pixel= Color32FromComponents( ust::make_array( 32u8, 16u8, 8u8, 255u8 ) );
		}
	}

	// TODO
	ust::ignore_unused( drawing_info );
	ust::ignore_unused( viewport_info );

	var WorldDrawingStats stats= zero_init;
	return stats;
}

} // namespace PM
