import "../bbox.iu"
import "../mat.iu"
import "color32.iu"

namespace PM
{

class LocalFogRasterizer
{
public:
	fn DrawLocalFogVolume(
		mut this,
		Color32ImageView surface,
		ust::array_view_imut</f32/> depth_buffer,
		[ f32, 4 ]& fog_color,
		BBox3f& fog_volume_bbox,
		Mat4f& view_matrix,
		Mat3f& inverse_perspective_and_rotation_matrix,
		Vec3f& camera_position );

public:
	struct FogBlock // Is public to be able to access it in a non-member template function applying fog.
	{
		f32 min_inv_z;
		f32 max_inv_z;
		f32 fog_density_inv_z_scale;
		f32 fog_density_bias;
	}

private:
	ust::vector</FogBlock/> fog_blocks_storage_;
}

} // namespace PM
