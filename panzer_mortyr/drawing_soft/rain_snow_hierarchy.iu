import "/common_lib/map_files.iu"
import "../bounding_boxes_hierarchy.iu"

namespace PM
{

struct RainSnowParticleInHierarchy
{
	Vec3f position;
	u16 max_movement_distance; // It's not normalized.
	u16 movement_distance_phase; // It's normalized, 65536 means 1.
}

type RainSnowHierarchy= BoundingBoxesHierarchy</ RainSnowParticleInHierarchy />;

fn BuildRainSnowHierarchy( ust::array_view_imut</ZmapLamRainDroplet/> rain_droplets ) : RainSnowHierarchy;

} // namespace PM
