import "../abstract_hud_drawer.iu"
import "window_soft.iu"

namespace PM
{

class HudDrawerSoft final : AbstractHudDrawer
{
public:
	fn constructor(
		ust::shared_ptr_mut</WindowSoft/> window, GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out );

protected: // AbstractHudDrawer
	fn virtual final AddTileQuad( mut this, i32 x, i32 y, HudDrawingInfo::IconIndex tile_index );
	fn virtual final AddDigitQuad( mut this, i32 x, i32 y, u32 digit_index, bool alternative_color );

	fn virtual final FlushDrawQuads( mut this );

private:
	fn MakeTiles( ust::optional_ref_imut</ImageData/> image_data_opt ) : Tiles;

private:
	type TileData= [ [ Color32, c_tile_width ], c_tile_height ];
	type Tiles= [ TileData, c_num_tiles_x * c_num_tiles_y ];

	struct TileQuad
	{
		i32 x;
		i32 y;
		HudDrawingInfo::IconIndex icon_index;
	}

	struct DigitQuad
	{
		i32 x;
		i32 y;
		u32 digit_index;
		bool alternative_color;
	}

private:
	ust::shared_ptr_mut</WindowSoft/> imut window_;
	Tiles imut tiles_;

	ust::vector</TileQuad/> tile_quads_;
	ust::vector</DigitQuad/> digit_quads_;
}

} // namespace PM
