import "../abstract_world_drawer.iu"
import "../triangles_sorting.iu"
import "../vertex_formats.iu"
import "dynamic_light_source_soft.iu"
import "window_soft.iu"
import "world_drawer_structs.iu"

namespace PM
{

class WorldDrawerSoft final : AbstractWorldDrawer
{
public:
	fn constructor(
		ust::shared_ptr_mut</WindowSoft/> window,
		SettingsImutPtr settings,
		CachingGameResourcesLoaderPtr caching_game_resources_loader,
		ConsoleOutPtr console_out );

public: // AbstractWorldDrawer
	fn virtual final Draw( mut this, WorldDrawingInfo& drawing_info ) : WorldDrawingStats;

private:
	fn SetMap( mut this, u32 map_index );

private:
	ust::shared_ptr_mut</WindowSoft/> imut window_;
	SettingsImutPtr imut settings_;
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;
	GameResourcePtr</GameParams/> imut game_params_;
	GameResourcePtr</MapsDescription/> imut maps_description_;
	GameResourcePtr</MaterialsDescription/> imut materials_description_;

	// Map index may be up-to-date, but map data may be empty - if failed to load map files.
	u32 map_index_;
	ust::optional</MapFullDrawDataSoft/> map_data_;

	ust::vector</MapVertex/> temp_vertices_;
	ust::vector</u16/> temp_indices_;

	ust::vector</MapVertex/> semitransparent_geometry_vertices_;
	ust::vector</u16/> semitransparent_geometry_indices_;

	// Temporary buffer used by triangles sorting code.
	ust::vector</TriangleForSorting/> triangles_for_sorting_;

	ust::vector</Vec3f/> transformed_vertices_; // Temporary container for transformed vertices.

	ust::vector</ VertexLightWithFog /> vertex_lights_;

	ust::vector</f32/> depth_buffer_;

	// A temporary container used for collecting dynamic lights for a cluster.
	ust::vector</ DynamicLightSourceSoft /> cluster_dynamic_light_sources_;

	// Load models on demand and store them in this container.
	// Store empty optional if failed to load (in order to avoid loading again).
	ModelsMapSoft models_;
}

} // namespace PM
