import "../abstract_world_drawer.iu"
import "../caching_game_resources_loader.iu"
import "../map_visibility_calculator.iu"
import "../vertex_formats.iu"
import "texture.iu"
import "window_soft.iu"

namespace PM
{

class WorldDrawerSoft final : AbstractWorldDrawer
{
public:
	fn constructor(
		ust::shared_ptr_mut</WindowSoft/> window,
		SettingsImutPtr settings,
		CachingGameResourcesLoaderPtr caching_game_resources_loader,
		ConsoleOutPtr console_out );

public: // AbstractWorldDrawer
	fn virtual final Draw( mut this, WorldDrawingInfo& drawing_info ) : WorldDrawingStats;

private:
	fn SetMap( mut this, u32 map_index );

private:
	ust::shared_ptr_mut</WindowSoft/> imut window_;
	SettingsImutPtr imut settings_;
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;
	GameResourcePtr</GameParams/> imut game_params_;
	GameResourcePtr</MapsDescription/> imut maps_description_;
	GameResourcePtr</MaterialsDescription/> imut materials_description_;

	// Map index may be up-to-date, but map data may be empty - if failed to load map files.
	u32 map_index_;
	ust::optional</MapFullDrawDataSoft/> map_data_;

	ust::vector</MapVertex/> temp_vertices_;
	ust::vector</u16/> temp_indices_;

	ust::vector</Vec3f/> transformed_vertices_; // Temporary container for transformed vertices.

	ust::vector</f32/> depth_buffer_;
}

struct MapFullDrawDataSoft
{
	MapDrawDataSoft imut map_draw_data;

	MapVisibilityCalculator map_visibility_calculator;
}

struct MapDrawDataSoft
{
	GameResourcePtr</ZmapData/> zmap_data;
	GameResourcePtr</ZvoxData/> zvox_data;
	GameResourcePtr</ZmapLamData/> zmap_lam_data;
	GameResourcePtr</ZmapLemData/> zmap_lem_data;

	ust::shared_ptr_final</RoomClustersBSPTree/> room_clusters_bsp_tree;

	// Has size equal to number of map clusters.
	ust::vector</ClusterDrawDataSoft/> clusters_draw_data;

	ust::vector</ MapVertex /> vertices;
	ust::vector</u16/> indices;

	ust::vector</Color32WorldTextureWithMips/> textures;

	BitArray breakable_material_bits;
}

// A mesh stored in some vertex/index buffer (containing also other meshes).
struct GeometryBufferChunkSoft
{
	// Use here 32-bit numbers - it's enough.

	// Offset into vertex array.
	u32 first_vertex_index;
	// How many own vertices this cluster has.
	u32 num_vertices;
	// Offset into index array.
	u32 first_index;
	// Number of indices is equal to number of triangles multiplied by 3.
	u32 num_indices;
}

struct ClusterDrawDataSoft
{
	GeometryBufferChunkSoft geometry_buffer_chunk;

	[ GeometryBufferChunkSoft, 4 ] special_material_valve_geometry_buffer_chunk;
	[ GeometryBufferChunkSoft, 8 ] special_material_film_geometry_buffer_chunk;

	bool has_glass_quads;
	bool has_liquid_quads;
	bool has_breakable_quads;
	bool has_mirror_quads;
}

} // namespace PM
