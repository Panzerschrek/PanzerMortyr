import "/common_lib/billboards_description_file.iu"
import "../abstract_world_drawer.iu"
import "../camera_utils.iu"
import "../caustics.iu"
import "../lighting_modifiers.iu"
import "../triangles_sorting.iu"
import "../vertex_formats.iu"
import "dynamic_light_source_soft.iu"
import "local_fog_rasterizer.iu"
import "world_drawer_structs.iu"

namespace PM
{

class WorldDrawerSoftInternal
{
public:
	fn constructor();

	fn Draw(
		mut this,
		Settings& settings,
		Color32ImageView surface,
		GameParams& game_params,
		BillboardsDescription& billboards_description,
		MapsDescription::MapDescription& map_description,
		MaterialsDescription::Block& materials_block,
		MapFullDrawDataSoft& map_data_full,
		MapVisibilityCalculatorsPair &mut map_visibility_calculators,
		ModelsMapSoft& models,
		WorldDrawingInfo& drawing_info ) : WorldDrawingStats;

private:
	fn DrawPartial(
		mut this,
		Settings& settings,
		Color32ImageView surface,
		GameParams& game_params,
		BillboardsDescription& billboards_description,
		MapsDescription::MapDescription& map_description,
		MaterialsDescription::Block& materials_block,
		MapFullDrawDataSoft& map_data_full,
		MapVisibilityCalculator& visibility_calculator,
		ModelsMapSoft& models,
		WorldDrawingInfo& drawing_info,
		ust::array_view_imut</DynamicLightSourceSoft/> dynamic_light_sources,
		Vec3f& camera_position,
		CameraMatrices& camera_matrices,
		CameraClipPlanes& camera_clip_planes,
		FrustumClipPlanes& frustum_clip_planes,
		LightingModifiers& lighting_modifiers,
		bool draw_first_person_weapon_models,
		TriangleVerticesOrder vertices_order,
		WorldDrawingStats &mut stats );

public:
	fn LoadMap(
		CachingGameResourcesLoader &mut caching_game_resources_loader,
		ConsoleOutPtr& console_out,
		GameParams& game_params,
		MapsDescription& maps_description,
		MaterialsDescription& materials_description,
		BillboardsDescription& billboards_description,
		u32 map_index ) : ust::optional</ MapFullDrawDataSoft />;

	fn LoadModels(
		ust::array_view_imut</UsedModel/> model_list,
		GameFilesystemPtr& game_filesystem_ptr,
		ConsoleOutPtr& console_out_ptr,
		ust::array_view_imut</Color32WorldTextureWithMips/> map_textures,
		ModelsMapSoft &mut models );

	fn LoadBillboardsDescription(
		GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out_ptr ) : BillboardsDescription;

private:
	struct CameraMatrices
	{
		Mat4f view_matrix;
		Mat4f moon_and_stars_matrix;
		Mat3f sky_inverse_transformation_matrix;
	}

private:
	ust::vector</MapVertex/> mirror_vertices_;
	ust::vector</u16/> mirror_indices_;

	ust::vector</MapVertex/> temp_vertices_;
	ust::vector</u16/> temp_indices_;

	ust::vector</MapVertex/> semitransparent_geometry_vertices_;
	ust::vector</u16/> semitransparent_geometry_indices_;

	// Temporary buffer used by triangles sorting code.
	ust::vector</TriangleForSorting/> triangles_for_sorting_;

	ust::vector</Vec3f/> transformed_vertices_; // Temporary container for transformed vertices.

	ust::vector</ VertexLightWithFog /> vertex_lights_;

	ust::vector</f32/> depth_buffer_;

	// A temporary container used for collecting dynamic lights for a cluster.
	ust::vector</ DynamicLightSourceSoft /> cluster_dynamic_light_sources_;

	ust::vector</BBox3f/> local_fog_volumes_;

	LocalFogRasterizer local_fog_rasterizer_;

	// Storage for mirror texture.
	// Is needed in order to be able to update its alpha.
	Color32WorldTextureWithMips mirror_texture_;
}

} // namespace PM
