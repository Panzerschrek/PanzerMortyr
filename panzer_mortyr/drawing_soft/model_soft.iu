import "/box.iu"
import "/variant.iu"
import "/common_lib/model_loading.iu"
import "../bbox.iu"
import "../vertex_formats.iu"
import "texture.iu"

namespace PM
{

struct ModelSoft
{
	u32 num_vertices;
	u32 num_triangles;
	u32 num_frames;

	ust::vector</ [ u16, 3 ] /> triangles;

	// Texture coordinates for each vertex.
	ust::vector</Vec2f/> texture_coordinates;

	// Positions and normals for each vertex and each frame.
	ust::vector</ModelFrameVertex/> vertices;

	ust::vector</BBox3f/> frame_bboxes;

	Texture texture;

	type Texture=
		ust::variant</ tup[
			ust::box</Texture256WithMips/>,
			ust::box</Texture128WithMips/>,
			ust::box</Texture64WithMips /> ] />;

	type Texture256WithMips= tup[
		Color32SquareTexture</ 8s />, // 256 x 256
		Color32SquareTexture</ 7s />, // 128 x 128
		Color32SquareTexture</ 6s />, //  64 x  64
		Color32SquareTexture</ 5s />, //  32 x  32
		Color32SquareTexture</ 4s />, //  16 x  16
		Color32SquareTexture</ 3s />, //   8 x   8
		Color32SquareTexture</ 2s />, //   4 x   4
		Color32SquareTexture</ 1s />, //   2 x   2
		Color32SquareTexture</ 0s />  //   1 x   1
		];

	type Texture128WithMips= tup[
		Color32SquareTexture</ 7s />, // 128 x 128
		Color32SquareTexture</ 6s />, //  64 x  64
		Color32SquareTexture</ 5s />, //  32 x  32
		Color32SquareTexture</ 4s />, //  16 x  16
		Color32SquareTexture</ 3s />, //   8 x   8
		Color32SquareTexture</ 2s />, //   4 x   4
		Color32SquareTexture</ 1s />, //   2 x   2
		Color32SquareTexture</ 0s />  //   1 x   1
		];

	type Texture64WithMips= tup[
		Color32SquareTexture</ 6s />, // 64 x 64
		Color32SquareTexture</ 5s />, // 32 x 32
		Color32SquareTexture</ 4s />, // 16 x 16
		Color32SquareTexture</ 3s />, //  8 x  8
		Color32SquareTexture</ 2s />, //  4 x  4
		Color32SquareTexture</ 1s />, //  2 x  2
		Color32SquareTexture</ 0s />  //  1 x  1
		];
}

fn CreateModelSoft( ModelData& model_data ) : ModelSoft;

} // namespace PM
