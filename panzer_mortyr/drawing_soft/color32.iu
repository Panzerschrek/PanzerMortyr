import "../image_data.iu"

namespace PM
{

// Type representing 32-bit color in native components order.
// Use 32-bit integer to force 4-byte aligment,
// which can give some performance benefits over an approach with an array of 4 bytes.
type Color32= u32;

fn Color32FromComponents( RGBAColor& c ) : Color32
{
	// Assume bbbbbbbbggggggggrrrrrrrraaaaaaaa order.
	return ( u32( c[0] ) << 16u ) | ( u32( c[1] ) <<  8u ) | ( u32( c[2] ) <<  0u ) | ( u32( c[3] ) << 24u );
}

fn Color32ToComponents( Color32 c ) : RGBAColor
{
	var RGBAColor components[ ( c >> 16 ), ( c >>  8 ), ( c >>  0 ), ( c >> 24 ) ];
	return components;
}

fn Color32Average( Color32 a, Color32 b ) : Color32
{
	return ( ( ( a ^ b ) & 0xFEFEFEFEu ) >> 1 ) + ( a & b );
}

fn Color32AlphaBlend( Color32 &mut dst, Color32 src )
{
	var RGBAColor src_components= Color32ToComponents( src );
	var RGBAColor dst_components= Color32ToComponents( dst );

	var u32 alpha( src_components[3] );
	var u32 one_minus_alpha= 255u - alpha;
	var RGBAColor color_mixed
	[
		( ( u32( src_components[0] ) * alpha + u32( dst_components[0] ) * one_minus_alpha ) / 255u ),
		( ( u32( src_components[1] ) * alpha + u32( dst_components[1] ) * one_minus_alpha ) / 255u ),
		( ( u32( src_components[2] ) * alpha + u32( dst_components[2] ) * one_minus_alpha ) / 255u ),
		( ( u32( src_components[3] ) * alpha + u32( dst_components[3] ) * one_minus_alpha ) / 255u ),
	];

	dst= Color32FromComponents( color_mixed );
}

struct Color32ImageView
{
	[ u32, 2 ] size;
	u32 stride; // How many values are between lines. It's greater or equal to width.
	ust::array_view_mut</Color32/> pixels;
}

} // namespace PM
