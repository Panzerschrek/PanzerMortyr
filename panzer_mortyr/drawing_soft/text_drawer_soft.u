import "/utf.iu"
import "../text_drawer_common.iu"
import "text_drawer_soft.iu"

namespace PM
{

fn TextDrawerSoft::constructor(
	ust::shared_ptr_mut</WindowSoft/> mut window, GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out )
	(
		viewport_size_= window.lock_imut().deref().GetViewportSize(),
		window_= move(window),
		font_data_= LoadFontData( game_filesystem_ptr, console_out ),
		code_point_to_glyph_position_map_=
			BuildCodePointToGlyphPositionMap( LoadFontTable( game_filesystem_ptr, console_out ) ),
	)
{
}

fn TextDrawerSoft::AddText( mut this, i32 x, i32 y, ust::string_view8 mut text, Settings& settings )
{
	var Color32 foreground_color= Color32FromComponents( settings.foreground_color );
	var Color32 background_color= Color32FromComponents( settings.background_color );

	var i32 initial_x= x, mut current_x= initial_x, mut current_y= y;

	loop
	{
		var char32 code_point= ust::utf::extract_code_point_or_null_from_string( text );
		if( code_point == '\0'c32 )
		{
			break;
		}

		if( code_point == '\n'c32 )
		{
			current_x= initial_x;
			current_y-= i32( c_glyph_height * settings.scale );
			continue;
		}

		var u32 mut glyph_index= 0u;
		if_var( p : code_point_to_glyph_position_map_.find( code_point ) )
		{
			glyph_index= p;
		}
		else
		{
			glyph_index= code_point_to_glyph_position_map_[ '?'c32 ];
		}

		var u32 glyph_pixel_width=
			( settings.monospace ? c_max_glyph_width : c_max_glyph_width /* TODO - read width from font here */ );

		glyphs_to_draw_.push_back(
			GlyphToDraw
			{
				.x= current_x,
				.y= current_y,
				.glyph_index( glyph_index ),
				.foreground_color= foreground_color,
				.background_color= background_color,
				.scale= settings.scale,
			} );

		current_x+= i32( glyph_pixel_width * settings.scale );
	}
}

fn TextDrawerSoft::DrawTexts( mut this )
{
	with( mut lock : window_.lock_mut() )
	{
		var Color32ImageView surface= lock.deref().GetSurface();

		foreach( &glyph_to_draw : glyphs_to_draw_ )
		{
			var u32 x_begin( ust::max( 0, glyph_to_draw.x ) );
			var u32 y_begin( ust::max( 0, glyph_to_draw.y ) );
			var u32 x_end(
				ust::min(
					glyph_to_draw.x + i32( c_max_glyph_width * glyph_to_draw.scale ),
					i32( surface.size[0] ) ) );
			var u32 y_end(
				ust::min(
					glyph_to_draw.y + i32( c_glyph_height * glyph_to_draw.scale ),
					i32( surface.size[1] ) ) );

			for( auto mut y= y_begin; y < y_end; ++y )
			{
				var size_type line_start( y * surface.stride );
				var size_type line_end( ( y + 1u ) * surface.stride );
				auto line= surface.pixels.subrange( line_start, line_end );
				for( auto mut x= x_begin; x < x_end; ++x )
				{
					line[ size_type(x) ]= glyph_to_draw.foreground_color;
				}
			}
		}
	}

	glyphs_to_draw_.clear();
}

} // namespace PM
