import "/utf.iu"
import "../text_drawer_common.iu"
import "text_drawer_soft.iu"

namespace PM
{

fn TextDrawerSoft::constructor(
	ust::shared_ptr_mut</WindowSoft/> mut window, GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out )
	(
		viewport_size_= window.lock_imut().deref().GetViewportSize(),
		window_= move(window),
		font_data16_= CreateFontData16( LoadFontData( game_filesystem_ptr, console_out ) ),
		code_point_to_glyph_position_map_=
			BuildCodePointToGlyphPositionMap( LoadFontTable( game_filesystem_ptr, console_out ) ),
	)
{
}

fn TextDrawerSoft::AddText( mut this, i32 x, i32 y, ust::string_view8 mut text, Settings& settings )
{
	var Color32 foreground_color= Color32FromComponents( settings.foreground_color );
	var Color32 background_color= Color32FromComponents( settings.background_color );

	var i32
		initial_x= x,
		mut current_x= initial_x,
		mut current_y= i32( viewport_size_[1] - 1u ) - y - i32( c_glyph_height * settings.scale );

	loop
	{
		var char32 code_point= ust::utf::extract_code_point_or_null_from_string( text );
		if( code_point == '\0'c32 )
		{
			break;
		}

		if( code_point == '\n'c32 )
		{
			current_x= initial_x;
			current_y+= i32( c_glyph_height * settings.scale );
			continue;
		}

		var u32 mut glyph_index= 0u;
		if_var( p : code_point_to_glyph_position_map_.find( code_point ) )
		{
			glyph_index= p;
		}
		else
		{
			glyph_index= code_point_to_glyph_position_map_[ '?'c32 ];
		}

		var u32 glyph_pixel_width=
			( settings.monospace ? c_max_glyph_width : u32( font_data16_.widths[ size_type( glyph_index ) ] ) );

		glyphs_to_draw_.push_back(
			GlyphToDraw
			{
				.x= current_x,
				.y= current_y,
				.glyph_index( glyph_index ),
				.foreground_color= foreground_color,
				.background_color= background_color,
				.scale= settings.scale,
				.width= glyph_pixel_width * settings.scale,
			} );

		current_x+= i32( glyph_pixel_width * settings.scale );
	}
}

fn TextDrawerSoft::DrawTexts( mut this )
{
	with( mut lock : window_.lock_mut() )
	{
		var Color32ImageView surface= lock.deref().GetSurface();

		foreach( &glyph_to_draw : glyphs_to_draw_ )
		{
			var i32 x_begin= ust::max( 0, glyph_to_draw.x );
			var i32 y_begin= ust::max( 0, glyph_to_draw.y );
			var i32 x_end= ust::min( glyph_to_draw.x + i32( glyph_to_draw.width ), i32( surface.size[0] ) );
			var i32 y_end= ust::min( glyph_to_draw.y + i32( 8u * glyph_to_draw.scale ), i32( surface.size[1] ) );

			var GlyphData16& glyph= font_data16_.glyphs[ size_type( glyph_to_draw.glyph_index ) ];

			var [ Color32, 2 ] colors[ glyph_to_draw.background_color, glyph_to_draw.foreground_color ];

			for( auto mut y= y_begin; y < y_end; ++y )
			{
				var u32 v= u32( y - y_begin ) / glyph_to_draw.scale;
				var u16 glyph_line= glyph[v];

				var size_type line_start( u32(y) * surface.stride );
				var size_type line_end( ( u32(y) + 1u ) * surface.stride );
				auto line= surface.pixels.subrange( line_start, line_end );

				for( auto mut x= x_begin; x < x_end; ++x )
				{
					var u32 u= u32( x - x_begin ) / glyph_to_draw.scale;

					var Color32 c= colors[ ( u32( glyph_line ) >> ( u * 2u ) ) & 1u ];

					line[ size_type(x) ]= c;
				}
			}
		}
	}

	glyphs_to_draw_.clear();
}

fn TextDrawerSoft::CreateFontData16( FontData& font_data ) : FontData16
{
	return FontData16
	{
		.glyphs=
			ust::make_vector_from_mapped_range(
				font_data.glyphs.range(),
				lambda( FontData::Glyph& glyph ) : GlyphData16
				{
					var GlyphData16 mut glyph_data= zero_init;
					for( auto mut y= 0s; y < 7s; ++y )
					{
						var u32 in_line( glyph.pixels[y] );
						var u32 mut out_line= 0u;
						for( auto mut x= 0s; x < 8s; ++x )
						{
							out_line|= ( ( in_line >> ( x ^ 7s ) ) & 1u ) << ( x * 2s );
						}
						glyph_data[y]= u16(out_line);
					}

					return glyph_data;
				} ),
		.widths=
			ust::make_vector_from_mapped_range(
				font_data.glyphs.range(), lambda( FontData::Glyph& glyph ) : u8 { return glyph.width; } ),
	};
}

} // namespace PM
