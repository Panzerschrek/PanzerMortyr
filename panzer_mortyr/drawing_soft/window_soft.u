import "/string_conversions.iu"
import "../message_box.iu"
import "window_soft.iu"

namespace PM
{

fn WindowSoft::constructor( SettingsPtr mut settings, ConsoleOutPtr& console_out )
	(
		viewport_size_=
			lambda[&]() : [ u32, 2 ]
			{
				auto lock= settings.lock_imut();
				var Settings& s= lock.deref();

				// If these values aren't correct, they will be fixed later anyway.
				return ust::make_array( s.r_screen_width, s.r_screen_height );
			} (),
		settings_= move(settings),
		window_= zero_init /* set later */,
		surface_= zero_init /* set later */,
	)
{
	if( unsafe( SDL_Init( SDL_INIT_VIDEO ) ) != 0 )
	{
		ConsoleOutAddTextLine( console_out, "SDL video init failed!" );
		ShowFatalErrorMessageBox( "SDL video init failed!" );
		halt;
	}

	// TODO - select video mode if needed.

	var u32 window_flags= 0u;

	auto SDL_WINDOWPOS_CENTERED= 0x2FFF0000; // TODO - move this constant into a common place.

	ConsoleOutAddTextLine(
		console_out,
		ust::concat(
			"Creating a window with size ",
			ust::to_string8( viewport_size_[0] ),
			"x",
			ust::to_string8( viewport_size_[1] ),
			"." ) );


	window_=
		unsafe( SDL_CreateWindow(
			$<( cast_mut( "panzer_mortyr\0"[0] ) ), // TODO - move this string into a common place.
			SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
			i32(viewport_size_[0]), i32(viewport_size_[1]),
			window_flags ) );

	if( ust::is_nullptr( window_ ) )
	{
		ConsoleOutAddTextLine( console_out, "Failed to create window!" );
		halt;
	}

	surface_= unsafe( SDL_GetWindowSurface( window_ ) );

	if( ust::is_nullptr( surface_ ) )
	{
		ConsoleOutAddTextLine( console_out, "Failed to get window surface!" );
		halt;
	}

	// TODO - set gamma and update it every frame.
}

fn WindowSoft::destructor()
{
	unsafe( SDL_DestroyWindow( window_ ) );
}

fn WindowSoft::GetViewportSize( this ) : [ u32, 2 ]
{
	return viewport_size_;
}

fn WindowSoft::SwapWindow( mut this )
{
	unsafe( SDL_UpdateWindowSurface( window_ ) );
}

fn WindowSoft::MakeScreenshot( mut this ) : ImageData
{
	// TODO
	return ImageData{ .size[ 0u, 0u ] };
}

fn WindowSoft::Fill( mut this, RGBAColor& color )
{
	var bool must_lock_surface= unsafe( ( $>(surface_).flags & u32(SDL_RLEACCEL) ) != 0u );

	if( must_lock_surface )
	{
		unsafe( SDL_LockSurface( surface_ ) );
	}

	unsafe
	{
		var SDL_Surface& surface= $>(surface_);

		var u32 pitch= u32( surface.pitch ) / u32( typeinfo</Color32/>.size_of );

		var ust::array_view_mut</Color32/> surface_data(
			ust::byte_ptr_cast</Color32/>( surface.pixels ),
			size_type( pitch * u32( surface.h ) ) );

		safe( FillBufferWithColor( surface_data, Color32FromComponents( color ) ) );
	}

	if( must_lock_surface )
	{
		unsafe( SDL_UnlockSurface( surface_ ) );
	}
}

// Type representing 32-bit color in native components order.
// Use 32-bit integer to force 4-byte aligment,
// which can give some performance benefits over an approach with an array of 4 bytes.
type Color32= u32;

fn Color32FromComponents( RGBAColor& c ) : Color32
{
	// Assume bbbbbbbbggggggggrrrrrrrraaaaaaaa order.
	return ( u32( c[0] ) << 16u ) | ( u32( c[1] ) <<  8u ) | ( u32( c[2] ) <<  0u ) | ( u32( c[3] ) << 24u );
}

fn FillBufferWithColor( ust::array_view_mut</Color32/> buffer, Color32 c )
{
	foreach( &mut pixel : buffer )
	{
		pixel= c;
	}
}

} // namespace PM
