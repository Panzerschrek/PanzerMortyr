import "/string_conversions.iu"
import "../message_box.iu"
import "../window_common.iu"
import "window_soft.iu"

namespace PM
{

fn WindowSoft::Create( SettingsPtr mut settings, ConsoleOutPtr& console_out ) : ust::optional</WindowSoft/>
{
	if( unsafe( SDL_Init( SDL_INIT_VIDEO ) ) != 0 )
	{
		ConsoleOutAddTextLine( console_out, "SDL video init failed!" );
		return ust::null_optional;
	}

	var [ u32, 2 ] mut viewport_size=
		lambda[&]() : [ u32, 2 ]
		{
			auto lock= settings.lock_imut();
			var Settings& s= lock.deref();
			return ust::make_array( s.r_screen_width, s.r_screen_height );
		} ();

	var Uint32 mut window_flags( 0 );

	var u32 display_index= GetAndActualizeDisplayIndex( settings, console_out );

	if( settings.lock_imut().deref().r_fullscreen )
	{
		SelectFullscreenMode( viewport_size, display_index, console_out );
		window_flags|= Uint32( SDL_WINDOW_FULLSCREEN );
	}
	else
	{
		SelectWindowedMode( viewport_size, display_index, console_out );
	}

	ConsoleOutAddTextLine(
		console_out,
		ust::concat(
			"Creating a window with size ",
			ust::to_string8( viewport_size[0] ),
			"x",
			ust::to_string8( viewport_size[1] ),
			"." ) );

	var $(SDL_Window) window=
		unsafe( SDL_CreateWindow(
			$<( cast_mut( c_window_caption_nt[0] ) ),
			SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
			i32(viewport_size[0]), i32(viewport_size[1]),
			window_flags ) );

	if( ust::is_nullptr( window ) )
	{
		ConsoleOutAddTextLine( console_out, "Failed to create window!" );
		return ust::null_optional;
	}

	// Request window surface to check its properties.
	// Don't save it into some variable, instead request it later each time it's needed.

	var $(SDL_Surface) surface= unsafe( SDL_GetWindowSurface( window ) );

	if( ust::is_nullptr( surface ) )
	{
		ConsoleOutAddTextLine( console_out, "Failed to get window surface!" );
		unsafe( SDL_DestroyWindow( window ) );
		return ust::null_optional;
	}

	var Uint8 bits_per_pixel= unsafe( $>( $>(surface).format ).BitsPerPixel );
	if( bits_per_pixel != 32u8 )
	{
		ConsoleOutAddTextLine( console_out, "Unexpected surface pixel format! Expected exactly 32 bits per pixel." );
		unsafe( SDL_DestroyWindow( window ) );
		return ust::null_optional;
	}

	// TODO - check here if pixel component order is expected?

	return unsafe( WindowSoft( move(settings), viewport_size, window ) );
}

fn WindowSoft::constructor( SettingsPtr mut settings, [ u32, 2 ] viwport_size, $(SDL_Window) window ) unsafe
	(
		viewport_size_= viwport_size,
		window_= window,
		prev_gamma_= ReadGamma( settings ),
		settings_= move(settings),
	)
{
	unsafe( SetWindowGamma( window_, prev_gamma_ ) );
}

fn WindowSoft::destructor()
{
	unsafe( SDL_DestroyWindow( window_ ) );
}

fn WindowSoft::GetSurface( mut this ) : Color32ImageView @( ust::reference_notation::return_inner_references::param0 )
{
	unsafe
	{
		var $(SDL_Surface) surface_ptr= SDL_GetWindowSurface( window_ );

		halt if( ust::is_nullptr( surface_ptr ) );
		var SDL_Surface& surface= $>(surface_ptr);

		halt if( ust::is_nullptr( surface.format ) );
		halt if( $>( surface.format ).BitsPerPixel != 32u8 );

		// Lock surface if needed before accessing its pixels.
		// Don't care unlocking it later.
		if( ( surface.flags & u32(SDL_RLEACCEL) ) != 0u && surface.locked == 0 )
		{
			SDL_LockSurface( surface_ptr );
		}

		var u32 stride= u32( surface.pitch ) / u32( typeinfo</Color32/>.size_of );

		return Color32ImageView
		{
			.size[ ( surface.w ), ( surface.h ) ],
			.stride= stride,
			.pixels( ust::byte_ptr_cast</Color32/>( surface.pixels ), size_type( stride * u32( surface.h ) ) )
		};
	}
}

fn WindowSoft::GetViewportSize( this ) : [ u32, 2 ]
{
	return viewport_size_;
}

fn WindowSoft::SwapWindow( mut this )
{
	unsafe( SDL_UpdateWindowSurface( window_ ) );

	// Update gamma each frame if necessary (if gamma settings was changed).
	UpdateGamma();
}

fn WindowSoft::MakeScreenshot( mut this ) : ImageData
{
	var Color32ImageView surface= GetSurface();

	var ImageData mut image_data
	{
		.size= surface.size,
		.pixels( size_type( surface.size[0] * surface.size[1] ), ust::make_zeroed</RGBAColor/>() ),
	};

	for( auto mut y= 0u; y < surface.size[1]; ++y )
	{
		var u32 dst_y= surface.size[1] - 1u - y;

		auto dst=
			image_data.pixels.range().subrange(
			size_type( dst_y * image_data.size[0] ), size_type( ( dst_y + 1u ) * image_data.size[0] ) );

		auto src= surface.pixels.subrange( size_type( y * surface.stride ), size_type( ( y + 1u ) * surface.stride ) );

		foreach( pair : dst.iter().zip( src.iter() ) )
		{
			pair.first= Color32ToComponents( pair.second );
		}
	}

	return image_data;
}

fn WindowSoft::Fill( mut this, RGBAColor& color )
{
	var Color32 c= Color32FromComponents( color );
	foreach( &mut pixel : GetSurface().pixels )
	{
		pixel= c;
	}
}

fn WindowSoft::UpdateGamma( mut this )
{
	var f32 gamma= ReadGamma( settings_ );
	if( gamma != prev_gamma_ )
	{
		prev_gamma_= gamma;
		unsafe( SetWindowGamma( window_, gamma ) );
	}
}

} // namespace PM
