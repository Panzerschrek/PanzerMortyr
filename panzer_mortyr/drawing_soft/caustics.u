import "caustics.iu"

namespace PM
{

fn ApplyCausticsTexture(
	CausticsTextureLayer& caustics_texture,
	Color32WorldTextureMip0& src_texture,
	Color32WorldTextureWithMips &mut dst_texture )
{
	var size_type dst_size= typeinfo</ Color32WorldTextureMip0 />.element_count;
	for( auto mut dst_y= 0s; dst_y < dst_size; ++dst_y )
	{
		var size_type src_y= dst_y * size_type( c_caustics_texture_size ) / dst_size;

		for( auto mut dst_x= 0s; dst_x < dst_size; ++dst_x )
		{
			var size_type src_x= dst_x * size_type( c_caustics_texture_size ) / dst_size;

			var RGBAColor src_color= Color32ToComponents( src_texture[ dst_y ][ dst_x ] );
			var u8 caustics_value= caustics_texture[ src_y ][ src_x ];

			var u32 scale= u32( caustics_value ) * 205u + 13261u;

			var RGBAColor mut dst_color= zero_init;
			for( auto mut c= 0u; c < 4u; ++c )
			{
				dst_color[c]= u8( ( u32( src_color[c] ) * scale ) >> 16 );
			}

			dst_texture[0][ dst_y ][ dst_x ]=  Color32FromComponents( dst_color );
		}
	}

	BuildTextureMip( dst_texture[1], dst_texture[0] );
	BuildTextureMip( dst_texture[2], dst_texture[1] );
	BuildTextureMip( dst_texture[3], dst_texture[2] );
	BuildTextureMip( dst_texture[4], dst_texture[3] );
	BuildTextureMip( dst_texture[5], dst_texture[4] );
	BuildTextureMip( dst_texture[6], dst_texture[5] );
	BuildTextureMip( dst_texture[7], dst_texture[6] );
}

} // namespace PM
