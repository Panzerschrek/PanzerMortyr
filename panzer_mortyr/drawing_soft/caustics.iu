import "../caustics.iu"
import "texture.iu"

namespace PM
{

fn FetchInterpolatedCausticsTextureLayer( CausticsTextureData& caustics_texture, f32 time_s ) : CausticsTextureLayer;

fn ApplyCausticsTexture(
	CausticsTextureLayer& caustics_texture,
	Color32WorldTextureMip0& src_texture,
	Color32WorldTextureWithMips &mut dst_texture );

// These parameters should match code in caustics shader!
var f32 c_caustics_light_add= 0.5f;
var f32 c_caustics_light_scale= 2.0f;
var f32 c_caustics_light_total_scale= c_caustics_light_add + c_caustics_light_scale;

} // namespace PM
