import "../caching_game_resources_loader.iu"
import "../lighting.iu"
import "../map_visibility_calculator.iu"
import "../rain_snow_hierarchy.iu"
import "../vertex_formats.iu"
import "../water_circles_hierarchy.iu"
import "model_soft.iu"
import "texture.iu"

namespace PM
{

struct MapFullDrawDataSoft
{
	MapDrawDataSoft imut map_draw_data;

	MapVisibilityCalculator map_visibility_calculator;

	ust::vector</bool/> highlighted_cluster_flags; // Has size equal to the number of clusters in the map.

	// Caustics are re-applied each frame to textures used for map quads located in water.
	TexturesWithAppliedCaustics textures_with_applied_caustics;
}

struct MapDrawDataSoft
{
	GameResourcePtr</ZmapData/> zmap_data;
	GameResourcePtr</ZvoxData/> zvox_data;
	GameResourcePtr</ZmapLamData/> zmap_lam_data;
	GameResourcePtr</ZmapLemData/> zmap_lem_data;
	GameResourcePtr</RoomClustersHierarchy/> room_clusters_hierarchy;
	GameResourcePtr</QuadsHierarchy/> quads_hierarchy;

	ust::shared_ptr_final</RoomClustersBSPTree/> room_clusters_bsp_tree;

	ust::vector</PointLightSource/> light_sources;

	// Has size equal to number of map clusters.
	ust::vector</ClusterDrawDataSoft/> clusters_draw_data;

	ust::vector</ MapVertex /> vertices;
	ust::vector</u16/> indices;

	ust::vector</Color32WorldTextureWithMips/> textures;

	tup[ ust::vector</MapVertex/>, ust::vector</u16/> ] moon_and_stars_buffer;

	u32 clouds_texture_layer;
	[ [ f32, 3 ], 2 ] sky_colors;
	bool use_two_cloud_layers;

	[ f32, 4 ] fog_color;
	bool global_fog_enabled;

	RainSnowHierarchy rain_snow_hierarchy; // Is empty if has neither rain or snow.

	BitArray breakable_material_bits;
	BitArray wet_material_bits;

	// Is empty if no water circles are needed for this map (there is no rain).
	WaterCirclesHierarchy water_circles_heirarchy;
}

// A mesh stored in some vertex/index buffer (containing also other meshes).
struct GeometryBufferChunkSoft
{
	// Use here 32-bit numbers - it's enough.

	// Offset into vertex array.
	u32 first_vertex_index;
	// How many own vertices this cluster has.
	u32 num_vertices;
	// Offset into index array.
	u32 first_index;
	// Number of indices is equal to number of triangles multiplied by 3.
	u32 num_indices;
}

struct ClusterDrawDataSoft
{
	GeometryBufferChunkSoft geometry_buffer_chunk;

	[ GeometryBufferChunkSoft, 4 ] special_material_valve_geometry_buffer_chunk;
	[ GeometryBufferChunkSoft, 8 ] special_material_film_geometry_buffer_chunk;

	bool has_glass_quads;
	bool has_liquid_quads;
	bool has_breakable_quads;
	bool has_mirror_quads;
	bool has_sky_quads;
}

type TexturesWithAppliedCaustics= ust::hash_map</ u32, ust::box</Color32WorldTextureWithMips/> />;

struct ModelSoftExt
{
	ModelSoft model;

	// Is non-empty and contains a pair of textures with blood coverage if such coverage is needed.
	ust::optional</ [ ModelSoft::Texture, 2 ] /> blood_covered_textures;
}

type ModelsMapSoft= ust::hash_map</ ResourceString, ModelSoftExt />;

// Vertex structure used for clipping of sky vertices.
// It's needed, because code performing clipping expects "position" member to be present in the given vertex type.
struct SkyVertex
{
	Vec3f position;

	op*( SkyVertex& v, f32 s ) : SkyVertex
	{
		return SkyVertex{ .position= v.position * s };
	}

	op+( SkyVertex& l, SkyVertex& r ) : SkyVertex
	{
		return SkyVertex{ .position= l.position + r.position };
	}

	op-( SkyVertex& l, SkyVertex& r ) : SkyVertex
	{
		return SkyVertex{ .position= l.position - r.position };
	}
}

// RGB light modulated by one minus fog density and fog density itself in the last component.
type VertexLightWithFog= [ f32, 4 ];

// Near plane + side planes.
type FrustumClipPlanes= tup[ Planef, FrustumSideClipPlanes ];
type FrustumSideClipPlanes= [ Planef, 4 ];

} // namespace PM
