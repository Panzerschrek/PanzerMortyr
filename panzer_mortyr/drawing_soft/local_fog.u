import "local_fog.iu"

namespace PM
{

fn DrawLocalFogVolume(
	Color32ImageView surface,
	ust::array_view_imut</f32/> depth_buffer,
	[ f32, 4 ]& fog_color,
	BBox3f& fog_volume_bbox )
{
	// TODO - draw proper volume.
	ust::ignore_unused( depth_buffer );
	ust::ignore_unused( fog_volume_bbox );

	foreach( &mut pixel : surface.pixels )
	{
		var BRGAColor color_components= Color32ReadRawComponents( pixel );

		var BRGAColor color_mixed
		[
			( ust::max( 0.0f, ust::min( f32( color_components[0] ) + fog_color[0], 255.0f ) ) ),
			( ust::max( 0.0f, ust::min( f32( color_components[1] ) + fog_color[1], 255.0f ) ) ),
			( ust::max( 0.0f, ust::min( f32( color_components[2] ) + fog_color[2], 255.0f ) ) ),
			( ust::max( 0.0f, ust::min( f32( color_components[3] ) + fog_color[3], 255.0f ) ) ),
		];

		Color32WriteRawComponents( pixel, color_mixed );
	}
}

} // namespace PM
