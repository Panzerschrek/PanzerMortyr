import "color32.iu"

namespace PM
{

template</size_type size_log2/>
type Color32SquareTexture= [ [ Color32, 1s << size_log2 ], 1s << size_log2 ];

type Color32WorldTextureMip0= Color32SquareTexture</ 7s />;

type Color32WorldTextureWithMips= tup[
	Color32SquareTexture</ 7s />, // 128 x 128
	Color32SquareTexture</ 6s />, //  64 x  64
	Color32SquareTexture</ 5s />, //  32 x  32
	Color32SquareTexture</ 4s />, //  16 x  16
	Color32SquareTexture</ 3s />, //   8 x   8
	Color32SquareTexture</ 2s />, //   4 x   4
	Color32SquareTexture</ 1s />, //   2 x   2
	Color32SquareTexture</ 0s />  //   1 x   1
	];

// Overloads for all texture sizes which are actually used.
fn BuildTextureMip( Color32SquareTexture</ 0s />& mut dst, Color32SquareTexture</ 1s />& src );
fn BuildTextureMip( Color32SquareTexture</ 1s />& mut dst, Color32SquareTexture</ 2s />& src );
fn BuildTextureMip( Color32SquareTexture</ 2s />& mut dst, Color32SquareTexture</ 3s />& src );
fn BuildTextureMip( Color32SquareTexture</ 3s />& mut dst, Color32SquareTexture</ 4s />& src );
fn BuildTextureMip( Color32SquareTexture</ 4s />& mut dst, Color32SquareTexture</ 5s />& src );
fn BuildTextureMip( Color32SquareTexture</ 5s />& mut dst, Color32SquareTexture</ 6s />& src );
fn BuildTextureMip( Color32SquareTexture</ 6s />& mut dst, Color32SquareTexture</ 7s />& src );
fn BuildTextureMip( Color32SquareTexture</ 7s />& mut dst, Color32SquareTexture</ 8s />& src );

// Build mips using data of mip0.
fn BuildWorldTextureMips( Color32WorldTextureWithMips &mut texture );

} // namespace PM
