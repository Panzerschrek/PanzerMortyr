import "color32.iu"

namespace PM
{

template</size_type size_log2/>
type Color32SquareTexture= [ [ Color32, 1s << size_log2 ], 1s << size_log2 ];

type Color32WorldTextureWithMips= tup[
	Color32SquareTexture</ 7s />, // 128 x 128
	Color32SquareTexture</ 6s />, //  64 x  64
	Color32SquareTexture</ 5s />, //  32 x  32
	Color32SquareTexture</ 4s />, //  16 x  16
	Color32SquareTexture</ 3s />, //   8 x   8
	Color32SquareTexture</ 2s />, //   4 x   4
	Color32SquareTexture</ 1s />, //   2 x   2
	Color32SquareTexture</ 0s />  //   1 x   1
	];

template</ size_type dst_size, size_type src_size />
fn enable_if( dst_size * 2s == src_size )
BuildTextureMip( [ [ Color32, dst_size ], dst_size ] &mut dst, [ [ Color32, src_size ], src_size ]& src )
{
	for( auto mut dst_y= 0s; dst_y < dst_size; ++dst_y )
	{
		var [ Color32, dst_size ] &mut dst_line= dst[ dst_y ];
		var [ Color32, src_size ]& src_line0= src[ dst_y * 2s + 0s ];
		var [ Color32, src_size ]& src_line1= src[ dst_y * 2s + 1s ];

		for( auto mut dst_x= 0s; dst_x < dst_size; ++dst_x )
		{
			var [ RGBAColor, 4 ] c
			[
				Color32ToComponents( src_line0[ dst_x * 2s + 0s ] ),
				Color32ToComponents( src_line0[ dst_x * 2s + 1s ] ),
				Color32ToComponents( src_line1[ dst_x * 2s + 0s ] ),
				Color32ToComponents( src_line1[ dst_x * 2s + 1s ] ),
			];

			var RGBAColor c_averaged
			[
				( ( u32( c[0][0] ) + u32( c[1][0] ) + u32( c[2][0] ) + u32( c[3][0] ) ) >> 2 ),
				( ( u32( c[0][1] ) + u32( c[1][1] ) + u32( c[2][1] ) + u32( c[3][1] ) ) >> 2 ),
				( ( u32( c[0][2] ) + u32( c[1][2] ) + u32( c[2][2] ) + u32( c[3][2] ) ) >> 2 ),
				( ( u32( c[0][3] ) + u32( c[1][3] ) + u32( c[2][3] ) + u32( c[3][3] ) ) >> 2 ),
			];

			dst_line[ dst_x ]= Color32FromComponents( c_averaged );
		}
	}
}

} // namespace PM
