import "world_drawer_soft_singlethreaded.iu"

namespace PM
{

fn WorldDrawerSoftSinglethreaded::constructor(
	ust::shared_ptr_mut</WindowSoft/> mut window,
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader,
	ConsoleOutPtr mut console_out )
	(
		window_= move(window),
		game_params_=
			lambda[&]() : GameResourcePtr</GameParams/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadGameParams();
			}(),
		maps_description_=
			lambda[&]() : GameResourcePtr</MapsDescription/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadMapsDescription();
			}(),
		materials_description_=
			lambda[&]() : GameResourcePtr</MaterialsDescription/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadMaterialsDescription();
			}(),
		billboards_description_=
			WorldDrawerSoftInternal::LoadBillboardsDescription(
				caching_game_resources_loader.lock_imut().deref().GetGameFilesystem(), console_out ),
		caching_game_resources_loader_ptr_= move(caching_game_resources_loader),
		drawer_internal_( settings ),
		console_out_= move(console_out),
		map_index_= 0u,
	)
{}

fn WorldDrawerSoftSinglethreaded::Draw( mut this, WorldDrawingInfo& drawing_info ) : WorldDrawingStats
{
	// Load models in use if switching to a new map.
	var bool need_loading_models= map_index_ != drawing_info.map_index;

	// Ensure we have actual map data.
	SetMap( drawing_info.map_index );

	if( need_loading_models && !map_data_.empty() )
	{
		// Load models in use if switching to a new map.
		WorldDrawerSoftInternal::LoadModels(
			drawing_info.used_models,
			caching_game_resources_loader_ptr_.lock_imut().deref().GetGameFilesystem(),
			console_out_,
			map_data_.try_deref().map_draw_data.deref().textures,
			models_ );
	}

	if( map_data_.empty() )
	{
		return ust::make_zeroed</WorldDrawingStats/>();
	}

	auto mut window_lock= window_.lock_mut();

	var MapsDescription::MapDescription& map_description= maps_description_.deref().maps[ size_type( map_index_ ) ];

	var MaterialsDescription::Block& materials_block=
		materials_description_.deref().blocks[ map_description.materials_block ]; // Halts if not found.

	return
		drawer_internal_.Draw(
		window_lock.deref().GetSurface(),
		game_params_.deref(),
		billboards_description_,
		map_description,
		materials_block,
		map_data_.try_deref(),
		models_,
		drawing_info );
}

fn WorldDrawerSoftSinglethreaded::SetMap( mut this, u32 map_index )
{
	// Check if we need to reload map first.
	if( map_index == map_index_ )
	{
		return;
	}
	// Need to load map data.

	// Set map index in any case - it may be necessary in order to avoid reloading map data constantly if failed to load it once.
	map_index_= map_index;

	// Reset previous map data first - to free used memory before allocating new memory for new map.
	map_data_.reset();

	if( map_index == 0u )
	{
		ConsoleOutAddTextLine( console_out_, "Can't load map 0!" );
		return;
	}

	auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	var ust::shared_ptr_mt_final_nullable</ MapDrawDataSoft /> map_draw_data_nullable_ptr=
		WorldDrawerSoftInternal::LoadMap(
			caching_game_resources_loader,
			console_out_,
			game_params_.deref(),
			maps_description_.deref(),
			materials_description_.deref(),
			billboards_description_,
			map_index );

	if( !map_draw_data_nullable_ptr.empty() )
	{
		map_data_= WorldDrawerSoftInternal::CreateMapFullData( map_draw_data_nullable_ptr.try_to_non_nullable() );
	}
}

} // namespace PM
