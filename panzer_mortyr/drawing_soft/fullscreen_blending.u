import "fullscreen_blending.iu"

namespace PM
{

fn ApplyFullscreenBlending( Color32ImageView surface )
{
	auto s= surface; // Take a copy to make sure it's not re-read on each loop iteration.

	for( auto mut y= 0u; y < s.size[1]; ++y )
	{
		for( auto mut x= 0u; x < s.size[0]; ++x )
		{
			var Color32 &mut dst_color= s.pixels[ size_type( x + y * s.stride ) ];

			// TODO - apply proper color gradient.
			dst_color= Color32Average( dst_color, Color32( 0x00FF00FFu ) );
		}
	}
}

} // namespace PM
