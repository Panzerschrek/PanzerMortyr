import "fullscreen_blending.iu"

namespace PM
{

fn ApplyFullscreenBlending( Color32ImageView surface, RGBAColor blend_color )
{
	if( blend_color[3] <= 2u8 )
	{
		return;
	}

	// Take a copy to make sure it's not re-read on each loop iteration.
	auto surface_copy= surface;
	var RGBAColor blend_color_copy= blend_color;

	var [ i32, 2 ] center_fixed1
	[
		( surface_copy.size[0] ),
		( surface_copy.size[1] ),
	];

	var [ i32, 2 ] radial_scale_fixed23
	[
		( ( 2 << 23 ) / i32( surface_copy.size[0] ) ),
		( ( 2 << 23 ) / i32( surface_copy.size[1] ) ),
	];

	var u32 alpha_scale_fixed8= ( u32( blend_color[3] ) << 8u ) / 255u;

	for( auto mut y= 0u; y < surface_copy.size[1]; ++y )
	{
		var i32 pixel_pos_y_fixed1= ( i32(y) << 1 ) + 1;
		var i32 radial_vector_y_fixed24= radial_scale_fixed23[1] * ( pixel_pos_y_fixed1 - center_fixed1[1] );
		var i64 radial_vector_y_squared_fixed48= i64( radial_vector_y_fixed24 ) * i64( radial_vector_y_fixed24 );

		for( auto mut x= 0u; x < surface_copy.size[0]; ++x )
		{
			var i32 pixel_pos_x_fixed1= ( i32(x) << 1 ) + 1;
			var i32 radial_vector_x_fixed24= radial_scale_fixed23[0] * ( pixel_pos_x_fixed1 - center_fixed1[0] );
			var i64 radial_vector_x_squared_fixed48= i64( radial_vector_x_fixed24 ) * i64( radial_vector_x_fixed24 );

			var u32 square_distance_to_center_fixed16(
				( radial_vector_x_squared_fixed48 + radial_vector_y_squared_fixed48 ) >> 32 );

			var u32 blending_factor_fixed24(
				( alpha_scale_fixed8 * ust::min( square_distance_to_center_fixed16, 1u << 16 ) ) );

			var u32 one_minus_blending_factor_fixed24= ( 1u << 24 ) - blending_factor_fixed24;

			var Color32 &mut dst_color= surface_copy.pixels[ size_type( x + y * surface_copy.stride ) ];

			var RGBAColor components= Color32ToComponents( dst_color );

			var RGBAColor components_blended
			[
				( ( u32( components[0] ) * one_minus_blending_factor_fixed24 + u32( blend_color_copy[0] ) * blending_factor_fixed24 ) >> 24 ),
				( ( u32( components[1] ) * one_minus_blending_factor_fixed24 + u32( blend_color_copy[1] ) * blending_factor_fixed24 ) >> 24 ),
				( ( u32( components[2] ) * one_minus_blending_factor_fixed24 + u32( blend_color_copy[2] ) * blending_factor_fixed24 ) >> 24 ),
				( ( u32( components[3] ) * one_minus_blending_factor_fixed24 + u32( blend_color_copy[3] ) * blending_factor_fixed24 ) >> 24 ),
			];

			dst_color= Color32FromComponents( components_blended );
		}
	}
}

} // namespace PM
