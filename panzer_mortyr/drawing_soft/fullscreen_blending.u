import "fullscreen_blending.iu"

namespace PM
{

fn ApplyFullscreenBlending( Color32ImageView surface, RGBAColor blend_color )
{
	if( blend_color[3] <= 2u8 )
	{
		return;
	}

	// Take a copy to make sure it's not re-read on each loop iteration.
	auto surface_copy= surface;
	var RGBAColor blend_color_copy= blend_color;

	var [ f32, 2 ] center
	[
		f32( surface_copy.size[0] ) * 0.5f,
		f32( surface_copy.size[1] ) * 0.5f,
	];

	var [ f32, 2 ] radial_scale
	[
		2.0f / f32( surface_copy.size[0] ),
		2.0f / f32( surface_copy.size[1] ),
	];

	var f32 alpha_scale= 65536.0f * f32( blend_color[3] ) / 255.0f;

	for( auto mut y= 0u; y < surface_copy.size[1]; ++y )
	{
		for( auto mut x= 0u; x < surface_copy.size[0]; ++x )
		{
			var [ f32, 2 ] pixel_pos[ f32(x) + 0.5f, f32(y) + 0.5f ];

			var [ f32, 2 ] vec_to_center
			[
				radial_scale[0] * ( pixel_pos[0] - center[0] ),
				radial_scale[1] * ( pixel_pos[1] - center[1] ),
			];

			var f32 square_distance_to_center=
				vec_to_center[0] * vec_to_center[0] + vec_to_center[1] * vec_to_center[1];

			var u32 blending_factor_fixed16( alpha_scale * ust::min( square_distance_to_center, 1.0f ) );
			var u32 one_minus_blending_factor_fixed16= 65536u - blending_factor_fixed16;

			var Color32 &mut dst_color= surface_copy.pixels[ size_type( x + y * surface_copy.stride ) ];

			var RGBAColor components= Color32ToComponents( dst_color );

			var RGBAColor components_blended
			[
				( ( u32( components[0] ) * one_minus_blending_factor_fixed16 + u32( blend_color_copy[0] ) * blending_factor_fixed16 ) >> 16 ),
				( ( u32( components[1] ) * one_minus_blending_factor_fixed16 + u32( blend_color_copy[1] ) * blending_factor_fixed16 ) >> 16 ),
				( ( u32( components[2] ) * one_minus_blending_factor_fixed16 + u32( blend_color_copy[2] ) * blending_factor_fixed16 ) >> 16 ),
				( ( u32( components[3] ) * one_minus_blending_factor_fixed16 + u32( blend_color_copy[3] ) * blending_factor_fixed16 ) >> 16 ),
			];

			dst_color= Color32FromComponents( components_blended );
		}
	}
}

} // namespace PM
