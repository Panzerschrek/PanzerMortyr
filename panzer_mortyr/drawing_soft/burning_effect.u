import "burning_effect.iu"

namespace PM
{

fn CalculateVertexLightsForBurningEffect(
	f32 burning_strength, ust::array_view_mut</ VertexLightWithFog /> vertex_lights )
{
	foreach( &mut vl : vertex_lights )
	{
		// TODO - perform proper light calculation.

		vl[0]= burning_strength * 0.1f;
		vl[1]= burning_strength * 0.3f;
		vl[2]= burning_strength * 0.5f;
	}
}

} // namespace PM
