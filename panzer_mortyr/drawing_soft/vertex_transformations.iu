import "../lighting.iu"
import "model_soft.iu"

namespace PM
{

fn EnsureTransformedVerticesCapacity( ust::vector</Vec3f/> &mut transformed_vertices, size_type capacity )
	: ust::array_view_mut</ Vec3f /> @( ust::reference_notation::return_inner_references::param0 );

fn EnsureVertexLightsCapacity( ust::vector</ [ f32, 4 ] /> &mut vertex_lights, size_type capacity )
	: ust::array_view_mut</ [ f32, 4 ] /> @( ust::reference_notation::return_inner_references::param0 );

fn TransformModelVerticesSingleFrame(
	ust::array_view_imut</ ModelFrameVertex /> frame_vertices,
	ust::array_view_mut</Vec3f/> vertices_transformed,
	Mat4f& model_full_matrix  );

fn TransformModelVerticesTwoFrames(
	ust::array_view_imut</ ModelFrameVertex /> frame0_vertices,
	ust::array_view_imut</ ModelFrameVertex /> frame1_vertices,
	ust::array_view_mut</Vec3f/> vertices_transformed,
	f32 frame_mix,
	Mat4f& model_full_matrix );

fn ApplyLightToModelVerticesSingleFrame(
	ust::array_view_imut</ ModelFrameVertex /> frame_vertices,
	ust::array_view_mut</ [ f32, 4 ] /> vertex_light,
	SphericalHarmonicsRGB& light );

fn ApplyLightToModelVerticesTwoFrames(
	ust::array_view_imut</ ModelFrameVertex /> frame0_vertices,
	ust::array_view_imut</ ModelFrameVertex /> frame1_vertices,
	ust::array_view_mut</ [ f32, 4 ] /> vertex_light,
	f32 frame_mix,
	SphericalHarmonicsRGB& light );

} // namespace PM
