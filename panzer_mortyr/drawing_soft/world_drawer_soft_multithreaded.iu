import "/shared_barrier.iu"
import "/shared_ptr_mt.iu"
import "/thread.iu"
import "../caching_game_resources_loader.iu"
import "../settings.iu"
import "window_soft.iu"
import "world_drawer_soft_internal.iu"

namespace PM
{

class WorldDrawerSoftMultithreaded final : AbstractWorldDrawer
{
public:
	fn constructor(
		ust::shared_ptr_mut</WindowSoft/> window,
		SettingsImutPtr mut settings,
		CachingGameResourcesLoaderPtr caching_game_resources_loader,
		ConsoleOutPtr console_out );

	fn destructor();

public: // AbstractWorldDrawer
	fn virtual final Draw( mut this, WorldDrawingInfo drawing_info ) : WorldDrawingStats;

private:
	struct DrawerSharedData
	{
		GameResourcePtr</GameParams/> imut game_params;
		GameResourcePtr</MapsDescription/> imut maps_description;
		GameResourcePtr</MaterialsDescription/> imut materials_description;
		BillboardsDescription imut billboards_description;

		u32 map_index;
		ust::optional</ MapFullDrawDataSoft /> map_data;

		// Load models on demand and store them in this container.
		// Store empty optional if failed to load (in order to avoid loading again).
		ModelsMapSoft models;

		// Copy it each frame to give background threads read access to it.
		Settings settings_copy;

		ust::optional</WorldDrawingInfo/> drawing_info;

		bool shutdown_requested;

		// Put all heavyweight fields at the end.

		CausticsTextureData imut caustics_texture;

		// Temporary storage, where interpolated caustics layer for each frame is calculated and stored.
		CausticsTextureLayer interpolated_caustics_layer;
	}

	// Each thread has its own copy, but the host thread can access it.
	struct ThreadIndividualSharedData
	{
		ust::vector</Color32/> color_buffer;
		[ u32, 2 ] imut color_buffer_size;
		[ u32, 2 ] imut dst_offset;

		// Each thread has its own visibility calculator - in order to draw only things visible within its screen region.
		// Should store actual visibility calculators for current map!
		ust::optional</MapVisibilityCalculatorsPair/> map_visibility_calculators;
	}

	struct ThreadData
	{
		ust::shared_ptr_mt_mut</ ThreadIndividualSharedData /> imut individual_shared_data;
		ust::thread</ ThreadFunction, void /> thread;
	}

	struct ThreadFunction
	{
		ust::shared_ptr_mt_imut</DrawerSharedData/> imut drawer_shared_data;
		ust::shared_ptr_mt_mut</ ThreadIndividualSharedData /> imut individual_shared_data;
		ust::shared_barrier imut barrier;

		op()( this );
	}

private:
	fn CreateThreads(
		u32 num_threads,
		ust::shared_barrier& barrier,
		ust::shared_ptr_mt_imut</DrawerSharedData/>& drawer_shared_data_ptr,
		[ u32, 2 ] out_surface_size ) : ust::vector</ThreadData/>;

	fn SetMap( mut this, u32 map_index );

private:
	SettingsImutPtr imut settings_;
	ust::shared_ptr_mut</WindowSoft/> imut window_;
	CachingGameResourcesLoaderPtr imut caching_game_resources_loader_ptr_;
	ConsoleOutPtr imut console_out_;

	ust::shared_barrier mut barrier_;

	ust::vector</ThreadData/> threads_;

	ust::shared_ptr_mt_mut</DrawerSharedData/> imut drawer_shared_data_;
}

} // namespace PM
