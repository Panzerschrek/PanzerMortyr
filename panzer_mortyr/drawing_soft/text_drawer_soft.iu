import "../abstract_text_drawer.iu"
import "../font_files.iu"
import "../game_filesystem.iu"
import "window_soft.iu"

namespace PM
{

class TextDrawerSoft final : AbstractTextDrawer
{
public:
	fn constructor(
		ust::shared_ptr_mut</WindowSoft/> window, GameFilesystemPtr& game_filesystem_ptr, ConsoleOutPtr& console_out );

public: // AbstractTextDrawer
	fn virtual final AddText( mut this, i32 x, i32 y, ust::string_view8 text, Settings& settings );

	fn virtual final DrawTexts( mut this );

private:
	type GlyphData16= [ u16, 8 ]; // 8x8 glyph with 2 bits per pixel.

	struct FontData16
	{
		ust::vector</GlyphData16/> glyphs;
		ust::vector</u8/> widths;
	}

	struct GlyphToDraw
	{
		i16 x;
		i16 y;
		u8 scale;
		u8 glyph_index;
		Color32 foreground_color;
		Color32 background_color;
	}

	static_assert( typeinfo</GlyphToDraw/>.size_of == 16s );

private:
	fn CreateFontData16( FontData& font_data ) : FontData16;
	fn CreateGlyphData16( FontData::Glyph& glyph ) : GlyphData16;

private:
	ust::shared_ptr_mut</WindowSoft/> imut window_;
	[ u32, 2 ] imut viewport_size_;
	FontData16 imut font_data16_;
	ust::hash_map</char32, u32/> imut code_point_to_glyph_position_map_;

	ust::vector</GlyphToDraw/> glyphs_to_draw_;
}

} // namespace PM
