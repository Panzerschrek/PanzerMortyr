	u32 tc_offset_x, u32 tc_offset_y,
	u32 tc_size_x, u32 tc_size_y,
	u8 alpha )
{
	// TODO
	ust::ignore_unused( image_file_name );
	ust::ignore_unused( x );
	ust::ignore_unused( y );
	ust::ignore_unused( scale );
	ust::ignore_unused( tc_offset_x );
	ust::ignore_unused( tc_offset_y );
	ust::ignore_unused( tc_size_x );
	ust::ignore_unused( tc_size_y );
	ust::ignore_unused( alpha );
}

fn ImageDrawerSoft::UploadAndDrawImage( mut this, ImageData& image_data, i32 x, i32 y, f32 scale )
{
	// TODO
	ust::ignore_unused( image_data );
	ust::ignore_unused( x );
	ust::ignore_unused( y );
	ust::ignore_unused( scale );
}

