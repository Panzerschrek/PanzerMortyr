import "/math.iu"
import "../image_loading.iu"
import "image_drawer_soft.iu"

namespace PM
{

fn ImageDrawerSoft::constructor(
	ust::shared_ptr_mut</WindowSoft/> mut window, GameFilesystemPtr mut game_filesystem_ptr )
	( window_= move(window), game_filesystem_ptr_= move(game_filesystem_ptr) )
{
}

fn ImageDrawerSoft::PreloadImage(
	mut this, ResourceString& image_file_name, ust::optional_ref_imut</ [ u8, 3 ] /> transparent_color )
{
	if( images_.exists( image_file_name ) )
	{
		return;
	}

	auto mut lock= game_filesystem_ptr_.lock_mut();

	result_match( lock.deref().LoadFile( image_file_name, LoadImageBMP ) )
	{
		Ok( mut image_data ) ->
		{
			var bool mut has_alpha= false;
			if_var( &c : transparent_color )
			{
				// Make transparent color black and for other colors set alpha to 255.
				foreach( &mut pixel : image_data.pixels )
				{
					if( pixel[0] == c[0] & pixel[1] == c[1] & pixel[2] == c[2] )
					{
						pixel= ust::make_array( 0u8, 0u8, 0u8, 0u8 );
						has_alpha= true;
					}
					else
					{
						pixel[3]= 255u8;
					}
				}
			}
			else
			{
				// Always set alpha to 255.
				foreach( &mut pixel : image_data.pixels )
				{
					pixel[3]= 255u8;
				}
			}

			// Swap rows to achieve proper order. TODO - is it needed?
			for( auto mut y= 0u; y < image_data.size[1] / 2u; ++y )
			{
				var u32 offset0= y * image_data.size[0];
				var u32 offset1= ( image_data.size[1] - 1u - y ) * image_data.size[0];
				for( auto mut x= 0u; x < image_data.size[0]; ++x )
				{
					image_data.pixels.swap( size_type( offset0 + x ), size_type( offset1 + x ) );
				}
			}

			images_.insert_new( image_file_name, ImageExt{ .data= move( image_data ), .has_alpha= has_alpha } );
		},
		Err(e) ->
		{
			// TODO - print error message?
			ust::ignore_unused(e);

			// Save a stub to avoid loading it again.
			images_.insert_new( image_file_name, ust::optional</ImageExt/>() );
		}
	}
}

fn ImageDrawerSoft::GetImageSize( this, ResourceString& image_file_name ) : ust::optional</ [ u32, 2 ] />
{
	if_var( & image_opt : images_.find( image_file_name ) )
	{
		if_var( & image : image_opt )
		{
			return image.data.size;
		}
	}

	return ust::null_optional;
}

fn ImageDrawerSoft::DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale )
{
	DrawImage( image_file_name, x, y, scale, 255u8 );
}

fn ImageDrawerSoft::DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale, u8 alpha )
{
	auto image_ref_opt= images_.find( image_file_name );
	if( image_ref_opt.empty() )
	{
		return;
	}

	var ust::optional</ImageExt/>& image_opt= image_ref_opt.try_deref();
	if( image_opt.empty() )
	{
		return;
	}

	var ImageExt& image= image_opt.try_deref();
	ust::ignore_unused(image);

	auto image_size= image.data.size;
	auto image_pixels= image.data.pixels.range();

	auto mut window_lock= window_.lock_mut();
	var Color32ImageView surface= window_lock.deref().GetSurface();

	var i32 y_end_initial= i32( surface.size[1] ) - y;
	var i32 y_begin_initial= y_end_initial - i32( ust::round( f32( image.data.size[1] ) * scale ) );

	var u32 x_begin( ust::max( 0, x ) );
	var u32 y_begin( ust::max( 0, y_begin_initial ) );
	var u32 x_end( ust::min( x + i32( ust::round( f32( image.data.size[0] ) * scale ) ), i32( surface.size[0] ) ) );
	var u32 y_end( ust::min( y_end_initial, i32( surface.size[1] ) ) );

	if( alpha == 255u8 && !image.has_alpha )
	{
		// A case where no alpha-blending is necessary.

		for( var u32 mut dst_y= y_begin; dst_y < y_end; ++dst_y )
		{
			var u32 v( f32( i32(dst_y) - i32(y_begin_initial) ) / scale );

			auto image_pixels_line= image_pixels.subrange_start( size_type( ( v % image_size[1] ) * image_size[0] ) );

			auto dst_line= surface.pixels.subrange_start( size_type( dst_y * surface.stride ) );

			for( var u32 mut dst_x= x_begin; dst_x < x_end; ++dst_x )
			{
				var u32 u( f32( i32(dst_x) - i32(x) ) / scale );

				var RGBAColor c= image_pixels_line[ size_type( u % image_size[0] ) ];
				dst_line[ size_type( dst_x ) ]= Color32FromComponents( c );
			}
		}
	}
	else
	{
		for( var u32 mut dst_y= y_begin; dst_y < y_end; ++dst_y )
		{
			var u32 v( f32( i32(dst_y) - i32(y_begin_initial) ) / scale );

			auto image_pixels_line= image_pixels.subrange_start( size_type( ( v % image_size[1] ) * image_size[0] ) );

			auto dst_line= surface.pixels.subrange_start( size_type( dst_y * surface.stride ) );

			for( var u32 mut dst_x= x_begin; dst_x < x_end; ++dst_x )
			{
				var u32 u( f32( i32(dst_x) - i32(x) ) / scale );

				var RGBAColor src_components= image_pixels_line[ size_type( u % image_size[0] ) ];

				var Color32 &mut dst= dst_line[ size_type( dst_x ) ];
				var RGBAColor dst_components= Color32ToComponents( dst );

				var u32 alpha_combined= u32(alpha) * u32( src_components[3] ) / 255u;
				var u32 one_minus_alpha_combined= 255u - alpha_combined;
				var RGBAColor color_mixed
				[
					( ( u32( src_components[0] ) * alpha_combined +
						u32( dst_components[0] ) * one_minus_alpha_combined ) / 255u ),
					( ( u32( src_components[1] ) * alpha_combined +
						u32( dst_components[1] ) * one_minus_alpha_combined ) / 255u ),
					( ( u32( src_components[2] ) * alpha_combined +
						u32( dst_components[2] ) * one_minus_alpha_combined ) / 255u ),
					( ( u32( src_components[3] ) * alpha_combined +
						u32( dst_components[3] ) * one_minus_alpha_combined ) / 255u ),
				];

				dst= Color32FromComponents( color_mixed );
			}
		}
	}
}

fn ImageDrawerSoft::DrawImage(
	mut this,
	ResourceString& image_file_name,
	i32 x, i32 y,
	f32 scale,
	u32 tc_offset_x, u32 tc_offset_y,
	u32 tc_size_x, u32 tc_size_y )
{
	// TODO
	ust::ignore_unused( image_file_name );
	ust::ignore_unused( x );
	ust::ignore_unused( y );
	ust::ignore_unused( scale );
	ust::ignore_unused( tc_offset_x );
	ust::ignore_unused( tc_offset_y );
	ust::ignore_unused( tc_size_x );
	ust::ignore_unused( tc_size_y );
}

fn ImageDrawerSoft::DrawImage(
