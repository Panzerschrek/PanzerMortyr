import "/assert.iu"
import "caustics.iu"
import "world_drawer_soft_multithreaded.iu"

namespace PM
{

fn WorldDrawerSoftMultithreaded::constructor(
	ust::shared_ptr_mut</WindowSoft/> mut window,
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader,
	ConsoleOutPtr mut console_out,
	u32 num_threads )
	(
		settings_= move(settings),
		drawer_shared_data_=
			ust::make_shared_ptr_mt(
				DrawerSharedData
				{
					.game_params=
						lambda[&]() : GameResourcePtr</GameParams/>
						{
							auto mut lock= caching_game_resources_loader.lock_mut();
							return lock.deref().LoadGameParams();
						}(),
					.maps_description=
						lambda[&]() : GameResourcePtr</MapsDescription/>
						{
							auto mut lock= caching_game_resources_loader.lock_mut();
							return lock.deref().LoadMapsDescription();
						}(),
					.materials_description=
						lambda[&]() : GameResourcePtr</MaterialsDescription/>
						{
							auto mut lock= caching_game_resources_loader.lock_mut();
							return lock.deref().LoadMaterialsDescription();
						}(),
					.billboards_description=
						WorldDrawerSoftInternal::LoadBillboardsDescription(
							caching_game_resources_loader.lock_imut().deref().GetGameFilesystem(), console_out ),
					.viewport_size= window.lock_imut().deref().GetViewportSize(),
					.map_index= 0u,
					.shutdown_requested= false,
					.caustics_texture= CreateCausticsTexture(),
					.interpolated_caustics_layer= zero_init,
				} ),
		window_= move(window),
		caching_game_resources_loader_ptr_= move(caching_game_resources_loader),
		console_out_= move(console_out),
		barriers_
		{
			// We have worker threads and single host thread.
			.drawing_start( num_threads + 1u ),
			.drawing_end  ( num_threads + 1u ),
		},
		threads_=
			CreateThreads( num_threads, barriers_, drawer_shared_data_, window_.lock_imut().deref().GetViewportSize() ),
	)
{
}

fn WorldDrawerSoftMultithreaded::destructor()
{
	with( mut lock : drawer_shared_data_.lock_mut() )
	{
		lock.deref().shutdown_requested= true;
	}

	barriers_.drawing_start.wait();

	threads_.clear(); // This causes joining.
}

fn WorldDrawerSoftMultithreaded::Draw( mut this, WorldDrawingInfo mut drawing_info ) : WorldDrawingStats
{
	// Load models in use if switching to a new map.
	var bool need_loading_models= drawer_shared_data_.lock_imut().deref().map_index != drawing_info.map_index;

	// Ensure we have actual map data.
	SetMap( drawing_info.map_index );

	with( mut drawer_shared_data_lock : drawer_shared_data_.lock_mut() )
	{
		var DrawerSharedData &mut drawer_shared_data= drawer_shared_data_lock.deref();

		if( need_loading_models && !drawer_shared_data.map_data.empty() )
		{
			// Load models in use if switching to a new map.
			WorldDrawerSoftInternal::LoadModels(
				drawing_info.used_models,
				caching_game_resources_loader_ptr_.lock_imut().deref().GetGameFilesystem(),
				console_out_,
				drawer_shared_data.map_data.try_deref().map_draw_data.textures,
				drawer_shared_data.models );
		}

		if( drawer_shared_data.map_data.empty() )
		{
			return ust::make_zeroed</WorldDrawingStats/>();
		}

		var MapFullDrawDataSoft &mut map_data_full= drawer_shared_data.map_data.try_deref();

		// Perform per-frame calculations independent on view point.
		// TODO - move this code into a common place.
		{
			var MapDrawDataSoft& map_data= map_data_full.map_draw_data;

			var ust::array_view_mut</bool/> highlighted_cluster_flags= map_data_full.highlighted_cluster_flags;

			foreach( &mut flag : highlighted_cluster_flags )
			{
				flag= false;
			}

			foreach( cluster_index : drawing_info.highlighted_cluster_indices )
			{
				if( size_type( cluster_index ) < highlighted_cluster_flags.size() )
				{
					highlighted_cluster_flags[ size_type( cluster_index ) ]= true;
				}
			}

			var TexturesWithAppliedCaustics &mut textures_with_applied_caustics=
					map_data_full.textures_with_applied_caustics;

			if( settings_.lock_imut().deref().r_caustics_enabled && !textures_with_applied_caustics.empty() )
			{
				// Just update all textures affected by caustics each frame.
				// We have not so many of such textures (no more than 10) and code doing so is pretty-fast.

				FetchInterpolatedCausticsTextureLayer(
					drawer_shared_data.caustics_texture,
					drawing_info.game_time_s,
					drawer_shared_data.interpolated_caustics_layer );

				// Just update all textures affected by caustics each frame.
				// We have not so many of such textures (no more than 10) and code doing so is pretty-fast.

				foreach( pair : textures_with_applied_caustics )
				{
					var Color32WorldTextureWithMips& src_texture= map_data.textures[ size_type( pair.key() ) ];
					var Color32WorldTextureWithMips &mut dst_texture= pair.value().deref();
					ApplyCausticsTexture( drawer_shared_data.interpolated_caustics_layer, src_texture[0], dst_texture );
				}
			}
		}
	}

	with( mut drawer_shared_data_lock : drawer_shared_data_.lock_mut() )
	{
		var DrawerSharedData &mut drawer_shared_data= drawer_shared_data_lock.deref();

		// Provide copy of settings.
		// TODO - consider copying not the whole struct, but reading only needed fields.
		drawer_shared_data.settings_copy= settings_.lock_imut().deref();

		// Provide drawing info for worker threads.
		drawer_shared_data.drawing_info= move( drawing_info );
	}

	// Tell other threads that they should start drawing.
	barriers_.drawing_start.wait();

	// Wait until the work is finished.
	barriers_.drawing_end.wait();

	// Copy individual framebuffers of each thread into the result surface.

	auto mut window_lock= window_.lock_mut();

	var Color32ImageView surface= window_lock.deref().GetSurface();

	foreach( &mut thread_data : threads_ )
	{
		auto mut thread_individual_shared_data_lock= thread_data.individual_shared_data.lock_imut();
		var ThreadIndividualSharedData& thread_individual_shared_data= thread_individual_shared_data_lock.deref();

		for( auto mut src_y= 0u; src_y < thread_individual_shared_data.color_buffer_size[1]; ++src_y )
		{
			auto dst_x= thread_individual_shared_data.dst_offset[0];
			auto dst_y= src_y + thread_individual_shared_data.dst_offset[1];

			auto src_line=
				thread_individual_shared_data.color_buffer.range().subrange(
					size_type( thread_individual_shared_data.color_buffer_size[0] * src_y ),
					size_type( thread_individual_shared_data.color_buffer_size[0] * ( src_y + 1u ) ) );

			auto dst_line=
				surface.pixels.subrange(
					size_type( dst_x + dst_y * surface.stride ),
					size_type( dst_x + dst_y * surface.stride + thread_individual_shared_data.color_buffer_size[0] ) );

			dst_line.copy_from( src_line );
		}
	}

	return ust::make_zeroed</ WorldDrawingStats />(); // TODO - return proper stats.
}

op WorldDrawerSoftMultithreaded::ThreadFunction::()( this )
{
	var WorldDrawerSoftInternal mut drawer;

	loop
	{
		// Wait for others and host before performing drawing.
		barriers.drawing_start.wait();

		with( mut drawer_shared_data_lock : drawer_shared_data.lock_imut() )
		{
			var DrawerSharedData& drawer_shared_data= drawer_shared_data_lock.deref();

			if( drawer_shared_data.shutdown_requested )
			{
				return;
			}

			auto mut thread_individual_shared_data_lock= individual_shared_data.lock_mut();
			var ThreadIndividualSharedData &mut thread_individual_shared_data= thread_individual_shared_data_lock.deref();

			if( !drawer_shared_data.map_data.empty() &&
				!drawer_shared_data.drawing_info.empty() &&
				!thread_individual_shared_data.map_visibility_calculators.empty() )
			{
				var MapsDescription::MapDescription& map_description=
					drawer_shared_data.maps_description.deref().maps[ size_type( drawer_shared_data.map_index ) ];

				var MaterialsDescription::Block& materials_block=
					drawer_shared_data.materials_description.deref().blocks[ map_description.materials_block ]; // Halts if not found.

				// TODO - provide here destination region.
				drawer.Draw(
					drawer_shared_data.settings_copy,
					Color32ImageView
					{
						.pixels= thread_individual_shared_data.color_buffer,
						.size= thread_individual_shared_data.color_buffer_size,
						.stride= thread_individual_shared_data.color_buffer_size[0],
					},
					WorldDrawerSoftInternal::ViewportContext
					{
						.subrect_offset= thread_individual_shared_data.dst_offset,
						.total_viewport_size= drawer_shared_data.viewport_size,
					},
					drawer_shared_data.game_params.deref(),
					drawer_shared_data.billboards_description,
					map_description,
					materials_block,
					drawer_shared_data.map_data.try_deref(),
					thread_individual_shared_data.map_visibility_calculators.try_deref(),
					drawer_shared_data.models,
					drawer_shared_data.drawing_info.try_deref() );
			}
		}

		// Synchronize with others and host after performing drawing.
		barriers.drawing_end.wait();
	}
}

fn WorldDrawerSoftMultithreaded::CreateThreads(
	u32 num_threads,
	Barriers& barriers,
	ust::shared_ptr_mt_imut</DrawerSharedData/>& drawer_shared_data_ptr,
	[ u32, 2 ] out_surface_size ) : ust::vector</ThreadData/>
{
	var ust::vector</ViewportSubrect/> subrects= SplitViewportRect( out_surface_size, num_threads );
	assert( subrects.size() == size_type( num_threads ) );

	var ust::vector</ThreadData/> mut result_threads;

	for( auto mut i= 0u; i < num_threads; ++i )
	{
		var ViewportSubrect& subrect= subrects[ size_type(i) ];

		auto individual_shared_data=
			ust::make_shared_ptr_mt(
				ThreadIndividualSharedData
				{
					.color_buffer( size_type( subrect.size[0] * subrect.size[1] ), Color32(0) ),
					.color_buffer_size= subrect.size,
					.dst_offset= subrect.offset,
				} );

		result_threads.push_back(
			ThreadData
			{
				.individual_shared_data= individual_shared_data,
				.thread=
					ust::make_thread(
						ThreadFunction
						{
							.barriers= barriers,
							.drawer_shared_data= drawer_shared_data_ptr,
							.individual_shared_data= individual_shared_data,
						} ),
			} );
	}

	return result_threads;
}

fn WorldDrawerSoftMultithreaded::SetMap( mut this, u32 map_index )
{
	with( mut drawer_shared_data_lock : drawer_shared_data_.lock_mut() )
	{
		var DrawerSharedData &mut drawer_shared_data= drawer_shared_data_lock.deref();

		// Check if we need to reload map first.
		if( map_index == drawer_shared_data.map_index )
		{
			return;
		}
		// Need to load map data.

		// Set map index in any case - it may be necessary in order to avoid reloading map data constantly if failed to load it once.
		drawer_shared_data.map_index= map_index;

		// Reset previous map data first - to free used memory before allocating new memory for new map.
		drawer_shared_data.map_data.reset();

		foreach( &mut thread_data : threads_ )
		{
			with( &mut lock : thread_data.individual_shared_data.lock_mut() )
			{
				lock.deref().map_visibility_calculators.reset();
			}
		}

		if( map_index == 0u )
		{
			ConsoleOutAddTextLine( console_out_, "Can't load map 0!" );
			return;
		}

		auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
		var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

		var ust::optional</ MapFullDrawDataSoft /> mut map_draw_data_opt=
			WorldDrawerSoftInternal::LoadMap(
				caching_game_resources_loader,
				console_out_,
				drawer_shared_data.game_params.deref(),
				drawer_shared_data.maps_description.deref(),
				drawer_shared_data.materials_description.deref(),
				drawer_shared_data.billboards_description,
				map_index );

		if( !map_draw_data_opt.empty() )
		{
			var ust::shared_ptr_mt_final</RoomClustersBSPTree/> room_clusters_bsp_tree=
				map_draw_data_opt.try_deref().map_draw_data.room_clusters_bsp_tree;

			drawer_shared_data.map_data= map_draw_data_opt.try_take();

			foreach( &mut thread_data : threads_ )
			{
				with( &mut lock : thread_data.individual_shared_data.lock_mut() )
				{
					lock.deref().map_visibility_calculators=
						ust::make_array(
							MapVisibilityCalculator( room_clusters_bsp_tree ),
							MapVisibilityCalculator( room_clusters_bsp_tree ) );
				}
			}
		}
	}
}

struct ViewportSubrect
{
	[ u32, 2 ] offset;
	[ u32, 2 ] size;
}

// Split given viewport rect into several subrects.
// This function tries to preserve equal area and makes rects as square as possible.
fn SplitViewportRect( [ u32, 2 ] size, u32 num_parts ) : ust::vector</ ViewportSubrect />
{
	var ust::vector</ ViewportSubrect /> mut subrects;
	SplitViewportSubrect_r( ViewportSubrect{ .offset[ 0u, 0u ], .size= size }, num_parts, subrects );
	return subrects;
}

fn SplitViewportSubrect_r( ViewportSubrect& subrect, u32 num_parts, ust::vector</ ViewportSubrect /> &mut out_subrects )
{
	debug_assert( num_parts > 0u );
	debug_assert( subrect.size[0] > 0u );
	debug_assert( subrect.size[1] > 0u );

	if( num_parts == 1u )
	{
		out_subrects.push_back( subrect );
		return;
	}

	var u32 num_parts0= num_parts / 2u;
	var u32 num_parts1= num_parts - num_parts0;

	if( subrect.size[0] > subrect.size[1] )
	{
		// TODO - consider rounding sizes so that they are divisible by 8.
		var u32 size0= subrect.size[0] * num_parts0 / num_parts;
		var u32 size1= subrect.size[0] - size0;

		SplitViewportSubrect_r(
			ViewportSubrect
			{
				.offset[ subrect.offset[0], subrect.offset[1] ],
				.size[ size0, subrect.size[1] ],
			},
			num_parts0,
			out_subrects );

		SplitViewportSubrect_r(
			ViewportSubrect
			{
				.offset[ subrect.offset[0] + size0, subrect.offset[1] ],
				.size[ size1, subrect.size[1] ],
			},
			num_parts1,
			out_subrects );
	}
	else
	{
		// TODO - consider rounding sizes so that they are divisible by 8.
		var u32 size0= subrect.size[1] * num_parts0 / num_parts;
		var u32 size1= subrect.size[1] - size0;

		SplitViewportSubrect_r(
			ViewportSubrect
			{
				.offset[ subrect.offset[0], subrect.offset[1] ],
				.size[ subrect.size[0], size0 ],
			},
			num_parts0,
			out_subrects );

		SplitViewportSubrect_r(
			ViewportSubrect
			{
				.offset[ subrect.offset[0], subrect.offset[1] + size0 ],
				.size[ subrect.size[0], size1 ],
			},
			num_parts1,
			out_subrects );
	}
}

} // namespace PM
