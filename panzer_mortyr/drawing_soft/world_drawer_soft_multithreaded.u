import "caustics.iu"
import "world_drawer_soft_multithreaded.iu"

namespace PM
{

fn WorldDrawerSoftMultithreaded::constructor(
	ust::shared_ptr_mut</WindowSoft/> mut window,
	SettingsImutPtr mut settings,
	CachingGameResourcesLoaderPtr mut caching_game_resources_loader,
	ConsoleOutPtr mut console_out )
	(
		settings_= settings,
		window_= move(window),
		game_params_=
			lambda[&]() : GameResourcePtr</GameParams/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadGameParams();
			}(),
		maps_description_=
			lambda[&]() : GameResourcePtr</MapsDescription/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadMapsDescription();
			}(),
		materials_description_=
			lambda[&]() : GameResourcePtr</MaterialsDescription/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadMaterialsDescription();
			}(),
		billboards_description_=
			WorldDrawerSoftInternal::LoadBillboardsDescription(
				caching_game_resources_loader.lock_imut().deref().GetGameFilesystem(), console_out ),
		caching_game_resources_loader_ptr_= move(caching_game_resources_loader),
		drawer_internal_( settings ),
		console_out_= move(console_out),
		map_index_= 0u,
		caustics_texture_= CreateCausticsTexture(),
		interpolated_caustics_layer_= zero_init,
	)
{}

fn WorldDrawerSoftMultithreaded::Draw( mut this, WorldDrawingInfo& drawing_info ) : WorldDrawingStats
{
	// Load models in use if switching to a new map.
	var bool need_loading_models= map_index_ != drawing_info.map_index;

	// Ensure we have actual map data.
	SetMap( drawing_info.map_index );

	if( need_loading_models && !map_data_.empty() )
	{
		// Load models in use if switching to a new map.
		WorldDrawerSoftInternal::LoadModels(
			drawing_info.used_models,
			caching_game_resources_loader_ptr_.lock_imut().deref().GetGameFilesystem(),
			console_out_,
			map_data_.try_deref()[0].map_draw_data.deref().textures,
			models_ );
	}

	if( map_data_.empty() )
	{
		return ust::make_zeroed</WorldDrawingStats/>();
	}

	auto mut window_lock= window_.lock_mut();

	var MapsDescription::MapDescription& map_description= maps_description_.deref().maps[ size_type( map_index_ ) ];

	var MaterialsDescription::Block& materials_block=
		materials_description_.deref().blocks[ map_description.materials_block ]; // Halts if not found.

	auto &mut map_data_tuple= map_data_.try_deref();

	var MapFullDrawDataSoft &mut map_data_full= map_data_tuple[0];

	// Perform per-frame calculations independent on view point.
	// TODO - move this code into a common place.
	{
		var MapDrawDataSoft& map_data= map_data_full.map_draw_data.deref();

		var ust::array_view_mut</bool/> highlighted_cluster_flags= map_data_full.highlighted_cluster_flags;

		foreach( &mut flag : highlighted_cluster_flags )
		{
			flag= false;
		}

		foreach( cluster_index : drawing_info.highlighted_cluster_indices )
		{
			if( size_type( cluster_index ) < highlighted_cluster_flags.size() )
			{
				highlighted_cluster_flags[ size_type( cluster_index ) ]= true;
			}
		}

		var TexturesWithAppliedCaustics &mut textures_with_applied_caustics=
				map_data_full.textures_with_applied_caustics;

		if( settings_.lock_imut().deref().r_caustics_enabled && !textures_with_applied_caustics.empty() )
		{
			// Just update all textures affected by caustics each frame.
			// We have not so many of such textures (no more than 10) and code doing so is pretty-fast.

			FetchInterpolatedCausticsTextureLayer(
				caustics_texture_, drawing_info.game_time_s, interpolated_caustics_layer_ );

			// Just update all textures affected by caustics each frame.
			// We have not so many of such textures (no more than 10) and code doing so is pretty-fast.

			foreach( pair : textures_with_applied_caustics )
			{
				var Color32WorldTextureWithMips& src_texture= map_data.textures[ size_type( pair.key() ) ];
				var Color32WorldTextureWithMips &mut dst_texture= pair.value().deref();
				ApplyCausticsTexture( interpolated_caustics_layer_, src_texture[0], dst_texture );
			}
		}
	}

	return
		drawer_internal_.Draw(
		window_lock.deref().GetSurface(),
		game_params_.deref(),
		billboards_description_,
		map_description,
		materials_block,
		map_data_full,
		map_data_tuple[1],
		models_,
		drawing_info );
}

fn WorldDrawerSoftMultithreaded::SetMap( mut this, u32 map_index )
{
	// Check if we need to reload map first.
	if( map_index == map_index_ )
	{
		return;
	}
	// Need to load map data.

	// Set map index in any case - it may be necessary in order to avoid reloading map data constantly if failed to load it once.
	map_index_= map_index;

	// Reset previous map data first - to free used memory before allocating new memory for new map.
	map_data_.reset();

	if( map_index == 0u )
	{
		ConsoleOutAddTextLine( console_out_, "Can't load map 0!" );
		return;
	}

	auto mut lock= caching_game_resources_loader_ptr_.lock_mut();
	var CachingGameResourcesLoader &mut caching_game_resources_loader= lock.deref();

	var ust::shared_ptr_mt_final_nullable</ MapDrawDataSoft /> map_draw_data_nullable_ptr=
		WorldDrawerSoftInternal::LoadMap(
			caching_game_resources_loader,
			console_out_,
			game_params_.deref(),
			maps_description_.deref(),
			materials_description_.deref(),
			billboards_description_,
			map_index );

	if( !map_draw_data_nullable_ptr.empty() )
	{
		var ust::shared_ptr_mt_final</ MapDrawDataSoft /> map_draw_data_ptr=
			map_draw_data_nullable_ptr.try_to_non_nullable();

		var ust::shared_ptr_mt_final</RoomClustersBSPTree/>& room_clusters_bsp_tree=
			map_draw_data_ptr.deref().room_clusters_bsp_tree;

		map_data_=
			ust::make_tuple(
				WorldDrawerSoftInternal::CreateMapFullData( map_draw_data_ptr ),
				ust::make_array(
					MapVisibilityCalculator( room_clusters_bsp_tree ),
					MapVisibilityCalculator( room_clusters_bsp_tree ) ) );
	}
}

} // namespace PM
