import "/thread.iu"
import "../loading_screen.iu"
import "drawers_factory_soft.iu"
import "hud_drawer_soft.iu"
import "image_drawer_soft.iu"
import "text_drawer_soft.iu"
import "video_player_soft.iu"
import "window_soft.iu"
import "world_drawer_soft_multithreaded.iu"
import "world_drawer_soft_singlethreaded.iu"

namespace PM
{

fn CreateDrawersSoft(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : ust::optional</ AbstractDrawers />
{
	var GameFilesystemPtr game_filesystem= caching_game_resources_loader.lock_imut().deref().GetGameFilesystem();

	var ust::optional</ WindowSoft /> mut window_opt= WindowSoft::Create( settings, console_out );
	if( window_opt.empty() )
	{
		return ust::null_optional;
	}

	auto mut window= ust::make_shared_ptr( window_opt.try_take() );

	auto mut image_drawer= ust::make_box( ImageDrawerSoft( window, game_filesystem, console_out ) );

	// Draw loading screen as soon as possible.
	DrawLoadingScreen( window, image_drawer.deref() );

	return AbstractDrawers
	{
		.image_drawer= move( image_drawer ),
		.hud_drawer= ust::make_box( HudDrawerSoft( window, game_filesystem, console_out ) ),
		.text_drawer= ust::make_box( TextDrawerSoft( window, game_filesystem, console_out ) ),
		.world_drawer= CreateWorldDrawer( window, settings, caching_game_resources_loader, console_out ),
		.video_player= ust::make_box( VideoPlayerSoft( window, console_out ) ),
		.window= move(window),
	};
}

fn CreateWorldDrawer(
	ust::shared_ptr_mut</WindowSoft/> mut window,
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : ust::box</ AbstractWorldDrawer />
{
	var u32 num_cpus= ust::get_number_of_available_cpus();

	ConsoleOutAddTextLine( console_out, ust::concat( "Has ", ust::to_string8( num_cpus ), " available CPUs." ) );

	var u32 num_threads_setting= settings.lock_imut().deref().r_software_mode_num_threads;

	var u32 num_threads=
		ust::min(
			( num_threads_setting == 0u
				? u32( num_cpus )
				// Don't allow selecting more than double number of available CPUs.
				: ust::min( num_threads_setting, num_cpus * 2u ) ),
			32u /* It seems that more than 32 threads aren't needed. */ );

	if( num_threads <= 1u )
	{
		ConsoleOutAddTextLine( console_out, ust::concat( "Use single world drawing thread." ) );

		return ust::make_box(
			WorldDrawerSoftSinglethreaded( move(window), settings, caching_game_resources_loader, console_out ) );
	}

	ConsoleOutAddTextLine(
		console_out, ust::concat( "Use ", ust::to_string8( num_threads ), " world drawing threads." ) );

	return
		ust::make_box(
			WorldDrawerSoftMultithreaded(
				move(window), settings, caching_game_resources_loader, console_out, num_threads ) );
}

} // namespace PM
