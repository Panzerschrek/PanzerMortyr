import "../loading_screen.iu"
import "drawers_factory_soft.iu"
import "hud_drawer_soft.iu"
import "image_drawer_soft.iu"
import "text_drawer_soft.iu"
import "video_player_soft.iu"
import "window_soft.iu"
import "world_drawer_soft.iu"

namespace PM
{

fn CreateDrawersSoft(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : AbstractDrawers
{
	var GameFilesystemPtr game_filesystem= caching_game_resources_loader.lock_imut().deref().GetGameFilesystem();

	auto mut window= ust::make_shared_ptr( WindowSoft( settings, console_out ) );

	auto mut image_drawer= ust::make_box( ImageDrawerSoft( window, game_filesystem ) );

	// Draw loading screen as soon as possible.
	DrawLoadingScreen( window, image_drawer.deref() );

	return AbstractDrawers
	{
		.image_drawer= move( image_drawer ),
		.hud_drawer= ust::make_box( HudDrawerSoft( window ) ),
		.text_drawer= ust::make_box( TextDrawerSoft( window, game_filesystem, console_out ) ),
		.world_drawer= ust::make_box( WorldDrawerSoft( window ) ),
		.video_player= ust::make_box( VideoPlayerSoft() ),
		.window= move(window),
	};
}

} // namespace PM
