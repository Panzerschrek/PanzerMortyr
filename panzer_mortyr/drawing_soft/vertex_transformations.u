import "/assert.iu"
import "../fog.iu"
import "vertex_transformations.iu"

namespace PM
{

fn EnsureTransformedVerticesCapacity( ust::vector</Vec3f/> &mut transformed_vertices, size_type capacity )
	: ust::array_view_mut</ Vec3f /> @( ust::reference_notation::return_inner_references::param0 )
{
	if( transformed_vertices.size() < capacity )
	{
		// Resize only up.
		transformed_vertices.resize( capacity, Vec3f::MakeZero() );
	}
	return transformed_vertices.range().subrange_end( capacity );
}

fn EnsureVertexLightsCapacity( ust::vector</ VertexLightWithFog /> &mut vertex_lights, size_type capacity )
	: ust::array_view_mut</ VertexLightWithFog /> @( ust::reference_notation::return_inner_references::param0 )
{
	if( vertex_lights.size() < capacity )
	{
		// Resize only up.
		vertex_lights.resize( capacity, ust::make_zeroed</ VertexLightWithFog />() );
	}
	return vertex_lights.range().subrange_end( capacity );
}

fn TransformMapVertices(
	ust::array_view_imut</ MapVertex /> vertices,
	ust::array_view_mut</ Vec3f /> vertices_transformed,
	Mat4f& matrix )
{
	debug_assert( vertices.size() == vertices_transformed.size() );

	var Mat4f m= matrix; // Read it into a local variable to ensure it's not re-read on each loop iteration.

	foreach( pair : vertices_transformed.iter().zip( vertices.iter() ) )
	{
		// TODO - try speeding-up this code. Make sure the compiler uses vectorization for it.
		pair.first= Vec3f( pair.second.position ) * m;
	}
}

fn CalculateLightForMapVertices(
	ust::array_view_imut</ MapVertex /> vertices,
	ust::array_view_mut</ VertexLightWithFog /> vertex_lights,
	ust::array_view_imut</ DynamicLightSourceSoft /> dynamic_light_sources )
{
	debug_assert( vertices.size() == vertex_lights.size() );

	// Take static light (stored for each vertex).
	foreach( pair : vertex_lights.iter().zip( vertices.iter() ) )
	{
		pair.first=
			ust::make_array(
				f32( pair.second.light[0] ) * ( 1.0f / 255.0f ),
				f32( pair.second.light[1] ) * ( 1.0f / 255.0f ),
				f32( pair.second.light[2] ) * ( 1.0f / 255.0f ),
				0.0f /* set fog density to zero */ );
	}

	// Add light from dynamic light sources.
	foreach( &light_source : dynamic_light_sources )
	{
		// Read it into a local variable to ensure it's not re-read on each loop iteration.
		var DynamicLightSourceSoft l= light_source;

		foreach( pair : vertex_lights.iter().zip( vertices.iter() ) )
		{
			var [ f32, 3 ] light= l.CalculateLightForPoint( Vec3f( pair.second.position ) );
			pair.first[0]+= light[0];
			pair.first[1]+= light[1];
			pair.first[2]+= light[2];
		}
	}
}

fn CalculateFogDensityForMapVertices(
	ust::array_view_imut</ MapVertex /> vertices,
	ust::array_view_mut</ VertexLightWithFog /> vertex_lights,
	Vec3f& camera_position )
{
	var Vec3f c= camera_position; // Read it into a local variable to ensure it's not re-read on each loop iteration.

	foreach( pair : vertex_lights.iter().zip( vertices.iter() ) )
	{
		var f32 one_minus_fog_density= CalculateOneMinusFogDensity( ( c - Vec3f( pair.second.position ) ).Length() );
		pair.first[0]*= one_minus_fog_density;
		pair.first[1]*= one_minus_fog_density;
		pair.first[2]*= one_minus_fog_density;
		pair.first[3]= 1.0f - one_minus_fog_density;
	}
}

fn TransformModelVerticesSingleFrame(
	ust::array_view_imut</ ModelFrameVertex /> frame_vertices,
	ust::array_view_mut</Vec3f/> vertices_transformed,
	Mat4f& model_full_matrix  )
{
	debug_assert( vertices_transformed.size() >= frame_vertices.size() );

	var Mat4f m= model_full_matrix; // Read it into a local variable to ensure it's not re-read on each loop iteration.

	foreach( pair : vertices_transformed.iter().zip( frame_vertices.iter() ) )
	{
		// TODO - try speeding-up this code. Make sure the compiler uses vectorization for it.
		pair.first= Vec3f( pair.second.position ) * m;
	}
}

fn TransformModelVerticesTwoFrames(
	ust::array_view_imut</ ModelFrameVertex /> frame0_vertices,
	ust::array_view_imut</ ModelFrameVertex /> frame1_vertices,
	ust::array_view_mut</Vec3f/> vertices_transformed,
	f32 frame_mix,
	Mat4f& model_full_matrix )
{
	debug_assert( frame0_vertices.size() == frame1_vertices.size() );
	debug_assert( vertices_transformed.size() >= frame0_vertices.size() );

	// Optimization for cases where no interpolation between frames is needed.
	if( frame_mix <= 0.001f )
	{
		return TransformModelVerticesSingleFrame( frame0_vertices, vertices_transformed, model_full_matrix );
	}
	if( frame_mix >= 0.999f )
	{
		return TransformModelVerticesSingleFrame( frame1_vertices, vertices_transformed, model_full_matrix );
	}

	var Mat4f m= model_full_matrix; // Read it into a local variable to ensure it's not re-read on each loop iteration.

	foreach( pair : vertices_transformed.iter().zip( frame0_vertices.iter().zip( frame1_vertices.iter() ) ) )
	{
		var Vec3f position=
			Vec3f( pair.second.first .position ) * ( 1.0f - frame_mix ) +
			Vec3f( pair.second.second.position ) * frame_mix;

		// TODO - try speeding-up this code. Make sure the compiler uses vectorization for it.
		pair.first= position * m;
	}
}

fn ApplyLightToModelVerticesSingleFrame(
	ust::array_view_imut</ ModelFrameVertex /> frame_vertices,
	ust::array_view_mut</ VertexLightWithFog /> vertex_lights,
	SphericalHarmonicsRGB& light )
{
	debug_assert( vertex_lights.size() >= frame_vertices.size() );

	 // Read it into a local variable to ensure it's not re-read on each loop iteration.
	var SphericalHarmonicsRGB l= light;

	var f32 constexpr normal_scale= 1.0f / 128.0f;

	foreach( pair : vertex_lights.iter().zip( frame_vertices.iter() ) )
	{
		// TODO - optimize this code, make sure vector instructions are used.

		// Since input normals are already normalized and no mixing is performed, renormalization isn't necessary.
		var [ i8, 3 ]& n= pair.second.normal;
		var Vec3f normal_normalized( f32(n[0]) * normal_scale, f32(n[1]) * normal_scale, f32(n[2]) * normal_scale );

		pair.first=
			ust::make_array(
				l[0].directional_components.Dot( normal_normalized ) + l[0].constant_component,
				l[1].directional_components.Dot( normal_normalized ) + l[1].constant_component,
				l[2].directional_components.Dot( normal_normalized ) + l[2].constant_component,
				0.0f /* set fog density to zero */ );
	}
}

fn ApplyLightToModelVerticesTwoFrames(
	ust::array_view_imut</ ModelFrameVertex /> frame0_vertices,
	ust::array_view_imut</ ModelFrameVertex /> frame1_vertices,
	ust::array_view_mut</ VertexLightWithFog /> vertex_lights,
	f32 frame_mix,
	SphericalHarmonicsRGB& light )
{
	debug_assert( frame0_vertices.size() == frame1_vertices.size() );
	debug_assert( vertex_lights.size() >= frame0_vertices.size() );

	// Optimization for cases where no interpolation between frames is needed.
	if( frame_mix <= 0.001f )
	{
		return ApplyLightToModelVerticesSingleFrame( frame0_vertices, vertex_lights, light );
	}
	if( frame_mix >= 0.999f )
	{
		return ApplyLightToModelVerticesSingleFrame( frame1_vertices, vertex_lights, light );
	}

	var f32 scale0= 1.0f - frame_mix;
	var f32 scale1= frame_mix;

	 // Read it into a local variable to ensure it's not re-read on each loop iteration.
	var SphericalHarmonicsRGB l= light;

	foreach( pair : vertex_lights.iter().zip( frame0_vertices.iter().zip( frame1_vertices.iter() ) ) )
	{
		// TODO - optimize this code, make sure vector instructions are used.
		var [ i8, 3 ]& n0= pair.second.first .normal;
		var [ i8, 3 ]& n1= pair.second.second.normal;

		var Vec3f normal=
			Vec3f( f32( n0[0] ), f32( n0[1] ), f32( n0[2] ) ) * scale0 +
			Vec3f( f32( n1[0] ), f32( n1[1] ), f32( n1[2] ) ) * scale1;

		// Perform normalization, since mixing may produce non-normalized normals.
		// TODO - try speed-up normalization, like by using fast inverse square root.
		var Vec3f normal_normalized= normal / ust::max( 1.0f / 1024.0f, normal.Length() );

		pair.first=
			ust::make_array(
				l[0].directional_components.Dot( normal_normalized ) + l[0].constant_component,
				l[1].directional_components.Dot( normal_normalized ) + l[1].constant_component,
				l[2].directional_components.Dot( normal_normalized ) + l[2].constant_component,
				0.0f /* set fog density to zero */ );
	}
}

fn CalculateFogDensityForModelVerticesSingleFrame(
	ust::array_view_imut</ ModelFrameVertex /> frame_vertices,
	ust::array_view_mut</ VertexLightWithFog /> vertex_lights,
	Mat4f& matrix )
{
	debug_assert( vertex_lights.size() >= frame_vertices.size() );

	// Read it into a local variable to ensure it's not re-read on each loop iteration.
	var Mat4f m= matrix;

	foreach( pair : vertex_lights.iter().zip( frame_vertices.iter() ) )
	{
		// TODO - optimize this code, make sure vector instructions are used.
		var Vec3f position_transformed= Vec3f( pair.second.position ) * m;

		var f32 one_minus_fog_density= CalculateOneMinusFogDensity( position_transformed.Length() );
		pair.first[0]*= one_minus_fog_density;
		pair.first[1]*= one_minus_fog_density;
		pair.first[2]*= one_minus_fog_density;
		pair.first[3]= 1.0f - one_minus_fog_density;
	}
}

fn CalculateFogDensityForModelVerticesTwoFrames(
	ust::array_view_imut</ ModelFrameVertex /> frame0_vertices,
	ust::array_view_imut</ ModelFrameVertex /> frame1_vertices,
	ust::array_view_mut</ VertexLightWithFog /> vertex_lights,
	f32 frame_mix,
	Mat4f& matrix )
{
	debug_assert( frame0_vertices.size() == frame1_vertices.size() );
	debug_assert( vertex_lights.size() >= frame0_vertices.size() );

	// Optimization for cases where no interpolation between frames is needed.
	if( frame_mix <= 0.001f )
	{
		return CalculateFogDensityForModelVerticesSingleFrame( frame0_vertices, vertex_lights, matrix );
	}
	if( frame_mix >= 0.999f )
	{
		return CalculateFogDensityForModelVerticesSingleFrame( frame1_vertices, vertex_lights, matrix );
	}

	var f32 scale0= 1.0f - frame_mix;
	var f32 scale1= frame_mix;

	// Read it into a local variable to ensure it's not re-read on each loop iteration.
	var Mat4f m= matrix;

	foreach( pair : vertex_lights.iter().zip( frame0_vertices.iter().zip( frame1_vertices.iter() ) ) )
	{
		// TODO - optimize this code, make sure vector instructions are used.

		var [ f32, 3 ]& p0= pair.second.first .position;
		var [ f32, 3 ]& p1= pair.second.second.position;

		var Vec3f position= Vec3f( p0 ) * scale0 + Vec3f( p1 ) * scale1;

		var Vec3f position_transformed= position * m;

		var f32 one_minus_fog_density= CalculateOneMinusFogDensity( position_transformed.Length() );
		pair.first[0]*= one_minus_fog_density;
		pair.first[1]*= one_minus_fog_density;
		pair.first[2]*= one_minus_fog_density;
		pair.first[3]= 1.0f - one_minus_fog_density;
	}
}

} // namespace PM
