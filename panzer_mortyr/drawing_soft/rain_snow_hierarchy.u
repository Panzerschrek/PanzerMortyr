import "../bounding_boxes_hierarchy_building.iu"
import "../precipitation_constants.iu"
import "rain_snow_hierarchy.iu"

namespace PM
{

fn BuildRainSnowHierarchy( ust::array_view_imut</ZmapLamRainDroplet/> rain_droplets ) : RainSnowHierarchy
{
	var ust::vector</RainSnowParticleInHierarchy/> mut particles=
		ust::make_vector_from_mapped_range(
			rain_droplets,
			lambda( ZmapLamRainDroplet& rain_droplet ) : RainSnowParticleInHierarchy
			{
				return
					RainSnowParticleInHierarchy
					{
						.position( rain_droplet.position ),
						.max_movement_distance( rain_droplet.travel_distance ),
						// Calculate normalized distance phase.
						// It's needed to distribute rain droplets along the whole path (with maximum length).
						.movement_distance_phase(
							65536.0f * f32( rain_droplet.movement_phase ) / rain_droplet.travel_distance ),
					};
			} );

	var size_type max_particles_in_node= 10s;

	return
		BuildBoundingBoxesHierarchy( particles.range(), max_particles_in_node, GetBBoxForRainSnowParticleInHierarchy );
}

fn GetBBoxForRainSnowParticleInHierarchy( RainSnowParticleInHierarchy& p ) : BBox3f
{
	// Create a bounding enclosing the whole path of a rain/snow particle.

	var Vec3f position0= p.position;
	var Vec3f position1= p.position + Vec3f( PrecipitationConstants::move_vector ) * f32( p.max_movement_distance );

	return BBox3f
	{
		.min(
			ust::min( position0.x, position1.x ),
			ust::min( position0.y, position1.y ),
			ust::min( position0.z, position1.z ) ),
		.max(
			ust::max( position0.x, position1.x ),
			ust::max( position0.y, position1.y ),
			ust::max( position0.z, position1.z ) ),
	};
}

} // namespace PM
