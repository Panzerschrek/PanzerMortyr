import "../model_common.iu"
import "model_soft.iu"

namespace PM
{

fn CreateModelSoft( ModelData& model_data ) : ModelSoft
{
	var size_type num_lod0_triangles( model_data.num_lod0_triangles );

	// Assume here that we have at least one texture. If we have more than one - don't care.
	var ModelSoft::Texture mut texture= CreateModelTexture( model_data.texture_collections.back().hd_textures[0] );

	return ModelSoft
	{
		.num_vertices( model_data.num_vertices ),
		.num_triangles( model_data.num_lod0_triangles ),
		.num_frames( model_data.num_frames ),
		.triangles=
			ust::make_vector_from_mapped_range(
				model_data.triangles.range().subrange_end( num_lod0_triangles ),
				lambda ( ObbTriangle& t ) : [ u16, 3 ]
				{
					// Original indices are multiplied by 2, divide them back.
					return ust::make_array( u16( t[0] >> 1 ), u16( t[1] >> 1 ), u16( t[2] >> 1 ) );
				} ),
		.texture_coordinates= PrepareModelTextureCoordinates( model_data.texture_coordinates, texture ),
		.vertices= CreateModelFrameVertices( model_data ),
		.frame_bboxes= CalculateModelFrameBBoxes( model_data ),
		.texture= move(texture),
	};
}

fn CreateModelTexture( ModelData::TextureData& texture_data ) : ModelSoft::Texture
{
	// All used models in the original game use textures with sizes 64x64, 128x128 or 256x256.

	if( texture_data.size[0] <= 64u && texture_data.size[1] <= 64u )
	{
		auto mut out_texture_ptr= ust::make_box( ust::make_zeroed</ModelSoft::Texture64WithMips/>() );

		{
			auto &mut out_texture= out_texture_ptr.deref();
			PrepareModelTextureMip0( out_texture[0], texture_data );
			BuildTextureMip( out_texture[1], out_texture[0] );
			BuildTextureMip( out_texture[2], out_texture[1] );
			BuildTextureMip( out_texture[3], out_texture[2] );
			BuildTextureMip( out_texture[4], out_texture[3] );
			BuildTextureMip( out_texture[5], out_texture[4] );
			BuildTextureMip( out_texture[6], out_texture[5] );
		}

		return out_texture_ptr;
	}
	else if( texture_data.size[0] <= 128u && texture_data.size[1] <= 128u )
	{
		auto mut out_texture_ptr= ust::make_box( ust::make_zeroed</ModelSoft::Texture128WithMips/>() );

		{
			auto &mut out_texture= out_texture_ptr.deref();
			PrepareModelTextureMip0( out_texture[0], texture_data );
			BuildTextureMip( out_texture[1], out_texture[0] );
			BuildTextureMip( out_texture[2], out_texture[1] );
			BuildTextureMip( out_texture[3], out_texture[2] );
			BuildTextureMip( out_texture[4], out_texture[3] );
			BuildTextureMip( out_texture[5], out_texture[4] );
			BuildTextureMip( out_texture[6], out_texture[5] );
			BuildTextureMip( out_texture[7], out_texture[6] );
		}

		return out_texture_ptr;
	}
	else
	{
		auto mut out_texture_ptr= ust::make_box( ust::make_zeroed</ModelSoft::Texture256WithMips/>() );

		{
			auto &mut out_texture= out_texture_ptr.deref();
			PrepareModelTextureMip0( out_texture[0], texture_data );
			BuildTextureMip( out_texture[1], out_texture[0] );
			BuildTextureMip( out_texture[2], out_texture[1] );
			BuildTextureMip( out_texture[3], out_texture[2] );
			BuildTextureMip( out_texture[4], out_texture[3] );
			BuildTextureMip( out_texture[5], out_texture[4] );
			BuildTextureMip( out_texture[6], out_texture[5] );
			BuildTextureMip( out_texture[7], out_texture[6] );
			BuildTextureMip( out_texture[8], out_texture[7] );
		}

		return out_texture_ptr;
	}
}

template</ size_type dst_size />
fn PrepareModelTextureMip0( [ [ Color32, dst_size ], dst_size ] &mut dst, ModelData::TextureData& src )
{
	auto& p= src.palette;

	if( size_type( src.size[0] ) == dst_size && size_type( src.size[1] ) == dst_size )
	{
		// Special case - source and destination have equal size. Use faster approach for it.

		for( auto mut y= 0s; y < dst_size; ++y )
		{
			var [ Color32, dst_size ] &mut dst_line= dst[ y ];

			auto src_line= src.pixels_data.range().subrange(
				y * size_type( src.size[0] ), ( y + 1s ) * size_type( src.size[1] ) );

			foreach( pair : ust::array_view_mut</Color32/>( dst_line ).iter().zip( src_line.iter() ) )
			{
				var size_type i( pair.second );

				pair.first=
					Color32FromComponents(
						ust::make_array( p[ i * 3s + 2s ], p[ i * 3s + 1s ], p[ i * 3s + 0s ], 255u8  ) );
			}
		}
	}
	else
	{
		// General case with necessity of resize. Use just resize with nearest filter.

		for( auto mut dst_y= 0s; dst_y < dst_size; ++dst_y )
		{
			var [ Color32, dst_size ] &mut dst_line= dst[ dst_y ];

			var u32 src_y= u32(dst_y) * src.size[1] / u32( dst_size );

			auto src_line= src.pixels_data.range().subrange(
				size_type( src_y * src.size[0] ), size_type( ( src_y + 1u ) * src.size[1] ) );

			for( auto mut dst_x= 0s; dst_x < dst_size; ++dst_x )
			{
				var u32 src_x= u32(dst_x) * src.size[0] / u32( dst_size );

				var size_type i( src_line[ size_type( src_x ) ] );

				dst_line[ dst_x ]=
					Color32FromComponents(
						ust::make_array( p[ i * 3s + 2s ], p[ i * 3s + 1s ], p[ i * 3s + 0s ], 255u8  ) );
			}
		}
	}
}

// Maps normalized texture coordinates to pixel-sized texture coorindates.
// Also adds a bias so that texture coordinates are as close as possible to zero, but are non-negative.
fn PrepareModelTextureCoordinates(
	ust::array_view_imut</ObbVertexTextureCoordinates/> in_texture_coordinates,
	ModelSoft::Texture& texture ) : ust::vector</Vec2f/>
{
	var ust::vector</Vec2f/> mut out_texture_coordinates=
		ust::make_vector_from_mapped_range(
			in_texture_coordinates,
			lambda( ObbVertexTextureCoordinates& t ) : Vec2f
			{
				return Vec2f( t );
			} );

	var Vec2f mut min_tc( ust::plus_inf</f32/>(), ust::plus_inf</f32/>() );

	foreach( &tc : out_texture_coordinates )
	{
		ust::min_assign( min_tc.x, tc.x );
		ust::min_assign( min_tc.y, tc.y );
	}

	var Vec2f mut texture_size= Vec2f::MakeZero();
	variant_visit( &texture_ptr : texture )
	{
		auto& mip0_typeinfo= typeinfo</ typeof( texture_ptr.deref() ) />.elements_list[0].type;
		texture_size.x= f32( mip0_typeinfo.element_type.element_count );
		texture_size.y= f32( mip0_typeinfo.element_count );
	}

	var Vec2f tc_bias( ust::floor( min_tc.x ) * ( - texture_size.x ), ust::floor( min_tc.y ) * ( - texture_size.y ) );

	foreach( &mut tc : out_texture_coordinates )
	{
		tc.x= ust::fma( tc.x, texture_size.x, tc_bias.x );
		tc.y= ust::fma( tc.y, texture_size.y, tc_bias.y );
	}

	return out_texture_coordinates;
}

} // namespace PM
