import "/sort.iu"
import "/sdl/sdl_with_opengl.iu"
import "display_modes.iu"

namespace PM
{

fn GetDisplayModesForAllDisplays() : PerDisplayModes
{
	var PerDisplayModes mut per_display_video_modes;

	var i32 num_displays= unsafe( SDL_GetNumVideoDisplays() );
	if( num_displays > 0 )
	{
		per_display_video_modes.resize( size_type( num_displays ) );

		var SDL_DisplayMode mut mode= zero_init;

		for( auto mut display_index= 0; display_index < num_displays; ++display_index )
		{
			var DisplayModes &mut display_modes= per_display_video_modes[ size_type( display_index ) ];

			var i32 num_modes= unsafe( SDL_GetNumDisplayModes( display_index ) );

			for( auto mut mode_index= 0; mode_index < num_modes; ++mode_index )
			{
				if( unsafe( SDL_GetDisplayMode( display_index, mode_index, $<( mode ) ) ) == 0 )
				{
					if( mode.w > 0 & mode.h > 0 )
					{
						display_modes.push_back( ust::make_array( u32( mode.w ), u32( mode.h ) ) );
					}
				}
			}

			ust::sort(
				display_modes.range(),
				lambda( [ u32, 2 ]& l, [ u32, 2 ]& r ) : bool
				{
					if( l[0] != r[0] ){ return l[0] < r[0]; }
					return l[1] < r[1];
				} );

			display_modes.remove_adjacent_duplicates();
		}
	}

	return per_display_video_modes;
}

} // namespace PM
