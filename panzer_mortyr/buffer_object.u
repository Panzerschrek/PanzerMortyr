import "buffer_object.iu"
import "gl_functions.iu"

namespace PM
{

fn BufferObject::CreateStaticDrawBuffer( GLenum target, ust::array_view_imut</byte8/> data ) : BufferObject
{
	unsafe
	{
		var GLuint mut buffer_object= zero_init;
		glGenBuffers( 1, $<( buffer_object ) );

		glBindBuffer( target, buffer_object );

		glBufferData( target, GLsizeiptr( data.size() ), data.data(), GLenum( GL_STATIC_DRAW ) );

		return BufferObject( buffer_object, target );
	}
}

fn BufferObject::CreateDynamicDrawBuffer( GLenum target, ust::array_view_imut</byte8/> data ) : BufferObject
{
	unsafe
	{
		var GLuint mut buffer_object= zero_init;
		glGenBuffers( 1, $<( buffer_object ) );

		glBindBuffer( target, buffer_object );

		glBufferData( target, GLsizeiptr( data.size() ), data.data(), GLenum( GL_DYNAMIC_DRAW ) );

		return BufferObject( buffer_object, target );
	}
}

fn BufferObject::CreateUninitializedDynamicDrawBuffer( GLenum target, size_type size ) : BufferObject
{
	unsafe
	{
		var GLuint mut buffer_object= zero_init;
		glGenBuffers( 1, $<( buffer_object ) );

		glBindBuffer( target, buffer_object );

		glBufferData( target, GLsizeiptr( size ), ust::nullptr</byte8/>(), GLenum( GL_DYNAMIC_DRAW ) );

		return BufferObject( buffer_object, target );
	}
}

fn BufferObject::constructor( GLuint buffer_object, GLenum target ) unsafe
	( buffer_object_= buffer_object, target_= target )
{}

fn BufferObject::destructor()
{
	unsafe( glDeleteBuffers( 1, $<( cast_mut(buffer_object_) ) ) );
}

fn BufferObject::Bind( this )
{
	unsafe( glBindBuffer( target_, buffer_object_ ) );
}

} // namespace PM
