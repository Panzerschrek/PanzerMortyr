import "caching_game_resources_loader.iu"
import "game_things_container.iu"
import "quads_hierarchy.iu"
import "random.iu"
import "room_clusters_hierarchy.iu"
import "vec.iu"

namespace PM
{

// This struct encapsulates all game state.
// Savegame files should store contents of this struct and (almost) nothing else.
struct GameState
{
	u32 imut skill;

	// Each step this number is increased by one.
	u32 step_index;

	PseudoRandomGenerator random;

	PlayerState player;

	// Store optionals here. It's needed if an entity should be fully killed without affecting indices stability.
	// Entities should not be removed from this cotainer, they can be only appeded or emptied.
	// All map entities are mapped to this container 1 to 1 so that original indices are matching.
	ust::vector</ ust::optional</EntityState/> /> entities;

	// Compact vector (with no gaps) of all colliders.
	// Entities hold an index into this container.
	// When a collider is removed, these indices are corrected.
	ust::vector</Collider/> colliders;

	ProjectilesContainer projectiles;

	// Collect projectile hit event within a single step for processing them later.
	// This container is cleared each step.
	ust::vector</ProjectileHitEvent/> projectile_hit_events;

	ProjectileHitSmokeEmittersContainer projectile_hit_smoke_emitters;

	ProjectileHitSmokeParticlesContainer projectile_hit_smoke_particles;

	BreakingGlassEffectsContainer breaking_glass_effects;

	DamagingFlamesContainer damaging_flames;

	MuzzleFlashesContainer muzzle_flashes;

	ExplosionParticlesContainer explosion_particles;

	FlameParticlesContainer flame_particles;

	SmokeParticlesContainer smoke_particles;

	// Maybe even use fixed-size container?
	ust::vector</SmokeTrailParticle/> smoke_trail_particles;

	// Store colliders separate from dynamic clusters state - to speed-up physics code.
	// Both these containers have identical size and elements in them are mapped to each other 1 to 1.
	ust::vector</DynamicClusterState/> dynamic_clusters;
	ust::vector</DynamicClusterCollider/> dynamic_cluster_colliders;
}

// Use specially-designed container with fixed capacity for many game things.
// For each case capacity tuned to serve needs in almost most extreme cases.
// Generally more capacity is needed for longer living things and less capacity is needed for rare short-lived ones.
type ProjectilesContainer= GameThingsContainer</Projectile, 96u/>;
type ProjectileHitSmokeEmittersContainer= GameThingsContainer</ProjectileHitSmokeEmitter, 96u/>;
type ProjectileHitSmokeParticlesContainer= GameThingsContainer</ProjectileHitSmokeParticle, 512u/>;
type BreakingGlassEffectsContainer= GameThingsContainer</BreakingGlassEffect, 32u/>;
type DamagingFlamesContainer= GameThingsContainer</DamagingFlame, 192u/>;
type MuzzleFlashesContainer= GameThingsContainer</MuzzleFlash, 64u/>;
type ExplosionParticlesContainer= GameThingsContainer</ExplosionParticle, 96u/>;
type FlameParticlesContainer= GameThingsContainer</FlameParticle, 128u/>;
type SmokeParticlesContainer= GameThingsContainer</SmokeParticle, 512u/>; // We have a lot of smoke emitters on some maps.

struct EntityState
{
	u32 kind; // Should be valid index within entities description.

	Vec3f position;
	f32 azimuth;

	u32 energy; // what's known to be health in other games

	u32 ammo; // Enemies use some sort of unified ammo, which is used by all their weapons.

	u32 current_operation; // Should be valid operation index.

	u32 num_steps_since_operation_start;

	// If not ~0u renresents navigation info index (and also navigation graph index).
	u32 navigation_info_index;

	// If not ~0u represents navigation graph node used for moving.
	u32 target_navigation_graph_node;

	// If not ~0u represents navigation graph node to which this entity is attached.
	// This node should be changed only while navigating the graph.
	// Re-calculated the nearest one can't work properly in any cases,
	// because original navigation graphs are somewhat buggy.
	u32 current_navigation_graph_node;

	// true if is avare of player presense (has seen him).
	// Once an enemy is alarmed, he can't be calm anymore and will be chasing the player as long as he (the enemy) is alive.
	bool alarmed;

	bool player_is_in_sight;

	bool lost_energy_in_current_operation;

	// There are several animation kinds and each may use different source model.
	// Calculate and store frame for each of them.
	[ u32, typeinfo</EntitiesDescription::Operation::AnimationKind/>.element_count ] animation_frames;

	// Only gravity acceleration is applied to entities.
	// They move with constant speed horizontally.
	f32 velocity_z;

	// Should be ~0u or valid collider index in the colliders array.
	// The corresponding entry in the colliders array should point to this entity.
	u32 collider_index;

	// Where this enemy last time has seen the player.
	ust::optional</Vec3f/> last_seen_player_position;
}

struct PlayerState
{
	Vec3f position;
	f32 azimuth;

	// Velocity in units per game logic step.
	Vec3f velocity;

	bool noclip;
	bool invisibility;

	bool on_ground;
	bool in_liquid;

	f32 ground_friction;

	// 0 if standing, 1 if crouching, a value inbetween if in transition.
	f32 crouching_phase;

	u32 energy; // What's known to be health in other games.
	u32 armor; // Absorbs/reflects some damage, except environmental damage and fall damage.

	u32 collider_index;

	// How many of each tool the player has.
	[ u32, typeinfo</EntitiesDescription::ToolType/>.element_count ] inventory;

	PlayerWeaponState weapon_state;

	PlayerToolsState tools_state;

	EntitiesDescription::ToolType last_requested_key_type; // None if nothing was requested.
	u32 last_key_request_step;

	// Each bit represents a map trigger volume.
	// Since we have only a few of them, 32 bits is enough.
	u32 opened_secrets_mask;

	u32 last_opened_secret_area_step;
}

struct PlayerWeaponState
{
	EntitiesDescription::ToolType current_weapon;
	EntitiesDescription::ToolType requested_weapon;

	// Is equal to "c_weapon_switching_half_time_steps" if has no active weapon switching.
	// It's decreased towards zero if requested weapong isn't equal to current weapon.
	// It's increased towards "c_weapon_switching_half_time_steps" after current weapon was changed to requested weapon.
	u32 switching_fraction;

	f32 extra_lowering; // Normally is 0, by may be up to 1 if this weapon should be lowered (while performing a shot).

	WeaponAnimation current_animation;
	u32 current_animation_step;

	enum WeaponAnimation
	{
		None,
		Walking,
		Idle0,
		Idle1,
		Shooting,
	}

	// Is non-empty if shooting right now.
	ust::optional</u32/> num_active_shooting_steps;
}

struct PlayerToolsState
{
	EntitiesDescription::ToolType selected_tool;
	u32 last_tool_selection_step; // Step number where last time a tool was selected.

	bool acid_protection_suit_is_active;
	bool night_vision_is_active;
	bool infrared_vision_is_active;
}

struct Collider
{
	BBox3f bbox;
	u32 entity_index; // Index in the entities array or special index for the player.
}

struct Projectile
{
	// Weapon tool used to fire this projectile. Should be valid.
	u32 weapon_tool_index;

	u32 owner_entity_index; // Index in the entities array or special index for the player.

	// Age is increased each step. It's needed to remove too old projectiles (flying towards infinity).
	u32 age_steps;

	Vec3f position;
	Vec3f velocity;
}

struct DynamicClusterState
{
	enum MovementStage
	{
		StayAtStart,
		MoveForward,
		StayAtEnd,
		MoveBackward,
	}

	MovementStage movement_stage;

	// Non-zero if state transition is sceduled.
	u32 num_steps_to_movement_stage_transition;

	// How far away is moved from start position towards movement direction (in distance units).
	f32 distance_from_start;
}

struct DynamicClusterCollider
{
	// Difference between center of this bbox and center of the original cluster is cluster translation.
	// Its size should be equal to the bbox size of the original cluster.
	// This bounding box is used to check if collision calculation should be performed for this dynamic cluster,
	// but collision itself is performed on per-quad basis.
	BBox3f bbox;

	u32 cluster_index;
}

struct ProjectileHitEvent
{
	u32 weapon_tool_index; // Should be valid index.
	Vec3f position;
	u32 hit_cluster_index; // Is valid cluster index to which hit world quad belongs (if hit a world quad).
	u32 hit_quad_index; // Is valid quad index if hit a world quad.
	u32 hit_entity_index; // May be entity index or player index or invalid index if didn't hit anything dynamic.
}

struct ProjectileHitSmokeEmitter
{
	Vec3f position;
	Vec3f hit_point_normal; // Normalized.
	u32 age_steps;
}

struct ProjectileHitSmokeParticle
{
	Vec3f position;
	Vec3f initial_direction; // Normalized.
	u32 age_steps;
}

// This object represents a glass quad being broken and showing breaking animation.
// It has almost no game logic associated with it, all actual glass animation is done in rendering code.
struct BreakingGlassEffect
{
	Vec3f hit_position;
	u32 cluster_index;
	u32 quad_index;
	u32 age_steps;
}

// Game object damaging given entity sometimes.
// It's distinct from flame visual effects.
struct DamagingFlame
{
	// Entity to which this flame is attached.
	u32 entity_index;

	u32 age_steps;
}

struct MuzzleFlash
{
	u32 model; // See EntitiesDescription::Tool::muzzle_flash_model.

	// Entity to which this muzzle flash is attached. May be player.
	u32 owner_entity_index;

	// Position in frame of reference of the owner entity.
	// For the player it's position relative camera.
	Vec3f relative_position;

	u32 age_steps;
}

struct ExplosionParticle
{
	bool large;
	Vec3f position;
	u32 age_steps;
}

// Flame visual effect, not actual flame doing damage.
struct FlameParticle
{
	Vec3f position;
	u32 dynamic_cluster_object_index; // Is valid index of a dynamic cluster object if is attached to it.
	Vec3f relative_position; // Used by flames attached to dynamic cluster objects.
	u32 age_steps;
}

struct SmokeParticle
{
	u32 smoke_model; // See EntitiesDescription::SmokeEmission::smoke_model.
	Vec3f center;
	Vec3f position;
	Vec3f velocity;
	u32 sequential_index; // Used for animating smoke particles.
	u32 age_steps;
}

struct SmokeTrailParticle
{
	typeof( EntitiesDescription::Tool::c_smoke_trail_kind_none ) kind;
	Vec3f position;
	u32 age_steps;
}

struct PlayerInput
{
	 // View direction from camera controller.
	f32 azimuth;
	f32 elevation;

	Vec3f move_wish_vector; // What player movement controller actually returs.
	bool jump_requested;
	bool crouching_requested;
	bool shot_requested;
	PlayerInventoryInput inventory_input;
}

struct PlayerInventoryInput
{
	EntitiesDescription::ToolType requested_weapon= EntitiesDescription::ToolType::None; // None if didn't requiested weapon change.
	bool current_tool_activation_requested= false;
	bool previous_tool_selection_requested= false;
	bool next_tool_selection_requiested= false;
	bool acid_protection_suit_activation_requested= false;
	bool night_vision_activation_requested= false;
	bool infrared_vision_activation_requested= false;
}

// Map-independent immutable data used by game logic code.
struct GameGlobalData
{
	GameResourcePtr</GameParams/> game_params;
	GameResourcePtr</MapsDescription/> maps_description;
	GameResourcePtr</MaterialsDescription/> materials_description;
	GameResourcePtr</MaterialsProperties/> materials_properties;
}

// Map-dependent immutable data used by game logic code.
struct GameMapData
{
	u32 map_index;
	GameResourcePtr</EntitiesDescription/> entities_description;
	GameResourcePtr</ZmapData/> zmap_data;
	GameResourcePtr</ZvoxData/> zvox_data;
	GameResourcePtr</ZpozData/> zpoz_data;
	GameResourcePtr</MapaWayData/> mapa_way_data;
	QuadsHierarchy collider_quads_hierarchy;
	GameResourcePtr</RoomClustersHierarchy/> room_clusters_hierarchy;
	ust::vector</ResourceString/> used_models;
}

} // namespace PM
