import "/integer_parsing.u"
import "/common_lib/string_iterators.uh"
import "materials_property_file.uh"

namespace PM
{

fn ParseMaterialPropertiesFile( ust::string_view8 file_contents ) : MaterialsProperties
{
	var MaterialsProperties mut materials_properties;

	var ust::optional</ tup[ size_type, MaterialProperties ] /> mut current_material;

	foreach( line : ust::wrap_raw_iterator( LinesRawIterator( file_contents ) ) )
	{
		auto mut words_it= ust::wrap_raw_iterator( WordsIterator( line ) );

		auto first_word_opt= words_it.next();
		if( first_word_opt.empty() )
		{
			continue;
		}

		var ust::string_view8 first_word= first_word_opt.try_deref();

		if( first_word == "material" )
		{
			if( !current_material.empty() )
			{
				auto [ index, mut material ]= current_material.try_take();
				if( materials_properties.size() <= index )
				{
					materials_properties.resize( index + 1s );
				}
				materials_properties[index]= move(material);
			}

			if_var( index_str : words_it.next() )
			{
				if_var( index : ust::parse_integer_exact</size_type/>( index_str ) )
				{
					var MaterialProperties mut m;

					if_var( name : words_it.next() )
					{
						m.name= name;
					}

					current_material= ust::make_tuple( index, move(m) );
				}
			}
		}
	}

	if( !current_material.empty() )
	{
		auto [ index, mut material ]= current_material.try_take();
		if( materials_properties.size() <= index )
		{
			materials_properties.resize( index + 1s );
		}
		materials_properties[index]= move(material);
	}

	return materials_properties;
}

} // namespace PM
