import "/sdl/sdl_with_opengl.iu"
import "player_tool_controller.iu"

namespace PM
{

fn PlayerToolController::constructor( SettingsImutPtr mut settings )
	( settings_= move(settings) )
{}

fn PlayerToolController::Update( mut this, KeyboardState& keyboard_state, u32 mouse_state )
{
	var u32 button_shot= 1u;

	auto lock= settings_.lock_imut();
	var Settings& settings= lock.deref();

	if( keyboard_state[ settings.in_key_weapon_kick.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::Kick;
	}
	if( keyboard_state[ settings.in_key_weapon_a.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponA;
	}
	if( keyboard_state[ settings.in_key_weapon_b.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponB;
	}
	if( keyboard_state[ settings.in_key_weapon_c.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponC;
	}
	if( keyboard_state[ settings.in_key_weapon_d.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponD;
	}
	if( keyboard_state[ settings.in_key_weapon_e.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponE;
	}
	if( keyboard_state[ settings.in_key_weapon_f.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponF;
	}
	if( keyboard_state[ settings.in_key_weapon_g.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponG;
	}
	if( keyboard_state[ settings.in_key_weapon_h.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponH;
	}
	if( keyboard_state[ settings.in_key_weapon_i.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponI;
	}
	if( keyboard_state[ settings.in_key_weapon_j.scancode ] )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponJ;
	}

	if( keyboard_state[ settings.in_key_inventory_use.scancode ] )
	{
		if( !tool_activation_pressed_ )
		{
			tool_activation_pressed_= true;
			inventory_input_.current_tool_activation_requested= true;
		}
	}
	else
	{
		tool_activation_pressed_= false;
	}

	if( keyboard_state[ settings.in_key_inventory_previous.scancode ] )
	{
		if( !previous_tool_selection_pressed_ )
		{
			previous_tool_selection_pressed_= true;
			inventory_input_.previous_tool_selection_requested= true;
		}
	}
	else
	{
		previous_tool_selection_pressed_= false;
	}

	if( keyboard_state[ settings.in_key_inventory_next.scancode ] )
	{
		if( !next_tool_selection_pressed_ )
		{
			next_tool_selection_pressed_= true;
			inventory_input_.next_tool_selection_requiested= true;
		}
	}
	else
	{
		next_tool_selection_pressed_= false;
	}

	if( keyboard_state[ settings.in_key_acid_protection_suit.scancode ] )
	{
		if( !acid_protection_suit_activation_pressed_ )
		{
			acid_protection_suit_activation_pressed_= true;
			inventory_input_.acid_protection_suit_activation_requested= true;
		}
	}
	else
	{
		acid_protection_suit_activation_pressed_= false;
	}

	if( keyboard_state[ settings.in_key_night_vision_activation.scancode ] )
	{
		if( !night_vision_activation_pressed_ )
		{
			night_vision_activation_pressed_= true;
			inventory_input_.night_vision_activation_requested= true;
		}
	}
	else
	{
		night_vision_activation_pressed_= false;
	}

	if( keyboard_state[ settings.in_key_infrared_vision_activation.scancode ] )
	{
		if( !infrared_vision_activation_pressed_ )
		{
			infrared_vision_activation_pressed_= true;
			inventory_input_.infrared_vision_activation_requested= true;
		}
	}
	else
	{
		infrared_vision_activation_pressed_= false;
	}

	if( ( mouse_state & ( 1u << ( button_shot - 1u ) ) ) != 0u )
	{
		shot_requested_= true;
	}
}

fn PlayerToolController::GetInventoryInput( this ) : PlayerInventoryInput
{
	return inventory_input_;
}

fn PlayerToolController::GetShotRequested( this ) : bool
{
	return shot_requested_;
}

fn PlayerToolController::Reset( mut this )
{
	inventory_input_= PlayerInventoryInput();
	shot_requested_= false;
}

} // namespace PM
