import "/sdl/sdl_with_opengl.uh"
import "player_tool_controller.uh"

namespace PM
{

fn PlayerToolController::Update( mut this, ust::array_view_imut</bool/> keyboard_state )
{
	var size_type
		key_kick(SDL_SCANCODE_1),
		key_weapon_a(SDL_SCANCODE_2),
		key_weapon_b(SDL_SCANCODE_3),
		key_weapon_c(SDL_SCANCODE_4),
		key_weapon_d(SDL_SCANCODE_5),
		key_weapon_e(SDL_SCANCODE_6),
		key_weapon_f(SDL_SCANCODE_7),
		key_weapon_g(SDL_SCANCODE_8),
		key_weapon_h(SDL_SCANCODE_9),
		key_weapon_i(SDL_SCANCODE_0),
		key_weapon_j(SDL_SCANCODE_MINUS);

	if( key_kick < keyboard_state.size() && keyboard_state[ key_kick ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::Kick;
	}
	if( key_weapon_a < keyboard_state.size() && keyboard_state[ key_weapon_a ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponA;
	}
	if( key_weapon_b < keyboard_state.size() && keyboard_state[ key_weapon_b ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponB;
	}
	if( key_weapon_c < keyboard_state.size() && keyboard_state[ key_weapon_c ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponC;
	}
	if( key_weapon_d < keyboard_state.size() && keyboard_state[ key_weapon_d ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponD;
	}
	if( key_weapon_e < keyboard_state.size() && keyboard_state[ key_weapon_e ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponE;
	}
	if( key_weapon_f < keyboard_state.size() && keyboard_state[ key_weapon_f ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponF;
	}
	if( key_weapon_g < keyboard_state.size() && keyboard_state[ key_weapon_g ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponG;
	}
	if( key_weapon_h < keyboard_state.size() && keyboard_state[ key_weapon_h ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponH;
	}
	if( key_weapon_i < keyboard_state.size() && keyboard_state[ key_weapon_i ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponI;
	}
	if( key_weapon_j < keyboard_state.size() && keyboard_state[ key_weapon_j ] )
	{
		requested_weapon_= EntitiesDescription::ToolType::WeaponJ;
	}
}

fn PlayerToolController::GetRequestedWeapon( this ) : ust::optional</EntitiesDescription::ToolType/>
{
	return requested_weapon_;
}

fn PlayerToolController::Reset( mut this )
{
	requested_weapon_.reset();
}

} // namespace PM
