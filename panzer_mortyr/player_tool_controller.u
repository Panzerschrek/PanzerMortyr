import "/sdl/sdl_with_opengl.uh"
import "player_tool_controller.uh"

namespace PM
{

fn PlayerToolController::Update( mut this, ust::array_view_imut</bool/> keyboard_state, u32 mouse_state )
{
	var [ tup[ size_type, EntitiesDescription::ToolType ], 11 ] mut weapon_tool_keys
	[
		[ (SDL_SCANCODE_1), EntitiesDescription::ToolType::Kick ],
		[ (SDL_SCANCODE_2), EntitiesDescription::ToolType::WeaponA ],
		[ (SDL_SCANCODE_3), EntitiesDescription::ToolType::WeaponB ],
		[ (SDL_SCANCODE_4), EntitiesDescription::ToolType::WeaponC ],
		[ (SDL_SCANCODE_5), EntitiesDescription::ToolType::WeaponD ],
		[ (SDL_SCANCODE_6), EntitiesDescription::ToolType::WeaponE ],
		[ (SDL_SCANCODE_7), EntitiesDescription::ToolType::WeaponF ],
		[ (SDL_SCANCODE_8), EntitiesDescription::ToolType::WeaponG ],
		[ (SDL_SCANCODE_9), EntitiesDescription::ToolType::WeaponH ],
		[ (SDL_SCANCODE_0), EntitiesDescription::ToolType::WeaponI ],
		[ (SDL_SCANCODE_MINUS), EntitiesDescription::ToolType::WeaponJ],
	];

	var SDL_Scancode key_inventory_use= SDL_SCANCODE_RETURN;
	var SDL_Scancode key_inventory_previous= SDL_SCANCODE_LEFTBRACKET;
	var SDL_Scancode key_inventory_next= SDL_SCANCODE_RIGHTBRACKET;

	var u32 button_shot= 1u;

	foreach( pair : weapon_tool_keys )
	{
		if( pair[0] < keyboard_state.size() && keyboard_state[ pair[0] ] )
		{
			inventory_input_.requested_weapon= pair[1];
		}
	}

	if( size_type( key_inventory_use ) < keyboard_state.size() && keyboard_state[ size_type( key_inventory_use ) ] )
	{
		inventory_input_.current_tool_activate_requested= true;
	}

	if( size_type( key_inventory_previous ) < keyboard_state.size() &&
		keyboard_state[ size_type( key_inventory_previous ) ] )
	{
		inventory_input_.previous_tool_requested= true;
	}

	if( size_type( key_inventory_next ) < keyboard_state.size() &&
		keyboard_state[ size_type( key_inventory_next ) ] )
	{
		inventory_input_.next_tool_requiested= true;
	}

	if( ( mouse_state & ( 1u << ( button_shot - 1u ) ) ) != 0u )
	{
		shot_requested_= true;
	}
}

fn PlayerToolController::GetInventoryInput( this ) : PlayerInventoryInput
{
	return inventory_input_;
}

fn PlayerToolController::GetShotRequested( this ) : bool
{
	return shot_requested_;
}

fn PlayerToolController::Reset( mut this )
{
	inventory_input_=
		PlayerInventoryInput
		{
			.requested_weapon= EntitiesDescription::ToolType::None,
			.current_tool_activate_requested= false,
			.previous_tool_requested= false,
			.next_tool_requiested= false,
		};

	shot_requested_= false;
}

} // namespace PM
