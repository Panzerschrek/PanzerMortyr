import "/sdl/sdl_with_opengl.iu"
import "player_tool_controller.iu"

namespace PM
{

fn PlayerToolController::constructor( SettingsImutPtr mut settings )
	( settings_= move(settings) )
{}

fn PlayerToolController::Update( mut this, InputState& input_state )
{
	auto lock= settings_.lock_imut();
	var Settings& settings= lock.deref();

	// Check key presses for weapon selection.
	// We don't require fast repetitive selection of the same weapon,
	// so, checking only key presses and not key state is fine.

	if( input_state.HasKeyPressEvent( settings.in_key_weapon_kick ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::Kick;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_a ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponA;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_b ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponB;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_c ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponC;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_d ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponD;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_e ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponE;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_f ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponF;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_g ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponG;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_h ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponH;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_i ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponI;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_weapon_j ) )
	{
		inventory_input_.requested_weapon= EntitiesDescription::ToolType::WeaponJ;
	}

	// Check key presses, not keyboard state for tools activation/deactivation and inventory navigation.
	// We do this in order to avoid activating/deactivating a tool on each step until the corresponding key is not depressed.

	if( input_state.HasKeyPressEvent( settings.in_key_inventory_use ) )
	{
		inventory_input_.current_tool_activation_requested= true;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_inventory_previous ) )
	{
		inventory_input_.previous_tool_selection_requested= true;
	}
	if( input_state.HasKeyPressEvent(  settings.in_key_inventory_next ) )
	{
		inventory_input_.next_tool_selection_requiested= true;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_acid_protection_suit ) )
	{
		inventory_input_.acid_protection_suit_activation_requested= true;
	}
	if( input_state.HasKeyPressEvent( settings.in_key_night_vision_activation ) )
	{
		inventory_input_.night_vision_activation_requested= true;
	}
	if(  input_state.HasKeyPressEvent( settings.in_key_infrared_vision_activation ) )
	{
		inventory_input_.infrared_vision_activation_requested= true;
	}
	if(  input_state.HasKeyPressEvent( settings.in_key_flashlight_activation ) )
	{
		inventory_input_.flashlight_activation_requested= true;
	}
	if(  input_state.HasKeyPressEvent( settings.in_key_jetpack_activation ) )
	{
		inventory_input_.jetpack_activation_requested= true;
	}

	if( input_state.KeyIsPressed( settings.in_key_attack ) )
	{
		shot_requested_= true;
	}

	// Check keyboard state, not key presses for kick in order to be able to kick as fast as possible.
	if( input_state.KeyIsPressed( settings.in_key_kick ) )
	{
		kick_requested_= true;
	}
}

fn PlayerToolController::GetInventoryInput( this ) : PlayerInventoryInput
{
	return inventory_input_;
}

fn PlayerToolController::GetShotRequested( this ) : bool
{
	return shot_requested_;
}

fn PlayerToolController::GetKickRequested( this ) : bool
{
	return kick_requested_;
}

fn PlayerToolController::Reset( mut this )
{
	inventory_input_= PlayerInventoryInput();
	shot_requested_= false;
	kick_requested_= false;
}

} // namespace PM
