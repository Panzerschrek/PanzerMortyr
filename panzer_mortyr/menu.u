import "menu.uh"

namespace PM
{

fn Menu::constructor( [ u32, 2 ] viewport_size )
	( viewport_size_= viewport_size, images_preloaded_= false, is_active_= true, time_s_= 0.0f, current_row_= 0u )
{
}

fn Menu::IsActive( this ) : bool
{
	return is_active_;
}

fn Menu::ProcessKeyPress( mut this, SDL_Keysym& key_sym )
{
	if( key_sym.scancode == SDL_SCANCODE_ESCAPE )
	{
		is_active_= !is_active_;
	}
	else if( key_sym.scancode == SDL_SCANCODE_UP )
	{
		current_row_= ( current_row_ + ( c_main_menu_num_rows - 1u ) ) % c_main_menu_num_rows;
	}
	else if( key_sym.scancode == SDL_SCANCODE_DOWN )
	{
		current_row_= ( current_row_ + 1u ) % c_main_menu_num_rows;
	}
}

fn Menu::Update( mut this, f32 time_delta_s )
{
	time_s_+= time_delta_s;
}

fn Menu::Draw( mut this, ImageDrawer &mut image_drawer, TextDrawer &mut text_drawer )
{
	if( !images_preloaded_ )
	{
		PreloadMenuImages( image_drawer );
		images_preloaded_= true;
	}

	if( !IsActive() )
	{
		return;
	}

	// Use only integer scale, since we need to draw scaled texts and they look nice only in integer scales.
	var u32 scale=
		ust::max( 1u,
			ust::min(
				viewport_size_[0] * 2u / 3u / c_base_menu_size[0],
				viewport_size_[1] * 2u / 3u / c_base_menu_size[1] ) );

	var i32 offset_x= i32( ( viewport_size_[0] - c_base_menu_size[0] * scale ) / 2u );
	var i32 offset_y= i32( ( viewport_size_[1] - c_base_menu_size[1] * scale ) * 3u / 4u );

	image_drawer.DrawImage( MenuImages::main_menu_background, offset_x, offset_y, f32( scale ) );

	{
		var i32 cursor_offset_x= offset_x + i32( 65u * scale );
		var i32 cursor_offset_y= offset_y + i32( 50u * scale );

		var u32 cursor_frame= u32( time_s_ * 16.0f ) % 16u;

		var u32 cursor_tile_x= cursor_frame % 8u;
		var u32 cursor_tile_y= ( cursor_frame / 8u ) ^ 1u;

		var u32 constexpr cursor_size= 24u;
		var u32 constexpr cursor_step_size= 16u;

		image_drawer.DrawImage(
			MenuImages::cursor_frames,
			cursor_offset_x,
			cursor_offset_y + i32( cursor_step_size * scale * ( c_main_menu_num_rows - 1u - current_row_ ) ),
			f32( scale ),
			cursor_tile_x * cursor_size,
			cursor_tile_y * cursor_size,
			cursor_size,
			cursor_size );
	}

	ust::ignore_unused( text_drawer ); // TODO - use it.
}

fn PreloadMenuImages( ImageDrawer &mut image_drawer )
{
	image_drawer.PreloadImage( MenuImages::main_menu_background );
	image_drawer.PreloadImage( MenuImages::cursor_frames );
	image_drawer.PreloadImage( MenuImages::control_elements );
}

var u32 c_main_menu_num_rows= 6u;

var [ u32, 2 ] c_base_menu_size[ 320u, 200u ];

namespace MenuImages
{

var ResourceString
	& main_menu_background= "MENU.BMP\0\0\0\0\0\0\0\0",
	& cursor_frames= "MENU_Z.BMP\0\0\0\0\0\0",
	& control_elements= "OPTION2.BMP\0\0\0\0\0";

} // namespace MenuImages

} // namespace PM
