			text_drawer.AddText(
				texts_offset_x,
				texts_offset_y - i32( horizontal_texts_spacing * 4u ),
				FetchStringFromExtraTable( ExtraStringTableKey::UnderwaterEffects ),
				text_settings );

			text_drawer.AddText(
				texts_offset_column1_x,
				texts_offset_y - i32( horizontal_texts_spacing * 4u ),
				( settings.r_caustics_enabled ? on_str : off_str ),
