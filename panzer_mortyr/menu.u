				text_settings );

			text_drawer.AddText(
				texts_offset_x,
				texts_offset_y - i32( horizontal_texts_spacing * 2u ),
				FetchStringFromExtraTable( ExtraStringTableKey::MirrorAlpha ),
				text_settings );

			{
				var [ char8, 16 ] mut slider_text[ '-' ... ];
				slider_text[ size_type( ust::max( 1, ust::min( 15, i32( settings.r_mirror_alpha * 16.0f ) ) ) ) ]= 'I';

				text_drawer.AddText(
					texts_offset_column1_x,
					texts_offset_y - i32( horizontal_texts_spacing * 2u ),
					slider_text,
					text_settings );
			}

			text_drawer.AddText(
				texts_offset_x,
				texts_offset_y - i32( horizontal_texts_spacing * 3u ),
				FetchStringFromExtraTable( ExtraStringTableKey::RainSnow ),
				text_settings );

			text_drawer.AddText(
				texts_offset_column1_x,
				texts_offset_y - i32( horizontal_texts_spacing * 3u ),
