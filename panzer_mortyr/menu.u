import "/scoped_array.iu"
import "/common_lib/game_params_file.iu"
import "extra_string_table.iu"
import "menu.iu"
import "savegame_screenshot.iu"

namespace PM
{

fn Menu::constructor(
	SettingsPtr mut settings, CachingGameResourcesLoaderPtr& caching_game_resources_loader, [ u32, 2 ] viewport_size )
	(
		settings_= move(settings),
		string_table_=
			lambda[&]() : GameResourcePtr</StringTable/>
			{
				auto mut lock= caching_game_resources_loader.lock_mut();
				return lock.deref().LoadStringTable();
			} (),
		viewport_size_= viewport_size,
		per_display_video_modes_= GetDisplayModesForAllDisplays(),
		images_preloaded_= false,
		current_page_= Page::MainMenu,
		time_s_= 0.0f,
		main_menu_current_row_= 0u,
		new_game_current_row_= 0u,
		options_current_row_= 0u,
		load_save_pages_state_{ .current_row= 0u },
		controls_current_row_= 0u,
		key_bindings_page_state_{ .current_row= 0u, .rows_offset= 0u, .editing_active= false },
		video_settings_page_state_{ .current_row= 0u, .current_video_mode_index= 0u },
		sound_settings_current_row_= 0u,
		extra_options_current_row_= 0u,
		quit_message_index_= 1000u,
	)
{}

fn Menu::IsActive( this ) : bool
{
	return current_page_ != Page::None;
}

fn Menu::Activate( mut this )
{
	current_page_= Page::MainMenu;
}

fn Menu::Deactivate( mut this )
{
	current_page_= Page::None;

	// Cancel save slot editing.
	load_save_pages_state_.input_slot_comment.reset();

	// Cancel key binding editing.
	key_bindings_page_state_.editing_active= false;
}

fn nodiscard Menu::ProcessKeyPress( mut this, SDL_Keysym& key_sym, AudioProcessor &mut audio_processor ) : Command
{
	auto play_menu_sound= lambda[&]() { audio_processor.PlayMenuSound(); };

	switch( key_sym.scancode )
	{
		SDL_SCANCODE_ESCAPE ->
		{
			play_menu_sound();

			switch( current_page_ )
			{
				Page::None -> { current_page_= Page::MainMenu; },
				Page::MainMenu -> { current_page_= Page::None; },
				Page::NewGame -> { current_page_= Page::MainMenu; },
				Page::LoadGame -> { current_page_= Page::MainMenu; },
				Page::SaveGame ->
				{
					if( !load_save_pages_state_.input_slot_comment.empty() )
					{
						// Discard edited changes.
						load_save_pages_state_.input_slot_comment.reset();
					}
					else
					{
						current_page_= Page::MainMenu;
					}
				},
				Page::Multiplayer -> { current_page_= Page::MainMenu; },
				Page::Options -> { current_page_= Page::MainMenu; },
				Page::Controls -> { current_page_= Page::Options; },
				Page::KeyBindings ->
				{
					if( key_bindings_page_state_.editing_active )
					{
						// Cancel editing.
						key_bindings_page_state_.editing_active= false;
					}
					else
					{
						current_page_= Page::Controls;
					}
				},
				Page::VideoSettings -> { current_page_= Page::Options; },
				Page::SoundSettings -> { current_page_= Page::Options; },
				Page::ExtraOptions -> { current_page_= Page::Options; },
				Page::Quit -> { current_page_= Page::MainMenu; },
			}
		},
		SDL_SCANCODE_RETURN ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu ->
				{
					switch( main_menu_current_row_ )
					{
						0u -> { current_page_= Page::NewGame; play_menu_sound(); },
						1u ->
						{
							current_page_= Page::LoadGame;
							play_menu_sound();

							// Load save summaries upon entering the load page.
							LoadSaveSummaries();
						},
						2u ->
						{
							current_page_= Page::SaveGame;
							play_menu_sound();

							// Load save summaries upon entering the save page.
							LoadSaveSummaries();
						},
						3u -> { current_page_= Page::Multiplayer; play_menu_sound(); },
						4u -> { current_page_= Page::Options; play_menu_sound(); },
						5u ->
						{
							current_page_= Page::Quit;

							play_menu_sound();

							// Pseudo-random time-based selection of quit message.
							var u32 mut new_index= u32( time_s_ * 17.0f ) % c_num_quit_messages;
							if( new_index == quit_message_index_ )
							{
								new_index= ( new_index + 1u ) % c_num_quit_messages;
							}

							quit_message_index_= new_index;
						},
						default -> {},
					}
				},
				Page::NewGame ->
				{
					current_page_= Page::None;

					play_menu_sound();

					return CommandNewGame{ .skill= new_game_current_row_ };
				},
				Page::LoadGame ->
				{
					if( !load_save_pages_state_.slots[ load_save_pages_state_.current_row ].empty() )
					{
						current_page_= Page::None;

						play_menu_sound();

						return CommandLoadGame{ .slot_name= GetSaveNameForSlot( load_save_pages_state_.current_row ) };
					}
				},
				Page::SaveGame ->
				{
					play_menu_sound();

					if( load_save_pages_state_.input_slot_comment.empty() )
					{
						// Start editing.
						if_var( &summary : load_save_pages_state_.slots[ load_save_pages_state_.current_row ] )
						{
							load_save_pages_state_.input_slot_comment= summary.comment;
						}
						else
						{
							load_save_pages_state_.input_slot_comment= ust::make_zeroed</SaveComment/>();
						}
					}
					else
					{
						// End editing. Slot name will be updated upon opening save/load pages next time.

						var SaveComment save_comment= load_save_pages_state_.input_slot_comment.try_deref();
						load_save_pages_state_.input_slot_comment.reset();

						current_page_= Page::None;

						return CommandSaveGame
						{
							.slot_name= GetSaveNameForSlot( load_save_pages_state_.current_row ),
							.save_comment= save_comment
						};
					}

				},
				Page::Multiplayer -> {},
				Page::Options ->
				{
					switch( options_current_row_ )
					{
						0u -> { current_page_= Page::Controls; play_menu_sound(); },
						1u ->
						{
							current_page_= Page::VideoSettings;
							play_menu_sound();
							ActualizeVideoModeIndex(); // Make sure we show actual video mode on video settings page.
						},
						2u -> { current_page_= Page::SoundSettings; play_menu_sound(); },
						3u -> { /* Do nothing for mouse sensitivity. */ },
						4u -> { /* TODO - change HUD position. */ },
						5u -> { /* TODO - change crosshair. */ },
						6u -> { /* TODO - switch to parental lock menu. */ },
						7u-> { current_page_= Page::ExtraOptions; play_menu_sound(); },
						default -> {},
					}
				},
				Page::Controls ->
				{
					switch( controls_current_row_ )
					{
						0u -> { current_page_= Page::KeyBindings; play_menu_sound(); },
						1u -> { ToggleBooleanSetting</ "in_mouse_enabled" />( settings_ ); play_menu_sound(); },
						2u -> { ToggleBooleanSetting</ "in_invert_mouse_y_axis" />( settings_ ); play_menu_sound(); },
						3u -> { ToggleBooleanSetting</ "in_always_run" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::KeyBindings ->
				{
					if( key_bindings_page_state_.editing_active )
					{
						ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
					}
					else
					{
						key_bindings_page_state_.editing_active= true;
					}
				},
				Page::VideoSettings ->
				{
					switch( video_settings_page_state_.current_row )
					{
						0u -> { ToggleBooleanSetting</ "r_fullscreen" />( settings_ ); play_menu_sound(); },
						1u ->
						{
							IncreaseDisplayIndex( settings_, u32( per_display_video_modes_.size() ) );
							ActualizeVideoModeIndex();
							play_menu_sound();
						},
						2u -> { SelectNextVideoMode(); play_menu_sound(); },
						3u -> { ToggleBooleanSetting</ "r_vsync" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::SoundSettings ->
				{
					switch( sound_settings_current_row_ )
					{
						0u -> { ToggleBooleanSetting</ "snd_audio_enabled" />( settings_ ); play_menu_sound(); },
						1u ->
						{
							ToggleBooleanSetting</ "snd_ambient_sound_enabled" />( settings_ );
							play_menu_sound();
						},
						2u -> { /* don't change a slider option via "enter" */ },
						3u -> { /* don't change a slider option via "enter" */ },
						4u -> { /* don't change a slider option via "enter" */ },
						5u ->
						{
							ToggleBooleanSetting</ "snd_character_voice_enabled" />( settings_ );
							play_menu_sound();
						},
						6u -> { ToggleBooleanSetting</ "snd_flip_stereo" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::ExtraOptions ->
				{
					switch( extra_options_current_row_ )
					{
						0u -> { ToggleBooleanSetting</ "r_fog_enabled" />( settings_ ); play_menu_sound(); },
						1u -> { ToggleBooleanSetting</ "r_mirrors_enabled" />( settings_ ); play_menu_sound(); },
						2u -> {},
						3u -> { ToggleBooleanSetting</ "r_rain_snow_enabled" />( settings_ ); play_menu_sound(); },
						4u -> { ToggleBooleanSetting</ "r_caustics_enabled" />( settings_ ); play_menu_sound(); },
						5u -> { ToggleBooleanSetting</ "r_decals_enabled" />( settings_ ); play_menu_sound(); },
						6u ->
						{
							ToggleBooleanSetting</ "r_water_circle_decals_enabled" />( settings_ );
							play_menu_sound();
						},
						7u -> { ToggleBooleanSetting</ "r_dynamic_lights_enabled" />( settings_ ); play_menu_sound(); },
						8u -> { ToggleBooleanSetting</ "g_blood_enabled" />( settings_ ); play_menu_sound(); },
						9u ->
						{
							ToggleBooleanSetting</ "r_texture_trilinear_filter" />( settings_ );
							play_menu_sound();
						},
						10u -> {},
						11u ->
						{
							ToggleBooleanSetting</ "r_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						12u ->
						{
							ToggleBooleanSetting</ "r_hud_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						13u ->
						{
							ToggleBooleanSetting</ "r_gui_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						default -> {},
					}
				},
				Page::Quit ->
				{
					return CommandQuit{};
				},
			}
		},
		SDL_SCANCODE_UP ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu ->
				{
					DecrementRow( main_menu_current_row_, PageNumRows::main_menu );
					play_menu_sound();
				},
				Page::NewGame -> { DecrementRow( new_game_current_row_, PageNumRows::new_game ); play_menu_sound(); },
				Page::LoadGame, Page::SaveGame ->
				{
					if( load_save_pages_state_.input_slot_comment.empty() )
					{
						DecrementRow( load_save_pages_state_.current_row, c_num_load_save_slots );
						play_menu_sound();
					}
				},
				Page::Multiplayer -> {},
				Page::Options -> { DecrementRow( options_current_row_, PageNumRows::options ); play_menu_sound(); },
				Page::Controls -> { DecrementRow( controls_current_row_, PageNumRows::controls ); play_menu_sound(); },
				Page::KeyBindings ->
				{
					if( key_bindings_page_state_.editing_active )
					{
						ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
					}
					else
					{
						if( key_bindings_page_state_.current_row == 0u )
						{
							key_bindings_page_state_.current_row= PageNumRows::key_bindings - 1u;
							key_bindings_page_state_.rows_offset= PageNumRows::key_bindings - c_num_visible_key_binding_rows;
						}
						else
						{
							--key_bindings_page_state_.current_row;

							if( key_bindings_page_state_.rows_offset > 0u &&
								key_bindings_page_state_.current_row <= key_bindings_page_state_.rows_offset )
							{
								--key_bindings_page_state_.rows_offset;
							}
						}

						play_menu_sound();
					}
				},
				Page::VideoSettings ->
				{
					DecrementRow( video_settings_page_state_.current_row, PageNumRows::video_settings );
					play_menu_sound();
				},
				Page::SoundSettings ->
				{
					DecrementRow( sound_settings_current_row_, PageNumRows::sound_settings );
					play_menu_sound();
				},
				Page::ExtraOptions ->
				{
					DecrementRow( extra_options_current_row_, PageNumRows::extra_options );
					play_menu_sound();
				},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_DOWN ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu ->
				{
					IncrementRow( main_menu_current_row_, PageNumRows::main_menu );
					play_menu_sound();
				},
				Page::NewGame -> { IncrementRow( new_game_current_row_, PageNumRows::new_game ); play_menu_sound(); },
				Page::LoadGame, Page::SaveGame ->
				{
					if( load_save_pages_state_.input_slot_comment.empty() )
					{
						IncrementRow( load_save_pages_state_.current_row, c_num_load_save_slots );
						play_menu_sound();
					}
				},
				Page::Multiplayer -> {},
				Page::Options -> { IncrementRow( options_current_row_, PageNumRows::options ); play_menu_sound(); },
				Page::Controls -> { IncrementRow( controls_current_row_, PageNumRows::controls ); play_menu_sound(); },
				Page::KeyBindings ->
				{
					if( key_bindings_page_state_.editing_active )
					{
						ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
					}
					else
					{
						if( key_bindings_page_state_.current_row == PageNumRows::key_bindings - 1u )
						{
							key_bindings_page_state_.current_row= 0u;
							key_bindings_page_state_.rows_offset= 0u;
						}
						else
						{
							++key_bindings_page_state_.current_row;

							if( key_bindings_page_state_.current_row + 1u >= c_num_visible_key_binding_rows + key_bindings_page_state_.rows_offset &&
								key_bindings_page_state_.rows_offset + c_num_visible_key_binding_rows < PageNumRows::key_bindings )
							{
								++key_bindings_page_state_.rows_offset;
							}
						}

						play_menu_sound();
					}
				},
				Page::VideoSettings ->
				{
					IncrementRow( video_settings_page_state_.current_row, PageNumRows::video_settings );
					play_menu_sound();
				},
				Page::SoundSettings ->
				{
					IncrementRow( sound_settings_current_row_, PageNumRows::sound_settings );
					play_menu_sound();
				},
				Page::ExtraOptions ->
				{
					IncrementRow( extra_options_current_row_, PageNumRows::extra_options );
					play_menu_sound();
				},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_LEFT ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu -> {},
				Page::NewGame -> {},
				Page::LoadGame, Page::SaveGame -> {},
				Page::Multiplayer -> {},
				Page::Options ->
				{
					switch( options_current_row_ )
					{
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								DecrementSliderValue( lock.deref().in_mouse_sensitivity );
							}
							play_menu_sound();
						},
						5u -> { /* TODO - change crosshair */ },
						default -> {},
					}
				},
				Page::Controls ->
				{
					switch( controls_current_row_ )
					{
						0u -> {},
						1u -> { ToggleBooleanSetting</ "in_mouse_enabled" />( settings_ ); play_menu_sound(); },
						2u -> { ToggleBooleanSetting</ "in_invert_mouse_y_axis" />( settings_ ); play_menu_sound(); },
						3u -> { ToggleBooleanSetting</ "in_always_run" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::KeyBindings ->
				{
					if( key_bindings_page_state_.editing_active )
					{
						ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
					}
				},
				Page::VideoSettings ->
				{
					switch( video_settings_page_state_.current_row )
					{
						0u -> { ToggleBooleanSetting</ "r_fullscreen" />( settings_ ); play_menu_sound(); },
						1u ->
						{
							DecreaseDisplayIndex( settings_, u32( per_display_video_modes_.size() ) );
							ActualizeVideoModeIndex();
							play_menu_sound();
						},
						2u -> { SelectPreviousVideoMode(); play_menu_sound(); },
						3u -> { ToggleBooleanSetting</ "r_vsync" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::SoundSettings ->
				{
					switch( sound_settings_current_row_ )
					{
						0u -> { ToggleBooleanSetting</ "snd_audio_enabled" />( settings_ ); play_menu_sound(); },
						1u ->
						{
							ToggleBooleanSetting</ "snd_ambient_sound_enabled" />( settings_ );
							play_menu_sound();
						},
						2u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								DecrementSliderValue( lock.deref().snd_volume );
							}
							play_menu_sound();
						},
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								DecrementSliderValue( lock.deref().snd_ambient_volume );
							}
							play_menu_sound();
						},
						4u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								DecrementSliderValue( lock.deref().snd_music_volume );
							}
							play_menu_sound();
						},
						5u ->
						{
							ToggleBooleanSetting</ "snd_character_voice_enabled" />( settings_ );
							play_menu_sound();
						},
						6u -> { ToggleBooleanSetting</ "snd_flip_stereo" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::ExtraOptions ->
				{
					switch( extra_options_current_row_ )
					{
						0u -> { ToggleBooleanSetting</ "r_fog_enabled" />( settings_ ); play_menu_sound(); },
						1u -> { ToggleBooleanSetting</ "r_mirrors_enabled" />( settings_ ); play_menu_sound(); },
						2u ->
						{
							{
								auto mut lock= settings_.lock_mut();
								var f32 &mut mirror_alpha= lock.deref().r_mirror_alpha;
								mirror_alpha= ( ust::max( ust::floor( mirror_alpha * 16.0f ), 1.0f ) - 1.0f ) / 16.0f;
							}
							play_menu_sound();
						},
						3u -> { ToggleBooleanSetting</ "r_rain_snow_enabled" />( settings_ ); play_menu_sound(); },
						4u -> { ToggleBooleanSetting</ "r_caustics_enabled" />( settings_ ); play_menu_sound(); },
						5u -> { ToggleBooleanSetting</ "r_decals_enabled" />( settings_ ); play_menu_sound(); },
						6u ->
						{
							ToggleBooleanSetting</ "r_water_circle_decals_enabled" />( settings_ );
							play_menu_sound();
						},
						7u -> { ToggleBooleanSetting</ "r_dynamic_lights_enabled" />( settings_ ); play_menu_sound(); },
						8u -> { ToggleBooleanSetting</ "g_blood_enabled" />( settings_ ); play_menu_sound(); },
						9u ->
						{
							ToggleBooleanSetting</ "r_texture_trilinear_filter" />( settings_ );
							play_menu_sound();
						},
						10u ->
						{
							{
								auto mut lock= settings_.lock_mut();
								var u32 &mut anisotropy= lock.deref().r_texture_anisotropy;
								if( anisotropy > 0u )
								{
									--anisotropy;
								}
							}
							play_menu_sound();
						},
						11u ->
						{
							ToggleBooleanSetting</ "r_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						12u ->
						{
							ToggleBooleanSetting</ "r_hud_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						13u ->
						{
							ToggleBooleanSetting</ "r_gui_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						default -> {},
					}
				},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_RIGHT ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu -> {},
				Page::NewGame -> {},
				Page::LoadGame, Page::SaveGame -> {},
				Page::Multiplayer -> {},
				Page::Options ->
				{
					switch( options_current_row_ )
					{
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								IncrementSliderValue( lock.deref().in_mouse_sensitivity );
							}
							play_menu_sound();
						},
						5u -> { /* TODO - change crosshair */ },
						default -> {},
					}
				},
				Page::Controls ->
				{
					switch( controls_current_row_ )
					{
						0u -> {},
						1u -> { ToggleBooleanSetting</ "in_mouse_enabled" />( settings_ ); play_menu_sound(); },
						2u -> { ToggleBooleanSetting</ "in_invert_mouse_y_axis" />( settings_ ); play_menu_sound(); },
						3u -> { ToggleBooleanSetting</ "in_always_run" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::KeyBindings ->
				{
					if( key_bindings_page_state_.editing_active )
					{
						ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
					}
				},
				Page::VideoSettings ->
				{
					switch( video_settings_page_state_.current_row )
					{
						0u -> { ToggleBooleanSetting</ "r_fullscreen" />( settings_ ); play_menu_sound(); },
						1u ->
						{
							IncreaseDisplayIndex( settings_, u32( per_display_video_modes_.size() ) );
							ActualizeVideoModeIndex();
							play_menu_sound();
						},
						2u -> { SelectNextVideoMode(); play_menu_sound(); },
						3u -> { ToggleBooleanSetting</ "r_vsync" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::SoundSettings ->
				{
					switch( sound_settings_current_row_ )
					{
						0u -> { ToggleBooleanSetting</ "snd_audio_enabled" />( settings_ ); play_menu_sound(); },
						1u ->
						{
							ToggleBooleanSetting</ "snd_ambient_sound_enabled" />( settings_ );
							play_menu_sound();
						},
						2u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								IncrementSliderValue( lock.deref().snd_volume );
							}
							play_menu_sound();
						},
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								IncrementSliderValue( lock.deref().snd_ambient_volume );
							}
							play_menu_sound();
						},
						4u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								IncrementSliderValue( lock.deref().snd_music_volume );
							}
							play_menu_sound();
						},
						5u ->
						{
							ToggleBooleanSetting</ "snd_character_voice_enabled" />( settings_ );
							play_menu_sound();
						},
						6u -> { ToggleBooleanSetting</ "snd_flip_stereo" />( settings_ ); play_menu_sound(); },
						default -> {},
					}
				},
				Page::ExtraOptions ->
				{
					switch( extra_options_current_row_ )
					{
						0u -> { ToggleBooleanSetting</ "r_fog_enabled" />( settings_ ); play_menu_sound(); },
						1u -> { ToggleBooleanSetting</ "r_mirrors_enabled" />( settings_ ); play_menu_sound(); },
						2u ->
						{
							{
								auto mut lock= settings_.lock_mut();
								var f32 &mut mirror_alpha= lock.deref().r_mirror_alpha;
								mirror_alpha= ( ust::min( ust::floor( mirror_alpha * 16.0f ), 15.0f ) + 1.0f ) / 16.0f;
							}
							play_menu_sound();
						},
						3u -> { ToggleBooleanSetting</ "r_rain_snow_enabled" />( settings_ ); play_menu_sound(); },
						4u -> { ToggleBooleanSetting</ "r_caustics_enabled" />( settings_ ); play_menu_sound(); },
						5u -> { ToggleBooleanSetting</ "r_decals_enabled" />( settings_ ); play_menu_sound(); },
						6u ->
						{
							ToggleBooleanSetting</ "r_water_circle_decals_enabled" />( settings_ );
							play_menu_sound();
						},
						7u -> { ToggleBooleanSetting</ "r_dynamic_lights_enabled" />( settings_ ); play_menu_sound(); },
						8u -> { ToggleBooleanSetting</ "g_blood_enabled" />( settings_ ); play_menu_sound(); },
						9u ->
						{
							ToggleBooleanSetting</ "r_texture_trilinear_filter" />( settings_ );
							play_menu_sound();
						},
						10u ->
						{
							{
								auto mut lock= settings_.lock_mut();
								var u32 &mut anisotropy= lock.deref().r_texture_anisotropy;
								if( anisotropy < 16u )
								{
									++anisotropy;
								}
							}
							play_menu_sound();
						},
						11u ->
						{
							ToggleBooleanSetting</ "r_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						12u ->
						{
							ToggleBooleanSetting</ "r_hud_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						13u ->
						{
							ToggleBooleanSetting</ "r_gui_texture_nearest_filter" />( settings_ );
							play_menu_sound();
						},
						default -> {},
					}
				},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_BACKSPACE ->
		{
			if( current_page_ == Page::SaveGame )
			{
				if_var( &mut comment : load_save_pages_state_.input_slot_comment )
				{
					// Just remove last char. It's fine, since we allow only ASCII characters in save comments.

					var size_type mut comment_size= 0s;
					while( comment_size < typeinfo</ SaveComment />.element_count && comment[ comment_size ] != '\0' )
					{
						++comment_size;
					}

					if( comment_size > 0s )
					{
						comment[ comment_size - 1s ]= '\0';
					}
				}
			}
		},
		SDL_SCANCODE_GRAVE -> { /* Don't allow binding keys to '~'. */ },
		SDL_SCANCODE_Y ->
		{
			if( current_page_ == Page::Quit )
			{
				return CommandQuit{};
				// Don't play menu sound if quitting.
			}
			else
			{
				ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
			}
		},
		SDL_SCANCODE_N ->
		{
			if( current_page_ == Page::Quit )
			{
				current_page_= Page::MainMenu;
				play_menu_sound();
			}
			else
			{
				ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
			}
		},
		default ->
		{
			ActualizeCurrentKeyBinding( KeyBinding::CreateFromKeyScancode( key_sym.scancode ) );
		},
	}

	return CommandNone{};
}

fn Menu::ProcessMouseButtonPress( mut this, u32 button_index )
{
	ActualizeCurrentKeyBinding( KeyBinding::CreateFromMouseButton( button_index ) );
}

fn Menu::ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event )
{
	if( current_page_ == Page::SaveGame )
	{
		if_var( &mut comment : load_save_pages_state_.input_slot_comment )
		{
			var size_type mut comment_size= 0s;
			while( comment_size < typeinfo</ SaveComment />.element_count && comment[ comment_size ] != '\0' )
			{
				++comment_size;
			}

			foreach( c : text_input_event.text )
			{
				if( c == '\0' )
				{
					break;
				}

				if( comment_size >= typeinfo</ SaveComment />.element_count )
				{
					break;
				}

				// Allow only latin letters, whitespaces, digits for slot names.
				// Convert uppercase letters to lowercase.
				if( ( c >= 'a' & c <= 'z' ) | ( c >= '0' && c <= '9' ) | c == ' ' )
				{
					comment[ comment_size ]= c;
					++comment_size;
				}
				else if( c >= 'A' && c <= 'Z' )
				{
					comment[ comment_size ]= char8( u32(c) - u32( 'A' ) + u32( 'a' ) );
					++comment_size;
				}
			}
		}
	}
}

fn Menu::Update( mut this, f32 time_delta_s )
{
	time_s_+= time_delta_s;
}

fn Menu::Draw( mut this, ImageDrawer &mut image_drawer, TextDrawer &mut text_drawer )
{
	if( !images_preloaded_ )
	{
		PreloadMenuImages( image_drawer );
		images_preloaded_= true;
	}

	if( !IsActive() )
	{
		return;
	}

	var StringTable& string_table= string_table_.deref();

	// Use only integer scale, since we need to draw scaled texts and they look nice only in integer scales.
	var u32 scale= ust::max( 1u, ust::min( viewport_size_[0] / 400u, viewport_size_[1] / 300u ) );

	// Center horizontally.
	var i32 offset_x= i32( ( viewport_size_[0] - c_base_menu_size[0] * scale ) / 2u );
	// Move menu slightly upper relative to the screen center.
	var i32 offset_y= i32( ( viewport_size_[1] - c_base_menu_size[1] * scale ) * 3u / 4u );

	var u32 cursor_frame= u32( time_s_ * 16.0f ) % 16u;
	var u32 cursor_tile_x= cursor_frame % 8u;
	var u32 cursor_tile_y= ( cursor_frame / 8u ) ^ 1u;

	var u32 constexpr cursor_size= 24u, constexpr small_cursor_size= 12u;

	var u32 constexpr
		control_element_width= 80u,
		control_element_height= 15u,
		control_element_on_y= control_element_height * 9u,
		control_element_off_y= control_element_height * 8u,
		control_element_slider_background_y= control_element_height * 4u,
		control_element_slider_y= control_element_height * 3u;

	var i32 constexpr slider_start_offset= -64;
	var u32 constexpr slider_increment= 2u;

	var TextDrawer::Settings text_settings
	{
		.scale= scale,
		.monospace= false,
		.foreground_color[  20u8,  20u8,  20u8, 255u8 ],
		.background_color[ 200u8, 120u8, 120u8,   0u8 ],
	};

	var TextDrawer::Settings edited_text_settings
	{
		.scale= text_settings.scale,
		.monospace= text_settings.monospace,
		.foreground_color[  80u8,   0u8,   0u8, 255u8 ],
		.background_color= text_settings.background_color,
	};

	switch( current_page_ )
	{
		Page::None -> {},
		Page::MainMenu ->
		{
			image_drawer.DrawImage( MenuImages::main_menu_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 65u * scale );
			var i32 cursor_offset_y= offset_y + i32( 50u * scale );

			var u32 constexpr cursor_step_size= 16u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::main_menu - 1u - main_menu_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );
		},
		Page::NewGame ->
		{
			image_drawer.DrawImage( MenuImages::new_game_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 65u * scale );
			var i32 cursor_offset_y= offset_y + i32( 67u * scale );

			var u32 constexpr cursor_step_size= 19u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::new_game - 1u - new_game_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );
		},
		Page::LoadGame, Page::SaveGame ->
		{
			image_drawer.DrawImage(
				( current_page_ == Page::LoadGame
					? MenuImages::load_game_page_background
					: MenuImages::save_game_page_background ),
				offset_x,
				offset_y,
				f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 192u * scale );
			var i32 cursor_offset_y= offset_y + i32(  58u * scale );

			image_drawer.DrawImage(
				MenuImages::small_cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( TextDrawer::c_glyph_height * scale * ( c_num_load_save_slots - 1u - load_save_pages_state_.current_row ) ),
				f32( scale ),
				cursor_tile_x * small_cursor_size,
				cursor_tile_y * small_cursor_size,
				small_cursor_size,
				small_cursor_size );

			if( load_save_pages_state_.current_row < c_num_load_save_slots &&
				!load_save_pages_state_.slots[ load_save_pages_state_.current_row ].empty() )
			{
				if_var( &image : load_save_pages_state_.slot_images[ load_save_pages_state_.current_row ] )
				{
					if( image.size[0] != 0u && image.size[1] != 0u )
					{
						var [ u32, 2 ] target_size[ 176u * scale, 110u * scale ];
						var f32 image_scale=
							ust::min(
								f32( target_size[0] ) / f32( image.size[0] ),
								f32( target_size[1] ) / f32( image.size[1] ) );

						image_drawer.UploadAndDrawImage(
							image,
							offset_x + i32( 10u * scale ),
							offset_y + i32( 58u * scale ) + i32( target_size[1] ) - i32( f32( image.size[1] ) * image_scale ),
							image_scale );
					}
				}
			}

			for( auto mut i= 0u; i < c_num_load_save_slots; ++i )
			{
				var bool is_active_slot=
					i == load_save_pages_state_.current_row && !load_save_pages_state_.input_slot_comment.empty();

				auto& slot_summary_opt= load_save_pages_state_.slots[i];
				var ust::string_view8 mut comment=
					( is_active_slot
						? ust::string_view8( load_save_pages_state_.input_slot_comment.try_deref() )
						: ( slot_summary_opt.empty()
							? FetchStringFromTable( string_table, StringTableKey::EmptySlot )
							: ust::string_view8( slot_summary_opt.try_deref().comment ) ) );

				while( !comment.empty() && comment.back() == '\0' )
				{
					comment.drop_back();
				}

				var ust::string_view8 cursor=
					( ( is_active_slot && ( u32( time_s_ * 4.0f ) & 1u ) != 0u ) ? "_" : " " );

				scoped_array char8 comment_with_cursor[ comment.size() + 1s ]( comment.iter().chain( cursor.iter() ) );

				text_drawer.AddText(
					offset_x + i32( 208u * scale ),
					offset_y + i32(  60u * scale ) + i32( ( c_num_load_save_slots - 1u - i ) * TextDrawer::c_glyph_height * scale ),
					comment_with_cursor,
					( is_active_slot ? edited_text_settings : text_settings ) );
			}

			var i32 summary_offset_x= offset_x + i32( 40u * scale );
			var i32 summary_offset_y= offset_y + i32( 44u * scale );

			text_drawer.AddText(
				summary_offset_x,
				summary_offset_y,
				( current_page_ == Page::LoadGame
					?  FetchStringFromTable( string_table, StringTableKey::SelectSlotForLoadGame )
					: ( load_save_pages_state_.input_slot_comment.empty()
						? FetchStringFromTable( string_table, StringTableKey::SelectSlotForSaveGame )
						: FetchStringFromTable( string_table, StringTableKey::EnterNewName ) ) ),
				text_settings );

			if_var( &summary : load_save_pages_state_.slots[ load_save_pages_state_.current_row ] )
			{
				{
					var ust::string_view8 level_str= FetchStringFromTable( string_table, StringTableKey::Level1 );
					var ust::string_view8 level_name_str= summary.level_name;

					scoped_array char8 level_text[
						level_str.size() + level_name_str.size() ]( level_str.iter().chain( level_name_str.iter() ) );

					text_drawer.AddText(
						summary_offset_x,
						summary_offset_y - i32( TextDrawer::c_glyph_height * 1u * scale ),
						level_text,
						text_settings );
				}
				{
					var [ char8, 65 ] mut text= zero_init; // Assume it's enough space for skill and kills.
					var size_type mut text_size= 0s;

					foreach( c : FetchStringFromTable( string_table, StringTableKey::Skill1 ) )
					{
						text[ text_size ]= c;
						++text_size;
					}

					text[ text_size ]= char8( u32( '0' ) + summary.skill );
					++text_size;

					foreach( c : FetchStringFromTable( string_table, StringTableKey::Killed ) )
					{
						text[ text_size ]= c;
						++text_size;
					}

					text[ text_size ]= ( summary.kills[0] >= 10u ? char8( u32('0') + summary.kills[0] / 10u ) : ' ' );
					++text_size;
					text[ text_size ]= char8( u32('0') + summary.kills[0] % 10u );
					++text_size;

					foreach( c : FetchStringFromTable( string_table, StringTableKey::KilledSlash ) )
					{
						text[ text_size ]= c;
						++text_size;
					}

					text[ text_size ]= ( summary.kills[1] >= 10u ? char8( u32('0') + summary.kills[1] / 10u ) : ' ' );
					++text_size;
					text[ text_size ]= char8( u32('0') + summary.kills[1] % 10u );
					++text_size;

					text_drawer.AddText(
						summary_offset_x,
						summary_offset_y - i32( TextDrawer::c_glyph_height * 2u * scale ),
						ust::string_view8( text ).subrange_end( text_size ),
						text_settings );
				}
			}
		},
		Page::Multiplayer ->
		{
			image_drawer.DrawImage( MenuImages::multiplayer_page_background, offset_x, offset_y, f32( scale ) );

			text_drawer.AddText(
				offset_x + i32(  32u * scale ),
				offset_y + i32( 120u * scale ),
				"Multiplayer isn't implemented.",
				text_settings );
		},
		Page::Options ->
		{
			image_drawer.DrawImage( MenuImages::options_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 16u * scale );
			var i32 cursor_offset_y= offset_y + i32( 46u * scale );

			var u32 constexpr cursor_step_size= 15u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::options - 1u - options_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );

			var i32 control_elements_offset_x= offset_x + i32( 230u * scale );
			var i32 control_elements_offset_y= offset_y + i32( 50u * scale );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_background_y,
				control_element_width,
				control_element_height );

			var u32 mouse_sensitivity_slider_value=
				GetSliderPositionForValue( settings_.lock_imut().deref().in_mouse_sensitivity );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x + slider_start_offset * i32( scale ) + i32( mouse_sensitivity_slider_value * slider_increment * scale ),
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_y,
				control_element_width,
				control_element_height );

			// TODO - draw crosshair.

			// TODO - draw hud alignment.
		},
		Page::Controls ->
		{
			image_drawer.DrawImage( MenuImages::key_bindings_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32(  20u * scale );
			var i32 cursor_offset_y= offset_y + i32( 144u * scale );

			var u32 controls_rows_spacing= TextDrawer::c_glyph_height * 3u / 2u;

			image_drawer.DrawImage(
				MenuImages::small_cursor_frames,
				cursor_offset_x,
				cursor_offset_y - i32( controls_current_row_ * controls_rows_spacing * scale ),
				f32( scale ),
				cursor_tile_x * small_cursor_size,
				cursor_tile_y * small_cursor_size,
				small_cursor_size,
				small_cursor_size );

			var i32 texts_offset_x= cursor_offset_x + i32( 18u * scale );
			var i32 texts_offset_y= cursor_offset_y + i32(  1u * scale );

			text_drawer.AddText(
				texts_offset_x,
				texts_offset_y - i32( 0u * controls_rows_spacing * scale ),
				FetchStringFromExtraTable( ExtraStringTableKey::KeyBindings ),
				text_settings );

			{
				var ust::string_view8 mouse_look_str= FetchStringFromTable( string_table, StringTableKey::MouseLook );

				var ust::string_view8 state_str=
					FetchStringFromTable(
						string_table,
						( settings_.lock_imut().deref().in_mouse_enabled ? StringTableKey::On : StringTableKey::Off ) );

				scoped_array char8 mouse_look_state_str[ mouse_look_str.size() + state_str.size() ](
					mouse_look_str.iter().chain( state_str.iter() ) );

				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y - i32( 1u * controls_rows_spacing * scale ),
					mouse_look_state_str,
					text_settings );
			}
			{
				var ust::string_view8 invert_mouse_str= FetchStringFromTable( string_table, StringTableKey::InvertMouse );

				var ust::string_view8 state_str=
					FetchStringFromTable(
						string_table,
						( settings_.lock_imut().deref().in_invert_mouse_y_axis ? StringTableKey::On : StringTableKey::Off ) );

				scoped_array char8 invert_mouse_state_str[ invert_mouse_str.size() + state_str.size() ](
					invert_mouse_str.iter().chain( state_str.iter() ) );

				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y - i32( 2u * controls_rows_spacing * scale ),
					invert_mouse_state_str,
					text_settings );
			}
			{
				var ust::string_view8 always_run_str= FetchStringFromTable( string_table, StringTableKey::AlwaysRun );

				var ust::string_view8 state_str=
					FetchStringFromTable(
						string_table,
						( settings_.lock_imut().deref().in_always_run ? StringTableKey::On : StringTableKey::Off ) );

				scoped_array char8 always_run_state_str[ always_run_str.size() + state_str.size() ](
					always_run_str.iter().chain( state_str.iter() ) );

				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y - i32( 3u * controls_rows_spacing * scale ),
					always_run_state_str,
					text_settings );
			}
		},
		Page::KeyBindings ->
		{
			image_drawer.DrawImage( MenuImages::key_bindings_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32(  20u * scale );
			var i32 cursor_offset_y= offset_y + i32( 144u * scale );

			var u32 key_bindings_rows_spacing= TextDrawer::c_glyph_height * 3u / 2u;

			var i32 cursor_visible_row=
				i32( key_bindings_page_state_.current_row ) - i32( key_bindings_page_state_.rows_offset );

			image_drawer.DrawImage(
				MenuImages::small_cursor_frames,
				cursor_offset_x,
				cursor_offset_y - cursor_visible_row * i32( key_bindings_rows_spacing * scale ),
				f32( scale ),
				cursor_tile_x * small_cursor_size,
				cursor_tile_y * small_cursor_size,
				small_cursor_size,
				small_cursor_size );

			var i32 texts_offset_x= cursor_offset_x + i32( 18u * scale );
			var i32 texts_offset_y= cursor_offset_y + i32(  1u * scale );

			var ust::string_view8 scroll_indicator_text= ". . . . . . . . . . . . . . . . . . . . . . . . . . . . .";

			if( key_bindings_page_state_.rows_offset > 0u )
			{
				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y + i32( key_bindings_rows_spacing * scale ),
					scroll_indicator_text,
					text_settings );
			}

			auto settings_lock= settings_.lock_imut();
			var Settings& settings= settings_lock.deref();

			var ust::string_view8 blinking_cursor= ( ( ( u32( time_s_ * 4.0f ) & 1u ) != 0u ) ? "___" : "   " );

			var u32 mut row= 0u;

			foreach( &key_bindig : c_key_binding_rows )
			{
				var i32 visible_row= i32(row) - i32( key_bindings_page_state_.rows_offset );

				if( visible_row >= 0 && visible_row < i32( c_num_visible_key_binding_rows ) )
				{
					var i32 row_y= texts_offset_y - visible_row * i32( key_bindings_rows_spacing * scale );

					var bool is_edited_row= key_bindings_page_state_.editing_active & row == key_bindings_page_state_.current_row;

					var TextDrawer::Settings& key_binding_text_settings=
						( is_edited_row ? edited_text_settings : text_settings );

					text_drawer.AddText(
						texts_offset_x,
						row_y,
						FetchStringFromExtraTable( key_bindig[1] ),
						key_binding_text_settings );

					text_drawer.AddText(
						texts_offset_x + i32( 120u * scale ),
						row_y,
						( is_edited_row ? blinking_cursor : mixin( "settings." + key_bindig[0] + ".GetName()" ) ),
						key_binding_text_settings );
				}

				++row;
			}

			if( key_bindings_page_state_.rows_offset + c_num_visible_key_binding_rows < PageNumRows::key_bindings )
			{
				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y - i32( key_bindings_rows_spacing * scale * c_num_visible_key_binding_rows ),
					scroll_indicator_text,
					text_settings );
			}
		},
		Page::VideoSettings ->
		{
			image_drawer.DrawImage( MenuImages::video_settings_page_background, offset_x, offset_y, f32( scale ) );

			var u32 video_settings_rows_spacing= TextDrawer::c_glyph_height * 3u / 2u;

			var i32 cursor_offset_x= offset_x + i32(  24u * scale );
			var i32 cursor_offset_y= offset_y + i32( 156u * scale );

			image_drawer.DrawImage(
				MenuImages::small_cursor_frames,
				cursor_offset_x,
				cursor_offset_y - i32( video_settings_rows_spacing * scale *  video_settings_page_state_.current_row ),
				f32( scale ),
				cursor_tile_x * small_cursor_size,
				cursor_tile_y * small_cursor_size,
				small_cursor_size,
				small_cursor_size );

			var i32 texts_offset_x= cursor_offset_x + i32( 18u * scale );
			var i32 texts_offset_y= cursor_offset_y + i32( 1u * scale );

			{
				var ust::string_view8 fullscreen_str= FetchStringFromExtraTable( ExtraStringTableKey::Fullscreen );

				var ust::string_view8 state_str=
					FetchStringFromTable(
						string_table,
						( settings_.lock_imut().deref().r_fullscreen ? StringTableKey::On : StringTableKey::Off ) );

				scoped_array char8 fullscreen_state_str[ fullscreen_str.size() + state_str.size() ](
					fullscreen_str.iter().chain( state_str.iter() ) );

				text_drawer.AddText( texts_offset_x, texts_offset_y, fullscreen_state_str, text_settings );
			}
			{
				var ust::string_view8 display_str= FetchStringFromExtraTable( ExtraStringTableKey::Display );

				var [ char8, 1 ] display_index[ ( u32('0') + settings_.lock_imut().deref().r_display_index ) ];
				var ust::string_view8 display_index_str= display_index;

				scoped_array char8 display_state_str[ display_str.size() + display_index_str.size() ](
					display_str.iter().chain( display_index_str.iter() ) );

				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y - i32( 1u * video_settings_rows_spacing * scale ),
					display_state_str,
					text_settings );
			}
			{
				var [ char8, 64 ] mut str= zero_init; // Assume it's enough chars.
				var size_type mut str_size= 0s;

				var ust::string_view8 mode_str= FetchStringFromExtraTable( ExtraStringTableKey::Mode );

				foreach( c : mode_str )
				{
					str[ str_size ]= c;
					++str_size;
				}

				auto settings_lock= settings_.lock_imut();
				var Settings& settings= settings_lock.deref();

				if( settings.r_screen_width == 0u | settings.r_screen_height == 0u )
				{
					// If screen width or height is set to height - it's a mode with auto-calculated size.
					foreach( c : FetchStringFromExtraTable( ExtraStringTableKey::AutoMode ) )
					{
						str[ str_size ]= c;
						++str_size;
					}
				}
				else
				{
					if( settings.r_screen_width >= 1000u )
					{
						str[ str_size ]= char8( u32( '0' ) + settings.r_screen_width / 1000u % 10u );
						++str_size;
					}
					str[ str_size ]= char8( u32( '0' ) + settings.r_screen_width /  100u % 10u );
					++str_size;
					str[ str_size ]= char8( u32( '0' ) + settings.r_screen_width /   10u % 10u );
					++str_size;
					str[ str_size ]= char8( u32( '0' ) + settings.r_screen_width /    1u % 10u );
					++str_size;

					str[ str_size ]= 'x';
					++str_size;

					if( settings.r_screen_height >= 1000u )
					{
						str[ str_size ]= char8( u32( '0' ) + settings.r_screen_height / 1000u % 10u );
						++str_size;
					}
					str[ str_size ]= char8( u32( '0' ) + settings.r_screen_height /  100u % 10u );
					++str_size;
					str[ str_size ]= char8( u32( '0' ) + settings.r_screen_height /   10u % 10u );
					++str_size;
					str[ str_size ]= char8( u32( '0' ) + settings.r_screen_height /    1u % 10u );
					++str_size;
				}

				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y - i32( 2u * video_settings_rows_spacing * scale ),
					str,
					text_settings );
			}
			{
				var ust::string_view8 vsync_str= FetchStringFromExtraTable( ExtraStringTableKey::VerticalSynchronization );

				var ust::string_view8 state_str=
					FetchStringFromTable(
						string_table,
						( settings_.lock_imut().deref().r_vsync ? StringTableKey::On : StringTableKey::Off ) );

				scoped_array char8 vsync_state_str[ vsync_str.size() + state_str.size() ](
					vsync_str.iter().chain( state_str.iter() ) );

				text_drawer.AddText(
					texts_offset_x,
					texts_offset_y - i32( 3u * video_settings_rows_spacing * scale ),
					vsync_state_str,
					text_settings );
			}

			text_drawer.AddText(
				offset_x + i32( 24u * scale ),
				offset_y + i32( 50u * scale ),
				FetchStringFromExtraTable( ExtraStringTableKey::ChangesWillBeAppliedAfterGameRestart ),
				text_settings );
		},
		Page::SoundSettings ->
		{
			image_drawer.DrawImage( MenuImages::sound_settings_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 16u * scale );
			var i32 cursor_offset_y= offset_y + i32( 51u * scale );

			var u32 constexpr cursor_step_size= 15u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::sound_settings - 1u - sound_settings_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );

			var i32 control_elements_offset_x= offset_x + i32( 230u * scale );
			var i32 control_elements_offset_y= offset_y + i32( 56u * scale );

			auto settings_lock= settings_.lock_imut();
			var Settings& settings= settings_lock.deref();

			image_drawer.DrawImage(
				MenuImages::control_elements,
