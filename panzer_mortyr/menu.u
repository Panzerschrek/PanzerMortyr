import "/scoped_array.iu"
import "/common_lib/game_params_file.iu"
import "menu.iu"
import "save_load.iu"

namespace PM
{

fn Menu::constructor( SettingsPtr mut settings, [ u32, 2 ] viewport_size )
	(
		settings_= move(settings),
		viewport_size_= viewport_size,
		images_preloaded_= false,
		current_page_= Page::MainMenu,
		time_s_= 0.0f,
		main_menu_current_row_= 0u,
		new_game_current_row_= 0u,
		load_save_menu_state_{ .current_row= 0u },
		options_current_row_= 0u,
		controls_current_row_= 0u,
		sound_settings_current_row_= 0u,
		advanced_options_current_row_= 0u,
		quit_message_index_= 1000u,
	)
{}

fn Menu::IsActive( this ) : bool
{
	return current_page_ != Page::None;
}

fn Menu::Activate( mut this )
{
	current_page_= Page::MainMenu;
}

fn Menu::Deactivate( mut this )
{
	current_page_= Page::None;
}

fn nodiscard Menu::ProcessKeyPress( mut this, SDL_Keysym& key_sym, AudioProcessor &mut audio_processor ) : Command
{
	switch( key_sym.scancode )
	{
		SDL_SCANCODE_ESCAPE ->
		{
			audio_processor.PlayMenuSound();

			switch( current_page_ )
			{
				Page::None -> { current_page_= Page::MainMenu; },
				Page::MainMenu -> { current_page_= Page::None; },
				Page::NewGame -> { current_page_= Page::MainMenu; },
				Page::LoadGame -> { current_page_= Page::MainMenu; },
				Page::SaveGame ->
				{
					if( !load_save_menu_state_.input_slot_comment.empty() )
					{
						// Discard edited changes.
						load_save_menu_state_.input_slot_comment.reset();
					}
					else
					{
						current_page_= Page::MainMenu;
					}
				},
				Page::Options -> { current_page_= Page::MainMenu; },
				Page::Controls -> { current_page_= Page::Options; },
				Page::VideoSettings -> { current_page_= Page::Options; },
				Page::SoundSettings -> { current_page_= Page::Options; },
				Page::AdvancedOptions -> { current_page_= Page::Options; },
				Page::Quit -> { current_page_= Page::MainMenu; },
			}
		},
		SDL_SCANCODE_RETURN ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu ->
				{
					switch( main_menu_current_row_ )
					{
						0u -> { current_page_= Page::NewGame; audio_processor.PlayMenuSound(); },
						1u ->
						{
							current_page_= Page::LoadGame;
							audio_processor.PlayMenuSound();

							// Load save summaries upon entering the load page.
							LoadSaveSummaries();
						},
						2u ->
						{
							current_page_= Page::SaveGame;
							audio_processor.PlayMenuSound();

							// Load save summaries upon entering the save page.
							LoadSaveSummaries();
						},
						3u -> { /* TODO - switch to multiplayer page */ },
						4u -> { current_page_= Page::Options; audio_processor.PlayMenuSound(); },
						5u ->
						{
							current_page_= Page::Quit;

							audio_processor.PlayMenuSound();

							// Pseudo-random time-based selection of quit message.
							var u32 mut new_index= u32( time_s_ * 17.0f ) % c_num_quit_messages;
							if( new_index == quit_message_index_ )
							{
								new_index= ( new_index + 1u ) % c_num_quit_messages;
							}

							quit_message_index_= new_index;
						},
						default -> {},
					}
				},
				Page::NewGame ->
				{
					current_page_= Page::None;

					audio_processor.PlayMenuSound();

					return CommandNewGame{ .skill= new_game_current_row_ };
				},
				Page::LoadGame ->
				{
					if( !load_save_menu_state_.slot_comments[ load_save_menu_state_.current_row ].empty() )
					{
						current_page_= Page::None;

						audio_processor.PlayMenuSound();

						return CommandLoadGame{ .slot_name= GetSaveNameForSlot( load_save_menu_state_.current_row ) };
					}
				},
				Page::SaveGame ->
				{
					audio_processor.PlayMenuSound();

					if( load_save_menu_state_.input_slot_comment.empty() )
					{
						// Start editing.
						load_save_menu_state_.input_slot_comment=
							load_save_menu_state_.slot_comments[ load_save_menu_state_.current_row ].deref_or( ust::make_zeroed</SaveComment/>() );
					}
					else
					{
						// End editing and update slot name.

						var SaveComment save_comment= load_save_menu_state_.input_slot_comment.try_deref();
						load_save_menu_state_.input_slot_comment.reset();

						load_save_menu_state_.slot_comments[ load_save_menu_state_.current_row ]= save_comment;

						current_page_= Page::None;

						return CommandSaveGame
						{
							.slot_name= GetSaveNameForSlot( load_save_menu_state_.current_row ),
							.save_comment= save_comment
						};
					}

				},
				Page::Options ->
				{
					switch( options_current_row_ )
					{
						0u -> { current_page_= Page::Controls; audio_processor.PlayMenuSound(); },
						1u -> { current_page_= Page::VideoSettings; audio_processor.PlayMenuSound(); },
						2u -> { current_page_= Page::SoundSettings; audio_processor.PlayMenuSound(); },
						3u -> { /* Do nothing for mouse sensitivity. */ },
						4u -> { /* TODO - change HUD position. */ },
						5u -> { /* TODO - change crosshair. */ },
						6u -> { /* TODO - switch to parental lock menu. */ },
						7u-> { current_page_= Page::AdvancedOptions; audio_processor.PlayMenuSound(); },
						default -> {},
					}
				},
				Page::Controls ->
				{
					// TODO
				},
				Page::VideoSettings ->
				{
					// TODO
				},
				Page::SoundSettings ->
				{
					switch( sound_settings_current_row_ )
					{
						0u -> { ChangeSoundEnabled( settings_ ); audio_processor.PlayMenuSound(); },
						1u -> { ChangeAmbientSoundEnabled( settings_ ); audio_processor.PlayMenuSound(); },
						2u -> { /* don't change a slider option via "enter" */ },
						3u -> { /* don't change a slider option via "enter" */ },
						4u -> { /* TODO - CD music */ },
						5u -> { /* TODO - Mortyr's voice */ },
						6u -> { ChangeFlipStereo( settings_ ); audio_processor.PlayMenuSound(); },
						default -> {},
					}
				},
				Page::AdvancedOptions ->
				{
					// TODO
				},
				Page::Quit ->
				{
					return CommandQuit{};
				},
			}
		},
		SDL_SCANCODE_UP ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu ->
				{
					DecrementRow( main_menu_current_row_, PageNumRows::main_menu );
					audio_processor.PlayMenuSound();
				},
				Page::NewGame ->
				{
					DecrementRow( new_game_current_row_, PageNumRows::new_game );
					audio_processor.PlayMenuSound();
				},
				Page::LoadGame, Page::SaveGame ->
				{
					if( load_save_menu_state_.input_slot_comment.empty() )
					{
						DecrementRow( load_save_menu_state_.current_row, c_num_load_save_slots );
						audio_processor.PlayMenuSound();
					}
				},
				Page::Options ->
				{
					DecrementRow( options_current_row_, PageNumRows::options );
					audio_processor.PlayMenuSound();
				},
				Page::Controls ->
				{
					DecrementRow( controls_current_row_, PageNumRows::controls );
					audio_processor.PlayMenuSound();
				},
				Page::VideoSettings ->
				{
					// TODO
				},
				Page::SoundSettings ->
				{
					DecrementRow( sound_settings_current_row_, PageNumRows::sound_settings );
					audio_processor.PlayMenuSound();
				},
				Page::AdvancedOptions ->
				{
					DecrementRow( advanced_options_current_row_, PageNumRows::advanced_options );
					audio_processor.PlayMenuSound();
				},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_DOWN ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu ->
				{
					IncrementRow( main_menu_current_row_, PageNumRows::main_menu );
					audio_processor.PlayMenuSound();
				},
				Page::NewGame ->
				{
					IncrementRow( new_game_current_row_, PageNumRows::new_game );
					audio_processor.PlayMenuSound();
				},
				Page::LoadGame, Page::SaveGame ->
				{
					if( load_save_menu_state_.input_slot_comment.empty() )
					{
						IncrementRow( load_save_menu_state_.current_row, c_num_load_save_slots );
						audio_processor.PlayMenuSound();
					}
				},
				Page::Options ->
				{
					IncrementRow( options_current_row_, PageNumRows::options );
					audio_processor.PlayMenuSound();
				},
				Page::Controls ->
				{
					IncrementRow( controls_current_row_, PageNumRows::controls );
					audio_processor.PlayMenuSound();
				},
				Page::VideoSettings ->
				{
					// TODO
				},
				Page::SoundSettings ->
				{
					IncrementRow( sound_settings_current_row_, PageNumRows::sound_settings );
					audio_processor.PlayMenuSound();
				},
				Page::AdvancedOptions ->
				{
					IncrementRow( advanced_options_current_row_, PageNumRows::advanced_options );
					audio_processor.PlayMenuSound();
				},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_LEFT ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu -> {},
				Page::NewGame -> {},
				Page::LoadGame, Page::SaveGame -> {},
				Page::Options ->
				{
					switch( options_current_row_ )
					{
						// TODO - change boolean values.
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								DecrementSliderValueForPercents( lock.deref().in_mouse_sensitivity );
							}
							audio_processor.PlayMenuSound();
						},
						default -> {},
					}
				},
				Page::Controls -> {},
				Page::VideoSettings -> {},
				Page::SoundSettings ->
				{
					switch( sound_settings_current_row_ )
					{
						0u -> { ChangeSoundEnabled( settings_ ); audio_processor.PlayMenuSound(); },
						1u -> { ChangeAmbientSoundEnabled( settings_ ); audio_processor.PlayMenuSound(); },
						2u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								DecrementSliderValueForPercents( lock.deref().snd_volume );
							}
							audio_processor.PlayMenuSound();
						},
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								DecrementSliderValueForPercents( lock.deref().snd_ambient_volume );
							}
							audio_processor.PlayMenuSound();
						},
						4u -> { /* TODO - CD music */ },
						5u -> { /* TODO - Mortyr's voice */ },
						6u -> { ChangeFlipStereo( settings_ ); audio_processor.PlayMenuSound(); },
						default -> {},
					}
				},
				Page::AdvancedOptions -> {},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_RIGHT ->
		{
			switch( current_page_ )
			{
				Page::None -> {},
				Page::MainMenu -> {},
				Page::NewGame -> {},
				Page::LoadGame, Page::SaveGame -> {},
				Page::Options ->
				{
					switch( options_current_row_ )
					{
						// TODO - change boolean values.
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								IncrementSliderValueForPercents( lock.deref().in_mouse_sensitivity );
							}
							audio_processor.PlayMenuSound();
						},
						default -> {},
					}
				},
				Page::Controls -> {},
				Page::VideoSettings -> {},
				Page::SoundSettings ->
				{
					switch( sound_settings_current_row_ )
					{
						0u -> { ChangeSoundEnabled( settings_ ); audio_processor.PlayMenuSound(); },
						1u -> { ChangeAmbientSoundEnabled( settings_ ); audio_processor.PlayMenuSound(); },
						2u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								IncrementSliderValueForPercents( lock.deref().snd_volume );
							}
							audio_processor.PlayMenuSound();
						},
						3u ->
						{
							with( mut lock : settings_.lock_mut() )
							{
								IncrementSliderValueForPercents( lock.deref().snd_ambient_volume );
							}
							audio_processor.PlayMenuSound();
						},
						4u -> { /* TODO - CD music */ },
						5u -> { /* TODO - Mortyr's voice */ },
						6u -> { ChangeFlipStereo( settings_ ); audio_processor.PlayMenuSound(); },
						default -> {},
					}
				},
				Page::AdvancedOptions -> {},
				Page::Quit -> {},
			}
		},
		SDL_SCANCODE_BACKSPACE ->
		{
			if( current_page_ == Page::SaveGame )
			{
				if_var( &mut comment : load_save_menu_state_.input_slot_comment )
				{
					var size_type mut comment_size= 0s;
					while( comment_size < typeinfo</ SaveComment />.element_count && comment[ comment_size ] != '\0' )
					{
						++comment_size;
					}

					if( comment_size > 0s )
					{
						comment[ comment_size - 1s ]= '\0';
					}
				}
			}
		},
		SDL_SCANCODE_Y ->
		{
			if( current_page_ == Page::Quit )
			{
				return CommandQuit{};
				// Don't play menu sound if quitting.
			}
		},
		SDL_SCANCODE_N ->
		{
			if( current_page_ == Page::Quit )
			{
				current_page_= Page::MainMenu;
				audio_processor.PlayMenuSound();
			}
		},
		default -> {},
	}

	return CommandNone{};
}

fn Menu::ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event )
{
	if( current_page_ == Page::SaveGame)
	{
		if_var( &mut comment : load_save_menu_state_.input_slot_comment )
		{
			var size_type mut comment_size= 0s;
			while( comment_size < typeinfo</ SaveComment />.element_count && comment[ comment_size ] != '\0' )
			{
				++comment_size;
			}

			foreach( c : text_input_event.text )
			{
				if( c == '\0' )
				{
					break;
				}

				if( comment_size >= typeinfo</ SaveComment />.element_count )
				{
					break;
				}

				// Allow only latin letters, whitespaces, digits for slot names.
				// Convert uppercase letters to lowercase.
				if( ( c >= 'a' & c <= 'z' ) | ( c >= '0' && c <= '9' ) | c == ' ' )
				{
					comment[ comment_size ]= c;
					++comment_size;
				}
				else if( c >= 'A' && c <= 'Z' )
				{
					comment[ comment_size ]= char8( u32(c) - u32( 'A' ) + u32( 'a' ) );
					++comment_size;
				}
			}
		}
	}
}

fn Menu::Update( mut this, f32 time_delta_s )
{
	time_s_+= time_delta_s;
}

fn Menu::Draw( mut this, ImageDrawer &mut image_drawer, TextDrawer &mut text_drawer )
{
	if( !images_preloaded_ )
	{
		PreloadMenuImages( image_drawer );
		images_preloaded_= true;
	}

	if( !IsActive() )
	{
		return;
	}

	// Use only integer scale, since we need to draw scaled texts and they look nice only in integer scales.
	var u32 scale= ust::max( 1u, ust::min( viewport_size_[0] / 400u, viewport_size_[1] / 300u ) );

	// Center horizontally.
	var i32 offset_x= i32( ( viewport_size_[0] - c_base_menu_size[0] * scale ) / 2u );
	// Move menu slightly upper relative to the screen center.
	var i32 offset_y= i32( ( viewport_size_[1] - c_base_menu_size[1] * scale ) * 3u / 4u );

	var u32 cursor_frame= u32( time_s_ * 16.0f ) % 16u;
	var u32 cursor_tile_x= cursor_frame % 8u;
	var u32 cursor_tile_y= ( cursor_frame / 8u ) ^ 1u;

	var u32 constexpr cursor_size= 24u, constexpr small_cursor_size= 12u;

	var u32 constexpr
		control_element_width= 80u,
		control_element_height= 15u,
		control_element_on_y= control_element_height * 9u,
		control_element_off_y= control_element_height * 8u,
		control_element_slider_background_y= control_element_height * 4u,
		control_element_slider_y= control_element_height * 3u;

	var i32 constexpr slider_start_offset= -64;
	var u32 constexpr slider_increment= 2u;

	var TextDrawer::Settings text_settings
	{
		.scale= scale,
		.monospace= false,
		.foreground_color[  20u8,  20u8,  20u8, 255u8 ],
		.background_color[ 200u8, 120u8, 120u8,   0u8 ],
	};

	var TextDrawer::Settings edited_text_settings
	{
		.scale= text_settings.scale,
		.monospace= text_settings.monospace,
		.foreground_color[  80u8,   0u8,   0u8, 255u8 ],
		.background_color= text_settings.background_color,
	};

	switch( current_page_ )
	{
		Page::None -> {},
		Page::MainMenu ->
		{
			image_drawer.DrawImage( MenuImages::main_menu_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 65u * scale );
			var i32 cursor_offset_y= offset_y + i32( 50u * scale );

			var u32 constexpr cursor_step_size= 16u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::main_menu - 1u - main_menu_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );
		},
		Page::NewGame ->
		{
			image_drawer.DrawImage( MenuImages::new_game_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 65u * scale );
			var i32 cursor_offset_y= offset_y + i32( 67u * scale );

			var u32 constexpr cursor_step_size= 19u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::new_game - 1u - new_game_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );
		},
		Page::LoadGame, Page::SaveGame ->
		{
			image_drawer.DrawImage(
				( current_page_ == Page::LoadGame
					? MenuImages::load_game_page_background
					: MenuImages::save_game_page_background ),
				offset_x,
				offset_y,
				f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 192u * scale );
			var i32 cursor_offset_y= offset_y + i32( 57u * scale );

			image_drawer.DrawImage(
				MenuImages::small_cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( TextDrawer::c_glyph_height * scale * ( c_num_load_save_slots - 1u - load_save_menu_state_.current_row ) ),
				f32( scale ),
				cursor_tile_x * small_cursor_size,
				cursor_tile_y * small_cursor_size,
				small_cursor_size,
				small_cursor_size );

			for( auto mut i= 0u; i < c_num_load_save_slots; ++i )
			{
				var bool is_active_slot= i == load_save_menu_state_.current_row && !load_save_menu_state_.input_slot_comment.empty();

				auto& slot_name_opt= load_save_menu_state_.slot_comments[i];
				var SaveComment save_comment=
					( is_active_slot
						? cast_imut( load_save_menu_state_.input_slot_comment.try_deref() )
						: ( slot_name_opt.empty()
							? "empty slot...\0\0\0"
							: slot_name_opt.try_deref() ) );

				var size_type mut save_comment_size= 0s;
				while( save_comment_size < typeinfo</ SaveComment />.element_count && save_comment[ save_comment_size ] != '\0' )
				{
					++save_comment_size;
				}

				var ust::string_view8 safe_comment_truncated=
					ust::string_view8( save_comment ).subrange_end( save_comment_size );

				var ust::string_view8 cursor=
					( ( is_active_slot && ( u32( time_s_ * 4.0f ) & 1u ) != 0u ) ? "_" : " " );

				scoped_array char8 slot_name_with_cursor[ safe_comment_truncated.size() + 1s ]( safe_comment_truncated.iter().chain( cursor.iter() ) );

				text_drawer.AddText(
					offset_x + 208 * i32(scale),
					offset_y + 58 * i32(scale) + i32( ( c_num_load_save_slots - 1u - i ) * TextDrawer::c_glyph_height * scale ),
					slot_name_with_cursor,
					( is_active_slot ? edited_text_settings : text_settings ) );
			}
		},
		Page::Options ->
		{
			image_drawer.DrawImage( MenuImages::options_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 16u * scale );
			var i32 cursor_offset_y= offset_y + i32( 46u * scale );

			var u32 constexpr cursor_step_size= 15u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::options - 1u - options_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );

			var i32 control_elements_offset_x= offset_x + i32( 230u * scale );
			var i32 control_elements_offset_y= offset_y + i32( 50u * scale );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_background_y,
				control_element_width,
				control_element_height );

			var u32 mouse_sensitivity_slider_value=
				ConvertPercentsToSliderValue( settings_.lock_imut().deref().in_mouse_sensitivity );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x + slider_start_offset * i32( scale ) + i32( mouse_sensitivity_slider_value * slider_increment * scale ),
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_y,
				control_element_width,
				control_element_height );

			// TODO - draw crosshair.

			// TODO - draw hud alignment.
		},
		Page::Controls ->
		{
			image_drawer.DrawImage( MenuImages::controls_page_background, offset_x, offset_y, f32( scale ) );

			text_drawer.AddText( offset_x + 32 * i32(scale), offset_y + 100 * i32(scale), "Control settings are not implemented yet", text_settings );
		},
		Page::VideoSettings ->
		{
			image_drawer.DrawImage( MenuImages::video_settings_page_background, offset_x, offset_y, f32( scale ) );

			// TODO - implement proper video settings.

			text_drawer.AddText( offset_x + 32 * i32(scale), offset_y + 100 * i32(scale), "Video settings are not implemented yet", text_settings );
		},
		Page::SoundSettings ->
		{
			image_drawer.DrawImage( MenuImages::sound_settings_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 16u * scale );
			var i32 cursor_offset_y= offset_y + i32( 51u * scale );

			var u32 constexpr cursor_step_size= 15u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::sound_settings - 1u - sound_settings_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );

			var i32 control_elements_offset_x= offset_x + i32( 230u * scale );
			var i32 control_elements_offset_y= offset_y + i32( 56u * scale );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 6u ),
				f32( scale ),
				0u,
				( settings_.lock_imut().deref().snd_audio_enabled ? control_element_on_y : control_element_off_y ),
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 5u ),
				f32( scale ),
				0u,
				( settings_.lock_imut().deref().snd_ambient_sound_enabled ? control_element_on_y : control_element_off_y ),
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_background_y,
				control_element_width,
				control_element_height );

			var u32 volume_slider_value=
				ConvertPercentsToSliderValue( settings_.lock_imut().deref().snd_volume );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x + slider_start_offset * i32( scale ) + i32( volume_slider_value * slider_increment * scale ),
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_y,
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 3u ),
				f32( scale ),
				0u,
				control_element_slider_background_y,
				control_element_width,
				control_element_height );

			var u32 ambient_volume_slider_value=
				ConvertPercentsToSliderValue( settings_.lock_imut().deref().snd_ambient_volume );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x + slider_start_offset * i32( scale ) + i32( ambient_volume_slider_value * slider_increment * scale ),
				control_elements_offset_y + i32( scale * cursor_step_size * 3u ),
				f32( scale ),
				0u,
				control_element_slider_y,
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 2u ),
				f32( scale ),
				0u,
				control_element_off_y, // For now we have no music.
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 1u ),
				f32( scale ),
				0u,
				control_element_on_y, // For now Mortyr's voice is always enabled.
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 0u ),
				f32( scale ),
				0u,
				( settings_.lock_imut().deref().snd_flip_stereo ? control_element_on_y : control_element_off_y ),
				control_element_width,
				control_element_height );
		},
		Page::AdvancedOptions ->
		{
			image_drawer.DrawImage( MenuImages::advanced_options_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 18u * scale );
			var i32 cursor_offset_y= offset_y + i32( 30u * scale );

			var u32 constexpr cursor_step_size= 15u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( PageNumRows::advanced_options - 1u - advanced_options_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );

			var i32 control_elements_offset_x= offset_x + i32( 230u * scale );
			var i32 control_elements_offset_y= offset_y + i32( 34u * scale );

			// TODO - use real states.
			var [ bool, PageNumRows::advanced_options ] row_states[ false, true, true, false, true, true, true, false, false ];

			for( auto mut i= 0u; i < PageNumRows::advanced_options; ++i )
			{
				image_drawer.DrawImage(
					MenuImages::control_elements,
					control_elements_offset_x,
					control_elements_offset_y + i32( scale * cursor_step_size * i ),
					f32( scale ),
					0u,
					( row_states[i] ? control_element_on_y : control_element_off_y ),
					control_element_width,
					control_element_height );
			}
		},
		Page::Quit ->
		{
			if_var( &image_size : image_drawer.GetImageSize( MenuImages::quit_texts ) )
			{
				var u32 message_height= image_size[1] / c_num_quit_messages;

				image_drawer.DrawImage(
					MenuImages::quit_texts,
					// Draw the message slightly above screen center.
					i32( ( viewport_size_[0] - image_size[0] * scale ) / 2u ),
					i32( viewport_size_[1] / 2u ),
					f32( scale ),
					0u,
					message_height * quit_message_index_,
					image_size[0],
					message_height );
			}
		},
	}
}

fn Menu::LoadSaveSummaries( mut this )
{
	for( auto mut i= 0u; i < c_num_load_save_slots; ++i )
	{
		var ust::optional</SaveComment/> &mut comment= load_save_menu_state_.slot_comments[i];

		if_var( &save_summary : LoadSaveSummary( GetSaveNameForSlot( i ) ) )
		{
			comment= save_summary.comment;
		}
		else
		{
			comment= ust::null_optional;
		}
	}
}

fn IncrementRow( u32 &mut row, u32 num_rows )
{
	row= ( row + 1u ) % num_rows;
}

fn DecrementRow( u32 &mut row, u32 num_rows )
{
	row= ( row + ( num_rows - 1u ) ) % num_rows;
}

fn PreloadMenuImages( ImageDrawer &mut image_drawer )
{
	image_drawer.PreloadImage( MenuImages::main_menu_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::new_game_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::load_game_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::save_game_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::options_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::controls_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::video_settings_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::sound_settings_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::advanced_options_page_background, ust::null_optional_ref );
	image_drawer.PreloadImage( MenuImages::cursor_frames, ust::make_array( 0u8, 100u8, 255u8 ) );
	image_drawer.PreloadImage( MenuImages::small_cursor_frames, ust::make_array( 0u8, 100u8, 255u8 ) );
	image_drawer.PreloadImage( MenuImages::control_elements, ust::make_array( 255u8, 0u8, 0u8 ) ); // TODO - fix this for the polish version, it uses green transparent color.
	image_drawer.PreloadImage( MenuImages::quit_texts, ust::make_array( 0u8, 0u8, 0u8 ) );
}

fn ChangeSoundEnabled( SettingsPtr& settings )
{
	auto mut lock= settings.lock_mut();
	ChangeBooleanSettingsFlag( lock.deref().snd_audio_enabled );
}

fn ChangeAmbientSoundEnabled( SettingsPtr& settings )
{
	auto mut lock= settings.lock_mut();
	ChangeBooleanSettingsFlag( lock.deref().snd_ambient_sound_enabled );
}

fn ChangeFlipStereo( SettingsPtr& settings )
{
	auto mut lock= settings.lock_mut();
	ChangeBooleanSettingsFlag( lock.deref().snd_flip_stereo );
}

fn ChangeBooleanSettingsFlag( bool &mut flag )
{
	flag ^= true;
}

fn IncrementSliderValueForPercents( u32 &mut percents )
{
	var u32 slider_value= ConvertPercentsToSliderValue( percents );
	loop
	{
		if( percents >= 100u )
		{
			break;
		}
		++percents;

		if( ConvertPercentsToSliderValue( percents ) > slider_value )
		{
			break;
		}
	}
}

fn DecrementSliderValueForPercents( u32 &mut percents )
{
	var u32 slider_value= ConvertPercentsToSliderValue( percents );
	loop
	{
		if( percents == 0u )
		{
			break;
		}
		--percents;

		if( ConvertPercentsToSliderValue( percents ) < slider_value )
		{
			break;
		}
	}
}

fn ConvertPercentsToSliderValue( u32 percents ) : u32
{
	// Roughly how many times slider can be incremented in the original game.
	// Use this value, but store internal slider values in percents (0 to 100) to be able to perform more fine-tuning.
	var u32 c_max_slider_value= 33u;

	return ust::min( percents * c_max_slider_value / 100u, c_max_slider_value );
}

var [ u32, 2 ] c_base_menu_size[ 320u, 200u ];

var u32 c_num_quit_messages= 8u;

namespace PageNumRows
{

var u32
	main_menu= 6u,
	new_game= c_num_skill_levels,
	options= 8u,
	controls= 10u,
	sound_settings= 7u,
	advanced_options= 9u;
} // namespace PageNumRows

