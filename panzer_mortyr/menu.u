import "menu.uh"

namespace PM
{

fn Menu::constructor( [ u32, 2 ] viewport_size )
	(
		viewport_size_= viewport_size,
		images_preloaded_= false,
		is_active_= true,
		current_page_= Page::MainMenu,
		time_s_= 0.0f,
		main_menu_current_row_= 0u,
		new_game_current_row_= 0u,
		load_save_game_current_row_= 0u,
		options_current_row_= 0u,
		controls_current_row_= 0u,
		quit_message_index_= 0u,
	)
{
}

fn Menu::IsActive( this ) : bool
{
	return is_active_;
}

fn Menu::ProcessKeyPress( mut this, SDL_Keysym& key_sym )
{
	if( key_sym.scancode == SDL_SCANCODE_ESCAPE )
	{
		if( !is_active_ )
		{
			is_active_= true;
		}
		else
		{
			switch( current_page_ )
			{
				Page::MainMenu -> { is_active_= false; },
				Page::NewGame -> { current_page_= Page::MainMenu; },
				Page::LoadGame -> { current_page_= Page::MainMenu; },
				Page::SaveGame -> { current_page_= Page::MainMenu; },
				Page::Options -> { current_page_= Page::MainMenu; },
				Page::Controls -> { current_page_= Page::Options; },
				Page::VideoSettings -> { current_page_= Page::Options; },
				Page::Quit -> { current_page_= Page::MainMenu; },
			}
		}
	}
	else if( key_sym.scancode == SDL_SCANCODE_RETURN )
	{
		switch( current_page_ )
		{
			Page::MainMenu ->
			{
				switch( main_menu_current_row_ )
				{
					0u -> { current_page_= Page::NewGame; },
					1u -> { current_page_= Page::LoadGame; },
					2u -> { current_page_= Page::SaveGame; },
					3u -> {},
					4u -> { current_page_= Page::Options; },
					5u ->
					{
						current_page_= Page::Quit;
						// TODO - select random one.
						quit_message_index_= ( quit_message_index_ + 1u ) % 8u;
					},
					default -> {},
				}
			},
			Page::NewGame ->
			{
				current_page_= Page::MainMenu;
				is_active_= false;
				// TODO - start new game with selected skill here.
			},
			Page::LoadGame ->
			{
				// TODO
			},
			Page::SaveGame ->
			{
				// TODO
			},
			Page::Options ->
			{
				switch( options_current_row_ )
				{
					0u -> { current_page_= Page::Controls; },
					1u -> { current_page_= Page::VideoSettings; },
					default -> {},
				}
			},
			Page::Controls ->
			{
				// TODO
			},
			Page::VideoSettings ->
			{
				// TODO
			},
			Page::Quit ->
			{
				// TODO - quit.
			},
		}
	}
	else if( key_sym.scancode == SDL_SCANCODE_UP )
	{
		switch( current_page_ )
		{
			Page::MainMenu ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				main_menu_current_row_= ( main_menu_current_row_ + ( num_rows - 1u ) ) % num_rows;
			},
			Page::NewGame ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				new_game_current_row_= ( new_game_current_row_ + ( num_rows - 1u ) ) % num_rows;
			},
			Page::LoadGame, Page::SaveGame ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				load_save_game_current_row_= ( load_save_game_current_row_ + ( num_rows - 1u ) ) % num_rows;
			},
			Page::Options ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				options_current_row_= ( options_current_row_ + ( num_rows - 1u ) ) % num_rows;
			},
			Page::Controls ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				controls_current_row_= ( controls_current_row_ + ( num_rows - 1u ) ) % num_rows;
			},
			Page::VideoSettings ->
			{
				// TODO
			},
			Page::Quit -> {},
		}

	}
	else if( key_sym.scancode == SDL_SCANCODE_DOWN )
	{
		switch( current_page_ )
		{
			Page::MainMenu ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				main_menu_current_row_= ( main_menu_current_row_ + 1u ) % num_rows;
			},
			Page::NewGame ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				new_game_current_row_= ( new_game_current_row_ + 1u ) % num_rows;
			},
			Page::LoadGame, Page::SaveGame ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				load_save_game_current_row_= ( load_save_game_current_row_ + 1u ) % num_rows;
			},
			Page::Options ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				options_current_row_= ( options_current_row_ + 1u ) % num_rows;
			},
			Page::Controls ->
			{
				var u32 num_rows= page_num_rows[ size_type( current_page_ ) ];
				controls_current_row_= ( controls_current_row_ + 1u ) % num_rows;
			},
			Page::VideoSettings ->
			{
				// TODO
			},
			Page::Quit -> {},
		}
	}
}

fn Menu::Update( mut this, f32 time_delta_s )
{
	time_s_+= time_delta_s;
}

fn Menu::Draw( mut this, ImageDrawer &mut image_drawer, TextDrawer &mut text_drawer )
{
	if( !images_preloaded_ )
	{
		PreloadMenuImages( image_drawer );
		images_preloaded_= true;
	}

	if( !IsActive() )
	{
		return;
	}

	// Use only integer scale, since we need to draw scaled texts and they look nice only in integer scales.
	var u32 scale=
		ust::max( 1u,
			ust::min(
				viewport_size_[0] * 2u / 3u / c_base_menu_size[0],
				viewport_size_[1] * 2u / 3u / c_base_menu_size[1] ) );

	var i32 offset_x= i32( ( viewport_size_[0] - c_base_menu_size[0] * scale ) / 2u );
	var i32 offset_y= i32( ( viewport_size_[1] - c_base_menu_size[1] * scale ) * 3u / 4u );

	var u32 cursor_frame= u32( time_s_ * 16.0f ) % 16u;

	var u32 cursor_tile_x= cursor_frame % 8u;
	var u32 cursor_tile_y= ( cursor_frame / 8u ) ^ 1u;

	var u32 constexpr cursor_size= 24u;


	switch( current_page_ )
	{
		Page::MainMenu ->
		{
			image_drawer.DrawImage( MenuImages::main_menu_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 65u * scale );
			var i32 cursor_offset_y= offset_y + i32( 50u * scale );

			var u32 constexpr cursor_step_size= 16u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( page_num_rows[ size_type( current_page_ ) ] - 1u - main_menu_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );

		},
		Page::NewGame ->
		{
			image_drawer.DrawImage( MenuImages::new_game_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 65u * scale );
			var i32 cursor_offset_y= offset_y + i32( 67u * scale );

			var u32 constexpr cursor_step_size= 19u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( page_num_rows[ size_type( current_page_ ) ] - 1u - new_game_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );
		},
		Page::LoadGame ->
		{
			image_drawer.DrawImage( MenuImages::load_game_background, offset_x, offset_y, f32( scale ) );

			// TODO - draw cursor
			// TODO - draw slots
		},
		Page::SaveGame ->
		{
			image_drawer.DrawImage( MenuImages::save_game_background, offset_x, offset_y, f32( scale ) );

			// TODO - draw cursor
			// TODO - draw slots
		},
		Page::Options ->
		{
			image_drawer.DrawImage( MenuImages::options_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32( 16u * scale );
			var i32 cursor_offset_y= offset_y + i32( 46u * scale );

			var u32 constexpr cursor_step_size= 15u;

			image_drawer.DrawImage(
				MenuImages::cursor_frames,
				cursor_offset_x,
				cursor_offset_y + i32( cursor_step_size * scale * ( page_num_rows[ size_type( current_page_ ) ] - 1u - options_current_row_ ) ),
				f32( scale ),
				cursor_tile_x * cursor_size,
				cursor_tile_y * cursor_size,
				cursor_size,
				cursor_size );
		},
		Page::Controls ->
		{
			image_drawer.DrawImage( MenuImages::controls_background, offset_x, offset_y, f32( scale ) );
		},
		Page::VideoSettings ->
		{
			image_drawer.DrawImage( MenuImages::video_settings_background, offset_x, offset_y, f32( scale ) );
		},
		Page::Quit ->
		{
			if_var( &image_size : image_drawer.GetImageSize( MenuImages::quit_texts ) )
			{
				var u32 message_height= image_size[1] / 8u;

				image_drawer.DrawImage(
					MenuImages::quit_texts,
					offset_x + ( ( i32( c_base_menu_size[0] ) - i32( image_size[0] ) ) / 2 ) * i32( scale ),
					offset_y + ( ( i32( c_base_menu_size[1] ) - i32( message_height ) ) / 2 ) * i32( scale ),
					f32( scale ),
					0u,
					message_height * quit_message_index_,
					image_size[0],
					message_height );
			}
		},
	}

	ust::ignore_unused( text_drawer ); // TODO - use it.
}

fn PreloadMenuImages( ImageDrawer &mut image_drawer )
{
	image_drawer.PreloadImage( MenuImages::main_menu_background );
	image_drawer.PreloadImage( MenuImages::new_game_background );
	image_drawer.PreloadImage( MenuImages::load_game_background );
	image_drawer.PreloadImage( MenuImages::save_game_background );
	image_drawer.PreloadImage( MenuImages::options_background );
	image_drawer.PreloadImage( MenuImages::controls_background );
	image_drawer.PreloadImage( MenuImages::video_settings_background );
	image_drawer.PreloadImage( MenuImages::cursor_frames );
	image_drawer.PreloadImage( MenuImages::control_elements );
	image_drawer.PreloadImage( MenuImages::quit_texts );
}

var [ u32, 2 ] c_base_menu_size[ 320u, 200u ];

namespace MenuImages
{

var ResourceString
	& main_menu_background= "MENU.BMP\0\0\0\0\0\0\0\0",
	& new_game_background= "MENU_T.BMP\0\0\0\0\0\0",
	& load_game_background= "LOADG.BMP\0\0\0\0\0\0\0",
	& save_game_background= "SAVEG.BMP\0\0\0\0\0\0\0",
	& options_background= "OPTION.BMP\0\0\0\0\0\0",
	& controls_background= "KLAWISZ.BMP\0\0\0\0\0",
	& video_settings_background= "MODES.BMP\0\0\0\0\0\0\0",
	& cursor_frames= "MENU_Z.BMP\0\0\0\0\0\0",
	& control_elements= "OPTION2.BMP\0\0\0\0\0",
	& quit_texts= "QUIT.BMP\0\0\0\0\0\0\0\0";

} // namespace MenuImages

} // namespace PM
