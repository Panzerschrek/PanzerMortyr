				control_elements_offset_y + i32( scale * cursor_step_size * 5u ),
				f32( scale ),
				0u,
				( settings.snd_ambient_sound_enabled ? control_element_on_y : control_element_off_y ),
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_background_y,
				control_element_width,
				control_element_height );

			var u32 volume_slider_value= GetSliderPositionForValue( settings.snd_volume );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x + slider_start_offset * i32( scale ) + i32( volume_slider_value * slider_increment * scale ),
				control_elements_offset_y + i32( scale * cursor_step_size * 4u ),
				f32( scale ),
				0u,
				control_element_slider_y,
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 3u ),
				f32( scale ),
				0u,
				control_element_slider_background_y,
				control_element_width,
				control_element_height );

			var u32 ambient_volume_slider_value= GetSliderPositionForValue( settings.snd_ambient_volume );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x + slider_start_offset * i32( scale ) + i32( ambient_volume_slider_value * slider_increment * scale ),
				control_elements_offset_y + i32( scale * cursor_step_size * 3u ),
				f32( scale ),
				0u,
				control_element_slider_y,
				control_element_width,
				control_element_height );

			// In the original game there is a boolean option "CD music".
			// Repurpose it for music volume - use a slider instead of a boolean value.

			var u32 music_volume_slider_value= GetSliderPositionForValue( settings.snd_music_volume );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x + slider_start_offset * i32( scale ) + i32( music_volume_slider_value * slider_increment * scale ),
				control_elements_offset_y + i32( scale * cursor_step_size * 2u ),
				f32( scale ),
				0u,
				control_element_slider_y,
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 2u ),
				f32( scale ),
				0u,
				control_element_slider_background_y,
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 1u ),
				f32( scale ),
				0u,
				( settings.snd_character_voice_enabled ? control_element_on_y : control_element_off_y ),
				control_element_width,
				control_element_height );

			image_drawer.DrawImage(
				MenuImages::control_elements,
				control_elements_offset_x,
				control_elements_offset_y + i32( scale * cursor_step_size * 0u ),
				f32( scale ),
				0u,
				( settings.snd_flip_stereo ? control_element_on_y : control_element_off_y ),
				control_element_width,
				control_element_height );
		},
		Page::ExtraOptions ->
		{
			image_drawer.DrawImage( MenuImages::extra_options_page_background, offset_x, offset_y, f32( scale ) );

			var i32 cursor_offset_x= offset_x + i32(   6u * scale );
			var i32 cursor_offset_y= offset_y + i32( 156u * scale );

			var i32 texts_offset_x= cursor_offset_x + i32( 16u * scale );
			var i32 texts_offset_column1_x= cursor_offset_x + i32( 174u * scale );
			var i32 texts_offset_y= cursor_offset_y + i32(  1u * scale );
			var u32 horizontal_texts_spacing= 9u * scale;

			image_drawer.DrawImage(
