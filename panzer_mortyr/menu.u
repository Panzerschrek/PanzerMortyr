			text_drawer.AddText(
				texts_offset_column1_x,
				texts_offset_y - i32( horizontal_texts_spacing * 7u ),
				( settings.r_dynamic_lights_enabled ? on_str : off_str ),
				text_settings );

			text_drawer.AddText(
				texts_offset_x,
				texts_offset_y - i32( horizontal_texts_spacing * 8u ),
				FetchStringFromExtraTable( ExtraStringTableKey::Blood ),
				text_settings );

			text_drawer.AddText(
				texts_offset_column1_x,
				texts_offset_y - i32( horizontal_texts_spacing * 8u ),
				( settings.g_blood_enabled ? on_str : off_str ),
				text_settings );

			text_drawer.AddText(
				texts_offset_x,
				texts_offset_y - i32( horizontal_texts_spacing * 9u ),
