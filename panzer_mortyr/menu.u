			auto settings_lock= settings_.lock_imut();
			var Settings& settings= settings_lock.deref();

			var ust::string_view8 on_str= FetchStringFromTable( string_table, StringTableKey::On );
			var ust::string_view8 off_str= FetchStringFromTable( string_table, StringTableKey::Off );

			text_drawer.AddText(
				texts_offset_x,
				texts_offset_y - i32( horizontal_texts_spacing * 0u ),
				FetchStringFromExtraTable( ExtraStringTableKey::Fog ),
