import "abstract_video_player.iu"
import "audio_processor.iu"
import "performance_counter.iu"
import "shader_program.iu"

namespace PM
{

class VideoPlayerGL final : AbstractVideoPlayer
{
public:
	fn constructor( ConsoleOutPtr console_out );

	fn virtual override PlayVideo(
		mut this,
		ust::filesystem_path_view file_path,
		AbstractWindow &mut window, // TODO - pass WindowGL instead.
		AudioProcessor &mut audio_processor );

private:
	ConsoleOutPtr imut console_out_;
	PerformanceCounter imut performance_counter_;
	ShaderProgram shader_;
}

} // namespace PM
