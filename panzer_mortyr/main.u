import "/main_wrapper.u"
import "/stdout.u"
import "shader_program.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

// Place actual entry point within "PM" namespace.

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	unsafe( SDL_Init( SDL_INIT_VIDEO ) );

	var bool use_gl_debugging= compiler::options::generate_debug_info || compiler::options::optimization_level == '0';

	unsafe
	{
		SDL_GL_SetAttribute( SDL_GL_DOUBLEBUFFER, 1 );
		SDL_GL_SetAttribute( SDL_GL_DEPTH_SIZE, 24 );

		if( use_gl_debugging )
		{
			SDL_GL_SetAttribute( SDL_GL_CONTEXT_FLAGS, i32( SDL_GL_CONTEXT_DEBUG_FLAG ) );
		}

		SDL_GL_SetAttribute( SDL_GL_CONTEXT_MAJOR_VERSION, 3 );
		SDL_GL_SetAttribute( SDL_GL_CONTEXT_MINOR_VERSION, 3 );
		SDL_GL_SetAttribute( SDL_GL_CONTEXT_PROFILE_MASK, i32( SDL_GL_CONTEXT_PROFILE_CORE ) );
	}

	auto SDL_WINDOWPOS_CENTERED= 0x2FFF0000;

	var u32 window_width= 1024u, window_height= 768u;

	var $(SDL_Window) window=
		unsafe( SDL_CreateWindow(
			$<( cast_mut( "panzer_mortyr\0"[0] ) ), // TODO - set proper caption.
			SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
			i32(window_width), i32(window_height),
			SDL_WINDOW_OPENGL ) );

	if( ust::is_nullptr( window ) )
	{
		ust::stderr_print( "Failed to create window!\n" );
		return -1;
	}

	// TODO - set window icon.

	var SDL_GLContext gl_context= unsafe( SDL_GL_CreateContext( window ) );
	if( ust::is_nullptr( gl_context ) )
	{
		ust::stderr_print( "Failed to create OpenGL context!\n" );
		return -1;
	}

	unsafe( SDL_GL_SetSwapInterval(1) );

	if( use_gl_debugging )
	{
		unsafe( glDebugMessageCallback( GLDebugCallback, ust::nullptr</byte8/>() ) );
	}

	var ShaderProgram test_shader( embed</char8/>( "shaders/test.vert.glsl" ), embed</char8/>( "shaders/test.frag.glsl" ) );

	var GLuint mut vertex_array_object= zero_init;
	unsafe( glGenVertexArrays( 1, $<( vertex_array_object ) ) );

	loop label main_loop
	{
		var SDL_Event mut event= zero_init;
		while( unsafe( SDL_PollEvent( $<(event) ) ) != 0 )
		{
			var SDL_EventType t( size_type( event.union_contents[0] ) );
			if( t == SDL_QUIT )
			{
				break label main_loop;
			}
			if( t == SDL_WINDOWEVENT )
			{
				auto& windows_event= unsafe( cast_ref_unsafe</SDL_WindowEvent/>( event ) );
				if( SDL_WindowEventID( windows_event.event ) == SDL_WINDOWEVENT_CLOSE )
				{
					break label main_loop;
				}
			}
			if( t == SDL_KEYDOWN )
			{
				auto& keyboard_event= unsafe( cast_ref_unsafe</SDL_KeyboardEvent/>( event ) );
				if( keyboard_event.keysym.scancode == SDL_SCANCODE_ESCAPE )
				{
					break label main_loop;
				}
			}

			unsafe( glClearColor( GLclampf(1.0), GLclampf(0.0), GLclampf(1.0), GLclampf(1.0) ) );
			unsafe( glClear( GLbitfield( GL_COLOR_BUFFER_BIT ) ) );

			test_shader.Bind();

			unsafe( glBindVertexArray( vertex_array_object ) );
			unsafe( glDrawArrays( GLenum(GL_TRIANGLES), 0, 3 ) );

			unsafe( SDL_GL_SwapWindow( window ) );

			// TODO - tune waiting time to avoid waiting to much or too little.

			unsafe( SDL_Delay( 15u ) );
		}
	}

	unsafe( glDeleteVertexArrays( 1, $<( vertex_array_object ) ) );

	unsafe( SDL_GL_DeleteContext( gl_context ) );

	unsafe( SDL_DestroyWindow( window ) );

	unsafe( SDL_Quit() );

	return 0;
}

fn GLDebugCallback(
	GLenum source,
	GLenum type_,
	GLuint id,
	GLenum severity,
	GLsizei length,
	$(GLchar) message,
	$(byte8) user_param ) unsafe call_conv( "C" )
{
	ust::ignore_unused( source );
	ust::ignore_unused( type_ );
	ust::ignore_unused( id );
	ust::ignore_unused( severity );
	ust::ignore_unused( user_param );

	ust::stderr_print(
		ust::concat(
			"OpenGL debug message:\n",
			unsafe( ust::string_view8( message, size_type( length ) ) ),
			"\n\n" ) );
}

} // namespace PM
