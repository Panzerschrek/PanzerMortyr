import "world_drawer.uh"

pretty_main
{
	var i32 res= PM::Main( args );

	// Call SDL_Quit after destroying all objects within "Main" function.
	unsafe( SDL_Quit() );

	return res;
}

namespace PM
{

// Place actual entry point within "PM" namespace.

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	// Parse command line.

	var CommandLineOptions command_line_options= ParseCommandLineOptions( args );


	// Create console out as first step - in order to have proper logging.

	var ConsoleOutPtr console_out_ptr( ConsoleOut() );

	ConsoleOutAddTextLine( console_out_ptr, "PanzerMortyr initializing..." );

	var SettingsPtr settings_ptr= LoadSettings( command_line_options.settings_file_path, console_out_ptr );

	var GameFilesystemNullablePtr game_filesystem_nullable_ptr= GameFilesystem::Create( console_out_ptr );
	if( game_filesystem_nullable_ptr.empty() )
	{
		return -1;
	}

	var GameFilesystemPtr game_filesystem_ptr= game_filesystem_nullable_ptr.try_to_non_nullable();

	var CachingGameResourcesLoaderPtr caching_game_resources_loader_ptr(
		CachingGameResourcesLoader( game_filesystem_ptr, console_out_ptr ) );

	var Game mut game( settings_ptr, caching_game_resources_loader_ptr, console_out_ptr );

	if_var( start_map : command_line_options.start_map )
	{
		game.TeleportToMap( start_map );
	}
	else if( command_line_options.new_game )
	{
		game.StartNewGame();
	}

	var OpenGLWindow mut window( settings_ptr, console_out_ptr );

	// Create classes requiring OpenGL context after OpenGL window creation.

	var Console mut console( settings_ptr, console_out_ptr, window.GetViewportSize() );

	var Menu mut menu( window.GetViewportSize() );

	var HudDrawer mut hud_drawer( window.GetViewportSize(), game_filesystem_ptr, console_out_ptr );

	var TextDrawer mut text_drawer( window.GetViewportSize(), game_filesystem_ptr, console_out_ptr );

	var ImageDrawer mut image_drawer( window.GetViewportSize(), game_filesystem_ptr );

	var WorldDrawer mut world_drawer(
		settings_ptr,
		game_filesystem_ptr,
		caching_game_resources_loader_ptr,
		console_out_ptr );

	var ust::vector</bool/> mut keyboard_state;

	var PerformanceCounter mut performance_counter;
	var PerformanceCounter::TimePoint mut prev_frame_start_time_point= performance_counter.GetCurrentTime();

	ConsoleOutAddTextLine( console_out_ptr, "PanzerMortyr initialized!" );

	loop label main_loop
	{
		var PerformanceCounter::TimePoint cur_frame_start_time_point= performance_counter.GetCurrentTime();

		var bool mut had_console_toggle_event= false;

		var u32 mut mouse_state( unsafe( SDL_GetMouseState( ust::nullptr</i32/>(), ust::nullptr</i32/>() ) ) );
		var [ i32, 2 ] mut mouse_motion[ 0, 0 ];

		var SDL_Event mut event= zero_init;
		while( unsafe( SDL_PollEvent( $<(event) ) ) != 0 )
		{
			switch( SDL_EventType( size_type( event.union_contents[0] ) ) )
			{
				SDL_QUIT ->
				{
					break label main_loop;
				},
				SDL_WINDOWEVENT ->
				{
					// Assume we have only single window and we should quit if it closes.
					auto& windows_event= unsafe( cast_ref_unsafe</SDL_WindowEvent/>( event ) );
					if( SDL_WindowEventID( windows_event.event ) == SDL_WINDOWEVENT_CLOSE )
					{
						break label main_loop;
					}
				},
				SDL_KEYDOWN ->
				{
					// Assume we have only single window and we process only keyboard events from it.
					auto& keyboard_event= unsafe( cast_ref_unsafe</SDL_KeyboardEvent/>( event ) );
					if( keyboard_event.keysym.scancode == SDL_SCANCODE_ESCAPE )
					{
						if( console.IsActive() )
						{
							console.Toggle();
						}
						else
						{
							menu.ProcessKeyPress( keyboard_event.keysym );
						}
					}
					else if( keyboard_event.keysym.scancode == SDL_SCANCODE_GRAVE )
					{
						console.Toggle();
						had_console_toggle_event= true;
					}
					else
					{
						if( console.IsActive() )
						{
							var HostCommandProcessor mut command_processor{ .game= game, .console_out_ptr= console_out_ptr };
							console.ProcessKeyPress( keyboard_event.keysym, command_processor );

							if( command_processor.quit_requested )
							{
								break label main_loop;
							}
						}
						else if( menu.IsActive() )
						{
							menu.ProcessKeyPress( keyboard_event.keysym );
						}
					}
				},
				SDL_TEXTINPUT ->
				{
					auto& text_input_event= unsafe( cast_ref_unsafe</SDL_TextInputEvent/>( event ) );
					if( !had_console_toggle_event && console.IsActive() )
					{
						console.ProcessTextInput( text_input_event );
					}
				},
				SDL_MOUSEBUTTONDOWN ->
				{
					auto& mouse_button_event= unsafe( cast_ref_unsafe</SDL_MouseButtonEvent/>( event ) );
					game.ProcessMouseButtonPress( u32( mouse_button_event.button ) );

					// Just in case if we had mouse pressed but current state isn't pressed anymore.
					if( mouse_button_event.button > 0u8 )
					{
						mouse_state |= 1u << ( u32( mouse_button_event.button ) - 1u );
					}
				},
				SDL_MOUSEMOTION ->
				{
					auto& mouse_motion_event= unsafe( cast_ref_unsafe</SDL_MouseMotionEvent/>( event ) );
					// Use += to accumulate multiple motion events.
					mouse_motion[0]+= mouse_motion_event.xrel;
					mouse_motion[1]+= mouse_motion_event.yrel;
				},
				default -> {},
			}
		}

		var bool mouse_enabled=
			settings_ptr.lock_imut().deref().in_mouse_enabled && !console.IsActive() && !menu.IsActive();

		unsafe( SDL_SetRelativeMouseMode( SDL_bool( ( mouse_enabled ? 1 : 0 ) ) ) );

		if( !mouse_enabled )
		{
			mouse_motion= ust::make_array( 0, 0 );
		}

		if( console.IsActive() || menu.IsActive() )
		{
			foreach( &mut b : keyboard_state )
			{
				b= false;
			}
			mouse_state= 0u;
		}
		else
		{
			var i32 mut key_count= 0;
			var $(Uint8) keyboard_state_raw= unsafe( SDL_GetKeyboardState( $<( key_count ) ) );

			keyboard_state.resize( size_type( key_count ), false );

			for( auto mut i= 0s; i < size_type(key_count); ++i )
			{
				keyboard_state[i]= unsafe( $>( keyboard_state_raw + i ) ) != Uint8(0);
			}
		}

		var f32 time_delta_s= performance_counter.CalculateDurationS( prev_frame_start_time_point, cur_frame_start_time_point );
		var f32 time_delta_s_limited= ust::min( ust::max( 0.0001f, time_delta_s ), 0.1f );

		performance_counter.AddMeasurement( prev_frame_start_time_point, cur_frame_start_time_point );

		prev_frame_start_time_point= cur_frame_start_time_point;

		if( !console.IsActive() && !menu.IsActive() )
		{
			// Update game if no console/menu is active.
			// TODO - update game in multiplayer mode always.

			game.Update( time_delta_s_limited, keyboard_state, mouse_state, mouse_motion );
		}

		console.Update( time_delta_s );

		menu.Update( time_delta_s );

		auto viewport_size= window.GetViewportSize();

		var WorldDrawer::DrawingStats world_drawing_stats=
			world_drawer.Draw(
				game.GetWorldDrawingInfo(),
				WorldDrawingViewportInfo{ .view_aspect= f32( viewport_size[0] ) / f32( viewport_size[1] ) } );

		if( settings_ptr.lock_imut().deref().r_show_stats )
		{
			DrawWorldDrawingStats( text_drawer, viewport_size, world_drawing_stats );
		}

		console.Draw( image_drawer, text_drawer );

		if( settings_ptr.lock_imut().deref().r_show_fps )
		{
			DrawFPS( text_drawer, viewport_size, performance_counter );
		}

		hud_drawer.Draw( game.GetHudDrawingInfo() );

		if( !console.IsActive() )
		{
			DrawCrosshair( settings_ptr, text_drawer, viewport_size, game.GetCrosshairDrawingInfo() );
		}

		menu.Draw( image_drawer, text_drawer );

		text_drawer.DrawTexts();

		window.SwapWindow();

		{
			var PerformanceCounter::TimePoint cur_frame_end_time_point= performance_counter.GetCurrentTime();
			var f32 frame_duration_excluding_waiting_s=
				performance_counter.CalculateDurationS( cur_frame_start_time_point, cur_frame_end_time_point );

			// If vsync is off, it may happen, that we are too fast.
			// In such case wait a little bit.
			var f32 min_frame_delta_s= 1.0f / f32( GetMaxFPS( settings_ptr ) );
			if( frame_duration_excluding_waiting_s < min_frame_delta_s )
			{
				var f32 time_to_sleep_s= min_frame_delta_s - frame_duration_excluding_waiting_s;
				var u32 time_to_sleep_ms( ust::floor( time_to_sleep_s * 1000.0f ) );
				unsafe( SDL_Delay( time_to_sleep_ms ) );
			}
		}
	}

	SaveSettings( settings_ptr.lock_imut().deref(), command_line_options.settings_file_path, console_out_ptr );

	return 0;
}

// A helper struct for processing console commands.
struct HostCommandProcessor
{
	//
	// Own process* functions.
	//

	fn process_new_game( mut this )
	{
		game.StartNewGame();
	}

	fn process_quit( mut this )
	{
		quit_requested= true;
	}

	fn process_map( this, ust::iterator</ WordsIterator /> mut args )
	{
		if_var( map_name : args.next() )
		{
			if_var( map_index : ust::parse_integer_exact</u32/>( map_name ) )
			{
				game.TeleportToMap( map_index );
			}
			else
			{
				ConsoleOutAddTextLine( console_out_ptr, "Failed to parse map index!" );
			}
		}
		else
		{
			ConsoleOutAddTextLine( console_out_ptr, "Expected map index." );
		}
	}

	//
	// Create proxies for Game::process_* methods using mixins and type information for Game class.
	//

	mixin( generate_game_processing_method_proxies() );

	fn constexpr generate_game_processing_method_proxies() : [ char8, 1024s ]
	{
		var ust::mixin_utils::static_string</1024s/> mut s;

		auto& processor_functions_prefix= "process_";

		foreach( &function_info : typeinfo</Game/>.functions_list )
		{
			static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
			{
				s+= "fn " + function_info.name + "( mut this ) { game. " + function_info.name + "(); }\n";
			}
		}

		return s.buffer;
	}

	//
	// Host members and other fields.
	//

	bool quit_requested= false;
	Game &mut @('a') game;
	ConsoleOutPtr& @('b') console_out_ptr;
}

fn DrawWorldDrawingStats( TextDrawer &mut text_drawer, [ u32, 2 ] viewport_size, WorldDrawer::DrawingStats& stats )
{
	var ust::string8 mut text;

	text+= "room visible clusters: ";
	text+= ust::to_string8( stats.num_room_visible_clusters );
	text+= "\n";

	text+= "total visible clusters: ";
	text+= ust::to_string8( stats.num_total_visible_clusters );
	text+= "\n";

	text+= "visible map triangles: ";
	text+= ust::to_string8( stats.num_visible_map_triangles );
	text+= "\n";

	text+= "visible models: ";
	text+= ust::to_string8( stats.num_visible_models );
	text+= "\n";

	text+= "visible model triangles: ";
	text+= ust::to_string8( stats.num_visivle_model_triangles );
	text+= "\n";

	text_drawer.AddText(
		0,
		i32( viewport_size[1] - TextDrawer::c_glyph_height ),
		text,
		TextDrawer::Settings
		{
			.monospace= true,
			.background_color[ 0u8, 0u8, 0u8, 96u8 ],
		} );
}

fn DrawFPS( TextDrawer &mut text_drawer, [ u32, 2 ] viewport_size, PerformanceCounter& performance_counter )
{
	var f32 average_frame_duration_s= performance_counter.GetAverageDurationS();
	var f32 fps= 1.0f / average_frame_duration_s;

	var u32 duration_mcs( ust::round( average_frame_duration_s * 1000000.0f ) );
	var u32 fps100( ust::round( fps * 100.0f ) );

	var [ char8, 19 ] text
	[
		( u32('0') + u32( duration_mcs / 1000000u % 10u ) ),
		( u32('0') + u32( duration_mcs /  100000u % 10u ) ),
		( u32('0') + u32( duration_mcs /   10000u % 10u ) ),
		( u32('0') + u32( duration_mcs /    1000u % 10u ) ),
		'.',
		( u32('0') + u32( duration_mcs /     100u % 10u ) ),
		( u32('0') + u32( duration_mcs /      10u % 10u ) ),
		'm', 's',
		'\n',
		( u32('0') + u32( fps100 /  10000u % 10u ) ),
		( u32('0') + u32( fps100 /   1000u % 10u ) ),
		( u32('0') + u32( fps100 /    100u % 10u ) ),
		'.',
		( u32('0') + u32( fps100 /     10u % 10u ) ),
		( u32('0') + u32( fps100 /      1u % 10u ) ),
		'f', 'p', 's'
	];

	text_drawer.AddText(
		i32( viewport_size[0] - TextDrawer::c_max_glyph_width * 9u ),
		i32( viewport_size[1] - TextDrawer::c_glyph_height ),
		text,
		TextDrawer::Settings
		{
			.monospace= true,
			.background_color[ 0u8, 0u8, 0u8, 96u8 ],
		} );
}

fn GetMaxFPS( SettingsPtr& settings_ptr ) : u32
{
	auto mut lock= settings_ptr.lock_mut();
	var Settings &mut settings= lock.deref();

	var u32 max_fps= ust::max( 10u, ust::min( settings.r_max_fps, 500u ) );
	settings.r_max_fps= max_fps;

	return max_fps;
}

} // namespace PM
