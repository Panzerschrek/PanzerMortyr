import "/main_wrapper.u"
import "/stdout.u"
import "/vector.u"
import "buffer_object.uh"
import "camera_controller.uh"
import "game_filesystem.uh"
import "mat.uh"
import "math_constants.uh"
import "opengl_window.uh"
import "shader_program.uh"
import "vertex_array_object.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

// Place actual entry point within "PM" namespace.

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	var GameFilesystem mut game_filesystem;

	var ust::string8 maps_description_file_contents= game_filesystem.LoadFileToString( "ICE.STD" ).try_take();

	var OpenGLWindow mut window;

	var ShaderProgram mut test_shader( embed</char8/>( "shaders/test.vert.glsl" ), embed</char8/>( "shaders/test.frag.glsl" ) );

	var [ [ f32, 4 ], 3 ] vertices
	[
		 [  0.0f, 0.75f,  1.5f, 0.0f ],
		 [  1.5f, -1.5f, -0.1f, 0.0f ],
		 [ -1.5f, -1.5f,  0.0f, 0.0f ]
	];

	// Create buffer object prior to vertex array object using it in order to ensure correct destruction order.

	var BufferObject buffer_object=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			ust::array_view_imut</ [ f32, 4 ] />( vertices ).to_byte8_range() );

	var VertexArrayObject vertex_array_object;

	vertex_array_object.Bind();

	var GLuint c_position_attrib= 0u;

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );

	buffer_object.Bind();

	unsafe( glVertexAttribPointer(
		c_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</f32/>.size_of * 4s ),
		ust::nullptr</byte8/>() ) );

	var ust::vector</bool/> mut keyboard_state;
	var CameraController mut camera_controller( Vec3f( 0.0f, 20.0f, 0.0f ) );

	var u64 system_performace_counter_frequency= ( unsafe( SDL_GetPerformanceFrequency() ) );

	var u64 mut prev_frame_time_point= unsafe( SDL_GetPerformanceCounter() );

	loop label main_loop
	{
		var SDL_Event mut event= zero_init;
		while( unsafe( SDL_PollEvent( $<(event) ) ) != 0 )
		{
			var SDL_EventType t( size_type( event.union_contents[0] ) );
			if( t == SDL_QUIT )
			{
				break label main_loop;
			}
			if( t == SDL_WINDOWEVENT )
			{
				// Assume we have only single window and we should quit if it closes.
				auto& windows_event= unsafe( cast_ref_unsafe</SDL_WindowEvent/>( event ) );
				if( SDL_WindowEventID( windows_event.event ) == SDL_WINDOWEVENT_CLOSE )
				{
					break label main_loop;
				}
			}
			if( t == SDL_KEYDOWN )
			{
				// Assume we have only single window and we process only keyboard events from it.
				auto& keyboard_event= unsafe( cast_ref_unsafe</SDL_KeyboardEvent/>( event ) );
				if( keyboard_event.keysym.scancode == SDL_SCANCODE_ESCAPE )
				{
					break label main_loop;
				}
			}
		}

		{
			var i32 mut key_count= 0;
			var $(Uint8) keyboard_state_raw= unsafe( SDL_GetKeyboardState( $<( key_count ) ) );

			keyboard_state.resize( size_type( key_count ), false );

			for( auto mut i= 0s; i < size_type(key_count); ++i )
			{
				keyboard_state[i]= unsafe( $>( keyboard_state_raw + i ) ) != Uint8(0);
			}
		}

		var u64 cur_frame_time_point=  unsafe( SDL_GetPerformanceCounter() );

		var f32 time_delta_s= ( f32( cur_frame_time_point ) - f32( prev_frame_time_point ) ) / f32( system_performace_counter_frequency );
		var f32 time_delta_s_limited= ust::min( ust::max( 0.0001f, time_delta_s ), 0.1f );

		camera_controller.Update( time_delta_s_limited, keyboard_state );

		unsafe( glClearColor( GLclampf(32.0 / 255.0), GLclampf(16.0 / 255.0), GLclampf(8.0f / 255.0f), GLclampf(1.0) ) );
		unsafe( glClear( GLbitfield( GL_COLOR_BUFFER_BIT ) ) );

		auto viewport_size= window.GetViewportSize();

		test_shader.Bind();
		test_shader.SetUniform( "fu_triangle_color", 0.1f, 0.1f, 0.9f, 1.0f );
		test_shader.SetUniform( "vu_matrix", camera_controller.GetCameraMatrix( f32(viewport_size[0]) / f32(viewport_size[1]) ) );

		vertex_array_object.Bind();

		unsafe( glDrawArrays( GLenum(GL_TRIANGLES), 0, 3 ) );

		window.SwapWindow();

		// TODO - tune waiting time to avoid waiting to much or too little.

		unsafe( SDL_Delay( 15u ) );

		prev_frame_time_point= cur_frame_time_point;
	}

	// This should be called always.
	unsafe( SDL_Quit() );

	return 0;
}

} // namespace PM
