import "/enum_string_conversions.u"
import "/main_wrapper.u"
import "/stdout.u"

import "/common_lib/string_utils.uh"

import "cached_game_resources_loader.uh"
import "game.uh"
import "game_filesystem.uh"
import "opengl_window.uh"
import "world_drawer.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

// Place actual entry point within "PM" namespace.

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	var GameFilesystemPtr game_filesystem_ptr( GameFilesystem() );

	var CachedGameResourcesLoader mut cached_game_resources_loader( game_filesystem_ptr );

	var GameResourcePtr</GameParams/> game_params_ptr= cached_game_resources_loader.LoadGameParams();
	var GameResourcePtr</MapsDescription/> maps_description_ptr= cached_game_resources_loader.LoadMapsDescription();
	var GameResourcePtr</MaterialsDescription/> materials_description_ptr= cached_game_resources_loader.LoadMaterialsDescription();

	var u32 map_index= game_params_ptr.deref().start_map;

	var MapsDescription::MapDescription& map_description= maps_description_ptr.deref().maps[map_index];

	var MaterialsDescription::Block& materials_block= materials_description_ptr.deref().blocks[ map_description.materials_block ];

	var GameResourcePtr</EntitiesDescription/> entities_description_ptr=
		cached_game_resources_loader.LoadEntitiesDescription( ConvertToUppercase( map_description.entities_info_file ) );

	var GameResourcePtr</ZmapData/> zmap_data_ptr= cached_game_resources_loader.LoadZmapFile( map_index );
	var GameResourcePtr</ZvoxData/> zvox_data_ptr= cached_game_resources_loader.LoadZvoxFile( map_index );

	auto mut lock= game_filesystem_ptr.lock_mut();
	var GameFilesystem &mut game_filesystem= lock.deref();

	auto mut zpoz_data_res= game_filesystem.LoadFile( ConvertToUppercase( map_description.positions_file ), LoadZpozFile );

	if_var( e : zpoz_data_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read map file! Error: ", ust::enum_to_string(e), "\n" ) );
		return -1;
	}

	auto mut zmap_lam_data_res=
		game_filesystem.LoadFile(
			GetZmapLamFileName( map_index ),
			lambda[num_clusters= zvox_data_ptr.deref().clusters.size()] ( ust::file_readable &mut f ) : ust::io_result</ZmapLamData/>
			{
				return LoadZmapLamFile( f, num_clusters );
			} );

	if_var( e : zmap_lam_data_res.as_error_ref() )
	{
		ust::stderr_print( ust::concat( "Failed to read map file! Error: ", ust::enum_to_string(e), "\n" ) );
		return -1;
	}

	var OpenGLWindow mut window;

	var WorldDrawer mut world_drawer;

	world_drawer.SetMap(
		zmap_data_ptr.deref(),
		zvox_data_ptr,
		move(zpoz_data_res).try_take(),
		move(zmap_lam_data_res).try_take(),
		materials_block,
		game_filesystem );

	var ust::vector</bool/> mut keyboard_state;
	var Game mut game;

	var u64 system_performace_counter_frequency= ( unsafe( SDL_GetPerformanceFrequency() ) );

	var u64 mut prev_frame_time_point= unsafe( SDL_GetPerformanceCounter() );

	loop label main_loop
	{
		var SDL_Event mut event= zero_init;
		while( unsafe( SDL_PollEvent( $<(event) ) ) != 0 )
		{
			var SDL_EventType t( size_type( event.union_contents[0] ) );
			if( t == SDL_QUIT )
			{
				break label main_loop;
			}
			if( t == SDL_WINDOWEVENT )
			{
				// Assume we have only single window and we should quit if it closes.
				auto& windows_event= unsafe( cast_ref_unsafe</SDL_WindowEvent/>( event ) );
				if( SDL_WindowEventID( windows_event.event ) == SDL_WINDOWEVENT_CLOSE )
				{
					break label main_loop;
				}
			}
			if( t == SDL_KEYDOWN )
			{
				// Assume we have only single window and we process only keyboard events from it.
				auto& keyboard_event= unsafe( cast_ref_unsafe</SDL_KeyboardEvent/>( event ) );
				if( keyboard_event.keysym.scancode == SDL_SCANCODE_ESCAPE )
				{
					break label main_loop;
				}
			}
		}

		{
			var i32 mut key_count= 0;
			var $(Uint8) keyboard_state_raw= unsafe( SDL_GetKeyboardState( $<( key_count ) ) );

			keyboard_state.resize( size_type( key_count ), false );

			for( auto mut i= 0s; i < size_type(key_count); ++i )
			{
				keyboard_state[i]= unsafe( $>( keyboard_state_raw + i ) ) != Uint8(0);
			}
		}

		var u64 cur_frame_time_point=  unsafe( SDL_GetPerformanceCounter() );

		var f32 time_delta_s= ( f32( cur_frame_time_point ) - f32( prev_frame_time_point ) ) / f32( system_performace_counter_frequency );
		var f32 time_delta_s_limited= ust::min( ust::max( 0.0001f, time_delta_s ), 0.1f );

		game.Update( time_delta_s_limited, keyboard_state );

		auto viewport_size= window.GetViewportSize();

		world_drawer.Draw(
			game.GetWorldDrawingInfo(),
			WorldDrawingViewportInfo{ .view_aspect= f32( viewport_size[0] ) / f32( viewport_size[1] ) } );

		window.SwapWindow();

		// TODO - tune waiting time to avoid waiting to much or too little.

		unsafe( SDL_Delay( 15u ) );

		prev_frame_time_point= cur_frame_time_point;
	}

	// This should be called always.
	unsafe( SDL_Quit() );

	return 0;
}

} // namespace PM
