import "/enum_string_conversions.u"
import "/integer_parsing.u"
import "/main_wrapper.u"
import "/stdout.u"

import "console.uh"
import "game.uh"
import "opengl_window.uh"
import "settings.uh"
import "world_drawer.uh"

pretty_main
{
	return PM::Main( args );
}

namespace PM
{

// Place actual entry point within "PM" namespace.

fn Main( ust::array_view_imut</ust::string_view8/> args ) : i32
{
	// Create console out as first step - in order to have proper logging.

	var ConsoleOutPtr console_out_ptr( ConsoleOut() );

	ConsoleOutAddTextLine( console_out_ptr, "PanzerMortyr initializing..." );

	var SettingsPtr settings_ptr= LoadSettings();

	var GameFilesystemNullablePtr game_filesystem_nullable_ptr= GameFilesystem::Create( console_out_ptr );
	if( game_filesystem_nullable_ptr.empty() )
	{
		return -1;
	}

	var GameFilesystemPtr game_filesystem_ptr= game_filesystem_nullable_ptr.try_to_non_nullable();

	var CachingGameResourcesLoaderPtr caching_game_resources_loader_ptr(
		CachingGameResourcesLoader( game_filesystem_ptr, console_out_ptr ) );

	var Game mut game( caching_game_resources_loader_ptr, console_out_ptr );

	var OpenGLWindow mut window( console_out_ptr );

	// Create classes requiring OpenGL context after OpenGL window creation.

	var Console mut console( console_out_ptr, window.GetViewportSize() );

	var TextDrawer mut text_drawer( window.GetViewportSize(), game_filesystem_ptr, console_out_ptr );

	var WorldDrawer mut world_drawer(
		game_filesystem_ptr,
		caching_game_resources_loader_ptr,
		console_out_ptr );

	var ust::vector</bool/> mut keyboard_state;

	var u64 system_performace_counter_frequency= ( unsafe( SDL_GetPerformanceFrequency() ) );

	var u64 mut prev_frame_time_point= unsafe( SDL_GetPerformanceCounter() );

	ConsoleOutAddTextLine( console_out_ptr, "PanzerMortyr initialized!" );

	loop label main_loop
	{
		var bool mut had_console_toggle_event= false;

		var SDL_Event mut event= zero_init;
		while( unsafe( SDL_PollEvent( $<(event) ) ) != 0 )
		{
			var SDL_EventType t( size_type( event.union_contents[0] ) );
			if( t == SDL_QUIT )
			{
				break label main_loop;
			}
			if( t == SDL_WINDOWEVENT )
			{
				// Assume we have only single window and we should quit if it closes.
				auto& windows_event= unsafe( cast_ref_unsafe</SDL_WindowEvent/>( event ) );
				if( SDL_WindowEventID( windows_event.event ) == SDL_WINDOWEVENT_CLOSE )
				{
					break label main_loop;
				}
			}
			if( t == SDL_KEYDOWN )
			{
				// Assume we have only single window and we process only keyboard events from it.
				auto& keyboard_event= unsafe( cast_ref_unsafe</SDL_KeyboardEvent/>( event ) );
				if( keyboard_event.keysym.scancode == SDL_SCANCODE_ESCAPE )
				{
					if( console.IsActive() )
					{
						console.Toggle();
					}
				}
				else if( keyboard_event.keysym.scancode == SDL_SCANCODE_GRAVE )
				{
					console.Toggle();
					had_console_toggle_event= true;
				}
				else
				{
					if( console.IsActive() )
					{
						var HostCommandProcessor mut command_processor{ .game= game, .console_out_ptr= console_out_ptr };
						console.ProcessKeyPress( keyboard_event.keysym, command_processor );

						if( command_processor.quit_requested )
						{
							break label main_loop;
						}
					}
				}
			}
			if( t == SDL_TEXTINPUT )
			{
				auto& text_input_event= unsafe( cast_ref_unsafe</SDL_TextInputEvent/>( event ) );
				if( !had_console_toggle_event && console.IsActive() )
				{
					console.ProcessTextInput( text_input_event );
				}
			}
			if( t == SDL_MOUSEBUTTONDOWN )
			{
				auto& mouse_button_event= unsafe( cast_ref_unsafe</SDL_MouseButtonEvent/>( event ) );
				game.ProcessMouseButtonPress( u32( mouse_button_event.button ) );
			}
		}

		if( console.IsActive() )
		{
			foreach( &mut b : keyboard_state )
			{
				b= false;
			}
		}
		else
		{
			var i32 mut key_count= 0;
			var $(Uint8) keyboard_state_raw= unsafe( SDL_GetKeyboardState( $<( key_count ) ) );

			keyboard_state.resize( size_type( key_count ), false );

			for( auto mut i= 0s; i < size_type(key_count); ++i )
			{
				keyboard_state[i]= unsafe( $>( keyboard_state_raw + i ) ) != Uint8(0);
			}
		}

		var u64 cur_frame_time_point=  unsafe( SDL_GetPerformanceCounter() );

		var f32 time_delta_s= ( f32( cur_frame_time_point ) - f32( prev_frame_time_point ) ) / f32( system_performace_counter_frequency );
		var f32 time_delta_s_limited= ust::min( ust::max( 0.0001f, time_delta_s ), 0.1f );

		game.Update( time_delta_s_limited, keyboard_state );
		console.Update( time_delta_s );

		auto viewport_size= window.GetViewportSize();

		world_drawer.Draw(
			game.GetWorldDrawingInfo(),
			WorldDrawingViewportInfo{ .view_aspect= f32( viewport_size[0] ) / f32( viewport_size[1] ) } );

		console.Draw( text_drawer );

		{
			var u32 mcs( time_delta_s * 1000000.0f );
			var [ char8, 9 ] text
			[
				( u32('0') + u32( mcs / 1000000u  % 10u ) ),
				( u32('0') + u32( mcs /  100000u  % 10u ) ),
				( u32('0') + u32( mcs /   10000u  % 10u ) ),
				( u32('0') + u32( mcs /    1000u  % 10u ) ),
				'.',
				( u32('0') + u32( mcs /     100u  % 10u ) ),
				( u32('0') + u32( mcs /      10u  % 10u ) ),
				'm',
				's',
			];

			var [ u32, 2 ] viewport_size= window.GetViewportSize();

			text_drawer.AddText(
				f32( viewport_size[0] - 7u * u32( typeinfo</ typeof(text) />.element_count ) ),
				f32( viewport_size[1] - 8u ),
				text,
				TextDrawer::Settings
				{
					.monospace= true,
					.background_color[ 0u8, 0u8, 0u8, 128u8 ],
				} );
		}

		text_drawer.DrawTexts();

		window.SwapWindow();

		// If vsync is off it may happen that we are too fast.
		// In such case wait a little bit.
		var f32 c_min_frame_delta_s= 4.0f / 1000.0f; // 4ms frame time means 250fps.
		if( time_delta_s < c_min_frame_delta_s )
		{
			var f32 time_to_sleep_s= c_min_frame_delta_s - time_delta_s;
			var u32 time_to_sleep_ms( ust::ceil( time_to_sleep_s * 1000.0f ) );
			unsafe( SDL_Delay( time_to_sleep_ms ) );
		}

		prev_frame_time_point= cur_frame_time_point;
	}

	SaveSettings( settings_ptr.lock_imut().deref() );

	// This should be called always.
	unsafe( SDL_Quit() );

	return 0;
}

// A helper struct for processing console commands.
struct HostCommandProcessor
{
	//
	// Own process* functions.
	//

	fn process_quit( mut this )
	{
		quit_requested= true;
	}

	fn process_map( this, ust::iterator</ WordsIterator /> mut args )
	{
		if_var( map_name : args.next() )
		{
			if_var( map_index : ust::parse_integer_exact</u32/>( map_name ) )
			{
				game.TeleportToMap( map_index );
			}
			else
			{
				ConsoleOutAddTextLine( console_out_ptr, "Failed to parse map index!" );
			}
		}
		else
		{
			ConsoleOutAddTextLine( console_out_ptr, "Expected map index." );
		}
	}

	//
	// Create proxies for Game::process_* methods using mixins and type information for Game class.
	//

	mixin( generate_game_processing_method_proxies() );

	fn constexpr generate_game_processing_method_proxies() : [ char8, 1024s ]
	{
		var ust::mixin_utils::static_string</1024s/> mut s;

		auto& processor_functions_prefix= "process_";

		foreach( &function_info : typeinfo</Game/>.functions_list )
		{
			static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
			{
				s+= "fn " + function_info.name + "( mut this ) { game. " + function_info.name + "(); }\n";
			}
		}

		return s.buffer;
	}

	//
	// Host members and other fields.
	//

	bool quit_requested= false;
	Game &mut @('a') game;
	ConsoleOutPtr& @('b') console_out_ptr;
}

} // namespace PM
