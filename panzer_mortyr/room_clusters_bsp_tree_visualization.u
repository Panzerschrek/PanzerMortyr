import "room_clusters_bsp_tree_visualization.iu"
import "debug_visualization.iu"

namespace PM
{

fn VisualizeRoomClustersBSPTree( RoomClustersBSPTree& tree, ust::vector</WorldDrawingInfo::TestLine/> &mut out_lines )
{
	foreach( &leaf_node : tree.leaf_nodes )
	{
		var [ u8, 3 ] color[ 255u8, 0u8, 255u8 ];

		CreateBBoxLines( leaf_node.bbox, color, out_lines );
		CreateBBoxSideDiagonalLines( leaf_node.bbox, color, out_lines );
	}
}

} // namespace PM
