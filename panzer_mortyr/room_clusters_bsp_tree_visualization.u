import "room_clusters_bsp_tree_visualization.iu"
import "debug_visualization.iu"

namespace PM
{

fn VisualizeRoomClustersBSPTree(
	RoomClustersBSPTree& tree,
	Vec3f& camera_position,
	ust::vector</WorldDrawingInfo::TestLine/> &mut out_lines )
{
	var u32 mut leaf_node_counter= 0u;
	VisualizeRoomClustersBSPTree_r(
		tree, camera_position, RoomClustersBSPTree::NodeIndex(0), leaf_node_counter, out_lines );
}

fn VisualizeRoomClustersBSPTree_r(
	RoomClustersBSPTree& tree,
	Vec3f& camera_position,
	RoomClustersBSPTree::NodeIndex node_index,
	u32 &mut leaf_node_counter,
	ust::vector</WorldDrawingInfo::TestLine/> &mut out_lines )
{
	if( node_index >= RoomClustersBSPTree::c_first_leaf_node )
	{
		var RoomClustersBSPTree::LeafNode& leaf_node= tree.leaf_nodes[ size_type( node_index ) - size_type( RoomClustersBSPTree::c_first_leaf_node ) ];

		var u8 brightness( leaf_node_counter * 255u / u32( tree.leaf_nodes.size() ) );
		var [ u8, 3 ] mut color[ brightness ... ];

		if( leaf_node_counter == 0u )
		{
			// Display portals only for current leaf.
			var [ u8, 3 ] portals_color[ 255u8, 255u8, 128u8 ];

			for( auto mut i= 0s; i < size_type( leaf_node.num_leaf_portals ); ++i )
			{
				var size_type portal_index( tree.leaf_portals[ size_type( leaf_node.first_leaf_portal ) + i ] );
				var RoomClustersBSPTree::Portal& portal= tree.portals[ portal_index ];
				var BBox3f bbox_extended
				{
					.min= portal.bbox.min - Vec3f( 1.0f, 1.0f, 1.0f ),
					.max= portal.bbox.max + Vec3f( 1.0f, 1.0f, 1.0f ),
				};

				CreateBBoxLines( bbox_extended, portals_color, out_lines );
			}

			color= ust::make_array( 255u8, 0u8, 255u8 );
		}

		CreateBBoxLines( leaf_node.bbox, color, out_lines );
		CreateBBoxSideDiagonalLines( leaf_node.bbox, color, out_lines );

		++leaf_node_counter;
	}
	else
	{
		var RoomClustersBSPTree::BranchNode& branch_node= tree.branch_nodes[ size_type( node_index ) ];
		var f32 distance= branch_node.plane.GetDistanceForPoint( camera_position );

		var [ RoomClustersBSPTree::NodeIndex, 2 ] children_order=
			( distance > 0.0f
				? ust::make_array( branch_node.children[0], branch_node.children[1] )
				: ust::make_array( branch_node.children[1], branch_node.children[0] ) );

		foreach( child_node_index : children_order )
		{
			VisualizeRoomClustersBSPTree_r( tree, camera_position, child_node_index, leaf_node_counter, out_lines );
		}
	}
}

} // namespace PM
