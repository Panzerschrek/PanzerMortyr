import "/hash_map.iu"
import "/path.iu"
import "/common_lib/resource_string.iu"
import "console_out.iu"

namespace PM
{

struct GameDataSearchResult
{
	ust::filesystem_path data_directory; // Where archive file and other files are located.
	ust::optional</ ust::filesystem_path /> archive_file; // Is empty if has no archive file and only individual files.
}

fn SearchForGameData(
	ust::filesystem_path_view executable_path,
	ust::filesystem_path_view custom_game_installation_directory_path,
	ConsoleOutPtr& console_out ) : ust::optional</GameDataSearchResult/>;

type GameDataFiles= ust::hash_map</ ResourceString, ust::filesystem_path />;

fn CollectGameDataFiles( ConsoleOutPtr& console_out, ust::filesystem_path_view data_directory ) : GameDataFiles;

} // namespace PM
