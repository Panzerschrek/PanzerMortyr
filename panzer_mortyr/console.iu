import "/integer_parsing.iu"
import "/string_conversions.iu"
import "/common_lib/string_iterators.iu"
import "console_out.iu"
import "image_drawer.iu"
import "settings.iu"
import "text_drawer.iu"

namespace PM
{

// A console class, which is able to display messages and execute commands which can be typed.
// Messages to display are taken from given console out instance.
class Console
{
public:
	fn constructor( SettingsPtr settings, ConsoleOutPtr console_out, [ u32, 2 ] viewport_size );

	// Turn it on or off. Active console is shown and input should be redirected to it.
	fn Toggle( mut this );

	fn IsActive( this ) : bool;

	fn IsVisible( this ) : bool;

	// Process key presses, processing resulting commands with given processor class.
	// This class should contain methods with names like "process_xxx" - where "xxx" is a command name.
	// Two kinds of signatures are possible - with no arguments or with single argument of type ust::iterator</ WordsIterator />.
	// Please, use lowercase command names with underscores separating words.
	//
	template</type ProcessorClass/>
	fn ProcessKeyPress( mut this, SDL_Keysym& key_sym, ProcessorClass &mut processor_class )
	{
		auto& processor_functions_prefix= "process_";
		var size_type processor_functions_prefix_len= typeinfo</ typeof(processor_functions_prefix) />.element_count;

		if( key_sym.scancode == SDL_SCANCODE_BACKSPACE )
		{
			if( !input_line_.empty() )
			{
				input_line_.drop_back();
			}
		}
		if( key_sym.scancode == SDL_SCANCODE_UP )
		{
			// Restore previous entered command on up key press.
			input_line_= previous_command_;
		}
		else if( key_sym.scancode == SDL_SCANCODE_TAB )
		{
			var ust::string8 input_line_copy= input_line_;
			auto mut input_line_words_it= ust::wrap_raw_iterator( WordsIterator( input_line_copy ) );
			var ust::string_view8 command_start= input_line_words_it.next().deref_or( ust::string_view8( "" ) );

			var size_type mut num_matches= 0s;

			foreach( &function_info : typeinfo</ProcessorClass/>.functions_list )
			{
				static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
				{
					var ust::string_view8 handler_command_name=
						ust::string_view8( function_info.name ).subrange_start( processor_functions_prefix_len );

					if( handler_command_name.starts_with( command_start ) )
					{
						ConsoleOutAddTextLine( console_out_, ust::concat( " ", handler_command_name ) );
						++num_matches;
					}
				}
			}

			foreach( &setting_field_description : typeinfo</Settings/>.fields_list )
			{
				if( ust::string_view8( setting_field_description.name ).starts_with( command_start ) )
				{
					ConsoleOutAddTextLine( console_out_, ust::concat( " ", setting_field_description.name ) );
					++num_matches;
				}
			}

			if( num_matches == 0s )
			{
				return;
			}

			ConsoleOutAddTextLine( console_out_, "--------------------------------" );

			var ust::string8 mut command_completed= command_start;

			loop label complete_char_by_char
			{
				var char8 mut next_char= '\0';

				foreach( &function_info : typeinfo</ProcessorClass/>.functions_list )
				{
					static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
					{
						var ust::string_view8 handler_command_name=
							ust::string_view8( function_info.name ).subrange_start( processor_functions_prefix_len );

						if( handler_command_name.starts_with( command_start ) )
						{
							if( handler_command_name.size() <= command_completed.size() )
							{
								break label complete_char_by_char;
							}
							var char8 c= handler_command_name[ command_completed.size() ];
							if( next_char == '\0' )
							{
								next_char= c;
							}
							else if( c != next_char )
							{
								break label complete_char_by_char;
							}
						}
					}
				}

				foreach( &setting_field_description : typeinfo</Settings/>.fields_list )
				{
					var ust::string_view8 setting_field_description_name= setting_field_description.name;
					if( setting_field_description_name.starts_with( command_start ) )
					{
						if( setting_field_description_name.size() <= command_completed.size() )
						{
							break label complete_char_by_char;
						}
						var char8 c= setting_field_description_name[ command_completed.size() ];
						if( next_char == '\0' )
						{
							next_char= c;
						}
						else if( c != next_char )
						{
							break label complete_char_by_char;
						}
					}
				}

				command_completed.push_back( next_char );
			}

			input_line_= command_completed;
		}
		else if( key_sym.scancode == SDL_SCANCODE_RETURN )
		{
			var ust::string8 input_line= take(input_line_);

			auto mut input_line_words_it= ust::wrap_raw_iterator( WordsIterator( input_line ) );
			auto command_name_opt= input_line_words_it.next();
			if( command_name_opt.empty() )
			{
				return;
			}
			var ust::string_view8 command_name= command_name_opt.try_deref();

			// Search for a command.
			foreach( &function_info : typeinfo</ProcessorClass/>.functions_list )
			{
				static_if( ust::constexpr_string_starts_with( function_info.name, processor_functions_prefix ) )
				{
					var ust::string_view8 handler_command_name=
						ust::string_view8( function_info.name ).subrange_start( processor_functions_prefix_len );
					if( command_name == handler_command_name )
					{
						// Add echo before calling command handler.
						ConsoleOutAddTextLine( console_out_, input_line );

						static_if( typeinfo</ typeof( function_info.type.params_list ) />.element_count == 1s )
						{
							mixin( "processor_class." + function_info.name + "();" );
							move( input_line_words_it );
						}
						else static_if( typeinfo</ typeof( function_info.type.params_list ) />.element_count == 2s )
						{
							mixin( "processor_class." + function_info.name + "( move( input_line_words_it ) );" );
						}
						else
						{
							static_assert( "Unexpected number of params in command processor class!" );
						}

						previous_command_= input_line;
						return;
					}
				}
			}

			// Search for a setting.
			foreach( &setting_field_description : typeinfo</Settings/>.fields_list )
			{
				if( command_name == setting_field_description.name )
				{
					with( mut settings_lock : settings_.lock_mut() )
					{
						auto &mut setting_field= mixin( "settings_lock.deref()." + setting_field_description.name );

						static_if( setting_field_description.type.is_bool )
						{
							if_var( new_value_str : input_line_words_it.next() )
							{
								if_var( n : ust::parse_integer_exact</u32/>( new_value_str ) )
								{
									setting_field= n != 0u;
								}
								else
								{
									ConsoleOutAddTextLine( console_out_, "Failed to parse setting value!" );
								}
							}
							else
							{
								ConsoleOutAddTextLine(
									console_out_,
									ust::concat(
										setting_field_description.name,
										" is ",
										( setting_field ? "1" : "0" ) ) );
							}
						}
						else static_if( setting_field_description.type.is_integer )
						{
							if_var( new_value_str : input_line_words_it.next() )
							{
								if_var( n : ust::parse_integer_exact</ typeof( setting_field ) />( new_value_str ) )
								{
									setting_field= n;
								}
								else
								{
									ConsoleOutAddTextLine( console_out_, "Failed to parse setting value!" );
								}
							}
							else
							{
								ConsoleOutAddTextLine(
									console_out_,
									ust::concat(
										setting_field_description.name,
										" is ",
										ust::to_string8( setting_field ) ) );
							}
						}
						else
						{
							static_assert( false, "Unhandled setting type!" );
						}
					}

					previous_command_= input_line;
					return;
				}
			}

			previous_command_= input_line;
			ConsoleOutAddTextLine( console_out_, ust::concat( "Command '", command_name, "', not found" ) );
		}
	}

	fn ProcessTextInput( mut this, SDL_TextInputEvent& text_input_event );

	fn Update( mut this, f32 time_delta_s );

	fn Draw( this, ImageDrawer &mut image_drawer, TextDrawer &mut text_drawer );

private:
	SettingsPtr imut settings_;
	ConsoleOutPtr imut console_out_;

	[ u32, 2 ] imut viewport_size_;

	bool background_image_preloaded_= false;

	f32 time_s_= 0.0f;

	bool is_active_= false;
	f32 screen_position_= 0.0f; // 1.0f - fully visible, 0.0f - fully hidden.

	ust::string8 input_line_;
	ust::string8 previous_command_; // Store single entry for history. It's enough for most cases.
}

} // namespace PM
