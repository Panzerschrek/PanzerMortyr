import "/directory_iterator.iu"
import "/enum_string_conversions.iu"
import "/file_helpers.iu"
import "/hash_set.iu"
import "/path_utils.iu"
import "/string_conversions.iu"
import "sound_loading.iu"

namespace PM
{

fn TestLoadAllSounds( ConsoleOutPtr& console_out )
{
	var ust::hash_set</u32/> mut used_frequencies;
	var ust::hash_set</u32/> mut used_formats;
	var ust::hash_set</u32/> mut used_channels;

	var ust::filesystem_path dir= "other/sound_files";
	foreach( &entry : ust::open_directory_for_iteration( dir ).try_take() )
	{
		var ust::filesystem_path file_path= ust::path::join( dir, entry.try_deref().name );

		ConsoleOutAddTextLine( console_out, ust::concat( "Audio file ", file_path ) );

		var ust::vector</byte8/> mut file_contents= ust::read_file_to_byte8_vector( file_path ).try_take();

		var ust::string8 mut file_path_nt= file_path + "\0";
		unsafe
		{
			var SDL_AudioSpec mut spec= zero_init;
			var $(Uint8) mut audio_buf= zero_init;
			var Uint32 mut audio_len= 0u;

			auto call_res=
				SDL_LoadWAV_RW(
					SDL_RWFromMem( file_contents.data(), i32( file_contents.size() ) ),
					1,
					$<( spec ),
					$<( audio_buf ),
					$<( audio_len ) );

			if( ust::is_nullptr( call_res ) )
			{
				safe( ConsoleOutAddTextLine( console_out, "Failed to load!" ) );
				continue;
			}

			safe
			{
				var ust::string8 mut s;
				s+= "frequency: "; s+= ust::to_string8( spec.freq );
				s+= ", channels: "; s+= ust::to_string8( spec.channels );
				s+= ", format: "; s+= ust::to_string8( spec.format );

				ConsoleOutAddTextLine( console_out, s );

				used_frequencies.insert( u32( spec.freq ) );
				used_formats.insert( u32( spec.format ) );
				used_channels.insert( u32( spec.channels ) );
			}

			SDL_FreeWAV( audio_buf );
		}
	}

	{
		var ust::string8 mut s;
		s+= "Used frequencies: ";
		foreach( f : used_frequencies )
		{
			s+= ust::to_string8( f );
			s+= ", ";
		}
		ConsoleOutAddTextLine( console_out, s );
	}

	{
		var ust::string8 mut s;
		s+= "Used formats: ";
		foreach( f : used_formats )
		{
			s+= ust::to_string8( f );
			s+= ", ";
		}
		ConsoleOutAddTextLine( console_out, s );
	}

	{
		var ust::string8 mut s;
		s+= "Used channels: ";
		foreach( f : used_channels )
		{
			s+= ust::to_string8( f );
			s+= ", ";
		}
		ConsoleOutAddTextLine( console_out, s );
	}
}

fn LoadSoundData(
	ConsoleOutPtr& console_out,
	GameFilesystem &mut game_filesystem,
	ResourceString& file_name ) : ust::optional</SoundDataAbstract/>
{
	result_match( game_filesystem.LoadFileToByte8Vector( file_name ) )
	{
		Ok( mut file_contents ) ->
		{
			unsafe
			{
				// TODO - consider writing our own code loading WAV files, which doesn't require "unsafe" to be loaded.

				var SDL_AudioSpec mut spec= zero_init;
				var $(Uint8) mut audio_buf= zero_init;
				var Uint32 mut audio_len= 0u;

				auto call_res=
					SDL_LoadWAV_RW(
						SDL_RWFromMem( file_contents.data(), i32( file_contents.size() ) ),
						1,
						$<( spec ),
						$<( audio_buf ),
						$<( audio_len ) );

				if( ust::is_nullptr( call_res ) )
				{
					safe( ConsoleOutAddTextLine(
						console_out,
						ust::concat(
							"Failed to load WAV file\"",
							ConvertResourceStringToStringView( file_name ),
							"\"!" ) ) );
					return ust::null_optional;
				}

				if( spec.channels != 1u8 )
				{
					safe( ConsoleOutAddTextLine(
						console_out,
						ust::concat(
							"Unsupported number of channels in WAV file\"",
							ConvertResourceStringToStringView( file_name ),
							"\"! Expected exactly 1 channel." ) ) );
					return ust::null_optional;
				}

				switch( i32( spec.format ) )
				{
					AUDIO_U8 ->
					{
						type SampleType= u8;
						return
							SoundDataAbstract(
								SoundData</SampleType/>(
									u32( spec.freq ),
									ust::byte_ptr_cast</SampleType/>( ust::ptr_cast_to_byte8( audio_buf ) ),
									u32( audio_len ) / u32( typeinfo</SampleType/>.size_of ) ) );
					},
					AUDIO_S16LSB ->
					{
						type SampleType= i16;
						return
							SoundDataAbstract(
								SoundData</SampleType/>(
									u32( spec.freq ),
									ust::byte_ptr_cast</SampleType/>( ust::ptr_cast_to_byte8( audio_buf ) ),
									u32( audio_len ) / u32( typeinfo</SampleType/>.size_of ) ) );
					},
					default ->
					{
						safe( ConsoleOutAddTextLine(
							console_out,
							ust::concat(
								"Unsupported format ",
									ust::to_string8( spec.format ),
									" for WAV file\"",
									ConvertResourceStringToStringView( file_name ),
									"\"!" ) ) );
						return ust::null_optional;
					}
				}
			}
		},
		Err(e) ->
		{
			ConsoleOutAddTextLine(
				console_out,
				ust::concat(
					"Failed to load file \"",
					ConvertResourceStringToStringView( file_name ),
					"\"! Error: ",
					ust::enum_to_string(e) ) );

			return ust::null_optional;
		},
	}
}

} // namespace PM
