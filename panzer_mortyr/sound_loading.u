import "/enum_string_conversions.iu"
import "/path_utils.iu"
import "/string_conversions.iu"
import "/common_lib/wav_header.iu"
import "sound_loading.iu"

namespace PM
{

fn LoadSoundData(
	ConsoleOutPtr& console_out,
	GameFilesystem &mut game_filesystem,
	ResourceString& file_name ) : ust::optional</SoundDataAbstract/>
{
	auto mut load_res=
		game_filesystem.LoadFile(
			file_name,
			lambda[&]( ust::file_readable &mut f ) : ust::io_result</ SoundDataAbstract />
			{
				return LoadSoundDataImpl( f, console_out );
			} );

	if_var( e : load_res.as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out,
			ust::concat(
				"Failed to load file \"",
				ConvertResourceStringToStringView( file_name ),
				"\"! Error: ",
				ust::enum_to_string(e) ) );

		return ust::null_optional;
	}

	return move( load_res ).try_take();
}

fn LoadSoundDataImpl( ust::file_readable &mut f, ConsoleOutPtr& console_out ) : ust::io_result</ SoundDataAbstract />
{
	var WavHeader mut header= zero_init;
	result_check_or_return( f.read_exact( ust::single_element_array_view( header ).to_byte8_range() ) );

	if( !(
		header.file_type_block_id == 0x46464952u &&
		header.file_format_id == 0x45564157u &&
		header.format_block_id == 0x20746D66u &&
		header.data_block_id == 0x61746164u ) )
	{
		ConsoleOutAddTextLine( console_out, "Not a WAV file!\n" );
		return ust::io_error::other;
	}

	if( header.audio_format != 1u16 )
	{
		ConsoleOutAddTextLine( console_out, "Unsupported audio format of WAV file!\n" );
		return ust::io_error::other;
	}

	if( header.num_channels != 1u16 )
	{
		ConsoleOutAddTextLine( console_out, "Unsupported number of channels in WAV file! Expected exactly 1 channel." );
		return ust::io_error::other;
	}

	if( header.bits_per_sample == 8u16 )
	{
		var SoundData</u8/> mut sound_data
		{
			.frequency= header.frequency,
			.samples( size_type( header.data_size ) / typeinfo</u8/>.size_of, 0u8 ),
		};

		result_check_or_return( f.read_exact( sound_data.samples.range().to_byte8_range() ) );

		return SoundDataAbstract( move( sound_data ) );
	}
	else if( header.bits_per_sample == 16u16 )
	{
		var SoundData</i16/> mut sound_data
		{
			.frequency= header.frequency,
			.samples( size_type( header.data_size ) / typeinfo</i16/>.size_of, 0i16 ),
		};

		result_check_or_return( f.read_exact( sound_data.samples.range().to_byte8_range() ) );

		return SoundDataAbstract( move( sound_data ) );
	}
	else
	{
		ConsoleOutAddTextLine( console_out, "Unsupported audio format of WAV file! Expected 8-bit or 32-bit." );
		return ust::io_error::other;
	}
}

} // namespace PM
