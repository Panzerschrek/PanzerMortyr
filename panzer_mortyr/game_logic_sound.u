import "game_constants.iu"
import "game_logic_sound.iu"

namespace PM
{

fn EmitDynamicClusterSound( SoundsDescription& sounds_description, u8 cluster_type, SoundSourceSlot &mut slot )
{
	var i32 sound_index= GetSoundIndexForDynamicCluster( sounds_description, cluster_type );
	if( sound_index >= 0 && sound_index <= 255 )
	{
		++slot.sequential_index;
		slot.sound_index= u8( sound_index );
		slot.volume= 255u8; // TODO - tune it?
	}
}

fn GetSoundIndexForDynamicCluster( SoundsDescription& sounds_description, u8 cluster_type ) : i32
{
	switch( cluster_type )
	{
		// Vertically-moving elevators.
		ZvoxCluster::c_cluster_type_z_plus_door_a,
		ZvoxCluster::c_cluster_type_z_minus_door_b,
		ZvoxCluster::c_cluster_type_z_plus_door_b,
		ZvoxCluster::c_cluster_type_z_minus_door_c
			-> { return sounds_description.elevator; },
		// Vertically-moving doors.
		ZvoxCluster::c_cluster_type_z_minus_door_a
			-> { return sounds_description.door; },
		// Horizontally-moving doors.
		ZvoxCluster::c_cluster_type_y_minus_door_a,
		ZvoxCluster::c_cluster_type_y_plus_door_a,
		ZvoxCluster::c_cluster_type_x_minus_door_a
			-> { return sounds_description.door; },
		// Buttons.
		ZvoxCluster::c_cluster_type_y_minus_button_a,
		ZvoxCluster::c_cluster_type_y_plus_button_a,
		ZvoxCluster::c_cluster_type_x_plus_button_a,
		ZvoxCluster::c_cluster_type_x_minus_button_a,
		ZvoxCluster::c_cluster_type_y_minus_button_b,
		ZvoxCluster::c_cluster_type_y_plus_button_b,
		ZvoxCluster::c_cluster_type_x_plus_button_b,
		ZvoxCluster::c_cluster_type_x_minus_button_b
			-> { return sounds_description.push_button; },
		default
			-> { return -1; }
	}
}

fn EmitStaticSound( StaticSoundSources &mut sources, u8 sound_index, u32 volume, Vec3f& position )
{
	if( volume <= 0u )
	{
		return;
	}

	var StaticSoundSources::Slot &mut slot= sources.slots[ sources.next_slot ];

	++sources.next_slot;
	if( size_type( sources.next_slot ) == typeinfo</ typeof( sources.slots ) />.element_count )
	{
		sources.next_slot= 0u; // Wrap around.
	}

	++slot.sequential_index;

	slot.sound_index= sound_index;
	slot.volume= u8( ust::min( volume, 255u ) );
	slot.positon= position;
}

fn EmitProjectileBounceSound(
	StaticSoundSources &mut sources,
	EntitiesDescription::Tool& weapon_tool,
	MaterialProperties& material_properties,
	Vec3f& position,
	Vec3f& velocity )
{
	if( weapon_tool.hit_wall < 0 | weapon_tool.hit_wall > 255 )
	{
		return;
	}

	var u32 volume= u32( 255.0f * velocity.Length() / f32( weapon_tool.speed ) );

	if( volume < 64u )
	{
		// Don't play bounce sounds if lost too much speed.
		// This is needed as an optimization - since too many bounces may lead to too many sounds emitted.
		return;
	}

	EmitStaticSound( sources, u8( weapon_tool.hit_wall ), volume, position );

	// Investigations have shown, that the projectile hit sound is played together with a bounce sound.
	EmitProjectileHitSound( sources, weapon_tool, material_properties, position );
}

fn EmitProjectileHitSound(
	StaticSoundSources &mut sources,
	EntitiesDescription::Tool& weapon_tool,
	MaterialProperties& material_properties,
	Vec3f& position )
{
	if( weapon_tool.wall_collision != 0 )
	{
		return;
	}

	if( material_properties.wall_collision[1] >= 0 && material_properties.wall_collision[1] <= 255 )
	{
		// Reduce volume for weapons firing more than one projectile.
		var u32 volume= 255u / ust::max( 1u, ust::min( 6u, u32( weapon_tool.shot_data.size() ) ) );

		EmitStaticSound( sources, u8( material_properties.wall_collision[1] ), volume, position );
	}
}

fn EmitProjectileObjectHitSound(
	StaticSoundSources &mut sources, EntitiesDescription::Tool& weapon_tool, Vec3f& position )
{
	if( weapon_tool.hit_object >= 0 && weapon_tool.hit_object <= 255 )
	{
		var u32 volume= 255u;
		EmitStaticSound( sources, u8(weapon_tool.hit_object), volume, position );
	}
}

