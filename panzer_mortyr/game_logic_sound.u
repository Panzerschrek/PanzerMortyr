fn EmitEntityRandomDamageSound(
	SoundsDescription& sounds_description, PseudoRandomGenerator &mut rand, EntitySoundSourceSlots &mut slots )
{
	// Select one of the available damage sounds randomly.
	var u32 constexpr num_sounds( typeinfo</ typeof( sounds_description.enemy_damage ) />.element_count );
	var i32 sound_index= sounds_description.enemy_damage[ rand.Next() % num_sounds ];

	if( sound_index >= 0 && sound_index <= 255 )
	{
		var u32 volume= 255u; // TODO - tune it?
		EmitSound( slots, u8( sound_index ), volume );
	}
}

fn EmitEntityRandomAlarmSound(
	SoundsDescription& sounds_description,
	PseudoRandomGenerator &mut rand,
	GlobalAlarmSoundsState &mut global_alarm_sounds_state,
	u32 current_step_index,
	EntitySoundSourceSlots &mut slots )
{
	// Avoid emitting an alarm sound if another one was played recently.
	var u32 c_min_delay_between_alarm_sounds( c_steps_per_second * 2.0f );
	if( current_step_index <
		global_alarm_sounds_state.last_emitted_alarm_sound_step_index + c_min_delay_between_alarm_sounds )
	{
		return;
	}

	for( auto mut i= 0s; i < 5s; ++i )
	{
		// Select one of the available alarm sounds randomly.
		var u32 constexpr num_sounds( typeinfo</ typeof( sounds_description.enemy_alarm ) />.element_count );
		var i32 sound_index= sounds_description.enemy_alarm[ rand.Next() % num_sounds ];

		if( sound_index >= 0 && sound_index <= 255 &&
			// Ensure we play an alarm sound different from the last one.
			sound_index != global_alarm_sounds_state.last_emitted_alarm_sound_index )
		{
			var u32 volume= 255u; // TODO - tune it?
			EmitSound( slots, u8( sound_index ), volume );

			global_alarm_sounds_state.last_emitted_alarm_sound_step_index= current_step_index;
			global_alarm_sounds_state.last_emitted_alarm_sound_index= sound_index;

			break;
		}
	}
}

