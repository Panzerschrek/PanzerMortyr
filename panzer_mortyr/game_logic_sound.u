import "game_logic_sound.iu"

namespace PM
{

fn EmitStaticSound( StaticSoundSources &mut sources, u8 sound_index, u32 volume, Vec3f& position )
{
	if( volume <= 0u )
	{
		return;
	}

	var StaticSoundSources::Slot &mut slot= sources.slots[ sources.next_slot ];

	++sources.next_slot;
	if( size_type( sources.next_slot ) == typeinfo</ typeof( sources.slots ) />.element_count )
	{
		sources.next_slot= 0u; // Wrap around.
	}

	++slot.sequential_index;

	slot.sound_index= sound_index;
	slot.volume= u8( ust::min( volume, 255u ) );
	slot.positon= position;
}

fn EmitProjectileBounceSound(
	StaticSoundSources &mut sources, EntitiesDescription::Tool& weapon_tool, Vec3f& position, Vec3f& velocity )
{
	if( weapon_tool.hit_wall < 0 | weapon_tool.hit_wall > 255 )
	{
		return;
	}

	var f32 extra_scale= 8.0f;

	var u32 volume= u32( 255.0f * extra_scale * velocity.Length() / f32( weapon_tool.speed ) );

	if( volume < 32u )
	{
		return; // Don't play bounce sounds for projectiles with almost zero speed. It's useful for grenades, for example.
	}

	EmitStaticSound( sources, u8( weapon_tool.hit_wall ), volume, position );
}

fn EmitProjectileHitGenericSound(
	StaticSoundSources &mut sources, EntitiesDescription::Tool& weapon_tool, Vec3f& position )
{
	if( weapon_tool.world_collision != 0 )
	{
		return;
	}

	// Reduce volume for weapons firing more than one projectile.
	var u32 volume= 255u / ust::max( 1u, ust::min( 6u, u32( weapon_tool.shot_data.size() ) ) );

	// For some reason the original game always plays "ryko2.wav" file, even if it isn't listed in the "GLOS.STD" file.
	// Hardcode here index of this sound.
	// TODO - investigate it properly, find clues that this special file name is really hardcoded.
	var u8 sound_index= 3u8;

	EmitStaticSound( sources, sound_index, volume, position );
}

fn EmitPlayerSpeechSound( i32 sound_index, PlayerSoundSourceSlots &mut slots )
{
	if( sound_index >= 0 && sound_index < i32( SoundsDescription::c_num_sounds ) )
	{
		var u32 volume= 255u; // TODO - tune it?
		EmitSound( slots, u8(sound_index), volume );
	}
}

