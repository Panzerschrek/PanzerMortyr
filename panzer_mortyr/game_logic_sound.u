fn EmitPickupSound(
	SoundsDescription& sounds_description, EntitiesDescription::ToolType tool, PlayerSoundSourceSlots &mut slots )
{
	type TT= EntitiesDescription::ToolType;

	switch( tool )
	{
		TT::WeaponA -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[0], slots ); },
		TT::WeaponB -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[1], slots ); },
		TT::WeaponC -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[2], slots ); },
		TT::WeaponD -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[3], slots ); },
		TT::WeaponE -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[4], slots ); },
		TT::WeaponF -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[5], slots ); },
		TT::WeaponG -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[6], slots ); },
		TT::WeaponH -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[7], slots ); },
		TT::WeaponI -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[8], slots ); },
		TT::WeaponJ -> { EmitPickupSoundImpl( sounds_description.weapon_pickup[9], slots ); },
		TT::KeyA -> { EmitPickupSoundImpl( sounds_description.key_pickup[0], slots ); },
		TT::KeyB -> { EmitPickupSoundImpl( sounds_description.key_pickup[1], slots ); },
		TT::KeyC -> { EmitPickupSoundImpl( sounds_description.key_pickup[2], slots ); },
		TT::HealthPack -> {  EmitPickupSoundImpl( sounds_description.health_pickup, slots ); },
		TT::Armor -> { EmitPickupSoundImpl( sounds_description.armor_pickup, slots ); },
		// TODO - check if it's correct to use this sound for all other pick-ups.
		default -> { EmitPickupSoundImpl( sounds_description.other_pickup, slots ); },
	}
}

fn EmitPickupSoundImpl( i32 sound_index, PlayerSoundSourceSlots &mut slots )
{
	if( sound_index >= 0 && sound_index < i32( SoundsDescription::c_num_sounds ) )
	{
		var u32 volume= 255u; // TODO - tune it?
		EmitSound( slots, u8(sound_index), volume );
	}
}

} // namespace PM
