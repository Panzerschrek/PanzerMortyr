import "/variant.iu"
import "/vector.iu"

namespace PM
{

class Serializer
{
public:
	fn SerializeBytes( mut this, ust::array_view_imut</byte8/> bytes )
	{
		// TODO - speed-up this, resize the bytes container and copy all bytes in one memory copy call.
		bytes_.append( bytes.iter() );
	}

	fn TakeBytes( byval mut this ) : ust::vector</byte8/>
	{
		return take(bytes_);
	}

private:
	ust::vector</byte8/> bytes_;
}

class Deserializer
{
public:
	type BytesView= ust::array_view_imut</byte8/>;

	fn constructor( BytesView bytes ) @( ust::reference_notation::pollution::param0_param_1_inner_reference )
		( bytes_= bytes )
	{}

	// May return less than expected if has no bytes left.
	fn ExtractBytes( mut this, size_type num_bytes ) : BytesView @( ust::reference_notation::return_inner_references::param0_inner_reference0 )
	{
		var BytesView result= bytes_.subrange_end( num_bytes );
		bytes_= bytes_.subrange_start( num_bytes );
		return result;
	}

private:
	BytesView bytes_;
}

template</type T/>
fn Serialize( Serializer &mut serializer, T& value )
{
	auto& ti= typeinfo</T/>;
	static_if( ti.is_fundamental )
	{
		static_if( same_type</T, bool/> )
		{
			var byte8 bool_byte( ( value ? 1u8 : 0u8 ) );
			serializer.SerializeBytes( ust::single_element_array_view( bool_byte ) );
		}
		else
		{
			// TODO - maybe handle "size_type" in a special way?
			serializer.SerializeBytes( ust::single_element_array_view( value ).to_byte8_range() );
		}
	}
	else static_if( ti.is_enum )
	{
		// Save enums as bytes.
		serializer.SerializeBytes( ust::single_element_array_view( value ).to_byte8_range() );
	}
	else static_if( ti.is_array )
	{
		// Just serialize all elements of an array sequentially.
		for( auto mut i= 0s; i < ti.element_count; ++i )
		{
			Serialize( serializer, value[i] );
		}
	}
	else static_if( ti.is_tuple )
	{
		// Just serialize all elements of a tuple sequentially.
		foreach( &el : value )
		{
			Serialize( serializer, el );
		}
	}
	else static_if( ti.is_class )
	{
		static_if( SerializationImpl::IsOptional</T/>::value )
		{
			// Serialize non-empty flag.
			Serialize( serializer, !value.empty() );
			if_var( &stored_value : value )
			{
				// Serialize stored value if has it.
				Serialize( serializer, stored_value );
			}
		}
		else static_if( SerializationImpl::IsVector</T/>::value )
		{
			// Serialize size for vectors. TODO - maybe save it in platform-independent way (not via size_type)?
			Serialize( serializer, value.size() );
			// Serialize all vector elements sequentially.
			foreach( &el : value )
			{
				Serialize( serializer, el );
			}
		}
		else static_if( SerializationImpl::IsVariant</T/>::value )
		{
			// Serialize index of stored type for variants.
			Serialize( serializer, value.index() );
			// Then serialize current stored type.
			variant_visit( &el : value )
			{
				Serialize( serializer, el );
			}
		}
		else static_if( SerializationImpl::ClassHasSerializeMethod</T/>() )
		{
			// A class with "Serialize" method - call it.
			value.Serialize( serializer );
		}
		else
		{
			// For other classes assume we can just serialize separate fields.
			// Use typeinfo order of fields for serialization.
			foreach( &field_info : ti.fields_list )
			{
				Serialize( serializer, mixin( "value." + field_info.name ) );
			}
		}
	}
	else
	{
		static_assert( false, "Unsupported type kind!" );
	}
}

template</type T/>
fn Deserialize( Deserializer &mut deserializer ) : ust::optional</T/>
{
	auto& ti= typeinfo</T/>;
	static_if( ti.is_fundamental )
	{
		static_if( same_type</T, bool/> )
		{
			if_var( b : Deserialize</byte8/>( deserializer ) )
			{
				return b != byte8(0u8);
			}
			return ust::null_optional;
		}
		else
		{
			var Deserializer::BytesView bytes= deserializer.ExtractBytes( ti.size_of );
			if( bytes.size() < ti.size_of )
			{
				return ust::null_optional;
			}

			var T mut result= zero_init;
			ust::single_element_array_view( result ).to_byte8_range().copy_from( bytes );
			return result;
		}
	}
	else
	{
		// TODO
		static_assert( false, "Unsupported type kind!" );
	}
}

namespace SerializationImpl
{

struct FalseTypeStruct{ var bool value= false; }
struct TrueTypeStruct { var bool value= true ; }

template</type T/> type IsOptional</T/> = FalseTypeStruct;
template</type T/> type IsOptional</ ust::optional</T/> /> = TrueTypeStruct;

template</type T/> type IsVector</T/> = FalseTypeStruct;
template</type T/> type IsVector</ ust::vector</T/> /> = TrueTypeStruct;

template</type T/> type IsVariant</T/> = FalseTypeStruct;
template</type T/> type IsVariant</ ust::variant</T/> /> = TrueTypeStruct;

template</ type T />
fn constexpr ClassHasSerializeMethod() : bool
{
	for( &list_element : typeinfo</T/>.functions_list )
	{
		if( ust::constexpr_string_equals( list_element.name, "Serialize" ) )
		{
			return true;
		}
	}

	return false;
}

} // namespace SerializationImpl

} // namespace PM
