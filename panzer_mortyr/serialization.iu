import "/mixin_utils.iu"
import "/variant.iu"
import "/vector.iu"

namespace PM
{

class Serializer
{
public:
	fn SerializeBytes( mut this, ust::array_view_imut</byte8/> bytes )
	{
		// TODO - speed-up this, resize the bytes container and copy all bytes in one memory copy call.
		bytes_.append( bytes.iter() );
	}

	fn TakeBytes( byval mut this ) : ust::vector</byte8/>
	{
		return take(bytes_);
	}

private:
	ust::vector</byte8/> bytes_;
}

class Deserializer
{
public:
	type BytesView= ust::array_view_imut</byte8/>;

	fn constructor( BytesView bytes ) @( ust::reference_notation::pollution::param0_param_1_inner_reference )
		( bytes_= bytes )
	{}

	// May return less than expected if has no bytes left.
	fn ExtractBytes( mut this, size_type num_bytes ) : BytesView @( ust::reference_notation::return_inner_references::param0_inner_reference0 )
	{
		var BytesView result= bytes_.subrange_end( num_bytes );
		bytes_= bytes_.subrange_start( num_bytes );
		return result;
	}

private:
	BytesView bytes_;
}

template</type T/>
fn Serialize( Serializer &mut serializer, T& value )
{
	auto& ti= typeinfo</T/>;
	static_if( ti.is_fundamental )
	{
		static_if( same_type</T, bool/> )
		{
			var byte8 bool_byte( ( value ? 1u8 : 0u8 ) );
			serializer.SerializeBytes( ust::single_element_array_view( bool_byte ) );
		}
		else
		{
			// TODO - maybe handle "size_type" in a special way?
			serializer.SerializeBytes( ust::single_element_array_view( value ).to_byte8_range() );
		}
	}
	else static_if( ti.is_enum )
	{
		// Save enums as bytes.
		serializer.SerializeBytes( ust::single_element_array_view( value ).to_byte8_range() );
	}
	else static_if( ti.is_array )
	{
		// Just serialize all elements of an array sequentially.
		for( auto mut i= 0s; i < ti.element_count; ++i )
		{
			Serialize( serializer, value[i] );
		}
	}
	else static_if( ti.is_tuple )
	{
		// Just serialize all elements of a tuple sequentially.
		foreach( &el : value )
		{
			Serialize( serializer, el );
		}
	}
	else static_if( ti.is_class )
	{
		static_if( SerializationImpl::IsOptional</T/>::value )
		{
			// Serialize non-empty flag.
			Serialize( serializer, !value.empty() );
			if_var( &stored_value : value )
			{
				// Serialize stored value if has it.
				Serialize( serializer, stored_value );
			}
		}
		else static_if( SerializationImpl::IsVector</T/>::value )
		{
			// Serialize size for vectors. TODO - maybe save it in platform-independent way (not via size_type)?
			Serialize( serializer, value.size() );
			// Serialize all vector elements sequentially.
			foreach( &el : value )
			{
				Serialize( serializer, el );
			}
		}
		else static_if( SerializationImpl::IsVariant</T/>::value )
		{
			// Serialize index of stored type for variants.
			Serialize( serializer, value.index() );
			// Then serialize current stored type.
			variant_visit( &el : value )
			{
				Serialize( serializer, el );
			}
		}
		else static_if( SerializationImpl::ClassHasSerializeMethod</T/>() )
		{
			// A class with "Serialize" method - call it.
			value.Serialize( serializer );
		}
		else
		{
			// For other classes assume we can just serialize separate fields.
			// Use typeinfo order of fields for serialization.
			foreach( &field_info : ti.fields_list )
			{
				Serialize( serializer, mixin( "value." + field_info.name ) );
			}
		}
	}
	else
	{
		static_assert( false, "Unsupported type kind!" );
	}
}

template</type T/>
fn Deserialize( Deserializer &mut deserializer ) : ust::optional</T/>
{
	auto& ti= typeinfo</T/>;
	static_if( ti.is_fundamental )
	{
		static_if( same_type</T, bool/> )
		{
			if_var( b : Deserialize</byte8/>( deserializer ) )
			{
				return b != byte8(0u8);
			}
			return ust::null_optional;
		}
		else
		{
			var Deserializer::BytesView bytes= deserializer.ExtractBytes( ti.size_of );
			if( bytes.size() < ti.size_of )
			{
				return ust::null_optional;
			}

			var T mut result= zero_init;
			ust::single_element_array_view( result ).to_byte8_range().copy_from( bytes );
			return result;
		}
	}
	else static_if( ti.is_enum )
	{
		if_var( underlying_value : Deserialize</ typeof( ti.underlying_type )::src_type />( deserializer ) )
		{
			// Use linear search for find enum value for given underlying value.
			// This is the only way to do so without using "unsafe".
			// Hopefully compiler can optimize this.
			foreach( &element_info : ti.elements_list )
			{
				if( underlying_value == element_info.value )
				{
					return mixin( "T::" + element_info.name );
				}
			}
		}
		return ust::null_optional;
	}
	else static_if( ti.is_array )
	{
		type ElementType= typeof( ti.element_type )::src_type;
		var size_type element_count= ti.element_count;

		// First extract all elements as optionals and store them in an intermediate array.
		var [ ust::optional</ElementType/>, element_count ] mut optionals_array
			[ Deserialize</ElementType/>( deserializer ) ... ];

		// Then check if all optionals are non-empty.
		for( auto mut i= 0s; i < element_count; ++i )
		{
			if( optionals_array[i].empty() )
			{
				return ust::null_optional;
			}
		}

		// Lastly form the target array by taking values from optionals array.
		var size_type mut i= 0s;
		var [ ElementType, element_count ] result
			[ optionals_array[ SerializationImpl::NextIndex(i) ].try_take() ... ];

		return result;
	}
	else static_if( ti.is_tuple )
	{
		mixin( SerializationImpl::CreateMixinTextForTupleDeserialization</T/>() );
	}
	else static_if( ti.is_class )
	{
		static_if( SerializationImpl::IsOptional</T/>::value )
		{
			if_var( has_value : Deserialize</bool/>( deserializer ) )
			{
				if( has_value )
				{
					type ElementType= SerializationImpl::GetOptionalElementType</T/>;
					var ust::optional</ElementType/> mut result= Deserialize</ ElementType />( deserializer );
					if( !result.empty() )
					{
						// Parsed non-empty optional.
						return T( result.try_take() );
					}
					else
					{
						// Failed to parse.
						return ust::null_optional;
					}
				}
				else
				{
					// Parsed empty optional.
					return T();
				}
			}
			else
			{
				// Failed to parse.
				return ust::null_optional;
			}
		}
		else static_if( SerializationImpl::IsVector</T/>::value )
		{
			if_var( size : Deserialize</size_type/>( deserializer ) )
			{
				type ElementType= SerializationImpl::GetVectorElementType</T/>;
				var ust::vector</ElementType/> mut result;

				for( auto mut i= 0s; i < size; ++i )
				{
					var ust::optional</ElementType/> mut element= Deserialize</ElementType/>( deserializer );
					if( element.empty() )
					{
						return ust::null_optional;
					}
					result.push_back( element.try_take() );
				}

				return result;
			}
			else
			{
				return ust::null_optional;
			}
		}
		else static_if( SerializationImpl::IsVariant</T/>::value )
		{
			if_var( index : Deserialize</size_type/>( deserializer ) )
			{
				var size_type mut current_index= 0s;
				for( & element_type_typeinfo : typeinfo</ T::elements_tuple />.elements_list )
				{
					if( current_index == index )
					{
						type ElementType= typeof(element_type_typeinfo.type)::src_type;
						var ust::optional</ElementType/> mut element= Deserialize</ElementType/>( deserializer );
						if( !element.empty() )
						{
							return T( element.try_take() );
						}
						else
						{
							return ust::null_optional;
						}
					}
					++current_index;
				}
			}
			return ust::null_optional;
		}
		else static_if( SerializationImpl::ClassHasSerializeMethod</T/>() )
		{

		}
		else
		{

		}
	}
	else
	{
		// TODO
		static_assert( false, "Unsupported type kind!" );
	}
}

namespace SerializationImpl
{

struct FalseTypeStruct{ var bool value= false; }
struct TrueTypeStruct { var bool value= true ; }

template</type T/> type IsOptional</T/> = FalseTypeStruct;
template</type T/> type IsOptional</ ust::optional</T/> /> = TrueTypeStruct;
template</type T/> type GetOptionalElementType</ ust::optional</T/> />= T;

template</type T/> type IsVector</T/> = FalseTypeStruct;
template</type T/> type IsVector</ ust::vector</T/> /> = TrueTypeStruct;
template</type T/> type GetVectorElementType</ ust::vector</T/> />= T;

template</type T/> type IsVariant</T/> = FalseTypeStruct;
template</type T/> type IsVariant</ ust::variant</T/> /> = TrueTypeStruct;

template</ type T />
fn constexpr ClassHasSerializeMethod() : bool
{
	for( &list_element : typeinfo</T/>.functions_list )
	{
		if( ust::constexpr_string_equals( list_element.name, "Serialize" ) )
		{
			return true;
		}
	}

	return false;
}

fn NextIndex( size_type &mut i ) : size_type
{
	var size_type result= i;
	++i;
	return result;
}

template</type T/>
fn constexpr CreateMixinTextForTupleDeserialization() : [ char8, 1024 ]
{
	var ust::mixin_utils::static_string</1024s/> mut s;

	// First extract all tuple elements into a tuple of optionals.

	s+= " var tup[ ";

	var size_type mut index= 0s;

	foreach( &element_info : typeinfo</T/>.elements_list )
	{
		s+= "ust::optional</ ";
		s+= " typeof( typeinfo</T/>.elements_list[ "; s.append_decimal_number(index); s+= " ].type )::src_type ";
		s+= " />";
		if( index + 1s < typeinfo</T/>.element_count )
		{
			s+= ", ";
		}
		++index;
	}

	s+= " ] mut optionals_tuple[ ";

	index= 0s;
	foreach( &element_info : typeinfo</T/>.elements_list )
	{
		s+= " Deserialize</ ";
		s+= " typeof( typeinfo</T/>.elements_list[ "; s.append_decimal_number(index); s+= " ].type )::src_type ";
		s+= " />( deserializer ), ";
		++index;
	}

	s+= " ];\n";

	// Then check if all these optionals aren't empty.

	s+= "foreach( &el : optionals_tuple ) { if( el.empty() ) { return ust::null_optional; } }\n";

	// Lastly take all elements to form the result.

	s+= " var T result[ ";

	index= 0s;
	foreach( &element_info : typeinfo</T/>.elements_list )
	{
		s+= " optionals_tuple[ "; s.append_decimal_number(index); s+= " ].try_take(), ";
		++index;
	}

	s+= " ];";
	s+= " return result;";

	return s.buffer;
}

} // namespace SerializationImpl

} // namespace PM
