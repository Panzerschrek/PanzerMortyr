import "/sort.u"
import "cluster_hierarchy.uh"

namespace PM
{

fn BuildClusterHierarchy( ust::array_view_imut</ZvoxCluster/> clusters ) : ClusterHierarchy
{
	var ust::vector</u32/> mut cluster_indices;

	for( auto mut i= 0s; i < clusters.size(); ++i )
	{
		if( clusters[i].c.num_children_clusters >= 0 )
		{
			cluster_indices.push_back( u32(i) );
		}
	}

	var ClusterHierarchy mut hierarchy;

	Build_r( hierarchy, clusters, cluster_indices );

	return hierarchy;
}

fn Build_r(
	ClusterHierarchy &mut hierarchy,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_mut</u32/> cluster_indices ) : u32
{
	var BBox3f bbox= GetBBoxForClustersList( clusters, cluster_indices );

	var u32 node_index( hierarchy.nodes.size() );

	if( cluster_indices.size() <= 5s )
	{
		var ClusterHierarchy::LeafNodeContents mut leaf_node_contents
		{
			.first_cluster_index( hierarchy.cluster_indices.size() ),
			.num_cluster_indices( cluster_indices.size() ),
		};

		hierarchy.nodes.push_back( ClusterHierarchy::Node{ .bbox= bbox, .contents= move(leaf_node_contents) } );

		foreach( cluster_index : cluster_indices )
		{
			hierarchy.cluster_indices.push_back( cluster_index );
		}
	}
	else
	{
		var ClusterHierarchy::BranchNodeContents mut branch_node_contents= zero_init; // Set later.

		hierarchy.nodes.push_back( ClusterHierarchy::Node{ .bbox= bbox, .contents= move(branch_node_contents) } );

		auto compare_center_x= lambda[clusters]( u32 index ) : i32 { return clusters[ size_type(index) ].c.center[0]; };
		auto compare_center_y= lambda[clusters]( u32 index ) : i32 { return clusters[ size_type(index) ].c.center[1]; };
		auto compare_center_z= lambda[clusters]( u32 index ) : i32 { return clusters[ size_type(index) ].c.center[2]; };

		var size_type half_clusters= cluster_indices.size() >> 1s;

		var size_type mut smallest_volume_dimension= 0s;
		var f32 mut smallest_volume= ust::plus_inf</f32/>();

		{
			ust::sort_by_key( cluster_indices, compare_center_x );
			var f32 volume=
				CalculateBBoxIntersectionVolume(
					GetBBoxForClustersList( clusters, cluster_indices.subrange_end  ( half_clusters ) ),
					GetBBoxForClustersList( clusters, cluster_indices.subrange_start( half_clusters ) ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 0s;
			}
		}
		{
			ust::sort_by_key( cluster_indices, compare_center_y );
			var f32 volume=
				CalculateBBoxIntersectionVolume(
					GetBBoxForClustersList( clusters, cluster_indices.subrange_end  ( half_clusters ) ),
					GetBBoxForClustersList( clusters, cluster_indices.subrange_start( half_clusters ) ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 1s;
			}
		}
		{
			ust::sort_by_key( cluster_indices, compare_center_z );
			var f32 volume=
				CalculateBBoxIntersectionVolume(
					GetBBoxForClustersList( clusters, cluster_indices.subrange_end  ( half_clusters ) ),
					GetBBoxForClustersList( clusters, cluster_indices.subrange_start( half_clusters ) ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 2s;
			}
		}

		switch( smallest_volume_dimension )
		{
			0s-> { ust::sort_by_key( cluster_indices, compare_center_x ); },
			1s-> { ust::sort_by_key( cluster_indices, compare_center_y ); },
			2s-> { ust::sort_by_key( cluster_indices, compare_center_z ); },
			default -> { halt; }
		}

		var u32 child0= Build_r( hierarchy, clusters, cluster_indices.subrange_end  ( half_clusters ) );
		var u32 child1= Build_r( hierarchy, clusters, cluster_indices.subrange_start( half_clusters ) );

		hierarchy.nodes[ size_type( node_index ) ].contents.try_get</ClusterHierarchy::BranchNodeContents/>().children_nodes= ust::make_array( child0, child1 );
	}

	return node_index;
}

fn GetBBoxForClustersList(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</u32/> cluster_indices ) : BBox3f
{
	var BBox3f mut bbox
	{
		.min( ust::plus_inf </f32/>(), ust::plus_inf </f32/>(), ust::plus_inf </f32/>() ),
		.max( ust::minus_inf</f32/>(), ust::minus_inf</f32/>(), ust::minus_inf</f32/>() ),
	};

	foreach( cluster_index : cluster_indices )
	{
		var ZvoxCluster& cluster= clusters[ size_type( cluster_index ) ];
		ust::min_assign( bbox.min.x, f32( cluster.c.center[0] - cluster.c.bounding_box_half_size[0] ) );
		ust::min_assign( bbox.min.y, f32( cluster.c.center[1] - cluster.c.bounding_box_half_size[1] ) );
		ust::min_assign( bbox.min.z, f32( cluster.c.center[2] - cluster.c.bounding_box_half_size[2] ) );
		ust::max_assign( bbox.max.x, f32( cluster.c.center[0] + cluster.c.bounding_box_half_size[0] ) );
		ust::max_assign( bbox.max.y, f32( cluster.c.center[1] + cluster.c.bounding_box_half_size[1] ) );
		ust::max_assign( bbox.max.z, f32( cluster.c.center[2] + cluster.c.bounding_box_half_size[2] ) );
	}

	return bbox;
}

fn CalculateBBoxIntersectionVolume( BBox3f& b0, BBox3f& b1 ) : f32
{
	var BBox3f intersection
	{
		.min( ust::max( b0.min.x, b1.min.x ), ust::max( b0.min.y, b1.min.y ), ust::max( b0.min.z, b1.min.z ) ),
		.max( ust::min( b0.max.x, b1.max.x ), ust::min( b0.max.y, b1.max.y ), ust::min( b0.max.z, b1.max.z ) ),
	};

	return
		ust::max( 0.0f, intersection.max.x - intersection.min.x ) *
		ust::max( 0.0f, intersection.max.y - intersection.min.y ) *
		ust::max( 0.0f, intersection.max.z - intersection.min.z );
}

} // namespace PM

