import "/sort.u"
import "cluster_hierarchy.uh"

namespace PM
{

fn BuildClusterHierarchy(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads ) : ClusterHierarchy
{
	var ust::vector</ClusterHierarchy::QuadIndex/> mut quad_indices;

	for( auto mut c= 0s; c < clusters.size(); ++c )
	{
		var ZvoxCluster& cluster= clusters[c];

		for( auto mut q= size_type( cluster.c.first_quad_index ); q < size_type( cluster.c.first_quad_index ) + size_type( cluster.num_quads ); ++q )
		{
			quad_indices.push_back( ClusterHierarchy::QuadIndex{ .cluster_index(c), .quad_index(q) } );
		}
	}

	var ClusterHierarchy mut hierarchy;

	Build_r( hierarchy, clusters, quads, quad_indices );

	return hierarchy;
}

fn Build_r(
	ClusterHierarchy &mut hierarchy,
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads,
	ust::array_view_mut</ClusterHierarchy::QuadIndex/> quad_indices ) : u32
{
	var BBox3f bbox= GetBBoxForQuadsList( quads, quad_indices );

	var u32 node_index( hierarchy.nodes.size() );

	if( quad_indices.size() <= 12s )
	{
		var ClusterHierarchy::LeafNodeContents mut leaf_node_contents
		{
			.first_cluster_index( hierarchy.cluster_indices.size() ),
			.num_cluster_indices( quad_indices.size() ),
		};

		hierarchy.nodes.push_back( ClusterHierarchy::Node{ .bbox= bbox, .contents= move(leaf_node_contents) } );

		foreach( cluster_index : quad_indices )
		{
			hierarchy.cluster_indices.push_back( cluster_index );
		}
	}
	else
	{
		var ClusterHierarchy::BranchNodeContents mut branch_node_contents= zero_init; // Set later.

		hierarchy.nodes.push_back( ClusterHierarchy::Node{ .bbox= bbox, .contents= move(branch_node_contents) } );

		auto compare_center_x= lambda[quads]( ClusterHierarchy::QuadIndex& index ) : i16 { return quads[ size_type(index.quad_index) ].center[0]; };
		auto compare_center_y= lambda[quads]( ClusterHierarchy::QuadIndex& index ) : i16 { return quads[ size_type(index.quad_index) ].center[1]; };
		auto compare_center_z= lambda[quads]( ClusterHierarchy::QuadIndex& index ) : i16 { return quads[ size_type(index.quad_index) ].center[2]; };

		var size_type half_clusters= quad_indices.size() >> 1s;

		var size_type mut smallest_volume_dimension= 0s;
		var f32 mut smallest_volume= ust::plus_inf</f32/>();

		{
			ust::sort_by_key( quad_indices, compare_center_x );
			var f32 volume=
				CalculateBBoxIntersectionVolume(
					GetBBoxForQuadsList( quads, quad_indices.subrange_end  ( half_clusters ) ),
					GetBBoxForQuadsList( quads, quad_indices.subrange_start( half_clusters ) ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 0s;
			}
		}
		{
			ust::sort_by_key( quad_indices, compare_center_y );
			var f32 volume=
				CalculateBBoxIntersectionVolume(
					GetBBoxForQuadsList( quads, quad_indices.subrange_end  ( half_clusters ) ),
					GetBBoxForQuadsList( quads, quad_indices.subrange_start( half_clusters ) ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 1s;
			}
		}
		{
			ust::sort_by_key( quad_indices, compare_center_z );
			var f32 volume=
				CalculateBBoxIntersectionVolume(
					GetBBoxForQuadsList( quads, quad_indices.subrange_end  ( half_clusters ) ),
					GetBBoxForQuadsList( quads, quad_indices.subrange_start( half_clusters ) ) );
			if( volume < smallest_volume )
			{
				smallest_volume= volume;
				smallest_volume_dimension= 2s;
			}
		}

		switch( smallest_volume_dimension )
		{
			0s-> { ust::sort_by_key( quad_indices, compare_center_x ); },
			1s-> { ust::sort_by_key( quad_indices, compare_center_y ); },
			2s-> { ust::sort_by_key( quad_indices, compare_center_z ); },
			default -> { halt; }
		}

		var u32 child0= Build_r( hierarchy, clusters, quads, quad_indices.subrange_end  ( half_clusters ) );
		var u32 child1= Build_r( hierarchy, clusters, quads, quad_indices.subrange_start( half_clusters ) );

		hierarchy.nodes[ size_type( node_index ) ].contents.try_get</ClusterHierarchy::BranchNodeContents/>().children_nodes= ust::make_array( child0, child1 );
	}

	return node_index;
}

fn GetBBoxForQuadsList(
	ust::array_view_imut</ZmapQuad/> quads,
	ust::array_view_imut</ClusterHierarchy::QuadIndex/> quad_indices ) : BBox3f
{
	var BBox3f mut bbox
	{
		.min( ust::plus_inf </f32/>(), ust::plus_inf </f32/>(), ust::plus_inf </f32/>() ),
		.max( ust::minus_inf</f32/>(), ust::minus_inf</f32/>(), ust::minus_inf</f32/>() ),
	};

	foreach( quad_index : quad_indices )
	{
		var ZmapQuad& quad= quads[ size_type( quad_index.quad_index ) ];
		ust::min_assign( bbox.min.x, f32( i32( quad.center[0] ) - i32( quad.bounding_box_half_size[0] ) ) );
		ust::min_assign( bbox.min.y, f32( i32( quad.center[1] ) - i32( quad.bounding_box_half_size[1] ) ) );
		ust::min_assign( bbox.min.z, f32( i32( quad.center[2] ) - i32( quad.bounding_box_half_size[2] ) ) );
		ust::max_assign( bbox.max.x, f32( i32( quad.center[0] ) + i32( quad.bounding_box_half_size[0] ) ) );
		ust::max_assign( bbox.max.y, f32( i32( quad.center[1] ) + i32( quad.bounding_box_half_size[1] ) ) );
		ust::max_assign( bbox.max.z, f32( i32( quad.center[2] ) + i32( quad.bounding_box_half_size[2] ) ) );
	}

	return bbox;
}

fn CalculateBBoxIntersectionVolume( BBox3f& b0, BBox3f& b1 ) : f32
{
	var BBox3f intersection
	{
		.min( ust::max( b0.min.x, b1.min.x ), ust::max( b0.min.y, b1.min.y ), ust::max( b0.min.z, b1.min.z ) ),
		.max( ust::min( b0.max.x, b1.max.x ), ust::min( b0.max.y, b1.max.y ), ust::min( b0.max.z, b1.max.z ) ),
	};

	return
		ust::max( 0.0f, intersection.max.x - intersection.min.x ) *
		ust::max( 0.0f, intersection.max.y - intersection.min.y ) *
		ust::max( 0.0f, intersection.max.z - intersection.min.z );
}

} // namespace PM

