import "/assert.u"
import "/stdout.u"
import "console_out.uh"

namespace PM
{

fn ConsoleOut::AddTextLine( mut this, ust::string8 mut line )
{
	// Write the same text into stdout. It may be useful.
	ust::stdout_print( line );
	ust::stdout_print( "\n" );

	lines_[ lines_end_ % c_max_lines_stored ]= move(line);
	++lines_end_;
	if( lines_end_ - lines_start_ > c_max_lines_stored )
	{
		lines_start_= lines_end_ - c_max_lines_stored;
	}
}

fn ConsoleOut::GetNumLines( this ) : size_type
{
	return lines_end_ - lines_start_;
}

fn ConsoleOut::GetLine( this, size_type index ) : ust::string_view8 @( ust::reference_notation::return_inner_references::param0 )
{
	debug_assert( index < GetNumLines() );

	return lines_[ ( lines_end_ - 1s - index ) % c_max_lines_stored ];
}

fn ConsoleOutAddTextLine( ConsoleOutPtr& console_out_ptr, ust::string8 mut line )
{
	with( mut lock : console_out_ptr.lock_mut() )
	{
		lock.deref().AddTextLine( move(line) );
	}
}

} // namespace PM
