import "image_data.iu"

namespace PM
{

class AbstractWindow abstract non_sync
{
	fn virtual pure GetViewportSize( this ) : [ u32, 2 ];

	fn virtual pure SwapWindow( mut this );

	fn virtual pure MakeScreenshot( mut this ) : ImageData;

	fn virtual pure Fill( mut this, RGBAColor& color );
}

} // namespace PM
