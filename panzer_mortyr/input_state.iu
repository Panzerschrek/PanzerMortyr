import "key_binding.iu"

namespace PM
{

struct InputState
{
	KeysState keyboard_state; // Keys which are now down are marked with "true".
	KeysState key_presses; // Keys for which a press event was generated in this frame are marked with "true".
	u32 mouse_buttons_state; // For each mouse button which is down a corresponding bit is set to one.
	[ i32, 2 ] mouse_motion; // Mouse motion in this frame.

	fn KeyIsOn( this, KeyBinding k ) : bool
	{
		if_var( scancode : k.GetAsKeyScancode() )
		{
			if( size_type( scancode ) < typeinfo</ KeysState />.size_of )
			{
				return keyboard_state[ size_type( scancode ) ];
			}
		}
		if_var( b : k.GetAsMouseButton() )
		{
			// This code does the same as SDL_BUTTON macro.
			return ( mouse_buttons_state & ( 1u << ( b - 1u ) ) ) != 0u;
		}
		return false;
	}

	fn KeyWasPressed( this, KeyBinding k ) : bool
	{
		if_var( scancode : k.GetAsKeyScancode() )
		{
			if( size_type( scancode ) < typeinfo</ KeysState />.size_of )
			{
				return key_presses[ size_type( scancode ) ];
			}
		}
		return false;
	}

	fn SetMouseButtonOn( mut this, u32 button_index )
	{
		mouse_buttons_state |= 1u << button_index - 1u;
	}

	// Use array of fixed size representing all scan-codes.
	type KeysState= [ bool, SDL_NUM_SCANCODES ];

	static_assert( typeinfo</ KeysState />.size_of <= 1024s, "It's too big! Consider using something more compact!" );
}

} // namespace PM
