import "key_binding.iu"

namespace PM
{

class InputState
{
public:
	fn constructor()
		(
			keyboard_state_= zero_init,
			keyboard_key_press_events_= zero_init,
			mouse_buttons_state_= zero_init,
			mouse_button_press_events_= zero_init,
			mouse_motion_= zero_init,
		)
	{}

	// Returns true if the given keyboard key or mouse button is pressed.
	fn KeyIsPressed( this, KeyBinding k ) : bool
	{
		if_var( scancode : k.GetAsKeyScancode() )
		{
			if( size_type( scancode ) < typeinfo</ KeysState />.size_of )
			{
				return keyboard_state_[ size_type( scancode ) ];
			}
		}
		if_var( b : k.GetAsMouseButton() )
		{
			// This code does the same as SDL_BUTTON macro.
			return ( mouse_buttons_state_ & ( 1u << ( b - 1u ) ) ) != 0u;
		}
		return false;
	}

	// Returns true if there was a press event for the given keyboard key or mouse button in current frame.
	fn HasKeyPressEvent( this, KeyBinding k ) : bool
	{
		if_var( scancode : k.GetAsKeyScancode() )
		{
			if( size_type( scancode ) < typeinfo</ KeysState />.size_of )
			{
				return keyboard_key_press_events_[ size_type( scancode ) ];
			}
		}
		if_var( b : k.GetAsMouseButton() )
		{
			// This code does the same as SDL_BUTTON macro.
			return ( mouse_button_press_events_ & ( 1u << ( b - 1u ) ) ) != 0u;
		}
		return false;
	}

	// Returns mouse motion in current frame.
	fn GetMouseMotion( this ) : [ i32, 2 ]
	{
		return mouse_motion_;
	}

	// Adds keyboard key press event.
	fn AddKeyboardKeyPressEvent( mut this, SDL_Scancode scancode )
	{
		if( size_type( scancode ) < typeinfo</ InputState::KeysState />.element_count )
		{
			keyboard_key_press_events_[ size_type( scancode ) ]= true;
		}
	}

	fn AddMouseButtonPressEvent( mut this, u32 button_index )
	{
		if( button_index > 0u )
		{
			// Set mouse buttone press event flag.
			mouse_button_press_events_ |= 1u << button_index - 1u;

			// Just in case if we had mouse pressed but current state isn't pressed anymore set also button state flag.
			mouse_buttons_state_ |= 1u << button_index - 1u;
		}
	}

	fn AddMouseMotion( mut this, [ i32, 2 ] motion )
	{
		mouse_motion_[0]+= motion[0];
		mouse_motion_[1]+= motion[1];
	}

	fn Reset( mut this )
	{
		foreach( &mut b : keyboard_state_ )
		{
			b= false;
		}
		foreach( &mut b : keyboard_key_press_events_ )
		{
			b= false;
		}
		mouse_buttons_state_= 0u;
		mouse_button_press_events_= 0u;
		mouse_motion_= ust::make_array( 0, 0 );
	}

	fn UpdateKeyboardAndMouseState( mut this )
	{
		mouse_buttons_state_= ( unsafe( SDL_GetMouseState( ust::nullptr</i32/>(), ust::nullptr</i32/>() ) ) );

		unsafe
		{
			var i32 mut key_count= 0;
			var $(Uint8) keyboard_state_raw= SDL_GetKeyboardState( $<( key_count ) );

			for( auto mut i= 0s; i < ust::min( size_type(key_count), typeinfo</InputState::KeysState/>.element_count ); ++i )
			{
				keyboard_state_[i]= $>( keyboard_state_raw + i ) != Uint8(0);
			}

			for( auto mut i= size_type(key_count); i < typeinfo</InputState::KeysState/>.element_count; ++i )
			{
				keyboard_state_[i]= false;
			}
		}
	}

private:
	// Use array of fixed size representing all scan-codes.
	type KeysState= [ bool, SDL_NUM_SCANCODES ];

	static_assert( typeinfo</ KeysState />.size_of <= 1024s, "It's too big! Consider using something more compact!" );

private:
	KeysState keyboard_state_; // Keys which are now down are marked with "true".
	KeysState keyboard_key_press_events_; // Keys for which a press event was generated in this frame are marked with "true".

	u32 mouse_buttons_state_; // For each mouse button which is down a corresponding bit is set to one.
	u32 mouse_button_press_events_; // For each mouse button for which a press event was generated in this frame a corresponding bit is set to one.

	[ i32, 2 ] mouse_motion_; // Mouse motion in this frame.
}

} // namespace PM
