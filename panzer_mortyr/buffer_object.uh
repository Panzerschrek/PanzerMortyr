import "/random_access_range.u"
import "/sdl/sdl_with_opengl.uh"

namespace PM
{

// RAII wrapper for buffer object.
class BufferObject
{
public:
	fn CreateStaticDrawBuffer( GLenum target, ust::array_view_imut</byte8/> data ) : BufferObject;
	fn CreateDynamicDrawBuffer( GLenum target, ust::array_view_imut</byte8/> data ) : BufferObject;
	fn CreateUninitializedDynamicDrawBuffer( GLenum target, size_type size ) : BufferObject;

	fn constructor( GLuint buffer_object, GLenum target ) unsafe; // Constructor for internal usage.
	fn destructor();

	// This is usually needed to use this buffer as attributes source of an vertex array object.
	// Make sure a buffer isn't deleted whil a vertex array object uses it!
	fn Bind( this );

private:
	GLuint imut buffer_object_;
	GLenum imut target_;
}

} // namespace PM
