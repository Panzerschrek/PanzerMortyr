import "/string_conversions.iu"
import "/utf.iu"
import "/sdl/sdl_with_opengl.iu"
import "video_playback_windows.iu"

namespace PM
{

fn PlayVideo( ConsoleOutPtr& console_out, ust::filesystem_path_view file_path )
{
	var ust::string16 mut file_path_nt= ust::utf::convert_utf8_to_utf16_string( file_path );
	file_path_nt.push_back( '\0'c16 );

	unsafe
	{
		AVIFileInit();

		var PAVIFILE mut avi_file= zero_init;

		if( AVIFileOpenW(
			$<(avi_file),
			$<( cast_ref_unsafe</u16/>( file_path_nt.front() ) ),
			UINT( OF_SHARE_DENY_WRITE ),
			ust::nullptr</CLSID/>() ) != 0 )
		{
			safe( ConsoleOutAddTextLine( console_out, "Failed to open AVI file!" ) );
			AVIFileExit();
			return;
		}

		var PAVISTREAM mut stream= zero_init;

		var size_type stream_index= 0s;

		if( AVIFileGetStream( avi_file, $<(stream), 0u, LONG(stream_index) ) != AVIERR_OK )
		{
			safe( ConsoleOutAddTextLine( console_out, "Failed to get AVI stream!" ) );
			AVIFileRelease( avi_file );
			AVIFileExit();
			return;
		}

		var AVISTREAMINFOW mut stream_info= zero_init;

		AVIStreamInfoW( stream, $<(stream_info), LONG( typeinfo</AVISTREAMINFOW/>.size_of ) );

		safe( ConsoleOutAddTextLine(
			console_out, ust::concat( "Stream type: ", ust::to_string8( stream_info.fccType ) ) ) );

		if( stream_info.fccType != streamtypeVIDEO )
		{
			safe( ConsoleOutAddTextLine( console_out, "Not a video stream!" ) );
			AVIFileRelease( avi_file );
			AVIFileExit();
			return;
		}

		var LONG stream_length= AVIStreamLength( stream );
		safe( ConsoleOutAddTextLine(
			console_out, ust::concat( "Stream length is ", ust::to_string8( stream_length ) ) ) );

		var BITMAPINFOHEADER mut bitmap_header= zero_init;

		var PGETFRAME get_frame= AVIStreamGetFrameOpen( stream, ust::nullptr</BITMAPINFOHEADER/>() );

		if( ust::is_nullptr( get_frame ) )
		{
			safe( ConsoleOutAddTextLine( console_out, "Failed opening stream frames!" ) );
			AVIStreamRelease( stream );
			AVIFileRelease( avi_file );
			AVIFileExit();
			return;
		}

		safe( ConsoleOutAddTextLine( console_out, "Ready for playing an AVI file." ) );

		safe( ConsoleOutAddTextLine(
			console_out,
			ust::concat(
				"size is ",
				ust::to_string8( bitmap_header.biWidth ),
				"x",
				ust::to_string8( bitmap_header.biHeight ) ) ) );

		AVIStreamGetFrameClose( get_frame );

		AVIStreamRelease( stream );

		AVIFileRelease( avi_file );

		AVIFileExit();
	}
}

fn constexpr mmioFOURCC( char8 c0, char8 c1, char8 c2, char8 c3 ) : u32
{
	return u32(c0) | ( u32(c1) << 8 ) | ( u32(c2) << 16 ) | ( u32(c3) << 24 );
}

var u32 streamtypeVIDEO= mmioFOURCC( 'v', 'i', 'd', 's' );

} // namespace PM
