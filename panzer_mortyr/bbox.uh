import "vec.uh"

namespace PM
{

type BBox3f= BBox3</f32/>;

// Axis-aligned bounding box defined by min and max coordinates of its corners.
template</type T/>
struct BBox3
{
	Vec3</T/> min;
	Vec3</T/> max;

	fn PointIsInside( this, Vec3</T/>& p ) : bool
	{
		return
			p.x > min.x && p.x < max.x &&
			p.y > min.y && p.y < max.y &&
			p.z > min.z && p.z < max.z;
	}

	fn PointIsInsideOrOnFace( this, Vec3</T/>& p ) : bool
	{
		return
			p.x >= min.x && p.x <= max.x &&
			p.y >= min.y && p.y <= max.y &&
			p.z >= min.z && p.z <= max.z;
	}
}

} // namespace PM
