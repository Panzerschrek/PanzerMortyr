import "vec.uh"

namespace PM
{

type BBox3f= BBox3</f32/>;

// Axis-aligned bounding box defined by min and max coordinates of its corners.
template</type T/>
struct BBox3
{
	type ThisType= BBox3</T/>;

	Vec3</T/> min;
	Vec3</T/> max;

	fn PointIsInside( this, Vec3</T/>& p ) : bool
	{
		return
			p.x > min.x && p.x < max.x &&
			p.y > min.y && p.y < max.y &&
			p.z > min.z && p.z < max.z;
	}

	fn PointIsInsideOrOnFace( this, Vec3</T/>& p ) : bool
	{
		return
			p.x >= min.x && p.x <= max.x &&
			p.y >= min.y && p.y <= max.y &&
			p.z >= min.z && p.z <= max.z;
	}

	fn Instersects( this, ThisType& other ) : bool
	{
		return !(
			this.max.x <= other.min.x | this.min.x >= other.max.x |
			this.max.y <= other.min.y | this.min.y >= other.max.y |
			this.max.z <= other.min.z | this.min.z >= other.max.z );
	}

	fn InstersectsOrTouches( this, ThisType& other ) : bool
	{
		return !(
			this.max.x < other.min.x | this.min.x > other.max.x |
			this.max.y < other.min.y | this.min.y > other.max.y |
			this.max.z < other.min.z | this.min.z > other.max.z );
	}

	fn CreateCornerVertices( this ) : [ Vec3</T/>, 8 ]
	{
		var [ Vec3</T/>, 8 ] corner_vertices
		[
			( min.x, min.y, min.z ),
			( max.x, min.y, min.z ),
			( min.x, max.y, min.z ),
			( max.x, max.y, min.z ),
			( min.x, min.y, max.z ),
			( max.x, min.y, max.z ),
			( min.x, max.y, max.z ),
			( max.x, max.y, max.z ),
		];

		return corner_vertices;
	}

	fn GetCenter( this ) : Vec3</T/>
	{
		return ( min + max ) * T( 0.5 );
	}

	fn GetDimensions( this ) : Vec3</T/>
	{
		return max - min;
	}
}

} // namespace PM
