namespace PM
{

fn CreateNewMapGameState(
	GameMapData& map_data, u32 skill, ust::optional_ref_imut</PlayerState/> prev_player_state ) : GameState;

// Returns next map index if requires map transition or 0 if requires no one.
fn nodiscard ProcessGameLogicStep(
	GameGlobalData& global_data, GameMapData& map_data, PlayerInput& player_input, GameState &mut game_state ) : u32;

fn GetPlayerColliderBBox( EntitiesDescription& entities_description, f32 crouching_phase ) : BBox3f;

// The original game uses angles in range 0 to 1024 mapped to 0 to tau and with negative sign.
fn Convert1024Angle( f32 a ) : f32;

fn GetCrosshairPositionAndKind(
	GameMapData& map_data,
	GameState& game_state,
	f32 camera_azimuth,
	f32 camera_elevation ) : tup[ Vec3f, CrosshairDrawingInfo::HitPointKind ];

var [ EntitiesDescription::ToolType, 18 ] c_inventory_accessible_tools
[
	EntitiesDescription::ToolType::WeaponA,
	EntitiesDescription::ToolType::WeaponB,
