import "/file.u"
import "/hash_map.u"
import "/string.u"

namespace PM
{

class GameFilesystem
{
public:
	// Halts if fails to open game archive file.
	fn constructor();

	fn LoadFileToString( mut this, ust::string8 file_name ) : ust::io_result</ust::string8/>;

	// Load file with given name.
	// Passed function object should accept "file_readable &mut" instance, which may point to the archive file or a separate filesystem file.
	// This function should not perform file seeking, since it may be wrong for a file being an archive part.
	template</type LoadingFunc/>
	fn LoadFile( mut this, ust::string8 file_name, LoadingFunc mut loading_func ) : auto
	{
		type ResultT= typeof( move(loading_func)( archive_file_ ) );

		var FileEntry& entry= archive_entries_[ file_name ];

		if_var( e : archive_file_.seek( u64(entry.offset) ).as_error_ref() )
		{
			return ResultT(e);
		}

		return move(loading_func)( archive_file_ );
	}

private:
	struct FileEntry
	{
		u32 offset;
		u32 size;
	}

private:
	ust::file_readable archive_file_;
	ust::hash_map</ust::string8, FileEntry/> archive_entries_;
}

} // namespace PM
