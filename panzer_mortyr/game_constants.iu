import "math_constants.iu"

namespace PM
{

// Game logic is updated in fixed steps.
// Estimations based on usage duration of items and sound durations have shown,
// that the original game runs game logic updates with frequency around 30Hz (±3Hz).
var f32 c_steps_per_second= 30.0f;

// Model animation frames are sparce - for each 2 logic steps there is only one frame.
var u32 c_num_steps_per_animation_frame= 2u;

var u32 c_player_entity_kind= 0u;

var u32 c_start_operation= 0u; // Start with operation 0.

// In places where entity index should be stored use this value to indicate not entity but player.
var u32 c_player_entity_index= 0xA0000000u;

// Speed values for entities are somewhat scaled. Scale them down.
// This value is experementally-found.
// TODO - check if it's really correct.
var f32 c_entity_speed_scale= 1.0f / 4.0f;

// Experimental value.
// TODO - fiund how it's exactly specified. Maybe it depends on current speed?
var f32 c_entity_turn_speed= c_tau / 30.0f;
var f32 c_sky_decoration_entity_turn_speed= c_tau / 360.0f;

// This value was experimentally-found.
var f32 c_camera_z_offset= -53.0f;

// Experiments with the original game have shown that maximum jump height is 64 units.
// Jump speed and gravity are tuned so that it's barely possible to jump to this height (but not much higher).
// Gravity is tuned so that jump duration is close to the original.
var f32 constexpr c_gravity_per_step= 2.0f;
var f32 constexpr c_jump_vertical_velocity_add= -17.5f;
// Water jump vertical velocity is tuned so that it's possible to jump onto a ledge with height 16 units, but not 32.
var f32 constexpr c_water_jump_vertical_velocity= -16.8f;
var f32 constexpr c_min_jump_velocity_for_fall_sound= -19.0f;

// It's tuned so that it's possible for the plyer to get fall damage above 100 (to be killed).
var f32 constexpr c_max_vertical_speed= 54.0f;

// Original game has steps with height 16. Add one extra unit to make sure we can climb all stairs.
var f32 constexpr c_maximum_step_height_for_climbing= 17.0f;

// How much player's hight is changed while he crouches.
// This value was tuned so that it's possible to pass into the shuttle hatch on map 29 and into the severs hatch on map 9.
var f32 constexpr c_crouching_height_delta= 32.5f;

// Speed for transition from standing state to fully crouching state.
var f32 constexpr c_crouching_transition_speed= 4.0f / c_steps_per_second;

// How long it takes to switch a weapon.
var u32 c_weapon_switching_half_time_steps= u32( c_steps_per_second / 2.5f );

var u32 c_weapon_idle_animation_delay_after_weapon_switching= c_weapon_switching_half_time_steps * 4u / 3u;

var f32 c_weapon_lowering_on_death_speed= 3.0f / c_steps_per_second;

// A projectile dies in this time if it didn't collide with something.
// The original game uses roughly 2 seconds delay, use a little bit more, so that slow projectiles don't disappear before they hit something.
// This value shouldn't be too high, in order for bouncing projectiles to die eventually.
// But it shouldn't be too low, so that projectiles disappear shortly after they are fired.
var u32 c_max_projectile_age( c_steps_per_second * 3.0f );

// Grenades seems to live shorter compared to other projectiles.
// Measurements of the original game have shown, that this delay is roughly 2 seconds.
var u32 c_grenade_explosion_delay( c_steps_per_second * 2.0f );

// Projectiles use gravity value different to one used for entities and the player.
// And different projectile kinds have different gravity values.
var f32 c_heavy_projectiles_gravity= c_light_projectiles_gravity * 3.0f;
var f32 c_light_projectiles_gravity= 0.46f;

// These constants were tuned to roughly match behavior observable in the original game.
var f32 c_projectile_hit_enemy_alarm_max_distance= 512.0f;
var f32 c_player_shot_enemy_alarm_max_distance= 512.0f;
// For shots fired by enemies use smaller alarm max distance, to avoid chain reactions alarming all enemies on a map.
var f32 c_enemy_shot_enemy_alarm_max_distance= 256.0f;
var f32 c_enemy_alarm_other_enemy_alarm_max_distance= 512.0f;
// Alarm distance for animals (birds, rats).
// Use smaller distance compared to other alarm distances, since trigger volumes for animals are pretty large.
var f32 c_animal_alarm_distance= 256.0f;

// Weapon accuracy is given in some unknown units. So, assume it's some sort of angle.
// Scale it down using this factor. It was tweaked to roughly match weapon spread of the original game.
var f32 c_weapon_angles_scale= 1.0f / 8192.0f;
// Appyly some extra scale to accuracy of enemy weapons in order to match their accuracy in the original game.
var f32 c_enemy_weapon_angles_extra_scale= 1.5f;

// Buttons/doors/elevators are activated with this delay.
// It's necessary to be able to board a button-operated elevator after pushing its button which is located nearby.
var u32 c_dynamic_cluster_activation_delay_steps= 15u;

// An investigation of the original game has shown,
// that environmental damage (acid) is applied roughly once in a second and is 15 units of energy.
var u32 c_environmental_damage_period_steps= u32( c_steps_per_second );
var u32 c_environmental_damage= 15u;

// Burning duration was measured in the original game.
var u32 c_damaging_flame_max_age( c_steps_per_second * 12.0f );

var u32 c_breaking_glass_max_age( c_steps_per_second * 4.0f );
var u32 c_projectile_hit_smoke_emitter_max_age( c_steps_per_second * 0.3f );
var u32 c_projectile_hit_smoke_particle_max_age( c_steps_per_second * 0.75f );
var u32 c_muzzle_flash_max_age= 3u;
var u32 c_spark_particle_max_age( c_steps_per_second * 0.6f );
var u32 c_explosion_particle_max_age( c_steps_per_second * 2.0f );
var u32 c_flame_particle_max_age( c_steps_per_second * 8.0f );
var u32 c_smoke_particle_max_age( c_steps_per_second * 2.5f );
var u32 c_smoke_trail_particle_max_age( c_steps_per_second * 1.0625f );
var u32 c_bubble_max_age( c_steps_per_second * 2.0f );
var u32 c_blood_particle_max_age( c_steps_per_second * 4.0f );
var u32 c_muzzle_light_max_age( c_steps_per_second / 5.0f );
var u32 c_projectile_hit_light_max_age( c_steps_per_second * 1.0f );
var u32 c_bird_max_age( c_steps_per_second * 2.5f );
var u32 c_rat_max_age( c_steps_per_second * 5.0f );

// Billboards with animation change their frame proportional to current game logic step divided by this value.
var u32 c_animated_billboards_frequency_divisor= 2u;

namespace EntityNavigationConstants
{

// For searching for a target nearby it's necessary to visit only a handful of nearby nodes.
var size_type max_nodes_to_visit_for_nearby_target_search= 48s;

// How many nodes can be visited while searching for a node far enough from the player.
var size_type max_nodes_to_visit_for_panic_mode_search= 768s;

// For route search to the player limit the number of nodes visited.
// It's necessary in order to avoid wasting time visiting a lot of nodes if no route can be found anyway.
// This constant was tuned so that it's possible to find a route in most practical cases where such route can exist.
var size_type max_nodes_to_visit_for_direct_route_search= 1024s;

// For patrolling points search use pretty small limit for the number of nodes to visit.
// Patrolling points are placed close to each other anyway.
var size_type max_nodes_to_visit_for_patrolling_target_search= 512s;

// Limit the number of nodes visited in a single game logic step.
// It's necessary to avoid spending too much time updating game state and thus creating a performance spike or even a frame drop.
// If this limit is reached - don't start a new search.
// It's not a huge problem to avoid starting a search, a route can be usually found in the next step.
// It's not a mistake that this value is smaller than the number of total nodes visited for single route search,
// since this constant only limits starting a new search attempt.
var size_type max_nodes_to_visit_in_single_game_logic_step= 512s;

// Use a cooldown to avoid searching for a route too often, since it's costly to perform a search.
var u32 min_steps_between_route_searches( c_steps_per_second );
// Use smaller cooldown for patrolling point route searches,
// since patrolling points are often placed very close to each other and
// thus travelling between them doesn't require much time.
var u32 min_steps_between_patrolling_route_searches( c_steps_per_second * 0.5f );

} // namespace EntityNavigationConstants

} // namespace PM
