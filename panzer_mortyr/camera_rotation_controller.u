import "/math.u"
import "/sdl/sdl_with_opengl.uh"
import "camera_rotation_controller.uh"
import "math_constants.uh"

namespace PM
{

fn CameraRotationController::constructor( f32 azimuth )
	( azimuth_= azimuth, elevation_= 0.0f, azimuth_velocity_( 0.0f ), elevation_velocity_( 0.0f ) )
{
}

fn CameraRotationController::Update(
	mut this,
	f32 time_delta_s,
	ust::array_view_imut</bool/> keyboard_state,
	u32 mouse_state,
	[ i32, 2 ] mouse_motion )
{
	// TODO - allow changig controls.
	var size_type
		key_turn_left(SDL_SCANCODE_LEFT),
		key_turn_right(SDL_SCANCODE_RIGHT),
		key_turn_up(SDL_SCANCODE_UP),
		key_turn_down(SDL_SCANCODE_DOWN);

	var u32 button_shot= 1u;

	// Perform angular movement via keyboard keys with acceleration. It looks a little bit better.

	var f32 constexpr angle_acceleration= 30.0f;
	var f32 constexpr angle_deceleration= 20.0f;

	var f32 constexpr max_angle_speed= c_tau * 3.0f / 4.0f;
	var f32 constexpr max_elevation= c_tau / 4.0f;

	// TODO - read it from settings.
	// TODO - allow Y axis inversion.
	var f32 constexpr mouse_sensitivity_x= 0.005f;
	var f32 constexpr mouse_sensitivity_y= 0.005f;

	if( key_turn_left < keyboard_state.size() && keyboard_state[ key_turn_left ] )
	{
		azimuth_velocity_ += angle_acceleration * time_delta_s;
	}
	if( key_turn_right < keyboard_state.size() && keyboard_state[ key_turn_right ] )
	{
		azimuth_velocity_ -= angle_acceleration * time_delta_s;
	}
	if( key_turn_up < keyboard_state.size() && keyboard_state[ key_turn_up ] )
	{
		elevation_velocity_ -= angle_acceleration * time_delta_s;
	}
	if( key_turn_down < keyboard_state.size() && keyboard_state[ key_turn_down ] )
	{
		elevation_velocity_ += angle_acceleration * time_delta_s;
	}

	{
		var f32 speed= ust::abs( azimuth_velocity_ );
		if( speed > 0.0f )
		{
			var f32 speed_decelerated= speed - angle_deceleration * time_delta_s;
			var f32 speed_decelerated_clamped= ust::max( 0.0f, ust::min( speed_decelerated, max_angle_speed ) );
			azimuth_velocity_*= speed_decelerated_clamped / speed;
		}
	}
	{
		var f32 speed= ust::abs( elevation_velocity_ );
		if( speed > 0.0f )
		{
			var f32 speed_decelerated= speed - angle_deceleration * time_delta_s;
			var f32 speed_decelerated_clamped= ust::max( 0.0f, ust::min( speed_decelerated, max_angle_speed ) );
			elevation_velocity_*= speed_decelerated_clamped / speed;
		}
	}

	azimuth_+= azimuth_velocity_ * time_delta_s;
	elevation_+= elevation_velocity_ * time_delta_s;

	azimuth_-= f32( mouse_motion[0] ) * mouse_sensitivity_x;
	elevation_+= f32( mouse_motion[1] ) * mouse_sensitivity_y;

	while(azimuth_ >  c_half_tau)
	{
		azimuth_-= c_tau;
	}
	while(azimuth_ < -c_half_tau)
	{
		azimuth_+= c_tau;
	}

	if( elevation_ > max_elevation )
	{
		elevation_= max_elevation;
	}
	if( elevation_ < -max_elevation )
	{
		elevation_= -max_elevation;
	}

	if( ( mouse_state & ( 1u << button_shot ) ) != 0u )
	{
		// Memorize angles of the camera at the moment when shot button was pressed.
		// It's necessary to shoot exactly in the direction where camera is pointed.
		shot_request_= PlayerShotRequest{ .azimuth= azimuth_, .elevation= elevation_ };
	}
}

fn CameraRotationController::GetAzimuth( this ) : f32
{
	return azimuth_;
}

fn CameraRotationController::GetElevation( this ) : f32
{
	return elevation_;
}

fn CameraRotationController::GetShotRequest( this ) : ust::optional</PlayerShotRequest/>
{
	return shot_request_;
}

fn CameraRotationController::Reset( mut this )
{
	shot_request_.reset();
}

} // namespace PM
