import "loading_screen.iu"

namespace PM
{

fn DrawLoadingScreen( ust::shared_ptr_mut</AbstractWindow/>& window, AbstractImageDrawer &mut image_drawer )
{
	with( mut lock : window.lock_mut() )
	{
		lock.deref().Fill( ust::make_array( 0u8, 0u8, 0u8, 0u8 ) );
	}

	image_drawer.PreloadImage( c_loading_image_file_name, ust::null_optional_ref ); // Preload it if didn't do it yet.

	if_var( &image_size : image_drawer.GetImageSize( c_loading_image_file_name ) )
	{
		var [ u32, 2 ] viewport_size= window.lock_imut().deref().GetViewportSize();
		var f32 scale=
			ust::max(
				1.0f,
				ust::min(
					f32( viewport_size[0] ) / f32( image_size[0] ),
					f32( viewport_size[1] ) / f32( image_size[1] ) ) * 0.5f );

		var f32 x= f32( viewport_size[0] ) * 0.5f - f32( image_size[0] ) * 0.5f * scale;
		var f32 y= f32( viewport_size[1] ) * 0.5f - f32( image_size[1] ) * 0.5f * scale;

		image_drawer.DrawImage( c_loading_image_file_name, i32(x), i32(y), scale );
	}

	with( mut lock : window.lock_mut() )
	{
		lock.deref().SwapWindow();
	}
}

var ResourceString& c_loading_image_file_name= "MENU_W.BMP\0\0";

} // namespace PM
