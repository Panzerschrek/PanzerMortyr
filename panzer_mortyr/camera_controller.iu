import "keyboard_state.iu"
import "settings.iu"

namespace PM
{

class CameraController
{
public:
	fn constructor( SettingsImutPtr settings, f32 azimuth );

	fn Update( mut this, f32 time_delta_s, KeyboardState& keyboard_state, u32 mouse_state, [ i32, 2 ] mouse_motion );

	fn GetAzimuth( this ) : f32;
	fn GetElevation( this ) : f32;

	fn GetFOV( this ) : f32;

private:
	SettingsImutPtr imut settings_;

	f32 azimuth_;
	f32 elevation_;
	f32 azimuth_velocity_;
	f32 elevation_velocity_;
	f32 zoom_fraction_;
}

} // namespace PM
