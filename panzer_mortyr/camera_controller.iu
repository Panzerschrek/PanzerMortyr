import "input_state.iu"
import "settings.iu"

namespace PM
{

class CameraController
{
public:
	struct State
	{
		f32 azimuth;
		f32 elevation= 0.0f;
		f32 azimuth_velocity= 0.0f;
		f32 elevation_velocity= 0.0f;
		f32 zoom_fraction= 0.0f;
	}

public:
	fn constructor( SettingsImutPtr settings, State& state );

	fn Update( mut this, f32 time_delta_s, InputState& input_state );

	fn GetAzimuth( this ) : f32;
	fn GetElevation( this ) : f32;

	fn GetFOV( this ) : f32;

	fn GetState( this ) : State&;

private:
	SettingsImutPtr imut settings_;
	State state_;
}

} // namespace PM
