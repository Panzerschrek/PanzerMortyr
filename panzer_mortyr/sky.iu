import "/common_lib/billboards_description_file.iu"
import "/common_lib/maps_description_file.iu"
import "buffer_object.iu"
import "vertex_array_object.iu"

namespace PM
{

struct SkyBackgroundBuffer
{
	VertexArrayObject vertex_array_object;
	BufferObject vertex_buffer;
	BufferObject index_buffer;
	size_type num_triangle_indices;
}

fn CreateSkyBackgroundBuffer( MapsDescription::MapDescription& map_description ) : SkyBackgroundBuffer;

struct SkyCloudsParams
{
	f32 scale;
	f32 scroll_speed;
	bool scale_colors_by_two;
}

// Returns empty optional if clouds are disabled for the map specified.
fn CreateSkyCloudsParams( MapsDescription::MapDescription& map_description ) : ust::optional</SkyCloudsParams/>;

struct StarsBuffer
{
	VertexArrayObject vertex_array_object;
	BufferObject vertex_buffer;
	BufferObject index_buffer;
	size_type num_triangle_indices;
}

fn CreateStarsBuffer(
	MapsDescription::MapDescription& map_description,
	ust::array_view_imut</BillboardDescription/> billboards_description ) : StarsBuffer;

} // namespace PM
