import "game_filesystem.iu"
import "image_loading.iu"
import "settings.iu"
import "shader_program.iu"
import "texture.iu"
import "vertex_array_object.iu"

namespace PM
{

class ImageDrawer
{
public:
	fn constructor( [ u32, 2 ] viewport_size, GameFilesystemPtr game_filesystem_ptr, SettingsPtr settings );

	// Use separate method for image preloading
	// in order to allow preloading all images at loading stage and avoid slow-downs later due to slow disk access.
	fn PreloadImage(
		mut this, ResourceString& image_file_name, ust::optional_ref_imut</ [ u8, 3 ] /> transparent_color );

	// Works only for preloaded images.
	fn GetImageSize( this, ResourceString& image_file_name ) : ust::optional</ [ u32, 2 ] />;

	// Draw the whole image at given position with given size. The image should be preloaded first.
	fn DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale );
	fn DrawImage( mut this, ResourceString& image_file_name, i32 x, i32 y, f32 scale, u8 alpha );

	// Draw a part of an image at given position with given size. The image should be preloaded first.
	fn DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y );

	fn DrawImage(
		mut this,
		ResourceString& image_file_name,
		i32 x, i32 y,
		f32 scale,
		u32 tc_offset_x, u32 tc_offset_y,
		u32 tc_size_x, u32 tc_size_y,
		u8 alpha );

	// This function uploads given image to GPU each time. Avoid using it too often for large images.
	fn UploadAndDrawImage( mut this, ImageData& image_data, i32 x, i32 y, f32 scale );

private:
	struct TextureExt
	{
		Texture texture;
		[ u32, 2 ] size;
	}

private:
	GameFilesystemPtr imut game_filesystem_ptr_;
	SettingsPtr imut settings_;
	[ u32, 2 ] imut viewport_size_;

	VertexArrayObject vertex_array_object_; // Just a dummy to avoid OpenGL warnings.
	ShaderProgram shader_;

	ust::hash_map</ ResourceString, ust::optional</TextureExt/> /> textures_;

	Texture temp_texture_;
}

} // namespace PM
