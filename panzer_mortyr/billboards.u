import "/common_lib/materials_file.iu"
import "billboards.iu"
import "cluster_utils.iu"

namespace PM
{

fn nodiscard BuildBillboardPolygons(
	ust::array_view_imut</WorldDrawingInfo::Billboard/> billboards,
	ust::array_view_imut</BillboardDescription/> billboards_description,
	Vec3f& camera_position,
	f32 fov_x,
	CameraClipPlanes& camera_clip_planes,
	BBox3f& visible_clusters_bbox,
	ust::vector</MapVertex/> &mut vertices,
	ust::vector</u16/> &mut indices ) : u32
{
	var u32 mut num_visible_billboards= 0u;

	// This scale was tuned so that fixed-size billboards look properly.
	var f32 scale_for_constant_screen_size_billboards= ust::tan( fov_x * 0.5f ) / 512.0f;

	foreach( &billboard : billboards ) label billboards_loop
	{
		var size_type billboard_index( billboard.billboard_index );
		if( billboard_index >= billboards_description.size() )
		{
			continue;
		}

		var BillboardDescription& billboard_description= billboards_description[ billboard_index ];

		var f32 mut radius=
			billboard.scale *
				ust::sqrt(
					f32(
						billboard_description.dx * billboard_description.dx +
						billboard_description.dy * billboard_description.dy ) );

		if( billboard.alignment == WorldDrawingInfo::Billboard::Alignment::ToCameraWithConstantScreenSize )
		{
			radius*=
				( billboard.position - camera_position ).Length() * scale_for_constant_screen_size_billboards;
		}

		// Perform clipping by camera planes (reject billboards outside view).
		foreach( &clip_plane : camera_clip_planes )
		{
			var f32 distance= clip_plane.GetDistanceForPoint( billboard.position );
			if( distance > radius )
			{
				continue label billboards_loop;
			}
		}

		var BBox3f billboard_bbox
		{
			.min= billboard.position - Vec3f( radius, radius, radius ),
			.max= billboard.position + Vec3f( radius, radius, radius ),
		};

		// Perform check with visible clusters bbox in order to reject billboards located in another rooms.
		// Such rough check is mostly fine.
		// Performing more compicated check against all visible room clusters is too expensice for billboards.
		if( !visible_clusters_bbox.Instersects( billboard_bbox ) )
		{
			continue;
		}

		var f32 texture_layer= GetBillboardTextureLayer( billboard_description );
		var u32 mut extra_tc_scale_log2= 0u;

		if( billboard_description.tek >= BillboardConstants::c_texture2_first_tile &&
			billboard_description.tek <= BillboardConstants::c_texture2_last_tile )
		{
			extra_tc_scale_log2= 2u;
		}

		var size_type base_vertex= vertices.size();

		auto [ mut u_vec, mut v_vec ]=
			GetBillboardAxes( billboard, camera_position, scale_for_constant_screen_size_billboards );

		u_vec*= f32( billboard_description.dx );
		v_vec*= f32( billboard_description.dy );

		var [ Vec3f, 4 ] positions
		[
			billboard.position - u_vec - v_vec,
			billboard.position + u_vec - v_vec,
			billboard.position - u_vec + v_vec,
			billboard.position + u_vec + v_vec,
		];

		var [ u32, 2 ] tc_base
		[
			billboard_description.xp % MaterialsDescription::c_texture_size,
			billboard_description.yp % MaterialsDescription::c_texture_size
		];

		var [ [ f32, 2 ], 2 ] tex_coords
		[
			[
				f32( tc_base[0] ) / f32( MaterialsDescription::c_texture_size ),
				f32( tc_base[1] ) / f32( MaterialsDescription::c_texture_size ),
			],
			[
				f32( tc_base[0] + ( ( billboard_description.xk - billboard_description.xp ) >> extra_tc_scale_log2 ) ) / f32( MaterialsDescription::c_texture_size ),
				f32( tc_base[1] + ( ( billboard_description.yk - billboard_description.yp ) >> extra_tc_scale_log2 ) ) / f32( MaterialsDescription::c_texture_size ),
			],
		];

		var u8 brightness( ust::max( 0.0f, ust::min( billboard.brightness * 255.0f, 255.0f ) ) );
		var [ u8, 4 ] light[ brightness ... ];

		vertices.push_back(
			MapVertex
			{
				.position[ positions[0].x, positions[0].y, positions[0].z ],
				.light= light,
				.tex_coordinates[ tex_coords[0][0], tex_coords[0][1], texture_layer ],
				.fog_params= zero_init,
			} );

		vertices.push_back(
			MapVertex
			{
				.position[ positions[1].x, positions[1].y, positions[1].z ],
				.light= light,
				.tex_coordinates[ tex_coords[1][0], tex_coords[0][1], texture_layer ],
				.fog_params= zero_init,
			} );

		vertices.push_back(
			MapVertex
			{
				.position[ positions[2].x, positions[2].y, positions[2].z ],
				.light= light,
				.tex_coordinates[ tex_coords[0][0], tex_coords[1][1], texture_layer ],
				.fog_params= zero_init,
			} );

		vertices.push_back(
			MapVertex
			{
				.position[ positions[3].x, positions[3].y, positions[3].z ],
				.light= light,
				.tex_coordinates[ tex_coords[1][0], tex_coords[1][1], texture_layer ],
				.fog_params= zero_init,
			} );

		indices.push_back( u16( base_vertex + 2s ) );
		indices.push_back( u16( base_vertex + 1s ) );
		indices.push_back( u16( base_vertex + 0s ) );
		indices.push_back( u16( base_vertex + 1s ) );
		indices.push_back( u16( base_vertex + 2s ) );
		indices.push_back( u16( base_vertex + 3s ) );

		++num_visible_billboards;
	}

	return num_visible_billboards;
}

fn GetBillboardTextureLayer( BillboardDescription& billboard_description ) : f32
{
	var u32 constexpr num_tiles_in_texture=
		MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y;

	if( billboard_description.tek >= BillboardConstants::c_texture2_first_tile &&
			billboard_description.tek <= BillboardConstants::c_texture2_last_tile )
	{
		var u32 base_texture_index= 37u * num_tiles_in_texture;
		if( billboard_description.tek < BillboardConstants::c_texture2_first_tile + 4u )
		{
			// Upper 4 subtiles.
			return f32( base_texture_index + billboard_description.tek - BillboardConstants::c_texture2_first_tile );
		}
		else if( billboard_description.tek >= BillboardConstants::c_texture2_first_tile + 12u )
		{
			// Lower 4 subtiles.
			return f32( base_texture_index + 4u + billboard_description.tek - BillboardConstants::c_texture2_first_tile - 12u );
		}

		return 0.0f;
	}
	else
	{
		var u32 mut base_texture_index= 0u;
		switch( billboard_description.tek )
		{
			BillboardConstants::c_texture0 -> { base_texture_index= 30u; },
			BillboardConstants::c_texture1 -> { base_texture_index= 31u; },
			// Alpha-tested version of ZBRA001*.BMP - textures.
			BillboardConstants::c_texture1_alpha_test -> { base_texture_index= 35u; },
			// Black version of ZBRA001*.BMP - textures.
			BillboardConstants::c_texture1_black -> { base_texture_index= 36u; },
			BillboardConstants::c_texture4 -> { base_texture_index= 34u; },
			default -> {},
		}

		return
			f32(
				base_texture_index * num_tiles_in_texture +
				billboard_description.xp / MaterialsDescription::c_texture_size +
				billboard_description.yp / MaterialsDescription::c_texture_size * MaterialsDescription::c_texture_file_num_tiles_x );
	}
}

fn GetBillboardAxes(
	WorldDrawingInfo::Billboard& billboard,
	Vec3f& camera_position,
	f32 scale_for_constant_screen_size_billboards ) : [ Vec3f, 2 ]
{
	var Vec3f vec_to_camera= billboard.position - camera_position;

	type Alignment= WorldDrawingInfo::Billboard::Alignment;

	switch( billboard.alignment )
	{
		Alignment::ZAxis ->
		{
			var Vec3f mut v_vec( 0.0f, 0.0f, 1.0f );
			var Vec3f mut u_vec= vec_to_camera.Cross( v_vec );

			var f32 u_vec_length= u_vec.Length();
			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			return ust::make_array( billboard.scale * u_vec, billboard.scale * v_vec );
		},
		Alignment::ToCamera ->
		{
			var Vec3f mut u_vec= vec_to_camera.Cross( Vec3f( 0.0f, 0.0f, 1.0f ) );
			var f32 u_vec_length= u_vec.Length();

			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			var Vec3f mut v_vec= u_vec.Cross( vec_to_camera );
			var f32 v_vec_length= v_vec.Length();

			if( v_vec_length == 0.0f )
			{
				v_vec= Vec3f( 1.0f, 0.0f, 0.0f );
			}
			else
			{
				v_vec /= v_vec_length;
			}

			return ust::make_array( billboard.scale * u_vec, billboard.scale * v_vec );
		},
		Alignment::ToCameraWithConstantScreenSize ->
		{
			var Vec3f mut u_vec= vec_to_camera.Cross( Vec3f( 0.0f, 0.0f, 1.0f ) );
			var f32 u_vec_length= u_vec.Length();

			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			var Vec3f mut v_vec= u_vec.Cross( vec_to_camera );
			var f32 v_vec_length= v_vec.Length();

			if( v_vec_length == 0.0f )
			{
				v_vec= Vec3f( 1.0f, 0.0f, 0.0f );
			}
			else
			{
				v_vec /= v_vec_length;
			}

			var f32 scale= billboard.scale * vec_to_camera.Length() * scale_for_constant_screen_size_billboards;

			return ust::make_array( u_vec * scale, v_vec * scale );
		},
		Alignment::ToCustomAxis ->
		{
			var Vec3f mut v_vec= billboard.custom_axis;
			var f32 v_vec_length= v_vec.Length();

			if( v_vec_length == 0.0f )
			{
				v_vec= Vec3f( 1.0f, 0.0f, 0.0f );
			}
			else
			{
				v_vec /= v_vec_length;
			}

			var Vec3f mut u_vec= vec_to_camera.Cross( v_vec );
			var f32 u_vec_length= u_vec.Length();

			if( u_vec_length == 0.0f )
			{
				u_vec= Vec3f( 0.0f, 1.0f, 0.0f );
			}
			else
			{
				u_vec /= u_vec_length;
			}

			return ust::make_array( billboard.scale * u_vec, billboard.scale * v_vec );
		},
	}
}

} // namespace PM
