import "drawing_gl/drawers_factory_gl.iu"
import "drawing_soft/drawers_factory_soft.iu"

namespace PM
{

fn CreateDrawers(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : AbstractDrawers
{
	switch( settings.lock_imut().deref().r_mode )
	{
		Settings::RenderingMode::OpenGL ->
		{
			return CreateDrawersGL( settings, caching_game_resources_loader, console_out );
		},
		Settings::RenderingMode::Software ->
		{
			return CreateDrawersSoft( settings, caching_game_resources_loader, console_out );
		},
	}
}

} // namespace PM
