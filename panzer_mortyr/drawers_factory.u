import "drawers_factory_gl_and_soft.iu"
import "drawing_gl/drawers_factory_gl.iu"
import "drawing_soft/drawers_factory_soft.iu"

namespace PM
{

fn CreateDrawers(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : ust::optional</ AbstractDrawers />
{
	with( mut lock : settings.lock_mut() )
	{
		var Settings::RenderingMode &mut mode= lock.deref().r_mode;

		if( mode == Settings::RenderingMode::Random )
		{
			// On the first launch select OpenGL or software mode randomly.
			// Generally prefer OpenGL mode, since it gives stable framerates and better quality.
			// But sometimes choose software mode, since it's a masterpiece which should be shown to people (sometimes).

			ConsoleOutAddTextLine( console_out, "First launch detected, select rendering mode randomly." );

			var ust::default_hasher mut hasher;
			ust::apply_value_to_hasher( hasher, ust::system_time::now() );

			// 25% chance for software rendering, 75% chance for OpenGL rendering.
			if( hasher.get() % 1024s < 256s )
			{
				mode= Settings::RenderingMode::Software;
				ConsoleOutAddTextLine( console_out, "Software mode is randomly selected." );
			}
			else
			{
				mode= Settings::RenderingMode::OpenGL;
				ConsoleOutAddTextLine( console_out, "OpenGL mode is randomly selected." );
			}
		}
	}

	var Settings::RenderingMode mode= settings.lock_imut().deref().r_mode;

	switch( mode )
	{
		Settings::RenderingMode::Random ->
		{
			// Should be actually handled previously.
			return CreateDrawersSoft( settings, caching_game_resources_loader, console_out );
		},
		Settings::RenderingMode::OpenGL ->
		{
			var ust::optional</ AbstractDrawers /> mut drawers_gl=
				CreateDrawersGL( settings, caching_game_resources_loader, console_out );

			if( !drawers_gl.empty() )
			{
				return drawers_gl;
			}

			ConsoleOutAddTextLine( console_out, "Failed to initialize OpenGL drawers. Falling-back to software mode." );

			with( mut lock : settings.lock_mut() )
			{
				// Save software mode in settings to avoid trying initializing OpenGL mode next time.
				lock.deref().r_mode= Settings::RenderingMode::Software;
			}

			return CreateDrawersSoft( settings, caching_game_resources_loader, console_out );
		},
		Settings::RenderingMode::Software ->
		{
			return CreateDrawersSoft( settings, caching_game_resources_loader, console_out );
		},
		Settings::RenderingMode::OpenGLAndSoftware ->
		{
			return CreateDrawersGLAndSoft( settings, caching_game_resources_loader, console_out );
		}
	}
}

} // namespace PM
