import "drawers_factory.iu"
import "drawing_gl/hud_drawer_gl.iu"
import "drawing_gl/image_drawer_gl.iu"
import "drawing_gl/text_drawer_gl.iu"
import "drawing_gl/video_player_gl.iu"
import "drawing_gl/window_gl.iu"
import "drawing_gl/world_drawer_gl.iu"
import "loading_screen.iu"

namespace PM
{

fn CreateDrawers(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : AbstractDrawers
{
	return CreateDrawersGL( settings, caching_game_resources_loader, console_out );
}

fn CreateDrawersGL(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : AbstractDrawers
{
	var GameFilesystemPtr game_filesystem= caching_game_resources_loader.lock_imut().deref().GetGameFilesystem();

	auto mut window= ust::make_shared_ptr( WindowGL( settings, console_out ) );

	var [ u32, 2 ] viewport_size= window.lock_imut().deref().GetViewportSize();

	// Create classes requiring OpenGL context after OpenGL window creation.

	auto mut image_drawer= ust::make_box( ImageDrawerGL( viewport_size, game_filesystem, settings ) );

	// Draw loading screen as soon as possible.
	DrawLoadingScreen( window, image_drawer.deref() );

	auto mut hud_drawer=
		ust::make_box( HudDrawerGL( viewport_size, game_filesystem, console_out, settings.lock_imut().deref() ) );

	auto mut text_drawer= ust::make_box( TextDrawerGL( viewport_size, game_filesystem, console_out ) );

	auto mut world_drawer=
		ust::make_box(
			WorldDrawerGL( settings, caching_game_resources_loader, console_out, GLCapabilities::Create() ) );

	auto mut video_player= ust::make_box( VideoPlayerGL( window, console_out ) );

	return AbstractDrawers
	{
		.window= move(window),
		.image_drawer= move(image_drawer),
		.hud_drawer= move(hud_drawer),
		.text_drawer= move(text_drawer),
		.world_drawer= move(world_drawer),
		.video_player= move(video_player),
	};
}

} // namespace PM
