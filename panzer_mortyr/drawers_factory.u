import "drawing_gl/drawers_factory_gl.iu"
import "drawing_soft/drawers_factory_soft.iu"

namespace PM
{

fn CreateDrawers(
	SettingsPtr& settings,
	CachingGameResourcesLoaderPtr& caching_game_resources_loader,
	ConsoleOutPtr& console_out ) : AbstractDrawers
{
	switch( settings.lock_imut().deref().r_mode )
	{
		0u -> { return CreateDrawersGL( settings, caching_game_resources_loader, console_out ); },
		1u -> { return CreateDrawersSoft( settings, caching_game_resources_loader, console_out ); },
		default -> { return CreateDrawersGL( settings, caching_game_resources_loader, console_out ); },
	}
}

} // namespace PM
