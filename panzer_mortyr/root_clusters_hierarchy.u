import "bounding_boxes_hierarchy_building.uh"
import "cluster_utils.uh"
import "root_clusters_hierarchy.uh"

namespace PM
{

fn BuildRootClustersHierarchy( ust::array_view_imut</ZvoxCluster/> clusters ) : RootClustersHierarchy
{
	var ust::vector</ClusterIndexInHierarchy/> mut cluster_indices;

	for( auto mut i= 0s; i < clusters.size(); ++i )
	{
		var ZvoxCluster& cluster= clusters[i];

		if( cluster.c.num_children_clusters >= 0 &&
			// Ignore clusters with zero or negative size, just in case if some map has such invalid clusters.
			cluster.c.bounding_box_half_size[0] > 0 &&
			cluster.c.bounding_box_half_size[1] > 0 &&
			cluster.c.bounding_box_half_size[2] > 0 )
		{
			cluster_indices.push_back( ClusterIndexInHierarchy(i) );
		}
	}

	auto get_bbox_func=
		lambda[clusters]( ClusterIndexInHierarchy cluster_index ) : BBox3f
		{
			return CreateClusterBBox( clusters[ size_type( cluster_index ) ] );
		};

	// if we have 8 or more clusters, split them into nodes of 4 clusters.
	var size_type c_max_clusters_in_node= 7s;

	return BuildBoundingBoxesHierarchy( cluster_indices.range(), c_max_clusters_in_node, get_bbox_func );
}

} // namespace PM
