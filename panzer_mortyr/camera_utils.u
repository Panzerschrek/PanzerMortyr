import "camera_utils.iu"
import "math_constants.iu"

namespace PM
{

fn CreateCameraClipPlanes( WorldDrawingInfo::CameraParams& camera_params, f32 aspect ) : CameraClipPlanes
{
	var Mat4f rotation_matrix_x= Mat4f::MakeRotationX( camera_params.elevation - c_tau / 4.0f );
	var Mat4f rotation_matrix_z= Mat4f::MakeRotationZ( camera_params.azimuth );
	var Mat4f rotation_matrix= rotation_matrix_x * rotation_matrix_z;

	var Vec3f front_plane_normal= Vec3f( 0.0f, 0.0f, -1.0f );

	var f32 half_fov_x= camera_params.fov_x * 0.5f;
	var f32 half_fov_x_cos= ust::cos( half_fov_x );
	var f32 half_fov_x_sin= ust::sin( half_fov_x );

	var Vec3f left_plane_normal = Vec3f( -half_fov_x_cos, 0.0f, -half_fov_x_sin );
	var Vec3f right_plane_normal= Vec3f(  half_fov_x_cos, 0.0f, -half_fov_x_sin );

	var f32 half_fov_y= ust::atan( ust::tan( half_fov_x ) / aspect );
	var f32 half_fov_y_cos= ust::cos( half_fov_y );
	var f32 half_fov_y_sin= ust::sin( half_fov_y );

	var Vec3f upper_plane_normal= Vec3f( 0.0f, -half_fov_y_cos, -half_fov_y_sin );
	var Vec3f lower_plane_normal= Vec3f( 0.0f,  half_fov_y_cos, -half_fov_y_sin );

	return ust::make_array(
		// First plane is front plane - in order to reject stuff behind the back first.
		Planef::CreateFromNormalAndPoint( front_plane_normal * rotation_matrix, camera_params.position + Vec3f( 0.0f, 0.0f, c_z_near ) * rotation_matrix ),
		Planef::CreateFromNormalAndPoint( left_plane_normal  * rotation_matrix, camera_params.position ),
		Planef::CreateFromNormalAndPoint( right_plane_normal * rotation_matrix, camera_params.position ),
		Planef::CreateFromNormalAndPoint( upper_plane_normal * rotation_matrix, camera_params.position ),
		Planef::CreateFromNormalAndPoint( lower_plane_normal * rotation_matrix, camera_params.position ) );
}

fn AreBoxVerticesClippedByAtLeastOneCameraClipPlane( CameraClipPlanes& clip_planes, [ Vec3f, 8 ]& vertices ) : bool
{
	foreach( &clip_plane : clip_planes )
	{
		var f32 mut min_distance= ust::plus_inf</f32/>();
		foreach( &v : vertices )
		{
			ust::min_assign( min_distance, clip_plane.GetDistanceForPoint( v ) );
		}

		if( min_distance >= 0.0f )
		{
			return true;
		}
	}

	return false;
}

fn CalculateCameraRotationMatrix( f32 camera_azimuth, f32 camera_elevation ) : Mat4f
{
	var Mat4f rotation_matrix_z= Mat4f::MakeRotationZ( -camera_azimuth );
	var Mat4f rotation_matrix_x= Mat4f::MakeRotationX( -camera_elevation + c_tau / 4.0f );
	return rotation_matrix_z * rotation_matrix_x;
}

fn CalculateFirstPersonWeaponDistortionMatrix()  : Mat4f
{
	// The original game distorts first-weapon model a bit.
	// These parameters are experimentally found.
	// TODO - improve this. It seems like this distortion is specified in the "IC.STD" file via "deformacja_ogniskowej" param.
	return Mat4f::MakeScale( Vec3f( 1.0f, 0.5f, 1.0f ) );
}

fn CalculateScissorRectForSphere(
	Mat4f& camera_space_matrix,
	Mat4f& camera_projection_matrix,
	[ u32, 2 ]& viewport_size,
	Vec3f& sphere_center,
	f32 sphere_radius ) : ScissorRect
{
	var Vec3f projected_sphere_center= sphere_center * camera_space_matrix;

	var [ f32, 2 ] bounds_x= GetSphereAxisBounds( Vec2f( projected_sphere_center.x, projected_sphere_center.z ), sphere_radius );
	var [ f32, 2 ] bounds_y= GetSphereAxisBounds( Vec2f( projected_sphere_center.y, projected_sphere_center.z ), sphere_radius );

	var f32 scale_x= camera_projection_matrix.values[0][0];
	var f32 scale_y= camera_projection_matrix.values[1][1];
	var [ f32, 2 ] bounds_x_scaled[ bounds_x[0] * scale_x, bounds_x[1] * scale_x ];
	var [ f32, 2 ] bounds_y_scaled[ bounds_y[0] * scale_y, bounds_y[1] * scale_y ];

	var f32 max_integer_bounds= 65536.0f; // Limit integer min/max values to avoid overflows.

	var i32 min_x(
		ust::max(
			ust::floor( f32( viewport_size[0] ) * ( bounds_x_scaled[0] * 0.5f + 0.5f ) ),
			-max_integer_bounds ) );

	var i32 max_x(
		ust::min(
			ust::ceil ( f32( viewport_size[0] ) * ( bounds_x_scaled[1] * 0.5f + 0.5f ) ),
			max_integer_bounds ) );

	var i32 min_y(
		ust::max(
			ust::floor( f32( viewport_size[1] ) * ( bounds_y_scaled[0] * 0.5f + 0.5f ) ),
			-max_integer_bounds ) );

	var i32 max_y(
		ust::min(
			ust::ceil ( f32( viewport_size[1] ) * ( bounds_y_scaled[1] * 0.5f + 0.5f ) ),
			max_integer_bounds ) );

	return ScissorRect
	{
		.start[ min_x, min_y ],
		.size[ ( ust::max( 0, max_x - min_x ) ), ( ust::max( 0, max_y - min_y ) ) ],
	};
}

// Use method mentioned in the article "2D Polyhedral Bounds of a Clipped, Perspective-Projected 3D Sphere"
//  by Michael Mara, Morgan McGuire.
//
// Returns a pair of near and far values.
// Returns valid huge bounds if is inside the sphere.
// Returns invalid bounds if the sphere is invisible.
fn GetSphereAxisBounds( Vec2f& sphere_center, f32 sphere_radius ) : [ f32, 2 ]
{
	var f32 inf= 999999.0f;

	var f32 singned_distance_to_z_near= sphere_center.y - c_z_near;

	if( singned_distance_to_z_near <= -sphere_radius )
	{
		// The sphere is behind the camera - return empty bounds.
		return ust::make_array( inf, -inf );
	}

	var f32 radius_squared= sphere_radius * sphere_radius;
	var f32 distance_to_center_squared= sphere_center.SquareLength();
	var f32 tangent_length_squared= distance_to_center_squared - radius_squared;

	if( tangent_length_squared <= 0.0f )
	{
		// The sphere is within camera - return the whole range.
		return ust::make_array( -inf, inf );
	}

	var f32 tangent_length= ust::sqrt( tangent_length_squared );

	var Vec2f scaled_direction_to_center= sphere_center * ( tangent_length / distance_to_center_squared );

	var Vec2f near_intersection_point(
		scaled_direction_to_center.x * tangent_length - scaled_direction_to_center.y * sphere_radius,
		scaled_direction_to_center.y * tangent_length + scaled_direction_to_center.x * sphere_radius );

	var Vec2f far_intersection_point(
		scaled_direction_to_center.x * tangent_length + scaled_direction_to_center.y * sphere_radius,
		scaled_direction_to_center.y * tangent_length - scaled_direction_to_center.x * sphere_radius );

	var [ f32, 2 ] mut bounds= zero_init; // Set later

	var f32 side_step_squared= radius_squared - singned_distance_to_z_near * singned_distance_to_z_near;

	if( side_step_squared >= 0.0f )
	{
		var f32 side_step= ust::sqrt( side_step_squared );

		if( near_intersection_point.y < c_z_near )
		{
			bounds[0]= ( sphere_center.x - side_step ) / c_z_near;
		}
		else
		{
			bounds[0]= near_intersection_point.x / near_intersection_point.y;
		}

		if( far_intersection_point.y < c_z_near )
		{
			bounds[1]= ( sphere_center.x + side_step ) / c_z_near;
		}
		else
		{
			bounds[1]= far_intersection_point.x / far_intersection_point.y;
		}
	}
	else
	{
		bounds[0]= near_intersection_point.x / near_intersection_point.y;
		bounds[1]= far_intersection_point.x / far_intersection_point.y;
	}

	return bounds;
}

} // namespace PM
