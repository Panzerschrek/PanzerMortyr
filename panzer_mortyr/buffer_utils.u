import "/scoped_array.iu"
import "buffer_utils.uh"

namespace PM
{

fn CreateQuadsU16IndexBuffer( size_type num_qauds ) : BufferObject
{
	scoped_array u16 mut indices[ num_qauds * 6s ]( 0u16 );

	for( auto mut i= 0s; i < num_qauds; ++i )
	{
		indices[ i * 6s + 0s ]= u16( i * 4s + 0s );
		indices[ i * 6s + 1s ]= u16( i * 4s + 1s );
		indices[ i * 6s + 2s ]= u16( i * 4s + 2s );
		indices[ i * 6s + 3s ]= u16( i * 4s + 0s );
		indices[ i * 6s + 4s ]= u16( i * 4s + 2s );
		indices[ i * 6s + 5s ]= u16( i * 4s + 3s );
	}

	return BufferObject::CreateStaticDrawBuffer( GLenum( GL_ELEMENT_ARRAY_BUFFER ), indices.to_byte8_range() );
}

} // namespace PM
