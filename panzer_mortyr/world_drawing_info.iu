import "/vector.iu"
import "/common_lib/resource_string.iu"
import "bit_array.iu"
import "vec.iu"

namespace PM
{

// This structure describes how world should be drawn.
// This is the main interface structure prepared by game logic code for map drawer.
struct WorldDrawingInfo
{
	// Absolute time from map start.
	// Used for time-dependent animations rendering.
	f32 game_time_s;

	u32 map_index;

	CameraParams camera_params;

	// List of all models used.
	// This list should be always the same for a particular map, so that it's possible to load all models at map start.
	ust::vector</ResourceString/> used_models;

	ust::vector</ModelObject/> model_objects;

	ust::vector</DynamicClusterObject/> dynamic_cluster_objects;

	ust::vector</u32/> highligted_cluster_indices;

	ust::vector</Billboard/> billboards;

	ust::vector</Decal/> decals;

	ust::vector</BreakingGlass/> breaking_glass_effects;

	ust::vector</DynamicLightSource/> dynamic_light_sources;

	// Stores a bit for each map quad. Value 1 means this quad is broken.
	BitArray broken_quad_bits;

	// Test point objects rendered as sprites.
	ust::vector</Vec3f/> test_sprites;

	ust::vector</TestTriangle/> test_triangles;
	ust::vector</TestLine/> test_lines;

	FullscreenEffect fullscreen_effect;

	[ u8, 4 ] fullscreen_blend_color; // RGBA color. alpha= 0 means no blend.

	struct CameraParams
	{
		Vec3f position;
		f32 azimuth;
		f32 elevation;
		f32 fov_x;
	}

	// An object drawn as model.
	struct ModelObject
	{
		ResourceString model_file_name; // Should be listed in "used_models".
		Vec3f position;
		f32 azimuth;
		f32 elevation;
		ModelFrames frames;
		bool disable_culling; // True for models which should be drawn even if they are outside visible bounds.
		bool first_person_weapon;
		bool constant_lighting; // True for things which should remain bright (non-lit).
		f32 burning_strength= 0.0f; // 0 for non-burning enemies, 1 is full power.
		u8 blood_coverage= 0u8; // 0 - no coverage, 1 - medium coverage, 2 - full coverage.
	}

	// Mixing between two frames is supported for models.
	// This structure describes these two frames and mixing factor between them (in range 0 to 1).
	// If no mixing is needed, both frame numbers should be equal and mixing factor should be somewhere in range 0 to 1.
	struct ModelFrames
	{
		u32 frame0;
		u32 frame1;
		f32 frame_mix;
	}

	struct DynamicClusterObject
	{
		u32 cluster_index;
		Vec3f translation;
	}

	struct Billboard
	{
		enum Alignment
		{
			ZAxis,
			ToCamera,
			ToCameraWithConstantScreenSize,
			ToCustomAxis,
		}

		Alignment alignment;
		u8 billboard_index; // Index in the billboard description table.
		Vec3f position;
		Vec3f custom_axis= Vec3f::MakeZero(); // Used only for some alignments. May be non-normalized.
		f32 scale= 1.0f; // For most cases should be 1.
		f32 brightness= 1.0f; // For most cases should be 1. Values above 1 are clamped.
	}

	struct Decal
	{
		Vec3f position;
		f32 half_size; // A decal is a quad, this param is half size of its side.
		f32 azimuth;
		f32 elevation;
		u32 dynamic_cluster_object_index; // Is valid index if is attached to a dynamic cluster.
		u8 texture_index; // Index of one of dedicated decal textures. 0 for bullet hole, 1 for blood, 3 for footprint.
		bool mirrored;
	}

	struct BreakingGlass
	{
		Vec3f hit_position;
		u32 cluster_index;
		u32 quad_index;
		f32 age; // 0 - just started, 1 - at finish.
	}

	struct DynamicLightSource
	{
		Vec3f position;
		f32 power;
		u32 color_index;
	}

	struct TestTriangle
	{
		[ Vec3f, 3 ] vertices;
		[ u8, 3 ] color;
	}

	struct TestLine
	{
		[ Vec3f, 2 ] vertices;
		[ u8, 3 ] color;
	}

	enum FullscreenEffect
	{
		None,
		NightVision,
		InfraredVision,
	}
}

// This struct represents parameters for viewport using for world drawing.
struct WorldDrawingViewportInfo
{
	[ u32, 2 ] viewport_size;
	f32 view_aspect;
}

} // namespace PM
