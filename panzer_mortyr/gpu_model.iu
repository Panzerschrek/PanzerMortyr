import "bbox.iu"
import "buffer_object.iu"
import "gl_capabilities.iu"
import "settings.iu"
import "texture.iu"
import "vertex_array_object.iu"
import "/common_lib/model_loading.iu"

namespace PM
{

// GPU-side resources of a model.
struct GPUModel
{
	// These attribute numbers should match values in vertex shader!
	var GLuint c_texture_coordinates_attrib= 0u;
	var GLuint c_position_attrib= 1u;
	var GLuint c_normal_attrib= 2u;

	size_type num_vertices;
	size_type num_triangles;
	size_type num_frames;

	VertexArrayObject vertex_array_object;

	BufferObject texture_coordinates_buffer;
	BufferObject positions_buffer;

	BufferObject index_buffer;

	ust::vector</Texture/> textures;

	ust::vector</BBox3f/> frame_bboxes;
}

fn CreateGPUModel( ModelData& model_data, Settings& settings, GLCapabilities& gl_capabilities ) : GPUModel;

} // namespace PM
