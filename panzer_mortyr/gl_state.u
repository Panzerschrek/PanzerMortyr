import "gl_functions.iu"
import "gl_state.iu"

namespace PM
{

fn SetGLState( GLState& state )
{
	if( state.color_write_enabled )
	{
		unsafe( glColorMask( GLboolean(1), GLboolean(1), GLboolean(1), GLboolean(1) ) );
	}
	else
	{
		unsafe( glColorMask( GLboolean(0), GLboolean(0), GLboolean(0), GLboolean(0) ) );
	}

	if( state.depth_test_enabled )
	{
		unsafe( glEnable( GLenum( GL_DEPTH_TEST ) ) );
		unsafe( glDepthFunc( state.depth_test_func ) );
	}
	else
	{
		unsafe( glDisable( GLenum( GL_DEPTH_TEST ) ) );
	}

	if( state.depth_write_enabled )
	{
		unsafe( glDepthMask( GLboolean(1) ) );
	}
	else
	{
		unsafe( glDepthMask( GLboolean(0) ) );
	}

	if( state.cull_face_enabled )
	{
		unsafe( glEnable( GLenum( GL_CULL_FACE ) ) );
		unsafe( glCullFace( state.cull_face ) );
	}
	else
	{
		unsafe( glDisable( GLenum( GL_CULL_FACE ) ) );
	}

	if( state.blending_enabled )
	{
		unsafe( glEnable( GLenum( GL_BLEND ) ) );
		unsafe( glBlendFunc( state.blend_source_factor, state.blend_destination_factor ) );
	}
	else
	{
		unsafe( glDisable( GLenum( GL_BLEND ) ) );
	}

	if( state.scissor_test_enabled )
	{
		unsafe( glEnable( GLenum( GL_SCISSOR_TEST ) ) );

		unsafe( glScissor(
			GLint( state.scissor_rect.start[0] ),
			GLint( state.scissor_rect.start[1] ),
			GLsizei( state.scissor_rect.size[0] ),
			GLsizei( state.scissor_rect.size[1] ) ) );
	}
	else
	{
		unsafe( glDisable( GLenum( GL_SCISSOR_TEST ) ) );
	}
}

fn GetMirroredGLState( GLState mut state ) : GLState
{
	if( state.cull_face == GLenum( GL_FRONT ) )
	{
		state.cull_face= GLenum( GL_BACK );
	}
	else if( state.cull_face == GLenum( GL_BACK ) )
	{
		state.cull_face= GLenum( GL_FRONT );
	}

	return state;
}

} // namespace PM
