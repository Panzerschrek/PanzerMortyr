import "/enum_string_conversions.iu"
import "/file_helpers.iu"
import "/filesystem.iu"
import "/path_utils.iu"
import "/string_conversions.iu"
import "save_load.iu"

namespace PM
{

fn nodiscard SaveStoredGameState(
	ConsoleOutPtr& console_out,
	ust::string_view8 save_name,
	SaveComment& save_comment,
	u32 map_index,
	GameState& game_state,
	CameraController::State& camera_controller_state,
	AudioProcessorState& audio_processor_state,
	GlobalNavigationGraph& global_navigation_graph ) : bool
{
	var Serializer mut serializer;

	// Serialize header first.
	serializer.SerializeBytes(
		ust::single_element_array_view(
			SaveFileHeader
			{
				.signature= SaveFileHeader::c_expected_signature,
				.scheme_hash= c_serialization_scheme_hash
			} ).to_byte8_range() );

	// Serialize summary after header - to read it from save/load menus.
	Serialize( serializer, SaveSummary{ .comment= save_comment } );

	// Serialize map index to know which map to load.
	Serialize( serializer, map_index );

	// Serialize the whole game state structure.
	Serialize( serializer, game_state );

	// Serialize camera controller state (it's not a part of the game state).
	Serialize( serializer, camera_controller_state );

	// Serialize audio processor state (it's not a part of the game state).
	Serialize( serializer, audio_processor_state );

	// Save global navigation graph in order to avoid recalculating it upon loading.
	// Such recalculation isn't safe, since it may produce a result different from one calculated previously,
	// but we need the exactly same graph, since indices to its nodes are stored in game state structures.
	Serialize( serializer, global_navigation_graph );

	EnsureSavesDirectoryExists( console_out );
	var ust::filesystem_path save_file_path= GetSaveFilePath( save_name );

	result_match( ust::write_byte8_range_to_file( save_file_path, move(serializer).TakeBytes() ) )
	{
		Ok(v) ->
		{
			ust::ignore_unused(v);
			ConsoleOutAddTextLine( console_out, ust::concat( "Successfully saved game into \"", save_file_path, "\".\n" ) );
			return true;
		},
		Err(e) ->
		{
			ConsoleOutAddTextLine( console_out, ust::concat( "Failed to save game! Error: ", ust::enum_to_string(e) ) );
			return false;
		},
	}
}

fn LoadStoredGameState( ConsoleOutPtr& console_out, ust::string_view8 save_name ) : ust::optional</StoredGameState/>
{
	var ust::filesystem_path save_file_path= GetSaveFilePath( save_name );

	ConsoleOutAddTextLine( console_out, ust::concat( "Loading game from \"", save_file_path, "\".\n" ) );

	result_match( ust::read_file_to_byte8_vector( save_file_path ) )
	{
		Ok( file_contents ) ->
		{
			var Deserializer mut deserializer( file_contents );

			var SaveFileHeader mut header= zero_init;

			var Deserializer::BytesView header_bytes= deserializer.ExtractBytes( typeinfo</SaveFileHeader/>.size_of );
			if( header_bytes.size() != typeinfo</SaveFileHeader/>.size_of )
			{
				ConsoleOutAddTextLine( console_out, "Failed to deserialize save header!" );
				return ust::null_optional;
			}

			ust::single_element_array_view( header ).to_byte8_range().copy_from( header_bytes );

			if( header.signature != SaveFileHeader::c_expected_signature )
			{
				ConsoleOutAddTextLine( console_out, "Unexpected save file signature!" );
				return ust::null_optional;
			}

			if( header.scheme_hash != c_serialization_scheme_hash )
			{
				ConsoleOutAddTextLine(
					console_out,
					ust::concat(
						"Serialization scheme hash mismatch! Expected ",
						ust::to_string8( c_serialization_scheme_hash ),
						" got ",
						ust::to_string8( header.scheme_hash ),
						"." ) );
				return ust::null_optional;
			}

			var ust::optional</SaveSummary/> mut save_summary_opt= Deserialize</SaveSummary/>( deserializer );

			if( save_summary_opt.empty() )
			{
				ConsoleOutAddTextLine( console_out, "Failed to deserialize save summary!" );
				return ust::null_optional;
			}

			var ust::optional</u32/> mut map_index_opt= Deserialize</u32/>( deserializer );

			if( map_index_opt.empty() )
			{
				ConsoleOutAddTextLine( console_out, "Failed to deserialize map index!" );
				return ust::null_optional;
			}

			var ust::optional</GameState/> mut game_state_opt= Deserialize</GameState/>( deserializer );

			if( game_state_opt.empty() )
			{
				ConsoleOutAddTextLine( console_out, "Failed to deserialize game state!" );
				return ust::null_optional;
			}

			var ust::optional</CameraController::State/> mut camera_controller_state_opt=
				Deserialize</CameraController::State/>( deserializer );

			if( camera_controller_state_opt.empty() )
			{
				ConsoleOutAddTextLine( console_out, "Failed to deserialize camera controller state!" );
				return ust::null_optional;
			}

			var ust::optional</AudioProcessorState/> mut audio_processor_state_opt=
				Deserialize</AudioProcessorState/>( deserializer );

			if( audio_processor_state_opt.empty() )
			{
				ConsoleOutAddTextLine( console_out, "Failed to deserialize audio processor state!" );
				return ust::null_optional;
			}

			var ust::optional</GlobalNavigationGraph/> mut global_navigation_graph_opt=
				Deserialize</ GlobalNavigationGraph />( deserializer );

			if( global_navigation_graph_opt.empty() )
			{
				ConsoleOutAddTextLine( console_out, "Failed to deserialize global navigation graph!" );
				return ust::null_optional;
			}

			// Check if no bytes are left. If something is left, it's problably an error.
			if( !deserializer.ExtractBytes(1s).empty() )
			{
				ConsoleOutAddTextLine( console_out, "Warning, have undeserialized bytes left in a save file!" );
			}

			return StoredGameState
			{
				.save_summary= save_summary_opt.try_take(),
				.map_index= map_index_opt.try_take(),
				.game_state= game_state_opt.try_take(),
				.camera_controller_state= camera_controller_state_opt.try_take(),
				.audio_processor_state= audio_processor_state_opt.try_take(),
				.global_navigation_graph= global_navigation_graph_opt.try_take(),
			};
		},
		Err(e) ->
		{
			ConsoleOutAddTextLine( console_out, ust::concat( "Failed to load saved game! Error: ", ust::enum_to_string(e) ) );
			return ust::null_optional;
		}
	}
}

fn GetSaveNameForSlot( u32 slot_index ) : ust::string8
{
	var [ char8, 6 ] name
	[
		'g',
		'a',
		'm',
		'e',
		( u32( '0' ) + slot_index / 10u ),
		( u32( '0' ) + slot_index % 10u ),
	];

	return name;
}

fn GetSaveFilePath( ust::string_view8 save_name ) : ust::filesystem_path
{
	auto& c_save_file_extension= ".pms"; // PanzerMortyrSave

	return ust::path::join( c_saves_directory, ust::concat( save_name, c_save_file_extension ) );
}

fn EnsureSavesDirectoryExists( ConsoleOutPtr& console_out )
{
	if_var( e : ust::create_directory_with_parents( c_saves_directory ).as_error_ref() )
	{
		ConsoleOutAddTextLine(
			console_out,
			ust::concat( "Failed to create directory \"", c_saves_directory, "\": ", ust::enum_to_string( e ) ) );
	}
}

// For now use a hardcode saves directory path.
// TODO - allow changing it.
auto& c_saves_directory= "saves";

// This function is slow and should be executed only in compilation time!
// It also isn't secure (is non-cryptographic).
template</ size_type S />
fn constexpr CalculateNonSecureHashSlow( [ char8, S ]& data ) : u32
{
	// Use MurmurHash3 here (sort of).
	// https://github.com/aappleby/smhasher/blob/master/src/MurmurHash3.cpp

	// Initialization.
	var u32 mut h= 0u;

	// Body.

	for( auto mut i= 0s; i < S; i+= 4s )
	{
		// For simplicity just clamp indices to avoid reading out of bounds for the last block.
		// It's incorrect, since tail bytes should be processed separately, but it's mostly fine.
		var u32 mut x=
			( u32( u8( data[ ust::min( i, S - 1s ) ] ) ) <<  0 ) |
			( u32( u8( data[ ust::min( i, S - 1s ) ] ) ) <<  8 ) |
			( u32( u8( data[ ust::min( i, S - 1s ) ] ) ) << 16 ) |
			( u32( u8( data[ ust::min( i, S - 1s ) ] ) ) << 24 );

		x*= 0xcc9e2d51u;
		x= ( x << 15 ) | ( x >> 17 );
		x*= 0x1b873593u;

		h ^= x;
		h= ( h << 13 ) | ( h >> 19 );
		h= h * 5u + 0xe6546b64u;
	}

	// Finalization.

	h ^= u32( S );

	h ^= h >> 16;
	h *= 0x85ebca6bu;
	h ^= h >> 13;
	h *= 0xc2b2ae35u;
	h ^= h >> 16;

	return h;
}

// Save in save files a hash of the serialization scheme for data structures serialized.
// This allows to detect if a save file uses a scheme different from the current one (a save file from an old PanzerMortyr version).
// It's not a 100% protection, since hash-collisions are still possible, but with 32-bit hashes they are extremely unlikely.
type SerializationSchemeHashType= u32;

var SerializationSchemeHashType constexpr c_serialization_scheme_hash=
	CalculateNonSecureHashSlow(
		BuildSerializationSchemeFull</SaveSummary/>() +
		BuildSerializationSchemeFull</GameState/>() +
		BuildSerializationSchemeFull</CameraController::State/>() +
		BuildSerializationSchemeFull</AudioProcessorState/>() +
		BuildSerializationSchemeFull</GlobalNavigationGraph/>() );

// This struct is saved directly into the save file.
struct SaveFileHeader ordered
{
	var [ char8, 16 ]& c_expected_signature= "PanzerMortyrSave";

	[ char8, 16 ] signature;
	SerializationSchemeHashType scheme_hash;
}

static_assert( typeinfo</SaveFileHeader/>.size_of == 20s, "Unexpected save file header size!" );

} // namespace PM
