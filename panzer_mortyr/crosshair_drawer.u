import "crosshair_drawer.uh"
import "mat.uh"
import "math_constants.uh"

namespace PM
{

fn DrawCrosshair( TextDrawer &mut text_drawer, [ u32, 2 ] viewport_size, CrosshairDrawingInfo& drawing_info )
{
	if( drawing_info.hit_point_kind == CrosshairDrawingInfo::HitPointKind::None )
	{
		return;
	}

	var Mat4f rotation_matrix_z= Mat4f::MakeRotationZ( -drawing_info.camera_azimuth );
	var Mat4f rotation_matrix_x= Mat4f::MakeRotationX( -drawing_info.camera_elevation + c_tau / 4.0f );

	var Mat4f projection_matrix=
		Mat4f::MakePerspective(
			f32( viewport_size[0] ) / f32( viewport_size[1] ),
			drawing_info.camera_fov,
			1.0f,
			1024.0f );

	var Mat4f translation_matrix= Mat4f::MakeTranslation( -drawing_info.camera_position );

	var Mat4f view_matrix= translation_matrix * rotation_matrix_z * rotation_matrix_x * projection_matrix;

	var Vec3f hit_point_transformed= drawing_info.hit_point * view_matrix;
	var f32 hit_point_w=
		drawing_info.hit_point.Dot(
			Vec3f( view_matrix.values[0][3], view_matrix.values[1][3], view_matrix.values[2][3] ) ) +
		view_matrix.values[3][3];

	if( hit_point_w <= 0.0f )
	{
		return;
	}

	var Vec2f hit_screen_position( hit_point_transformed.x / hit_point_w, hit_point_transformed.y / hit_point_w );

	var [ i32, 2 ] center
	[
		( ( hit_screen_position.x + 1.0f ) * 0.5f * f32( viewport_size[0] ) ),
		( ( hit_screen_position.y + 1.0f ) * 0.5f * f32( viewport_size[1] ) ),
	];

	var i32 scale= ust::max( 1, ust::min( i32( viewport_size[0] / 640u ), i32( viewport_size[1] / 480u ) ) );

	var TextDrawer::Settings text_settings
	{
		.scale( scale ),
		.foreground_color= GetColorForCrosshairHitPointKind( drawing_info.hit_point_kind ),
		.background_color= zero_init,
	};

	text_drawer.AddText( center[0] - 8 * scale, center[1] -  5 * scale, "_", text_settings );
	text_drawer.AddText( center[0] - 6 * scale, center[1] -  5 * scale, "_", text_settings );

	text_drawer.AddText( center[0] + 4 * scale, center[1] -  5 * scale, "_", text_settings );
	text_drawer.AddText( center[0] + 6 * scale, center[1] -  5 * scale, "_", text_settings );

	text_drawer.AddText( center[0] + 0 * scale, center[1] - 11 * scale, "I", text_settings );

	text_drawer.AddText( center[0] + 0 * scale, center[1] +  1 * scale, "I", text_settings );
}

fn GetColorForCrosshairHitPointKind( CrosshairDrawingInfo::HitPointKind kind ) : [ u8, 4 ]
{
	switch( kind )
	{
		CrosshairDrawingInfo::HitPointKind::None -> { return ust::make_array( 255u8, 255u8, 255u8, 255u8 ); },
		CrosshairDrawingInfo::HitPointKind::Sky -> { return ust::make_array( 128u8, 255u8, 128u8, 255u8 ); },
		CrosshairDrawingInfo::HitPointKind::World -> { return ust::make_array( 255u8, 255u8, 128u8, 255u8 ); },
		CrosshairDrawingInfo::HitPointKind::Entity -> { return ust::make_array( 255u8, 128u8, 128u8, 255u8 ); },
	}
}

} // namespace PM
