namespace PM
{

//
// Caution!
// Vertex formats specified in this file should obey OpenGL alighment rules.
// 3 and 4-component f32 vectors should be aligned to 4 f32 elements.
// 3 and 4-component 87 bectors should be aligned to 4 bytes.
//

// Use f32 for position and texture coordinates, since the original data is store in this format.
struct MapVertex ordered
{
	// Position in world space.
	[ f32, 3 ] position;

	f32 padding12;

	// Normalized texture coordinates. Third component is integer texture index in array.
	[ f32, 3 ] tex_coordinates;

	// RGB per-vertex light.
	[ u8, 3 ] light;

	byte8 padding31;
}

static_assert( typeinfo</MapVertex/>.size_of == 32s );

} // namespace PM
