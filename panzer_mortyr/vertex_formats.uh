import "/type_traits.u"

namespace PM
{

//
// Caution!
// Vertex formats specified in this file should obey OpenGL alighment rules.
// 3 and 4-component f32 vectors should be aligned to 4 f32 elements.
// 3 and 4-component 87 bectors should be aligned to 4 bytes.
//

// Use f32 for position and texture coordinates, since the original data is store in this format.
struct MapVertex ordered
{
	// Position in world space.
	[ f32, 3 ] position;

	f32 padding12;

	// Normalized texture coordinates. Third component is integer texture index in array.
	[ f32, 3 ] tex_coordinates;

	// RGB per-vertex light.
	[ u8, 3 ] light;

	byte8 padding31;
}

static_assert( typeinfo</MapVertex/>.size_of == 32s );

struct TextVertex ordered
{
	[ f32, 2 ] position;
	[ f32, 2 ] tex_coordinates;
	[ u8, 4 ] foreground_color;
	[ u8, 4 ] background_color;
}

struct HudVertex ordered
{
	[ f32, 2 ] position;
	[ f32, 2 ] tex_coordinates;
}

// Vertex structure used for things like test sprites, lines, triangles.
struct TestPrimitiveVertex ordered
{
	// Position in world space.
	[ f32, 3 ] position;

	[ u8, 3 ] color;

	u8 padding15;
}

struct SkyBackgroundVertex ordered
{
	// Position in world space.
	[ f32, 3 ] position;

	[ u8, 3 ] color;

	u8 padding15;
}

static_assert( typeinfo</TextVertex/>.size_of == 24s );

template</ type StructT, [ char8, S ] field_name, size_type S />
fn GetStructFieldOffset() : size_type
{
	for( &f : typeinfo</StructT/>.fields_list )
	{
		if( ust::constexpr_string_equals( f.name, field_name ) )
		{
			return f.offset;
		}
	}

	halt;
}

} // namespace PM
