import "/optional.iu"

namespace PM
{

struct GameEventNotificationsDrawingInfo
{
	EventNotification event_notification;

	ust::optional</NoteInfo/> note_info;

	// Non-zero values are indices of note images which should be pre-loaded.
	// A note shown should be listed here to be drawn properly.
	// This array is pretty small, since there is maximum a couple of unique notes on a map.
	[ u8, 16 ] note_indices_to_preload;

	enum EventNotification
	{
		None,
		KeyARequired,
		KeyBRequired,
		KeyCRequired,
		SecretAreaFound,
	}

	struct NoteInfo
	{
		u8 note_index; // 8 bits are enough. Maximum note index used in original game is 200.
		f32 scale; // Maximum is 1.
		f32 alpha; // Maximum is 1.
	}
}

} // namespace PM
