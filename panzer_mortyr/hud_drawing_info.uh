namespace PM
{

struct HudDrawingInfo
{
	IconIndex character_icon_index; // Zero if none.

	u16 health;
	u16 armor;

	i16 ammo; // Negative if shouldn't display at all.
	IconIndex weapon_icon_index;

	// Several inventory items can be displayed. One of them is selected.
	[ IconIndex, 20 ] inventory_tool_icons;
	u8 num_inventory_tool_icons;
	u8 selected_inventory_tool_icon_index; // Should be valid index in the array above.

	[ IconIndex, 3 ] key_icon_indices; // Zero if none.

	// Several active tools may be displayed.
	[ ActiveTool, 8 ] active_tools;
	u8 num_active_tools;

	// We have way less than 255 HUD icons.
	type IconIndex= u8;

	struct ActiveTool
	{
		u8 icon_index;
		u16 amount;
	}
}

} // namespace PM
