namespace PM
{

struct HudDrawingInfo
{
	u32 character_icon_index; // Zero if none.

	u32 health;
	u32 armor;

	i32 ammo; // Negative if shouldn't display at all.
	u32 weapon_icon_index;

	// Several inventory items can be displayed. One of them is selected.
	[ u8, 20 ] inventory_tool_icons;
	u8 num_inventory_tool_icons;
	u8 selected_inventory_tool_icon_index; // Should be valid index in the array above.

	[ u32, 3 ] key_icon_indices; // Zero if none.

	// Several active tools may be displayed.
	[ ActiveTool, 8 ] active_tools;
	u8 num_active_tools;

	struct ActiveTool
	{
		u8 icon_index;
		u16 amount;
	}
}

} // namespace PM
