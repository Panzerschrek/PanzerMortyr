import "/variant.u"
import "/vector.u"
import "/common_lib/map_files.uh"
import "bbox.uh"

namespace PM
{

struct QuadsHierarchy
{
	ust::vector</Node/> nodes;
	ust::vector</QuadIndex/> cluster_indices;

	struct Node
	{
		BBox3f bbox;
		ust::variant</ tup[ BranchNodeContents, LeafNodeContents ] /> contents;
	}

	struct BranchNodeContents
	{
		[ u32, 2 ] children_nodes;
	}

	struct LeafNodeContents
	{
		u32 first_cluster_index;
		u32 num_cluster_indices;
	}

	struct QuadIndex
	{
		u32 cluster_index;
		u32 quad_index;
	}
}

fn BuildQuadsHierarchy(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads ) : QuadsHierarchy;

template</type Func/>
fn VisitQuadsHierarchy( QuadsHierarchy& hierarchy, BBox3f& bbox, Func& func )
{
	VisitQuadsHierarchy_r( hierarchy, 0u, bbox, func );
}

template</type Func/>
fn VisitQuadsHierarchy_r( QuadsHierarchy& hierarchy, u32 node_index, BBox3f& bbox, Func& func )
{
	var QuadsHierarchy::Node& node= hierarchy.nodes[ size_type( node_index ) ];

	if( !bbox.InstersectsOrTouches( node.bbox ) )
	{
		return;
	}

	if_var( &branch_node_contents : node.contents.get</QuadsHierarchy::BranchNodeContents/>() )
	{
		foreach( child_node_index : branch_node_contents.children_nodes )
		{
			VisitQuadsHierarchy_r( hierarchy, child_node_index, bbox, func );
		}
	}
	else if_var( &leaf_node_contents : node.contents.get</QuadsHierarchy::LeafNodeContents/>() )
	{
		foreach( &quad_index : hierarchy.cluster_indices.range().subrange(
			size_type( leaf_node_contents.first_cluster_index ),
			size_type( leaf_node_contents.first_cluster_index ) + size_type( leaf_node_contents.num_cluster_indices ) ) )
		{
			func( quad_index );
		}
	}
	else{ halt; }
}

} // namespace PM
