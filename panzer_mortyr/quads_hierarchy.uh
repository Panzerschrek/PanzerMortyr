import "/variant.u"
import "/vector.u"
import "/common_lib/map_files.uh"
import "bbox.uh"

namespace PM
{

// Bounding boxes binary tree for map quads.
// It's helpful to find quads in some specific area with reasonable speed (without enumerating all quads).
struct QuadsHierarchy
{
	// Nodes of quads hierarchy. First node is root.
	ust::vector</Node/> nodes;

	// Indices of quads. Each leaf have a subrange in this container.
	ust::vector</PackedQuadIndex/> quad_indices;

	// Tree node with bounding box.
	struct Node
	{
		BBox3f bbox;
		// Store a couple of children nodes or several quads.
		ust::variant</ tup[ BranchNodeContents, LeafNodeContents ] /> contents;
	}

	struct BranchNodeContents
	{
		// Contains indices of child nodes.
		[ u32, 2 ] children_nodes;
	}

	struct LeafNodeContents
	{
		// Leaf quads are listed as indices in the "quad_indices" container.
		u32 first_quad_index;
		u32 num_quad_indices;
	}

	// Pack cluster index and quad index into single 32-bit value (for compactness).
	class PackedQuadIndex
	{
	public:
		fn constructor( size_type cluster_index, size_type quad_index )
			( packed_index_( ( cluster_index << c_cluster_index_shift ) | quad_index ) )
		{}

		fn constructor( mut this, PackedQuadIndex& other )= default;
		op=( mut this, PackedQuadIndex& other )= default;

		fn GetClusterIndex( this ) : size_type
		{
			return size_type( packed_index_ ) >> c_cluster_index_shift;
		}

		fn GetQuadIndex( this ) : size_type
		{
			return size_type( packed_index_ ) & ( ( 1s << c_cluster_index_shift ) - 1s );
		}

	private:
		var size_type c_cluster_index_shift= 16s;

	private:
		u32 packed_index_;
	}
}

fn BuildColliderQuadsHierarchy(
	ust::array_view_imut</ZvoxCluster/> clusters,
	ust::array_view_imut</ZmapQuad/> quads ) : QuadsHierarchy;

// Input function should have two parameters of "size_type" for cluster index and quad index.
template</type Func/>
fn VisitQuadsHierarchyForBBox( QuadsHierarchy& hierarchy, BBox3f& bbox, Func& func )
{
	VisitQuadsHierarchyForBBox_r( hierarchy, 0u, bbox, func );
}

template</type Func/>
fn VisitQuadsHierarchyForBBox_r( QuadsHierarchy& hierarchy, u32 node_index, BBox3f& bbox, Func& func )
{
	var QuadsHierarchy::Node& node= hierarchy.nodes[ size_type( node_index ) ];

	if( !bbox.InstersectsOrTouches( node.bbox ) )
	{
		return;
	}

	if_var( &branch_node_contents : node.contents.get</QuadsHierarchy::BranchNodeContents/>() )
	{
		foreach( child_node_index : branch_node_contents.children_nodes )
		{
			VisitQuadsHierarchyForBBox_r( hierarchy, child_node_index, bbox, func );
		}
	}
	else if_var( &leaf_node_contents : node.contents.get</QuadsHierarchy::LeafNodeContents/>() )
	{
		foreach( &quad_index : hierarchy.quad_indices.range().subrange(
			size_type( leaf_node_contents.first_quad_index ),
			size_type( leaf_node_contents.first_quad_index ) + size_type( leaf_node_contents.num_quad_indices ) ) )
		{
			func( quad_index.GetClusterIndex(), quad_index.GetQuadIndex() );
		}
	}
	else{ halt; }
}

} // namespace PM
