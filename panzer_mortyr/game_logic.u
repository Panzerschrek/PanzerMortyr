namespace PM
{

fn CreateNewMapGameState(
	GameMapData& map_data, u32 skill, ust::optional_ref_imut</PlayerState/> prev_player_state ) : GameState
{
	var GameState mut game_state
	{
		.skill= skill,
		// Use pretty large initial step index to be able to use 0 for representing some time step in the past.
		.step_index= 4096u,
		.player
		{
			.position= Vec3f::MakeZero(),
			.azimuth= 0.0f,
			.velocity= Vec3f::MakeZero(),
			.on_ground= false,
			.in_liquid= false,
			.noclip= false,
			.invisibility= false,
			.invulnerability= false,
			.ground_friction= 0.0f,
			.crouching_phase= 0.0f,
			.energy= 0u,
			.armor= 0u,
			.collider_index= ~0u,
			.inventory= zero_init,
			.primary_weapon_state
			{
				.current_weapon= EntitiesDescription::ToolType::None,
				.requested_weapon= EntitiesDescription::ToolType::None,
				.weapon_switching_fraction= c_weapon_switching_half_time_steps,
				.weapon_state
				{
					.extra_lowering= 0.0f,
					.current_animation= PlayerWeaponState::WeaponAnimation::None,
					.current_animation_step= 0u,
				},
			},
			.kick_weapon_state
			{
				.extra_lowering= 0.0f,
				.current_animation= PlayerWeaponState::WeaponAnimation::None,
				.current_animation_step= 0u,
			},
			.tools_state
			{
				.selected_tool= EntitiesDescription::ToolType::None, // Set later.
				.last_tool_selection_step= 0u,
				.acid_protection_suit_is_active= false,
				.night_vision_is_active= false,
				.infrared_vision_is_active= false,
				.flashlight_is_active= false,
			},
			.last_requested_key_type= EntitiesDescription::ToolType::None,
			.last_key_request_step= 0u,
			.activated_triggers_mask= 0u,
			.last_opened_secret_area_step= 0u,
			.horizontal_distance_walked= 0.0f,
		},
		.broken_quad_bits( map_data.zmap_data.deref().quads.size() )
	};

	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	var ZpozData& zpoz_data= map_data.zpoz_data.deref();

	var ust::array_view_imut</ZpozEntity/> zpoz_entities= zpoz_data.entities;

	// Map source entities 1 to 1 to runtime entities. It's needed for index stability.
	game_state.entities.resize( zpoz_entities.size() );

	foreach( pair : zpoz_entities.iter().zip( game_state.entities.iter() ) )
	{
		var ZpozEntity& in_entity= pair.first;

		if( in_entity.alive_flag == 0u16 )
		{
			continue;
		}

		if( u32( in_entity.kind ) == c_player_entity_kind )
		{
			// Do not place player spawn entities.
			continue;
		}

		var size_type navigation_info_index( in_entity.data[16] );
		if( navigation_info_index < zpoz_data.entity_navigation_infos.size() &&
			 zpoz_data.entity_navigation_infos[ navigation_info_index ].spawn_trigger_is_present != 0u )
		{
			// Don't spawn enemies spawned via a trigger touch.
			continue;
		}

		if( size_type( in_entity.kind ) >= entities_description.entities.size() )
		{
			continue;
		}

		var EntitiesDescription::EntityDescription& entity_description=
			entities_description.entities[ size_type( in_entity.kind ) ];

		if( size_type( c_start_operation ) >= entity_description.operations.size() )
		{
			continue;
		}

		pair.second=
			EntityState
			{
				.kind( in_entity.kind ),
				.position( f32( in_entity.position[0] ), f32( in_entity.position[1] ), f32( in_entity.position[2] ) ),
				.azimuth( Convert1024Angle( f32( in_entity.data[4] ) ) ),
				.energy= entity_description.energy,
				.ammo= entity_description.ammunition,
				.current_operation= c_start_operation,
				.num_steps_since_operation_start= 0u,
				.navigation_info_index( navigation_info_index ),
				.alarmed= false,
				.player_is_in_sight= false,
				.lost_energy_in_current_operation= false,
				.animation_frame= 0u, // Set exact frame later.
				.directional_animation_frame= 0u, // Set exact frame later.
				.velocity_z= 0.0f,
				.collider_index= ~0u,
			};

		with( &mut entity : pair.second.try_deref() )
		{
			// Emit a sound if spawning an entity in state requiring such sound.
			if_var( &sound : entity_description.operations[ size_type( entity.current_operation ) ].sound )
			{
				if( sound.sound_index <= 255u )
				{
					EmitSound( entity.sound_source_slots, u8( sound.sound_index ), sound.power );
				}
			}
		}
	}

	// Map entity navigation infos 1 to 1 to what is stored in the map data.
	game_state.entity_navigation_states.resize(
		zpoz_data.entity_navigation_infos.size(),
		EntityNavigationState
		{
			.last_route_search_step_index= 0u,
			.target_navigation_graph_node= GlobalNavigationGraph::c_invalid_node_index,
			.current_navigation_graph_node= GlobalNavigationGraph::c_invalid_node_index,
			.route[ GlobalNavigationGraph::c_invalid_node_index ... ],
			.current_patrolling_point_index= 0u8,
		} );

	// Build colliders for entities.
	game_state.colliders.clear();
	for( auto mut i= 0s; i < game_state.entities.size(); ++i )
	{
		AddEntityCollider( entities_description, i, game_state );
	}

	// Find player spawn.
	foreach( &entity : zpoz_entities )
	{
		if( entity.alive_flag == 0u16 )
		{
			continue;
		}

		if( u32( entity.kind ) == c_player_entity_kind )
		{
			game_state.player=
				PlayerState
				{
					.position( f32( entity.position[0] ), f32( entity.position[1] ), f32( entity.position[2] ) ),
					.azimuth= Convert1024Angle( f32( entity.data[4] ) ),
					.velocity= Vec3f::MakeZero(),
					.on_ground= false,
					.in_liquid= false,
					.noclip= false,
					.invisibility= false,
					.invulnerability= false,
					.ground_friction= 0.0f,
					.crouching_phase= 0.0f,
					.energy= GetPlayerStartEnergy( entities_description ),
					.armor= 0u, // TODO - maybe read it from some config?
					.collider_index= ~0u,
					.inventory= zero_init,
					.primary_weapon_state
					{
						.current_weapon= EntitiesDescription::ToolType::None,
						.requested_weapon= EntitiesDescription::ToolType::None,
						.weapon_switching_fraction= c_weapon_switching_half_time_steps,
						.weapon_state
						{
							.extra_lowering= 0.0f,
							.current_animation= PlayerWeaponState::WeaponAnimation::None,
							.current_animation_step= 0u,
						},
					},
					.kick_weapon_state
					{
						.extra_lowering= 0.0f,
						.current_animation= PlayerWeaponState::WeaponAnimation::None,
						.current_animation_step= 0u,
					},
					.tools_state
					{
						.selected_tool= EntitiesDescription::ToolType::None, // Set later.
						.last_tool_selection_step= 0u,
						.acid_protection_suit_is_active= false,
						.night_vision_is_active= false,
						.infrared_vision_is_active= false,
						.flashlight_is_active= false,
					},
					.last_requested_key_type= EntitiesDescription::ToolType::None,
					.last_key_request_step= 0u,
					.activated_triggers_mask= 0u,
					.last_opened_secret_area_step= 0u,
					.horizontal_distance_walked= 0.0f,
				};

			if_var( &prev_state : prev_player_state )
			{
				var PlayerState &mut player_state= game_state.player;

				// Preserve health and items from previous state.
				player_state.energy= prev_state.energy;
				player_state.inventory= prev_state.inventory;

				// But don't preserve keys.
				player_state.inventory[ size_type( EntitiesDescription::ToolType::KeyA ) ]= 0u;
				player_state.inventory[ size_type( EntitiesDescription::ToolType::KeyB ) ]= 0u;
				player_state.inventory[ size_type( EntitiesDescription::ToolType::KeyC ) ]= 0u;

				// Preserve current weapon (if can).
				if( player_state.inventory[ size_type( prev_state.primary_weapon_state.current_weapon ) ] != 0u )
				{
					player_state.primary_weapon_state.current_weapon= prev_state.primary_weapon_state.current_weapon;
				}
				else
				{
					player_state.primary_weapon_state.current_weapon= EntitiesDescription::ToolType::Kick;
				}

				// Preserve selected tool.
				player_state.tools_state.selected_tool= prev_state.tools_state.selected_tool;

				// Preserve night vision and infrared vision if it was active.
				player_state.tools_state.night_vision_is_active= prev_state.tools_state.night_vision_is_active;
				player_state.tools_state.infrared_vision_is_active= prev_state.tools_state.infrared_vision_is_active;
				player_state.tools_state.flashlight_is_active= prev_state.tools_state.flashlight_is_active;
			}
			else
			{
				// Give the player tools which he should have at start.
				for( auto mut t= 0s; t < typeinfo</ EntitiesDescription::ToolType />.element_count; ++t )
				{
					var size_type tool_index( entities_description.tool_type_to_index_map[t] );
					if( tool_index < entities_description.tools.size() )
					{
						game_state.player.inventory[t]= entities_description.tools[ tool_index ].player_start_count;
					}
				}

				// Make the best weapon we have active.
				var [ EntitiesDescription::ToolType, 11 ] weapon_tools
				[
					EntitiesDescription::ToolType::Kick,
					EntitiesDescription::ToolType::WeaponA,
					EntitiesDescription::ToolType::WeaponB,
					EntitiesDescription::ToolType::WeaponC,
					EntitiesDescription::ToolType::WeaponD,
					EntitiesDescription::ToolType::WeaponE,
					EntitiesDescription::ToolType::WeaponF,
					EntitiesDescription::ToolType::WeaponG,
					EntitiesDescription::ToolType::WeaponH,
					EntitiesDescription::ToolType::WeaponI,
					EntitiesDescription::ToolType::WeaponJ,
				];

				foreach( weapon_tool : weapon_tools )
				{
					if( game_state.player.inventory[ size_type(weapon_tool) ] > 0u )
					{
						game_state.player.primary_weapon_state.current_weapon= weapon_tool;
					}
				}
			}

			game_state.player.primary_weapon_state.requested_weapon=
				game_state.player.primary_weapon_state.current_weapon;

			AddPlayerCollider( entities_description, game_state );

			break;
		}
	}

	auto clusters= map_data.zvox_data.deref().clusters.range();

	// Prepare dynamic clusters.
	for( auto mut c= 0s; c < clusters.size(); ++c )
	{
		var ZvoxCluster& cluster= clusters[c];
		if( cluster.cluster_type == ZvoxCluster::c_cluster_type_regular |
			cluster.cluster_type == ZvoxCluster::c_cluster_type_notes )
		{
			continue;
		}

		game_state.dynamic_clusters.push_back(
			DynamicClusterState
			{
				.movement_stage= DynamicClusterState::MovementStage::StayAtStart,
				.num_steps_to_movement_stage_transition= 0u,
				.distance_from_start= 0.0f,
			} );

		game_state.dynamic_cluster_colliders.push_back(
			DynamicClusterCollider
			{
				.cluster_index( c ),
				.bbox( CreateDynamicClusterBBox( cluster, Vec3f::MakeZero() ) ),
			} );
	}

	return game_state;
}

fn nodiscard ProcessGameLogicStep(
	GameGlobalData& global_data,
	GameMapData& map_data,
	PlayerInput& player_input,
	GameState &mut game_state,
	GlobalNavigationGraphRouteSearcher &mut route_searcher ) : u32
{
	PerformPlayerWeaponLogic( map_data, player_input, game_state );

	PerformPlayerInventoryLogic(
		map_data.entities_description.deref(), player_input.inventory_input, game_state.player, game_state.step_index );

	UpdatePlayerActiveTools( game_state.player, game_state.step_index );

	PerformPlayerMovement( global_data, map_data, player_input, game_state );

	// Spawn new entities before entity update step, so that they are properly animated.
	TriggerEntitiesSpawn( map_data, game_state );

	var RouteSearchContext mut route_search_context
	{
		.route_searcher= route_searcher,
		.num_nodes_visited= 0s,
	};

	ProcessEntitiesLogicStep( global_data, map_data, game_state, route_search_context );

	ProcessDynamicClustersLogicStep( global_data, map_data, game_state );

	ProcessProjectilesLogicStep( global_data, map_data, game_state );

	ProcessProjectileHitEventsLogicStep( global_data, map_data, game_state );

	ProcessDamagingFlamesLogicStep(
		global_data,
		game_state.damaging_flames,
		game_state.random,
		game_state.entities,
		game_state.player );

	ProcessProjectileHitSmokeEmittersLogicStep( game_state );

	ProcessProjectileHitSmokeParticlesLogicStep( game_state.projectile_hit_smoke_particles );

	ProcessBreakingGlassLogicStep( game_state.breaking_glass_effects );

	ProcessMuzzleFlashesLogicStep( game_state.muzzle_flashes );

	ProcessSparkParticlesLogicStep( game_state.spark_particles );

	ProcessExplosionParticlesLogicStep( game_state.explosion_particles );

	ProcessFlameParticlesLogicStep( game_state );

	ProcessSmokeParticlesLogicStep( game_state.smoke_particles );

	ProcessSmokeTrailParticlesLogicStep( game_state.smoke_trail_particles );

	ProcessMuzzleLightsLogicStep( game_state.muzzle_lights );

	ProcessProjectileHitLightsLogicStep( game_state.projectile_hit_lights );

	PickUpItems( global_data.sounds_description.deref(), map_data, game_state );

	DealPlayerEnvironmentalDamage( global_data.sounds_description.deref(), map_data, game_state );

	var u32 next_map_index= InteractWithTriggerVolumes( global_data.sounds_description.deref(), map_data, game_state );

	++game_state.step_index;

	return next_map_index;
}

fn PerformPlayerWeaponLogic( GameMapData& map_data, PlayerInput& player_input, GameState &mut game_state )
{
	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	var PlayerState &mut player_state= game_state.player;

	if( player_state.energy > 0u /* Allow starting shooting only if alive. */ )
	{
		if( player_input.shot_requested )
		{
			if( player_state.primary_weapon_state.current_weapon == EntitiesDescription::ToolType::Kick )
			{
				// If current weapon is kick - perform kicking using kicking weapon state.
				// This allows to switch to other weapon while performing such kicking.
				TryStartPlayerShooting(
					entities_description,
					EntitiesDescription::ToolType::Kick,
					player_state.kick_weapon_state,
					player_state.inventory );
			}
			else if(
				// Make sure weapon switching is done.
				player_state.primary_weapon_state.weapon_switching_fraction >= c_weapon_switching_half_time_steps )
			{
				TryStartPlayerShooting(
					entities_description,
					player_state.primary_weapon_state.current_weapon,
					player_state.primary_weapon_state.weapon_state,
					player_state.inventory );
			}
		}

		if( player_input.kick_requested )
		{
			TryStartPlayerShooting(
				entities_description,
				EntitiesDescription::ToolType::Kick,
				player_state.kick_weapon_state,
				player_state.inventory );
		}
	}

	if( player_input.inventory_input.requested_weapon != EntitiesDescription::ToolType::None &&
		player_state.energy > 0u /* Allow switching weapons only if alive. */ )
	{
		player_state.primary_weapon_state.requested_weapon= player_input.inventory_input.requested_weapon;
	}

	if( player_state.energy == 0u )
	{
		// In case of death lower the weapon.
		player_state.primary_weapon_state.weapon_state.extra_lowering+= c_weapon_lowering_on_death_speed;
		ust::min_assign( player_state.primary_weapon_state.weapon_state.extra_lowering, 1.0f );
	}
	else
	{
		player_state.primary_weapon_state.weapon_state.extra_lowering= 0.0f;
	}

	// Process shooting logic.
	for( auto mut i= 0u; i < 2u; ++i )
	{
		var EntitiesDescription::ToolType weapon_tool_type=
			( i == 0u ? player_state.primary_weapon_state.current_weapon : EntitiesDescription::ToolType::Kick );

		var PlayerWeaponState &mut weapon_state=
			( i == 0u ? player_state.primary_weapon_state.weapon_state : player_state.kick_weapon_state );

		if( weapon_state.num_active_shooting_steps.empty() )
		{
			continue;
		}

		var u32 num_active_shooting_steps= weapon_state.num_active_shooting_steps.try_deref();
		++weapon_state.num_active_shooting_steps.try_deref();

		var size_type weapon_tool_index( entities_description.tool_type_to_index_map[ size_type( weapon_tool_type ) ] );

		if( weapon_tool_index >= entities_description.tools.size() )
		{
			continue;
		}

		var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

		var bool mut out_of_ammo= false;

		foreach( &shot : tool.shot_data )
		{
			if( u32( shot[1] ) == num_active_shooting_steps )
			{
				// Perform the shot.

				var ust::optional_ref_mut</u32/> mut ammo;

				if( tool.ammo_item >= 0 && size_type( tool.ammo_item ) < entities_description.tools.size() )
				{
					var EntitiesDescription::Tool& ammo_tool= entities_description.tools[ size_type( tool.ammo_item ) ];
					ammo= player_state.inventory[ size_type( ammo_tool.tool_type ) ];
				}

				if( ( ammo.empty() || ammo.try_deref() > 0u ) &&
					player_state.energy > 0u /* Allow shooting only if alive. */ )
				{
					auto [ position, direction ]=
						GetPlayerShotStartAndDirection(
							shot,
							player_state.position,
							player_state.crouching_phase,
							player_input.azimuth,
							player_input.elevation );

					{
						// HACK!
						// Weapon shot positions are for some weapons located too far away from the camera and outside the player's bbox.
						// With such weapons it's possible to shoot through a wall or some other obstacle.
						// The original game allows this.
						// We fix this by performing a line of sight check from an estimated camera position (it's not actual position, since it's Y-shifted)
						// to the shot position.
						// If there is something in the way - cancel this shot.

						var Vec3f view_center(
							 player_state.position.xy(),
							 player_state.position.z + c_camera_z_offset + player_state.crouching_phase * c_crouching_height_delta );

						if( view_center != position )
						{
							if_var( &trace_result :
									LineTrace(
										map_data,
										game_state.broken_quad_bits,
										game_state.dynamic_cluster_colliders,
										view_center,
										position - view_center ) )
							{
								if( trace_result.distance < 1.0f )
								{
									continue; // Line of sight is blocked.
								}
							}
						}
					}

					// Consume ammo only if passed line of sight check.
					if_var( &mut a : ammo )
					{
						debug_assert( a > 0u );
						--a;
					}

					var Vec3f direction_with_random_spread=
						RandomOffsetShotVector( direction, tool.player_weapon_accuracy, game_state.random );

					game_state.projectiles.Insert(
						Projectile
						{
							.weapon_tool_index( weapon_tool_index ),
							.owner_entity_index= c_player_entity_index,
							.age_steps= 0u,
							.position= position,
							.velocity= f32( tool.speed ) * direction_with_random_spread,
						} );

					if( tool.muzzle_flash_model >= 0 )
					{
						game_state.muzzle_flashes.Insert(
							MuzzleFlash
							{
								.model( tool.muzzle_flash_model ),
								.owner_entity_index= c_player_entity_index,
								.relative_position(
									f32( shot[2] ), f32( shot[3] ), f32( shot[4] ) - c_camera_z_offset ),
								.age_steps= 0u,
							} );
					}

					if( tool.light_at_shot[1] > 0u )
					{
						AddMuzzleLight(
							game_state.muzzle_lights,
							MuzzleLight
							{
								.owner_entity_index= c_player_entity_index,
								.relative_position(
									f32( shot[2] ), f32( shot[3] ), f32( shot[4] ) - c_camera_z_offset ),
								.power= f32( tool.light_at_shot[1] ),
								.color_index= tool.light_at_shot[0],
								.age_steps= 0u,
							} );
					}

					if( tool.recoil > 0u )
					{
						player_state.velocity+=
							f32( tool.recoil ) *
							( Vec3f( 0.0f, -1.0f, 0.0f ) *
								Mat4f::MakeRotationX( player_input.elevation ) *
								Mat4f::MakeRotationZ( player_input.azimuth ) );
					}

					// Alarm nearby enemies assuming shooting produces a loud sound which can be heard by them.
					// The only exception is melee weapons.
					if( tool.projectile_kind != EntitiesDescription::Tool::c_projectile_kind_melee )
					{
						AlarmEnemiesByNearbyEvent(
							game_state.colliders,
							game_state.entities,
							position,
							c_player_shot_enemy_alarm_max_distance );
					}

					if( tool.sound >= 0 &&  tool.sound <= 255 )
					{
						EmitShotSound( player_state.sound_source_slots, u8(tool.sound) );
					}
				}
			}
		}

		var u32 cur_num_active_shooting_steps= weapon_state.num_active_shooting_steps.try_deref();

		if( tool.overload != 0u )
		{
			// Messy code created for grenades weapon.
			// All parameters are just guessed.

			var u32 mut first_shot_step= tool.shooting;
			foreach( &shot : tool.shot_data )
			{
				if( shot[1] >= 0 )
				{
					ust::min_assign( first_shot_step, u32( shot[1] ) );
				}
			}

			var u32 lowering_begin= ust::max( 2u, first_shot_step ) - 2u;
			var u32 lowering_end= lowering_begin + 6u;

			var u32 up_movement_begin= ust::min( lowering_end + 16u, tool.shooting - 2u );
			var u32 up_movement_end= tool.shooting - 1u;

			if( cur_num_active_shooting_steps < lowering_begin )
			{
				weapon_state.extra_lowering= 0.0f;
			}
			else if(
				cur_num_active_shooting_steps >= lowering_begin &&
				cur_num_active_shooting_steps < lowering_end )
			{
				weapon_state.extra_lowering=
					f32( cur_num_active_shooting_steps - lowering_begin ) / f32( lowering_end - lowering_begin );
			}
			else if(
				cur_num_active_shooting_steps >= lowering_end &&
				cur_num_active_shooting_steps < up_movement_begin )
			{
				weapon_state.extra_lowering= 1.0f;
			}
			else if(
				cur_num_active_shooting_steps >= up_movement_begin &&
				cur_num_active_shooting_steps < up_movement_end )
			{
				weapon_state.extra_lowering=
					f32( up_movement_end - 1u - cur_num_active_shooting_steps ) /
					f32( up_movement_end - up_movement_begin );
			}
			else
			{
				weapon_state.extra_lowering= 0.0f;
			}
		}

		if( cur_num_active_shooting_steps >= tool.shooting || out_of_ammo || player_state.energy == 0u )
		{
			// Finish shooting.
			weapon_state.num_active_shooting_steps.reset();
			weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::None;
			weapon_state.current_animation_step= 0u;
			weapon_state.extra_lowering= 0.0f;
		}
	}

	if( player_state.primary_weapon_state.weapon_state.num_active_shooting_steps.empty() &&
		player_state.primary_weapon_state.requested_weapon != player_state.primary_weapon_state.current_weapon &&
		player_state.energy > 0u )
	{
		// Perform weapon switching logic (if not shooting right now or if is alive).

		// Check first if we have requiresed weapon.
		// It may be necessary if (somehow) the player loses his weapons during transition.
		// TODO - check also for ammo.
		if( player_state.inventory[ size_type( player_state.primary_weapon_state.requested_weapon ) ] == 0u )
		{
			player_state.primary_weapon_state.requested_weapon= player_state.primary_weapon_state.current_weapon;
		}
		else
		{
			if( player_state.primary_weapon_state.weapon_switching_fraction == 0u )
			{
				player_state.primary_weapon_state.current_weapon= player_state.primary_weapon_state.requested_weapon;
				++player_state.primary_weapon_state.weapon_switching_fraction;
			}
			else
			{
				--player_state.primary_weapon_state.weapon_switching_fraction;
			}
		}
	}
	else
	{
		if( player_state.primary_weapon_state.weapon_switching_fraction < c_weapon_switching_half_time_steps )
		{
			++player_state.primary_weapon_state.weapon_switching_fraction;
		}
	}

	// TODO - tune this.
	var bool walking= player_state.velocity.xy().Length() >= 1.0f;

	PerformFirstPersonWeaponAnimation(
		entities_description,
		player_state.primary_weapon_state.current_weapon,
		walking,
		player_state.primary_weapon_state.weapon_state );

	PerformFirstPersonWeaponAnimation(
		entities_description,
		EntitiesDescription::ToolType::Kick,
		walking,
		player_state.kick_weapon_state );
}

fn TryStartPlayerShooting(
	EntitiesDescription& entities_description,
	EntitiesDescription::ToolType weapon_tool_type,
	PlayerWeaponState &mut weapon_state,
	PlayerInventory& player_inventory )
{
	// Check if we have no shooting active.
	if( !weapon_state.num_active_shooting_steps.empty() )
	{
		return;
	}

	// Initiate shooting.
	var size_type weapon_tool_index( entities_description.tool_type_to_index_map[ size_type( weapon_tool_type ) ] );

	if( weapon_tool_index < entities_description.tools.size() )
	{
		var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

		// Check if has enough ammo for at least one shot, but only for weapons requiring ammo.
		var bool mut has_enough_ammo= true;
		if( tool.ammo_item >= 0 && size_type( tool.ammo_item ) < entities_description.tools.size() )
		{
			var EntitiesDescription::Tool& ammo_tool= entities_description.tools[ size_type( tool.ammo_item ) ];
			has_enough_ammo= player_inventory[ size_type( ammo_tool.tool_type ) ] > 0u;
		}

		if( has_enough_ammo )
		{
			weapon_state.num_active_shooting_steps= 0u;
			weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Shooting;
			weapon_state.current_animation_step= u32( tool.weapon_data[6] );
		}
	}
}

fn PerformFirstPersonWeaponAnimation(
	EntitiesDescription& entities_description,
	EntitiesDescription::ToolType weapon_tool_type,
	bool walking,
	PlayerWeaponState &mut weapon_state )
{
	var size_type weapon_tool_index( entities_description.tool_type_to_index_map[ size_type( weapon_tool_type ) ] );

	if( weapon_tool_index >= entities_description.tools.size() )
	{
		return;
	}

	var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

	// Some stupid (and probably wrong) state machine.
	// If walking - play walking animation. Otherwise play Idle0 and Idle1.
	switch( weapon_state.current_animation )
	{
		PlayerWeaponState::WeaponAnimation::None ->
		{
			if( walking )
			{
				weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Walking;
				weapon_state.current_animation_step= u32( tool.weapon_data[0] );
			}
			else
			{
				weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Idle0;
				weapon_state.current_animation_step= u32( tool.weapon_data[2] );
			}
		},
		PlayerWeaponState::WeaponAnimation::Walking ->
		{
			++weapon_state.current_animation_step;
			if( weapon_state.current_animation_step >= u32( tool.weapon_data[0] + tool.weapon_data[1] ) )
			{
				if( walking )
				{
					weapon_state.current_animation_step= u32( tool.weapon_data[0] );
				}
				else
				{
					weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Idle0;
					weapon_state.current_animation_step= u32( tool.weapon_data[2] );
				}
			}
		},
		PlayerWeaponState::WeaponAnimation::Idle0 ->
		{
			++weapon_state.current_animation_step;
			if( weapon_state.current_animation_step >= u32( tool.weapon_data[2] + tool.weapon_data[3] ) )
			{
				if( walking )
				{
					weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Walking;
					weapon_state.current_animation_step= u32( tool.weapon_data[0] );
				}
				else
				{
					weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Idle1;
					weapon_state.current_animation_step= u32( tool.weapon_data[4] );
				}
			}
		},
		PlayerWeaponState::WeaponAnimation::Idle1 ->
		{
			++weapon_state.current_animation_step;
			if( weapon_state.current_animation_step >= u32( tool.weapon_data[4] + tool.weapon_data[5] ) )
			{
				if( walking )
				{
					weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Walking;
					weapon_state.current_animation_step= u32( tool.weapon_data[0] );
				}
				else
				{
					weapon_state.current_animation= PlayerWeaponState::WeaponAnimation::Idle0;
					weapon_state.current_animation_step= u32( tool.weapon_data[2] );
				}
			}
		},
		PlayerWeaponState::WeaponAnimation::Shooting ->
		{
			++weapon_state.current_animation_step;
		},
	}
}

fn PerformPlayerInventoryLogic(
	EntitiesDescription& entities_description,
	PlayerInventoryInput& player_inventory_input,
	PlayerState &mut player,
	u32 current_step )
{
	if( player.energy == 0u )
	{
		// Don't allow changing selected tool and activate tools in dead stae.
		return;
	}

	var size_type c_num_tools_for_selection= typeinfo</ typeof( c_inventory_accessible_tools ) />.element_count;

	// Reset current tool if it's no longer available.
	if( player.inventory[ size_type( player.tools_state.selected_tool ) ] == 0u )
	{
		player.tools_state.selected_tool = EntitiesDescription::ToolType::None;
	}

	// Select an active tool if has no one.
	if( player.tools_state.selected_tool == EntitiesDescription::ToolType::None )
	{
		foreach( tool : c_inventory_accessible_tools )
		{
			if( player.inventory[ size_type( tool ) ] > 0u )
			{
				player.tools_state.selected_tool= tool;
				break;
			}
		}
	}

	var size_type mut current_index= ~0s;
	for( auto mut i= 0s; i < c_num_tools_for_selection; ++i )
	{
		if( c_inventory_accessible_tools[i] == player.tools_state.selected_tool )
		{
			current_index= i;
			break;
		}
	}

	if( current_index < c_num_tools_for_selection )
	{
		if( player_inventory_input.previous_tool_selection_requested )
		{
			for( auto mut i= 0s; i < c_num_tools_for_selection; ++i )
			{
				var size_type table_index= ( c_num_tools_for_selection * 3s + current_index - 1s - i ) % c_num_tools_for_selection;

				var EntitiesDescription::ToolType tool= c_inventory_accessible_tools[ table_index];
				if( player.inventory[ size_type( tool ) ] > 0u )
				{
					player.tools_state.selected_tool= tool;
					player.tools_state.last_tool_selection_step= current_step;
					break;
				}
			}
		}

		if( player_inventory_input.next_tool_selection_requiested )
		{
			for( auto mut i= 0s; i < c_num_tools_for_selection; ++i )
			{
				var EntitiesDescription::ToolType tool=
					c_inventory_accessible_tools[ ( i + current_index + 1s ) % c_num_tools_for_selection ];
				if( player.inventory[ size_type( tool ) ] > 0u )
				{
					player.tools_state.selected_tool= tool;
					player.tools_state.last_tool_selection_step= current_step;
					break;
				}
			}
		}
	}

	if( player_inventory_input.current_tool_activation_requested )
	{
		switch( player.tools_state.selected_tool )
		{
			EntitiesDescription::ToolType::WeaponA ... EntitiesDescription::ToolType::WeaponJ ->
			{
				if( player.inventory[ size_type( player.tools_state.selected_tool ) ] > 0u )
				{
					player.primary_weapon_state.requested_weapon= player.tools_state.selected_tool;
				}
			},
			EntitiesDescription::ToolType::HealthPack ->
			{
				var u32 max_energy= GetPlayerStartEnergy( entities_description );

				var u32 energy_needed= ust::max( max_energy, player.energy ) - player.energy;

				var u32 &mut inventory_energy= player.inventory[ size_type( EntitiesDescription::ToolType::HealthPack ) ];

				var u32 energy_transfer= ust::min( energy_needed, inventory_energy );

				player.energy+= energy_transfer;
				inventory_energy-= energy_transfer;
			},
			EntitiesDescription::ToolType::Armor ->
			{
				var u32 max_armor= GetPlayerMaxArmor( entities_description );

				var u32 armor_needed= ust::max( max_armor, player.armor ) - player.armor;

				var u32 &mut inventory_armor= player.inventory[ size_type( EntitiesDescription::ToolType::Armor ) ];

				var u32 armor_transfer= ust::min( armor_needed, inventory_armor );

				player.armor+= armor_transfer;
				inventory_armor-= armor_transfer;
			},
			EntitiesDescription::ToolType::AcidProtectionSuit ->
			{
				ProcessAcidProtectionToolActivationRequest( player );
			},
			EntitiesDescription::ToolType::NightVision ->
			{
				ProcesNightVisionToolActivationRequest( player );
			},
			EntitiesDescription::ToolType::InfraredVision ->
			{
				ProcesInfraredVisionToolActivationRequest( player );
			},
			EntitiesDescription::ToolType::Flashlight ->
			{
				ProcesFlashlightToolActivationRequest( player );
			},
			default -> {},
		}
	}

	if( player_inventory_input.acid_protection_suit_activation_requested )
	{
		ProcessAcidProtectionToolActivationRequest( player );
	}
	if( player_inventory_input.night_vision_activation_requested )
	{
		ProcesNightVisionToolActivationRequest( player );
	}
	if( player_inventory_input.infrared_vision_activation_requested )
	{
		ProcesInfraredVisionToolActivationRequest( player );
	}
	if( player_inventory_input.flashlight_activation_requested )
	{
		ProcesFlashlightToolActivationRequest( player );
	}
}

fn ProcessAcidProtectionToolActivationRequest( PlayerState &mut player )
{
	if( player.tools_state.acid_protection_suit_is_active )
	{
		player.tools_state.acid_protection_suit_is_active= false;
	}
	else if( player.inventory[ size_type( EntitiesDescription::ToolType::AcidProtectionSuit ) ] > 0u )
	{
		player.tools_state.acid_protection_suit_is_active= true;
	}
}

fn ProcesNightVisionToolActivationRequest( PlayerState &mut player )
{
	if( player.tools_state.night_vision_is_active )
	{
		player.tools_state.night_vision_is_active= false;
	}
	else if( player.inventory[ size_type( EntitiesDescription::ToolType::NightVision ) ] > 0u )
	{
		player.tools_state.night_vision_is_active= true;
		player.tools_state.infrared_vision_is_active= false; // Don't allow turning both night and infrared vision on.
	}
}

fn ProcesInfraredVisionToolActivationRequest( PlayerState &mut player )
{
	if( player.tools_state.infrared_vision_is_active )
	{
		player.tools_state.infrared_vision_is_active= false;
	}
	else if( player.inventory[ size_type( EntitiesDescription::ToolType::InfraredVision ) ] > 0u )
	{
		player.tools_state.infrared_vision_is_active= true;
		player.tools_state.night_vision_is_active= false; // Don't allow turning both night and infrared vision on.
	}
}

fn ProcesFlashlightToolActivationRequest( PlayerState &mut player )
{
	if( player.tools_state.flashlight_is_active )
	{
		player.tools_state.flashlight_is_active= false;
	}
	else if( player.inventory[ size_type( EntitiesDescription::ToolType::Flashlight ) ] > 0u )
	{
		player.tools_state.flashlight_is_active= true;
	}
}

fn UpdatePlayerActiveTools( PlayerState &mut player, u32 step_index )
{
	// Tools which can be activated have amount specified in (presumably) seconds.
	// Decrease their amount only once in a second.
	// This approach allows sometimes activating a tool for a short time without consuming it, but it's fine.

	if( step_index % u32( c_steps_per_second ) != 0u )
	{
		return;
	}

	if( player.tools_state.acid_protection_suit_is_active )
	{
		var u32 &mut amount= player.inventory[ size_type( EntitiesDescription::ToolType::AcidProtectionSuit ) ];
		if( amount == 0u )
		{
			player.tools_state.acid_protection_suit_is_active= false;
		}
		else
		{
			--amount;
			if( amount == 0u )
			{
				player.tools_state.acid_protection_suit_is_active= false;
			}
		}
	}

	if( player.tools_state.night_vision_is_active )
	{
		var u32 &mut amount= player.inventory[ size_type( EntitiesDescription::ToolType::NightVision ) ];
		if( amount == 0u )
		{
			player.tools_state.night_vision_is_active= false;
		}
		else
		{
			--amount;
			if( amount == 0u )
			{
				player.tools_state.night_vision_is_active= false;
			}
		}
	}

	if( player.tools_state.infrared_vision_is_active )
	{
		var u32 &mut amount= player.inventory[ size_type( EntitiesDescription::ToolType::InfraredVision ) ];
		if( amount == 0u )
		{
			player.tools_state.infrared_vision_is_active= false;
		}
		else
		{
			--amount;
			if( amount == 0u )
			{
				player.tools_state.infrared_vision_is_active= false;
			}
		}
	}

	if( player.tools_state.flashlight_is_active )
	{
		var u32 &mut amount= player.inventory[ size_type( EntitiesDescription::ToolType::Flashlight ) ];
		if( amount == 0u )
		{
			player.tools_state.flashlight_is_active= false;
		}
		else
		{
			--amount;
			if( amount == 0u )
			{
				player.tools_state.flashlight_is_active= false;
			}
		}
	}
}

fn PerformPlayerMovement(
	GameGlobalData& global_data, GameMapData& map_data, PlayerInput& player_input, GameState &mut game_state )
{
	game_state.player.azimuth= player_input.azimuth;

	// Remove player collider before moving the player - to avoid self-collisions.
	RemovePlayerCollider( game_state );

	var Vec3f movement_start_position= game_state.player.position;

	if( game_state.player.energy > 0u )
	{
		ApplyPlayerUnclippedMovement(
			global_data,
			game_state.player,
			player_input.move_wish_vector,
			player_input.jump_requested );
	}
	else
	{
		// If the player is dead - apply unclipped movement, but with controls disabled.
		// Gravity and deceleration should be still applied.
		ApplyPlayerUnclippedMovement(
			global_data,
			game_state.player,
			Vec3f::MakeZero(),
			false );
	}

	var Vec3f movement_end_position= game_state.player.position;

	if( game_state.player.noclip )
	{
		return;
	}

	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	var BBox3f player_bbox= GetPlayerColliderBBox( entities_description, game_state.player.crouching_phase );

	var CollisionStepMoveResult move_result=
		CollisionStepMove(
			map_data,
			game_state.broken_quad_bits,
			game_state.dynamic_cluster_colliders,
			game_state.colliders,
			player_bbox,
			movement_start_position,
			movement_end_position );

	if( move_result.ground_planes_mask != 0u )
	{
		var f32 horizontal_distance_walked_in_this_logic_step=
			( move_result.trace_clip_result.position_clipped.xy() - movement_start_position.xy() ).Length();

		HandlePlayerWalking(
			game_state.player,
			horizontal_distance_walked_in_this_logic_step,
			GetGroundMaterialPropertiesForMoveResult( global_data, map_data, move_result ) );
	}

	if( move_result.step_z_delta < 0.0f )
	{
		// A tricky way to avoid sudden jump in camera hight when performing steps climbing.
		// Crouch a little bit after performed a step movement,
		// so that full player hight will be restored in next several steps.
		// This approach works well for the most cases.
		// It doesn't work well with long staircases with too short steps, when full crouching can be reached in several steps.
		// It doesn't work at all if the player is already crouching.
		// But regardless of these edge cases use this approach, since it still gives good enough result for many staircases.

		game_state.player.crouching_phase+= move_result.step_z_delta / ( -c_crouching_height_delta );
		ust::min_assign( game_state.player.crouching_phase, 1.0f );
	}

	game_state.player.position= move_result.trace_clip_result.position_clipped;
	game_state.player.on_ground= move_result.ground_planes_mask != 0u;

	var f32 mut ground_friction= 0.0f;

	for( auto mut i= 0u; i < move_result.trace_clip_result.num_collision_events; ++i )
	{
		var CollisionTraceClipResult::CollisionEvent& collision_event= move_result.trace_clip_result.collision_events[i];

		// Clip player's velocity using clip planes of collision result.
		ClampPlayerVelocity( game_state.player, collision_event.plane_normal );

		if( ( move_result.ground_planes_mask & ( 1u << i ) ) != 0u )
		{
			// Use maximum friction of all ground quads.
			ust::max_assign(
				ground_friction,
				GetFrictionForMapQuad( global_data, map_data, collision_event.collision_quad_index ) );
		}
	}

	if( move_result.ground_planes_mask == 0u )
	{
		// A hack for cases if the player is stuck between two almost vertical planes.
		// If we detect such case, assume that the player is still on ground and thus can jump and move with ground acceleration.
		// Assume that it's technically possible to jump from such tight corner.
		// It's especially needed for map 6, where it's possible to stuch between rails.
		//
		for( auto mut i= 0u; i < move_result.trace_clip_result.num_collision_events; ++i )
		{
			for( auto mut j= i + 1u; j < move_result.trace_clip_result.num_collision_events; ++j )
			{
				var CollisionTraceClipResult::CollisionEvent& collision_event_i=
					move_result.trace_clip_result.collision_events[i];
				var CollisionTraceClipResult::CollisionEvent& collision_event_j=
					move_result.trace_clip_result.collision_events[j];

				var Vec3f& normal_i= collision_event_i.plane_normal;
				var Vec3f& normal_j= collision_event_j.plane_normal;

				if( ( normal_i.z < 0.0f && normal_j.z <= 0.0f ) || ( normal_i.z <= 0.0f && normal_j.z < 0.0f ) )
				{
					var Vec2f normal_i_xy= normal_i.xy();
					var Vec2f normal_j_xy= normal_j.xy();
					var f32 lengths_square_product= normal_i_xy.SquareLength() * normal_j_xy.SquareLength();
					if( lengths_square_product > 0.0f )
					{
						var f32 angle_cos= normal_i_xy.Dot( normal_j_xy ) / ust::sqrt( lengths_square_product );
						if( angle_cos < -c_half_sqrt_2 )
						{
							game_state.player.on_ground= true;

							ClampPlayerVelocity( game_state.player, Vec3f( 0.0f, 0.0f, -1.0f ) );

							ust::max_assign(
								ground_friction,
								GetFrictionForMapQuad( global_data, map_data, collision_event_i.collision_quad_index ) );
							ust::max_assign(
								ground_friction,
								GetFrictionForMapQuad( global_data, map_data, collision_event_j.collision_quad_index ) );
						}
					}
				}
			}
		}
	}

	game_state.player.ground_friction= ground_friction;

	if( player_input.crouching_requested ||
		// If the player is dead activate crouching too - to simulate falling.
		game_state.player.energy == 0u )
	{
		game_state.player.crouching_phase+= c_crouching_transition_speed;
		ust::min_assign( game_state.player.crouching_phase, 1.0f );
	}
	else
	{
		if( game_state.player.crouching_phase > 0.0f )
		{
			// Check if has enough room above the head to stay.
			var Vec3f head_up_movement_vector(
				0.0f,
				0.0f,
				-c_crouching_height_delta * c_crouching_transition_speed - 0.125f );

			var TraceCollisionResult head_up_trace_result=
				CollisionTrace(
					map_data,
					game_state.broken_quad_bits,
					game_state.dynamic_cluster_colliders,
					game_state.colliders,
					player_bbox,
					game_state.player.position,
					head_up_movement_vector );

			// For simplicity don't care if can move the head up a little bit.
			// If can't move the whole crouching transition step at all, remain in current crouching phase.

			if( head_up_trace_result.clipped_move_distance >= 1.0f )
			{
				game_state.player.crouching_phase-= c_crouching_transition_speed;
				ust::max_assign( game_state.player.crouching_phase, 0.0f );
			}
		}
	}

	// After the player was moved, add his collider back.
	AddPlayerCollider( map_data.entities_description.deref(), game_state );

	// Check if in liquid.
	var Vec3f player_center_position= game_state.player.position + ( player_bbox.min + player_bbox.max ) * 0.5f;

	var bool new_in_liquid= IsPointInLiquid( map_data, player_center_position );

	if( new_in_liquid & !game_state.player.in_liquid )
	{
		// TODO - emit different sounds if entering not water but acid or lava.
		EmitPlayerWaterEnteringSound( global_data.sounds_description.deref(), game_state.player.sound_source_slots );
	}
	if( !new_in_liquid & game_state.player.in_liquid )
	{
		// TODO - add a timeout for this sound - don't emit if if was in liquid only a fraction of a second.
		EmitPlayerWaterLeavingSound( global_data.sounds_description.deref(), game_state.player.sound_source_slots );
	}

	game_state.player.in_liquid= new_in_liquid;

	// Water leaving logic.
	// If the player is in water (but not staying on bottom), slightly above has air,
	// wishes to move upowards and has a collision with a wall -
	// set vertical velocity to some large value, enough to perform jumping out of the water volume.
	if( game_state.player.in_liquid &&
		!game_state.player.on_ground &&
		player_input.move_wish_vector.z < 0.0f )
	{
		var bool mut has_wall_collision= false;
		for( auto mut i= 0u; i < move_result.trace_clip_result.num_collision_events; ++i )
		{
			// TODO - maybe check for slightly non-vertical walls?
			has_wall_collision|= move_result.trace_clip_result.collision_events[i].plane_normal.z == 0.0f;
		}

		if( has_wall_collision &&
			!IsPointInLiquid( map_data, player_center_position + Vec3f( 0.0f, 0.0f, -4.0f ) ) )
		{
			// Set vertical velocity, not add it.
			// Do this to ensure that the jump height is not too small and too heigh.
			game_state.player.velocity.z= c_water_jump_vertical_velocity;
		}
	}

	// Find possible collisions with projectiles caused by player movement.
	// It isn't fully correct to use straight movement form old position to new one,
	// since actual movement including clipping may be a little bit more complex.
	// But it's mostly fine.
	CollideMovedEntityWithProjectiles(
		movement_start_position,
		game_state.player.position,
		player_bbox,
		c_player_entity_index,
		game_state.projectiles,
		game_state.projectile_hit_events );
}

fn ApplyPlayerUnclippedMovement(
	GameGlobalData& global_data,
	PlayerState &mut player_state,
	Vec3f& move_wish_direction,
	bool jump_requested )
{
	var f32 crouching_related_movement_scale= 1.0f - 0.6f * player_state.crouching_phase;

	// Max player speed is defined via the game config.
	// Make it smaller if crouching.
	var f32 max_horizontal_speed_per_step=
		f32( global_data.game_params.deref().max_player_speed ) * crouching_related_movement_scale;

	// Acceleration depends on friction. Scale is for now just guessed.
	// Acceleration is twice as big as deceleration, it's needed because deceleration is always applied.
	var f32 friction_acceleration_scale= 0.5f;
	var f32 horizontal_deceleation_per_step= friction_acceleration_scale * player_state.ground_friction;
	var f32 horizontal_acceleration_per_step= horizontal_deceleation_per_step * 2.0f;

	var f32 azimuth_cos= ust::cos( player_state.azimuth );
	var f32 azimuth_sin= ust::sin( player_state.azimuth );

	var Vec3f forward_vector( -azimuth_sin, azimuth_cos, 0.0f );
	var Vec3f right_vector( azimuth_cos, azimuth_sin, 0.0f );
	var Vec3f down_vector( 0.0f, 0.0f, 1.0f );

	if( player_state.noclip )
	{
		// Some arbitrary scaler for nice fast noclip flight.
		var f32 max_noclip_horizontal_speed_per_step= max_horizontal_speed_per_step * 3.0f;

		var f32 noclip_acceleration_per_step= 2.0f;
		var f32 noclip_deceleration_per_step= 1.0f;

		var Vec3f move_vector_transformed=
			move_wish_direction.x * forward_vector +
			move_wish_direction.y * right_vector +
			move_wish_direction.z * down_vector;

		player_state.velocity+= move_vector_transformed * noclip_acceleration_per_step;

		var f32 speed= player_state.velocity.Length();
		if( speed > 0.0f )
		{
			var f32 new_speed= speed - noclip_deceleration_per_step;
			var f32 new_speed_clamped= ust::max( 0.0f, ust::min( new_speed, max_noclip_horizontal_speed_per_step ) );
			player_state.velocity*= new_speed_clamped / speed;
		}
	}
	else if( player_state.in_liquid )
	{
		// Deceleration in liquid is propertional to current speed.
		var f32 liquid_decelration_per_step_speed_factor= 15.0f / 16.0f;

		// Acceleration should be derived from deceleration and max speed.
		var f32 liquid_acceleration_per_step=
			max_horizontal_speed_per_step *
			( 1.0f - liquid_decelration_per_step_speed_factor );

		var f32 liquid_gravity_scale= 1.0f / 16.0f;
		var f32 liquid_jump_velocity_scale= 0.5f;

		// Perform swimming-based acceleration.
		var Vec3f move_vector_transformed=
			move_wish_direction.x * forward_vector +
			move_wish_direction.y * right_vector +
			move_wish_direction.z * down_vector;

		player_state.velocity+= move_vector_transformed * liquid_acceleration_per_step;

		// Apply less gravity acceleration in liquid compared to air (because of buoyancy counter-force).
		player_state.velocity.z+= c_gravity_per_step * liquid_gravity_scale;

		if( player_state.on_ground )
		{
			// If staying on ground, perform additional walking-based acceleration.
			var Vec3f move_vector_transformed=
				move_wish_direction.x * forward_vector +
				move_wish_direction.y * right_vector;

			player_state.velocity+= move_vector_transformed * ( horizontal_acceleration_per_step * liquid_gravity_scale );

			// Allow jumping while standing on bottom, but with less power.
			if( jump_requested )
			{
				player_state.velocity.z+=
					c_jump_vertical_velocity_add * liquid_jump_velocity_scale * crouching_related_movement_scale;

				EmitPlayerJumpSound( global_data.sounds_description.deref(), player_state.sound_source_slots );
			}

			// Apply ground deceleration.
			var Vec2f mut horizontal_velocity= player_state.velocity.xy();
			var f32 speed= horizontal_velocity.Length();
			if( speed > 0.0f )
			{
				var f32 deceleration= horizontal_deceleation_per_step * liquid_gravity_scale;
				var f32 new_speed= speed - deceleration;
				var f32 new_speed_clamped= ust::max( 0.0f, ust::min( new_speed, max_horizontal_speed_per_step ) );
				horizontal_velocity*= new_speed_clamped / speed;
				player_state.velocity.x= horizontal_velocity.x;
				player_state.velocity.y= horizontal_velocity.y;
			}
		}

		// Apply liquid deceleration.
		player_state.velocity*= liquid_decelration_per_step_speed_factor;
	}
	else
	{
		// Allow only a little bit acceleration while in air.
		var f32 constexpr horizontal_air_acceleration_per_step= 0.2f;
		// Apply fast no deceleration while in air.
		var f32 constexpr horizontal_air_deceleation_per_step= 0.05f;

		var Vec3f move_vector_transformed=
			move_wish_direction.x * forward_vector +
			move_wish_direction.y * right_vector;

		player_state.velocity+=
			move_vector_transformed *
			( player_state.on_ground ? horizontal_acceleration_per_step : horizontal_air_acceleration_per_step );

		player_state.velocity.z+= c_gravity_per_step;

		if( jump_requested && player_state.on_ground )
		{
			player_state.velocity.z+= c_jump_vertical_velocity_add * crouching_related_movement_scale;

			EmitPlayerJumpSound( global_data.sounds_description.deref(), player_state.sound_source_slots );
		}

		{
			// Apply horizontal deceleration and limit horizontal speed if necessary.
			var Vec2f mut horizontal_velocity= player_state.velocity.xy();
			var f32 speed= horizontal_velocity.Length();
			if( speed > 0.0f )
			{
				var f32 deceleration= ( player_state.on_ground ? horizontal_deceleation_per_step : horizontal_air_deceleation_per_step );
				var f32 new_speed= speed - deceleration;
				var f32 new_speed_clamped= ust::max( 0.0f, ust::min( new_speed, max_horizontal_speed_per_step ) );
				horizontal_velocity*= new_speed_clamped / speed;
				player_state.velocity.x= horizontal_velocity.x;
				player_state.velocity.y= horizontal_velocity.y;
			}
		}

		// Limit vertical speed if necessary.
		ust::min_assign( player_state.velocity.z,  c_max_vertical_speed );
		ust::max_assign( player_state.velocity.z, -c_max_vertical_speed );
	}

	player_state.position+= player_state.velocity;
}

fn HandlePlayerWalking(
	PlayerState &mut player_state,
	f32 horizontal_distance_walked_in_this_logic_step,
	ust::optional_ref_imut</MaterialProperties/> material_properties_opt )
{
	var f32 prev_distance= player_state.horizontal_distance_walked;
	player_state.horizontal_distance_walked+= horizontal_distance_walked_in_this_logic_step;
	var f32 cur_distance= player_state.horizontal_distance_walked;

	if_var( &material_properties : material_properties_opt )
	{
		// This value was tuned so that footstep sounds are synchronized with walking animations of many (but not all) weapons.
		var f32 c_step_length= 128.0f;

		var u32 prev_steps( prev_distance / c_step_length );
		var u32 cur_steps( cur_distance / c_step_length );

		for( auto mut step= prev_steps; step < cur_steps; ++step )
		{
			EmitFootstepSound( material_properties, step, player_state.sound_source_slots );

			// TODO - spawn here footstep decals if necessary.
		}
	}
}

fn GetGroundMaterialPropertiesForMoveResult(
	GameGlobalData& global_data,
	GameMapData& map_data,
	CollisionStepMoveResult& move_result )
		: ust::optional_ref_imut</MaterialProperties/> @( ust::reference_notation::return_inner_references::param0 )
{
	for( auto mut i= 0u; i < move_result.trace_clip_result.num_collision_events; ++i )
	{
		if( ( move_result.ground_planes_mask & ( 1u << i ) ) != 0u )
		{
			var u32 quad_index= move_result.trace_clip_result.collision_events[i].collision_quad_index;
			if( quad_index != ~0u )
			{
				return GetMaterialPropertiesForMapQuad( global_data, map_data, quad_index );
			}
			else
			{
				// TODO - maybe use default material if ground plane belongs to a non-map object (entity)?
			}
		}
	}

	return ust::null_optional_ref;
}

fn GetFrictionForMapQuad( GameGlobalData& global_data, GameMapData& map_data, u32 quad_index ) : f32
{
	return f32( GetMaterialPropertiesForMapQuad( global_data, map_data, quad_index ).player_step_friction );
}

fn GetMaterialPropertiesForMapQuad(
	GameGlobalData& global_data, GameMapData& map_data, u32 quad_index )
		: MaterialProperties & @( ust::reference_notation::return_references::param0 )
{
	var MaterialsProperties& materials_properties= global_data.materials_properties.deref();
	var MaterialProperties& default_properties= materials_properties.front();

	var ZmapData& zmap_data= map_data.zmap_data.deref();

	if( size_type( quad_index ) >= zmap_data.quads.size() )
	{
		return default_properties;
	}

	var ZmapQuad& quad= zmap_data.quads[ size_type( quad_index ) ];

	var MapsDescription& maps_description= global_data.maps_description.deref();

	if( size_type( map_data.map_index ) < maps_description.maps.size() )
	{
		var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type( map_data.map_index ) ];

		if_var( &materials_block : global_data.materials_description.deref().blocks.find( map_description.materials_block ) )
		{
			var size_type constexpr num_materials_in_texture=
				size_type( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y );

			var size_type mut material_index( quad.texture_id );

			if( material_index >= materials_block.textures.size() * num_materials_in_texture )
			{
				// Find actual material index for a special material.
				for( auto mut j= 0s; j < typeinfo</MaterialsDescription::SpecialMaterial/>.element_count; ++j )
				{
					if( u32( quad.texture_id ) == MaterialsDescription::c_special_material_texture_indices[j] )
					{
						material_index= size_type( materials_block.special_material_indices[j] );
						break;
					}
				}
			}

			var size_type texture_index= material_index / num_materials_in_texture;
			if( texture_index < materials_block.textures.size() )
			{
				var MaterialsDescription::Texture& texture= materials_block.textures[ texture_index ];
				var size_type tile_index= material_index % num_materials_in_texture;
				var ust::string8& material_name= texture.materials[ tile_index ];

				foreach( &material_properties : materials_properties )
				{
					if( material_properties.name == material_name )
					{
						return material_properties;
					}
				}
			}
		}
	}

	return default_properties;
}

fn IsMapQuadBreakable( GameGlobalData& global_data, GameMapData& map_data, ZmapQuad& quad ) : bool
{
	if( u32( quad.texture_id ) ==
		MaterialsDescription::c_special_material_texture_indices[ size_type( MaterialsDescription::SpecialMaterial::Glass ) ] )
	{
		return true;
	}

	var MapsDescription& maps_description= global_data.maps_description.deref();

	if( size_type( map_data.map_index ) < maps_description.maps.size() )
	{
		var MapsDescription::MapDescription& map_description= maps_description.maps[ size_type( map_data.map_index ) ];

		if_var( &materials_block : global_data.materials_description.deref().blocks.find( map_description.materials_block ) )
		{
			var size_type constexpr num_materials_in_texture=
				size_type( MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y );

			var size_type material_index( quad.texture_id );

			var size_type texture_index= material_index / num_materials_in_texture;
			if( texture_index < materials_block.textures.size() )
			{
				var MaterialsDescription::Texture& texture= materials_block.textures[ texture_index ];
				var size_type tile_index= material_index % num_materials_in_texture;
				var ust::string8& material_name= texture.materials[ tile_index ];

				foreach( &material_properties : global_data.materials_properties.deref() )
				{
					if( material_properties.name == material_name )
					{
						return material_properties.fragile;
					}
				}
			}
		}
	}

	return false;
}

fn TriggerEntitiesSpawn( GameMapData& map_data, GameState &mut game_state )
{
	// Spawn enemies behind the player's back.

	if( size_type( game_state.player.collider_index ) >= game_state.colliders.size() )
	{
		return;
	}

	if( game_state.player.energy == 0u )
	{
		return; // Dead player can't trigger entities spawn.
	}

	var BBox3f player_bbox= game_state.colliders[ size_type( game_state.player.collider_index ) ].bbox;

	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	var ZpozData& zpoz_data= map_data.zpoz_data.deref();

	var ust::array_view_imut</ZpozEntity/> zpoz_entities= zpoz_data.entities;

	for( var size_type mut i= 0s, i_end= ust::min( zpoz_entities.size(), game_state.entities.size() ); i < i_end; ++i )
	{
		if( !game_state.entities[i].empty() )
		{
			// Already spawned this entity.
			continue;
		}

		var ZpozEntity& in_entity= zpoz_entities[i];

		if( in_entity.alive_flag == 0u16 )
		{
			continue;
		}

		var size_type navigation_info_index( in_entity.data[16] );
		if( navigation_info_index >= zpoz_data.entity_navigation_infos.size() )
		{
			// No navigation info and thus spawn trigger is present.
			continue;
		}

		var ZpozEntityNavigationInfo& navigation_info= zpoz_data.entity_navigation_infos[ navigation_info_index ];

		if( navigation_info.spawn_trigger_is_present == 0u )
		{
			continue;
		}

		var BBox3f spawn_trigger_bbox
		{
			.min(
				f32( navigation_info.spawn_trigger_box_center[0] - navigation_info.spawn_trigger_box_half_size[0] ),
				f32( navigation_info.spawn_trigger_box_center[1] - navigation_info.spawn_trigger_box_half_size[1] ),
				f32( navigation_info.spawn_trigger_box_center[2] - navigation_info.spawn_trigger_box_half_size[2] ) ),
			.max(
				f32( navigation_info.spawn_trigger_box_center[0] + navigation_info.spawn_trigger_box_half_size[0] ),
				f32( navigation_info.spawn_trigger_box_center[1] + navigation_info.spawn_trigger_box_half_size[1] ),
				f32( navigation_info.spawn_trigger_box_center[2] + navigation_info.spawn_trigger_box_half_size[2] ) ),
		};

		if( !player_bbox.InstersectsOrTouches( spawn_trigger_bbox ) )
		{
			continue;
		}

		if( size_type( in_entity.kind ) >= entities_description.entities.size() )
		{
			continue;
		}

		var EntitiesDescription::EntityDescription& entity_description=
			entities_description.entities[ size_type( in_entity.kind ) ];

		if( size_type( c_start_operation ) >= entity_description.operations.size() )
		{
			continue;
		}

		game_state.entities[i]=
			EntityState
			{
				.kind( in_entity.kind ),
				.position( f32( in_entity.position[0] ), f32( in_entity.position[1] ), f32( in_entity.position[2] ) ),
				.azimuth( Convert1024Angle( f32( in_entity.data[4] ) ) ),
				.energy= entity_description.energy,
				.ammo= entity_description.ammunition,
				.current_operation= c_start_operation,
				.num_steps_since_operation_start= 0u,
				.navigation_info_index( navigation_info_index ),
				.alarmed= true, // Spawn triggered entities in alarmed state.
				.player_is_in_sight= false,
				.lost_energy_in_current_operation= false,
				.animation_frame= 0u, // Set later.
				.directional_animation_frame= 0u, // Set later.
				.velocity_z= 0.0f,
				.collider_index= ~0u,
			};

		with( &mut entity : game_state.entities[i].try_deref() )
		{
			// Emit a sound if spawning an entity in state requiring such sound.
			if_var( &sound : entity_description.operations[ size_type( entity.current_operation ) ].sound )
			{
				if( sound.sound_index <= 255u )
				{
					EmitSound( entity.sound_source_slots, u8( sound.sound_index ), sound.power );
				}
			}
		}

		AddEntityCollider( entities_description, i, game_state );
	}
}

struct DelayedExplosionSplashDamage
{
	Vec3f center;
	f32 radius;
	f32 splash_base_damage;
}

fn ProcessEntitiesLogicStep(
	GameGlobalData& game_global_data,
	GameMapData& map_data,
	GameState &mut game_state,
	RouteSearchContext &mut route_search_context )
{
	var GameParams& game_params= game_global_data.game_params.deref();
	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	// Use index-based loop to be able to insert entities.
	for( auto mut entity_index= 0s; entity_index < game_state.entities.size(); ++entity_index )
	{
		if( game_state.entities[entity_index].empty() )
		{
			continue;
		}

		// Remove entity from colliders list before processing collisions - to avoid colliding with itself.
		RemoveEntityCollider( entity_index, game_state );

		var bool mut need_to_remove_entity= false;
		var ust::optional</EntityState/> mut new_spawned_entity;

		// Memorize possible explosion damage event to apply it later.
		// It's needed, since we can't iterate over entities and apply damage for other entities in the same time.
		var ust::optional</DelayedExplosionSplashDamage/> mut delayed_explosion_splash_damage;

		// Memorize possible shot alarm event to apply it later.
		// It's needed, since we can't iterate over entities and modify other entities in the same time.
		var ust::optional</DelayedShotAlarm/> mut delayed_shot_alarm;

		{
			var EntityState &mut entity= game_state.entities[entity_index].try_deref();

			var ust::optional_ref_mut</EntityNavigationState/> mut entity_navigation_state_opt;
			if( size_type( entity.navigation_info_index ) < game_state.entity_navigation_states.size() )
			{
				entity_navigation_state_opt=
					game_state.entity_navigation_states[ size_type( entity.navigation_info_index ) ];
			}

			var EntitiesDescription::EntityDescription& entity_description=
				entities_description.entities[ size_type( entity.kind ) ];

			// Check for player visibility only on even steps for even entities and on odd steps for odd entities.
			// Such sparse update is needed, since this calculation are costly.
			// Doing this only each second step isn't that problematic, it means only that enemies react slightly slower.
			if( ( entity_index & 1s ) == ( size_type( game_state.step_index ) & 1s ) )
			{
				UpdateEntityPlayerInSightFlag(
					map_data,
					game_state.broken_quad_bits,
					game_state.dynamic_cluster_colliders,
					entity_description,
					entity,
					game_state.player );
			}

			// For now update movement target each step.
			// It's necessary to select new target just afer reaching the old one.
			if_var( &mut entity_navigation_state : entity_navigation_state_opt )
			{
				UpdateEntityMovementTarget(
					map_data,
					game_state.broken_quad_bits,
					game_state.dynamic_cluster_colliders,
					route_search_context,
					entity_description,
					entity,
					entity_navigation_state,
					game_state.random,
					game_state.step_index );
			}

			if( entity.player_is_in_sight )
			{
				// Go to alarmed state if saw the player at least once.
				entity.alarmed= true;
			}

			// Perform operation transition (if necessary).
			var u32 mut next_operation= ~0u;

			{
				var EntitiesDescription::Operation& operation=
					entity_description.operations[ size_type( entity.current_operation ) ];

				// TODO - determine exact priorities of different operation transition conditions.

				if_var( &operation_control : operation.operation_control )
				{
					// Always check if damaged or killed.
					// Keep it first here (killed enemies should die).
					// TODO - check if we need some delay.
					if_var( &energy_loss : operation_control.energy_loss )
					{
						if( entity.lost_energy_in_current_operation )
						{
							if( entity.energy == 0u )
							{
								next_operation= u32( energy_loss[2] );
							}
							else
							{
								var bool can_use0=
									energy_loss[0] >= 0 &&
									size_type( energy_loss[0] ) < entity_description.operations.size() &&
									energy_loss[0] != i32( entity.current_operation );

								var bool can_use1=
									energy_loss[1] >= 0 &&
									size_type( energy_loss[1] ) < entity_description.operations.size() &&
									energy_loss[1] != i32( entity.current_operation );

								if( can_use0 && can_use1 )
								{
									next_operation= u32( energy_loss[ game_state.random.Next() & 1u ] );
								}
								else if( can_use0 )
								{
									next_operation= u32( energy_loss[0] );
								}
								else if( can_use1 )
								{
									next_operation= u32( energy_loss[1] );
								}
							}
						}
					}

					if( next_operation == ~0u )
					{
						if_var( &player_visible : operation_control.player_visible )
						{
							if( entity.alarmed )
							{
								next_operation= u32( player_visible[2] );
								// TODO - process delay properly.
							}
						}
					}
					if( next_operation == ~0u )
					{
						if_var( &inside_shooting_zone_a : operation_control.inside_shooting_zone_a )
						{
							if( entity.player_is_in_sight && // Attack only if the player is visible.
								entity.ammo > 0u && // Attack only if has ammo.
								game_state.player.energy > 0u /* Attack only if the player is alive. */ )
							{
								var u32 period( inside_shooting_zone_a[0] );
								if( period != 0u && entity.num_steps_since_operation_start % period == 0u )
								{
									if_var( &target_position : entity.last_seen_player_position )
									{
										// Perform melee atack if the target is in attack range.
										var f32 max_distance= f32( entity_description.direct_contact );
										if( ( target_position - entity.position ).SquareLength() <=
											max_distance * max_distance )
										{
											next_operation= inside_shooting_zone_a[2];
										}
									}
								}
							}
						}
					}
					if( next_operation == ~0u )
					{
						if_var( &inside_shooting_zone_b : operation_control.inside_shooting_zone_b )
						{
							// TODO - check what else condition is necessary.
							// Maybe add some random element?
							if( entity.player_is_in_sight && // Attack only if the player is visible.
								entity.ammo > 0u && // Attack only if has ammo.
								game_state.player.energy > 0u /* Attack only if the player is alive. */ )
							{
								var u32 period( inside_shooting_zone_b[0] );
								if( period != 0u && entity.num_steps_since_operation_start % period == 0u )
								{
									next_operation= inside_shooting_zone_b[2];
								}
							}
						}
					}
					if( next_operation == ~0u )
					{
						if_var( &convenient_position : operation_control.convenient_position )
						{
							// Assume player should be visible and be in optimal distance to trigger this state transition.

							if( entity.player_is_in_sight && // Attack only if the player is visible.
								entity.ammo > 0u && // Attack only if has ammo.
								game_state.player.energy > 0u && // Attack only if the player is alive.
								entity.num_steps_since_operation_start == convenient_position[0] )
							{
								if_var( &player_position : entity.last_seen_player_position )
								{
									var f32 square_distance= ( player_position - entity.position ).SquareLength();
									var EntityDistanceRange optimal_range= GetEntityDistanceRanges( entity_description ).optimal;

									if( square_distance >= optimal_range.distance_min * optimal_range.distance_min &&
										square_distance <= optimal_range.distance_max * optimal_range.distance_max )
									{
										if( game_state.random.Next() % 10u < convenient_position[2] )
										{
											next_operation= convenient_position[1];
										}
									}
								}
							}
						}
					}
					if( next_operation == ~0u )
					{
						if_var( &transformation : operation_control.transformation )
						{
							if( entity.num_steps_since_operation_start == transformation[1] )
							{
								next_operation= ( entity.ammo > 0u ? transformation[2] : transformation[3] );
							}
						}
					}
					if( next_operation == ~0u )
					{
						if_var( &within_sight : operation_control.within_sight )
						{
							if( entity.num_steps_since_operation_start == within_sight[0] )
							{
								// TODO - perform proper player to entity check, not reverse check as now.
								var bool player_sees_this_entity= entity.player_is_in_sight;
								if( player_sees_this_entity )
								{
									next_operation= within_sight[1];
								}
							}
						}
					}
					if( next_operation == ~0u )
					{
						if_var( &randomness : operation_control.randomness )
						{
							// Random state transition with no other condition.
							if( entity.num_steps_since_operation_start == u32( randomness[0] ) )
							{
								if( randomness[2] >= 0 && game_state.random.Next() % 100u <= u32(randomness[1]) )
								{
									next_operation= u32( randomness[2] );
								}
								else if( randomness[4] >= 0 && game_state.random.Next() % 100u <= u32(randomness[3]) )
								{
									next_operation= u32( randomness[4] );
								}
							}
						}
					}
					if( next_operation == ~0u )
					{
						if_var( & timeout : operation_control.timeout )
						{
							// Timeout should be (generally) the last checked option.
							if( entity.num_steps_since_operation_start >= timeout[0] )
							{
								next_operation= u32( timeout[1] );
							}
						}
					}

					if( next_operation == ~0u )
					{
						// Shoot if no operation transition is scheduled.
						if_var( &item : operation_control.item )
						{
							if( entity.num_steps_since_operation_start == u32( item[4] ) )
							{
								delayed_shot_alarm=
									EntityShoot(
										game_params,
										entities_description,
										game_state.skill,
										item,
										entity,
										u32( entity_index ),
										game_state.player.crouching_phase,
										game_state.random,
										game_state.projectiles,
										game_state.muzzle_flashes,
										game_state.muzzle_lights );
							}
						}
					}
				}

				if_var( &collision_with_enemy : operation.collision_with_enemy )
				{
					// State transition used only by the destructible wall on map 24.
					// Just check if some other entity (nearly) touches this entity.

					var bool mut collided= false;

					if_var( &mut collider_bbox : CalculateEntityColliderBBox( entity, operation ) )
					{
						var f32 distance_eps= 1.0f;
						collider_bbox.min-= Vec3f( distance_eps, distance_eps, distance_eps );
						collider_bbox.max+= Vec3f( distance_eps, distance_eps, distance_eps );

						foreach( &collider : game_state.colliders )
						{
							if( collider.bbox.Instersects( collider_bbox ) && collider.entity_index != c_player_entity_index )
							{
								collided= true;
							}
						}
					}

					if( collided )
					{
						next_operation= collision_with_enemy.new_operation;
					}
				}

				if_var( &rotation_for_shot : operation.rotation_for_shot )
				{
					if_var( &target_position : entity.last_seen_player_position )
					{
						var Vec2f vec_to_movement_target= target_position.xy() - entity.position.xy();

						var f32 target_azimuth= ust::atan2( -vec_to_movement_target.x, vec_to_movement_target.y );

						var f32 angle_delta= CalculateRotationAngleDelta( entity.azimuth, target_azimuth );

						if( ust::abs( angle_delta ) <= ust::abs( Convert1024Angle( f32( rotation_for_shot.deviation_angle ) ) ) )
						{
							if( rotation_for_shot.new_operation_if_target_in_view >= 0 &&
								size_type( rotation_for_shot.new_operation_if_target_in_view ) < entity_description.operations.size() )
							{
								next_operation= u32( rotation_for_shot.new_operation_if_target_in_view );
							}
						}
						else
						{
							if( rotation_for_shot.new_operation_if_target_not_in_view >= 0 &&
								size_type( rotation_for_shot.new_operation_if_target_not_in_view ) < entity_description.operations.size() )
							{
								next_operation= u32( rotation_for_shot.new_operation_if_target_not_in_view );
							}
						}
					}
				}

				if_var( &directional_shot : operation.directional_shot )
				{
					if( entity.num_steps_since_operation_start == directional_shot.time &&
						// Perform tank shot only if player is still alive.
						game_state.player.energy > 0u )
					{
						EntityDirectionalShot(
							entities_description,
							directional_shot,
							entity,
							u32( entity_index ),
							game_state.random,
							game_state.projectiles,
							game_state.muzzle_flashes,
							game_state.muzzle_lights );
					}
				}

				if_var( &if_alive : operation.if_alive )
				{
					if( if_alive.time != 0u && entity.num_steps_since_operation_start == if_alive.time )
					{
						next_operation= ( entity.energy > 0u ? if_alive.new_operation[0] : if_alive.new_operation[1] );
					}
				}

				if_var( &stopper : operation.stopper )
				{
					if( stopper.time != 0u &&
						entity.num_steps_since_operation_start % stopper.time == 0u )
					{
						next_operation= stopper.new_operation;
					}
				}

				if_var( &object_rotation : operation.object_rotation )
				{
					// Perform rotation.
					entity.azimuth= Convert1024Angle( f32( object_rotation.rotation ) ) * f32( entity.num_steps_since_operation_start );

					// It looks like object rotation also includes tomeout-based state transition.
					if( next_operation == ~0u )
					{
						if( entity.num_steps_since_operation_start == object_rotation.time )
						{
							next_operation= object_rotation.new_operation;
						}
					}
				}

				if_var( &supply_drop : operation.supply_drop )
				{
					// Emit new entity if it's dropped.
					// This will increase the total amout of entities, but it's not a big deal,
					// since (generally) items are dropped only once and dropped items can't drop other items.

					if( entity.num_steps_since_operation_start == supply_drop.time )
					{
						if( size_type( supply_drop.special_object ) < entities_description.entities.size() )
						{
							var EntitiesDescription::EntityDescription& new_entity_description=
								entities_description.entities[ size_type( supply_drop.special_object ) ];

							if( size_type( c_start_operation ) < new_entity_description.operations.size() )
							{
								new_spawned_entity.reset(
									EntityState
									{
										.kind= supply_drop.special_object,
										.position= entity.position,
										.azimuth= entity.azimuth,
										.energy= new_entity_description.energy,
										.ammo= new_entity_description.ammunition,
										.current_operation= c_start_operation,
										.num_steps_since_operation_start= 0u,
										.navigation_info_index= ~0u,
										.alarmed= false,
										.player_is_in_sight= false,
										.lost_energy_in_current_operation= false,
										.animation_frame= 0u, // Set exact frame later.
										.directional_animation_frame= 0u, // Set exact frame later.
										.velocity_z= 0.0f,
										.collider_index= ~0u,
									} );
							}
						}
					}
				}

				if_var( &gasoline_explosion : operation.gasoline_explosion )
				{
					foreach( &explosion : gasoline_explosion.explosions )
					{
						if( explosion[2] != 0 && entity.num_steps_since_operation_start == u32( explosion[0] ) )
						{
							game_state.explosion_particles.Insert(
								ExplosionParticle
								{
									.large= true,
									.position( entity.position.xy(), entity.position.z + f32( explosion[1] ) ),
									.age_steps= 0u,
								} );
						}
					}

					if( gasoline_explosion.damage_area[0] > 0u && gasoline_explosion.damage_area[1] > 0u )
					{
						// Entity explosion damage in the original works a little bit strange.
						// Investigations have shown, that it's applied to entities in the surrounding area each game step
						// if current operation contains "wybuch_benzyny".
						//
						// It's not clear, how exactly this damage is dealed, so, use the same approach as for splash damage of projectiles,
						// which includes distance-based attenuation.

						delayed_explosion_splash_damage=
							DelayedExplosionSplashDamage
							{
								.center= entity.position,
								.radius= f32( gasoline_explosion.damage_area[0] ),
								// Scale damage somewhat down. Its' too high without this.
								.splash_base_damage= f32( gasoline_explosion.damage_area[1] ) / 2.0f,
							};
					}
				}

				if_var( &smoke_emission : operation.smoke_emission )
				{
					if( smoke_emission.emission_period != 0u &&
						entity.num_steps_since_operation_start % smoke_emission.emission_period == 0u )
					{
						var Vec3f start_position=
							entity.position +
							Vec3f(
								f32( smoke_emission.pos_x ),
								f32( smoke_emission.pos_y ),
								f32( smoke_emission.pos_z ) );

						game_state.smoke_particles.Insert(
							SmokeParticle
							{
								.smoke_model= smoke_emission.smoke_model,
								.center= start_position,
								.position= start_position,
								.velocity(
									f32( smoke_emission.velocity_x ),
									f32( smoke_emission.velocity_y ),
									f32( smoke_emission.velocity_z ) ),
								.sequential_index=
									entity.num_steps_since_operation_start / smoke_emission.emission_period,
								.age_steps= 0u,
							} );
					}
				}

				if_var( &smoke : operation.smoke )
				{
					if( entity.num_steps_since_operation_start >= smoke.time && smoke.delta > 0u )
					{
						// Just ignore all parameters and spawn the same smoke effect as for projectile hits.
						if( entity.num_steps_since_operation_start == smoke.time )
						{
							var Mat4f rotation_matrix= Mat4f::MakeRotationZ( entity.azimuth );
							var Vec3f offset=
								Vec3f( f32( smoke.position_x ), f32( smoke.position_y ), f32( smoke.position_z ) ) *
								rotation_matrix;

							game_state.projectile_hit_smoke_emitters.Insert(
								ProjectileHitSmokeEmitter
								{
									.position= entity.position + offset,
									.hit_point_normal= Vec3f( 0.0f, 1.0f, 0.0f ) * rotation_matrix,
									.age_steps= 0u,
								} );
						}
					}
				}

				if( next_operation != ~0u )
				{
					if( size_type( next_operation ) < entity_description.operations.size() )
					{
						entity.current_operation= next_operation;
						entity.num_steps_since_operation_start= 0u;
						entity.lost_energy_in_current_operation= false;

						// Emit a sound if switching to an operation having it.
						if_var( &sound : entity_description.operations[ size_type( entity.current_operation ) ].sound )
						{
							if( sound.sound_index <= 255u )
							{
								EmitSound( entity.sound_source_slots, u8( sound.sound_index ), sound.power );
							}
						}

						// Emit an explosion sound if swtiching to an operation having gasoline explosion effect.
						if( !entity_description.operations[ size_type( entity.current_operation ) ].gasoline_explosion.empty() )
						{
							EmitEntityExplosionSound(
								game_global_data.sounds_description.deref(), entity.sound_source_slots );
						}
					}
					else
					{
						// Remove this entity if non-existing operation is specified.
						// This is used by some entities which should be completely destroyed.
						need_to_remove_entity= true;
					}
				}
			}

			var EntitiesDescription::Operation& operation=
				entity_description.operations[ size_type( entity.current_operation ) ];

			// Perform entity movement.
			MoveEntity(
				map_data,
				game_state.broken_quad_bits,
				game_state.dynamic_cluster_colliders,
				game_state.colliders,
				game_state.projectiles,
				game_state.projectile_hit_events,
				entity,
				entity_navigation_state_opt,
				u32(entity_index),
				entity_description,
				operation );

			// Calculate current frame based on animation params.
			// TODO - perform extra animation logic for some special animation kinds.

			{
				var u32 animation_step=
					operation.animation.start_step +
					entity.num_steps_since_operation_start % ust::max( 1u, operation.animation.num_steps );

				entity.animation_frame= animation_step / c_num_steps_per_animation_frame;
			}
			{
				var u32 animation_step=
					operation.directional_animation.start_step +
					entity.num_steps_since_operation_start % ust::max( 1u, operation.directional_animation.num_steps );

				entity.directional_animation_frame= animation_step / c_num_steps_per_animation_frame;
			}

			// Increase step counter after doing any other logic.
			// It's needed in order to make results (like animation frame) of step #0 observable.

			++entity.num_steps_since_operation_start;
		}

		if( need_to_remove_entity )
		{
			RemoveEntityCollider( entity_index, game_state );
			game_state.entities[ entity_index ].reset();
		}
		else
		{
			// Add entity back to the colliders list (if necessary).
			AddEntityCollider( entities_description, entity_index, game_state );
		}

		// Push new entity into the container.
		// It's necessary to process it later (within current update step).
		if( !new_spawned_entity.empty() )
		{
			var size_type new_entity_index= game_state.entities.size();
			game_state.entities.push_back( new_spawned_entity.try_take() );
			AddEntityCollider( entities_description, new_entity_index, game_state );
		}

		if_var( &d : delayed_explosion_splash_damage )
		{
			ApplySplashDamage(
				game_global_data.sounds_description.deref(),
				d.center,
				d.radius,
				d.splash_base_damage,
				game_state.random,
				game_state.colliders,
				game_state.entities,
				game_state.player,
				// Avoid applying splash damage to this entity.
				// It's needed for the tank enemy, which deals splash damage around it. It should not damage itself.
				u32( entity_index ) );
		}

		if_var( &d : delayed_shot_alarm )
		{
			AlarmEnemiesByNearbyEvent( game_state.colliders, game_state.entities, d.center, d.max_distance );
		}
	}
}

fn ProcessDynamicClustersLogicStep( GameGlobalData& global_data, GameMapData& map_data, GameState &mut game_state )
{
	auto clusters= map_data.zvox_data.deref().clusters.range();
	auto dynamic_cluster_extra_infos= map_data.zvox_data.deref().dynamic_cluster_extra_infos.range();

	// The player activates dynamic clusters by his bbox. But he can't do this if he has no one or if he is dead.
	var BBox3f mut player_touch_bbox=
		( ( game_state.player.collider_index == ~0u || game_state.player.energy == 0u )
			? BBox3f{ .min( 10000.0f, 10000.0f, 10000.0f ), .max( 10001.0f, 10001.0f, 10001.0f ) }
			: game_state.colliders[ size_type( game_state.player.collider_index ) ].bbox );

	// Extend player touch bbox a little bit.
	player_touch_bbox.min-= Vec3f( 1.0f, 1.0f, 1.0f );
	player_touch_bbox.max+= Vec3f( 1.0f, 1.0f, 1.0f );

	// We have only a few dynamic cluster extra infos. Store their activation flags in activation mask.
	var u32 mut activation_mask= 0u;

	for( auto mut i= 0s; i < game_state.dynamic_clusters.size(); ++i )
	{
		var DynamicClusterState &mut cluster_state= game_state.dynamic_clusters[i];

		var ZvoxCluster& cluster= clusters[ size_type( game_state.dynamic_cluster_colliders[i].cluster_index ) ];

		var bool mut is_button_operated= false;
		var u32 mut current_cluster_targets_activation_mask= 0u;

		if( cluster.dynamic_cluster_extra_info_index >= 0 &&
			size_type( cluster.dynamic_cluster_extra_info_index ) < dynamic_cluster_extra_infos.size() )
		{
			var ZvoxDynamicClusterExtraInfo& dynamic_cluster_extra_info=
				dynamic_cluster_extra_infos[ size_type( cluster.dynamic_cluster_extra_info_index ) ];

			is_button_operated= dynamic_cluster_extra_info.is_door_or_platform != 0;

			if( dynamic_cluster_extra_info.other_info_index >= 0 &&
				dynamic_cluster_extra_info.other_info_index < 32 )
			 {
				current_cluster_targets_activation_mask= 1u << u32( dynamic_cluster_extra_info.other_info_index );
			 }
		}

		var f32 movement_speed= GetDynamicClusterMovementSpeed( cluster );
		var Vec3f movement_direction= GetDynamicClusterMovementDirection( cluster );

		switch( cluster_state.movement_stage )
		{
			DynamicClusterState::MovementStage::StayAtStart ->
			{
				if( cluster_state.num_steps_to_movement_stage_transition != 0u )
				{
					--cluster_state.num_steps_to_movement_stage_transition;
					if( cluster_state.num_steps_to_movement_stage_transition == 0u )
					{
						cluster_state.movement_stage= DynamicClusterState::MovementStage::MoveForward;
						activation_mask|= current_cluster_targets_activation_mask;
					}
				}
				else if(
					!is_button_operated &&
					game_state.dynamic_cluster_colliders[i].bbox.InstersectsOrTouches( player_touch_bbox ) )
				{
					if( HasNecessaryKeyForDynamicCluster( cluster, game_state.player ) )
					{
						cluster_state.num_steps_to_movement_stage_transition= c_dynamic_cluster_activation_delay_steps;
					}
					else
					{
						ProcessClusterKeyRequirement( cluster, game_state.player, game_state.step_index );
					}
				}
			},
			DynamicClusterState::MovementStage::MoveForward ->
			{
				if( PushMoveDynamicCluster(
						global_data,
						map_data,
						game_state.broken_quad_bits,
						game_state.dynamic_cluster_colliders[i],
						movement_direction * movement_speed,
						game_state.colliders,
						game_state.entities,
						game_state.dynamic_cluster_colliders,
						game_state.player,
						game_state.projectiles,
						game_state.projectile_hit_events,
						game_state.static_sound_sources ) )
				{
					cluster_state.distance_from_start+= movement_speed;

					var f32 travel_distance( cluster.light_sources_begin );

					if( cluster_state.distance_from_start >= travel_distance )
					{
						cluster_state.distance_from_start= travel_distance;
						cluster_state.movement_stage= DynamicClusterState::MovementStage::StayAtEnd;
					}
				}
				else
				{
					// Reverse movement if is blocked.
					cluster_state.movement_stage= DynamicClusterState::MovementStage::MoveBackward;
				}

			},
			DynamicClusterState::MovementStage::StayAtEnd ->
			{
				if( cluster_state.num_steps_to_movement_stage_transition != 0u )
				{
					--cluster_state.num_steps_to_movement_stage_transition;
					if( cluster_state.num_steps_to_movement_stage_transition == 0u )
					{
						cluster_state.movement_stage= DynamicClusterState::MovementStage::MoveBackward;
						activation_mask|= current_cluster_targets_activation_mask;
					}
				}
				else if( !is_button_operated && GetDynamicClusterAutoReturn( cluster ) )
				{
					// Auto-return some dynamic clusters to their initial position.
					cluster_state.num_steps_to_movement_stage_transition= c_dynamic_cluster_activation_delay_steps;
				}
				else if(
					!is_button_operated &&
					game_state.dynamic_cluster_colliders[i].bbox.InstersectsOrTouches( player_touch_bbox ) )
				{
					if( HasNecessaryKeyForDynamicCluster( cluster, game_state.player ) )
					{
						cluster_state.num_steps_to_movement_stage_transition= c_dynamic_cluster_activation_delay_steps;
					}
					else
					{
						ProcessClusterKeyRequirement( cluster, game_state.player, game_state.step_index );
					}
				}
			},
			DynamicClusterState::MovementStage::MoveBackward ->
			{
				if( PushMoveDynamicCluster(
						global_data,
						map_data,
						game_state.broken_quad_bits,
						game_state.dynamic_cluster_colliders[i],
						movement_direction * (-movement_speed),
						game_state.colliders,
						game_state.entities,
						game_state.dynamic_cluster_colliders,
						game_state.player,
						game_state.projectiles,
						game_state.projectile_hit_events,
						game_state.static_sound_sources ) )
				{
					cluster_state.distance_from_start-= movement_speed;

					if( cluster_state.distance_from_start <= 0.0f )
					{
						cluster_state.distance_from_start= 0.0f;
						cluster_state.movement_stage= DynamicClusterState::MovementStage::StayAtStart;
					}
				}
				else
				{
					// Reverse movement if is blocked.
					cluster_state.movement_stage= DynamicClusterState::MovementStage::MoveForward;
				}
			},
		}

		game_state.dynamic_cluster_colliders[i].bbox=
			CreateDynamicClusterBBox(
				cluster,
				movement_direction * cluster_state.distance_from_start );
	}

	// Activate dynamic clusters by other dynamic clusters.
	if( activation_mask != 0u )
	{
		for( auto mut i= 0s; i < game_state.dynamic_clusters.size(); ++i )
		{
			var DynamicClusterState &mut cluster_state= game_state.dynamic_clusters[i];

			var ZvoxCluster& cluster= clusters[ size_type( game_state.dynamic_cluster_colliders[i].cluster_index ) ];

			if( cluster.dynamic_cluster_extra_info_index >= 0 &&
				cluster.dynamic_cluster_extra_info_index < 32 &&
				( activation_mask & ( 1u << size_type( cluster.dynamic_cluster_extra_info_index ) ) ) != 0u )
			{
				switch( cluster_state.movement_stage )
				{
					DynamicClusterState::MovementStage::StayAtStart,
					DynamicClusterState::MovementStage::StayAtEnd ->
					{
						if( cluster_state.num_steps_to_movement_stage_transition == 0u )
						{
							cluster_state.num_steps_to_movement_stage_transition= c_dynamic_cluster_activation_delay_steps;
						}
					},
					DynamicClusterState::MovementStage::MoveForward ->
					{
						// TODO - reverse movement?
					},
					DynamicClusterState::MovementStage::MoveBackward ->
					{
						// TODO - reverse movement?
					},
				}
			}
		}
	}
}

fn GetDynamicClusterMovementSpeed( ZvoxCluster& cluster ) : f32
{
	// TODO - tune these speeds.
	// TODO - check how in the original game speed depends on cluster type.
	switch(  cluster.cluster_type )
	{
		// Doors and platforms.
		ZvoxCluster::c_cluster_type_z_minus_door_a,
		ZvoxCluster::c_cluster_type_z_plus_door_a,
		ZvoxCluster::c_cluster_type_z_minus_door_b,
		ZvoxCluster::c_cluster_type_z_plus_door_b,
		ZvoxCluster::c_cluster_type_z_minus_door_c,
		ZvoxCluster::c_cluster_type_y_minus_door_a,
		ZvoxCluster::c_cluster_type_y_plus_door_a,
		ZvoxCluster::c_cluster_type_x_minus_door_a
			-> { return 4.0f; },
		// Buttons.
		ZvoxCluster::c_cluster_type_y_minus_button_a,
		ZvoxCluster::c_cluster_type_y_plus_button_a,
		ZvoxCluster::c_cluster_type_x_plus_button_a,
		ZvoxCluster::c_cluster_type_x_minus_button_a,
		ZvoxCluster::c_cluster_type_y_minus_button_b,
		ZvoxCluster::c_cluster_type_y_plus_button_b,
		ZvoxCluster::c_cluster_type_x_plus_button_b,
		ZvoxCluster::c_cluster_type_x_minus_button_b
			-> { return 1.0f; },
		default
			-> { return 4.0f; }
	}
}

fn GetDynamicClusterMovementDirection( ZvoxCluster& cluster ) : Vec3f
{
	switch( cluster.cluster_type )
	{
		ZvoxCluster::c_cluster_type_x_plus_button_a,
		ZvoxCluster::c_cluster_type_x_plus_button_b
			-> { return Vec3f(  1.0f,  0.0f,  0.0f ); },
		ZvoxCluster::c_cluster_type_x_minus_door_a,
		ZvoxCluster::c_cluster_type_x_minus_button_a,
		ZvoxCluster::c_cluster_type_x_minus_button_b
			-> { return Vec3f( -1.0f,  0.0f,  0.0f ); },
		ZvoxCluster::c_cluster_type_y_plus_door_a,
		ZvoxCluster::c_cluster_type_y_plus_button_a,
		ZvoxCluster::c_cluster_type_y_plus_button_b
			-> { return Vec3f(  0.0f,  1.0f,  0.0f ); },
		ZvoxCluster::c_cluster_type_y_minus_door_a,
		ZvoxCluster::c_cluster_type_y_minus_button_a,
		ZvoxCluster::c_cluster_type_y_minus_button_b
			-> { return Vec3f(  0.0f, -1.0f,  0.0f ); },
		ZvoxCluster::c_cluster_type_z_plus_door_a,
		ZvoxCluster::c_cluster_type_z_plus_door_b
			-> { return Vec3f(  0.0f,  0.0f,  1.0f ); },
		ZvoxCluster::c_cluster_type_z_minus_door_a,
		ZvoxCluster::c_cluster_type_z_minus_door_b,
		ZvoxCluster::c_cluster_type_z_minus_door_c
			-> { return Vec3f(  0.0f,  0.0f, -1.0f ); },
		default
			-> { return Vec3f( 0.0f, 0.0f, 0.0f ); },
	}
}

fn GetDynamicClusterAutoReturn( ZvoxCluster& cluster ) : bool
{
	switch(  cluster.cluster_type )
	{
		// Doors and platforms with auto-return.
		ZvoxCluster::c_cluster_type_z_minus_door_b,
		ZvoxCluster::c_cluster_type_z_plus_door_b,
		ZvoxCluster::c_cluster_type_z_minus_door_c
			-> { return true; },
		// Doors and platforms with no auto-return.
		ZvoxCluster::c_cluster_type_z_minus_door_a,
		ZvoxCluster::c_cluster_type_z_plus_door_a,
		ZvoxCluster::c_cluster_type_y_minus_door_a,
		ZvoxCluster::c_cluster_type_y_plus_door_a,
		ZvoxCluster::c_cluster_type_x_minus_door_a
			-> { return false; },
		// Buttons have no auto-return. TODO - maybe add it?
		ZvoxCluster::c_cluster_type_y_minus_button_a,
		ZvoxCluster::c_cluster_type_y_plus_button_a,
		ZvoxCluster::c_cluster_type_x_plus_button_a,
		ZvoxCluster::c_cluster_type_x_minus_button_a,
		ZvoxCluster::c_cluster_type_y_minus_button_b,
		ZvoxCluster::c_cluster_type_y_plus_button_b,
		ZvoxCluster::c_cluster_type_x_plus_button_b,
		ZvoxCluster::c_cluster_type_x_minus_button_b
			-> { return false; },
		default
			-> { return false; }
	}
}

fn HasNecessaryKeyForDynamicCluster( ZvoxCluster& cluster, PlayerState& player_state ) : bool
{
	type TT= EntitiesDescription::ToolType;
	switch( cluster.contents )
	{
		ZvoxCluster::c_contents_key_a -> { return player_state.inventory[ size_type( TT::KeyA ) ] > 0u; },
		ZvoxCluster::c_contents_key_b -> { return player_state.inventory[ size_type( TT::KeyB ) ] > 0u; },
		ZvoxCluster::c_contents_key_c -> { return player_state.inventory[ size_type( TT::KeyC ) ] > 0u; },
		default -> { return true; } // No key required
	}
}

fn ProcessClusterKeyRequirement( ZvoxCluster& cluster, PlayerState &mut player, u32 current_step )
{
	type TT= EntitiesDescription::ToolType;
	switch( cluster.contents )
	{
		ZvoxCluster::c_contents_key_a -> { player.last_requested_key_type= TT::KeyA; },
		ZvoxCluster::c_contents_key_b -> { player.last_requested_key_type= TT::KeyB; },
		ZvoxCluster::c_contents_key_c -> { player.last_requested_key_type= TT::KeyC; },
		default -> {} // No key required
	}

	player.last_key_request_step= current_step;
}

// Returns true if can move and false if movement is blocked.
fn PushMoveDynamicCluster(
	GameGlobalData& global_data,
	GameMapData& map_data,
	BitArrayView broken_quad_bits,
	DynamicClusterCollider& dynamic_cluster_collider,
	Vec3f& in_movement_vector,
	ust::array_view_mut</Collider/> colliders,
	ust::array_view_mut</ ust::optional</EntityState/> /> entities,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	PlayerState &mut player_state,
	ProjectilesContainer &mut projectiles,
	ust::vector</ProjectileHitEvent/> &mut projectile_hit_events,
	StaticSoundSources &mut static_sound_sources ) : bool
{
	var f32 movement_vector_length= in_movement_vector.Length();
	if( movement_vector_length == 0.0f )
	{
		return true;
	}

	// Slightly overestimate push movement in order to avoid numerical precision issues.
	var f32 c_elongation_eps= 1.0f / 16.0f;
	var Vec3f movement_vector_elongated=
		in_movement_vector * ( ( movement_vector_length + c_elongation_eps ) / movement_vector_length );

	// Move all entity colliders in the direction opposite to the movement direction,
	// in order to find possible collisions with this dynamic cluster.

	var Vec3f opposite_movement_vector= -movement_vector_elongated;

	var size_type c_max_pushed_colliders= 4s;

	// Collider index + relative distance to the collider.
	var [ tup[ size_type, f32 ], c_max_pushed_colliders ] mut pushed_colliders= zero_init;
	var size_type mut num_pushed_colliders= 0s;

	// Check all colliders of entities and players if they are in the way.
	// It's not fully correct, since entities without permanent colliders (like pick-ups) are ignored, but it's mostly fine.
	for( auto mut i= 0s; i < colliders.size(); ++i )
	{
		var TraceCollisionResult trace_collision_result=
			CollisionTraceSingleDynamicCluster(
				map_data,
				broken_quad_bits,
				dynamic_cluster_collider,
				colliders[i].bbox,
				Vec3f::MakeZero(),
				opposite_movement_vector );

		if( trace_collision_result.clipped_move_distance <= 1.0f )
		{
			if( num_pushed_colliders >= c_max_pushed_colliders )
			{
				// Has too many colliders in the way. Assume to be blocked.
				return false;
			}

			var f32 push_relative_distance= 1.0f - trace_collision_result.clipped_move_distance;
			var Vec3f push_vector= opposite_movement_vector * (-push_relative_distance);

			// Check if this collider can be pushed the whole movement distance.
			// Temporary move this collider itself near to infinity to avoid self-collisions.
			var BBox3f collider_bbox= colliders[i].bbox;
			colliders[i].bbox= BBox3f{ .min( 10000.0f, 10000.0f, 10000.0f ), .max( 10001.0f, 10001.0f, 10001.0f ) };

			var TraceCollisionResult push_trace_collision_result=
				CollisionTrace(
					map_data,
					broken_quad_bits,
					dynamic_cluster_colliders,
					colliders,
					collider_bbox,
					Vec3f::MakeZero(),
					push_vector );

			colliders[i].bbox= collider_bbox;

			if( push_trace_collision_result.clipped_move_distance <= 1.0f )
			{
				// Blocked.
				return false;
			}

			pushed_colliders[num_pushed_colliders]=
				ust::make_tuple( i, trace_collision_result.clipped_move_distance );
			++num_pushed_colliders;
		}
	}

	// Push colliders in the way.

	for( var size_type mut i= 0s; i < num_pushed_colliders; ++i )
	{
		var size_type collider_index= pushed_colliders[i][0];
		var f32 relative_distance_to_collider= pushed_colliders[i][1];

		if( relative_distance_to_collider < 1.0f )
		{
			var Collider &mut collider= colliders[ collider_index ];

			var Vec3f push_vector=
				movement_vector_elongated * ( 1.0f - relative_distance_to_collider );

			// Collide with projectiles if is pushed.
			CollideMovedEntityWithProjectiles(
				Vec3f::MakeZero(),
				push_vector,
				collider.bbox,
				collider.entity_index,
				projectiles,
				projectile_hit_events );

			// Modify player/entity position directly.
			if( collider.entity_index == c_player_entity_index )
			{
				player_state.position+= push_vector;
			}
			else if( size_type( collider.entity_index ) < entities.size() )
			{
				if_var( &mut entity : entities[ size_type( collider.entity_index ) ] )
				{
					entity.position+= push_vector;
				}
			}

			// Modify bbox of the collider directly.
			collider.bbox.min+= push_vector;
			collider.bbox.max+= push_vector;
		}
	}

	// Hit projectiles by moving this dynamc cluster.
	projectiles.Retain(
		lambda[&]( Projectile &mut projectile ) : bool
		{
			if_var( &intersection_result :
				LineTraceSingleDynamicCluster(
					map_data,
					broken_quad_bits,
					dynamic_cluster_collider,
					projectile.position,
					opposite_movement_vector ) )
			{
				if( intersection_result.distance <= 1.0f )
				{
					projectile.position+= movement_vector_elongated * ( 1.0f - intersection_result.distance );

					var EntitiesDescription& entities_description= map_data.entities_description.deref();

					var EntitiesDescription::Tool& weapon_tool=
						entities_description.tools[ size_type( projectile.weapon_tool_index ) ];

					if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_ricocheting_bullet |
						weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_grenade )
					{
						// Bounce a this projectile.

						auto& quads= map_data.zmap_data.deref().quads;

						if( size_type( intersection_result.quad_index ) < quads.size() )
						{
							var Vec3f normal= CalculateQuadNormal( quads[ size_type( intersection_result.quad_index ) ] );

							var f32 normal_square_length= normal.SquareLength();
							if( normal_square_length > 0.0f )
							{
								// Move position slightly away from the collider plane.
								projectile.position+= ( ( 1.0f / 32.0f ) / ust::sqrt( normal_square_length ) ) * normal;

								var Vec3f mut velocity_in_dynamic_cluster_reference_system=
									projectile.velocity - movement_vector_elongated;

								// Reflect velocity.
								velocity_in_dynamic_cluster_reference_system-=
									( 2.0f * velocity_in_dynamic_cluster_reference_system.Dot( normal ) / normal_square_length ) * normal;

								SlowDownProjectileAfterBouncing(
									velocity_in_dynamic_cluster_reference_system, weapon_tool );

								projectile.velocity=
									velocity_in_dynamic_cluster_reference_system + movement_vector_elongated;

								EmitProjectileBounceSound(
									static_sound_sources,
									weapon_tool,
									GetMaterialPropertiesForMapQuad(
										global_data, map_data, intersection_result.quad_index ),
									projectile.position,
									projectile.velocity );
							}
						}
					}
					else
					{
						// Non-bouncing projectile - just destroy it.

						projectile_hit_events.push_back(
							ProjectileHitEvent
							{
								.weapon_tool_index= projectile.weapon_tool_index,
								.position= projectile.position,
								.hit_cluster_index= intersection_result.cluster_index,
								.hit_quad_index= intersection_result.quad_index,
								.hit_entity_index= ~0u,
							} );

						return false; // Destroy.
					}
				}
			}

			return true; // Preserve.
		} );

	return true;
}

fn ProcessProjectilesLogicStep( GameGlobalData& global_data, GameMapData& map_data, GameState &mut game_state )
{
	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	auto &mut smoke_trail_particles= game_state.smoke_trail_particles;
	auto &mut projectile_hit_events= game_state.projectile_hit_events;
	auto& broken_quad_bits= game_state.broken_quad_bits;
	auto& dynamic_cluster_colliders= game_state.dynamic_cluster_colliders;
	auto& colliders= game_state.colliders;
	auto &mut static_sound_sources= game_state.static_sound_sources;

	game_state.projectiles.Retain(
		lambda[&]( Projectile& mut projectile ) : bool
		{
			var EntitiesDescription::Tool& weapon_tool=
				entities_description.tools[ size_type( projectile.weapon_tool_index ) ];

			// Add smoke trail particles before moving.
			// This will create a particle at shot start point, which is needed for better look for weapons like flamethrower.
			if( weapon_tool.smoke_trail_kind != EntitiesDescription::Tool::c_smoke_trail_kind_none )
			{
				smoke_trail_particles.Insert(
					SmokeTrailParticle
					{
						.kind= weapon_tool.smoke_trail_kind,
						.position= projectile.position,
						.age_steps= 0u,
					} );
			}

			var f32 mut remaining_movement_fraction= 1.0f;

			// Support up to 3 bounces for bouncing projectiles.
			for( auto mut bounce= 0s; bounce < 3s; ++bounce ) label bounces_loop
			{
				var Vec3f current_bounce_movement_vector=
					remaining_movement_fraction * projectile.velocity;

				// Perform movement with collision check.

				// Find itersections using movement slightly longer than necessary.
				// It's needed in order to fix possible numerical imprecisions.

				var f32 c_elongation_eps= 1.0f;
				var f32 velocity_length= ust::max( 0.01f, current_bounce_movement_vector.Length() );
				var Vec3f velocity_slightly_elongated=
					current_bounce_movement_vector * ( ( velocity_length + c_elongation_eps ) / velocity_length );

				var f32 mut smallest_travelled_distance= 1.0f;

				var u32 mut hit_cluster_index= ~0u, mut hit_quad_index= ~0u;
				var u32 mut hit_entity_index= ~0u;

				if_var( &line_trace_result :
						LineTrace(
							map_data,
							broken_quad_bits,
							dynamic_cluster_colliders,
							projectile.position,
							velocity_slightly_elongated ) )
				{
					if( line_trace_result.distance < 1.0f )
					{
						smallest_travelled_distance= line_trace_result.distance;
						hit_cluster_index= line_trace_result.cluster_index;
						hit_quad_index= line_trace_result.quad_index;
					}
				}

				foreach( &collider : colliders )
				{
					if( collider.entity_index == projectile.owner_entity_index )
					{
						// Don't collide with owner.
						// This is needed for some entities or for the player,
						// since sometimes their/his own projectiles are spawned within their/his bounding boxes.
						// Also it's necessary for ricocheting projectiles and other projectiles with non-linear movement.
						continue;
					}

					if_var( &intersection_result :
						FindRayBBoxIntersection( projectile.position, velocity_slightly_elongated, collider.bbox ) )
					{
						if( !( intersection_result.near_point_distance > 1.0f | intersection_result.far_point_distance < 0.0f ) )
						{
							var f32 intersection_distance= ust::max( 0.0f, intersection_result.near_point_distance );
							if( intersection_distance < smallest_travelled_distance )
							{
								smallest_travelled_distance= intersection_distance;
								hit_entity_index= collider.entity_index;
								hit_cluster_index= ~0u;
								hit_quad_index= ~0u;
							}
						}
					}
				}

				if( smallest_travelled_distance < 1.0f )
				{
					// Collided with something.

					var Vec3f hit_position=
						projectile.position + velocity_slightly_elongated * smallest_travelled_distance;

					if( hit_entity_index == ~0u )
					{
						if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_ricocheting_bullet |
							weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_grenade )
						{
							// Bounce.

							auto& quads= map_data.zmap_data.deref().quads;

							if( size_type( hit_quad_index ) < quads.size() )
							{
								var Vec3f normal= CalculateQuadNormal( quads[ size_type( hit_quad_index ) ] );

								var f32 normal_square_length= normal.SquareLength();
								if( normal_square_length > 0.0f )
								{
									projectile.position= hit_position;

									// Move position slightly away from the collider plane.
									projectile.position+= ( ( 1.0f / 32.0f ) / ust::sqrt( normal_square_length ) ) * normal;

									remaining_movement_fraction *= 1.0f - smallest_travelled_distance;

									// Reflect velocity.
									projectile.velocity-=
										( 2.0f * projectile.velocity.Dot( normal ) / normal_square_length ) * normal;

									SlowDownProjectileAfterBouncing( projectile.velocity, weapon_tool );

									EmitProjectileBounceSound(
										static_sound_sources,
										weapon_tool,
										GetMaterialPropertiesForMapQuad( global_data, map_data, hit_quad_index ),
										projectile.position,
										projectile.velocity );

									continue label bounces_loop;
								}
							}
						}
					}

					projectile_hit_events.push_back(
						ProjectileHitEvent
						{
							.weapon_tool_index= projectile.weapon_tool_index,
							.position= hit_position,
							.hit_cluster_index= hit_cluster_index,
							.hit_quad_index= hit_quad_index,
							.hit_entity_index= hit_entity_index,
						} );

					return false; // Remove.
				}

				// If has no collision or has a collision with an entity or player or if it's not a bouncing projectile - don't perform more bounces.
				projectile.position+= current_bounce_movement_vector;
				break label bounces_loop;
			}

			// Apply gravity if needed.
			if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_grenade )
			{
				projectile.velocity.z+= c_heavy_projectiles_gravity;
			}
			else if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_rocket )
			{
				projectile.velocity.z+= c_light_projectiles_gravity;
			}

			++projectile.age_steps;

			if( projectile.age_steps >= c_max_projectile_age )
			{
				return false; // Remove.
			}
			if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_melee )
			{
				// Melee projectiles live only single step.
				// Their effective distance is equal to their speed per step.
				return false; // Remove.
			}

			if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_grenade &
				projectile.age_steps >= c_grenade_explosion_delay )
			{
				// Explode grenades after some delay.

				projectile_hit_events.push_back(
					ProjectileHitEvent
					{
						.weapon_tool_index= projectile.weapon_tool_index,
						.position= projectile.position,
						.hit_cluster_index= ~0u,
						.hit_quad_index= ~0u,
						.hit_entity_index= ~0u,
					} );

				return false; // Remove.
			}

			return true; // Preserve.
		} );
}

fn SlowDownProjectileAfterBouncing( Vec3f &mut velocity, EntitiesDescription::Tool& weapon_tool )
{
	// Slow-down the projectile due to energy loss caused by bouncing.
	// The original game does similar stuff.

	if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_ricocheting_bullet )
	{
		// Bullet-like bouncing projectile.
		// Multiplying velocity by half square root of two halves the kinetic energy.
		velocity *= c_half_sqrt_2;
	}
	else if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_grenade )
	{
		// Grenades bounce poorly. Reduce kinetic energy by 75%.
		velocity *= 0.5f;
	}
}

fn DamageEntityOrPlayer(
	SoundsDescription& sounds_description,
	ust::array_view_mut</ ust::optional</EntityState/> /> entities,
	PlayerState &mut player_state,
	u32 entity_index,
	u32 damage )
{
	if( entity_index == c_player_entity_index )
	{
		DamagePlayer( sounds_description, player_state, damage );
	}
	else
	{
		if( size_type( entity_index ) < entities.size() )
		{
			if_var( &mut entity : entities[ size_type( entity_index ) ] )
			{
				DamageEntity( entity, damage );
			}
		}
	}
}

fn DamagePlayer( SoundsDescription& sounds_description, PlayerState &mut player_state, u32 damage )
{
	if( damage == 0u )
	{
		return;
	}

	if( player_state.invulnerability )
	{
		return;
	}

	// An investigation of the original game has shown,
	// that armor absorbs 50% damage (rounded down),
	// 25% (rounded down) aren't absorbed and damage player's energy,
	// the rest is reflected.

	var u32 damage_with_armor_absorption= ust::min( damage, player_state.armor * 2u );
	var u32 damage_without_armor_absorption= damage - damage_with_armor_absorption;

	var u32 armor_reduce= damage_with_armor_absorption / 2u;
	var u32 energy_reduce= damage_with_armor_absorption / 4u + damage_without_armor_absorption;

	var u32 armor_damage= ust::min( armor_reduce, player_state.armor );
	var u32 energy_damage= ust::min( energy_reduce, player_state.energy );

	if( armor_damage > 0u | energy_damage > 0u )
	{
		player_state.armor-= armor_damage;
		player_state.energy-= energy_damage;

		if( player_state.energy == 0u )
		{
			EmitPlayerDeathSound( sounds_description, player_state.sound_source_slots );
		}
		else
		{
			// Assume that we need to emit this sound each time the player is damaged.
			// TODO - check if the original game does this too.
			EmitPlayerDamageSound( sounds_description, player_state.sound_source_slots );
		}
	}
}

fn DamageEntity( EntityState &mut entity, u32 damage )
{
	if( damage == 0u )
	{
		return;
	}

	if( entity.energy > 0u )
	{
		// TODO - investigate whether enemies have armor.
		entity.energy-= ust::min( damage, entity.energy );
		entity.lost_energy_in_current_operation= true;

		// Alarm enemies being hit.
		entity.alarmed= true;
	}

	// TODO - spawn blood particles.
}

fn ProcessProjectileHitEventsLogicStep( GameGlobalData& global_data, GameMapData& map_data, GameState &mut game_state )
{
	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	var ust::array_view_imut</ZvoxCluster/> clusters= map_data.zvox_data.deref().clusters;
	var ust::array_view_imut</ZmapQuad/> quads= map_data.zmap_data.deref().quads;

	foreach( &projectile_hit_event : game_state.projectile_hit_events )
	{
		var EntitiesDescription::Tool& weapon_tool=
			entities_description.tools[ size_type( projectile_hit_event.weapon_tool_index ) ];

		var size_type mut collision_kind_index= 0s; // See EntitiesDescription::Tool::collision_handling.

		if( projectile_hit_event.hit_entity_index != ~0u )
		{
			if( weapon_tool.splash_damage_area_size == 0u )
			{
				// No splash damage - damage hit entity directly.
				DamageEntityOrPlayer(
					global_data.sounds_description.deref(),
					game_state.entities,
					game_state.player,
					projectile_hit_event.hit_entity_index,
					weapon_tool.damage );
			}

			collision_kind_index= 1s;

			if( size_type( projectile_hit_event.hit_entity_index ) < game_state.entities.size() )
			{
				if_var( &entity : game_state.entities[ size_type( projectile_hit_event.hit_entity_index ) ] )
				{
					var size_type entity_kind( entity.kind );
					if( entity_kind < entities_description.entities.size()  )
					{
						if( entities_description.entities[ entity_kind ].susceptible != 0u )
						{
							collision_kind_index= 2s;
						}
					}
				}
			}
			else if( projectile_hit_event.hit_entity_index == c_player_entity_index )
			{
				// Use hit effects for the player as for alive enemy entities.
				collision_kind_index= 2s;
			}

			if( weapon_tool.napalm != 0u )
			{
				game_state.damaging_flames.Insert(
					DamagingFlame{ .entity_index= projectile_hit_event.hit_entity_index, .age_steps= 0u } );
			}
		}

		if( weapon_tool.splash_damage_area_size > 0u )
		{
			// Apply splash damage.

			// Assume this param to be radius.
			var f32 splash_damage_radius( weapon_tool.splash_damage_area_size );
			// Assume splash base damage equal to weapon damage.
			var f32 splash_base_damage( weapon_tool.damage );

			ApplySplashDamage(
				global_data.sounds_description.deref(),
				projectile_hit_event.position,
				splash_damage_radius,
				splash_base_damage,
				game_state.random,
				game_state.colliders,
				game_state.entities,
				game_state.player,
				~0u );
		}

		switch( weapon_tool.collision_handling[ collision_kind_index ] )
		{
			EntitiesDescription::Tool::c_projectile_collision_effect_flame ->
			{
				var Vec3f mut flame_position= projectile_hit_event.position;

				// Slightly offset flame position using hit point normal.
				// It's necessary to avoid ugly clipping of flame billboards on walls.
				if( size_type( projectile_hit_event.hit_quad_index ) < quads.size() )
				{
					var Vec3f normal= CalculateQuadNormal( quads[ size_type( projectile_hit_event.hit_quad_index ) ] );
					var f32 normal_length= normal.Length();
					if( normal_length != 0.0f )
					{
						var f32 scale= 3.0f / normal_length;
						flame_position.x+= normal.x * scale;
						flame_position.y+= normal.y * scale;
						if( normal.z > 0.0f ) // Offset down, but not up.
						{
							var f32 vertical_scale= 12.0f / normal_length;
							flame_position.z+= normal.z * vertical_scale;
						}
					}
				}

				if( !IsPointInLiquidOrNearby( map_data, flame_position ) ) // Avoid spawning flames in liquids.
				{
					// Check if this flame hit a dynamic cluster.
					// If so - attach it to this cluster.
					var u32 mut dynamic_cluster_object_index= ~0u;
					var Vec3f mut relative_position= Vec3f::MakeZero();

					// Use linear search. It's mostly fine, since we have only a few of dynamic clusters.
					for( auto mut i= 0s; i < game_state.dynamic_cluster_colliders.size(); ++i )
					{
						var DynamicClusterCollider& collider= game_state.dynamic_cluster_colliders[i];
						if( size_type( collider.cluster_index ) < clusters.size() )
						{
							var ZvoxCluster& cluster= clusters[ size_type( collider.cluster_index ) ];
							if( cluster.num_quads >= 0 &&
								projectile_hit_event.hit_quad_index >= cluster.c.first_quad_index &&
								projectile_hit_event.hit_quad_index < cluster.c.first_quad_index + u32( cluster.num_quads ) )
							{
								dynamic_cluster_object_index= u32(i);
								relative_position= flame_position - collider.bbox.GetCenter();
								break;
							}
						}
					}

					game_state.flame_particles.Insert(
						FlameParticle
						{
							.position= flame_position,
							.dynamic_cluster_object_index= dynamic_cluster_object_index,
							.relative_position= relative_position,
							.age_steps= 0u,
						} );
				}
			},
			EntitiesDescription::Tool::c_projectile_collision_effect_small_explosion ->
			{
				game_state.explosion_particles.Insert(
					ExplosionParticle{ .large= false, .position= projectile_hit_event.position, .age_steps= 0u, } );
			},
			EntitiesDescription::Tool::c_projectile_collision_effect_large_explosion ->
			{
				game_state.explosion_particles.Insert(
					ExplosionParticle{ .large= true, .position= projectile_hit_event.position, .age_steps= 0u, } );
			},
			EntitiesDescription::Tool::c_projectile_collision_effect_smoke_source ->
			{
				var Vec3f mut smoke_emitter_normal( 0.0f, 0.0f, -1.0f );

				if( size_type( projectile_hit_event.hit_quad_index ) < quads.size() )
				{
					var Vec3f normal= CalculateQuadNormal( quads[ size_type( projectile_hit_event.hit_quad_index ) ] );
					var f32 normal_length= normal.Length();
					if( normal_length > 0.0f )
					{
						smoke_emitter_normal= normal / normal_length;
					}
				}
				else if( size_type( projectile_hit_event.hit_entity_index ) < game_state.entities.size() )
				{
					// For entities approximate smoke emitter normal using direction towards entity bbox center.
					if_var( &entity : game_state.entities[ size_type( projectile_hit_event.hit_entity_index ) ] )
					{
						if( size_type( entity.collider_index ) < game_state.colliders.size() )
						{
							var BBox3f& collider_bbox= game_state.colliders[ size_type( entity.collider_index ) ].bbox;
							var Vec3f vec_from_center= projectile_hit_event.position - collider_bbox.GetCenter();
							var f32 vec_from_center_length= vec_from_center.Length();
							if( vec_from_center_length > 0.0f )
							{
								smoke_emitter_normal= vec_from_center / vec_from_center_length;
							}
						}
					}
				}

				game_state.projectile_hit_smoke_emitters.Insert(
					ProjectileHitSmokeEmitter
					{
						.position= projectile_hit_event.position,
						.hit_point_normal= smoke_emitter_normal,
						.age_steps= 0u,
					} );
			},
			// TODO - handle other known kinds.
			default -> {},
		}

		if( size_type( projectile_hit_event.hit_cluster_index ) < clusters.size() &&
			size_type( projectile_hit_event.hit_quad_index ) < quads.size() )
		{
			var ZmapQuad& quad= quads[ size_type( projectile_hit_event.hit_quad_index ) ];
			if( IsMapQuadBreakable( global_data, map_data, quad ) )
			{
				if( !game_state.broken_quad_bits.GetAndSetBitToOne( size_type( projectile_hit_event.hit_quad_index ) ) )
				{
					game_state.breaking_glass_effects.Insert(
						BreakingGlassEffect
						{
							.hit_position= projectile_hit_event.position,
							.cluster_index= projectile_hit_event.hit_cluster_index,
							.quad_index= projectile_hit_event.hit_quad_index,
							.age_steps= 0u,
						} );
				}
			}
		}

		if( weapon_tool.wall_mark >= 0 )
		{
			// TODO - add a bullet hole.
		}

		if( weapon_tool.light_at_hit_point[1] > 0u )
		{
			game_state.projectile_hit_lights.Insert(
				ProjectileHitLight
				{
					.position= projectile_hit_event.position,
					.power( weapon_tool.light_at_hit_point[1] ),
					.color_index( weapon_tool.light_at_hit_point[0] ),
					.age_steps= 0u,
				} );
		}

		if( weapon_tool.stars == EntitiesDescription::Tool::c_sparks_effect_id )
		{
			if( size_type( projectile_hit_event.hit_quad_index ) < quads.size() )
			{
				var Vec3f normal= CalculateQuadNormal( quads[ size_type( projectile_hit_event.hit_quad_index ) ] );
				var f32 normal_length= normal.Length();
				if( normal_length > 0.0f )
				{
					var Vec3f normal_normalized= normal / normal_length;

					// Generate sparks travelling with random direction and speed.
					for( auto mut i= 0s; i < 32s; ++i )
					{
						var [ f32, 3 ] direction_raw[
							f32( game_state.random.Next() ) * ( 2.0f / f32( PseudoRandomGenerator::c_max ) ) - 1.0f ... ];
						var Vec3f direction( direction_raw );

						var f32 direction_length= direction.Length();

						// Ignore random vectors outside unit sphere. Doing so gives nice spherical distribution.
						// Also ignore zero vectors.
						if( direction_length > 1.0f | direction_length == 0.0f )
						{
							continue;
						}

						// If random direction is facing away from the hit plane - reflect it.
						// There is no reason to spawn sparks flying towards hit plane, since they are invisible anyway.

						var Vec3f mut direction_corrected= direction;
						var f32 normal_dot= direction.Dot( normal_normalized );
						if( normal_dot < 0.0f )
						{
							direction_corrected -= ( 2.0f * normal_dot / direction_length ) * normal_normalized;
						}

						var f32 c_sparks_speed_scale= 8.0f;

						game_state.spark_particles.Insert(
							SparkParticle
							{
								.position= projectile_hit_event.position,
								// Since direction vector isn't normalized, result speeds are variating, which gives good result.
								.velocity= direction_corrected * c_sparks_speed_scale,
								.age_steps= 0u,
							} );
					}
				}
			}
		}

		if( size_type( projectile_hit_event.hit_cluster_index ) < clusters.size() &&
			size_type( projectile_hit_event.hit_quad_index ) < quads.size() )
		{
			EmitProjectileHitSound(
				game_state.static_sound_sources,
				weapon_tool,
				GetMaterialPropertiesForMapQuad( global_data, map_data, projectile_hit_event.hit_quad_index ),
				projectile_hit_event.position );
		}
		else if( projectile_hit_event.hit_entity_index != ~0u )
		{
			EmitProjectileObjectHitSound( game_state.static_sound_sources, weapon_tool, projectile_hit_event.position );
		}

		if( weapon_tool.splash_damage_area_size > 0u )
		{
			// Projectiles with splash damage emit explosion sounds.
			EmitExplosionSound(
				game_state.static_sound_sources,
				global_data.sounds_description.deref(),
				projectile_hit_event.position );
		}

		// Alarm entities by nearby projectile hits.
		AlarmEnemiesByNearbyEvent(
			game_state.colliders,
			game_state.entities,
			projectile_hit_event.position,
			c_projectile_hit_enemy_alarm_max_distance );
	}

	game_state.projectile_hit_events.clear();
}

fn ApplySplashDamage(
	SoundsDescription& sounds_description,
	Vec3f& center,
	f32 radius,
	f32 splash_base_damage,
	PseudoRandomGenerator &mut rand,
	ust::array_view_imut</Collider/> colliders,
	ust::array_view_mut</ust::optional</EntityState/>/> entities,
	PlayerState &mut player,
	u32 ignore_entity_index )
{
	foreach( &collider : colliders )
	{
		if( collider.entity_index == ignore_entity_index )
		{
			continue;
		}

		var Vec3f bbox_dimensions= collider.bbox.GetDimensions();
		var f32 approximate_bbox_radius=
			0.5f * ust::min( bbox_dimensions.x, ust::min( bbox_dimensions.y, bbox_dimensions.z ) );

		// Calculate approximate distance to the edge of a sphere roughly representing this bbox.
		var f32 distane=
			ust::max(
				0.0f,
				( collider.bbox.GetCenter() - center ).Length() - approximate_bbox_radius );

		if( distane < radius )
		{
			// Use simple linear distance to damage relation.
			var f32 damage_fraction= 1.0f - distane / radius;

			var f32 damage_at_distance= splash_base_damage * damage_fraction;

			// Perform rounding with random - to avoid systematic error when dealing small amounts of damage.
			var u32 damage_at_distance_rounded(
				damage_at_distance + f32( rand.Next() ) / f32( PseudoRandomGenerator::c_max_plus_one ) );

			DamageEntityOrPlayer(
				sounds_description, entities, player, collider.entity_index, damage_at_distance_rounded );
		}
	}
}

fn AlarmEnemiesByNearbyEvent(
	ust::array_view_imut</Collider/> colliders,
	ust::array_view_mut</ust::optional</EntityState/>/> entities,
	Vec3f& center,
	f32 max_alarm_distance )
{
	var f32 max_alarm_distance_squared= max_alarm_distance * max_alarm_distance;

	foreach( &collider : colliders )
	{
		var f32 distance_squared= ( collider.bbox.GetCenter() - center ).SquareLength();

		if( distance_squared <= max_alarm_distance_squared )
		{
			var size_type entity_index( collider.entity_index );
			if( entity_index < entities.size() )
			{
				if_var( &mut entity : entities[ entity_index ] )
				{
					entity.alarmed= true;
				}
			}
		}
	}
}

fn ProcessDamagingFlamesLogicStep(
	GameGlobalData& global_data,
	DamagingFlamesContainer &mut damaging_flames,
	PseudoRandomGenerator &mut rand,
	ust::array_view_mut</ ust::optional</EntityState /> /> entities,
	PlayerState &mut player )
{
	/*
		In the original game damaging flames work in the following way:
			For each game logic step with ( step_number & game_params.fire_damage[0] ) == 0 flame damage is applied.
			Value from game_params.fire_damage[1] is divided by 16 to obtain damage from this flame.
			Damage from all flames is accumulated for each entity and rounded down to nearest integer.
			Since game_params.fire_damage[1] value is set to 8 in settings, a single flame doesn't deal damage at all.

		We do this differently:
			Damaging step for each projectile is calculated individually, so that many flames deal damage in a smooth way.
			A little bit of random is added to damage to compensate rounding errors, so that even single flame damages sometimes.
	*/

	var GameParams& game_params= global_data.game_params.deref();

	var u32 damage_step_mask= game_params.fire_damage[0];
	var u32 base_flame_damage= game_params.fire_damage[1];
	var u32 constexpr c_flame_damage_divisor= 16u;

	damaging_flames.Retain(
		lambda[&]( DamagingFlame &mut damaging_flame ) : bool
		{
			if( ( damaging_flame.age_steps & damage_step_mask ) == 0u )
			{
				var u32 damage= ( base_flame_damage + rand.Next() % c_flame_damage_divisor ) / c_flame_damage_divisor;
				if( damage > 0u )
				{
					DamageEntityOrPlayer(
						global_data.sounds_description.deref(), entities, player, damaging_flame.entity_index, damage );
				}
			}

			++damaging_flame.age_steps;

			return damaging_flame.age_steps < c_damaging_flame_max_age;
		} );
}

fn ProcessProjectileHitSmokeEmittersLogicStep( GameState& mut game_state )
{
	auto &mut projectile_hit_smoke_particles= game_state.projectile_hit_smoke_particles;

	game_state.projectile_hit_smoke_emitters.Retain(
		lambda[&]( ProjectileHitSmokeEmitter &mut smoke_emitter ) : bool
		{
			projectile_hit_smoke_particles.Insert(
				ProjectileHitSmokeParticle
				{
					.position= smoke_emitter.position,
					.initial_direction= smoke_emitter.hit_point_normal,
					.age_steps= 0u,
				} );

			++smoke_emitter.age_steps;

			return smoke_emitter.age_steps < c_projectile_hit_smoke_emitter_max_age;
		} );
}

fn ProcessProjectileHitSmokeParticlesLogicStep(
	ProjectileHitSmokeParticlesContainer &mut projectile_hit_smoke_particles )
{
	projectile_hit_smoke_particles.Retain(
		lambda( ProjectileHitSmokeParticle &mut smoke_particle ) : bool
		{
			var f32 constexpr speed= 1.0f;
			var f32 constexpr vertical_acceleration= -0.5f;

			// Apply only horizontal speed as usual.
			smoke_particle.position.x+= smoke_particle.initial_direction.x * speed;
			smoke_particle.position.y+= smoke_particle.initial_direction.y * speed;

			// Apply vertical speed only if it's directed down.
			if( smoke_particle.initial_direction.z > 0.0f )
			{
				smoke_particle.position.z+= smoke_particle.initial_direction.z * speed;
			}

			smoke_particle.position.z+= f32( smoke_particle.age_steps ) * ( vertical_acceleration * 0.5f );

			++smoke_particle.age_steps;

			return smoke_particle.age_steps < c_projectile_hit_smoke_particle_max_age;
		} );
}

fn ProcessBreakingGlassLogicStep( BreakingGlassEffectsContainer &mut breaking_glass_effects )
{
	breaking_glass_effects.Retain(
		lambda( BreakingGlassEffect &mut breaking_glass_effect ) : bool
		{
			++breaking_glass_effect.age_steps;
			return breaking_glass_effect.age_steps < c_breaking_glass_max_age;
		} );
}

fn ProcessMuzzleFlashesLogicStep( MuzzleFlashesContainer &mut muzzle_flashes )
{
	muzzle_flashes.Retain(
		lambda( MuzzleFlash &mut muzzle_flash ) : bool
		{
			++muzzle_flash.age_steps;
			return muzzle_flash.age_steps < c_muzzle_flash_max_age;
		} );
}

fn ProcessSparkParticlesLogicStep( SparkParticlesContainer &mut spark_particles )
{
	spark_particles.Retain(
		lambda( SparkParticle &mut spark_particle ) : bool
		{
			spark_particle.position+= spark_particle.velocity;

			var f32 c_sparks_gravity= 1.0f;

			spark_particle.velocity.z+= c_sparks_gravity;

			++spark_particle.age_steps;
			return spark_particle.age_steps < c_spark_particle_max_age;
		} );
}

fn ProcessExplosionParticlesLogicStep( ExplosionParticlesContainer &mut explosion_particles )
{
	explosion_particles.Retain(
		lambda( ExplosionParticle &mut explosion_particle ) : bool
		{
			++explosion_particle.age_steps;
			return explosion_particle.age_steps < c_explosion_particle_max_age;
		} );
}

fn ProcessFlameParticlesLogicStep( GameState &mut game_state )
{
	auto& dynamic_cluster_colliders= game_state.dynamic_cluster_colliders;

	game_state.flame_particles.Retain(
		lambda[&]( FlameParticle &mut flame_particle ) : bool
		{
			if( size_type( flame_particle.dynamic_cluster_object_index ) < dynamic_cluster_colliders.size() )
			{
				var DynamicClusterCollider& collider=
					dynamic_cluster_colliders[ size_type( flame_particle.dynamic_cluster_object_index ) ];
				flame_particle.position= flame_particle.relative_position + collider.bbox.GetCenter();
			}

			++flame_particle.age_steps;

			return flame_particle.age_steps < c_flame_particle_max_age;
		} );
}

fn ProcessSmokeParticlesLogicStep( SmokeParticlesContainer &mut smoke_particles )
{
	smoke_particles.Retain(
		lambda( SmokeParticle &mut smoke_particle ) : bool
		{
			smoke_particle.center+= smoke_particle.velocity;

			// The original game animates smoke particles, so that their way is a conical spiral.

			var f32 amplitude= f32( smoke_particle.age_steps ) * smoke_particle.velocity.Length() * 0.1f;

			var f32 phase=
				// Perform time-based phase shift.
				f32( smoke_particle.age_steps ) * 0.2f +
				// Use individual phase shifts for each particle, so that particles don't follow the same path.
				f32( smoke_particle.sequential_index ) * ( c_tau / c_golden_ratio ) +
				// Shift phase based on X and Y coordinates, so that nearby smoke emitters are not in sync.
				( smoke_particle.center.x + smoke_particle.center.y );

			smoke_particle.position=
				smoke_particle.center +
				Vec3f( amplitude * ust::cos( phase ), amplitude * ust::sin( phase ), 0.0f );

			++smoke_particle.age_steps;

			return smoke_particle.age_steps < c_smoke_particle_max_age;
		} );
}

fn ProcessSmokeTrailParticlesLogicStep( SmokeTrailParticlesContainer &mut smoke_trail_particles )
{
	smoke_trail_particles.Retain(
		lambda( SmokeTrailParticle &mut smoke_trail_particle ) : bool
		{
			if( smoke_trail_particle.kind == EntitiesDescription::Tool::c_smoke_trail_kind_rocket )
			{
				// Rocket trail particles move slightly upwards.
				smoke_trail_particle.position.z -= 2.0f;
			}
			else if( smoke_trail_particle.kind == EntitiesDescription::Tool::c_smoke_trail_kind_flamethrower )
			{
				// Flamethrower trail particles move a little bit upwards.
				smoke_trail_particle.position.z -= 0.5f;
			}

			++smoke_trail_particle.age_steps;

			return smoke_trail_particle.age_steps < c_smoke_trail_particle_max_age;

		} );
}

fn AddMuzzleLight( MuzzleLightsContainer &mut muzzle_lights, MuzzleLight mut new_muzzle_light )
{
	// If there is already a muzzle light for this entity - remove it.
	// Don't stack muzzle lights for the same entity atop of each other, since it's too costly to draw them.
	// So, just replace old one with new one.
	// It's not a huge problem to use here linear search, since maximum number of muzzle lights is pretty small.
	muzzle_lights.Retain(
		lambda[ entity_index= new_muzzle_light.owner_entity_index ] ( MuzzleLight& muzzle_light ) : bool
		{
			return muzzle_light.owner_entity_index != entity_index;
		} );

	muzzle_lights.Insert( move(new_muzzle_light ) );
}

fn ProcessMuzzleLightsLogicStep( MuzzleLightsContainer &mut muzzle_lights )
{
	muzzle_lights.Retain(
		lambda( MuzzleLight &mut muzzle_light ) : bool
		{
			++muzzle_light.age_steps;
			return muzzle_light.age_steps < c_muzzle_light_max_age;
		} );
}

fn ProcessProjectileHitLightsLogicStep( ProjectileHitLightsContainer &mut projectile_hit_lights )
{
	projectile_hit_lights.Retain(
		lambda( ProjectileHitLight &mut projectile_hit_light ) : bool
		{
			++projectile_hit_light.age_steps;
			return projectile_hit_light.age_steps < c_projectile_hit_light_max_age;
		} );
}

fn PickUpItems( SoundsDescription& sounds_description, GameMapData& map_data, GameState &mut game_state )
{
	if( game_state.player.energy == 0u )
	{
		return;
	}

	if( game_state.player.collider_index == ~0u )
	{
		return;
	}

	var BBox3f player_bbox= game_state.colliders[ size_type( game_state.player.collider_index ) ].bbox;

	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	for( auto mut entity_index= 0s; entity_index < game_state.entities.size(); ++entity_index )
	{
		var bool mut need_to_remove_entity= false;

		if_var( &entity : game_state.entities[entity_index] )
		{
			var EntitiesDescription::EntityDescription& entity_description=
				entities_description.entities[ size_type( entity.kind ) ];

			var EntitiesDescription::Operation& operation=
				entity_description.operations[ size_type( entity.current_operation ) ];

			if_var( &box_contents : operation.box_contents )
			{
				var Vec3f bbox_center=
					entity.position +
					Vec3f(
						f32( operation.animation.bounding_box_center_x ),
						f32( operation.animation.bounding_box_center_y ),
						f32( operation.animation.bounding_box_center_z ) );

				var Vec3f bbox_half_size(
					f32( operation.animation.bounding_box_half_size_x ),
					f32( operation.animation.bounding_box_half_size_y ),
					f32( operation.animation.bounding_box_half_size_z ) );

				var BBox3f entity_bbox
				{
					.min= bbox_center - bbox_half_size,
					.max= bbox_center + bbox_half_size,
				};

				if( player_bbox.Instersects( entity_bbox ) )
				{
					var size_type tool_index( entities_description.tool_type_to_index_map[ size_type( box_contents.tool_type ) ] );
					if( tool_index < entities_description.tools.size() )
					{
						var EntitiesDescription::Tool& tool= entities_description.tools[ tool_index ];

						if( tool.tool_type == EntitiesDescription::ToolType::HealthPack )
						{
							// The original game does something wired.
							// Player has some extra place in inventory for energy, where extra energy may be stored.
							// If a health-box is picked-up, not only contents of the box is applied, but also energy from inventory.

							var u32 box_energy= box_contents.amount;

							var u32 &mut player_energy= game_state.player.energy;

							var u32 &mut inventory_energy=
								game_state.player.inventory[ size_type(EntitiesDescription::ToolType::HealthPack) ];

							var u32 mut total_energy= box_energy + player_energy + inventory_energy;

							player_energy= ust::min( total_energy, GetPlayerStartEnergy( entities_description ) );
							total_energy-= player_energy;

							inventory_energy= ust::min( total_energy, tool.player_max_count );
							total_energy-= inventory_energy;

							if( total_energy < box_energy )
							{
								EmitPickupSound(
									sounds_description,
									EntitiesDescription::ToolType::HealthPack,
									game_state.player.sound_source_slots );

								need_to_remove_entity= true;
							}
						}
						else if( tool.tool_type == EntitiesDescription::ToolType::Armor )
						{
							// Use the same approach for armor as for energy.
							// Apply all armor to the current armor level, store the rest in inventory.
							// Also apply armor from inventory if current armor level isn't full.
							// TODO - investigate whether it's correct.

							var u32 box_armor= box_contents.amount;

							var u32 &mut player_armor= game_state.player.armor;

							var u32 &mut inventory_armor=
								game_state.player.inventory[ size_type(EntitiesDescription::ToolType::Armor) ];

							var u32 mut total_armor= box_armor + player_armor + inventory_armor;

							var u32 max_player_armor= GetPlayerMaxArmor( entities_description );

							player_armor= ust::min( total_armor, max_player_armor );
							total_armor-= player_armor;

							inventory_armor= ust::min( total_armor, tool.player_max_count );
							total_armor-= inventory_armor;

							if( total_armor < box_armor )
							{
								EmitPickupSound(
									sounds_description,
									EntitiesDescription::ToolType::Armor,
									game_state.player.sound_source_slots );

								need_to_remove_entity= true;
							}
						}
						else
						{
							var u32 &mut current_count= game_state.player.inventory[ size_type( box_contents.tool_type ) ];
							if( current_count < tool.player_max_count )
							{
								// If picked up a new weapon switch to it.
								if( current_count == 0u &&
									box_contents.amount != 0u &&
									box_contents.tool_type >= EntitiesDescription::ToolType::WeaponA &&
									box_contents.tool_type <= EntitiesDescription::ToolType::WeaponJ )
								{
									game_state.player.primary_weapon_state.requested_weapon= box_contents.tool_type;
								}

								current_count+= box_contents.amount;
								ust::min_assign( current_count, tool.player_max_count );

								need_to_remove_entity= true;
							}
						}

						if( box_contents.ammo > 0u &&
							tool.ammo_item >= 0 &&
							size_type( tool.ammo_item ) < entities_description.tools.size() )
						{
							var EntitiesDescription::Tool& ammo_tool= entities_description.tools[ size_type( tool.ammo_item ) ];

							var u32 &mut current_count= game_state.player.inventory[ size_type( ammo_tool.tool_type ) ];
							if( current_count < ammo_tool.player_max_count )
							{
								current_count+= box_contents.ammo;
								ust::min_assign( current_count, ammo_tool.player_max_count );

								need_to_remove_entity= true;
							}
						}

						if( need_to_remove_entity )
						{
							EmitPickupSound( sounds_description, tool.tool_type, game_state.player.sound_source_slots );
						}

						// TODO - handle regenerating entities in multiplayer.
					}
				}
			}
		}

		if( need_to_remove_entity )
		{
			RemoveEntityCollider( entity_index, game_state );
			game_state.entities[ entity_index ].reset();
		}
	}
}

fn DealPlayerEnvironmentalDamage(
	SoundsDescription& sounds_description, GameMapData& map_data, GameState &mut game_state )
{
	if( game_state.step_index % c_environmental_damage_period_steps != 0u )
	{
		return;
	}

	if( size_type( game_state.player.collider_index ) >= game_state.colliders.size() )
	{
		return;
	}

	var BBox3f& player_bbox= game_state.colliders[ size_type( game_state.player.collider_index ) ].bbox;

	var bool mut is_in_acid= false, mut is_in_lava= false;

	var ust::array_view_imut</ZvoxCluster/> clusters= map_data.zvox_data.deref().clusters;

	VisitBoundingBoxesHierarchyForBBox(
		map_data.room_clusters_hierarchy.deref(),
		player_bbox,
		lambda[&]( ClusterIndexInHierarchy c )
		{
			var ZvoxCluster& cluster= clusters[ size_type(c) ];
			if( CreateClusterBBox( cluster ).Instersects( player_bbox ) )
			{
				is_in_acid |= cluster.contents == ZvoxCluster::c_contents_acid;
				is_in_lava |= cluster.contents == ZvoxCluster::c_contents_lava;
			}
		} );

	if( ( is_in_acid & !game_state.player.tools_state.acid_protection_suit_is_active ) | is_in_lava )
	{
		// Armor can't absorb environmental damage, so that only energy is damaged.

		var u32 damage= ust::min( c_environmental_damage, game_state.player.energy );
		if( damage > 0u )
		{
			game_state.player.energy-= damage;

			if( game_state.player.energy == 0u )
			{
				EmitPlayerDeathSound( sounds_description, game_state.player.sound_source_slots );
			}
			else
			{
				// Emit damage sound if is damaged in acid or lava.
				// TODO - check if the original game does this.
				EmitPlayerDamageSound( sounds_description, game_state.player.sound_source_slots );
			}
		}
	}
}

// Returns next map index if requires map transition or 0 if requires no one.
fn InteractWithTriggerVolumes(
	SoundsDescription& sounds_description, GameMapData& map_data, GameState &mut game_state ) : u32
{
	var u32 mut next_map_index= 0u;

	if( game_state.player.energy == 0u )
	{
		// Dead player can't interact with triger volumes.
		return next_map_index;
	}

	if( size_type( game_state.player.collider_index ) >= game_state.colliders.size() )
	{
		return next_map_index;
	}

	var BBox3f& player_bbox= game_state.colliders[ size_type( game_state.player.collider_index ) ].bbox;

	var ust::array_view_imut</ZvoxTriggerVolume/> trigger_volumes= map_data.zvox_data.deref().trigger_volumes;

	for( var size_type mut trigger_volumen_index= 0s; trigger_volumen_index < trigger_volumes.size(); ++trigger_volumen_index )
	{
		var ZvoxTriggerVolume& trigger_volume= trigger_volumes[ trigger_volumen_index ];

		var BBox3f trigger_bbox
		{
			.min(
				f32( trigger_volume.center[0] - trigger_volume.bounding_box_half_size[0] ),
				f32( trigger_volume.center[1] - trigger_volume.bounding_box_half_size[1] ),
				f32( trigger_volume.center[2] - trigger_volume.bounding_box_half_size[2] ) ),
			.max(
				f32( trigger_volume.center[0] + trigger_volume.bounding_box_half_size[0] ),
				f32( trigger_volume.center[1] + trigger_volume.bounding_box_half_size[1] ),
				f32( trigger_volume.center[2] + trigger_volume.bounding_box_half_size[2] ) ),
		};

		if( !player_bbox.InstersectsOrTouches( trigger_bbox ) )
		{
			continue;
		}

		// Assume we have no more than 32 triggers on a map.
		var u32 trigger_mask= 1u << trigger_volumen_index;

		switch( trigger_volume.trigger_type )
		{
			ZvoxTriggerVolume::c_trigger_type_map_end ->
			{
				next_map_index= u32( trigger_volume.trigger_param );
			},
			ZvoxTriggerVolume::c_trigger_type_secret_area ->
			{
				if( ( game_state.player.activated_triggers_mask & trigger_mask ) == 0u )
				{
					game_state.player.activated_triggers_mask |= trigger_mask;
					game_state.player.last_opened_secret_area_step= game_state.step_index;

					EmitSecretFoundSound( sounds_description, game_state.player.sound_source_slots );
				}
			},
			ZvoxTriggerVolume::c_trigger_type_character_speech ->
			{
				if( ( game_state.player.activated_triggers_mask & trigger_mask ) == 0u )
				{
					game_state.player.activated_triggers_mask |= trigger_mask;

					EmitPlayerSpeechSound( trigger_volume.trigger_param, game_state.player.sound_source_slots );
				}
			},
			ZvoxTriggerVolume::c_trigger_type_game_end ->
			{
				// TODO - show game end cinematics.
				// For now just trigger transition to a non-existing level.
				next_map_index= 99999u;
			},
			default -> {},
		}
	}

	return next_map_index;
}

fn CollideMovedEntityWithProjectiles(
	Vec3f& old_position,
	Vec3f& new_position,
	BBox3f& bbox,
	u32 entity_index,
	ProjectilesContainer &mut projectiles,
	ust::vector</ProjectileHitEvent/> &mut projectile_hit_events )
{
	if( old_position == new_position )
	{
		return;
	}

	// Find intersections of moved entity bbox with projectile points.
	// This is equivalent for calculating intersection of stationary bbox with a moved point.

	var Vec3f inverse_movement_vec= old_position - new_position;

	var BBox3f bbox_translated
	{
		.min= bbox.min + old_position,
		.max= bbox.max + old_position,
	};

	projectiles.Retain(
		lambda[&]( Projectile& projectile ) : bool
		{
			if( projectile.owner_entity_index != entity_index ) // Don't collide with owner.
			{
				if_var( &intersection_result :
					FindRayBBoxIntersection( projectile.position, inverse_movement_vec, bbox_translated ) )
				{
					if( !( intersection_result.near_point_distance >= 1.0f | intersection_result.far_point_distance <= 0.0f ) )
					{
						projectile_hit_events.push_back(
							ProjectileHitEvent
							{
								.weapon_tool_index= projectile.weapon_tool_index,
								.position= projectile.position,
								.hit_cluster_index= ~0u,
								.hit_quad_index= ~0u,
								.hit_entity_index= entity_index,
							} );

						return false; // Remove.
					}
				}
			}

			return true; // Preserve.
		} );
}

fn AddPlayerCollider( EntitiesDescription& entities_description, GameState &mut game_state )
{
	debug_assert( game_state.player.collider_index == ~0u, "Adding collider for player, which already has one!" );

	if( game_state.player.noclip )
	{
		return;
	}

	var BBox3f bbox= GetPlayerColliderBBox( entities_description, game_state.player.crouching_phase );

	var BBox3f mut bbox_translated
	{
		.min= bbox.min + game_state.player.position,
		.max= bbox.max + game_state.player.position,
	};

	game_state.player.collider_index= u32( game_state.colliders.size() );
	game_state.colliders.push_back( Collider{ .bbox= move(bbox_translated), .entity_index= c_player_entity_index } );
}

fn RemovePlayerCollider( GameState &mut game_state )
{
	var u32 collider_index= game_state.player.collider_index;
	game_state.player.collider_index= ~0u;

	debug_assert(
		collider_index == ~0u || size_type( collider_index ) < game_state.colliders.size(),
		"Invalid collider index!" );

	if( size_type( collider_index ) >= game_state.colliders.size() )
	{
		return;
	}

	if( size_type( collider_index ) + 1s == game_state.colliders.size() )
	{
		game_state.colliders.drop_back();
	}
	else
	{
		var Collider mut last_collider= game_state.colliders.pop_back();

		if( last_collider.entity_index == c_player_entity_index )
		{
			game_state.player.collider_index= collider_index;
		}
		else
		{
			if_var( &mut last_collider_entity : game_state.entities[ size_type( last_collider.entity_index ) ] )
			{
				last_collider_entity.collider_index= collider_index;
			}
		}

		game_state.colliders[ size_type( collider_index ) ]= move( last_collider );
	}
}

fn AddEntityCollider(
	EntitiesDescription& entities_description,
	size_type entity_index,
	GameState &mut game_state )
{
	if_var( &mut entity : game_state.entities[ entity_index ] )
	{
		debug_assert( entity.collider_index == ~0u, "Should not add entity collider if already has one!" );

		var EntitiesDescription::EntityDescription& entity_description=
			entities_description.entities[ size_type( entity.kind ) ];

		if( entity_description.mode == EntitiesDescription::EntityDescription::c_mode_pickup )
		{
			// Pick-ups don't collide with other entities.
			return;
		}

		var EntitiesDescription::Operation& operation=
			entity_description.operations[ size_type( entity.current_operation ) ];

		var ust::optional</BBox3f/> mut collider_bbox= CalculateEntityColliderBBox( entity, operation );

		if( !collider_bbox.empty() )
		{
			entity.collider_index= u32( game_state.colliders.size() );
			game_state.colliders.push_back( Collider{ .bbox= collider_bbox.try_take(), .entity_index( entity_index ) } );
		}
	}
}

fn CalculateEntityColliderBBox( EntityState& entity, EntitiesDescription::Operation& operation ) : ust::optional</BBox3f/>
{
	// Directional animation is used only by the tank enemy on map 24.
	// If it's present - used bbox for it.
	if( operation.directional_animation.num_steps > 0u )
	{
		return
			CaclulateColliderBBoxForOperationAnimation(
				entity,
				operation.directional_animation,
				Convert1024Angle( f32( operation.directional_animation.direction ) ) );
	}

	return CaclulateColliderBBoxForOperationAnimation( entity, operation.animation, entity.azimuth );
}

fn CaclulateColliderBBoxForOperationAnimation(
	EntityState& entity,
	EntitiesDescription::OperationAnimationDescription& anim,
	f32 bbox_angle ) : ust::optional</BBox3f/>
{
	if( anim.num_steps == 0u )
	{
		return ust::null_optional;
	}

	if( anim.bounding_box_half_size_x == 0 ||
		anim.bounding_box_half_size_y == 0 ||
		anim.bounding_box_half_size_z == 0 )
	{
		// Entities with at least one zero collider dimentsion don't collide with each other.
		return ust::null_optional;
	}

	var Vec3f mut bbox_half_size(
		f32( anim.bounding_box_half_size_x ),
		f32( anim.bounding_box_half_size_y ),
		f32( anim.bounding_box_half_size_z ) );

	RotateEntityBBox( bbox_half_size, bbox_angle );

	var Vec3f bbox_center=
		entity.position +
		Vec3f(
			f32( anim.bounding_box_center_x ),
			f32( anim.bounding_box_center_y ),
			f32( anim.bounding_box_center_z ) );

	return BBox3f{ .min= bbox_center - bbox_half_size, .max= bbox_center + bbox_half_size };
}

fn RemoveEntityCollider(
	size_type entity_index,
	GameState &mut game_state )
{
	if( game_state.entities[ entity_index ].empty() )
	{
		return;
	}

	var u32 collider_index= game_state.entities[ size_type( entity_index ) ].try_deref().collider_index;
	game_state.entities[ size_type( entity_index ) ].try_deref().collider_index= ~0u;

	debug_assert(
		collider_index == ~0u || size_type( collider_index ) < game_state.colliders.size(),
		"Invalid collider index!" );

	if( size_type( collider_index ) >= game_state.colliders.size() )
	{
		return;
	}

	if( size_type( collider_index ) + 1s == game_state.colliders.size() )
	{
		game_state.colliders.drop_back();
	}
	else
	{
		var Collider mut last_collider= game_state.colliders.pop_back();

		if( last_collider.entity_index == c_player_entity_index )
		{
			game_state.player.collider_index= collider_index;
		}
		else
		{
			if_var( &mut last_collider_entity : game_state.entities[ size_type( last_collider.entity_index ) ] )
			{
				last_collider_entity.collider_index= collider_index;
			}
		}

		game_state.colliders[ size_type( collider_index ) ]= move( last_collider );
	}
}

fn UpdateEntityPlayerInSightFlag(
	GameMapData& map_data,
	BitArrayView broken_quad_bits,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	EntitiesDescription::EntityDescription& entity_description,
	EntityState &mut entity,
	PlayerState& player_state )
{
	entity.player_is_in_sight= false;

	if( entity_description.mode != EntitiesDescription::EntityDescription::c_mode_enemy )
	{
		// Non-enemy entities don't use player in sight flag.
		return;
	}

	if( entity.energy == 0u )
	{
		// Dead entities don't care about player visibility.
		return;
	}

	if( player_state.invisibility )
	{
		// Entities can't see invisible player.
		return;
	}

	// Check if player is in sight.

	// Don't care about other entities (even decorations).
	// Assume enemies can see through other entities and only map geometry blocks the view.

	var EntitiesDescription::Operation& operation=
		entity_description.operations[ size_type( entity.current_operation ) ];

	if( operation.animation_kind != EntitiesDescription::Operation::AnimationKind::Forward )
	{
		// No regular animation means no bbox.
		return;
	}

	var Vec3f trace_end= GetEntityPointForPlayerVisibilityTrace( entity.position, operation.animation );
	var Vec3f trace_start= GetPlayerPointForEntityVisibilityTrace( player_state.position, player_state.crouching_phase );

	if( trace_start == trace_end )
	{
		entity.player_is_in_sight= true;
		return;
	}

	if( entity.alarmed )
	{
		// Assume that alarmed enemies can turn their heads in any direction near instantly to see the player.
	}
	else
	{
		// Check if player is in field of view for non-alarmed enemies.
		// This check shoud be performing before performing expensive line tracing.

		var Vec2f vector_to_player_xy= trace_start.xy() - trace_end.xy();
		var f32 vector_to_player_xy_length= vector_to_player_xy.Length();
		if( vector_to_player_xy_length > 0.0f )
		{
			var Vec2f entity_direction_vector_xy= GetEntityDirectionNormalizedVector( entity );

			var f32 horizontal_angle_cos=
				entity_direction_vector_xy.Dot( vector_to_player_xy ) / vector_to_player_xy_length;

			var f32 vertical_angle_tan= ( trace_start.z - trace_end.z ) / vector_to_player_xy_length;

			var bool is_in_field_of_view=
				// Has horizontal field of view equal to 120 degrees.
				horizontal_angle_cos >= 0.5f &&
				// Has vertical field of view equal to 120 degrees.
				ust::abs( vertical_angle_tan ) <= c_sqrt_3;

			if( !is_in_field_of_view )
			{
				return;
			}
		}
	}

	var Vec3f trace_vector= trace_end - trace_start;
	if_var( &trace_result :
			LineTrace( map_data, broken_quad_bits, dynamic_cluster_colliders, trace_start, trace_vector ) )
	{
		if( trace_result.distance >= 1.0f )
		{
			entity.player_is_in_sight= true;
		}
	}
	else
	{
		entity.player_is_in_sight= true;
	}

	if( entity.player_is_in_sight )
	{
		entity.last_seen_player_position= player_state.position;
	}
}

struct RouteSearchContext
{
	GlobalNavigationGraphRouteSearcher &mut route_searcher;

	// Total number of nodes visited within this game logic step.
	size_type num_nodes_visited;
}

fn UpdateEntityMovementTarget(
	GameMapData& map_data,
	BitArrayView broken_quad_bits,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	RouteSearchContext &mut route_search_context,
	EntitiesDescription::EntityDescription& entity_description,
	EntityState& entity,
	EntityNavigationState &mut navigation_state,
	PseudoRandomGenerator& mut random,
	u32 current_step_index )
{
	if( entity.energy == 0u )
	{
		// An optimization - no need to update movement target for dead enemies.
		return;
	}

	var EntitiesDescription::Operation& operation=
		entity_description.operations[ size_type( entity.current_operation ) ];

	if_var( &operation_control : operation.operation_control )
	{
		if( operation_control.speed == 0u )
		{
			// Don't care selecting movement target if has zero speed.
			// Select it later if movement is possible.
			return;
		}
		if( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_sky_decoration )
		{
			// Sky decorations don't use global navigation graph for their movement.
			return;
		}
	}
	else
	{
		// Don't require movement target if has no operation control.
		return;
	}

	var bool mut large_entity= false;

	if( operation.animation_kind != EntitiesDescription::Operation::AnimationKind::None )
	{
		var Vec3f bbox_half_size(
			f32( operation.animation.bounding_box_half_size_x ),
			f32( operation.animation.bounding_box_half_size_y ),
			f32( operation.animation.bounding_box_half_size_z ) );

		var Vec3f bbox_center(
			f32( operation.animation.bounding_box_center_x ),
			f32( operation.animation.bounding_box_center_y ),
			f32( operation.animation.bounding_box_center_z ) );

		var BBox3f bbox{ .min= bbox_center - bbox_half_size, .max= bbox_center + bbox_half_size };

		large_entity= !map_data.global_navigation_graph.node_bbox.Contains( bbox );
	}

	if( navigation_state.current_navigation_graph_node == GlobalNavigationGraph::c_invalid_node_index )
	{
		// Attach to the navigation graph if has no current node.
		if_var( node_index : FindNearestNavigationGraphNode( map_data, broken_quad_bits, entity.position, large_entity ) )
		{
			navigation_state.current_navigation_graph_node= node_index;
		}

		if( navigation_state.current_navigation_graph_node == GlobalNavigationGraph::c_invalid_node_index )
		{
			// Failed to attach.
			return;
		}
	}
	else
	{
		// Re-attach to the navigation graph if is too far away from the current navigation graph node.
		// It's necessary for non-graph-based movement modes (like movement towards the player).
		// It's also needed for rare cases if an enemy has fallen down.

		var Vec3f& node_position=
			map_data.global_navigation_graph.nodes[ size_type( navigation_state.current_navigation_graph_node ) ].position;

		var f32 max_distance= 1.5f * map_data.global_navigation_graph.nodes_spacing;

		var f32 square_distance= ( node_position - entity.position ).SquareLength();

		if( square_distance > max_distance * max_distance )
		{
			if_var( node_index : FindNearestNavigationGraphNode( map_data, broken_quad_bits, entity.position, large_entity ) )
			{
				if( node_index != navigation_state.current_navigation_graph_node )
				{
					navigation_state.current_navigation_graph_node= node_index;

					var GlobalNavigationGraph::NodeIndex next_waypoint= navigation_state.route[0];

					if( next_waypoint != GlobalNavigationGraph::c_invalid_node_index &&
						next_waypoint != node_index )
					{
						// Check if it's still possible to move to the next waypoint from the newly-identified current node.
						// If it's not possible - reset it to trigger route recalculation.

						var bool mut next_waypoint_is_reachable= false;

						var GlobalNavigationGraph::Node& current_node=
							map_data.global_navigation_graph.nodes[ size_type( navigation_state.current_navigation_graph_node ) ];

						foreach( &edge :
							map_data.global_navigation_graph.node_output_edges.range().subrange(
								size_type( current_node.first_output_edge ),
								size_type( current_node.first_output_edge ) + size_type( current_node.num_output_edges ) ) )
						{
							next_waypoint_is_reachable|= edge.dst_node_index == next_waypoint;
						}

						if( !next_waypoint_is_reachable )
						{
							SaveEntityRoute( ust::empty_range, navigation_state );
						}
					}
				}
			}
		}
	}

	if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index &&
		navigation_state.current_navigation_graph_node == navigation_state.target_navigation_graph_node )
	{
		// Reached the target. Reset it to select new target.
		navigation_state.target_navigation_graph_node= GlobalNavigationGraph::c_invalid_node_index;
	}

	if( entity.alarmed && !entity.last_seen_player_position.empty() )
	{
		var Vec3f& player_position= entity.last_seen_player_position.try_deref();

		if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index &&
			navigation_state.route[0] == GlobalNavigationGraph::c_invalid_node_index )
		{
			// No intermediate points are left.
			// Just reset the target in such case.
			// We don't care preserving the target in alarmed mode in any cost.
			// If we need to recalculate a route, use this opportunity to select more actual target.
			navigation_state.target_navigation_graph_node= GlobalNavigationGraph::c_invalid_node_index;
		}

		var EntityDistanceRanges distance_ranges= GetEntityDistanceRanges( entity_description );

		var f32 optimal_square_distance_min=
			distance_ranges.optimal.distance_min * distance_ranges.optimal.distance_min;
		var f32 optimal_square_distance_max=
			distance_ranges.optimal.distance_max * distance_ranges.optimal.distance_max;
		var f32 good_enough_square_distance_min=
			distance_ranges.good_enough.distance_min * distance_ranges.good_enough.distance_min;
		var f32 good_enough_square_distance_max=
			distance_ranges.good_enough.distance_max * distance_ranges.good_enough.distance_max;

		var bool is_in_panic_mode=
			// First condition is necessary to disable out-of-ammo panic if panic is disabled.
			entity_description.panic > 0u &&
			// TODO - make sure <= should be used here instead of <.
			( entity.energy <= entity_description.panic || entity.ammo == 0u );

		if( is_in_panic_mode )
		{
			var f32 min_square_distance_for_panic_mode= good_enough_square_distance_max;

			var bool mut navigation_target_needs_update= false;

			if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index )
			{
				// Check if current target is close enough to the player.
				// If so - request navigation target recalculation.

				var GlobalNavigationGraph::Node& node=
					map_data.global_navigation_graph.nodes[ size_type( navigation_state.target_navigation_graph_node ) ];

				var f32 square_distance= ( node.position - player_position ).SquareLength();

				if( square_distance < min_square_distance_for_panic_mode )
				{
					navigation_target_needs_update= true;
				}
			}
			else
			{
				navigation_target_needs_update= true;
			}

			if( navigation_target_needs_update )
			{
				// First check nodes connected to current one.
				// Select a node leading away from the player.

				var Vec2f direction_to_player= player_position.xy() - entity.position.xy();
				var Vec2f direction_to_player_normalized= direction_to_player / ( direction_to_player.Length() + 0.0001f );

				var GlobalNavigationGraph::Node& current_node=
					map_data.global_navigation_graph.nodes[ size_type( navigation_state.current_navigation_graph_node ) ];

				var GlobalNavigationGraph::NodeIndex mut best_node_index= GlobalNavigationGraph::c_invalid_node_index;
				var f32 mut smallest_angle_cos= ust::plus_inf</f32/>();

				foreach( &edge :
					map_data.global_navigation_graph.node_output_edges.range().subrange(
						size_type( current_node.first_output_edge ),
						size_type( current_node.first_output_edge ) + size_type( current_node.num_output_edges ) ) )
				{
					var GlobalNavigationGraph::Node& node=
						map_data.global_navigation_graph.nodes[ size_type( edge.dst_node_index ) ];

					if( large_entity && !node.large )
					{
						continue;
					}

					var Vec2f direction_to_node= node.position.xy() - entity.position.xy();
					var f32 dot= direction_to_node.Dot( direction_to_player_normalized );

					if( dot < 0.0f ) // Consider only nodes leading away from the player.
					{
						var f32 angle_cos= dot / direction_to_node.Length();
						if( angle_cos < smallest_angle_cos )
						{
							smallest_angle_cos= angle_cos;
							best_node_index= edge.dst_node_index;
						}
					}
				}

				if( best_node_index != GlobalNavigationGraph::c_invalid_node_index )
				{
					SaveEntityRoute( ust::single_element_array_view( best_node_index ), navigation_state );
					navigation_state.target_navigation_graph_node= best_node_index;
				}
				else if(
					current_step_index >= navigation_state.last_route_search_step_index + EntityNavigationConstants::min_steps_between_route_searches &&
					route_search_context.num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_in_single_game_logic_step )
				{
					// A fallback for cases when an enemy is pushed into a corner with no way to move away from the player.
					// Perform more complex nearby nodes enumeration to find a way from this corner.

					var GlobalNavigationGraph::NodeIndex mut new_navigation_target_node=
						GlobalNavigationGraph::c_invalid_node_index;

					var size_type mut num_nodes_visited= 0s;

					route_search_context.route_searcher.EnumerateOutputNodes(
						map_data.global_navigation_graph,
						navigation_state.current_navigation_graph_node,
						large_entity,
						lambda[&]( GlobalNavigationGraph::NodeIndex node_index, u32 graph_distance ) : bool
						{
							ust::ignore_unused(graph_distance);

							if( node_index != navigation_state.current_navigation_graph_node )
							{
								var GlobalNavigationGraph::Node& node=
									map_data.global_navigation_graph.nodes[ size_type( node_index ) ];

								var f32 square_distance_from_node_to_player=
									( node.position - player_position ).SquareLength();

								if( square_distance_from_node_to_player >= min_square_distance_for_panic_mode )
								{
									// Found a node which is far enough from the player.
									// Select is as target and end the search.
									new_navigation_target_node= node_index;
									return false;
								}
							}

							++num_nodes_visited;
							return num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_for_panic_mode_search;
						} );

					// Remember time point at which a route search/nodes enumeration for this entity was executed.
					navigation_state.last_route_search_step_index= current_step_index;

					route_search_context.num_nodes_visited+= num_nodes_visited;

					if( new_navigation_target_node != GlobalNavigationGraph::c_invalid_node_index )
					{
						// Reconstruct a route after nodes enumeration.
						var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
							route_search_context.route_searcher.ReconstructRouteAfterNodesEnumeration( new_navigation_target_node );

						if( !route.empty() )
						{
							SaveEntityRoute( route, navigation_state );
							navigation_state.target_navigation_graph_node= new_navigation_target_node;
						}
					}
				}
			}
		}
		else if( entity.player_is_in_sight )
		{
			var f32 player_crouching_phase= 0.0f; // For line of sight check assume that the player is staying.

			var bool mut navigation_target_needs_update= false;

			if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index )
			{
				// Check if current target node is good enough and if the player is still visible from it.
				// If it's not the case - request navigation target update.

				var GlobalNavigationGraph::Node& node=
					map_data.global_navigation_graph.nodes[ size_type( navigation_state.target_navigation_graph_node ) ];

				var f32 square_distance= ( node.position - player_position ).SquareLength();

				var bool distance_good_enough=
					square_distance >= good_enough_square_distance_min &&
					square_distance <= good_enough_square_distance_max;

				if( distance_good_enough )
				{
					var Vec3f trace_start=
						GetPlayerPointForEntityVisibilityTrace( player_position, player_crouching_phase );

					var Vec3f trace_end= GetEntityPointForPlayerVisibilityTrace( node.position, operation.animation );

					if( trace_end != trace_start )
					{
						var Vec3f trace_vector= trace_end - trace_start;
						if_var( &trace_result :
								LineTrace(
									map_data,
									broken_quad_bits,
									dynamic_cluster_colliders,
									trace_start,
									trace_vector ) )
						{
							if( trace_result.distance < 1.0f )
							{
								// Player is no longer visible from this target.
								navigation_target_needs_update= true;
							}
						}
					}
				}
				else
				{
					navigation_target_needs_update= true;
				}
			}
			else
			{
				navigation_target_needs_update= true;
			}

			if( navigation_target_needs_update &&
				current_step_index >= navigation_state.last_route_search_step_index + EntityNavigationConstants::min_steps_between_route_searches &&
				route_search_context.num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_in_single_game_logic_step )
			{
				// Need a new target and a route to it.

				var f32 square_distance_to_player= ( player_position - entity.position ).SquareLength();

				if( square_distance_to_player < good_enough_square_distance_min )
				{
					// Is too close to the player.
					// Search for the nearest node (in graph distance units), which isn't too close to the player.

					// In the worst case we need to go to the player and past it. It's roughly 2 minimal distances.
					var u32 max_graph_distance_to_observe( distance_ranges.good_enough.distance_min * 2.5f );

					var GlobalNavigationGraph::NodeIndex mut new_navigation_target_node=
						GlobalNavigationGraph::c_invalid_node_index;

					var size_type mut num_nodes_visited= 0s;

					route_search_context.route_searcher.EnumerateOutputNodes(
						map_data.global_navigation_graph,
						navigation_state.current_navigation_graph_node,
						large_entity,
						lambda[&]( GlobalNavigationGraph::NodeIndex node_index, u32 graph_distance ) : bool
						{
							++num_nodes_visited;

							if( graph_distance > max_graph_distance_to_observe )
							{
								// Avoid observing the entire graph if failed to find a good position nearby.
								return false;
							}

							if( node_index == navigation_state.current_navigation_graph_node )
							{
								// Avoid selecting the current node as target.
								return true;
							}

							var GlobalNavigationGraph::Node& node=
								map_data.global_navigation_graph.nodes[ size_type( node_index ) ];

							var f32 square_distance_to_player= ( node.position - player_position ).SquareLength();

							if( square_distance_to_player >= good_enough_square_distance_min &&
								square_distance_to_player <= good_enough_square_distance_max )
							{
								// Find a node which is far enough from the player.
								// Check if it's possible to see the player from it.
								var Vec3f trace_start=
									GetPlayerPointForEntityVisibilityTrace( player_position, player_crouching_phase );

								var Vec3f trace_end= GetEntityPointForPlayerVisibilityTrace( node.position, operation.animation );

								if( trace_end != trace_start )
								{
									var Vec3f trace_vector= trace_end - trace_start;
									auto trace_result=
										LineTrace(
											map_data,
											broken_quad_bits,
											dynamic_cluster_colliders,
											trace_start,
											trace_vector );

									if( trace_result.empty() || trace_result.try_deref().distance >= 1.0f )
									{
										// Found a good target. Stop graph nodes enumeration.
										new_navigation_target_node= node_index;
										return false;
									}
								}
							}

							return true;
						} );

					// Remember time point at which a route search/nodes enumeration for this entity was executed.
					navigation_state.last_route_search_step_index= current_step_index;

					route_search_context.num_nodes_visited+= num_nodes_visited;

					if( new_navigation_target_node != GlobalNavigationGraph::c_invalid_node_index )
					{
						// Reconstruct a route after nodes enumeration.
						var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
							route_search_context.route_searcher.ReconstructRouteAfterNodesEnumeration( new_navigation_target_node );

						if( !route.empty() )
						{
							SaveEntityRoute( route, navigation_state );
							navigation_state.target_navigation_graph_node= new_navigation_target_node;
						}
					}
				}
				else if( square_distance_to_player > good_enough_square_distance_max )
				{
					// Is too far away from the player. Search a direct route towards him.

					if_var( player_node_index : FindNearestNavigationGraphNode( map_data, broken_quad_bits, player_position, large_entity ) )
					{
						var size_type mut num_nodes_visited= 0s;

						var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
							route_search_context.route_searcher.PerformDirectedSearch(
								map_data.global_navigation_graph,
								navigation_state.current_navigation_graph_node,
								player_node_index,
								large_entity,
								lambda[&]( GlobalNavigationGraph::NodeIndex node_index ) : bool
								{
									ust::ignore_unused( node_index );
									++num_nodes_visited;
									return num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_for_direct_route_search;
								} );

						// Remember time point at which a route search/nodes enumeration for this entity was executed.
						navigation_state.last_route_search_step_index= current_step_index;

						route_search_context.num_nodes_visited+= num_nodes_visited;

						if( !route.empty() )
						{
							// Found a route to the player.
							// Search for nodes in this route which are in optimal and good enough distance to the player.

							var size_type max_route_indices= 16s;
							var [ [ u16, max_route_indices ], 2 ] mut route_indices[ [ ~0u16 ... ] ... ]; // Optimal and good enough indices.
							var [ size_type, 2 ] mut num_indices[ 0s ... ]; // Optimal and good enough indices.

							for( auto mut i= 0s; i < route.size(); ++i )
							{
								var GlobalNavigationGraph::Node& node=
									map_data.global_navigation_graph.nodes[ size_type( route[i] ) ];

								var f32 node_square_distance_to_player= ( node.position - player_position ).SquareLength();

								if( node_square_distance_to_player >= optimal_square_distance_min &&
									node_square_distance_to_player <= optimal_square_distance_max )
								{
									if( num_indices[0] < max_route_indices )
									{
										route_indices[0][ num_indices[0] ]= u16(i);
										++num_indices[0];
									}
								}
								else if( node_square_distance_to_player >= good_enough_square_distance_min &&
									node_square_distance_to_player >= good_enough_square_distance_max )
								{
									if( num_indices[1] < max_route_indices )
									{
										route_indices[1][ num_indices[1] ]= u16(i);
										++num_indices[1];
									}
								}
							}

							var size_type mut end_index= route.size() - 1s;

							// Check optimal nodes in the route, then good enough ones.
							// If the player can be seen from the position of this node - select it as target.
							for( auto mut range_index= 0s; range_index < 2s; ++range_index ) label select_movement_target_loop
							{
								auto& range_route_indices= route_indices[ range_index ];
								var size_type range_num_indices= num_indices[ range_index ];

								for( auto mut i= 0s; i < range_num_indices; ++i )
								{
									// Check if the player is visible from the position of this node.

									var size_type index( range_route_indices[i] );
									var GlobalNavigationGraph::Node& node=
										map_data.global_navigation_graph.nodes[ size_type( route[index] ) ];

									var Vec3f trace_start=
										GetPlayerPointForEntityVisibilityTrace( player_position, player_crouching_phase );

									var Vec3f trace_end= GetEntityPointForPlayerVisibilityTrace( node.position, operation.animation );

									if( trace_end != trace_start )
									{
										var Vec3f trace_vector= trace_end - trace_start;
										auto trace_result=
											LineTrace(
												map_data,
												broken_quad_bits,
												dynamic_cluster_colliders,
												trace_start,
												trace_vector );

										if( trace_result.empty() || trace_result.try_deref().distance >= 1.0f )
										{
											end_index= index;
											break label select_movement_target_loop;
										}
									}
								}
							}

							navigation_state.target_navigation_graph_node= route[ end_index ];
							SaveEntityRoute( route.subrange_end( end_index + 1s ), navigation_state );
						}
						else
						{
							// Can't find a route towards the player.
							// It's actually not so rare case,
							// since many enemies are placed in areas without straight connection to the player's location.

							// Just select a nearby node which is the closest to the player.

							var GlobalNavigationGraph::Node& current_node=
								map_data.global_navigation_graph.nodes[ size_type( navigation_state.current_navigation_graph_node ) ];

							var GlobalNavigationGraph::NodeIndex mut best_node_index= GlobalNavigationGraph::c_invalid_node_index;
							var f32 mut smallest_square_distance= ust::plus_inf</f32/>();

							foreach( &edge :
								map_data.global_navigation_graph.node_output_edges.range().subrange(
									size_type( current_node.first_output_edge ),
									size_type( current_node.first_output_edge ) + size_type( current_node.num_output_edges ) ) )
							{
								var GlobalNavigationGraph::Node& node=
									map_data.global_navigation_graph.nodes[ size_type( edge.dst_node_index ) ];

								if( large_entity && !node.large )
								{
									continue;
								}

								var f32 square_distance_to_player= ( node.position - player_position ).SquareLength();

								if( square_distance_to_player < smallest_square_distance )
								{
									smallest_square_distance= square_distance_to_player;
									best_node_index= edge.dst_node_index;
								}
							}

							if( best_node_index != GlobalNavigationGraph::c_invalid_node_index )
							{
								SaveEntityRoute( ust::single_element_array_view( best_node_index ), navigation_state );
								navigation_state.target_navigation_graph_node= best_node_index;
							}
						}
					}
				}
				else
				{
					// Is in good enough distance to the player.
					// Enumerate nearby nodes.
					// Collect nodes in optimal distance and in good enough distance.

					var size_type max_nodes_collected= 16s;

					var [ [ GlobalNavigationGraph::NodeIndex, max_nodes_collected ], 2 ] mut nodes_collected
						[ [ GlobalNavigationGraph::c_invalid_node_index ... ] ... ]; // Optimal and good enough indices.

					var [ size_type, 2 ] mut num_nodes_collected[ 0s ... ]; // Optimal and good enough indices.

					var size_type mut num_nodes_visited= 0s;

					route_search_context.route_searcher.EnumerateOutputNodes(
						map_data.global_navigation_graph,
						navigation_state.current_navigation_graph_node,
						large_entity,
						lambda[&]( GlobalNavigationGraph::NodeIndex node_index, u32 graph_distance ) : bool
						{
							ust::ignore_unused( graph_distance );

							++num_nodes_visited;

							if( node_index == navigation_state.current_navigation_graph_node )
							{
								return true;
							}

							var GlobalNavigationGraph::Node& node=
									map_data.global_navigation_graph.nodes[ size_type( node_index ) ];

							var f32 node_square_distance_to_player= ( player_position - node.position ).SquareLength();

							if( node_square_distance_to_player >= good_enough_square_distance_min &&
								node_square_distance_to_player <= good_enough_square_distance_max )
							{
								// Check if moving from current position to this node in a straight line doesn't cause to walk to the player too close.

								var Vec3f vec_from_entity_to_node= node.position - entity.position;
								var Vec3f vec_from_node_to_player= player_position - node.position;
								var Vec3f vec_from_entity_to_player= player_position - entity.position;

								var bool mut too_close= false;

								var bool projection_is_within_line=
									vec_from_entity_to_node.Dot( vec_from_node_to_player ) <= 0.0f &&
									vec_from_entity_to_node.Dot( vec_from_entity_to_player ) >= 0.0f;

								if( projection_is_within_line )
								{
									var f32 square_distance_from_entity_to_node= vec_from_entity_to_node.SquareLength();
									if( square_distance_from_entity_to_node > 0.0f )
									{
										var f32 closest_square_distance=
											vec_from_node_to_player.Cross( vec_from_entity_to_player ).SquareLength() /
											square_distance_from_entity_to_node;

										too_close= closest_square_distance < good_enough_square_distance_min;
									}
								}

								if( !too_close )
								{
									if( node_square_distance_to_player >= optimal_square_distance_min &&
										node_square_distance_to_player <= optimal_square_distance_max )
									{
										if( num_nodes_collected[0] < max_nodes_collected )
										{
											nodes_collected[0][ num_nodes_collected[0] ]= node_index;
											++num_nodes_collected[0];
										}
									}
									else
									{
										if( num_nodes_collected[1] < max_nodes_collected )
										{
											nodes_collected[1][ num_nodes_collected[1] ]= node_index;
											++num_nodes_collected[1];
										}
									}
								}
							}

							return num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_for_nearby_target_search;
						} );

					// Remember time point at which a route search/nodes enumeration for this entity was executed.
					navigation_state.last_route_search_step_index= current_step_index;

					route_search_context.num_nodes_visited+= num_nodes_visited;

					// Proccess first optimal nodes, then good enough.
					// On each step select a random node from the list.
					// Check if this node if the player is visible from the position of this node.

					var GlobalNavigationGraph::NodeIndex mut new_navigation_target_node=
						GlobalNavigationGraph::c_invalid_node_index;

					for( auto mut range_index= 0s; range_index < 2s; ++range_index ) label select_movement_target_loop
					{
						auto &mut range_nodes= nodes_collected[ range_index ];
						var size_type num_nodes= num_nodes_collected[ range_index ];

						for( auto mut i= 0s; i < num_nodes; ++i )
						{
							// Select random point from remaining candidates.
							{
								var size_type random_index= i + size_type( random.Next() ) % ( num_nodes - i );
								auto prev= range_nodes[i];
								range_nodes[i]= range_nodes[ random_index ];
								range_nodes[ random_index ]= prev;
							}

							var GlobalNavigationGraph::NodeIndex node_index= range_nodes[i];

							var GlobalNavigationGraph::Node& node=
								map_data.global_navigation_graph.nodes[ size_type( node_index ) ];

							var Vec3f trace_start=
								GetPlayerPointForEntityVisibilityTrace( player_position, player_crouching_phase );

							var Vec3f trace_end=
								GetEntityPointForPlayerVisibilityTrace( node.position, operation.animation );

							if( trace_end != trace_start )
							{
								var Vec3f trace_vector= trace_end - trace_start;
								auto trace_result=
									LineTrace(
										map_data,
										broken_quad_bits,
										dynamic_cluster_colliders,
										trace_start,
										trace_vector );

								if( trace_result.empty() || trace_result.try_deref().distance >= 1.0f )
								{
									new_navigation_target_node= node_index;
									break label select_movement_target_loop;
								}
							}
						}
					}

					if( new_navigation_target_node != GlobalNavigationGraph::c_invalid_node_index )
					{
						// Reconstruct a route after nodes enumeration.
						var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
							route_search_context.route_searcher.ReconstructRouteAfterNodesEnumeration( new_navigation_target_node );

						if( !route.empty() )
						{
							SaveEntityRoute( route, navigation_state );
							navigation_state.target_navigation_graph_node= new_navigation_target_node;
						}
					}
				}
			}
		}
		else
		{
			// If the player isn't visible, just go to the last position where he was seen.

			if( current_step_index >= navigation_state.last_route_search_step_index + EntityNavigationConstants::min_steps_between_route_searches &&
				route_search_context.num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_in_single_game_logic_step )
			{
				if_var( player_node_index : FindNearestNavigationGraphNode( map_data, broken_quad_bits, player_position, large_entity ) )
				{
					if( navigation_state.target_navigation_graph_node != player_node_index ||
						navigation_state.route[0] == GlobalNavigationGraph::c_invalid_node_index )
					{
						var size_type mut num_nodes_visited= 0s;

						var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
							route_search_context.route_searcher.PerformDirectedSearch(
								map_data.global_navigation_graph,
								navigation_state.current_navigation_graph_node,
								player_node_index,
								large_entity,
								lambda[&]( GlobalNavigationGraph::NodeIndex node_index ) : bool
								{
									ust::ignore_unused( node_index );
									++num_nodes_visited;
									return num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_for_direct_route_search;
								} );

						// Remember time point at which a route search/nodes enumeration for this entity was executed.
						navigation_state.last_route_search_step_index= current_step_index;

						route_search_context.num_nodes_visited+= num_nodes_visited;

						if( !route.empty() )
						{
							SaveEntityRoute( route, navigation_state );
							navigation_state.target_navigation_graph_node= route.back();
						}
						else
						{
							// If no route is found, just use the default fallback for the target (calculated later).
						}
					}
				}
			}
		}
	}
	else
	{
		// Perform movement between patrolling points if is not alarmed or is alarmed, but has not seen the player yet.
		// It's necessary to do so for enemies with trigger-based spawn.

		var bool mut need_to_recalculate_route= false;

		if( navigation_state.target_navigation_graph_node == GlobalNavigationGraph::c_invalid_node_index )
		{
			navigation_state.target_navigation_graph_node=
				SelectNextPatrollingNode(
					map_data.global_navigation_graph.entity_navigation_infos[ size_type( entity.navigation_info_index ) ],
					navigation_state.current_navigation_graph_node,
					large_entity );

			need_to_recalculate_route= true;
		}

		if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index &&
			navigation_state.route[0] == GlobalNavigationGraph::c_invalid_node_index )
		{
			// Need to recalculate the route, since no intermediate points are left.
			need_to_recalculate_route= true;
		}

		if( need_to_recalculate_route &&
			current_step_index >= navigation_state.last_route_search_step_index + EntityNavigationConstants::min_steps_between_patrolling_route_searches &&
			route_search_context.num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_in_single_game_logic_step )
		{
			// Search for a route to target.

			var bool mut found_route= false;

			if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index )
			{
				var size_type mut num_nodes_visited= 0s;

				var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
					route_search_context.route_searcher.PerformDirectedSearch(
						map_data.global_navigation_graph,
						navigation_state.current_navigation_graph_node,
						navigation_state.target_navigation_graph_node,
						large_entity,
						lambda[&]( GlobalNavigationGraph::NodeIndex node_index ) : bool
						{
							ust::ignore_unused( node_index );
							++num_nodes_visited;
							return num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_for_patrolling_target_search;
						} );

				// Remember time point at which a route search/nodes enumeration for this entity was executed.
				navigation_state.last_route_search_step_index= current_step_index;

				route_search_context.num_nodes_visited+= num_nodes_visited;

				if( !route.empty() )
				{
					SaveEntityRoute( route, navigation_state );
					found_route= true;
				}
			}

			if( !found_route )
			{
				// Can't find a route to the target patrolling point.
				// Try selecting the next patrolling point as target and finding a route to it.

				navigation_state.target_navigation_graph_node=
					SelectNextPatrollingNode(
						map_data.global_navigation_graph.entity_navigation_infos[ size_type( entity.navigation_info_index ) ],
						navigation_state.target_navigation_graph_node,
						large_entity );

				if( navigation_state.target_navigation_graph_node != GlobalNavigationGraph::c_invalid_node_index )
				{
					var size_type mut num_nodes_visited= 0s;

					var ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route=
						route_search_context.route_searcher.PerformDirectedSearch(
							map_data.global_navigation_graph,
							navigation_state.current_navigation_graph_node,
							navigation_state.target_navigation_graph_node,
							large_entity,
							lambda[&]( GlobalNavigationGraph::NodeIndex node_index ) : bool
						{
							ust::ignore_unused( node_index );
							++num_nodes_visited;
							return num_nodes_visited < EntityNavigationConstants::max_nodes_to_visit_for_patrolling_target_search;
						} );

					// Remember time point at which a route search/nodes enumeration for this entity was executed.
					navigation_state.last_route_search_step_index= current_step_index;

					route_search_context.num_nodes_visited+= num_nodes_visited;

					if( !route.empty() )
					{
						SaveEntityRoute( route, navigation_state );
						found_route= true;
					}
				}
			}
		}
	}

	// A fallback for cases where no target can be selected and/or no route can be found.
	// Just select a nearby navigation graph node based on current direction as target.
	// In the worst case this will result in a straigh movement until next obstacle is reached, than turning will take place.
	if( navigation_state.target_navigation_graph_node == GlobalNavigationGraph::c_invalid_node_index )
	{
		var GlobalNavigationGraph::Node& current_node=
			map_data.global_navigation_graph.nodes[ size_type( navigation_state.current_navigation_graph_node ) ];

		var GlobalNavigationGraph::NodeIndex mut best_node_index= GlobalNavigationGraph::c_invalid_node_index;
		var f32 mut best_angle_cos= ust::minus_inf</f32/>();

		var Vec2f entity_direction_normalized= GetEntityDirectionNormalizedVector( entity );

		foreach( &edge :
			map_data.global_navigation_graph.node_output_edges.range().subrange(
				size_type( current_node.first_output_edge ),
				size_type( current_node.first_output_edge ) + size_type( current_node.num_output_edges ) ) )
		{
			var GlobalNavigationGraph::Node& node=
				map_data.global_navigation_graph.nodes[ size_type( edge.dst_node_index ) ];

			if( large_entity && !node.large )
			{
				continue;
			}

			var Vec2f vector_to_node= ( node.position.xy() - entity.position.xy() );

			var f32 vector_to_node_length= vector_to_node.Length();
			if( vector_to_node_length > 0.0f )
			{
				var f32 angle_cos= vector_to_node.Dot( entity_direction_normalized ) / vector_to_node_length;
				if( angle_cos > best_angle_cos )
				{
					best_node_index= edge.dst_node_index;
					best_angle_cos= angle_cos;
				}
			}
		}

		if( best_node_index != GlobalNavigationGraph::c_invalid_node_index )
		{
			SaveEntityRoute( ust::single_element_array_view( best_node_index ), navigation_state );
			navigation_state.target_navigation_graph_node= best_node_index;
		}
	}
}

fn GetPlayerPointForEntityVisibilityTrace( Vec3f& player_position, f32 crouching_phase ) : Vec3f
{
	// Trace from player's head. Assume enemies can't see player's feet.
	return player_position + Vec3f( 0.0f, 0.0f, c_camera_z_offset + crouching_phase * c_crouching_height_delta );
}

fn GetEntityPointForPlayerVisibilityTrace(
	Vec3f& position,
	EntitiesDescription::OperationAnimationDescription& animation ) : Vec3f
{
	// Trace roughly from enemy head.
	return
		position +
		Vec3f(
			f32( animation.bounding_box_center_x ),
			f32( animation.bounding_box_center_y ),
			f32( animation.bounding_box_center_z ) - 0.6f * f32( animation.bounding_box_half_size_z ) );
}

fn GetEntityDistanceRanges( EntitiesDescription::EntityDescription& entity_description ) : EntityDistanceRanges
{
	// Hold-on distance is specified in configs in some strange units.
	// Just assume scale for this unit.
	var f32 constexpr distance_unit_scale= 24.0f;

	var f32 hold_on_distance( entity_description.hold_on_distance );

	return EntityDistanceRanges
	{
		.optimal
		{
			.distance_min= distance_unit_scale * ust::max( 1.0f, hold_on_distance - 1.0f ),
			.distance_max= distance_unit_scale * ( hold_on_distance + 4.0f ),
		},
		.good_enough
		{
			.distance_min= distance_unit_scale * ust::max( 1.0f, hold_on_distance - 2.0f ),
			.distance_max= distance_unit_scale * ( hold_on_distance + 6.0f ),
		},
	};
}

struct EntityDistanceRanges
{
	EntityDistanceRange optimal;
	EntityDistanceRange good_enough;
}

struct EntityDistanceRange
{
	f32 distance_min;
	f32 distance_max;
}

// May return invalid node index.
fn SelectNextPatrollingNode(
	GlobalNavigationGraph::EntityNavigationInfo& entity_navigation_info,
	GlobalNavigationGraph::NodeIndex current_node,
	bool use_large_nodes ) : GlobalNavigationGraph::NodeIndex
{
	auto& patrolling_nodes=
		( use_large_nodes ? entity_navigation_info.large_patrolling_nodes : entity_navigation_info.patrolling_nodes );

	var size_type max_points= typeinfo</ typeof( patrolling_nodes ) />.element_count;

	// Find index of current node.
	auto mut i= 0s;
	for( ; i < max_points; ++i )
	{
		if( current_node == patrolling_nodes[i] )
		{
			++i;
			break;
		}
	}

	// Search the remaing array after current node.
	for( ; i < max_points; ++i )
	{
		var GlobalNavigationGraph::NodeIndex node_index= patrolling_nodes[i];
		if( node_index != GlobalNavigationGraph::c_invalid_node_index )
		{
			return node_index;
		}
	}

	// If given node was the last one in the patrolling nodes array or if it's invalid - search from start.
	foreach( node_index : patrolling_nodes )
	{
		if( node_index != GlobalNavigationGraph::c_invalid_node_index )
		{
			return node_index;
		}
	}

	return GlobalNavigationGraph::c_invalid_node_index;
}

fn SaveEntityRoute(
	ust::array_view_imut</GlobalNavigationGraph::NodeIndex/> route, EntityNavigationState &mut navigation_state )
{
	var ust::array_view_mut</GlobalNavigationGraph::NodeIndex/> dst_route= navigation_state.route;

	dst_route.copy_from( route );

	foreach( &mut n : dst_route.subrange_start( route.size() ) )
	{
		n= GlobalNavigationGraph::c_invalid_node_index;
	}
}

struct DelayedShotAlarm
{
	Vec3f center;
	f32 max_distance;
}

fn EntityShoot(
	GameParams& game_params,
	EntitiesDescription& entities_description,
	u32 skill,
	[ i32, 5 ]& item,
	EntityState& mut entity,
	u32 entity_index,
	f32 player_crouching_phase, // Assume an entity knows player's crouching phase if it can see him right now.
	PseudoRandomGenerator &mut rand,
	ProjectilesContainer &mut projectiles,
	MuzzleFlashesContainer &mut muzzle_flashes,
	MuzzleLightsContainer &mut muzzle_lights ) : ust::optional</DelayedShotAlarm/>
{
	if( entity.ammo == 0u )
	{
		return ust::null_optional;
	}

	var i32 weapon_tool_index= item[0];

	if( !( weapon_tool_index >= 0 && size_type( weapon_tool_index ) < entities_description.tools.size() ) )
	{
		return ust::null_optional;
	}

	var EntitiesDescription::Tool& weapon_tool= entities_description.tools[ size_type( weapon_tool_index ) ];

	if( !entity.player_is_in_sight || entity.last_seen_player_position.empty() )
	{
		// Can't see the player anymore, avoid shooting.
		return ust::null_optional;
	}

	var Vec3f target_position=
		entity.last_seen_player_position.try_deref() +
		GetPlayerColliderBBox( entities_description, player_crouching_phase ).GetCenter();

	var Mat4f rotation_matrix= Mat4f::MakeRotationZ( entity.azimuth );

	var Vec3f shot_relative_position( f32( item[1] ), f32( item[2] ), f32( item[3] ) );

	var Vec3f shot_position= entity.position + shot_relative_position * rotation_matrix;

	// Just shoot towards the target.
	// Assume, that we have rotation towards the target,
	// since shooting operations should include active rotation towards it.

	var Vec3f vec_to_target= target_position - shot_position;

	// Accuracy is specified on per-weapon basis.
	// Additionally there is a skill-based extra bullet spread.
	var u32 accuracy= weapon_tool.enemy_weapon_accuracy + game_params.bullet_spread[ skill ];

	var Vec3f direction_with_random_spread=
		RandomOffsetShotVector( vec_to_target, accuracy, rand );

	projectiles.Insert(
		Projectile
		{
			.weapon_tool_index( weapon_tool_index ),
			.owner_entity_index= entity_index,
			.age_steps= 0u,
			.position= shot_position,
			.velocity= direction_with_random_spread * f32( weapon_tool.speed ),
		} );

	--entity.ammo;

	if( weapon_tool.muzzle_flash_model >= 0 )
	{
		muzzle_flashes.Insert(
			MuzzleFlash
			{
				.model( weapon_tool.muzzle_flash_model ),
				.owner_entity_index= entity_index,
				.relative_position= shot_relative_position,
				.age_steps= 0u,
			} );
	}

	if( weapon_tool.light_at_shot[1] > 0u )
	{
		AddMuzzleLight(
			muzzle_lights,
			MuzzleLight
			{
				.owner_entity_index= entity_index,
				.relative_position= shot_relative_position,
				.power= f32( weapon_tool.light_at_shot[1] ),
				.color_index= weapon_tool.light_at_shot[0],
				.age_steps= 0u,
			} );
	}

	if( weapon_tool.sound >= 0 &&  weapon_tool.sound <= 255 )
	{
		EmitShotSound( entity.sound_source_slots, u8(weapon_tool.sound) );
	}

	// Alarm other nearby enemies assuming shooting produces a loud sound which can be heard by them.
	// The only exception is melee weapons.
	if( weapon_tool.projectile_kind == EntitiesDescription::Tool::c_projectile_kind_melee )
	{
		return ust::null_optional;
	}
	else
	{
		return
			DelayedShotAlarm
			{
				.center= shot_position,
				.max_distance= c_enemy_shot_enemy_alarm_max_distance,
			};
	}
}

fn EntityDirectionalShot(
	EntitiesDescription& entities_description,
	EntitiesDescription::DirectionalShot& directional_shot,
	EntityState& mut entity,
	u32 entity_index,
	PseudoRandomGenerator &mut rand,
	ProjectilesContainer &mut projectiles,
	MuzzleFlashesContainer &mut muzzle_flashes,
	MuzzleLightsContainer &mut muzzle_lights )
{
	// No ammo is consumed for directional shots.

	var size_type weapon_tool_index( directional_shot.item );

	if( weapon_tool_index >= entities_description.tools.size()  )
	{
		return;
	}

	var EntitiesDescription::Tool& weapon_tool= entities_description.tools[ weapon_tool_index ];

	var Vec3f shot_offset(
		f32( directional_shot.offset_x ), f32( directional_shot.offset_y ), f32( directional_shot.offset_z ) );

	var Mat4f rotation_matrix= Mat4f::MakeRotationZ( entity.azimuth );

	var Vec3f shot_position= entity.position + shot_offset * rotation_matrix;

	var Vec3f direction= Vec3f( 0.0f, 1.0f, 0.0f ) * rotation_matrix;

	// Accuracy is specified on per-weapon basis.
	// For directional shots don't use skill-based accuracy.
	var u32 accuracy= weapon_tool.enemy_weapon_accuracy;

	var Vec3f direction_with_random_spread= RandomOffsetShotVector( direction, accuracy, rand );

	projectiles.Insert(
		Projectile
		{
			.weapon_tool_index( weapon_tool_index ),
			.owner_entity_index= entity_index,
			.age_steps= 0u,
			.position= shot_position,
			.velocity= direction_with_random_spread * f32( weapon_tool.speed ),
		} );

	if( weapon_tool.muzzle_flash_model >= 0 )
	{
		muzzle_flashes.Insert(
			MuzzleFlash
			{
				.model( weapon_tool.muzzle_flash_model ),
				.owner_entity_index= entity_index,
				.relative_position= shot_offset,
				.age_steps= 0u,
			} );
	}

	if( weapon_tool.light_at_shot[1] > 0u )
	{
		AddMuzzleLight(
			muzzle_lights,
			MuzzleLight
			{
				.owner_entity_index= entity_index,
				.relative_position= shot_offset,
				.power= f32( weapon_tool.light_at_shot[1] ),
				.color_index= weapon_tool.light_at_shot[0],
				.age_steps= 0u,
			} );
	}

	if( weapon_tool.sound >= 0 &&  weapon_tool.sound <= 255 )
	{
		EmitShotSound( entity.sound_source_slots, u8(weapon_tool.sound) );
	}
}

fn MoveEntity(
	GameMapData& map_data,
	BitArrayView broken_quad_bits,
	ust::array_view_imut</DynamicClusterCollider/> dynamic_cluster_colliders,
	ust::array_view_imut</Collider/> extra_colliders,
	ProjectilesContainer &mut projectiles,
	ust::vector</ProjectileHitEvent/> &mut projectile_hit_events,
	EntityState &mut entity,
	ust::optional_ref_mut</EntityNavigationState/> navigation_state_opt,
	u32 entity_index,
	EntitiesDescription::EntityDescription& entity_description,
	EntitiesDescription::Operation& current_operation )
{
	// Warning!
	// This code should match code performing navigation graph building as close as possible!

	var Vec3f old_position= entity.position;

	PerformEntityOwnMovement( map_data, entity, navigation_state_opt, current_operation );

	var Vec3f mut new_position= entity.position;

	var bool mut affected_by_gravity= false;

	// Players are affected by gravity.
	affected_by_gravity|= entity_description.mode == EntitiesDescription::EntityDescription::c_mode_player;

	// Enemies are affected by gravity.
	affected_by_gravity|= entity_description.mode == EntitiesDescription::EntityDescription::c_mode_enemy;

	// Pick-ups are affected by gravity.
	affected_by_gravity|= entity_description.mode == EntitiesDescription::EntityDescription::c_mode_pickup;

	// TODO - process here also projectiles.

	// Decorations are affected by gravity, but only if they are pushable.
	affected_by_gravity|=
		entity_description.mode == EntitiesDescription::EntityDescription::c_mode_decoration &&
		!entity_description.param_akt.empty() && entity_description.param_akt.try_deref()[3] != 0u;

	if( current_operation.animation_kind == EntitiesDescription::Operation::AnimationKind::Landscape )
	{
		// Decorations like planes and airships shouldn't be affected by gravity.
		affected_by_gravity= false;
	}

	if( affected_by_gravity )
	{
		entity.velocity_z+= c_gravity_per_step;
		new_position.z+= entity.velocity_z;

		// Don't fall into infinity.
		ust::min_assign( new_position.z, 4096.0f );

		// Limit vertical speed if necessary.
		ust::min_assign( entity.velocity_z,  c_max_vertical_speed );
		ust::max_assign( entity.velocity_z, -c_max_vertical_speed );
	}

	if( new_position == old_position )
	{
		// No movement is required.
		return;
	}

	var ust::optional</BBox3f/> mut collider_bbox_opt;

	// Usually we have only one collision box.
	// The only exception is the tank enemy on map 24. Use for it directional animation collider.
	if( current_operation.directional_animation.num_steps > 0u )
	{
		var Vec3f mut bbox_half_size(
			f32( current_operation.directional_animation.bounding_box_half_size_x ),
			f32( current_operation.directional_animation.bounding_box_half_size_y ),
			f32( current_operation.directional_animation.bounding_box_half_size_z ) );

		RotateEntityBBox( bbox_half_size, Convert1024Angle( f32( current_operation.directional_animation.direction ) ) );

		var Vec3f bbox_center=
			Vec3f(
				f32( current_operation.directional_animation.bounding_box_center_x ),
				f32( current_operation.directional_animation.bounding_box_center_y ),
				f32( current_operation.directional_animation.bounding_box_center_z ) );

		collider_bbox_opt= BBox3f{ .min= bbox_center - bbox_half_size, .max= bbox_center + bbox_half_size };
	}
	else if( current_operation.animation.num_steps > 0u )
	{
		var Vec3f mut bbox_half_size(
			f32( current_operation.animation.bounding_box_half_size_x ),
			f32( current_operation.animation.bounding_box_half_size_y ),
			f32( current_operation.animation.bounding_box_half_size_z ) );

		RotateEntityBBox( bbox_half_size, entity.azimuth );

		var Vec3f bbox_center=
			Vec3f(
				f32( current_operation.animation.bounding_box_center_x ),
				f32( current_operation.animation.bounding_box_center_y ),
				f32( current_operation.animation.bounding_box_center_z ) );

		collider_bbox_opt= BBox3f{ .min= bbox_center - bbox_half_size, .max= bbox_center + bbox_half_size };
	}

	if( collider_bbox_opt.empty() )
	{
		return;
	}

	var BBox3f& collider_bbox= collider_bbox_opt.try_deref();

	// TODO - move non-enemy entities without stepping.

	var CollisionStepMoveResult move_result=
		CollisionStepMove(
			map_data,
			broken_quad_bits,
			dynamic_cluster_colliders,
			extra_colliders,
			collider_bbox,
			old_position,
			new_position );

	// Clamp vertical velocity if necessary.
	for( auto mut i= 0u; i < move_result.trace_clip_result.num_collision_events; ++i )
	{
		ClampVerticalVelocity( entity.velocity_z, move_result.trace_clip_result.collision_events[i].plane_normal );
	}

	entity.position= move_result.trace_clip_result.position_clipped;

	// Calculate collisions with projectiles.
	// It's necessary to avoid missing collisions in some cases, especially for slow-moving projectiles.
	if( entity.position != old_position &&
		entity_description.mode != EntitiesDescription::EntityDescription::c_mode_pickup &&
		collider_bbox.min.x != collider_bbox.max.x &&
		collider_bbox.min.y != collider_bbox.max.y &&
		collider_bbox.min.z != collider_bbox.max.z )
	{
		// Using straight movement from start to end isn't fully correct, since actual movement with clipping may be more complex.
		// But it's mostly fine.
		CollideMovedEntityWithProjectiles(
			old_position,
			entity.position,
			collider_bbox,
			entity_index,
			projectiles,
			projectile_hit_events );
	}
}

fn PerformEntityOwnMovement(
	GameMapData& map_data,
	EntityState &mut entity,
	ust::optional_ref_mut</EntityNavigationState/> navigation_state_opt,
	EntitiesDescription::Operation& current_operation )
{
	if_var( &operation_control : current_operation.operation_control )
	{
		if( !navigation_state_opt.empty() )
		{
			PerformEntityOperationControlBasedMovement(
				map_data, entity, navigation_state_opt.try_deref(), operation_control );
		}
	}
	else
	{
		if_var( &object_movement : current_operation.object_movement )
		{
			PerformEntityObjectMovement( entity, object_movement );
		}

		if_var( &target_rotation : current_operation.target_rotation )
		{
			PerformEntityTargetRotation( entity, target_rotation );
		}
		else if_var( &rotation_for_shot : current_operation.rotation_for_shot )
		{
			PerformEntityRotationForShot( entity, rotation_for_shot );
		}
	}
}

fn PerformEntityOperationControlBasedMovement(
	GameMapData& map_data,
	EntityState &mut entity,
	EntityNavigationState &mut navigation_state,
	EntitiesDescription::OperationControl& operation_control )
{
	var ust::optional</Vec2f/> mut movement_target_opt;

	if( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_move_towards_waypoint )
	{
		if( navigation_state.route[0] != GlobalNavigationGraph::c_invalid_node_index )
		{
			movement_target_opt=
				map_data.global_navigation_graph.nodes[ size_type( navigation_state.route[0] ) ].position.xy();
		}
	}
	else if( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_move_towards_player )
	{
		if_var( &player_position : entity.last_seen_player_position )
		{
			movement_target_opt= player_position.xy();
		}
	}
	else if( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_sky_decoration )
	{
		// For sky decorations don't use the global navigation graph at all.
		// Use initial patrolling points for them directly.

		var ust::array_view_imut</ZpozEntityNavigationInfo/> navigation_infos=
			map_data.zpoz_data.deref().entity_navigation_infos;
		if( size_type( entity.navigation_info_index ) < navigation_infos.size() )
		{
			var ZpozEntityNavigationInfo& navigation_info= navigation_infos[ size_type( entity.navigation_info_index ) ];
			if( navigation_info.num_patrolling_points > 0u )
			{
				navigation_state.current_patrolling_point_index=
					u8( u32( navigation_state.current_patrolling_point_index ) % navigation_info.num_patrolling_points );

				var u32 point_index( navigation_state.current_patrolling_point_index );

				movement_target_opt=
					Vec2f(
						f32( navigation_info.patrolling_point_coords[ point_index +  0u ] ),
						f32( navigation_info.patrolling_point_coords[ point_index + 16u ] ) );
			}
		}
	}
	else
	{
		// Unknown mode.
		return;
	}

	if( movement_target_opt.empty() )
	{
		return;
	}

	var Vec2f& movement_target= movement_target_opt.try_deref();

	var f32 turn_speed=
		( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_sky_decoration
			? c_sky_decoration_entity_turn_speed
			: c_entity_turn_speed );

	var f32 mut move_fraction= 1.0f;

	// Use 2d calculation for vector to waypoint - ignore some Z difference.
	var Vec2f vec_to_movement_target= movement_target - entity.position.xy();
	var f32 square_distance_to_movement_target= vec_to_movement_target.SquareLength();

	if( square_distance_to_movement_target != 0.0f )
	{
		// Perform smooth turn towards the waypoint node.

		var f32 target_azimuth= ust::atan2( -vec_to_movement_target.x, vec_to_movement_target.y );

		var f32 angle_delta= CalculateRotationAngleDelta( entity.azimuth, target_azimuth );

		if( angle_delta < -turn_speed )
		{
			move_fraction= 0.0f; // Don't move if turn.
			entity.azimuth+= turn_speed;
		}
		else if( angle_delta > turn_speed )
		{
			move_fraction= 0.0f; // Don't move if turn.
			entity.azimuth-= turn_speed;
		}
		else
		{
			move_fraction= 1.0f - ust::abs( angle_delta ) / turn_speed;
			entity.azimuth= target_azimuth;
		}
	}

	var f32 base_move_distance= f32( operation_control.speed ) * c_entity_speed_scale;

	// If we perform a turn don't move.
	// We should move only directly towards the target, otherwise we can encount various problems with target reaching.
	// The only exception is sky decorations, they move wiredly in the original game too.
	if( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_sky_decoration )
	{
		move_fraction= 1.0f;
	}
	var f32 move_distance= base_move_distance * move_fraction;

	// Perform movement towards current direction.
	var Vec3f direction_vector( GetEntityDirectionNormalizedVector( entity ), 0.0f );
	entity.position+= direction_vector * move_distance;

	if( square_distance_to_movement_target <= base_move_distance * base_move_distance )
	{
		if( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_move_towards_waypoint )
		{
			// Reached the next route point.
			// Mark it as current node.

			navigation_state.current_navigation_graph_node= navigation_state.route[0];

			// Shift the route.
			var size_type max_route_nodes= typeinfo</ typeof( navigation_state.route ) />.element_count;
			for( auto mut i= 0s; i < max_route_nodes - 1s; ++i )
			{
				navigation_state.route[i]= navigation_state.route[ i + 1s ];
			}

			navigation_state.route[ max_route_nodes - 1s ]= GlobalNavigationGraph::c_invalid_node_index;
		}
		else if( operation_control.functioning_mode == EntitiesDescription::OperationControl::c_functioning_mode_sky_decoration )
		{
			++navigation_state.current_patrolling_point_index;
		}
	}
}

fn PerformEntityObjectMovement( EntityState &mut entity, EntitiesDescription::ObjectMovement& object_movement )
{
	var f32 angle= entity.azimuth + Convert1024Angle( f32( object_movement.relative_angle ) );

	var Vec3f movement_vector( -ust::sin(angle), ust::cos(angle), 0.0f );

	entity.position+= movement_vector * f32( object_movement.speed );
}

fn PerformEntityTargetRotation( EntityState &mut entity, EntitiesDescription::TargetRotation& target_rotation )
{
	var f32 target_azimuth= Convert1024Angle( f32( target_rotation.target_angle ) );
	var f32 speed= ust::abs( Convert1024Angle( f32( target_rotation.step ) ) );

	var f32 angle_delta= CalculateRotationAngleDelta( entity.azimuth, target_azimuth );

	if( angle_delta < -speed )
	{
		entity.azimuth+= speed;
	}
	else if( angle_delta > speed )
	{
		entity.azimuth-= speed;
	}
	else
	{
		entity.azimuth= target_azimuth;
	}
}

fn PerformEntityRotationForShot( EntityState &mut entity, EntitiesDescription::RotationForShot& rotation_for_shot )
{
	if( entity.last_seen_player_position.empty() )
	{
		return;
	}

	var Vec2f vec_to_movement_target= entity.last_seen_player_position.try_deref().xy() - entity.position.xy();

	var f32 target_azimuth= ust::atan2( -vec_to_movement_target.x, vec_to_movement_target.y );

	var f32 speed= ust::abs( Convert1024Angle( f32( rotation_for_shot.rotation_speed ) ) );

	var f32 angle_delta= CalculateRotationAngleDelta( entity.azimuth, target_azimuth );

	if( angle_delta < -speed )
	{
		entity.azimuth+= speed;
	}
	else if( angle_delta > speed )
	{
		entity.azimuth-= speed;
	}
	else
	{
		entity.azimuth= target_azimuth;
	}
}

fn GetEntityDirectionNormalizedVector( EntityState& entity ) : Vec2f
{
	return Vec2f( -ust::sin(entity.azimuth), ust::cos(entity.azimuth) );
}

fn IsPointInLiquid( GameMapData& map_data, Vec3f& point ) : bool
{
	var bool mut in_liquid= false;

	VisitBoundingBoxesHierarchyForPoint(
		map_data.room_clusters_hierarchy.deref(),
		point,
		lambda[ clusters= map_data.zvox_data.deref().clusters.range(), &point, &in_liquid ]( ClusterIndexInHierarchy c )
		{
			var ZvoxCluster& cluster= clusters[ size_type(c) ];

			if( cluster.contents == ZvoxCluster::c_contents_water |
				cluster.contents == ZvoxCluster::c_contents_acid |
				cluster.contents == ZvoxCluster::c_contents_lava )
			{
				if( CreateClusterBBox( cluster ).PointIsInsideOrOnFace( point ) )
				{
					in_liquid= true;
				}
			}
		} );

	return in_liquid;
}

// In liquid check function version for cases where points slightly near liquid voluems should be still considered to be in liquid.
// It's necessary to perform such check due to numerical imprecisions.
fn IsPointInLiquidOrNearby( GameMapData& map_data, Vec3f& point ) : bool
{
	var f32 eps= 1.0f;
	var BBox3f sample_box
	{
		.min= point - Vec3f( eps, eps, eps ),
		.max= point + Vec3f( eps, eps, eps ),
	};

	var bool mut in_liquid= false;

	VisitBoundingBoxesHierarchyForBBox(
		map_data.room_clusters_hierarchy.deref(),
		sample_box,
		lambda[ clusters= map_data.zvox_data.deref().clusters.range(), &sample_box, &in_liquid ]( ClusterIndexInHierarchy c )
		{
			var ZvoxCluster& cluster= clusters[ size_type(c) ];

			if( cluster.contents == ZvoxCluster::c_contents_water |
				cluster.contents == ZvoxCluster::c_contents_acid |
				cluster.contents == ZvoxCluster::c_contents_lava )
			{
				if( CreateClusterBBox( cluster ).InstersectsOrTouches( sample_box ) )
				{
					in_liquid= true;
				}
			}
		} );

	return in_liquid;
}

fn RotateEntityBBox( Vec3f &mut bbox_half_size, f32 azimuth )
{
	if( bbox_half_size.x != bbox_half_size.y && ust::abs( ust::sin( azimuth ) ) >= c_half_sqrt_2 )
	{
		// Rotate initial bounding box by 90 degrees.
		// This is necessary for decorations with unsymmetrical bounds.
		var f32 tmp= bbox_half_size.x;
		bbox_half_size.x= bbox_half_size.y;
		bbox_half_size.y= tmp;
	}
}

fn ClampPlayerVelocity( PlayerState &mut player_state, Vec3f& prohibited_movement_direction )
{
	var f32 dot= player_state.velocity.Dot( prohibited_movement_direction );
	if( dot < 0.0f )
	{
		player_state.velocity-= prohibited_movement_direction * ( dot / prohibited_movement_direction.SquareLength() );
	}
}

// Calculare angle delta used for rotation.
// Returns result in roughly -tau / 2 to tau / 2 range.
fn CalculateRotationAngleDelta( f32 angle_a, f32 angle_b ) : f32
{
	 var f32 mut angle_delta= ( ( angle_a - angle_b ) % c_tau + c_tau ) % c_tau;

	// Prefer shortest turn, but slightly biased, in order to avoid some nasty behavior with constantly changing turning direction.
	if( angle_delta > c_tau * 0.45f )
	{
		angle_delta -= c_tau;
	}

	return angle_delta;
}

fn Convert1024Angle( f32 a ) : f32
{
	return a * ( c_tau / -1024.0f );
}

fn GetPlayerColliderBBox( EntitiesDescription& entities_description, f32 crouching_phase ) : BBox3f
{
	// Some reasonable default.
	var BBox3f mut bbox
	{
		.min( -14.0f, -14.0f, -64.0f ),
		.max(  14.0f,  14.0f, 0.0f ),
	};

	if( size_type( c_player_entity_kind ) < entities_description.entities.size() )
	{
		var EntitiesDescription::EntityDescription& entity_description=
			entities_description.entities[ size_type( c_player_entity_kind ) ];

		foreach( &operation : entity_description.operations ) label operations_loop
		{
			var EntitiesDescription::OperationAnimationDescription& animation= operation.animation;

			if( animation.num_steps != 0u &&
				animation.bounding_box_half_size_x != 0 &&
				animation.bounding_box_half_size_y != 0 )
			{
				bbox.min.x= f32( animation.bounding_box_center_x - animation.bounding_box_half_size_x );
				bbox.max.x= f32( animation.bounding_box_center_x + animation.bounding_box_half_size_x );
				bbox.min.y= f32( animation.bounding_box_center_y - animation.bounding_box_half_size_y );
				bbox.max.y= f32( animation.bounding_box_center_y + animation.bounding_box_half_size_y );

				// The original game seems to use a hard-coded Z dimensions, so, ignore Z dimensions from the config.

				break label operations_loop;
			}
		}
	}

	// Lower the top face of the player's bbox if he is crouching.
	bbox.min.z += crouching_phase * c_crouching_height_delta;

	return bbox;
}

fn GetPlayerStartEnergy( EntitiesDescription& entities_description ) : u32
{
	if( size_type( c_player_entity_kind ) < entities_description.entities.size() )
	{
		var EntitiesDescription::EntityDescription& entity_description=
			entities_description.entities[ size_type( c_player_entity_kind ) ];

		return entity_description.energy;
	}

	return 100u; // Some reasonable default.
}

fn GetPlayerMaxArmor( EntitiesDescription& entities_description ) : u32
{
	// For now assume that the maximum armor is equal to start health.
	return GetPlayerStartEnergy( entities_description );
}

fn CreateDynamicClusterBBox( ZvoxCluster& cluster, Vec3f& translation ) : BBox3f
{
	var BBox3f mut bbox= CreateClusterBBox( cluster );
	bbox.min+= translation;
	bbox.max+= translation;

	// Hack!
	// Some bounding boxes of small clusters in the original game dont't include the whole cluster geometry.
	// So, extend bounding boxes a little bit to compensate this issue.
	bbox.min-= Vec3f( 1.01f, 1.01f, 1.01f );
	bbox.max+= Vec3f( 1.01f, 1.01f, 1.01f );

	return bbox;
}

fn GetCrosshairPositionAndKind(
	GameMapData& map_data,
	GameState& game_state,
	f32 camera_azimuth,
	f32 camera_elevation ) : tup[ Vec3f, CrosshairDrawingInfo::HitPointKind ]
{
	var Vec3f mut position_sum= Vec3f::MakeZero(), mut direction_sum= Vec3f::MakeZero();
	var size_type mut num_positions= 0s;

	var EntitiesDescription& entities_description= map_data.entities_description.deref();

	var size_type weapon_tool_index(
		entities_description.tool_type_to_index_map[
			size_type( game_state.player.primary_weapon_state.current_weapon ) ] );

	if( weapon_tool_index < entities_description.tools.size() )
	{
		var EntitiesDescription::Tool& tool= entities_description.tools[ weapon_tool_index ];

		foreach( &shot : tool.shot_data )
		{
			auto [ position, direction ]=
				GetPlayerShotStartAndDirection(
					shot,
					game_state.player.position,
					game_state.player.crouching_phase,
					camera_azimuth,
					camera_elevation );

			position_sum+= position;
			direction_sum+= direction;
			++num_positions;
		}
	}

	if( num_positions == 0s )
	{
		return ust::make_tuple( Vec3f::MakeZero(), CrosshairDrawingInfo::HitPointKind::None );
	}

	var Vec3f trace_start= position_sum / f32( num_positions );
	var Vec3f trace_vector= direction_sum * ( 16384.0f / f32( num_positions ) );

	var f32 mut trace_min_distance= 1.0f;
	var CrosshairDrawingInfo::HitPointKind mut hit_point_kind= CrosshairDrawingInfo::HitPointKind::Sky;

	// Check for intersection with the world.

	if_var( line_trace_result :
			LineTrace(
				map_data,
				game_state.broken_quad_bits,
				game_state.dynamic_cluster_colliders,
				trace_start,
				trace_vector ) )
	{
		if( line_trace_result.distance < trace_min_distance )
		{
			trace_min_distance= line_trace_result.distance;
			hit_point_kind= CrosshairDrawingInfo::HitPointKind::World;
		}
	}

	// Check for intersection with enemies and props, but exclude player itself.

	foreach( &collider : game_state.colliders )
	{
		if( collider.entity_index == c_player_entity_index )
		{
			continue;
		}

		if_var( &intersection : FindRayBBoxIntersection( trace_start, trace_vector, collider.bbox ) )
		{
			if( intersection.far_point_distance >= 0.0f )
			{
				var f32 distance= ust::max( 0.0f, intersection.near_point_distance );
				if( distance < trace_min_distance )
				{
					trace_min_distance= distance;
					hit_point_kind= CrosshairDrawingInfo::HitPointKind::Entity;
				}
			}
		}
	}

	return ust::make_tuple( trace_start + trace_vector * trace_min_distance, hit_point_kind );
}

fn GetPlayerShotStartAndDirection(
	[ i32, 7 ]& shot,
	Vec3f& player_position,
	f32 crouching_phase,
	f32 camera_azimuth,
	f32 camera_elevation ) : [ Vec3f, 2 ]
{
	var Mat4f camera_rotation_matrix=
		Mat4f::MakeRotationX( camera_elevation ) *
		Mat4f::MakeRotationZ( camera_azimuth );

	var f32 shot_elevation= ( c_weapon_angles_scale * c_tau ) * f32( shot[5] );

	// Each odd shot for weapons firing more than one bullet is fired slighly upper.
	// This behavior is observable in the original game.
	var f32 extra_elevation= f32( shot[0] & 1 ) * ( -0.75f / 360.0f * c_tau );

	var Mat4f shot_rotation_matrix= Mat4f::MakeRotationX( shot_elevation + extra_elevation );

	var Vec3f shot_relative_position( f32( shot[2] ), f32( shot[3] ), f32( shot[4] ) - c_camera_z_offset );

	return ust::make_array(
		// Shot position isn't affected by shot elevation.
		player_position +
			Vec3f( 0.0f, 0.0f, c_camera_z_offset + crouching_phase * c_crouching_height_delta ) +
			shot_relative_position * camera_rotation_matrix,
		// Shot direction IS affected by shot elevation.
		Vec3f( 0.0f, 1.0f, 0.0f ) * shot_rotation_matrix * camera_rotation_matrix );
}

// Input vector may be non-normalized.
fn RandomOffsetShotVector( Vec3f& shot_vector, u32 accuracy, PseudoRandomGenerator &mut rand ) : Vec3f
{
	var [ Vec3f, 3 ] basis= GetShotVectorBasis( shot_vector );

	var f32 spread_half_angle= f32( accuracy ) * ( 0.5f * c_tau * c_weapon_angles_scale );

	// Select random longitude in any direction and random deviation angle from shot direction.
	// Result distribution has more density at center, which is nice and is somewhat realistic.
	var f32 longitude= f32( rand.Next() ) * ( c_tau / f32( PseudoRandomGenerator::c_max_plus_one ) );
	var f32 latitude= c_tau / 4.0f - f32( rand.Next() ) * ( spread_half_angle / f32( PseudoRandomGenerator::c_max_plus_one ) );

	var f32 longitude_cos= ust::cos( longitude );
	var f32 longitude_sin= ust::sin( longitude );
	var f32 latitude_cos= ust::cos( latitude );
	var f32 latitude_sin= ust::sin( latitude );

	return
		basis[0] * latitude_sin +
		basis[1] * ( longitude_cos * latitude_cos ) +
		basis[2] * ( longitude_sin * latitude_cos );
}

// Input vector may be non-normalized.
fn GetShotVectorBasis( Vec3f& shot_vector ) : [ Vec3f, 3 ]
{
	var Vec3f basis_vector_a= shot_vector;
	var f32 basis_vector_a_length= basis_vector_a.Length();
	if( basis_vector_a_length == 0.0f )
	{
		return ust::make_array( Vec3f( 1.0f, 0.0f, 0.0f ), Vec3f( 0.0f, 1.0f, 0.0f ), Vec3f( 0.0f, 0.0f, 1.0f ) );
	}

	var Vec3f basis_vector_b= shot_vector.Cross( Vec3f( 0.0f, 0.0f, 1.0f ) );
	var f32 basis_vector_b_length= basis_vector_b.Length();
	if( basis_vector_b_length == 0.0f )
	{
		return
			ust::make_array(
				basis_vector_a / basis_vector_a_length,
				Vec3f( 0.0f, 1.0f, 0.0f ),
				Vec3f( 0.0f, 0.0f, 1.0f ) );
	}

	var Vec3f basis_vector_c= basis_vector_b.Cross( shot_vector );
	var f32 basis_vector_c_length= basis_vector_c.Length();
	if( basis_vector_c_length == 0.0f )
	{
		return
			ust::make_array(
				basis_vector_a / basis_vector_a_length,
				basis_vector_b / basis_vector_b_length,
				Vec3f( 0.0f, 0.0f, 1.0f ) );
	}

	return
		ust::make_array(
			basis_vector_a / basis_vector_a_length,
			basis_vector_b / basis_vector_b_length,
			basis_vector_c / basis_vector_c_length );
}

} // namespace PM
