import "gl_state.iu"
import "mat.iu"
import "plane.iu"
import "world_drawing_info.iu"

namespace PM
{

type CameraClipPlanes= [ Planef, 5 ];

fn CreateCameraClipPlanes( WorldDrawingInfo::CameraParams& camera_params, f32 aspect ) : CameraClipPlanes;

fn AreBoxVerticesClippedByAtLeastOneCameraClipPlane( CameraClipPlanes& clip_planes, [ Vec3f, 8 ]& vertices ) : bool;

fn CalculateCameraRotationMatrix( f32 camera_azimuth, f32 camera_elevation ) : Mat4f;

fn CalculateFirstPersonWeaponDistortionMatrix()  : Mat4f;

fn CalculateScissorRectForSphere(
	Mat4f& camera_space_matrix,
	Mat4f& camera_projection_matrix,
	[ u32, 2 ]& viewport_size,
	Vec3f& sphere_center,
	f32 sphere_radius ) : ScissorRect;

// Z near is moved as far as possible to increase Z-buffer precision
// without causing clipping of map geometry while staying close to it.
// Clipping is still technically possible with very wide field of view or when screen width is much smaller than its hight,
// but this normally shouldn't happen.
var f32 c_z_near= 8.0f;

// Z far is moved as near as possible without clipping far geometry on maps with largest possible view distance.
var f32 c_z_far= 8192.0f;

} // namespace PM
