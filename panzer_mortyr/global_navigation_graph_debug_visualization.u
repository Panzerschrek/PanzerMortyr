import "global_navigation_graph_debug_visualization.iu"

namespace PM
{

fn VisualizeGlobalNavigationGraph(
	GlobalNavigationGraph& global_navigation_graph,
	ust::vector</WorldDrawingInfo::TestLine/> &mut out_lines )
{
	var [ u8, 3 ] color[ 32u8, 200u8, 32u8 ];

	foreach( &node : global_navigation_graph.nodes )
	{
		// TODO - use proper dimensions.
		var f32 half_width= 16.0f;
		var f32 height= 64.0f;

		var [ Vec3f, 5 ] vertices
		[
			node.position + Vec3f( -half_width, -half_width, 0.0f ),
			node.position + Vec3f( -half_width,  half_width, 0.0f ),
			node.position + Vec3f(  half_width, -half_width, 0.0f ),
			node.position + Vec3f(  half_width,  half_width, 0.0f ),
			node.position + Vec3f( 0.0f, 0.0f, -height ),
		];

		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[0], vertices[1] ], .color= color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[0], vertices[2] ], .color= color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[2], vertices[3] ], .color= color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[1], vertices[3] ], .color= color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[0], vertices[4] ], .color= color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[1], vertices[4] ], .color= color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[2], vertices[4] ], .color= color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[3], vertices[4] ], .color= color } );
	}
}

} // namespace PM
