import "global_navigation_graph_debug_visualization.iu"

namespace PM
{

fn VisualizeGlobalNavigationGraph(
	GlobalNavigationGraph& global_navigation_graph,
	ust::vector</WorldDrawingInfo::TestLine/> &mut out_lines )
{
	var [ u8, 3 ] node_color[  32u8, 200u8,  32u8 ];
	var [ u8, 3 ] edge_color[ 200u8, 200u8,  32u8 ];

	foreach( &node : global_navigation_graph.nodes )
	{
		// TODO - use proper dimensions.
		var f32 half_width= 16.0f;
		var f32 height= 64.0f;

		var [ Vec3f, 6 ] vertices
		[
			node.position + Vec3f( -half_width, -half_width, 0.0f ),
			node.position + Vec3f( -half_width,  half_width, 0.0f ),
			node.position + Vec3f(  half_width, -half_width, 0.0f ),
			node.position + Vec3f(  half_width,  half_width, 0.0f ),
			node.position + Vec3f( 0.0f, 0.0f, -height ),
			node.position,
		];

		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[0], vertices[1] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[0], vertices[2] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[2], vertices[3] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[1], vertices[3] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[0], vertices[4] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[1], vertices[4] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[2], vertices[4] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[3], vertices[4] ], .color= node_color } );
		out_lines.push_back( WorldDrawingInfo::TestLine{ .vertices[ vertices[4], vertices[5] ], .color= node_color } );

		for( auto mut i= 0u; i < node.num_input_edges; ++i )
		{
			var GlobalNavigationGraph::InputEdge& input_edge=
				global_navigation_graph.node_input_edges[ size_type( node.first_input_edge + i ) ];

			var Vec3f& input_node_position=
				global_navigation_graph.nodes[ size_type( input_edge.src_node_index ) ].position;

			out_lines.push_back(
				WorldDrawingInfo::TestLine
				{
					.vertices[ ( input_node_position.xy(), input_node_position.z - height ), vertices[5] ],
					.color= edge_color
				} );
		}
	}
}

} // namespace PM
