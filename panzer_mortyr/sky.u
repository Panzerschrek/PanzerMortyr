import "/math.u"
import "/vector.u"
import "gl_functions.uh"
import "math_constants.uh"
import "sky.uh"
import "vertex_formats.uh"

namespace PM
{

fn CreateSkyBackgroundBuffer() : SkyBackgroundBuffer
{
	var ust::vector</SkyBackgroundVertex/> mut vertices;
	var ust::vector</u16/> mut indices;

	var size_type c_num_rings= 20s, c_num_directions= 32s;
	var f32 scale= 1024.0f;

	for( auto mut r= 0s; r < c_num_rings + 1s; ++r )
	{
		var f32 elevation_angle= ( ( f32(r) + 1.0f ) / f32( c_num_rings + 2s ) * 2.0f - 1.0f ) * ( c_tau * 0.25f );
		var f32 elevation_angle_cos= ust::cos( elevation_angle );
		var f32 elevation_angle_sin= ust::sin( elevation_angle );

		var f32 azimuth_offset= f32( r & 1s ) * ( c_half_tau / f32(c_num_directions) );

		for( auto mut d= 0s; d < c_num_directions; ++d )
		{
			var f32 azimuth= f32(d) * ( c_tau / f32(c_num_directions) ) + azimuth_offset;
			var f32 azimuth_cos= ust::cos( azimuth );
			var f32 azimuth_sin= ust::sin( azimuth );

			vertices.push_back(
				SkyBackgroundVertex
				{
					.position[ elevation_angle_cos * azimuth_cos * scale, elevation_angle_cos * azimuth_sin * scale, elevation_angle_sin * scale ],
					.color[ ( r * 255s / (c_num_rings + 1s) ), ( d * 255s / c_num_directions ), (0) ],
					.padding15= zero_init,
				} );
		}
	}

	for( auto mut r= 0s; r < c_num_rings; ++r )
	{
		var size_type offset0= c_num_directions * r;
		var size_type offset1= c_num_directions * ( r + 1s );

		for( auto mut d= 0s; d < c_num_directions; ++d )
		{
			var size_type next_d= ( d + 1s ) % c_num_directions;
			var [ u16, 4 ] quad_indices
			[
				( offset0 + d ),
				( offset0 + next_d ),
				( offset1 + d ),
				( offset1 + next_d ),
			];
			if( ( r & 1s ) != 0s )
			{
				indices.push_back( quad_indices[0] );
				indices.push_back( quad_indices[1] );
				indices.push_back( quad_indices[3] );
				indices.push_back( quad_indices[0] );
				indices.push_back( quad_indices[2] );
				indices.push_back( quad_indices[3] );
			}
			else
			{
				indices.push_back( quad_indices[0] );
				indices.push_back( quad_indices[1] );
				indices.push_back( quad_indices[2] );
				indices.push_back( quad_indices[1] );
				indices.push_back( quad_indices[2] );
				indices.push_back( quad_indices[3] );
			}
		}
	}

	var VertexArrayObject mut vertex_array_object;

	var BufferObject mut vertex_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			vertices.range().to_byte8_range() );

	var BufferObject mut index_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ELEMENT_ARRAY_BUFFER ), // Needed for a triangle indices source.
			indices.range().to_byte8_range() );

	vertex_array_object.Bind();
	vertex_buffer.Bind();

	// These constants should match locations in the shader!
	var u32 c_position_attrib= 0u;
	var u32 c_color_attrib= 1u;

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );

	unsafe( glVertexAttribPointer(
		c_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</SkyBackgroundVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ SkyBackgroundVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( c_color_attrib ) );

	unsafe( glVertexAttribPointer(
		c_color_attrib,
		3,
		GLenum( GL_UNSIGNED_BYTE ),
		GLboolean(1),
		GLsizei( typeinfo</SkyBackgroundVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ SkyBackgroundVertex, "color" />() ) );

	return SkyBackgroundBuffer
	{
		.vertex_array_object= move(vertex_array_object),
		.vertex_buffer= move(vertex_buffer),
		.index_buffer= move(index_buffer),
		.num_vertices= vertices.size(),
		.num_triangle_indices= indices.size(),
	};
}

} // namespace PM
