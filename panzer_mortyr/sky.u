import "/math.iu"
import "/vector.iu"
import "/common_lib/materials_file.iu"
import "gl_functions.iu"
import "math_constants.iu"
import "random.iu"
import "sky.iu"
import "vec.iu"
import "vertex_formats.iu"

namespace PM
{

fn CreateSkyBackgroundBuffer( MapsDescription::MapDescription& map_description ) : SkyBackgroundBuffer
{
	if( map_description.sky_model == 0u )
	{
		// Sky mode 0 is always black.
		var [ u8, 3 ] black= zero_init;
		return CreateSkyBackgroundGradientBuffer( black, black );
	}
	else
	{
		// Other modes use gradient of two colors.
		return CreateSkyBackgroundGradientBuffer( map_description.sky_colors[0], map_description.sky_colors[1] );
	}
}

fn CreateSkyBackgroundGradientBuffer( [ u8, 3 ]& color0, [ u8, 3 ]& color1 ) : SkyBackgroundBuffer
{
	var ust::vector</SkyBackgroundVertex/> mut vertices;
	var ust::vector</u16/> mut indices;

	// Enough resolution to approximate angle-based gradient interpolation.
	var size_type constexpr c_num_rings= 20s, constexpr c_num_stripes= 24s;

	// Ring vertices.
	for( auto mut r= 1s; r < c_num_rings; ++r )
	{
		var f32 elevation_angle= ( f32(r) *( 2.0f / f32( c_num_rings ) ) - 1.0f ) * ( c_tau * 0.25f );
		var f32 elevation_angle_cos= ust::cos( elevation_angle );
		var f32 elevation_angle_sin= ust::sin( elevation_angle );

		var f32 azimuth_offset= f32( r & 1s ) * ( c_half_tau / f32(c_num_stripes) );

		var [ u8, 3 ] mut ring_color= zero_init;
		for( auto mut i= 0s; i < 3s; ++i )
		{
			ring_color[ 2s - i ]= u8( ( size_type( color0[i] ) * r + size_type( color1[i] ) * ( c_num_rings - r ) ) / c_num_rings );
		}

		for( auto mut s= 0s; s < c_num_stripes; ++s )
		{
			var f32 azimuth= f32(s) * ( c_tau / f32(c_num_stripes) ) + azimuth_offset;

			vertices.push_back(
				SkyBackgroundVertex
				{
					.position
					[
						elevation_angle_cos * ust::cos( azimuth ),
						elevation_angle_cos * ust::sin( azimuth ),
						elevation_angle_sin
					],
					.color= ring_color,
					.padding15= zero_init,
				} );
		}
	}

	// Ring triangles.
	for( auto mut r= 0s; r < c_num_rings - 2s; ++r )
	{
		var size_type offset0= c_num_stripes * r;
		var size_type offset1= c_num_stripes * ( r + 1s );

		for( auto mut s= 0s; s < c_num_stripes; ++s )
		{
			var size_type next_s= ( s + 1s ) % c_num_stripes;
			var [ u16, 4 ] quad_indices
			[
				( offset0 + s ),
				( offset0 + next_s ),
				( offset1 + s ),
				( offset1 + next_s ),
			];

			indices.push_back( quad_indices[0] );
			indices.push_back( quad_indices[1] );
			if( ( r & 1s ) == 0s )
			{

				indices.push_back( quad_indices[3] );
				indices.push_back( quad_indices[0] );
			}
			else
			{
				indices.push_back( quad_indices[2] );
				indices.push_back( quad_indices[1] );
			}
			indices.push_back( quad_indices[2] );
			indices.push_back( quad_indices[3] );
		}
	}

	// North cup.
	{
		var size_type pole_vertex_index= vertices.size();
		vertices.push_back(
			SkyBackgroundVertex
			{
				.position[ 0.0f, 0.0f, -1.0f ],
				.color[ color1[2], color1[1], color1[0] ],
				.padding15= zero_init,
			} );

		for( auto mut s= 0s; s < c_num_stripes; ++s )
		{
			indices.push_back( u16( pole_vertex_index ) );
			indices.push_back( u16( s ) );
			indices.push_back( u16( ( s + 1s ) % c_num_stripes ) );
		}
	}

	// South cup.
	{
		var size_type pole_vertex_index= vertices.size();
		vertices.push_back(
			SkyBackgroundVertex
			{
				.position[ 0.0f, 0.0f, 1.0f ],
				.color[ color0[2], color0[1], color0[0] ],
				.padding15= zero_init,
			} );

		var size_type base_index= ( c_num_rings - 2s ) * c_num_stripes;

		for( auto mut s= 0s; s < c_num_stripes; ++s )
		{
			indices.push_back( u16( pole_vertex_index ) );
			indices.push_back( u16( base_index + s ) );
			indices.push_back( u16( base_index + ( s + 1s ) % c_num_stripes ) );
		}
	}

	var VertexArrayObject mut vertex_array_object;

	var BufferObject mut vertex_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			vertices.range().to_byte8_range() );

	var BufferObject mut index_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ELEMENT_ARRAY_BUFFER ), // Needed for a triangle indices source.
			indices.range().to_byte8_range() );

	vertex_array_object.Bind();
	vertex_buffer.Bind();

	// These constants should match locations in the shader!
	var u32 c_position_attrib= 0u;
	var u32 c_color_attrib= 1u;

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );

	unsafe( glVertexAttribPointer(
		c_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</SkyBackgroundVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ SkyBackgroundVertex, "position" />() ) );

	unsafe( glEnableVertexAttribArray( c_color_attrib ) );

	unsafe( glVertexAttribPointer(
		c_color_attrib,
		3,
		GLenum( GL_UNSIGNED_BYTE ),
		GLboolean(1),
		GLsizei( typeinfo</SkyBackgroundVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</ SkyBackgroundVertex, "color" />() ) );

	return SkyBackgroundBuffer
	{
		.vertex_array_object= move(vertex_array_object),
		.vertex_buffer= move(vertex_buffer),
		.index_buffer= move(index_buffer),
		.num_triangle_indices= indices.size(),
	};
}

fn CreateSkyCloudsParams( MapsDescription::MapDescription& map_description ) : ust::optional</SkyCloudsParams/>
{
	switch( map_description.sky_model )
	{
		0u -> { return ust::null_optional; },
		1u ->
		{
			return SkyCloudsParams{ .scale= 1.0f / 3.0f, .scroll_speed= 1.0f / 64.0f, .scale_colors_by_two= true };
		},
		2u ->
		{
			return SkyCloudsParams{ .scale= 1.0f / 3.0f, .scroll_speed= 1.0f / 64.0f, .scale_colors_by_two= false };
		},
		3u ... ->
		{
			return SkyCloudsParams{ .scale= 4.0f / 3.0f, .scroll_speed= 1.0f / 16.0f, .scale_colors_by_two= true };
		},
	}
}

fn CreateStarsBuffer(
	MapsDescription::MapDescription& map_description,
	ust::array_view_imut</BillboardDescription/> billboards_description ) : StarsBuffer
{
	var ust::vector</StarVertex/> mut vertices;
	var ust::vector</u16/> mut indices;

	var f32 star_layer= 124.0f;

	var [ f32, 2 ] mut star_tc_start[ 0.0f, 0.0f ], mut star_tc_end[ 1.0f, 1.0f ];

	if( size_type( BillboardConstants::c_id_star ) < billboards_description.size() )
	{
		var BillboardDescription& billboard_description=
			billboards_description[ size_type( BillboardConstants::c_id_star ) ];

		var f32 constexpr tc_scale= 1.0f / f32( MaterialsDescription::c_texture_size );

		star_tc_start[0]= f32( billboard_description.xp ) * tc_scale;
		star_tc_start[1]= f32( billboard_description.yp ) * tc_scale;
		star_tc_end[0]= f32( billboard_description.xk ) * tc_scale;
		star_tc_end[1]= f32( billboard_description.yk ) * tc_scale;
	}

	var f32 moon_layer= 125.0f;

	if( map_description.sky_model == 0u | map_description.sky_model == 1u )
	{
		var PseudoRandomGenerator mut rand;

		var size_type c_num_stars= 512s;

		for( auto mut i= 0s; i < c_num_stars; ++i )
		{
			var Vec3f position(
				f32( rand.Next() ) * ( 2.0f / f32( PseudoRandomGenerator::c_max ) ) - 1.0f,
				f32( rand.Next() ) * ( 2.0f / f32( PseudoRandomGenerator::c_max ) ) - 1.0f,
				// Generate stars only in upper hemisphere.
				-ust::abs( f32( rand.Next() ) * ( 2.0f / f32( PseudoRandomGenerator::c_max ) ) - 1.0f ) );

			// Reject points outside unit sphere to ensure equal angular density.
			// Reject points too close to the camera (stars should be behind the clouds).
			var f32 position_square_length= position.SquareLength();
			if( position_square_length < 0.25f || position_square_length > 1.0f )
			{
				continue;
			}

			var Vec3f u_vec= position.Cross( Vec3f( 0.0f, 0.0f, 1.0f ) );
			var Vec3f v_vec= u_vec.Cross( position );

			var f32 u_vec_length= u_vec.Length();
			var f32 v_vec_length= v_vec.Length();
			if( u_vec_length == 0.0f | v_vec_length == 0.0f )
			{
				continue;
			}

			var f32 scale= f32( rand.Next() ) * ( 0.006f / f32( PseudoRandomGenerator::c_max ) )  + 0.002f;

			var f32 vectors_scale= scale * ust::sqrt( position_square_length );

			var Vec3f u_vec_normalized_and_scaled= u_vec * ( vectors_scale / u_vec_length );
			var Vec3f v_vec_normalized_and_scaled= v_vec * ( vectors_scale / v_vec_length );

			var [ Vec3f, 4 ] positions
			[
				position - u_vec_normalized_and_scaled - v_vec_normalized_and_scaled,
				position + u_vec_normalized_and_scaled - v_vec_normalized_and_scaled,
				position - u_vec_normalized_and_scaled + v_vec_normalized_and_scaled,
				position + u_vec_normalized_and_scaled + v_vec_normalized_and_scaled,
			];

			var size_type base_vertex= vertices.size();

			vertices.push_back(
				StarVertex
				{
					.position[ positions[0].x, positions[0].y, positions[0].z ],
					.light= zero_init,
					.tex_coordinates[ star_tc_start[0], star_tc_start[1], star_layer ],
					.fog_params= zero_init,
				} );

			vertices.push_back(
				StarVertex
				{
					.position[ positions[1].x, positions[1].y, positions[1].z ],
					.light= zero_init,
					.tex_coordinates[ star_tc_end[0], star_tc_start[1], star_layer ],
					.fog_params= zero_init,
				} );

			vertices.push_back(
				StarVertex
				{
					.position[ positions[2].x, positions[2].y, positions[2].z ],
					.light= zero_init,
					.tex_coordinates[ star_tc_start[0], star_tc_end[1], star_layer ],
					.fog_params= zero_init,
				} );

			vertices.push_back(
				StarVertex
				{
					.position[ positions[3].x, positions[3].y, positions[3].z ],
					.light= zero_init,
					.tex_coordinates[ star_tc_end[0], star_tc_end[1], star_layer ],
					.fog_params= zero_init,
				} );

			indices.push_back( u16( base_vertex + 0s ) );
			indices.push_back( u16( base_vertex + 1s ) );
			indices.push_back( u16( base_vertex + 2s ) );
			indices.push_back( u16( base_vertex + 1s ) );
			indices.push_back( u16( base_vertex + 2s ) );
			indices.push_back( u16( base_vertex + 3s ) );
		}
	}

	if( map_description.sky_model == 2u | map_description.sky_model == 3u )
	{
		var Vec3f position( 0.4f, 0.2f, -0.65f );

		var Vec3f u_vec= position.Cross( Vec3f( 0.0f, 0.0f, 1.0f ) );
		var Vec3f v_vec= u_vec.Cross( position );

		var f32 vectors_scale= 0.1f;

		var Vec3f u_vec_normalized_and_scaled= u_vec * ( vectors_scale / u_vec.Length() );
		var Vec3f v_vec_normalized_and_scaled= v_vec * ( vectors_scale / v_vec.Length() );

		var [ Vec3f, 4 ] positions
		[
			position - u_vec_normalized_and_scaled - v_vec_normalized_and_scaled,
			position + u_vec_normalized_and_scaled - v_vec_normalized_and_scaled,
			position - u_vec_normalized_and_scaled + v_vec_normalized_and_scaled,
			position + u_vec_normalized_and_scaled + v_vec_normalized_and_scaled,
		];

		var size_type base_vertex= vertices.size();

		vertices.push_back(
			StarVertex
			{
				.position[ positions[0].x, positions[0].y, positions[0].z ],
				.light= zero_init,
				.tex_coordinates[ 0.0f, 0.0f, moon_layer ],
				.fog_params= zero_init,
			} );

		vertices.push_back(
			StarVertex
			{
				.position[ positions[1].x, positions[1].y, positions[1].z ],
				.light= zero_init,
				.tex_coordinates[ 1.0f, 0.0f, moon_layer ],
				.fog_params= zero_init,
			} );

		vertices.push_back(
			StarVertex
			{
				.position[ positions[2].x, positions[2].y, positions[2].z ],
				.light= zero_init,
				.tex_coordinates[ 0.0f, 1.0f, moon_layer ],
				.fog_params= zero_init,
			} );

		vertices.push_back(
			StarVertex
			{
				.position[ positions[3].x, positions[3].y, positions[3].z ],
				.light= zero_init,
				.tex_coordinates[ 1.0f, 1.0f, moon_layer ],
				.fog_params= zero_init,
			} );

		indices.push_back( u16( base_vertex + 0s ) );
		indices.push_back( u16( base_vertex + 1s ) );
		indices.push_back( u16( base_vertex + 2s ) );
		indices.push_back( u16( base_vertex + 1s ) );
		indices.push_back( u16( base_vertex + 2s ) );
		indices.push_back( u16( base_vertex + 3s ) );
	}

	var VertexArrayObject mut vertex_array_object;

	var BufferObject mut vertex_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ARRAY_BUFFER ), // Needed for a vertex attribute source.
			vertices.range().to_byte8_range() );

	var BufferObject mut index_buffer=
		BufferObject::CreateStaticDrawBuffer(
			GLenum( GL_ELEMENT_ARRAY_BUFFER ), // Needed for a triangle indices source.
			indices.range().to_byte8_range() );

	vertex_array_object.Bind();
	vertex_buffer.Bind();

	// These attribute numbers should match values in vertex shader!
	var GLuint c_position_attrib= 0u;
	var GLuint c_texture_coordinates_attrib= 1u;

	unsafe( glEnableVertexAttribArray( c_position_attrib ) );

	unsafe( glVertexAttribPointer(
		c_position_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</StarVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</StarVertex, "position"/>() ) );

	unsafe( glEnableVertexAttribArray( c_texture_coordinates_attrib ) );

	unsafe( glVertexAttribPointer(
		c_texture_coordinates_attrib,
		3,
		GLenum( GL_FLOAT ),
		GLboolean(0),
		GLsizei( typeinfo</StarVertex/>.size_of ),
		ust::nullptr</byte8/>() + GetStructFieldOffset</StarVertex, "tex_coordinates"/>() ) );

	return StarsBuffer
	{
		.vertex_array_object= move(vertex_array_object),
		.vertex_buffer= move(vertex_buffer),
		.index_buffer= move(index_buffer),
		.num_triangle_indices= indices.size(),
	};
}

} // namespace PM
