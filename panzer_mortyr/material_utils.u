import "material_utils.iu"

namespace PM
{
fn CalculateValveSpecialMaterialFrame( f32 time_s ) : u32
{
	return u32( time_s * 16.0f ) % 4u;
}

fn CalculateFilmSpecialMaterialFrame( f32 time_s ) : u32
{
	// Perform mirrored animation. It seems like the original does exactly this.
	var u32 constexpr num_frames= 8u;
	var u32 raw_frame= u32( time_s * 8.0f );
	var u32 repetition= raw_frame / num_frames;
	var u32 mut frame= raw_frame % num_frames;
	if( ( repetition & 1u ) != 0u )
	{
		frame= num_frames - 1u - frame;
	}

	return frame;
}

} // namespace PM
