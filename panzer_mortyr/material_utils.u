import "material_utils.iu"

namespace PM
{
fn CalculateValveSpecialMaterialFrame( f32 time_s ) : u32
{
	return u32( time_s * 16.0f ) % 4u;
}

fn CalculateFilmSpecialMaterialFrame( f32 time_s ) : u32
{
	// Perform mirrored animation. It seems like the original does exactly this.
	var u32 constexpr num_frames= 8u;
	var u32 raw_frame= u32( time_s * 8.0f );
	var u32 repetition= raw_frame / num_frames;
	var u32 mut frame= raw_frame % num_frames;
	if( ( repetition & 1u ) != 0u )
	{
		frame= num_frames - 1u - frame;
	}

	return frame;
}

fn CreateBreakableMaterialsBitArray(
	MaterialsProperties& materials_properties, MaterialsDescription::Block& materials_block ) : BitArray
{
	var size_type num_tiles_in_texture(
		MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y );

	var BitArray mut breakable_materials_bit_array( materials_block.textures.size() * num_tiles_in_texture );

	for( auto mut i= 0s; i < materials_block.textures.size(); ++i )
	{
		var MaterialsDescription::Texture& texture= materials_block.textures[i];

		for( auto mut j= 0s; j < num_tiles_in_texture; ++j )
		{
			var ust::string_view8 material_kind_name= texture.materials[j];

			foreach( &material_property : materials_properties )
			{
				if( material_kind_name == material_property.name && material_property.fragile )
				{
					breakable_materials_bit_array.SetBitToOne( i * num_tiles_in_texture + j );
				}
			}
		}
	}

	return breakable_materials_bit_array;
}

fn CreateWetMaterialsBitArray(
	MaterialsProperties& materials_properties, MaterialsDescription::Block& materials_block ) : BitArray
{
	var size_type num_tiles_in_texture(
		MaterialsDescription::c_texture_file_num_tiles_x * MaterialsDescription::c_texture_file_num_tiles_y );

	var BitArray mut wet_materials_bit_array( materials_block.textures.size() * num_tiles_in_texture );

	for( auto mut i= 0s; i < materials_block.textures.size(); ++i )
	{
		var MaterialsDescription::Texture& texture= materials_block.textures[i];

		for( auto mut j= 0s; j < num_tiles_in_texture; ++j )
		{
			var ust::string_view8 material_kind_name= texture.materials[j];

			foreach( &material_property : materials_properties )
			{
				if( material_kind_name == material_property.name && material_property.water_mark != 0u )
				{
					wet_materials_bit_array.SetBitToOne( i * num_tiles_in_texture + j );
				}
			}
		}
	}

	return wet_materials_bit_array;
}

} // namespace PM
