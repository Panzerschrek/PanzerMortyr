import "gl_functions.iu"
import "texture.iu"

namespace PM
{

fn Texture::Create( GLenum target ) : Texture
{
	unsafe
	{
		var GLuint mut texture= zero_init;
		unsafe( glGenTextures( 1, $<(texture) ) );

		unsafe( glBindTexture( GLenum( target ), texture ) );

		return Texture( texture, target );
	}
}

fn Texture::constructor( GLuint texture, GLenum target ) unsafe
	( texture_= texture, target_= target )
{}

fn Texture::destructor()
{
	unsafe( glDeleteTextures( 1, $<( cast_mut( texture_ ) ) ) );
}

fn Texture::Bind( this )
{
	unsafe( glBindTexture( target_, texture_ ) );
}

} // namespace PM
