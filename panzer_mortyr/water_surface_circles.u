import "water_surface_circles.iu"

namespace PM
{

fn CreateWaterSurfaceCirclesGeometry(
	ust::array_view_imut</WorldDrawingInfo::WaterSurfaceCircle/> water_surface_circles,
	ust::vector</MapVertex/> &mut out_vertices,
	ust::vector</u16/> &mut out_indices )
{
	var f32 constexpr c_water_circle_texture_layer= 151.0f;

	var [ u8, 4 ] light[ 255u8, 255u8, 255u8, 255u8 ];

	foreach( &water_surface_cirlce : water_surface_circles )
	{
		var size_type base_vertex= out_vertices.size();

		out_vertices.push_back(
			MapVertex
			{
				.position
				[
					water_surface_cirlce.position.x - water_surface_cirlce.radius,
					water_surface_cirlce.position.y - water_surface_cirlce.radius,
					water_surface_cirlce.position.z
				],
				.tex_coordinates[ 0.0f, 0.0f, c_water_circle_texture_layer ],
				.light= light,
				.fog_params= zero_init,
			} );

		out_vertices.push_back(
			MapVertex
			{
				.position
				[
					water_surface_cirlce.position.x + water_surface_cirlce.radius,
					water_surface_cirlce.position.y - water_surface_cirlce.radius,
					water_surface_cirlce.position.z
				],
				.tex_coordinates[ 0.5f, 0.0f, c_water_circle_texture_layer ],
				.light= light,
				.fog_params= zero_init,
			} );

		out_vertices.push_back(
			MapVertex
			{
				.position
				[
					water_surface_cirlce.position.x - water_surface_cirlce.radius,
					water_surface_cirlce.position.y + water_surface_cirlce.radius,
					water_surface_cirlce.position.z
				],
				.tex_coordinates[ 0.0f, 0.5f, c_water_circle_texture_layer ],
				.light= light,
				.fog_params= zero_init,
			} );

		out_vertices.push_back(
			MapVertex
			{
				.position
				[
					water_surface_cirlce.position.x + water_surface_cirlce.radius,
					water_surface_cirlce.position.y + water_surface_cirlce.radius,
					water_surface_cirlce.position.z
				],
				.tex_coordinates[ 0.5f, 0.5f, c_water_circle_texture_layer ],
				.light= light,
				.fog_params= zero_init,
			} );

		out_indices.push_back( u16( base_vertex + 0s ) );
		out_indices.push_back( u16( base_vertex + 1s ) );
		out_indices.push_back( u16( base_vertex + 3s ) );
		out_indices.push_back( u16( base_vertex + 0s ) );
		out_indices.push_back( u16( base_vertex + 3s ) );
		out_indices.push_back( u16( base_vertex + 2s ) );
	}
}

} // namespace PM
