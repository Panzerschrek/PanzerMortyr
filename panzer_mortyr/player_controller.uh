import "/random_access_range.u"
import "mat.uh"

namespace PM
{

class PlayerController
{
public:
	fn constructor( Vec3f& pos, f32 azimuth );

	fn GetPos(this) : Vec3f;
	fn GetAzimuth(this) : f32;
	fn GetElevation(this) : f32;

	fn UpdateCameraRotation( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state );
	fn Update( mut this, f32 time_delta_s, ust::array_view_imut</bool/> keyboard_state );

	fn SetPos( mut this, Vec3f& pos );

	fn ClampVelocity( mut this, Vec3f& prohibited_movement_direction );

private:
	Vec3f pos_;
	Vec3f velocity_;
	f32 azimuth_= 0.0f;
	f32 elevation_= 0.0f;
}

} // namespace PM
