import "/sort.iu"
import "triangles_sorting.iu"

namespace PM
{

fn SortTrianglesFarToNearOrder(
	Vec3f& camera_position,
	ust::array_view_imut</MapVertex/> vertices,
	ust::array_view_mut</u16/> triangle_indices,
	ust::vector</TriangleForSorting/> &mut temp_buffer )
{
	// This code sorts triangles using far to near order.
	// Triangle center is used to determine distance used for sorting.
	// Generally sorting can't be always correct, but this approach gives good enough results.

	var size_type num_triangles= triangle_indices.size() / 3s;

	temp_buffer.resize( num_triangles, ust::make_zeroed</TriangleForSorting/>() );

	for( auto mut i= 0s; i < num_triangles; ++i )
	{
		var [ u16, 3 ] vertex_indices
		[
			triangle_indices[ i * 3s + 0s ],
			triangle_indices[ i * 3s + 1s ],
			triangle_indices[ i * 3s + 2s ],
		];

		var Vec3f triangle_center=
			0.333333333333333f * (
				Vec3f( vertices[ size_type( vertex_indices[0] ) ].position ) +
				Vec3f( vertices[ size_type( vertex_indices[1] ) ].position ) +
				Vec3f( vertices[ size_type( vertex_indices[2] ) ].position ) );

		temp_buffer[i]=
			TriangleForSorting
			{
				.vertex_indices= vertex_indices,
				.square_distance= ( triangle_center - camera_position ).SquareLength(),
			};
	}

	// Using - for square distance gives near to far order.
	ust::sort_by_key( temp_buffer, lambda[]( TriangleForSorting& t ) : f32 { return -t.square_distance; } );

	for( auto mut i= 0s; i < num_triangles; ++i )
	{
		var TriangleForSorting& t= temp_buffer[i];
		triangle_indices[ i * 3s + 0s ]= t.vertex_indices[0];
		triangle_indices[ i * 3s + 1s ]= t.vertex_indices[1];
		triangle_indices[ i * 3s + 2s ]= t.vertex_indices[2];
	}
}

} // namespace PM
