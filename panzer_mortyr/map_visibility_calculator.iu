import "clipping_polygon.iu"
import "mat.iu"
import "room_clusters_bsp_tree.iu"

namespace PM
{

class MapVisibilityCalculator
{
public:
	type PortalProjected= ust::optional</ ClippingPolygon />;
	type LeafProjectedBounds= ust::optional</ ClippingPolygon />;

	type VisibleRoomClusterFlags= ust::array_view_imut</bool/>;

public:
	fn constructor( ust::array_view_imut</ZvoxCluster/> clusters );

	fn GetRoomClustersBSPTree( this ) : RoomClustersBSPTree { return room_clusters_bsp_tree_; }

	fn GetLeafProjectedBounds( this ) : ust::array_view_imut</ LeafProjectedBounds /> @( ust::reference_notation::return_inner_references::param0 )
	{
		return leaf_bounds_;
	}

	fn GetPortalsProjected( this ) : ust::array_view_imut</ PortalProjected /> @( ust::reference_notation::return_inner_references::param0 )
	{
		return portals_projected_;
	}

	fn GetVisibleRoomClusterFlags( this ) : VisibleRoomClusterFlags @( ust::reference_notation::return_inner_references::param0 )
	{
		return visible_room_cluster_flags_;
	}

	fn CalculateVisibility( mut this, Vec3f& camera_position, Mat4f& view_matrix );

	fn IsBoxVisible( this, [ Vec3f, 8 ]& box_vertices ) : bool;

private:
	fn IsBoxVisible_r( this, [ Vec3f, 8 ]& box_vertices, RoomClustersBSPTree::NodeIndex node_index ) : bool;

private:
	RoomClustersBSPTree imut room_clusters_bsp_tree_;

	// Contains entry for each leaf. Is non-empty if a leaf is visible.
	ust::vector</ LeafProjectedBounds /> leaf_bounds_;

	// Contains entry for each portal.
	ust::vector</ PortalProjected /> portals_projected_;

	// Contains entry for each cluster. But only room clusters may be marked with "true".
	ust::vector</bool/> visible_room_cluster_flags_;
}

} // namespace PM
