import "/vector.iu"
import "bbox.uh"
import "plane.uh"

namespace PM
{

struct RayPolyhedronIntersectionResult
{
	f32 near_point_distance;
	f32 far_point_distance;
	u32 near_plane_index;
	u32 far_point_index;
}

// Find intersection between a ray and a convex polyhedron defined by its planes.
// Returns two points - near and far. They may be behind the ray start.
// Returns empty result if has no intersection.
fn FindRayPolyhedronIntersection(
	Vec3f& ray_start,
	Vec3f& ray_direction,
	ust::array_view_imut</Planef/> polyhedron_planes ) : ust::optional</RayPolyhedronIntersectionResult/>;

struct RayBBoxIntersectionResult
{
	f32 near_point_distance;
	f32 far_point_distance;
	Vec3f near_point_normal;
	Vec3f far_point_normal;
}

// Similar to ray polyhedron intersection function, but it's optimized for bounding boxes.
fn FindRayBBoxIntersection(
	Vec3f& ray_start, Vec3f& ray_direction, BBox3f& bbox ) : ust::optional</RayBBoxIntersectionResult/>;

// Returns planes in order -X, +X, -Y, +Y, -Z, +Z.
fn CreateBBoxPlanes( BBox3f& bbox ) : [ Planef, 6 ];

// Polyhedron defined by its planes, but with only small number of such planes.
struct CompactPolyhedron
{
	var u32 c_max_planes= 20u;

	u32 num_planes;
	u32 primary_planes_mask; // Has non-zero bits for planes which are "primary" - obtained from quad plane or something similar.
	[ Planef, c_max_planes ] planes;
}

// Assuming given coordinates represent a planar quad, build minkowsky sum of this quad and given bounding box.
// Returns result in passed struct, since it's too heavy to return it normally.
fn CreateBBoxAndQuadMinkowskiSum( BBox3f& bbox, [ Vec3f, 4 ]& quad_vertices, CompactPolyhedron &mut result );

} // namespace PM
