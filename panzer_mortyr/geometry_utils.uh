import "/vector.u"
import "bbox.uh"
import "plane.uh"

namespace PM
{

struct RayPolyhedronIntersectionResult
{
	f32 near_point_distance;
	f32 far_point_distance;
	u32 near_plane_index;
	u32 far_point_index;
}

// Find intersection between a ray and a convex polyhedron defined by its planes.
// Returns two points - near and far. They may be behind the ray start.
// Returns empty result if has no intersection.
fn FindRayPolyhedronIntersection(
	Vec3f& ray_start,
	Vec3f& ray_direction,
	ust::array_view_imut</Planef/> polyhedron_planes ) : ust::optional</RayPolyhedronIntersectionResult/>;

fn CreateBBoxPlanes( BBox3f& bbox ) : [ Planef, 6 ];

// Assuming given coordinates represent a planar quad, build minkowsky sum of this quad and given bounding box.
// TODO - use a container with fixed maximum size.
fn CreateBBoxAndQuadMinkowskiSum( BBox3f& bbox, [ Vec3f, 4 ]& quad_vertices ) : ust::vector</Planef/>;

} // namespace PM
