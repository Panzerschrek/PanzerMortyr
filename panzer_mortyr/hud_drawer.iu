import "buffer_object.iu"
import "game_filesystem.iu"
import "hud_drawing_info.iu"
import "settings.iu"
import "shader_program.iu"
import "texture.iu"
import "vertex_array_object.iu"
import "vertex_formats.iu"

namespace PM
{

class HudDrawer
{
public:
	fn constructor(
		[ u32, 2 ] viewport_size,
		GameFilesystemPtr& game_filesystem_ptr,
		ConsoleOutPtr& console_out,
		Settings& settings );

	fn Draw( mut this, HudDrawingInfo& drawing_info );

private:
	fn AddTileQuad( mut this, i32 x, i32 y, HudDrawingInfo::IconIndex tile_index );
	fn AddDigitQuad( mut this, i32 x, i32 y, u32 digit_index, bool alternative_color );
	fn AddDecimalNumber( mut this, i32 right_x, i32 y, u32 num, bool alternative_color );

	fn FlushDrawQuads( mut this );

private:
	// Should be enough to display all stats (with 3-digit numbers) and several active items.
	var size_type c_max_buffer_size_quads= 32s;

private:
	[ u32, 2 ] imut viewport_size_;
	u32 imut scale_;
	ShaderProgram shader_;
	VertexArrayObject vertex_array_object_;
	BufferObject vertex_buffer_;
	BufferObject index_buffer_;
	Texture hud_texture_atlas_;

	size_type num_buffered_quads_;
	[ [ HudVertex, 4 ], c_max_buffer_size_quads ] buffered_quads_;
}

} // namespace PM
