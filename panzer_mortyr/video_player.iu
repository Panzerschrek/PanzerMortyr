import "/path.iu"
import "opengl_window.iu"
import "performance_counter.iu"
import "shader_program.iu"

namespace PM
{

class VideoPlayer
{
public:
	fn constructor( ConsoleOutPtr console_out );

	// Play given video.
	// The caller thread is blocked while a video is playing,
	// but SDL events are processed and thus video playback can be interrupted.
	fn PlayVideo( mut this, ust::filesystem_path_view file_path, OpenGLWindow &mut window );

private:
	ConsoleOutPtr imut console_out_;
	PerformanceCounter imut performance_counter_;
	ShaderProgram shader_;
}

} // namespace PM
