import "debug_visualization.uh"
import "mat.uh"

namespace PM
{

fn PolygonizePolyhedron(
	ust::array_view_imut</Planef/> planes,
	ust::vector</ WorldDrawingInfo::TestTriangle /> &mut out_triangles )
{
	// Iterate over all planes "i".
	// For each polyhedron plane iterate over all possible pairs of planes and build point of intersection.
	// Than check if this point lies behind polyhedron plane. If so - add point to result.
	for( auto mut i= 0s; i < planes.size(); ++i )
	{
		var Planef& plane_i= planes[i];

		var ust::vector</Vec3f/> mut plane_polygon_vertices;

		for( auto mut j= 0s; j < planes.size(); ++j )
		{
			if( i == j )
			{
				continue;
			}

			var Planef& plane_j= planes[j];

			for( auto mut k= 0s; k < planes.size(); ++k )
			{
				if( k == i || k == j )
				{
					continue;
				}

				var Planef& plane_k= planes[k];

				// Find intersection point by solving system of 3 linear equations.
				// Do this using approach with inverse matrix calculation.

				var Mat3f normals_matrix
				{
					.values
					[
						[ plane_i.normal.x, plane_j.normal.x, plane_k.normal.x ],
						[ plane_i.normal.y, plane_j.normal.y, plane_k.normal.y ],
						[ plane_i.normal.z, plane_j.normal.z, plane_k.normal.z ],
					],
				};

				var Vec3f offset_vec( plane_i.distance, plane_j.distance, plane_k.distance );

				var ust::optional</Mat3f/> inverse_normals_matrix= normals_matrix.Inverse();
				if( inverse_normals_matrix.empty() )
				{
					continue;
				}

				var Vec3f intersection_point= (-offset_vec) * inverse_normals_matrix.try_deref();

				var bool mut is_behind_another_plane= false;
				for( auto mut l= 0s; l < planes.size(); ++l )
				{
					if( l == i || l == j || l == k )
					{
						continue;
					}

					is_behind_another_plane|= planes[l].GetDistanceForPoint( intersection_point ) > 0.0f;
				}

				if( is_behind_another_plane )
				{
					continue;
				}

				plane_polygon_vertices.push_back( intersection_point );
			}
		}

		if( plane_polygon_vertices.size() < 3s )
		{
			continue;
		}

		SortConvexPolygonVertices( plane_i, plane_polygon_vertices );

		auto vertices_range= cast_imut(plane_polygon_vertices).range();

		if( vertices_range.size () < 3s )
		{
			continue;
		}

		for( auto mut t= 0s; t < vertices_range.size() - 2s; ++t )
		{
			out_triangles.push_back(
				WorldDrawingInfo::TestTriangle
				{
					.vertices[ vertices_range[0s], vertices_range[ t + 2s ], vertices_range[ t + 1s ] ],
					.color[ (i * 37s), (i * 751s), (i * 83s) ],
				}
			);
		}
	}
}

fn SortConvexPolygonVertices( Planef& plane, ust::vector</Vec3f/> &mut in_vertices )
{
	// First, find average vertex. For convex polygon it is always inside it.
	var Vec3f mut vertices_sum( 0.0f, 0.0f, 0.0f );

	foreach( &v : in_vertices )
	{
		vertices_sum+= v;
	}

	var Vec3f middle_vertex= vertices_sum / f32( in_vertices.size() );

	var ust::vector</Vec3f/> mut res;
	res.push_back( in_vertices.pop_back() );

	while( !in_vertices.empty() )
	{
		// Search for vertex with smallest angle relative to vector from middle to last vertex.
		var Vec3f v0= res.back() - middle_vertex;

		var size_type mut smallest_cotan_vertex= ~0s;
		var f32 mut smallest_cotan= 0.0f;

		for( auto mut i= 0s; i < in_vertices.size(); ++i )
		{
			var Vec3f v1= in_vertices[i] - middle_vertex;

			var f32 dot= v0.Dot( v1 );
			var Vec3f cross= v0.Cross( v1 );
			var f32 cross_plane_vec_dot= cross.Dot( plane.normal );
			if( cross_plane_vec_dot >= 0.0f )
			{
				continue; // Wrong direction.
			}
			var f32 scaled_angle_cotan = dot / cross_plane_vec_dot; // Should be equal to angle cotangent multiplied by plane vector length.

			if( smallest_cotan_vertex >= in_vertices.size() || scaled_angle_cotan < smallest_cotan  )
			{
				smallest_cotan_vertex= i;
				smallest_cotan= scaled_angle_cotan;
			}
		}

		if( smallest_cotan_vertex < in_vertices.size() )
		{
			var size_type last= in_vertices.size() - 1s;
			in_vertices.swap( smallest_cotan_vertex, last );
			res.push_back( in_vertices.pop_back() );
		}
		else
		{
			break;
		}
	}

	in_vertices= res;
}

fn CreateBBoxLines(
	BBox3f& bbox,
	[ u8, 3 ] color,
	ust::vector</ WorldDrawingInfo::TestLine /> &mut out_lines )
{
	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.min.y, bbox.min.z ), ( bbox.max.x, bbox.min.y, bbox.min.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.max.y, bbox.min.z ), ( bbox.max.x, bbox.max.y, bbox.min.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.min.y, bbox.max.z ), ( bbox.max.x, bbox.min.y, bbox.max.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.max.y, bbox.max.z ), ( bbox.max.x, bbox.max.y, bbox.max.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.min.y, bbox.min.z ), ( bbox.min.x, bbox.max.y, bbox.min.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.max.x, bbox.min.y, bbox.min.z ), ( bbox.max.x, bbox.max.y, bbox.min.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.min.y, bbox.max.z ), ( bbox.min.x, bbox.max.y, bbox.max.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.max.x, bbox.min.y, bbox.max.z ), ( bbox.max.x, bbox.max.y, bbox.max.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.min.y, bbox.min.z ), ( bbox.min.x, bbox.min.y, bbox.max.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.max.x, bbox.min.y, bbox.min.z ), ( bbox.max.x, bbox.min.y, bbox.max.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.min.x, bbox.max.y, bbox.min.z ), ( bbox.min.x, bbox.max.y, bbox.max.z ) ],
			.color= color,
		} );

	out_lines.push_back(
		WorldDrawingInfo::TestLine
		{
			.vertices[ ( bbox.max.x, bbox.max.y, bbox.min.z ), ( bbox.max.x, bbox.max.y, bbox.max.z ) ],
			.color= color,
		} );
}

fn CreateClusterHierarchyLines(
	ClusterHierarchy& cluster_hierarchy,
	size_type depth_to_show,
	ust::vector</ WorldDrawingInfo::TestLine /> &mut out_lines )
{
	CreateClusterHierarchyLines_r( cluster_hierarchy, depth_to_show, 0s, 0u, out_lines );
}

fn CreateClusterHierarchyLines_r(
	ClusterHierarchy& cluster_hierarchy,
	size_type depth_to_show,
	size_type depth,
	u32 node_index,
	ust::vector</ WorldDrawingInfo::TestLine /> &mut out_lines )
{
	var ClusterHierarchy::Node& node= cluster_hierarchy.nodes[ size_type( node_index ) ];

	auto& color= c_cluster_hierarchy_colors[ depth % typeinfo</ typeof(c_cluster_hierarchy_colors ) />.element_count ];

	if( depth == depth_to_show | depth == depth_to_show + 1s )
	{
		CreateBBoxLines( node.bbox, color, out_lines );
	}

	if_var( &branch_node_contents : node.contents.get</ClusterHierarchy::BranchNodeContents/>() )
	{
		if( depth == depth_to_show )
		{
			foreach( child_node_index : branch_node_contents.children_nodes )
			{
				var ClusterHierarchy::Node& child_node= cluster_hierarchy.nodes[ size_type( child_node_index ) ];

				out_lines.push_back(
					WorldDrawingInfo::TestLine
					{
						.vertices
						[
							0.5f * ( node.bbox.min + node.bbox.max ),
							0.5f * ( child_node.bbox.min + child_node.bbox.max ),
						],
						.color= color,
					} );
			}
		}

		foreach( child_node_index : branch_node_contents.children_nodes )
		{
			CreateClusterHierarchyLines_r( cluster_hierarchy, depth_to_show, depth + 1s, child_node_index, out_lines );
		}
	}
	else if_var( &leaf_node_contents : node.contents.get</ClusterHierarchy::LeafNodeContents/>() )
	{
		ust::ignore_unused( leaf_node_contents );
	}
	else{ halt; }
}

var [ [ u8, 3 ], 7 ] c_cluster_hierarchy_colors
[
	[ (255), (  0), (  0) ],
	[ (170), ( 85), (  0) ],
	[ ( 85), (170), (  0) ],
	[ (  0), (255), (  0) ],
	[ (  0), (170), ( 85) ],
	[ (  0), ( 85), (170) ],
	[ (  0), (  0), (255) ],
];

} // namespace PM
